// tbm_app — scenario 5: realistic composite. A shared 256-slot record
// ring (updated via array-set, which promotes the stored record), a
// logger channel carrying small messages (channel writes promote), and
// per-connection request handling: 3-node contexts plus a 64KiB buffer
// every 16th round. All cross-domain edges flow through promote points
// (channel write / array set), so this shape is sound even under the
// experimental multi-domain local collector.
class Node {
    impl __builtin.IReferenceType;
    v: mut i64 = 0;
    n1: mut __builtin.Option<Node> = new __builtin.Option<Node>.none();
}

class Rec {
    impl __builtin.IReferenceType;
    key: mut i64 = 0;
    val: mut i64 = 0;
    tag: mut i64 = 0;
}

class Msg {
    impl __builtin.IReferenceType;
    from: mut i64 = 0;
    payload: mut i64 = 0;
}

fun chain(base: i64, n: i64) -> mut Node {
    let head: mut Node = new Node();
    head.v = base;
    let cur: mut Node = head;
    let i: mut i64 = 1;
    while (i < n) {
        let x: mut Node = new Node();
        x.v = base + i;
        cur.n1 = new __builtin.Option<Node>.some(x);
        cur = x;
        i = i + 1;
    }
    return head;
}

fun chain_sum(h: mut Node) -> i64 {
    let acc: mut i64 = 0;
    let cur: mut Node = h;
    let alive: mut bool = true;
    while (alive) {
        acc = acc + cur.v;
        if (cur.n1.is_some()) {
            cur = cast<mut Node>(cur.n1.some);
        } else {
            alive = false;
        }
    }
    return acc;
}

fun new_rec(k: i64) -> mut Rec {
    let r: mut Rec = new Rec();
    r.key = k;
    r.val = k * 7;
    r.tag = k;
    return r;
}

// The ring rides inside a class: `mut array<Rec>` cannot be passed to an
// async-spawned function directly (Tests/ArrayTest/AsyncArrayParameter.md
// double-red sentinel — array<T> flowing through async argument checking
// leaves the generic unsubstituted).
class Cache {
    impl __builtin.IReferenceType;
    slots: mut array<Rec>;
    fun new(mut this, n: u64) {
        // no explicit <Rec> here — constructor-context explicit generic args
        // skip template instantiation (ExplicitGenericArgInConstructor.md)
        this.slots = create_array(n, new_rec(0));
        let j: mut u64 = 0;
        while (j < n) {
            this.slots.set(j, new_rec(cast<i64>(j)));
            j = j + 1;
        }
    }
    fun put(mut this, i: u64, r: mut Rec) {
        this.slots.set(i, r);
    }
    fun get(mut this, i: u64) -> mut Rec {
        return cast<mut Rec>(this.slots.at(i).some);
    }
}

fun logger(total: i64, ch: mut __builtin.Fifo<mut Msg>) -> i64 {
    let got: mut i64 = 0;
    let acc: mut i64 = 0;
    while (got < total) {
        let m: mut Msg = wait ch;
        acc = acc + m.from * 3 + m.payload;
        got = got + 1;
    }
    return acc;
}

fun handler(id: i64, rounds: i64, cache: mut Cache, log: mut __builtin.Fifo<mut Msg>) -> i64 {
    let i: mut i64 = 0;
    let acc: mut i64 = 0;
    let c16: mut i64 = 0;
    let c64: mut i64 = 0;
    let slot: mut i64 = 0;
    let buf: mut array<u8> = create_array<u8>(65536, 7);
    while (i < rounds) {
        let req: mut Node = chain(id * 100000000 + i, 3);
        acc = acc + chain_sum(req);
        c16 = c16 + 1;
        if (c16 == 8) {
            buf = create_array<u8>(65536, 5);
            acc = acc + cast<i64>(buf.at(cast<u64>(100)).value_or(0));
        }
        if (c16 == 16) {
            c16 = 0;
            let m: mut Msg = new Msg();
            m.from = id;
            m.payload = i;
            log.write(m);
        }
        c64 = c64 + 1;
        if (c64 == 64) {
            c64 = 0;
            let r: mut Rec = new_rec(i + id);
            r.val = acc;
            cache.put(cast<u64>(slot), r);
            let back: mut Rec = cache.get(cast<u64>(slot));
            acc = acc + back.key + back.tag;
            slot = slot + 1;
            if (slot == 256) {
                slot = 0;
            }
        }
        i = i + 1;
    }
    return acc;
}

initial {
    let t0: i64 = __builtin.now_ms();
    let cache: mut Cache = new Cache(cast<u64>(256));
    let log: mut __builtin.Fifo<mut Msg> = new __builtin.Fifo<mut Msg>(256, new __builtin.FifoPolicy.backpressure());
    let R: i64 = 120000;
    let lg = async logger(R * 4 / 16, log);
    let h0 = async handler(0, R, cache, log);
    let h1 = async handler(1, R, cache, log);
    let h2 = async handler(2, R, cache, log);
    let h3 = async handler(3, R, cache, log);
    let s0: i64 = wait h0;
    let s1: i64 = wait h1;
    let s2: i64 = wait h2;
    let s3: i64 = wait h3;
    let sl: i64 = wait lg;
    let t1: i64 = __builtin.now_ms();
    println("tbm_app elapsed_ms=" + cast<string>(t1 - t0)
        + " checksum=" + cast<string>(s0 + s1 + s2 + s3 + sl));
}
