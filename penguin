#!/bin/sh
# Fail the script when a stage command fails, even if it's upstream of a pipe.
# Without this, `$?` after `dotnet ... | ts | tee` is `tee`'s exit code (always 0),
# so a failing pass1/pass2/pass3 is not detected and the bootstrap falsely succeeds.
# (Supported by bash/ksh/zsh/ash; /bin/sh on this system is bash.)
set -o pipefail

PASS=1
BOOTSTRAPPING=0
OTHERS=""
TESTING=0
CLEAN=0
PUBLISH=0

for arg in "$@"; do
  case "$arg" in
    -1) PASS=1 ;;
    -2) PASS=2 ;;
    -3) PASS=3 ;;
    -4) PASS=4 ;;
    -c) CLEAN=1 ;;
    -b) BOOTSTRAPPING=1 ;;
    -t) TESTING=1 ;;
    -p) PUBLISH=1 ;;
    *) OTHERS="$OTHERS $arg" ;;
  esac
done

if [ $CLEAN -eq 1 ]; then
    echo "Cleaning build artifacts ..."
    rm -rf tmp
fi

if [ $BOOTSTRAPPING -eq 1 ]; then
    echo "Bootstrapping EmperorPenguin (BabyPenguin --backend=cs) ..."
    echo "============================================================"
    mkdir -p tmp
    # Pass 1: BabyPenguin lowers+compiles EmperorPenguin to C# and runs it (via the cs backend,
    # ~same order of magnitude as the native passes), which emits LLVM IR + clang -> tmp/pass2.
    dotnet run --configuration Release --project BabyPenguin -- \
        --backend=cs EmperorPenguin/EmperorPenguin.penguins -- \
        EmperorPenguin/EmperorPenguin.penguins EmperorPenguin/src/utils.penguin \
        -vv -enable-meta -o "tmp/pass2" 2>&1 | ts "%F %T" | tee tmp/pass1.log
    if [ $? -ne 0 ]; then
        echo "Bootstrap FAILED at pass1 (BabyPenguin cs backend -> tmp/pass2)" >&2
        exit 1
    fi
    echo "Running Pass 2 with bootstrapping ..."
    tmp/pass2 EmperorPenguin/EmperorPenguin.penguins EmperorPenguin/src/utils.penguin \
        -vv -enable-meta -o "tmp/pass3" 2>&1 | ts "%F %T" | tee tmp/pass2.log
    if [ $? -ne 0 ]; then
        echo "Bootstrap FAILED at pass2 (tmp/pass2 -> tmp/pass3)" >&2
        exit 1
    fi
    echo "Running Pass 3 with bootstrapping ..."
    tmp/pass3 EmperorPenguin/EmperorPenguin.penguins EmperorPenguin/src/utils.penguin \
        -vv -enable-meta -o "tmp/pass4" 2>&1 | ts "%F %T" | tee tmp/pass3.log
    if [ $? -ne 0 ]; then
        echo "Bootstrap FAILED at pass3 (tmp/pass3 -> tmp/pass4)" >&2
        exit 1
    fi
    if command -v md5sum >/dev/null 2>&1; then
        HASH3=$(md5sum tmp/pass3 | cut -d' ' -f1)
        HASH4=$(md5sum tmp/pass4 | cut -d' ' -f1)
    else
        HASH3=$(md5 -q tmp/pass3)
        HASH4=$(md5 -q tmp/pass4)
    fi
    if [ "$HASH3" = "$HASH4" ]; then
        echo "Bootstrap complete"
        echo "============================================================"
        exit 0
    else
        echo "Bootstrap NOT converged: pass3 and pass4 differ." >&2
        exit 1
    fi
fi

if [ $TESTING -eq 1 ]; then
    echo "Running PenguinLang Tests ..."
    echo "============================================================"
    dotnet run --configuration Release --project Tests/PenguinTestRunner.csproj -- $OTHERS 2>&1 | ts "%F %T" | tee tmp/test.log
    exit $?
fi

if [ $PUBLISH -eq 1 ]; then
    echo "Publishing self-contained executables + VSCode extension ..."
    echo "============================================================"

    # --- Build native EmperorPenguin binaries via self-bootstrap ---
    if [ ! -f tmp/pass4 ]; then
        echo "Pass 4 binary not found. Run './penguin -b' first." >&2
        exit 1
    fi

    echo "Building Linux EmperorPenguin (tmp/linux/emperor_penguin) ..."
    mkdir -p tmp/linux
    OPT=-O2 tmp/pass4 EmperorPenguin/EmperorPenguin.penguins EmperorPenguin/src/utils.penguin \
        -o tmp/linux/emperor_penguin -vv 2>&1 | ts "%F %T" | tee tmp/publish-linux.log
    if [ $? -ne 0 ]; then
        echo "Publish FAILED: Linux EmperorPenguin build" >&2
        exit 1
    fi

    echo "Building Windows EmperorPenguin (tmp/win64/emperor_penguin.exe) ..."
    mkdir -p tmp/win64
    CC=/opt/llvm-mingw/bin/x86_64-w64-mingw32-clang \
    AR=/opt/llvm-mingw/bin/x86_64-w64-mingw32-ar \
    CLANG=/opt/llvm-mingw/bin/x86_64-w64-mingw32-clang \
    CLANG_FLAGS="-Wl,-subsystem:console" \
    OPT=-O2 \
    tmp/pass4 EmperorPenguin/EmperorPenguin.penguins EmperorPenguin/src/utils.penguin \
        -o tmp/win64/emperor_penguin.exe -vv 2>&1 | ts "%F %T" | tee tmp/publish-win64.log
    if [ $? -ne 0 ]; then
        echo "Publish FAILED: Windows EmperorPenguin cross-compile" >&2
        exit 1
    fi

    # --- Copy emperor_penguin binaries to vscode server directories ---
    cp tmp/linux/emperor_penguin MagellanicPenguin/vscode/server/linux/emperor_penguin
    cp tmp/win64/emperor_penguin.exe MagellanicPenguin/vscode/server/windows/emperor_penguin.exe

    # Publish native, self-contained executables for both targets.
    dotnet publish -r win-x64 --self-contained
    if [ $? -ne 0 ]; then
        echo "Publish FAILED: win-x64 self-contained" >&2
        exit 1
    fi
    dotnet publish -r linux-x64 --self-contained
    if [ $? -ne 0 ]; then
        echo "Publish FAILED: linux-x64 self-contained" >&2
        exit 1
    fi
    # Build the VSCode extension package (subshell keeps this script's cwd intact).
    (cd MagellanicPenguin/vscode && npm run package)
    if [ $? -ne 0 ]; then
        echo "Publish FAILED: vscode extension (npm run package)" >&2
        exit 1
    fi
    echo "Publish complete"
    exit 0
fi

if [ $PASS -eq 1 ]; then
    echo "Running EmperorPenguin Pass 1 (BabyPenguin --backend=cs) ..."
    echo "============================================================"
    mkdir -p tmp
    dotnet run --configuration Release --project BabyPenguin/BabyPenguin.csproj -- -q --backend=cs EmperorPenguin/EmperorPenguin.penguins -- $OTHERS
    exit $?
fi

if [ $PASS -eq 2 ]; then
    echo "Running EmperorPenguin Pass 2 ..."
    echo "============================================================"
    if [ ! -f tmp/pass2 ]; then
        echo "Pass 2 binary not found. Run './penguin -b' first." >&2
        exit 1
    fi
    tmp/pass2 $OTHERS
        exit $?
fi

if [ $PASS -eq 3 ]; then
    echo "Running EmperorPenguin Pass 3 ..."
    echo "============================================================"
    if [ ! -f tmp/pass3 ]; then
        echo "Pass 3 binary not found. Run './penguin -b' first." >&2
        exit 1
    fi
    tmp/pass3 $OTHERS
    exit $?
fi

if [ $PASS -eq 4 ]; then
    echo "Running EmperorPenguin Pass 4 ..."
    echo "============================================================"
    if [ ! -f tmp/pass4 ]; then
        echo "Pass 4 binary not found. Run './penguin -b' first." >&2
        exit 1
    fi
    tmp/pass4 $OTHERS
    exit $?
fi


