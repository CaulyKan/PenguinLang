#!/bin/sh
# Fail the script when a stage command fails, even if it's upstream of a pipe.
# Without this, `$?` after `dotnet ... | ts | tee` is `tee`'s exit code (always 0),
# so a failing pass1/pass2/pass3 is not detected and the bootstrap falsely succeeds.
# (Supported by bash/ksh/zsh/ash; /bin/sh on this system is bash.)
set -o pipefail

PASS=1
BOOTSTRAPPING=0
OTHERS=""
TESTING=0
CLEAN=0
PUBLISH=0
LSP=0
LSPWIN=0

for arg in "$@"; do
  case "$arg" in
    -1) PASS=1 ;;
    -2) PASS=2 ;;
    -3) PASS=3 ;;
    -4) PASS=4 ;;
    -c) CLEAN=1 ;;
    -b) BOOTSTRAPPING=1 ;;
    -t) TESTING=1 ;;
    -p) PUBLISH=1 ;;
    -lsp) LSP=1 ;;
    -win) LSPWIN=1 ;;
    *) OTHERS="$OTHERS $arg" ;;
  esac
done

if [ $CLEAN -eq 1 ]; then
    echo "Cleaning build artifacts ..."
    rm -rf tmp
fi

if [ $BOOTSTRAPPING -eq 1 ]; then
    echo "Bootstrapping EmperorPenguin (BabyPenguin --backend=cs) ..."
    echo "============================================================"
    mkdir -p tmp
    # Pass 1: BabyPenguin lowers+compiles EmperorPenguin to C# and runs it (via the cs backend,
    # ~same order of magnitude as the native passes), which emits LLVM IR + clang -> tmp/pass2.
    # Pass1 builds from EmperorPenguin.penguins (the ANTLR-safe DynlibStub — dyn-lib disabled),
    # so --disable-dl is explicit per the bootstrap contract (pass1/pass2 are not dyn-lib capable).
    dotnet run --configuration Release --project BabyPenguin -- \
        --backend=cs EmperorPenguin/EmperorPenguin.penguins -- \
        EmperorPenguin/EmperorPenguin.penguins EmperorPenguin/src/utils.penguin \
        --disable-dl -vv -enable-meta -o "tmp/pass2" 2>&1 | ts "%F %T" | tee tmp/pass1.log
    if [ $? -ne 0 ]; then
        echo "Bootstrap FAILED at pass1 (BabyPenguin cs backend -> tmp/pass2)" >&2
        exit 1
    fi
    # Pass2 (native) builds pass3 from EmperorPenguinFull.penguins: the json-backed Dynlib +
    # json/vector/hashmap + _utils are part of the compiler, making pass3 the first
    # dyn-lib-capable compiler (--enable-dl default on). pass2 itself is a Full
    # monolith (pass1 built it from the ANTLR-safe stub project, no dynlib), so
    # the lib+exe split can only start FROM pass3.
    # --enable-coroutine is passed ONLY here: pass3 is the first coroutine-capable
    # compiler (ports/channels/scheduler syntax accepted). Wait-free programs (the
    # compiler itself included) emit identical binaries with or without the flag.
    echo "Running Pass 2 with bootstrapping ..."
    tmp/pass2 EmperorPenguin/EmperorPenguinFull.penguins \
        -vv -enable-meta --enable-coroutine -o "tmp/pass3" 2>&1 | ts "%F %T" | tee tmp/pass2.log
    if [ $? -ne 0 ]; then
        echo "Bootstrap FAILED at pass2 (tmp/pass2 -> tmp/pass3)" >&2
        exit 1
    fi
    # Pass4+ are split lib+exe (EmperorPenguinLib/EmperorPenguinExe projects): the
    # whole compiler is a libemperorpenguin.penguin-lib and the CLI driver links it,
    # making dyn-lib load-bearing at compiler scale — every bootstrap exercises the
    # .penguin-lib build/consume path on the compiler's own 16k lines. The exe finds
    # its lib via rpath $ORIGIN (SONAME = lib basename); tmp/pass4 is a symlink into
    # pass4.d so the conventional path keeps working from any cwd. pass5 repeats the
    # stage for the convergence check (exe AND lib md5 equality — the exe alone only
    # contains the CLI driver, so both artifacts are the full fixed-point proof) and
    # is removed afterwards.
    echo "Running Pass 3 (lib) with bootstrapping ..."
    rm -rf tmp/pass4.d tmp/pass5.d
    mkdir -p tmp/pass4.d
    tmp/pass3 EmperorPenguin/EmperorPenguinLib.penguins \
        -vv -enable-meta -o "tmp/pass4.d/libemperorpenguin.penguin-lib" 2>&1 | ts "%F %T" | tee tmp/pass3-lib.log
    if [ $? -ne 0 ]; then
        echo "Bootstrap FAILED at pass3 lib (tmp/pass3 -> tmp/pass4.d/libemperorpenguin.penguin-lib)" >&2
        exit 1
    fi
    echo "Running Pass 3 with bootstrapping ..."
    tmp/pass3 EmperorPenguin/EmperorPenguinExe.penguins \
        -vv -enable-meta --lib tmp/pass4.d/libemperorpenguin.penguin-lib \
        -o "tmp/pass4.d/pass4" 2>&1 | ts "%F %T" | tee tmp/pass3.log
    if [ $? -ne 0 ]; then
        echo "Bootstrap FAILED at pass3 (tmp/pass3 -> tmp/pass4.d/pass4)" >&2
        exit 1
    fi
    ln -sf pass4.d/pass4 tmp/pass4
    echo "Running Pass 4 (lib) with bootstrapping ..."
    mkdir -p tmp/pass5.d
    tmp/pass4 EmperorPenguin/EmperorPenguinLib.penguins \
        -vv -enable-meta -o "tmp/pass5.d/libemperorpenguin.penguin-lib" 2>&1 | ts "%F %T" | tee tmp/pass4-lib.log
    if [ $? -ne 0 ]; then
        echo "Bootstrap FAILED at pass4 lib (tmp/pass4 -> tmp/pass5.d/libemperorpenguin.penguin-lib)" >&2
        exit 1
    fi
    echo "Running Pass 4 with bootstrapping ..."
    tmp/pass4 EmperorPenguin/EmperorPenguinExe.penguins \
        -vv -enable-meta --lib tmp/pass5.d/libemperorpenguin.penguin-lib \
        -o "tmp/pass5.d/pass5" 2>&1 | ts "%F %T" | tee tmp/pass4.log
    if [ $? -ne 0 ]; then
        echo "Bootstrap FAILED at pass4 (tmp/pass4 -> tmp/pass5.d/pass5)" >&2
        exit 1
    fi
    if command -v md5sum >/dev/null 2>&1; then
        HASHEXE4=$(md5sum tmp/pass4.d/pass4 | cut -d' ' -f1)
        HASHEXE5=$(md5sum tmp/pass5.d/pass5 | cut -d' ' -f1)
        HASHLIB4=$(md5sum tmp/pass4.d/libemperorpenguin.penguin-lib | cut -d' ' -f1)
        HASHLIB5=$(md5sum tmp/pass5.d/libemperorpenguin.penguin-lib | cut -d' ' -f1)
    else
        HASHEXE4=$(md5 -q tmp/pass4.d/pass4)
        HASHEXE5=$(md5 -q tmp/pass5.d/pass5)
        HASHLIB4=$(md5 -q tmp/pass4.d/libemperorpenguin.penguin-lib)
        HASHLIB5=$(md5 -q tmp/pass5.d/libemperorpenguin.penguin-lib)
    fi
    if [ "$HASHEXE4" = "$HASHEXE5" ] && [ "$HASHLIB4" = "$HASHLIB5" ]; then
        rm -rf tmp/pass5.d
        echo "Bootstrap complete (exe $HASHEXE4, lib $HASHLIB4)"
        echo "============================================================"
        exit 0
    else
        echo "Bootstrap NOT converged: pass4/pass5 differ (exe: $HASHEXE4 vs $HASHEXE5, lib: $HASHLIB4 vs $HASHLIB5)." >&2
        exit 1
    fi
fi

if [ $LSP -eq 1 ]; then
    if [ $LSPWIN -eq 1 ]; then
        echo "Building Windows LSP server (tmp/win64-lsp/MagellanicPenguinLSP.exe) ..."
        echo "============================================================"
        if [ ! -f tmp/pass4 ]; then
            echo "tmp/pass4 not found. Run './penguin -b' first." >&2
            exit 1
        fi
        # win64 cross build (same env shape as ./penguin -p's win64 compiler):
        # the LspServerWin monolith = LSP modules + the whole compiler in ONE
        # self-contained exe — the Linux dyn-lib pair is ELF-specific (SONAME
        # + $ORIGIN rpath + -rdynamic interposition). No -enable-meta (the
        # Linux LSP carries no JIT either). Windows coroutines & stdio events
        # come from the runtime's fiber scheduler + PeekNamedPipe fd
        # integration (EmperorPenguin/std/c/scheduler.c). The toolchain
        # prefix defaults to llvm-mingw and can be overridden per-variable
        # (WIN_CC/WIN_CXX/WIN_AR/WIN_CLANG).
        mkdir -p tmp/win64-lsp
        CC=${WIN_CC:-/opt/llvm-mingw/bin/x86_64-w64-mingw32-clang} \
        CXX=${WIN_CXX:-/opt/llvm-mingw/bin/x86_64-w64-mingw32-clang++} \
        AR=${WIN_AR:-/opt/llvm-mingw/bin/x86_64-w64-mingw32-ar} \
        CLANG=${WIN_CLANG:-/opt/llvm-mingw/bin/x86_64-w64-mingw32-clang} \
        OPT=-O2 \
        tmp/pass4 MagellanicPenguin/LspServer/LspServerWin.penguins \
            --enable-coroutine -o tmp/win64-lsp/MagellanicPenguinLSP.exe -target=win64
        exit $?
    fi
    echo "Building MagellanicPenguin LSP server (tmp/lsp + tmp/libemperorpenguin.penguin-lib) ..."
    echo "============================================================"
    if [ ! -f tmp/pass3 ]; then
        echo "tmp/pass3 not found. Run './penguin -b' first." >&2
        exit 1
    fi
    # --enable-coroutine: the server is a ports/channels program end to end
    # (StdioStream parks on fd 0/1, modules wait wires/Fifos). The compiler is
    # consumed as libemperorpenguin.penguin-lib (EmperorPenguinLib.penguins):
    # the LSP binary contains only the 10 LSP modules and monomorphizes its own
    # generic instances from the lib's embedded source, so an LSP-only change
    # relinks in seconds while compiler changes rebuild just the lib.
    # e2e tests run the exe via the test runner's Prebuilt backend without
    # recompiling (Tests/LspTest/*.md, Compile.Args=tmp/lsp).
    #
    # Content-addressed caches (LSP_NO_CACHE=1 forces rebuilds):
    #   lib key  = pass3 + EmperorPenguinLib sources + auto-loaded stdlib pair
    #   lsp key  = pass3 + LspServer sources + the lib artifact itself
    # The lib lands NEXT TO tmp/lsp (link_exe stamps rpath $ORIGIN + the lib's
    # basename SONAME), so the pair is relocatable — ./penguin -p copies both.

    # --- Stage 1: the compiler lib ---
    LIB_KEY=""
    LIB_FRESH=0
    if [ -z "$LSP_NO_CACHE" ]; then
        LIB_KEY_INPUT="tmp/pass3 EmperorPenguin/EmperorPenguinLib.penguins"
        for f in $(sed -n 's/^sources=\[\(.*\)\]/\1/p' EmperorPenguin/EmperorPenguinLib.penguins | tr ',' '\n' | sed 's/"//g; s/^[[:space:]]*//; s/[[:space:]]*$//'); do
            if [ -f "EmperorPenguin/$f" ]; then
                LIB_KEY_INPUT="$LIB_KEY_INPUT EmperorPenguin/$f"
            fi
        done
        LIB_KEY_INPUT="$LIB_KEY_INPUT EmperorPenguin/std/penguin/core_builtin.penguin EmperorPenguin/std/penguin/io.penguin"
        LIB_KEY=$(md5sum $LIB_KEY_INPUT 2>/dev/null | md5sum | cut -d' ' -f1)
        if [ -n "$LIB_KEY" ] && [ -f "tmp/lsp-cache/$LIB_KEY/libemperorpenguin.penguin-lib" ]; then
            cp "tmp/lsp-cache/$LIB_KEY/libemperorpenguin.penguin-lib" tmp/libemperorpenguin.penguin-lib
            echo "Compiler lib cache hit ($LIB_KEY) -> copied to tmp/libemperorpenguin.penguin-lib"
            LIB_FRESH=1
        fi
    fi
    if [ $LIB_FRESH -eq 0 ]; then
        tmp/pass3 EmperorPenguin/EmperorPenguinLib.penguins -o tmp/libemperorpenguin.penguin-lib
        LIB_RC=$?
        if [ $LIB_RC -ne 0 ]; then
            echo "LSP build FAILED at compiler lib stage" >&2
            exit 1
        fi
        if [ -n "$LIB_KEY" ]; then
            mkdir -p "tmp/lsp-cache/$LIB_KEY"
            cp tmp/libemperorpenguin.penguin-lib "tmp/lsp-cache/$LIB_KEY/libemperorpenguin.penguin-lib"
            echo "Compiler lib cached as $LIB_KEY"
        fi
    fi

    # --- Stage 2: the LSP exe, linked against the lib ---
    LSP_KEY=""
    if [ -z "$LSP_NO_CACHE" ]; then
        KEY_INPUT="tmp/pass3 MagellanicPenguin/LspServer/LspServer.penguins tmp/libemperorpenguin.penguin-lib"
        for f in $(sed -n 's/^sources=\[\(.*\)\]/\1/p' MagellanicPenguin/LspServer/LspServer.penguins | tr ',' '\n' | sed 's/"//g; s/^[[:space:]]*//; s/[[:space:]]*$//'); do
            if [ -f "MagellanicPenguin/LspServer/$f" ]; then
                KEY_INPUT="$KEY_INPUT MagellanicPenguin/LspServer/$f"
            elif [ -f "$f" ]; then
                KEY_INPUT="$KEY_INPUT $f"
            fi
        done
        KEY_INPUT="$KEY_INPUT EmperorPenguin/std/penguin/core_builtin.penguin EmperorPenguin/std/penguin/io.penguin"
        LSP_KEY=$(md5sum $KEY_INPUT 2>/dev/null | md5sum | cut -d' ' -f1)
        if [ -n "$LSP_KEY" ] && [ -f "tmp/lsp-cache/$LSP_KEY/lsp" ]; then
            cp "tmp/lsp-cache/$LSP_KEY/lsp" tmp/lsp
            echo "LSP cache hit ($LSP_KEY) -> copied to tmp/lsp"
            exit 0
        fi
    fi
    tmp/pass3 --enable-coroutine MagellanicPenguin/LspServer/LspServer.penguins \
        --lib tmp/libemperorpenguin.penguin-lib -o tmp/lsp
    rc=$?
    if [ $rc -eq 0 ] && [ -n "$LSP_KEY" ]; then
        mkdir -p "tmp/lsp-cache/$LSP_KEY"
        cp tmp/lsp "tmp/lsp-cache/$LSP_KEY/lsp"
        echo "LSP cached as $LSP_KEY"
    fi
    exit $rc
fi

if [ $TESTING -eq 1 ]; then
    echo "Running PenguinLang Tests ..."
    echo "============================================================"
    dotnet run --configuration Release --project Tests/PenguinTestRunner.csproj -- $OTHERS 2>&1 | ts "%F %T" | tee tmp/test.log
    exit $?
fi

if [ $PUBLISH -eq 1 ]; then
    echo "Publishing self-contained executables + VSCode extension ..."
    echo "============================================================"

    # --- Build native EmperorPenguin binaries via self-bootstrap ---
    if [ ! -f tmp/pass4 ]; then
        echo "Pass 4 binary not found. Run './penguin -b' first." >&2
        exit 1
    fi

    echo "Building Linux EmperorPenguin (tmp/linux/emperor_penguin) ..."
    mkdir -p tmp/linux
    OPT=-O2 tmp/pass4 EmperorPenguin/EmperorPenguinFull.penguins \
        -enable-meta -o tmp/linux/emperor_penguin -vv 2>&1 | ts "%F %T" | tee tmp/publish-linux.log
    if [ $? -ne 0 ]; then
        echo "Publish FAILED: Linux EmperorPenguin build" >&2
        exit 1
    fi

    echo "Building Windows EmperorPenguin (tmp/win64/emperor_penguin.exe) ..."
    mkdir -p tmp/win64
    # CC/AR/CXX drive the libcore_builtin.a + (optionally) libpenguin_jit.a cross
    # builds; CLANG selects the link-time cross-compiler; -target=win64 tells
    # main.penguin to link for PE/COFF (`-Wl,--stack` for the 32 MB PE stack).
    # When a Windows LLVM is available — either $LLVM_WIN_PREFIX or the in-repo
    # thirdparty/mingw-w64-x86_64-llvm-libs (see its README) — the win64 build
    # also gets -enable-meta: the Makefile builds libpenguin_jit.a for mingw and
    # main.penguin links it against the DLL import lib (with --export-all-symbols
    # so the ORC JIT can resolve host functions). Without it the binary links
    # no-op JIT stubs. lld-link infers the console subsystem from the `main`
    # entry point, so no explicit subsystem flag is needed.
    if [ -z "$LLVM_WIN_PREFIX" ] && [ -f "thirdparty/mingw-w64-x86_64-llvm-libs/lib/libLLVM-22.dll.a" ]; then
        LLVM_WIN_PREFIX="$PWD/thirdparty/mingw-w64-x86_64-llvm-libs"
    fi
    WIN_META=""
    if [ -n "$LLVM_WIN_PREFIX" ]; then
        WIN_META="-enable-meta -llvm-win $LLVM_WIN_PREFIX"
    fi
    CC=/opt/llvm-mingw/bin/x86_64-w64-mingw32-clang \
    CXX=/opt/llvm-mingw/bin/x86_64-w64-mingw32-clang++ \
    AR=/opt/llvm-mingw/bin/x86_64-w64-mingw32-ar \
    CLANG=/opt/llvm-mingw/bin/x86_64-w64-mingw32-clang \
    LLVM_WIN_PREFIX="$LLVM_WIN_PREFIX" \
    OPT=-O2 \
    tmp/pass4 EmperorPenguin/EmperorPenguinFull.penguins \
        -o tmp/win64/emperor_penguin.exe -target=win64 $WIN_META -vv 2>&1 | ts "%F %T" | tee tmp/publish-win64.log
    if [ $? -ne 0 ]; then
        echo "Publish FAILED: Windows EmperorPenguin cross-compile" >&2
        exit 1
    fi

    # --- Copy emperor_penguin binaries to vscode server directories ---
    cp tmp/linux/emperor_penguin MagellanicPenguin/vscode/server/linux/emperor_penguin
    cp tmp/win64/emperor_penguin.exe MagellanicPenguin/vscode/server/windows/emperor_penguin.exe
    # --- PenguinLang-native LSP server (windows): built by './penguin -lsp -win' ---
    # Same deployed layout as the linux side: the exe plus the stdlib bundle
    # beside it (the server's embedded document compiles resolve stdlib via
    # the exe-dir candidate on every platform). The Windows binary is a
    # self-contained monolith — no .penguin-lib to ship.
    if [ -f tmp/win64-lsp/MagellanicPenguinLSP.exe ]; then
        cp tmp/win64-lsp/MagellanicPenguinLSP.exe MagellanicPenguin/vscode/server/windows/MagellanicPenguinLSP.exe
        echo "Copied tmp/win64-lsp/MagellanicPenguinLSP.exe -> MagellanicPenguin/vscode/server/windows/"
        mkdir -p MagellanicPenguin/vscode/server/windows/EmperorPenguin/std
        cp -r EmperorPenguin/std/penguin MagellanicPenguin/vscode/server/windows/EmperorPenguin/std/penguin
        echo "Bundled stdlib -> MagellanicPenguin/vscode/server/windows/EmperorPenguin/std/penguin"
        # Optional runtime smoke test when a Windows emulator is available:
        # WINE=<wine-binary> ./penguin -p (or wine on PATH). A full session
        # from a foreign cwd — initialize, a broken-document didOpen (the
        # parser-panic path exercises the Windows sjlj landing pad) and
        # shutdown/exit — exercises the fiber scheduler, the PeekNamedPipe
        # stdio integration and the exe-dir stdlib discovery in the deployed
        # layout.
        WINE_BIN="${WINE:-wine}"
        if command -v "$WINE_BIN" >/dev/null 2>&1; then
            SMOKE_DIR=$(mktemp -d)
            REPO_ROOT="$PWD"
            printf 'Content-Length: 58\r\n\r\n{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}Content-Length: 172\r\n\r\n{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///smoke/broken.penguin","languageId":"penguin","version":1,"text":"fun broken( {"}}}Content-Length: 44\r\n\r\n{"jsonrpc":"2.0","id":2,"method":"shutdown"}Content-Length: 33\r\n\r\n{"jsonrpc":"2.0","method":"exit"}' \
                | (cd "$SMOKE_DIR" && "$WINE_BIN" "$REPO_ROOT/MagellanicPenguin/vscode/server/windows/MagellanicPenguinLSP.exe" > out.bin 2> err.bin)
            SMOKE_RC=$?
            if [ $SMOKE_RC -ne 0 ] || ! grep -q "definitionProvider" "$SMOKE_DIR/out.bin" 2>/dev/null \
                || ! grep -q "internal compiler error" "$SMOKE_DIR/out.bin" 2>/dev/null; then
                echo "Publish FAILED: Windows LSP smoke test under $WINE_BIN (exit=$SMOKE_RC)" >&2
                cat "$SMOKE_DIR/err.bin" >&2
                rm -rf "$SMOKE_DIR"
                exit 1
            fi
            rm -rf "$SMOKE_DIR"
            echo "Windows LSP smoke test passed (initialize + broken-doc survival + shutdown/exit under $WINE_BIN, foreign cwd)"
        else
            echo "(no wine available: skipped the Windows LSP runtime smoke test — the binary is cross-compile/link-validated only; run it on a Windows host or set WINE=<path>)"
        fi
    else
        echo "tmp/win64-lsp/MagellanicPenguinLSP.exe not found; skipping Windows LSP server (build with './penguin -lsp -win')"
    fi
    # --- PenguinLang-native LSP server (linux): built by './penguin -lsp' ---
    # The extension's client picks PENGUINLANG_LSPSERVER_PATH first, else the
    # bundled server/<platform>/MagellanicPenguinLSP binary (the C# server on
    # win32; the native one on linux when present).
    if [ -f tmp/lsp ]; then
        if [ ! -f tmp/libemperorpenguin.penguin-lib ]; then
            echo "Publish FAILED: tmp/lsp exists but tmp/libemperorpenguin.penguin-lib is missing (the exe links it via rpath \$ORIGIN). Run './penguin -lsp' first." >&2
            exit 1
        fi
        mkdir -p MagellanicPenguin/vscode/server/linux
        cp tmp/lsp MagellanicPenguin/vscode/server/linux/MagellanicPenguinLSP
        echo "Copied tmp/lsp -> MagellanicPenguin/vscode/server/linux/MagellanicPenguinLSP"
        # The compiler lib the exe links (SONAME libemperorpenguin.penguin-lib,
        # rpath \$ORIGIN): must sit BESIDE the binary in the deployed layout.
        cp tmp/libemperorpenguin.penguin-lib MagellanicPenguin/vscode/server/linux/libemperorpenguin.penguin-lib
        echo "Copied tmp/libemperorpenguin.penguin-lib -> MagellanicPenguin/vscode/server/linux/"
        # Bundle the stdlib beside the binary: the server's embedded document
        # compiles look it up at <exe_dir>/EmperorPenguin/std/penguin (one of
        # load_stdlib_text's candidates), so an installed extension analyzes
        # documents without the repo.
        mkdir -p MagellanicPenguin/vscode/server/linux/EmperorPenguin/std
        cp -r EmperorPenguin/std/penguin MagellanicPenguin/vscode/server/linux/EmperorPenguin/std/penguin
        echo "Bundled stdlib -> MagellanicPenguin/vscode/server/linux/EmperorPenguin/std/penguin"
        # Smoke test the BUNDLED server from a foreign cwd (no repo): a full
        # session must answer capabilities, survive opening a broken document
        # (the parser-panic path exercises the sjlj try/catch landing pad —
        # publishing an 'internal compiler error' diagnostic, not dying) and
        # exit 0 — this proves the exe-dir stdlib discovery AND the rpath
        # $ORIGIN lib load work in a deployed layout.
        SMOKE_DIR=$(mktemp -d)
        REPO_ROOT="$PWD"
        printf 'Content-Length: 58\r\n\r\n{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}Content-Length: 172\r\n\r\n{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///smoke/broken.penguin","languageId":"penguin","version":1,"text":"fun broken( {"}}}Content-Length: 44\r\n\r\n{"jsonrpc":"2.0","id":2,"method":"shutdown"}Content-Length: 33\r\n\r\n{"jsonrpc":"2.0","method":"exit"}' \
            | (cd "$SMOKE_DIR" && "$REPO_ROOT/MagellanicPenguin/vscode/server/linux/MagellanicPenguinLSP" > out.bin 2> err.bin)
        SMOKE_RC=$?
        if [ $SMOKE_RC -ne 0 ] || ! grep -q "definitionProvider" "$SMOKE_DIR/out.bin" 2>/dev/null \
            || ! grep -q "internal compiler error" "$SMOKE_DIR/out.bin" 2>/dev/null; then
            echo "Publish FAILED: bundled LSP smoke test (exit=$SMOKE_RC)" >&2
            cat "$SMOKE_DIR/err.bin" >&2
            rm -rf "$SMOKE_DIR"
            exit 1
        fi
        rm -rf "$SMOKE_DIR"
        echo "Bundled LSP smoke test passed (initialize + broken-doc survival + shutdown/exit from a foreign cwd)"
    else
        echo "tmp/lsp not found; skipping native LSP server (build with './penguin -lsp')"
    fi
    # Windows meta JIT runtime DLLs ride along in the vscode windows server dir
    # (only the three LLVM DLLs are vendored in thirdparty/mingw-w64-x86_64-llvm-libs/bin;
    # their own deps — libc++/libffi/zlib/zstd/libxml2/winpthread — must be staged
    # from the MSYS2 clang64 bin for the meta exe to actually run).
    if [ -d "thirdparty/mingw-w64-x86_64-llvm-libs/bin" ]; then
        cp thirdparty/mingw-w64-x86_64-llvm-libs/bin/*.dll MagellanicPenguin/vscode/server/windows/
    fi

    # Publish native, self-contained executables for both targets.
    dotnet publish -r win-x64 --self-contained
    if [ $? -ne 0 ]; then
        echo "Publish FAILED: win-x64 self-contained" >&2
        exit 1
    fi
    dotnet publish -r linux-x64 --self-contained
    if [ $? -ne 0 ]; then
        echo "Publish FAILED: linux-x64 self-contained" >&2
        exit 1
    fi
    # Build the VSCode extension package (subshell keeps this script's cwd intact).
    (cd MagellanicPenguin/vscode && npm run package)
    if [ $? -ne 0 ]; then
