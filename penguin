#!/bin/sh

PASS=1
BOOTSTRAPPING=0
OTHERS=""
TESTING=0

for arg in "$@"; do
  case "$arg" in
    -1) PASS=1 ;;
    -2) PASS=2 ;;
    -3) PASS=3 ;;
    -4) PASS=4 ;;
    -b) BOOTSTRAPPING=1 ;;
    -t) TESTING=1 ;;
    *) OTHERS="$OTHERS $arg" ;;
  esac
done

if [ $BOOTSTRAPPING -eq 1 ]; then
    echo "Bootstrapping mode enabled. Running Pass 1 with bootstrapping ..."
    mkdir -p tmp
    dotnet run --configuration Release --project BabyPenguin -- \
        EmperorPenguin/EmperorPenguin.penguins -- \
        EmperorPenguin/EmperorPenguin.penguins \
        -vv -o "tmp/pass2"
    echo "Running Pass 2 with bootstrapping ..."
    tmp/pass2 EmperorPenguin/EmperorPenguin.penguins \
        -vv -o "tmp/pass3"
    exit $?
fi

if [ $TESTING -eq 1 ]; then
    echo "Running PenguinLang Tests ..."
    dotnet run --configuration Release --project Tests/PenguinTestRunner.csproj -- $OTHERS
    exit $?
fi

if [ $PASS -eq 1 ]; then
    echo "Running EmperorPenguin Pass 1 ..."
    rm -rf tmp && mkdir -p tmp
    dotnet run --configuration Release --project BabyPenguin/BabyPenguin.csproj -- -q EmperorPenguin/EmperorPenguin.penguins -- $OTHERS
fi

if [ $PASS -eq 2 ]; then
    echo "Running EmperorPenguin Pass 2 ..."
    if [ ! -f tmp/pass2 ]; then
        echo "Pass 2 binary not found. Run './penguin -b' first." >&2
        exit 1
    fi
    tmp/pass2 $OTHERS
fi

if [ $PASS -eq 3 ]; then
    echo "Running EmperorPenguin Pass 3 ..."
    if [ ! -f tmp/pass3 ]; then
        echo "Pass 3 binary not found. Run './penguin -b' first." >&2
        exit 1
    fi
    tmp/pass3 $OTHERS
fi


