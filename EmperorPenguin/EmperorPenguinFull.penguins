[Project]
# Full compiler build: the json-backed Dynlib module + the pass3-only stdlib
# sources (json/vector/hashmap + _utils). Used ONLY by the bootstrap's
# pass2→pass3 and pass3→pass4 steps (./penguin -b) so the produced pass3/pass4
# compiler has dyn-lib support. Compiled by the native parser (pass2+), which
# handles the `#` meta constructs in json/vector/hashmap — never by BabyPenguin
# (pass1), which is why the default EmperorPenguin.penguins uses DynlibStub.
name="EmperorPenguinFull"
sources=["src/ast/AST.penguin", "src/ast/Lexer.penguin", "src/ast/Parser.penguin", "src/ast/SourceLocation.penguin", "src/ast/Token.penguin", "src/bound/BoundCompilationUnit.penguin", "src/bound/BoundDefinition.penguin", "src/bound/BoundExpression.penguin", "src/bound/BoundScope.penguin", "src/bound/BoundStatement.penguin", "src/bound/BoundSymbol.penguin", "src/bound/BoundTreePrinter.penguin", "src/bound/BoundType.penguin", "src/bound/BoundTypeRegistry.penguin", "src/bound/EmperorPenguinCompiler.penguin", "src/bound/SemanticModel.penguin", "src/ir/IRBuilder.penguin", "src/ir/IRFunction.penguin", "src/ir/IRGenerator.penguin", "src/ir/IRInstruction.penguin", "src/ir/IRModule.penguin", "src/ir/IRPrinter.penguin", "src/ir/IRSourceLocation.penguin", "src/ir/IRValue.penguin", "src/llvm/LLVMCompiler.penguin", "src/llvm/LLVMEmitter.penguin", "src/meta/MetaEngine.penguin", "src/meta/MetaHost.penguin", "src/project/CompilerConfig.penguin", "src/project/ErrorCode.penguin", "src/project/Project.penguin", "src/utils.penguin", "std/penguin/json.penguin", "std/penguin/vector.penguin", "std/penguin/hashmap.penguin", "std/penguin/array.penguin", "std/penguin/dynlib.penguin", "main.penguin"]
