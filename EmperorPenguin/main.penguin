namespace emperor {

// Thin driver. Argument parsing lives in CompilerConfig; the IR/lowering in
// LLVMCompiler; the .penguin-lib loading/validation/metadata in Dynlib. This
// file only orchestrates: parse -> load lib chain -> assemble sources ->
// compile -> validate (lib) -> emit LLVM IR (.ll). LINKING is external (the
// emperor / emperor_penguin.bat driver scripts run clang + the C runtime make) so the
// emitted IR is platform-independent and each platform just links it.

// Locate an auto-loaded stdlib source (core_builtin / io / scheduler*):
// beside the compiler executable FIRST — a released compiler always compiles
// against the std tree shipped next to the emitter (build/<platform>/, the
// vscode extension's server/<platform>/), never against whatever std sources
// happen to surround it on the machine (version-skew hazard: a deployed
// binary mixing with a mismatched source tree). The std dynlib follows the
// same rule (--enable-std auto-probes libemperorpenguin-std.penguin-lib
// beside the exe, no filesystem search). The cwd (dev + bootstrap
// invocations run from the repo root) and an upward walk from the exe dir
// (in-repo build dirs) remain as fallbacks for binaries deployed WITHOUT a
// bundled tree — the bootstrap passes, the dotnet VM. Same candidate set as
// the LSP's load_stdlib_text (MagellanicPenguin/LspServer/
// LspCompilationUnit.penguin), prioritized for self-contained deploys.
fun locate_stdlib_source(name: string) -> string {
    let candidates: mut _utils.List<string> = new _utils.List<string>();
    let exe_dir: string = compiler_exe_dir();
    candidates.push(exe_dir + "/EmperorPenguin/std/penguin/" + name);
    candidates.push("EmperorPenguin/std/penguin/" + name);
    let dir: mut string = exe_dir;
    let hops: mut i64 = 0;
    while (hops < 12) {
        let parent: string = get_parent_dir(dir);
        if (parent == dir || parent == ".") { break; }
        dir = parent;
        candidates.push(dir + "/EmperorPenguin/std/penguin/" + name);
        hops = hops + 1;
    }
    let i: mut i64 = 0;
    while (i < cast<i64>(candidates.size())) {
        let path: string = candidates.at(cast<u64>(i)).some;
        if (_utils.file_exists(path)) {
            return _utils.file_read_text(path);
        }
        i = i + 1;
    }
    __builtin.eprintln("[EmperorPenguin] Error: cannot locate stdlib source '" + name + "' — looked beside the compiler executable (" + exe_dir + "), in the working directory and the exe dir's parents. Run from the repo root, or deploy EmperorPenguin/std/penguin beside the emitter.");
    __builtin.exit(1);
    return "";
}

initial {
    let args: _utils.List<string> = _utils.args();
    if (args.size() == 0) {
        __builtin.eprintln("Usage: EmperorPenguin [options] <file.penguins | file1.penguin [file2.penguin ...]>");
        __builtin.eprintln("       Emits LLVM IR only: -o X -> X.ll (+ X.def); -o X.penguin-lib -> X.ll + X.libmeta.");
        __builtin.eprintln("       Run with --help for the option list (or emperor_penguin --help for the full");
        __builtin.eprintln("       driver documentation, incl. link modes).");
        __builtin.exit(1);
    }

    let mut config = new CompilerConfig();
    config.parse(args);
    if (config.help_requested) {
        __builtin.eprintln("Usage: EmperorPenguin [options] <file.penguins | file1.penguin [file2.penguin ...]>");
        __builtin.eprintln("Options:");
        __builtin.eprintln("  -o <output>       output base; X.penguin-lib triggers dyn-lib (lib) mode");
        __builtin.eprintln("  -v / -vv / -vvv   verbosity");
        __builtin.eprintln("  --enable-coroutine / --disable-coroutine   concurrency syntax + scheduler stdlib (default: on)");
        __builtin.eprintln("  --enable-multithread-scheduler             load the multi-thread scheduler, free-form policy (scheduler_free.penguin): no virtual clock, immediate components, AsyncQueue (default: off)");
        __builtin.eprintln("  --enable-clock-model                       with --enable-multithread-scheduler: the clock model (scheduler_mt.penguin) -- virtual clock, convergence-delta ticks; alone it is an error");
        __builtin.eprintln("  -Wconcurrency                               with the mt scheduler: per-site stealable/pinned diagnostics");
        __builtin.eprintln("  --enable-std / --disable-std               auto-load libemperorpenguin-std.penguin-lib beside the compiler (default: on)");
        __builtin.eprintln("  --enable-dl / --disable-dl                 dyn-lib build/consume (default: on)");
        __builtin.eprintln("  --lib <file.penguin-lib>                   consume a dyn-lib (repeatable; deps resolved recursively)");
        __builtin.eprintln("  --libmeta=text|direct                      libmeta ingestion mode (default: direct)");
        __builtin.eprintln("  --define A=B / --meta-src <file>           compile-time option store / explicit unit-B meta sources");
        __builtin.eprintln("  -g / --debug                               emit DWARF debug info (function/line/variable) into the .ll");
        __builtin.eprintln("  --enable-meta, -target=, -llvm-win=        link-time flags (parsed here, honored by the external driver)");
        __builtin.eprintln("Emits LLVM IR only: -o X -> X.ll (+ X.def/.libs); -o X.penguin-lib -> X.ll + X.libmeta.");
        __builtin.eprintln("Linking is external (emperor_penguin / emperor_penguin.bat; see their --help).");
        __builtin.exit(0);
    }
    if (config.source_files.size() == 0) {
        __builtin.eprintln("Error: no source files specified");
        __builtin.exit(1);
    }
    // Project-file lib/flags pre-scan: a .penguins may carry lib = [...] and
    // flags = [...]; both take effect BEFORE the dyn-lib checks below
    // (project libs flow into lib_paths; relative lib paths resolve against
    // the project dir). Project flags re-enter parse() after the CLI was
    // consumed, so on a conflicting toggle/value the PROJECT file wins — keep
    // project flags to options the command line does not restate. Only
    // '-'-prefixed tokens are honored (a project file can never inject
    // source files).
    {
        let pscan: mut i64 = 0;
        while (pscan < cast<i64>(config.source_files.size())) {
            let pfile: string = config.source_files.at(cast<u64>(pscan)).some;
            if (string_ends_with(pfile, ".penguins")) {
                let pproj: mut PenguinProject = PenguinProject.load(pfile);
                let pdir: string = get_parent_dir(pfile);
                let plib: mut i64 = 0;
                while (plib < cast<i64>(pproj.libs.size())) {
                    let libp : mut string = pproj.libs.at(cast<u64>(plib)).some;
                    if (string_length(libp) > 0 && string_char_at(libp, 0) != "/") {
                        libp = path_combine(pdir, libp);
                    }
                    config.lib_paths.push(libp);
                    if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Project] lib: " + libp); }
                    plib = plib + 1;
                }
                if (cast<i64>(pproj.flags.size()) > 0) {
                    if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Project] applying project flags"); }
                    config.parse(pproj.flags);
                }
                // meta-sources=[...]: the compile-time (unit B) file list.
                // Patterns resolve against the project dir (same glob rules
                // as sources) and merge into --meta-src (exact-path dedup).
                if (cast<i64>(pproj.meta_sources.size()) > 0) {
                    let mres: mut _utils.List<string> = pproj.resolve_meta_sources(pdir);
                    let rmi: mut i64 = 0;
                    while (rmi < cast<i64>(mres.size())) {
                        let mpath: string = mres.at(cast<u64>(rmi)).some;
                        let dup: mut bool = false;
                        let di: mut i64 = 0;
                        while (di < cast<i64>(config.meta_source_files.size())) {
                            if (config.meta_source_files.at(cast<u64>(di)).some == mpath) {
                                dup = true;
                            }
                            di = di + 1;
                        }
                        if (!dup) {
                            config.meta_source_files.push(mpath);
                            if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Project] meta source: " + mpath); }
                        }
                        rmi = rmi + 1;
                    }
                }
            }
            pscan = pscan + 1;
        }
    }
    // The clock model currently exists only on the multi-thread scheduler
    // (a classic-scheduler implementation is possible in principle, but not
    // built): --enable-clock-model without the mt kernel is a hard error,
    // not a silent fallback. Checked after the project pre-scan so a
    // .penguins flags=[...] is covered too.
    if (config.clock_model_enabled && !config.multithread_scheduler_enabled) {
        __builtin.eprintln("EmperorPenguin clock model is supported only in multithread-scheduler");
        __builtin.exit(1);
    }

    // Dyn-lib capability: --enable-dl (default on) is a plain config bool, and
    // dynlib_available() reports whether THIS compiler binary was built with the
    // json-backed Dynlib (only the pass3+ binary from EmperorPenguinPass2.penguins
    // is). Either being false disables building/consuming .penguin-lib files.
    if (config.is_lib_mode() && (!config.dl_enabled || !dynlib_available())) {
        __builtin.eprintln("[EmperorPenguin] Error: building a .penguin-lib requires --enable-dl and a dyn-lib-capable compiler (pass3+ built from EmperorPenguinPass2.penguins)");
        __builtin.exit(1);
    }
    if (config.lib_paths.size() > 0 && (!config.dl_enabled || !dynlib_available())) {
        __builtin.eprintln("[EmperorPenguin] Error: --lib requires --enable-dl and a dyn-lib-capable compiler (pass3+ built from EmperorPenguinPass2.penguins)");
        __builtin.exit(1);
    }

    // Auto-std: with std enabled (default) and this binary dyn-lib-capable,
    // load the std dynlib sitting beside the compiler executable — the
    // released layout ships emitter + libemperorpenguin.penguin-lib +
    // libemperorpenguin-std.penguin-lib together, so plain user invocations
    // get json/vector/hashmap/array/argparse without listing sources. Skipped
    // silently when the file is absent (bootstrap passes, the BabyPenguin VM,
    // Windows monoliths) or when a --lib entry already names it (explicit
    // paths win; the loader dedups by lib name anyway).
    if (config.std_enabled && config.dl_enabled && dynlib_available()) {
        let std_lib: string = compiler_exe_dir() + "/libemperorpenguin-std.penguin-lib";
        if (_utils.file_exists(std_lib)) {
            let std_named: mut bool = false;
            let sai: mut i64 = 0;
            while (sai < cast<i64>(config.lib_paths.size())) {
                if (_get_base_name(config.lib_paths.at(cast<u64>(sai)).some) == "libemperorpenguin-std.penguin-lib") {
                    std_named = true;
                }
                sai = sai + 1;
            }
            if (!std_named) {
                config.lib_paths.push(std_lib);
                if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin] Auto-std: " + std_lib); }
            }
        }
    }

    // Load the --lib chain (deps recursively, deps-first). On any unresolvable
    // dependency the loader has already reported it; abort here.
    let lib_state: mut LibLoadState = new LibLoadState();
    if (config.lib_paths.size() > 0) {
        lib_state = load_lib_chain(config.lib_paths, compiler_exe_dir());
        if (lib_state.has_error) {
            __builtin.exit(1);
        }
    }

    let stdlib_source: string = locate_stdlib_source("core_builtin.penguin");
    // io stdlib (console/stdin/stdout, io.File handles, whole-file + fs ops) —
    // auto-loaded on the same path as core_builtin, so every compiled program
    // sees the `io` namespace. Unreferenced externs are dropped by the emitter,
    // so non-io programs pay nothing for it.
    let io_source: string = locate_stdlib_source("io.penguin");
    // Scheduler stdlib (the coroutine/concurrency runtime: the C-microkernel
    // externs, IFuture/timers/async futures, channels + Event, and the
    // delta-round policy loop __sched_run) — auto-loaded ONLY with
    // --enable-coroutine. The concurrency syntax is flag-gated by the
    // semantic model, so flag-off programs never reference any of it; loading
    // it conditionally keeps their compilations (and binaries) free of the
    // scheduler surface entirely.
    let sched_source: mut string = "";
    if (config.coroutine_enabled) {
        // --enable-multithread-scheduler loads the multi-thread kernel's
        // FREE-FORM policy (scheduler_free.penguin); adding
        // --enable-clock-model loads the CLOCK MODEL policy
        // (scheduler_mt.penguin) instead — virtual clock + convergence-
        // delta loop. The surface (names, IFuture, channels, __sched_run)
        // is identical across policies, so the emitter and the wait
        // lowering need no changes. The SourceInput name stays
        // "scheduler.penguin" so diagnostics and libmeta naming are
        // unaffected by which policy file is loaded.
        if (config.clock_model_enabled) {
            sched_source = locate_stdlib_source("scheduler_mt.penguin");
        } else if (config.multithread_scheduler_enabled) {
            sched_source = locate_stdlib_source("scheduler_free.penguin");
        } else {
            sched_source = locate_stdlib_source("scheduler.penguin");
        }
    }

    // Output layout: the emitter writes a platform-independent .ll plus a
    // side file next to the -o path (no linking happens in-process):
    //   exe mode  -o X              -> X.ll  + X.def (lld-link export table)
    //   lib mode  -o X.penguin-lib  -> X.ll  + X.libmeta (the JSON metadata
    //                                   the driver script appends to the
    //                                   linked .so, see link-lib there)
    // Without -o the default base is "out" in the current directory.
    let out_base: mut string = "out";
    if (string_length(config.output_name) > 0) {
        out_base = config.output_name;
        if (config.is_lib_mode()) {
            let lidx: i64 = string_find(out_base, ".penguin-lib");
            if (lidx >= 0) {
                out_base = string_substring(out_base, 0, lidx);
            }
        }
        let last_slash: mut i64 = -1;
        let pos: mut i64 = string_find(out_base, "/");
        while (pos >= 0) {
            last_slash = pos;
            pos = string_find_from(out_base, "/", pos + 1);
        }
        if (last_slash > 0) {
            _utils.mkdir(string_substring(out_base, 0, last_slash));
        }
    }
    let ll_path: string = out_base + ".ll";

    let inputs: mut _utils.List<SourceInput> = new _utils.List<SourceInput>();
    inputs.push(new SourceInput("core_builtin.penguin", stdlib_source));
    inputs.push(new SourceInput("io.penguin", io_source));
    if (config.coroutine_enabled) {
        inputs.push(new SourceInput("scheduler.penguin", sched_source));
    }

    // Lib sources first (deps-first order from load_lib_chain), then user
    // sources. For a lib build, lib_files accumulates the lib's OWN source
    // files (name + verbatim text, embedded into its metadata so consumers get
    // per-file SourceInputs — original file namespaces preserved — and can
    // monomorphize NEW generic instances from the #fun/#template bodies) —
    // loaded dep-lib sources are NOT re-embedded.
    let lib_files: mut _utils.List<LibFile> = new _utils.List<LibFile>();
    let use_direct_libmeta: bool = config.libmeta_mode == "direct";
    let si: mut i64 = 0;
    while (si < cast<i64>(lib_state.sources.size())) {
        let src: SourceInput = lib_state.sources.at(cast<u64>(si)).some;
        // Direct injection: the materialized decl pseudo-file is replaced by
        // an empty slot input that only records the def index where the
        // injector splices the prebuilt symbols (keeping def order — and the
        // emitted .ll — identical to --libmeta=text).
        let is_decl_file: bool = string_length(src.filename) > 10 && string_substring(src.filename, 0, 10) == "<libdecls:";
        if (use_direct_libmeta && is_decl_file) {
            let slot_input: mut SourceInput = new SourceInput(src.filename, "");
            slot_input.is_lib = true;
            slot_input.is_lib_decl_slot = true;
            inputs.push(slot_input);
            if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Dynlib] Libmeta decl slot (direct injection): " + src.filename); }
            si = si + 1;
            continue;
        }
        let lib_input: mut SourceInput = new SourceInput(src.filename, src.source);
        lib_input.is_lib = true;
        inputs.push(lib_input);
        if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Dynlib] Merged lib source: " + src.filename); }
        si = si + 1;
    }
    // --meta-src / meta-sources: the EXPLICIT unit-B file list. Read each
    // listed file independently (it need not be one of the compilation's own
    // sources); unreadable paths warn and are skipped so a typo never
    // silently degrades a #fun into a resolve error.
    let user_meta_inputs: mut _utils.List<SourceInput> = new _utils.List<SourceInput>();
    {
        let mi: mut i64 = 0;
        while (mi < cast<i64>(config.meta_source_files.size())) {
            let mfile: string = config.meta_source_files.at(cast<u64>(mi)).some;
            let msource: string = _utils.file_read_text(mfile);
            if (string_length(msource) > 0) {
                user_meta_inputs.push(new SourceInput(mfile, msource));
            } else {
                __builtin.eprintln("[EmperorPenguin] Warning: --meta-src file not readable (skipped): " + mfile);
            }
            mi = mi + 1;
        }
    }
    let fi: mut i64 = 0;
    while (fi < cast<i64>(config.source_files.size())) {
        let file: string = config.source_files.at(cast<u64>(fi)).some;
        if (string_ends_with(file, ".penguins")) {
            let proj: mut PenguinProject = PenguinProject.load(file);
            let project_dir: string = get_parent_dir(file);
            let resolved: mut _utils.List<string> = proj.resolve_sources(project_dir);
            let project_file_index: mut i64 = 0;
            while (project_file_index < cast<i64>(resolved.size())) {
                let proj_file: string = resolved.at(cast<u64>(project_file_index)).some;
                let source: string = _utils.file_read_text(proj_file);
                inputs.push(new SourceInput(proj_file, source));
                if (config.is_lib_mode()) {
                    let lf: mut LibFile = new LibFile();
                    lf.name = proj_file;
                    lf.text = source;
                    lib_files.push(lf);
                }
                if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Project] Adding source: " + proj_file); }
                project_file_index = project_file_index + 1;
            }
        } else {
            let source: string = _utils.file_read_text(file);
            inputs.push(new SourceInput(file, source));
            if (config.is_lib_mode()) {
                let lf2: mut LibFile = new LibFile();
                lf2.name = file;
                lf2.text = source;
                lib_files.push(lf2);
            }
            if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Project] Adding source: " + file); }
        }
        fi = fi + 1;
    }

    if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin] Compiling " + cast<string>(config.source_files.size()) + " source files..."); }

    _utils.trace_set_verbose(config.verbose);
    let mut compiler = new EmperorPenguinCompiler();
    compiler.verbose = config.verbose;
    compiler.enable_coroutine = config.coroutine_enabled;
    compiler.enable_mt_scheduler = config.multithread_scheduler_enabled || config.clock_model_enabled;
    compiler.warn_concurrency = config.warn_concurrency;
    compiler.strict_handoff = config.strict_handoff;
    compiler.meta_user_inputs = user_meta_inputs;
    compiler.cli_define_keys = config.cli_define_keys;
    compiler.cli_define_values = config.cli_define_values;
    // Dyn-lib routing data: shipped instances (the lib-source boundary is set
    // via SourceInput.is_lib on the merged inputs, counted in compile_sources).
    let lii: mut i64 = 0;
    while (lii < cast<i64>(lib_state.instances.size())) {
        compiler.lib_instances.push(lib_state.instances.at(cast<u64>(lii)).some);
        lii = lii + 1;
    }
    if (use_direct_libmeta) {
        let mdi: mut i64 = 0;
        while (mdi < cast<i64>(lib_state.meta_docs.size())) {
            compiler.prebuilt_lib_metas.push(lib_state.meta_docs.at(cast<u64>(mdi)).some);
            mdi = mdi + 1;
        }
    }
    let result = compiler.compile_sources(inputs);

    if (result.has_errors()) {
        __builtin.eprintln("[EmperorPenguin] Compilation failed with " + cast<string>(result.errors.size()) + " errors:");
        let ei: mut i64 = 0;
        while (ei < cast<i64>(result.errors.size())) {
            let err: SemanticError = result.errors.at(cast<u64>(ei)).some;
            let loc_txt: mut string = "";
            if (string_length(err.location.filename) > 0 || err.location.line > 0) {
                loc_txt = " (at " + err.location.filename + ":" + cast<string>(err.location.line) + "," + cast<string>(err.location.col) + ")";
            }
            __builtin.eprintln("  error[" + error_code_name(err.code) + "]: " + err.message + loc_txt);
            ei = ei + 1;
        }
        __builtin.exit(1);
    }

    let lc: mut LLVMCompiler = new LLVMCompiler();
    lc.verbose = config.verbose;
    lc.debug_info = config.debug_info;
    if (config.is_lib_mode()) {
        // A lib may not emit @main / initialized globals.
        if (!validate_lib_defs(result)) {
            __builtin.exit(1);
        }
        let instances: _utils.List<string> = collect_instances(result);
        let lib_name: mut string = config.output_name;
        let lidx: i64 = string_find(config.output_name, ".penguin-lib");
        if (lidx >= 0) { lib_name = string_substring(config.output_name, 0, lidx); }
        lib_name = _get_base_name(lib_name);
        let lib_meta: string = serialize_symbols(result, lib_name, 1, lib_state.lib_names, instances, lib_files, config.verbose);
        // The metadata blob must be a real JSON document (never empty): a stub
        // build's serialize_symbols returns "" and must not produce a corrupt
        // lib.
        if (string_length(lib_meta) == 0) {
            __builtin.eprintln("[EmperorPenguin] Error: no metadata produced (dynamic linking unavailable in this compiler build)");
            __builtin.exit(1);
        }
        if (!lc.build_ll(result, ll_path)) { __builtin.exit(1); }
        let libmeta_path: string = out_base + ".libmeta";
        _utils.file_write_text(libmeta_path, lib_meta);
        if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin] Wrote " + libmeta_path + " (" + cast<string>(string_length(lib_meta)) + " bytes)"); }
    } else {
        if (!lc.build_ll(result, ll_path)) { __builtin.exit(1); }
        let def_path: string = out_base + ".def";
        lc.write_export_def(ll_path, def_path);
        if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin] Wrote " + def_path); }
        // The consumer dyn-lib closure (deps-first from load_lib_chain —
        // includes libs reached only through another lib's deps, which the
        // command line never named). The driver script links every path
        // listed here beside the .ll.
        let libs_path: string = out_base + ".libs";
        let libs_text: mut string = "";
        let spi: mut i64 = 0;
        while (spi < cast<i64>(lib_state.so_paths.size())) {
            libs_text = libs_text + lib_state.so_paths.at(cast<u64>(spi)).some + "\n";
            spi = spi + 1;
        }
        _utils.file_write_text(libs_path, libs_text);
        if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin] Wrote " + libs_path); }
    }
}

}
