namespace emperor {

// Thin driver. Argument parsing lives in CompilerConfig; the IR/lower/link
// pipeline in LLVMCompiler; the .penguin-lib loading/validation/metadata in
// Dynlib. This file only orchestrates: parse -> load lib chain -> assemble
// sources -> compile -> validate (lib) -> link (exe or lib).
initial {
    let args: _utils.List<string> = _utils.args();
    if (args.size() == 0) {
        __builtin.eprintln("Usage: EmperorPenguin [-v|-vv|-vvv] [-o output] <file.penguins | file1.penguin [file2.penguin ...]>");
        __builtin.exit(1);
    }

    let mut config = new CompilerConfig();
    config.parse(args);
    if (config.source_files.size() == 0) {
        __builtin.eprintln("Error: no source files specified");
        __builtin.exit(1);
    }
    // Dyn-lib capability: --enable-dl (default on) is a plain config bool, and
    // dynlib_available() reports whether THIS compiler binary was built with the
    // json-backed Dynlib (only the pass3+ binary from EmperorPenguinFull.penguins
    // is). Either being false disables building/consuming .penguin-lib files.
    if (config.is_lib_mode() && (!config.dl_enabled || !dynlib_available())) {
        __builtin.eprintln("[EmperorPenguin] Error: building a .penguin-lib requires --enable-dl and a dyn-lib-capable compiler (pass3+ built from EmperorPenguinFull.penguins)");
        __builtin.exit(1);
    }
    if (config.lib_paths.size() > 0 && (!config.dl_enabled || !dynlib_available())) {
        __builtin.eprintln("[EmperorPenguin] Error: --lib requires --enable-dl and a dyn-lib-capable compiler (pass3+ built from EmperorPenguinFull.penguins)");
        __builtin.exit(1);
    }

    // Load the --lib chain (deps recursively, deps-first). On any unresolvable
    // dependency the loader has already reported it; abort here.
    let lib_state: mut LibLoadState = new LibLoadState();
    if (config.lib_paths.size() > 0) {
        lib_state = load_lib_chain(config.lib_paths, compiler_exe_dir());
        if (lib_state.has_error) {
            __builtin.exit(1);
        }
    }

    let stdlib_source: string = _utils.file_read_text("EmperorPenguin/std/penguin/core_builtin.penguin");

    // Build intermediates go into a per-process unique temp directory so that
    // parallel EmperorPenguin invocations never collide on a shared path.
    let tmp_dir: mut string = _utils.get_temp_folder();
    // The final output defaults into that same isolated directory; -o overrides
    // only the output location (intermediates always stay isolated).
    let exe_path: mut string = tmp_dir + "/out.exe";
    if (string_length(config.output_name) > 0) {
        exe_path = config.output_name;
        let last_slash: mut i64 = -1;
        let pos: mut i64 = string_find(config.output_name, "/");
        while (pos >= 0) {
            last_slash = pos;
            pos = string_find_from(config.output_name, "/", pos + 1);
        }
        if (last_slash > 0) {
            _utils.mkdir(string_substring(config.output_name, 0, last_slash));
        }
    }

    let inputs: mut _utils.List<SourceInput> = new _utils.List<SourceInput>();
    inputs.push(new SourceInput("core_builtin.penguin", stdlib_source));

    // Lib sources first (deps-first order from load_lib_chain), then user
    // sources. For a lib build, lib_source_text accumulates the lib's OWN source
    // (embedded verbatim into its metadata so consumers get the #fun/#template
    // bodies) — loaded dep-lib sources are NOT re-embedded.
    let lib_source_text: mut string = "";
    let si: mut i64 = 0;
    while (si < cast<i64>(lib_state.sources.size())) {
        let src: SourceInput = lib_state.sources.at(cast<u64>(si)).some;
        let lib_input: mut SourceInput = new SourceInput(src.filename, src.source);
        lib_input.is_lib = true;
        inputs.push(lib_input);
        if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Dynlib] Merged lib source: " + src.filename); }
        si = si + 1;
    }
    let fi: mut i64 = 0;
    while (fi < cast<i64>(config.source_files.size())) {
        let file: string = config.source_files.at(cast<u64>(fi)).some;
        if (string_ends_with(file, ".penguins")) {
            let proj: mut PenguinProject = PenguinProject.load(file);
            let project_dir: string = get_parent_dir(file);
            let resolved: mut _utils.List<string> = proj.resolve_sources(project_dir);
            let project_file_index: mut i64 = 0;
            while (project_file_index < cast<i64>(resolved.size())) {
                let proj_file: string = resolved.at(cast<u64>(project_file_index)).some;
                let source: string = _utils.file_read_text(proj_file);
                inputs.push(new SourceInput(proj_file, source));
                if (config.is_lib_mode()) { lib_source_text = lib_source_text + source + "\n"; }
                if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Project] Adding source: " + proj_file); }
                project_file_index = project_file_index + 1;
            }
        } else {
            let source: string = _utils.file_read_text(file);
            inputs.push(new SourceInput(file, source));
            if (config.is_lib_mode()) { lib_source_text = lib_source_text + source + "\n"; }
            if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Project] Adding source: " + file); }
        }
        fi = fi + 1;
    }

    if (config.verbose >= 1) { __builtin.eprintln("[EmperorPenguin] Compiling " + cast<string>(config.source_files.size()) + " source files..."); }

    _utils.trace_set_verbose(config.verbose);
    let mut compiler = new EmperorPenguinCompiler();
    compiler.verbose = config.verbose;
    compiler.cli_define_keys = config.cli_define_keys;
    compiler.cli_define_values = config.cli_define_values;
    // Dyn-lib routing data: shipped instances (the lib-source boundary is set
    // via SourceInput.is_lib on the merged inputs, counted in compile_sources).
    let lii: mut i64 = 0;
    while (lii < cast<i64>(lib_state.instances.size())) {
        compiler.lib_instances.push(lib_state.instances.at(cast<u64>(lii)).some);
        lii = lii + 1;
    }
    let result = compiler.compile_sources(inputs);

    if (result.has_errors()) {
        __builtin.eprintln("[EmperorPenguin] Compilation failed with " + cast<string>(result.errors.size()) + " errors:");
        let ei: mut i64 = 0;
        while (ei < cast<i64>(result.errors.size())) {
            let err: SemanticError = result.errors.at(cast<u64>(ei)).some;
            __builtin.eprintln("  error[" + error_code_name(err.code) + "]: " + err.message);
            ei = ei + 1;
        }
        __builtin.exit(1);
    }

    let lc: mut LLVMCompiler = new LLVMCompiler();
    lc.verbose = config.verbose;
    if (config.is_lib_mode()) {
        // A lib may not emit @main / initialized globals.
        if (!validate_lib_defs(result)) {
            __builtin.exit(1);
        }
        let instances: _utils.List<string> = collect_instances(result);
        let lib_name: mut string = config.output_name;
        let lidx: i64 = string_find(config.output_name, ".penguin-lib");
        if (lidx >= 0) { lib_name = string_substring(config.output_name, 0, lidx); }
        lib_name = _get_base_name(lib_name);
        let lib_meta: string = build_metadata(lib_name, 1, lib_state.lib_names, instances, lib_source_text);
        if (!lc.link_lib(result, config, tmp_dir, exe_path, lib_meta)) {
            __builtin.exit(1);
        }
    } else {
        if (!lc.link_exe(result, config, tmp_dir, exe_path, lib_state.so_paths)) {
            __builtin.exit(1);
        }
    }
}

}
