namespace emperor {

fun get_base_name(path: string) -> string {
    let pos: mut i64 = string_find(path, "/");
    while (pos >= 0) {
        let next: i64 = string_find_from(path, "/", pos + 1);
        if (next < 0) {
            return string_substring(path, pos + 1, string_length(path) - pos - 1);
        }
        pos = next;
    }
    return path;
}

fun get_stem(path: string) -> string {
    let base: string = get_base_name(path);
    let dot: i64 = string_find(base, ".");
    if (dot < 0) { return base; }
    return string_substring(base, 0, dot);
}

fun scope_kind_name(kind: ScopeKind) -> string {
    if (kind is ScopeKind.GlobalScope) { return "GlobalScope"; }
    if (kind is ScopeKind.NamespaceScope) { return "NamespaceScope"; }
    if (kind is ScopeKind.ClassScope) { return "ClassScope"; }
    if (kind is ScopeKind.EnumScope) { return "EnumScope"; }
    if (kind is ScopeKind.InterfaceScope) { return "InterfaceScope"; }
    if (kind is ScopeKind.FunctionScope) { return "FunctionScope"; }
    if (kind is ScopeKind.BlockScope) { return "BlockScope"; }
    if (kind is ScopeKind.InitialRoutineScope) { return "InitialRoutineScope"; }
    if (kind is ScopeKind.ImplScope) { return "ImplScope"; }
    return "Unknown";
}

fun symbol_kind_name(sym: BoundSymbol) -> string {
    if (sym is BoundSymbol.variable) { return "var"; }
    if (sym is BoundSymbol.function_sym) { return "func"; }
    if (sym is BoundSymbol.type_sym) { return "type"; }
    if (sym is BoundSymbol.enum_member) { return "enum_member"; }
    if (sym is BoundSymbol.namespace_sym) { return "namespace"; }
    return "unknown";
}

fun symbol_type_name(sym: BoundSymbol) -> string {
    if (sym is BoundSymbol.variable) { return sym.variable.bound_type.display_name(); }
    if (sym is BoundSymbol.function_sym) { return sym.function_sym.return_type.display_name(); }
    if (sym is BoundSymbol.type_sym) { return sym.type_sym.bound_type.display_name(); }
    if (sym is BoundSymbol.enum_member) { return sym.enum_member.member_type.display_name(); }
    return "";
}

fun print_scope_to(sb: mut StringBuilder, scope: BoundScope, level: i64) {
    let pad: mut string = "";
    let pi: mut i64 = 0;
    while (pi < level * 2) {
        pad = pad + " ";
        pi = pi + 1;
    }
    sb.append(pad + "[" + scope_kind_name(scope.kind) + "] " + scope.name);
    if (string_length(scope.full_name) > 0) {
        sb.append(" (" + scope.full_name + ")");
    }
    sb.append("\n");

    let si: mut i64 = 0;
    while (si < cast<i64>(scope.symbols.size())) {
        let sym: BoundSymbol = scope.symbols.at(cast<u64>(si)).some;
        let type_str: string = symbol_type_name(sym);
        sb.append(pad + "  " + symbol_kind_name(sym) + " " + sym.get_name());
        if (string_length(type_str) > 0) {
            sb.append(": " + type_str);
        }
        sb.append("\n");
        si = si + 1;
    }

    let ci: mut i64 = 0;
    while (ci < cast<i64>(scope.children.size())) {
        print_scope_to(sb, scope.children.at(cast<u64>(ci)).some, level + 1);
        ci = ci + 1;
    }
}

initial {
    let args: _utils.List<string> = _utils.args();
    if (args.size() == 0) {
        __builtin.eprintln("Usage: EmperorPenguin [-v|-vv|-vvv] [-o output] <file.penguins | file1.penguin [file2.penguin ...]>");
        __builtin.exit(1);
    }

    // Parse options
    let output_name: mut string = "";
    let verbose: mut i64 = 0;
    let source_start: mut i64 = 0;
    let enable_meta: mut bool = false;
    // Determine source files
    let source_files: mut _utils.List<string> = new _utils.List<string>();
    // Command-line --define A=B / --define A seeds the compile-time option store
    // (equivalent to a top-level #define("A","B"); code-level #define wins).
    let cli_define_keys: mut _utils.List<string> = new _utils.List<string>();
    let cli_define_values: mut _utils.List<string> = new _utils.List<string>();

    let i: mut i64 = 0;
    while (i < cast<i64>(args.size())) {
        let arg: string = args.at(cast<u64>(i)).some;
        if (arg == "-vvv") {
            verbose = 3;
        } else if (arg == "-vv") {
            verbose = 2;
        } else if (arg == "-v") {
            verbose = 1;
        } else if (arg == "-o") {
            i = i + 1;
            if (i < cast<i64>(args.size())) {
                output_name = args.at(cast<u64>(i)).some;
            }
        } else if (arg == "-enable-meta" || arg == "--enable-meta") {
            enable_meta = true;
        } else if (arg == "-define" || arg == "--define") {
            i = i + 1;
            if (i < cast<i64>(args.size())) {
                let spec: string = args.at(cast<u64>(i)).some;
                let eq: i64 = string_find(spec, "=");
                if (eq >= 0) {
                    cli_define_keys.push(string_substring(spec, 0, eq));
                    cli_define_values.push(string_substring(spec, eq + 1, string_length(spec) - eq - 1));
                } else {
                    cli_define_keys.push(spec);
                    cli_define_values.push("1");
                }
            }
        } else {
            source_files.push(args.at(cast<u64>(i)).some);
        }
        i = i + 1;
    }
    if (source_files.size() == 0) {
        __builtin.eprintln("Error: no source files specified");
        __builtin.exit(1);
    }

    let stdlib_source: string = _utils.file_read_text("EmperorPenguin/std/penguin/core_builtin.penguin");

    // Build intermediates go into a per-process unique temp directory so that
    // parallel EmperorPenguin invocations never collide on a shared path. The
    // directory is created atomically by get_temp_folder().
    let tmp_dir: mut string = _utils.get_temp_folder();
    // The final executable defaults into that same isolated directory; -o
    // overrides only the output location (intermediates always stay isolated).
    let exe_path: mut string = tmp_dir + "/out.exe";
    if (string_length(output_name) > 0) {
        exe_path = output_name;
        // Ensure the output's parent directory exists.
        let last_slash: mut i64 = -1;
        let pos: mut i64 = string_find(output_name, "/");
        while (pos >= 0) {
            last_slash = pos;
            pos = string_find_from(output_name, "/", pos + 1);
        }
        if (last_slash > 0) {
            _utils.mkdir(string_substring(output_name, 0, last_slash));
        }
    }

    let inputs: mut _utils.List<SourceInput> = new _utils.List<SourceInput>();
    inputs.push(new SourceInput("core_builtin.penguin", stdlib_source));
    let fi: mut i64 = 0;
    while (fi < cast<i64>(source_files.size())) {
        let file: string = source_files.at(cast<u64>(fi)).some;
        if (string_ends_with(file, ".penguins")) { 
            let proj: mut PenguinProject = PenguinProject.load(file);
            let project_dir: string = get_parent_dir(file);
            let resolved: mut _utils.List<string> = proj.resolve_sources(project_dir);
            let project_file_index: mut i64 = 0;
            while (project_file_index < cast<i64>(resolved.size())) {
                let proj_file: string = resolved.at(cast<u64>(project_file_index)).some;
                let source: string = _utils.file_read_text(proj_file);
                inputs.push(new SourceInput(proj_file, source));
                if (verbose >= 1) { __builtin.eprintln("[EmperorPenguin Project] Adding source: " + proj_file); }
                project_file_index = project_file_index + 1;
            }
        }
        else {
            let source: string = _utils.file_read_text(file);
            inputs.push(new SourceInput(file, source));
            if (verbose >= 1) { __builtin.eprintln("[EmperorPenguin Project] Adding source: " + file); }
        }
        fi = fi + 1;
    }

    if (verbose >= 1) { __builtin.eprintln("[EmperorPenguin] Compiling " + cast<string>(source_files.size()) + " source files..."); }

    _utils.trace_set_verbose(verbose);
    let mut compiler = new EmperorPenguinCompiler();
    compiler.verbose = verbose;
    compiler.cli_define_keys = cli_define_keys;
    compiler.cli_define_values = cli_define_values;
    let result = compiler.compile_sources(inputs);

    // Meta #fun calls in user code are JIT-executed and spliced at compile time
    // inside SemanticModel.bind_meta_call (Phase 5b) — no special driver hook needed.


    if (result.has_errors()) {
        __builtin.eprintln("[EmperorPenguin] Compilation failed with " + cast<string>(result.errors.size()) + " errors:");
        let ei: mut i64 = 0;
        while (ei < cast<i64>(result.errors.size())) {
            let err: SemanticError = result.errors.at(cast<u64>(ei)).some;
            // Workaround: capture location fields individually to avoid
            // GC corrupting the reference-typed `filename` string pointer
            // in SourceLocation.to_string().
            let loc_s: SourceLocation = err.location;
            __builtin.eprintln("  error[" + error_code_name(err.code) + "]: " + err.message);
            ei = ei + 1;
        }
        __builtin.exit(1);
    } else {
        let generator = new IRGenerator();
        generator.verbose = verbose;
        let module = generator.generate(result);
        if (verbose >= 1) { __builtin.eprintln("[EmperorPenguin] IR generation done"); }

        let emitter = new LLVMEmitter();
        emitter.verbose = verbose;
        let llvm_ir: string = emitter.lower(module, result);
        if (verbose >= 1) { __builtin.eprintln("[EmperorPenguin] LLVM IR generation done"); }

        let ll_path: string = tmp_dir + "/combined.ll";
        _utils.file_write_text(ll_path, llvm_ir);

        let lib_path: string = tmp_dir + "/libcore_builtin.a";

        let make_args: mut _utils.List<string> = new _utils.List<string>();
        make_args.push("--silent");
        make_args.push("-C");
        make_args.push("EmperorPenguin/std/c");
        make_args.push("OUTPUT_DIR=" + tmp_dir);
        if (verbose >= 1) { __builtin.eprintln("[EmperorPenguin Link] Running: make --silent -C EmperorPenguin/std/c OUTPUT_DIR=" + tmp_dir); }
        let make_exit: i64 = _utils.exec("make", make_args);
        if (make_exit != 0) {
            __builtin.eprintln("[EmperorPenguin Link] make failed with exit code " + cast<string>(make_exit));
            __builtin.exit(1);
        }

        let clang_args: mut _utils.List<string> = new _utils.List<string>();
        clang_args.push(ll_path);
        clang_args.push(lib_path);

        // When --enable-meta is active, link libpenguin_jit.a and LLVM
        // so that the produced binary can JIT-compile #fun meta functions
        // at runtime via the ORC JIT C API (penguin_jit_*).
        if (enable_meta) {
            // Capture llvm-config link flags (e.g. "-L/usr/lib -lLLVM-22").
            // _exec_cmd uses system(3) so we redirect stdout to a file.
            let ldflags_file: string = tmp_dir + "/llvm_ldflags.txt";
            let cfg_exit: i64 = __builtin._exec_cmd(
                "llvm-config --ldflags --libs core orcjit native > "
                + ldflags_file + " 2>/dev/null");
            if (cfg_exit == 0) {
                let ldflags: string = _utils.file_read_text(ldflags_file);
                // llvm-config emits flags newline-separated (e.g. "-L/usr/lib \n-lLLVM-22\n");
                // split on BOTH space and newline so no token contains a newline — a newline
                // inside a clang arg would be parsed by the shell (which _utils.exec uses) as
                // a command separator, producing "-lLLVM-22: command not found".
                let pos: mut i64 = 0;
                let len: i64 = string_length(ldflags);
                while (pos < len) {
                    while (pos < len && (string_char_at(ldflags, pos) == " " || string_char_at(ldflags, pos) == "\n")) {
                        pos = pos + 1;
                    }
                    if (pos >= len) { break; }
                    let next_space: i64 = string_find_from(ldflags, " ", pos);
                    let next_nl: i64 = string_find_from(ldflags, "\n", pos);
                    let end_pos: mut i64 = next_space;
                    if (next_nl >= 0 && (end_pos < 0 || next_nl < end_pos)) { end_pos = next_nl; }
                    if (end_pos < 0) { end_pos = len; }
                    if (end_pos > pos) {
                        clang_args.push(string_substring(ldflags, pos, end_pos - pos));
                    }
                    pos = end_pos + 1;
                }
            }

            let jit_lib_path: string = tmp_dir + "/libpenguin_jit.a";
            clang_args.push(jit_lib_path);
            clang_args.push("-rdynamic");
            clang_args.push("-Wl,--export-dynamic");
            clang_args.push("-lstdc++");
        }

        // Request a 32 MB stack so deep recursion in the self-hosted compiler
        // (especially SemanticModel pass_build_scopes) doesn't overflow the
        // default 8 MB stack and cause intermittent SIGSEGV.
        clang_args.push("-Wl,-z,stack-size=33554432");
        clang_args.push("-o");
        clang_args.push(exe_path);

        if (verbose >= 1) { __builtin.eprintln("[EmperorPenguin Link] Running: clang -> " + exe_path); }
        let exit_code: i64 = _utils.exec("clang", clang_args);
        if (exit_code == 0) {
            if (verbose >= 1) { __builtin.eprintln("[EmperorPenguin Link] Output: " + exe_path); }
        } else {
            __builtin.eprintln("[EmperorPenguin Link] clang failed with exit code " + cast<string>(exit_code));
            __builtin.exit(1);
        }
    }
}
}
