[Project]
# Full compiler build: the json-backed Dynlib module + the pass3-only stdlib
# sources (json/vector/hashmap + _utils). Used ONLY by the bootstrap's
# pass2→pass3 and pass3→pass4 steps (./penguin -b) so the produced pass3/pass4
# compiler has dyn-lib support. Compiled by the native parser (pass2+), which
# handles the `#` meta constructs in json/vector/hashmap — never by BabyPenguin
# (pass1), which is why the default EmperorPenguin.penguins uses DynlibStub.
name="EmperorPenguinFull"
sources=["src/ast/AST.penguin", "src/ast/Lexer.penguin", "src/ast/Parser.penguin", "src/ast/SourceLocation.penguin", "src/ast/Token.penguin", "src/ast/Formatter.penguin", "src/bound/BoundCompilationUnit.penguin", "src/bound/BoundDefinition.penguin", "src/bound/BoundExpression.penguin", "src/bound/BoundScope.penguin", "src/bound/BoundStatement.penguin", "src/bound/BoundSymbol.penguin", "src/bound/BoundTreePrinter.penguin", "src/bound/BoundType.penguin", "src/bound/BoundTypeRegistry.penguin", "src/bound/Mangling.penguin", "src/bound/EmperorPenguinCompiler.penguin", "src/bound/GlobalIndex.penguin", "src/bound/SemanticModel.penguin", "src/bound/SemanticShared.penguin", "src/bound/SemanticMetaRewrite.penguin", "src/bound/SemanticBuildScopes.penguin", "src/bound/SemanticMonomorphize.penguin", "src/bound/SemanticMonomorphizeAdjudicate.penguin", "src/bound/SemanticMonomorphizeCollect.penguin", "src/bound/SemanticMonomorphizeSpecialize.penguin", "src/bound/SemanticMonomorphizeSpecializing.penguin", "src/bound/SemanticResolveTypes.penguin", "src/bound/SemanticBindSymbols.penguin", "src/bound/SemanticConstructors.penguin", "src/bound/SemanticIfaceLayout.penguin", "src/bound/SemanticConcurrency.penguin", "src/bound/SemanticClassifyValueTypes.penguin", "src/bound/SemanticBindA5.penguin", "src/bound/SemanticBindBodies.penguin", "src/bound/SemanticBindExpressions.penguin", "src/bound/SemanticBindExprCall.penguin", "src/bound/SemanticBindExprCastNew.penguin", "src/bound/SemanticBindExprCoroutine.penguin", "src/bound/SemanticBindExprGenerator.penguin", "src/bound/SemanticBindExprLambda.penguin", "src/bound/SemanticBindExprLiteral.penguin", "src/bound/SemanticBindExprMember.penguin", "src/bound/SemanticBindExprOwnership.penguin", "src/bound/SemanticBindMetaCalls.penguin", "src/bound/SemanticTypeInterner.penguin", "src/bound/SemanticValidateControlFlow.penguin", "src/bound/IncrementalSession.penguin", "src/ir/IRBuilder.penguin", "src/ir/IRFunction.penguin", "src/ir/IRGenerator.penguin