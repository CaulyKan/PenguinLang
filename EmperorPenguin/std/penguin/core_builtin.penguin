namespace __builtin {
    extern fun exit(code : i32);
    extern fun print(text : string);
    extern fun println(text : string);
    extern fun eprint(text : string);
    extern fun eprintln(text : string);
    extern fun _exec_cmd(cmd: string) -> i64;

    extern fun lshift(value: i64, shift: i64) -> i64;
    extern fun rshift(value: i64, shift: i64) -> i64;

    extern fun gc_collect();
    extern fun gc_info() -> i64;
    // GC v3 green-tea introspection (EmperorPenguin runtime only; greentea
    // mode): which — 0 live span bytes, 1 heap goal, 2/3/4 full/partial/
    // empty span counts, 5 wholesale-recycled spans (cumulative),
    // 6 representative fast-path scans (cumulative), 7 completed cycles,
    // 8 superchunks. 0 outside greentea mode.
    extern fun gc_gt_stats(which : i64) -> i64;
    // Pin a compile-time object value (a raw i64 address baked into a meta
    // stub / template-arg environment) for the process lifetime — the GC
    // retains it as a root because integers are invisible to the marker.
    extern fun gc_pin_object(addr: u64);

    // Raw heap allocation for manually-managed buffers (Array<T,N>, _ptr<T>).
    // Routed to @_emperor_malloc / @_emperor_mfree in core_builtin.c (libc
    // malloc/free, NOT the GC arena). Unreferenced externs are free.
    extern fun _malloc(size: u64) -> u64;
    extern fun _mfree(addr: u64);
    // GC scan-region registration for raw buffers that CONTAIN pointers to GC
    // objects (Vector/HashMap/Array element storage). The conservative
    // collector cannot see inside malloc'd memory: register the buffer right
    // after allocating it, and remove the region BEFORE freeing/replacing it
    // (dispose_mem / _grow). A missing registration means live elements get
    // swept; a stale one only retains garbage.
    extern fun _gc_scan_add(addr: u64, size: i64);
    extern fun _gc_scan_remove(addr: u64);

    // Byte-level helpers for generic HashMap<K,V>: hash and equality over the raw
    // bytes of a value-type key (address + #sizeof). Routed to @_emperor_hash_bytes
    // / @_emperor_bytes_equal in core_builtin.c.
    extern fun _hash_bytes(addr: u64, len: u64) -> u64;
    extern fun _bytes_equal(addr1: u64, addr2: u64, len: u64) -> i64;

    extern fun __args_count() -> i64;
    extern fun __args_get(index: i64) -> string;

    // Throw a runtime error: caught by the innermost enclosing try/catch of
    // the current coroutine, or reported and exited if uncaught.
    extern fun __throw_runtime_error(message: string, code: i64);
    extern fun __throw_get_msg() -> string;
    extern fun __throw_get_code() -> i64;
    // try/catch (sjlj): the compiled function calls _setjmp itself on a
    // per-site buffer from the C runtime's table. __TryBuf is the opaque
    // handle type for that buffer; __sjlj_setjmp is a MARKER call — the LLVM
    // emitter intercepts it and inlines `call i32 @_setjmp(ptr <buf>)` so the
    // landing happens inside the still-live compiled function (a C-side
    // wrapper's dead frame would make the landing undefined).
    class __TryBuf {
        impl IReferenceType;
    }
    extern fun _try_buf(site: i64) -> mut __TryBuf;
    extern fun _try_setup(site: i64);
    extern fun _try_leave();
    extern fun __sjlj_setjmp(jb: mut __TryBuf) -> i32;

    // The catch handler's error object: message + numeric code (panic uses
    // code 1, channel-closed 100 — mirrors BabyPenguin's RuntimeError).
    class RuntimeError {
        impl IReferenceType;
        message: string = "";
        code: i64 = 0;

        fun new(mut this, message: string, code: i64) {
            this.message = message;
            this.code = code;
        }
    }

    // JIT compilation API (backed by libpenguin_jit / LLVM ORC)
    extern fun penguin_jit_create() -> u64;
    extern fun penguin_jit_add_module(ctx: u64, name: string, ir_text: string) -> i32;
    extern fun penguin_jit_lookup(ctx: u64, name: string) -> u64;
    extern fun penguin_jit_destroy(ctx: u64);
    extern fun penguin_jit_get_error() -> string;

    // JIT trampolines — call a JIT-compiled function pointer with various
    // argument/return-type signatures (backed by libpenguin_jit)
    extern fun penguin_jit_call_i64_0(fn: u64) -> i64;
    extern fun penguin_jit_call_i64_i64(fn: u64, a: i64) -> i64;
    extern fun penguin_jit_call_i64_i64_i64(fn: u64, a: i64, b: i64) -> i64;
    extern fun penguin_jit_call_i64_i64_i64_i64(fn: u64, a: i64, b: i64, c: i64) -> i64;
    extern fun penguin_jit_call_ptr_ptr(fn: u64, a: u64) -> u64;
    extern fun penguin_jit_call_ptr_ptr_ptr(fn: u64, a: u64, b: u64) -> u64;

    fun panic(text : string) {
        print("panic: ");
        println(text);
        __throw_runtime_error(text, 1);
    }

    #template(T: type)
    class Box {
        value: T;
        impl IReferenceType;
        fun new(mut this, value: T) {
            this.value = value;
        }
    }

    class __ExternImpl {}

    #template(T: type)
    enum Option {
        some: T;
        none;

        fun is_some(this) -> bool {
            return this is Option<T>.some;
        }

        fun is_none(this) -> bool {
            return this is Option<T>.none;
        }

        fun value_or(this, default_val: T) -> T {
            if (this is Option<T>.some) {
                return this.some;
            } else {
                return default_val;
            }
        }
    }

    #template(T: type)
    interface ICopy {
        extern fun copy(this: T) -> T;
    }

    // IHash: hashes a value to a 64-bit hash code. Implemented for every
    // primitive via `impl IHash for <type>`; calls like `k.hash()` on a
    // primitive resolve to the impl's method as a direct call (primitive
    // interface-method dispatch).
    interface IHash {
        fun hash(this) -> i64;
    }

    // IReferenceType marks a class as a heap-allocated reference type, overriding
    // the all-value-fields heuristic in classify_class. Without it, a class whose
    // fields are all value-like (e.g. StringBuilder: string/i32/i32, where string
    // is PrimitiveKind=>value-like) is misclassified as a VALUE type — value-copy
    // semantics then break aliasing (the LLVMEmitter this.sb buffer swap copies the
    // 24B struct instead of aliasing, so the buffer is never written).
    interface IReferenceType {
        // Self-marker so the interface itself is reference-sized (callable as a
        // return type, e.g. the M6-step2 penguin_meta_get_object bridge);
        // mirrors IIterator's `impl IReferenceType`.
        impl IReferenceType;
    }

    // M6-step2: canonical, deterministic name for a non-scalar value-template
    // argument, used to mangle/dedup object value args (e.g. Foo<#make_list(...)>)
    // by VALUE rather than by address. get_unique_name() must be stable across
    // compilations (no embedded addresses/random) — it is the mangle key.
    // CONTRACT: the returned name must be an INJECTIVE encoding of the content
    // the template body may introspect — pass free-text content through
    // umangle_escape() so distinct values never share a name (the mangle-level
    // sanitizer maps ' ', '<', '>', ',' to '_', so raw text like "a b" and "a_b"
    // would otherwise collide and wrongly dedup two distinct instantiations).
    interface IUniqueMangleName {
        fun get_unique_name(this) -> string;
    }

    // Identifier-safe, injective escaping for IUniqueMangleName content:
    //   '_' → "_0", [A-Za-z0-9] → verbatim, everything else → "_x" + 2 hex digits
    // (e.g. ' ' → "_x20"). Because '_' itself is escaped, the mapping is
    // one-to-one: two different inputs always yield different names, and the
    // output survives the mangle sanitizer (it contains no ' ', '<', '>', ',')
    // byte-for-byte.
    fun umangle_escape(s: string) -> string {
        let digits: string = "0123456789abcdef";
        let sb: mut StringBuilder = new StringBuilder();
        let i: mut i64 = 0;
        while (i < string_length(s)) {
            let ch: string = string_char_at(s, i);
            let code: i64 = string_char_code(ch);
            if (code == 95) {
                sb.append("_0");
            } else {
                if ((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)) {
                    sb.append(ch);
                } else {
                    sb.append("_x");
                    sb.append(string_char_at(digits, code / 16));
                    sb.append(string_char_at(digits, code % 16));
                }
            }
            i = i + 1;
        }
        return sb.to_string();
    }

    // Marker for reference types that own raw memory (Array<T,N>,
    // HashMap<K,V>, ...). dispose_mem() may be called explicitly, and for
    // IReferenceType classes it is also invoked automatically by the GC when
    // a dead instance is swept (the emitter points the class metadata
    // destructor slot at dispose_mem). Implementations must be idempotent —
    // an owner's finalizer may dispose an inner object before that object's
    // own finalizer runs.
    interface IMemoryDispose {
        fun dispose_mem();
    }

    #template(T: type)
    interface IIterator {
        impl IReferenceType;
        fun next(mut this) -> Option<T>;
        fun iter(this) -> IIterator<T> {
            return this;
        }
    }

    #template(T: type)
    interface IIterable {
        // `iter()` is the read-only iteration path (non-mut-typed IIterator); `iter_mut()` is
        // the mutable path. Both are callable on immutable containers — creating an iterator
        // never mutates the container. The element type T is preserved as stored.
        fun iter(this) -> IIterator<T>;
        fun iter_mut(this) -> mut IIterator<T>;
    }

    #template(T: type)
    interface IMutIterator {
        fun iter_mut(this) -> mut IIterator<T>;
    }

    impl __builtin.ICopy<i64> for i64;
    impl __builtin.ICopy<u64> for u64;
    impl __builtin.ICopy<i32> for i32;
    impl __builtin.ICopy<u32> for u32;
    impl __builtin.ICopy<i16> for i16;
    impl __builtin.ICopy<u16> for u16;
    impl __builtin.ICopy<i8> for i8;

    // --- IUniqueMangleName for every primitive ----------------------------
    // Primitive interface impls (`impl Iface for <prim>`) are name-mangled to
    // `<method>$$<prim>` and dispatched directly (the IHash precedent). They let
    // the IUniqueMangleName render below be UNIFORM — every umangleable element
    // type answers `.get_unique_name()` — so the container impl bodies in the
    // #specializing blocks below contain NO meta calls (no JIT, no recursion).
    // Render text must distinguish kinds at a glance: digits for ints, quoted
    // for string, true/false for bool, decimal text for floats.
    impl IUniqueMangleName for i64 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for i32 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for i16 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for i8 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for u64 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for u32 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for u16 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for u8 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for f64 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for f32 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for bool {
        fun get_unique_name(this) -> string {
            if (this) { return "true"; }
            return "false";
        }
    }
    impl IUniqueMangleName for char { fun get_unique_name(this) -> string { return cast<string>(cast<i64>(this)); } }
    impl IUniqueMangleName for string { fun get_unique_name(this) -> string { return "\"" + this + "\""; } }

    // --- IUniqueMangleName auto-impls for the core/std generic wrappers -----
    // These #specializing blocks live in core_builtin deliberately: core_builtin
    // is (a) the stdlib of EVERY host compilation and (b) a base source of EVERY
    // unit-B (meta) compilation — so the impl is injected symmetrically in all
    // modules that specialize these types, keeping their specializations
    // layout/vtable-identical (the cross-module asymmetry was the crash).
    // The `umangleable(T)` gate is evaluated NATIVELY by the compiler (no JIT
    // gate — a JIT gate would recurse: its own unit-B compile re-fires these
    // blocks). The impl bodies use only the uniform `.get_unique_name()` render
    // above — no meta splices, nothing left to JIT.
    #specializing _utils.List<T> {
        if (umangleable(T)) {
            impl IUniqueMangleName {
                fun get_unique_name(this) -> string {
                    let sb: mut StringBuilder = new StringBuilder();
                    sb.append("Ls_");
                    sb.append(cast<string>(this.size()));
                    let i: mut i64 = 0;
                    while (i < cast<i64>(this.size())) {
                        sb.append("_");
                        sb.append(this.at(cast<u64>(i)).some.get_unique_name());
                        i = i + 1;
                    }
                    return sb.to_string();
                }
            }
        }
    }

    #specializing __builtin.Box<T> {
        if (umangleable(T)) {
            impl IUniqueMangleName {
                fun get_unique_name(this) -> string {
                    return "Bx_" + this.value.get_unique_name();
                }
            }
        }
    }

    #specializing __builtin.Option<T> {
        if (umangleable(T)) {
            impl IUniqueMangleName {
                fun get_unique_name(this) -> string {
                    if (this is Option<T>.none) { return "Op_n"; }
                    return "Op_s_" + this.some.get_unique_name();
                }
            }
        }
    }

    impl __builtin.ICopy<u8> for u8;
    impl __builtin.ICopy<bool> for bool;
    impl __builtin.ICopy<char> for char;
    impl __builtin.ICopy<string> for string;
    impl __builtin.ICopy<float> for float;
    impl __builtin.ICopy<double> for double;

    // IHash implementations for every primitive (primitive interface-method
    // dispatch: `k.hash()` lowers to a direct call of the mangled method).
    impl IHash<i64> for i64 {
        fun hash(this) -> i64 {
            return this;
        }
    }
    impl IHash<i32> for i32 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<i16> for i16 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<i8> for i8 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<u64> for u64 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<u32> for u32 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<u16> for u16 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<u8> for u8 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<char> for char {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<f32> for f32 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<f64> for f64 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<bool> for bool {
        fun hash(this) -> i64 {
            if (this) { return 1; }
            return 0;
        }
    }
    impl IHash<string> for string {
        fun hash(this) -> i64 {
            // FNV-1a 64-bit: h ^= byte; h *= prime. The standard offset basis
            // 0xCBF29CE484222325 overflows i64 literals, so its low 63 bits
            // (0x4BF29CE484222325) are used — hash distribution is unchanged.
            let h: mut i64 = 5472609002491880229;
            let i: mut i64 = 0;
            while (i < string_length(this)) {
                h = h ^ string_char_code(string_char_at(this, i));
                h = h * 1099511628211;
                i = i + 1;
            }
            return h;
        }
    }

    // StringBuilder is backed by the C struct in core_builtin.c. Its PenguinLang
    // field layout MUST match that C struct (EmperorPenguin always prepends a
    // metadata ptr at offset 0, so the C struct leads with `void* metadata`
    // too). The extern `new` initializes these fields in place via `this`; if the
    // layouts disagree, `_emperor_stringbuilder_append` would read the metadata
    // pointer as `data` and overwrite global metadata -> heap corruption.
    class StringBuilder {
        data: string;
        len: i32;
        cap: i32;
        impl IReferenceType;
        extern fun new(mut this);
        extern fun append(mut this, s: string);
        extern fun to_string(this) -> mut string;
        // M6-step2 4b: canonical value-level name for object value-template args
        // (stable mangle/dedup by VALUE, not address). Content-derived and ESCAPED
        // via umangle_escape so distinct contents never share a mangle (raw text
        // like "a b" vs "a_b" would collide in the mangle sanitizer's '_'
        // mapping) — it becomes part of the specialization's mangled symbol.
        impl IUniqueMangleName {
            fun get_unique_name(this) -> string {
                return "SB_" + umangle_escape(this.data);
            }
        }
    }

    // NOTE: the old M6-step2 generic unique-name trampoline
    // (`#fun penguin_meta_unique_name(l: IUniqueMangleName)`) was REMOVED — its
    // virtual dispatch ran on the UNIT-B object, where impls injected into the
    // host compilation (#specializing blocks) do not exist, producing a missing
    // vtable entry and a SEGV. The host now synthesizes a per-type STATIC
    // trampoline (SemanticModel.find_unique_name_trampoline); only impls written
    // in base-meta-source class bodies (like StringBuilder's above) are callable
    // that way.

    // String helper functions
    extern fun string_length(s: string) -> i64;
    extern fun string_find(s: string, sub: string) -> i64;
    extern fun string_find_from(s: string, sub: string, start: i64) -> i64;
    extern fun string_substring(s: string, start: i64, length: i64) -> string;
    extern fun string_char_at(s: string, index: i64) -> string;
    extern fun string_char_code(s: string) -> i64;
    // O(1)-per-call hot-path helpers (no strlen scan of the WHOLE string, no
    // allocation): the lexer calls these per source byte — string_substring/
    // string_length re-strlen the entire source file every call, which made
    // tokenization quadratic. starts_with compares prefix bytes until s's NUL;
    // char_code_at returns the code unit at index (-1 at the NUL terminator),
    // callers keep index within [0, length).
    extern fun string_starts_with_at(s: string, at: i64, prefix: string) -> bool;
    extern fun string_char_code_at(s: string, index: i64) -> i64;
    extern fun string_slice(s: string, start: i64, length: i64) -> string;
    extern fun string_to_int(s: string) -> i64;
    extern fun string_to_double(s: string) -> double;

    // IStringOps: the std string-operation surface, implemented for the
    // primitive `string` via primitive interface-method dispatch (the IHash
    // precedent: the impl's methods are mangled `<name>$$string` and
    // `s.method()` resolves to a direct call). All operations are unit-based
    // (byte units on the native runtime, UTF-16 units on the VM) and the
    // case/trim tables are ASCII. This block is mirrored verbatim in
    // BabyPenguin/Builtin.penguin (there the impl attaches a vtable to the
    // string BasicTypeNode — BasicTypeNode is an IVTableContainer).
    interface IStringOps {
        fun length(this: string) -> i64;
        fun is_empty(this: string) -> bool;
        fun char_at(this: string, index: i64) -> string;
        fun char_code(this: string) -> i64;
        fun char_code_at(this: string, index: i64) -> i64;
        fun substring(this: string, start: i64, length: i64) -> string;
        fun slice(this: string, start: i64, length: i64) -> string;
        fun find(this: string, sub: string) -> i64;
        fun find_from(this: string, sub: string, start: i64) -> i64;
        fun find_last(this: string, sub: string) -> i64;
        fun contains(this: string, sub: string) -> bool;
        fun starts_with(this: string, prefix: string) -> bool;
        fun ends_with(this: string, suffix: string) -> bool;
        fun equals_ignore_case(this: string, other: string) -> bool;
        fun compare(this: string, other: string) -> i64;
        fun count(this: string, sub: string) -> i64;
        fun to_upper(this: string) -> string;
        fun to_lower(this: string) -> string;
        fun trim(this: string) -> string;
        fun trim_start(this: string) -> string;
        fun trim_end(this: string) -> string;
        fun replace(this: string, from: string, to: string) -> string;
        fun reverse(this: string) -> string;
        fun repeat(this: string, n: i64) -> string;
        fun pad_left(this: string, width: i64, ch: string) -> string;
        fun pad_right(this: string, width: i64, ch: string) -> string;
        fun split(this: string, sep: string) -> mut IIterator<string>;
        fun to_int(this: string) -> i64;
        fun to_double(this: string) -> double;
    }

    // Lazy separator-split iterator behind `s.split(sep)` — for-in ready
    // (the in-expression is already an iterator, so it is used as-is).
    // Semantics: pieces between non-overlapping occurrences of sep; a
    // trailing separator yields one final empty piece (Python-like); an
    // empty sep yields the whole string once (or nothing when empty).
    class StringSplitIterator {
        source: string = "";
        sep: string = "";
        pos: mut i64 = 0;
        done: mut bool = false;

        fun new(mut this, source: string, sep: string) {
            this.source = source;
            this.sep = sep;
        }

        impl IIterator<string> {
            fun next(this: mut IIterator<string>) -> Option<string> {
                let self: mut Self = cast<mut Self>(this);
                if (self.done) {
                    return new Option<string>.none();
                }
                let n: i64 = string_length(self.source);
                let sep_len: i64 = string_length(self.sep);
                if (sep_len == 0) {
                    self.done = true;
                    if (n == 0) {
                        return new Option<string>.none();
                    }
                    return new Option<string>.some(self.source);
                }
                let idx: i64 = string_find_from(self.source, self.sep, self.pos);
                if (idx < 0) {
                    self.done = true;
                    return new Option<string>.some(
                        string_substring(self.source, self.pos, n - self.pos));
                }
                let piece: string =
                    string_substring(self.source, self.pos, idx - self.pos);
                self.pos = idx + sep_len;
                return new Option<string>.some(piece);
            }
        }
    }

    impl IStringOps for string {
        fun length(this: string) -> i64 { return string_length(this); }
        fun is_empty(this: string) -> bool { return string_length(this) == 0; }
        fun char_at(this: string, index: i64) -> string {
            return string_char_at(this, index);
        }
        fun char_code(this: string) -> i64 { return string_char_code(this); }
        fun char_code_at(this: string, index: i64) -> i64 {
            return string_char_code_at(this, index);
        }
        fun substring(this: string, start: i64, length: i64) -> string {
            return string_substring(this, start, length);
        }
        fun slice(this: string, start: i64, length: i64) -> string {
            return string_slice(this, start, length);
        }
        fun find(this: string, sub: string) -> i64 {
            return string_find(this, sub);
        }
        fun find_from(this: string, sub: string, start: i64) -> i64 {
            return string_find_from(this, sub, start);
        }
        // Empty sub is ill-defined (every gap matches) — report "not found".
        fun find_last(this: string, sub: string) -> i64 {
            if (string_length(sub) == 0) { return -1; }
            let result: mut i64 = -1;
            let pos: mut i64 = 0;
            while (true) {
                let idx: i64 = string_find_from(this, sub, pos);
                if (idx < 0) { break; }
                result = idx;
                pos = idx + 1;
            }
            return result;
        }
        fun contains(this: string, sub: string) -> bool {
            return string_find(this, sub) >= 0;
        }
        fun starts_with(this: string, prefix: string) -> bool {
            return string_starts_with_at(this, 0, prefix);
        }
        fun ends_with(this: string, suffix: string) -> bool {
            let n: i64 = string_length(this);
            let m: i64 = string_length(suffix);
            if (m > n) { return false; }
            return string_starts_with_at(this, n - m, suffix);
        }
        fun equals_ignore_case(this: string, other: string) -> bool {
            if (string_length(this) != string_length(other)) { return false; }
            let i: mut i64 = 0;
            while (i < string_length(this)) {
                let ca: mut i64 = string_char_code_at(this, i);
                let cb: mut i64 = string_char_code_at(other, i);
                if (ca >= 65 && ca <= 90) { ca = ca + 32; }
                if (cb >= 65 && cb <= 90) { cb = cb + 32; }
                if (ca != cb) { return false; }
                i = i + 1;
            }
            return true;
        }
        // Lexicographic unit-wise compare: negative / zero / positive.
        fun compare(this: string, other: string) -> i64 {
            let n: i64 = string_length(this);
            let m: i64 = string_length(other);
            let len: i64 = if (n < m) { n } else { m };
            let i: mut i64 = 0;
            while (i < len) {
                let ca: i64 = string_char_code_at(this, i);
                let cb: i64 = string_char_code_at(other, i);
                if (ca != cb) { return ca - cb; }
                i = i + 1;
            }
            return n - m;
        }
        // Non-overlapping occurrences; empty sub counts as zero.
        fun count(this: string, sub: string) -> i64 {
            if (string_length(sub) == 0) { return 0; }
            let result: mut i64 = 0;
            let pos: mut i64 = 0;
            while (true) {
                let idx: i64 = string_find_from(this, sub, pos);
                if (idx < 0) { break; }
                result = result + 1;
                pos = idx + string_length(sub);
            }
            return result;
        }
        fun to_upper(this: string) -> string {
            let lower: string = "abcdefghijklmnopqrstuvwxyz";
            let upper: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
            let sb: mut StringBuilder = new StringBuilder();
            let i: mut i64 = 0;
            while (i < string_length(this)) {
                let c: string = string_char_at(this, i);
                let idx: i64 = string_find(lower, c);
                if (idx >= 0) {
                    sb.append(string_char_at(upper, idx));
                } else {
                    sb.append(c);
                }
                i = i + 1;
            }
            return sb.to_string();
        }
        fun to_lower(this: string) -> string {
            let lower: string = "abcdefghijklmnopqrstuvwxyz";
            let upper: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
            let sb: mut StringBuilder = new StringBuilder();
            let i: mut i64 = 0;
            while (i < string_length(this)) {
                let c: string = string_char_at(this, i);
                let idx: i64 = string_find(upper, c);
                if (idx >= 0) {
                    sb.append(string_char_at(lower, idx));
                } else {
                    sb.append(c);
                }
                i = i + 1;
            }
            return sb.to_string();
        }
        fun trim(this: string) -> string {
            let ws: string = " \t\n\r";
            let n: i64 = string_length(this);
            let b: mut i64 = 0;
            let e: mut i64 = n - 1;
            while (b < n) {
                if (string_find(ws, string_char_at(this, b)) < 0) { break; }
                b = b + 1;
            }
            while (e >= b) {
                if (string_find(ws, string_char_at(this, e)) < 0) { break; }
                e = e - 1;
            }
            if (e < b) { return ""; }
            return string_substring(this, b, e - b + 1);
        }
        fun trim_start(this: string) -> string {
            let ws: string = " \t\n\r";
            let n: i64 = string_length(this);
            let b: mut i64 = 0;
            while (b < n) {
                if (string_find(ws, string_char_at(this, b)) < 0) { break; }
                b = b + 1;
            }
            if (b >= n) { return ""; }
            return string_substring(this, b, n - b);
        }
        fun trim_end(this: string) -> string {
            let ws: string = " \t\n\r";
            let n: i64 = string_length(this);
            let e: mut i64 = n - 1;
            while (e >= 0) {
                if (string_find(ws, string_char_at(this, e)) < 0) { break; }
                e = e - 1;
            }
            if (e < 0) { return ""; }
            return string_substring(this, 0, e + 1);
        }
        fun replace(this: string, from: string, to: string) -> string {
            if (string_length(from) == 0) { return this; }
            let n: i64 = string_length(this);
            let from_len: i64 = string_length(from);
            let sb: mut StringBuilder = new StringBuilder();
            let pos: mut i64 = 0;
            while (true) {
                let idx: i64 = string_find_from(this, from, pos);
                if (idx < 0) { break; }
                sb.append(string_substring(this, pos, idx - pos));
                sb.append(to);
                pos = idx + from_len;
            }
            sb.append(string_substring(this, pos, n - pos));
            return sb.to_string();
        }
        fun reverse(this: string) -> string {
            let sb: mut StringBuilder = new StringBuilder();
            let i: mut i64 = string_length(this) - 1;
            while (i >= 0) {
                sb.append(string_char_at(this, i));
                i = i - 1;
            }
            return sb.to_string();
        }
        fun repeat(this: string, n: i64) -> string {
            if (n <= 0) { return ""; }
            let sb: mut StringBuilder = new StringBuilder();
            let i: mut i64 = 0;
            while (i < n) {
                sb.append(this);
                i = i + 1;
            }
            return sb.to_string();
        }
        fun pad_left(this: string, width: i64, ch: string) -> string {
            let n: i64 = string_length(this);
            if (n >= width) { return this; }
            let fill: string = if (string_length(ch) > 0) { string_char_at(ch, 0) } else { " " };
            let sb: mut StringBuilder = new StringBuilder();
            let i: mut i64 = n;
            while (i < width) {
                sb.append(fill);
                i = i + 1;
            }
            sb.append(this);
            return sb.to_string();
        }
        fun pad_right(this: string, width: i64, ch: string) -> string {
            let n: i64 = string_length(this);
            if (n >= width) { return this; }
            let fill: string = if (string_length(ch) > 0) { string_char_at(ch, 0) } else { " " };
            let sb: mut StringBuilder = new StringBuilder();
            sb.append(this);
            let i: mut i64 = n;
            while (i < width) {
                sb.append(fill);
                i = i + 1;
            }
            return sb.to_string();
        }
        fun split(this: string, sep: string) -> mut IIterator<string> {
            return cast<mut IIterator<string>>(new StringSplitIterator(this, sep));
        }
        fun to_int(this: string) -> i64 { return string_to_int(this); }
        fun to_double(this: string) -> double { return string_to_double(this); }
    }

    #template(T: type, E: type)
    enum Result {
        ok: T;
        error: E;

        fun is_ok(this) -> bool {
            return this is Result<T, E>.ok;
        }

        fun is_error(this) -> bool {
            return this is Result<T, E>.error;
        }

        fun value_or(this, default_val: T) -> T {
            if (this is Result<T, E>.ok) {
                return this.ok;
            } else {
                return default_val;
            }
        }
    }

    #template(K: type, V: type)
    class Pair {
        first: K;
        second: V;
    }

    // Range iterator: a simple numeric range for for-loop support
    class RangeIterator {
        current: mut i64 = 0;
        end: i64 = 0;
        fun new(mut this, start: i64, end: i64) {
            this.current = start;
            this.end = end;
        }
        fun next(mut this) -> __builtin.Option<i64> {
            if (this.current < this.end) {
                let val: i64 = this.current;
                this.current = this.current + 1;
                return new __builtin.Option<i64>.some(val);
            }
            return new __builtin.Option<i64>.none();
        }
        fun iter(this) -> RangeIterator {
            return this;
        }
        #template(U: type)
        fun map(mut this, f: mut fun<U, i64>) -> mut MapIterator<i64, U> {
            let it: mut MapIterator<i64, U> = new MapIterator<i64, U>(cast<mut IIterator<i64>>(this), f);
            return it;
        }
        fun filter(mut this, pred: mut fun<bool, i64>) -> mut FilterIterator<i64> {
            let it: mut FilterIterator<i64> = new FilterIterator<i64>(cast<mut IIterator<i64>>(this), pred);
            return it;
        }
        #template(R: type)
        fun reduce(mut this, init: R, f: mut fun<R, R, i64>) -> R {
            let mut acc = init;
            let mut v = this.next();
            while (v.is_some()) {
                acc = f(acc, v.some);
                v = this.next();
            }
            return acc;
        }
        fun all(mut this, pred: mut fun<bool, i64>) -> bool {
            let mut v = this.next();
            while (v.is_some()) {
                if (!(pred(v.some))) { return false; }
                v = this.next();
            }
            return true;
        }
        fun any(mut this, pred: mut fun<bool, i64>) -> bool {
            let mut v = this.next();
            while (v.is_some()) {
                if (pred(v.some)) { return true; }
                v = this.next();
            }
            return false;
        }
        #template(C: type)
        fun into(mut this) -> C {
            let mut c = new C();
            let mut v = this.next();
            while (v.is_some()) {
                c.push(v.some);
                v = this.next();
            }
            return c;
        }

        impl IIterator<i64> {
            fun next(mut this) -> __builtin.Option<i64> {
                if (this.current < this.end) {
                    let val: i64 = this.current;
                    this.current = this.current + 1;
                    return new __builtin.Option<i64>.some(val);
                }
                return new __builtin.Option<i64>.none();
            }
        }
    }

    // ---- iterator combinators (map/filter/reduce/all/any/into) ----
    // Generic methods on the CONCRETE iterator classes: chaining works because
    // `range()`/`iter()` return concrete iterator types (interface-typed
    // IIterator values cannot dispatch generic methods through the vtable —
    // the specialized slot set is not knowable per call site). map/reduce
    // infer their type argument from the lambda/init argument; into takes an
    // explicit container type argument (any type with a default constructor
    // and push).

    // MapIterator: applies f to every element of src (lazily, one next() at a
    // time — the source is only pulled when the mapped iterator is pulled).
    #template(T: type, U: type)
    class MapIterator {
        impl IReferenceType;
        src: mut IIterator<T>;
        f: mut fun<U, T>;

        fun new(mut this, src: mut IIterator<T>, f: mut fun<U, T>) {
            this.src = src;
            this.f = f;
        }

        fun next(mut this) -> Option<U> {
            let v: Option<T> = this.src.next();
            if (v.is_none()) { return new Option<U>.none(); }
            return new Option<U>.some(this.f(v.some));
        }

        // NOTE: no `iter()` here (nor on FilterIterator): its bare generic
        // return type (`-> MapIterator`) resolves to the TEMPLATE, mismatching
        // `this` in every specialization (E_RETURN_TYPE_MISMATCH), and for-in
        // already treats iterator-typed operands as-is (is_iterator_type).

        impl IIterator<U> {
            fun next(mut this) -> Option<U> {
                let v: Option<T> = this.src.next();
                if (v.is_none()) { return new Option<U>.none(); }
                return new Option<U>.some(this.f(v.some));
            }
        }

        // NOTE: the method template is named V — a method-level `U` here would
        // SHADOW the class's U (element/output type) and mis-sign the chain.
        // Semantics: MapIterator<T,U> yields U; map(f: fun(U)->V) yields V, so
        // the result is MapIterator<U, V> (fun<V, U> = return V, arg U).
        #template(V: type)
        fun map(mut this, f: mut fun<V, U>) -> mut MapIterator<U, V> {
            let it: mut MapIterator<U, V> = new MapIterator<U, V>(cast<mut IIterator<U>>(this), f);
            return it;
        }
        fun filter(mut this, pred: mut fun<bool, U>) -> mut FilterIterator<U> {
            let it: mut FilterIterator<U> = new FilterIterator<U>(cast<mut IIterator<U>>(this), pred);
            return it;
        }
        #template(R: type)
        fun reduce(mut this, init: R, f: mut fun<R, R, U>) -> R {
            let mut acc = init;
            let mut v = this.next();
            while (v.is_some()) {
                acc = f(acc, v.some);
                v = this.next();
            }
            return acc;
        }
        fun all(mut this, pred: mut fun<bool, U>) -> bool {
            let mut v = this.next();
            while (v.is_some()) {
                if (!(pred(v.some))) { return false; }
                v = this.next();
            }
            return true;
        }
        fun any(mut this, pred: mut fun<bool, U>) -> bool {
            let mut v = this.next();
            while (v.is_some()) {
                if (pred(v.some)) { return true; }
                v = this.next();
            }
            return false;
        }
        #template(C: type)
        fun into(mut this) -> C {
            let mut c = new C();
            let mut v = this.next();
            while (v.is_some()) {
                c.push(v.some);
                v = this.next();
            }
            return c;
        }

    }

    // FilterIterator: yields only the elements matching pred (lazily).
    #template(T: type)
    class FilterIterator {
        impl IReferenceType;
        src: mut IIterator<T>;
        pred: mut fun<bool, T>;

        fun new(mut this, src: mut IIterator<T>, pred: mut fun<bool, T>) {
            this.src = src;
            this.pred = pred;
        }

        fun next(mut this) -> Option<T> {
            while (true) {
                let v: Option<T> = this.src.next();
                if (v.is_none()) { return new Option<T>.none(); }
                if (this.pred(v.some)) { return new Option<T>.some(v.some); }
            }
            return new Option<T>.none();
        }

        impl IIterator<T> {
            fun next(mut this) -> Option<T> {
                while (true) {
                    let v: Option<T> = this.src.next();
                    if (v.is_none()) { return new Option<T>.none(); }
                    if (this.pred(v.some)) { return new Option<T>.some(v.some); }
                }
                return new Option<T>.none();
            }
        }

        #template(U: type)
        fun map(mut this, f: mut fun<U, T>) -> mut MapIterator<T, U> {
            let it: mut MapIterator<T, U> = new MapIterator<T, U>(cast<mut IIterator<T>>(this), f);
            return it;
        }
        fun filter(mut this, pred: mut fun<bool, T>) -> mut FilterIterator<T> {
            let it: mut FilterIterator<T> = new FilterIterator<T>(cast<mut IIterator<T>>(this), pred);
            return it;
        }
        #template(R: type)
        fun reduce(mut this, init: R, f: mut fun<R, R, T>) -> R {
            let mut acc = init;
            let mut v = this.next();
            while (v.is_some()) {
                acc = f(acc, v.some);
                v = this.next();
            }
            return acc;
        }
        fun all(mut this, pred: mut fun<bool, T>) -> bool {
            let mut v = this.next();
            while (v.is_some()) {
                if (!(pred(v.some))) { return false; }
                v = this.next();
            }
            return true;
        }
        fun any(mut this, pred: mut fun<bool, T>) -> bool {
            let mut v = this.next();
            while (v.is_some()) {
                if (pred(v.some)) { return true; }
                v = this.next();
            }
            return false;
        }
        #template(C: type)
        fun into(mut this) -> C {
            let mut c = new C();
            let mut v = this.next();
            while (v.is_some()) {
                c.push(v.some);
                v = this.next();
            }
            return c;
        }

    }

class Range {
        start: i64 = 0;
        end: i64 = 0;
        fun new(mut this, start: i64, end: i64) {
            this.start = start;
            this.end = end;
        }
        fun iter(this) -> RangeIterator {
            return new RangeIterator(this.start, this.end);
        }
    }

    fun range(start: i64, end: i64) -> mut RangeIterator {
        return new RangeIterator(start, end);
    }

}
