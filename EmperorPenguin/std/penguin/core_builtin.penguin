namespace __builtin {
    extern fun exit(code : i32);
    extern fun print(text : string);
    extern fun println(text : string);
    extern fun eprint(text : string);
    extern fun eprintln(text : string);
    extern fun _exec_cmd(cmd: string) -> i64;

    extern fun lshift(value: i64, shift: i64) -> i64;
    extern fun rshift(value: i64, shift: i64) -> i64;

    extern fun gc_collect();
    extern fun gc_info() -> i64;

    // Raw heap allocation for manually-managed buffers (Array<T,N>, _ptr<T>).
    // Routed to @_emperor_malloc / @_emperor_mfree in core_builtin.c (libc
    // malloc/free, NOT the GC arena). Unreferenced externs are free.
    extern fun _malloc(size: u64) -> u64;
    extern fun _mfree(addr: u64);
    // GC scan-region registration for raw buffers that CONTAIN pointers to GC
    // objects (Vector/HashMap/Array element storage). The conservative
    // collector cannot see inside malloc'd memory: register the buffer right
    // after allocating it, and remove the region BEFORE freeing/replacing it
    // (dispose_mem / _grow). A missing registration means live elements get
    // swept; a stale one only retains garbage.
    extern fun _gc_scan_add(addr: u64, size: i64);
    extern fun _gc_scan_remove(addr: u64);

    // Byte-level helpers for generic HashMap<K,V>: hash and equality over the raw
    // bytes of a value-type key (address + #sizeof). Routed to @_emperor_hash_bytes
    // / @_emperor_bytes_equal in core_builtin.c.
    extern fun _hash_bytes(addr: u64, len: u64) -> u64;
    extern fun _bytes_equal(addr1: u64, addr2: u64, len: u64) -> i64;

    extern fun __args_count() -> i64;
    extern fun __args_get(index: i64) -> string;

    // --- Coroutine scheduler runtime (scheduler.c) ---
    // Stackful coroutines: initial routines and `async f()` spawns each run on
    // their own stack; `wait` parks the current coroutine for one delta round.
    extern fun _co_wait();
    extern fun _sim_now() -> i64;
    extern fun _sim_delta() -> i64;
    extern fun _sim_activity();
    extern fun _sim_settled() -> bool;
    // Register a timer deadline; readiness is observed by _TimerWait.poll.
    extern fun _timer_at(deadline: i64);
    // Spawn a coroutine whose entry is a __ICoroutineEntry object (the
    // async-spawn desugar's ctx class implements it).
    extern fun _co_spawn_entry(entry: mut __ICoroutineEntry);
    // Throw a runtime error: caught by the innermost enclosing try/catch of
    // the current coroutine, or reported and exited if uncaught.
    extern fun __throw_runtime_error(message: string, code: i64);
    extern fun __throw_get_msg() -> string;
    extern fun __throw_get_code() -> i64;
    // try/catch (sjlj): the compiled function calls _setjmp itself on a
    // per-site buffer from the C runtime's table. __TryBuf is the opaque
    // handle type for that buffer; __sjlj_setjmp is a MARKER call — the LLVM
    // emitter intercepts it and inlines `call i32 @_setjmp(ptr <buf>)` so the
    // landing happens inside the still-live compiled function (a C-side
    // wrapper's dead frame would make the landing undefined).
    class __TryBuf {
        impl IReferenceType;
    }
    extern fun _try_buf(site: i64) -> mut __TryBuf;
    extern fun _try_setup(site: i64);
    extern fun _try_leave();
    extern fun __sjlj_setjmp(jb: mut __TryBuf) -> i32;

    // The coroutine entry interface: __enter runs on the spawned coroutine's
    // own stack (void return, single receiver — a stable C-side vtable call).
    interface __ICoroutineEntry {
        impl IReferenceType;
        fun __enter(mut this);
    }

    #template(T: type)
    enum FutureState {
        not_ready;
        ready: T;
        finished;
        ready_finished: T;
    }

    // A waitable value: poll probes readiness (non-consuming from the
    // waiter's perspective — implementations decide cursor semantics);
    // do_wait parks one delta round between polls until a delivering state.
    #template(T: type)
    interface IFuture {
        impl IReferenceType;
        fun poll(this) -> mut FutureState<T>;

        !async fun do_wait(mut this) -> T {
            let state: mut FutureState<T> = new FutureState<T>.not_ready();
            while (true) {
                __builtin._co_wait();
                state = this.poll();
                if (state is FutureState<T>.ready_finished) {
                    break;
                }
                if (state is FutureState<T>.finished) {
                    break;
                }
            }
            if (state is FutureState<T>.ready_finished) {
                __builtin._sim_activity();
            }
            // A `finished` (already-consumed) future returns its stale payload
            // slot — BabyPenguin returns an uninitialized default there.
            return state.ready_finished;
        }
    }

    // Timer future: `wait n tick` desugars to _after(n).do_wait() — the
    // deadline is registered with the scheduler; the clock advances when the
    // simulation is otherwise idle.
    class _TimerWait {
        impl IReferenceType;
        finished: mut bool = false;
        result_tick: mut i64 = 0;

        impl IFuture<i64> {
            fun poll(this) -> mut FutureState<i64> {
                if (__builtin._sim_now() >= this.result_tick) {
                    return new FutureState<i64>.ready_finished(this.result_tick);
                }
                return new FutureState<i64>.not_ready();
            }
        }
    }

    fun _after(n: i64) -> mut _TimerWait {
        let t: mut _TimerWait = new _TimerWait();
        t.result_tick = __builtin._sim_now() + n;
        __builtin._timer_at(t.result_tick);
        return t;
    }

    // The future behind every `async f(args)` spawn: the synthesized ctx
    // class's __enter calls complete() with the function's result.
    #template(R: type)
    class __SpawnFuture {
        impl IReferenceType;
        done: mut bool = false;
        result: mut Option<R> = new Option<R>.none();

        fun complete(mut this, v: R) {
            this.result = new Option<R>.some(v);
            this.done = true;
        }

        impl IFuture<R> {
            fun poll(this) -> mut FutureState<R> {
                if (this.done && this.result.is_some()) {
                    return new FutureState<R>.ready_finished(this.result.some);
                }
                return new FutureState<R>.not_ready();
            }
        }
    }

    // Unit future for void spawns: `let f = async set_x();` yields one; it
    // cannot be waited (void has no deliverable value — BabyPenguin's
    // IFuture<void> gap is intentionally not emulated).
    class __SpawnUnitFuture {
        impl IReferenceType;
        done: mut bool = false;

        fun complete_unit(mut this) {
            this.done = true;
        }
    }

    // ============ Coroutine channel layer (E4 — mirrors BabyPenguin Builtin.penguin) ============
    // Source-level compatible contract: ISource/ISink/IChannel share names
    // and shapes with BabyPenguin. EmperorPenguin has no interface
    // inheritance, so IChannel declares only its own methods (close/
    // is_closed) and every concrete channel additionally implements
    // ISource<T>, ISink<T> and IFuture<T> in separate blocks (the same class
    // shape as BabyPenguin's channels, whose IChannel surface is inherited).

    #template(T: type)
    class _ChanNode {
        impl IReferenceType;
        value: T;
        next: mut Option<_ChanNode<T>> = new Option<_ChanNode<T>>.none();
        fun new(mut this, value: T) {
            this.value = value;
        }
    }

    // Linked FIFO queue (core_builtin cannot use _utils containers).
    #template(T: type)
    class _ChanQueue {
        impl IReferenceType;
        head: mut Option<_ChanNode<T>> = new Option<_ChanNode<T>>.none();
        tail: mut Option<_ChanNode<T>> = new Option<_ChanNode<T>>.none();
        count: mut i64 = 0;

        fun new(mut this) {}

        fun size(mut this) -> i64 {
            return this.count;
        }

        fun enqueue(mut this, v: T) {
            let node: mut _ChanNode<T> = new _ChanNode<T>(v);
            if (this.tail.is_some()) {
                let t: mut _ChanNode<T> = cast<mut _ChanNode<T>>(this.tail.some);
                t.next = new Option<_ChanNode<T>>.some(node);
                this.tail = new Option<_ChanNode<T>>.some(node);
            } else {
                this.head = new Option<_ChanNode<T>>.some(node);
                this.tail = new Option<_ChanNode<T>>.some(node);
            }
            this.count = this.count + 1;
        }

        fun dequeue(mut this) -> Option<T> {
            if (this.head.is_none()) {
                return new Option<T>.none();
            }
            let h: _ChanNode<T> = this.head.some;
            let v: T = h.value;
            this.head = h.next;
            if (this.head.is_none()) {
                this.tail = new Option<_ChanNode<T>>.none();
            }
            this.count = this.count - 1;
            return new Option<T>.some(v);
        }
    }

    // Linked list with index access (fanout wires / subscribers / sources).
    #template(T: type)
    class _ChanList {
        impl IReferenceType;
        head: mut Option<_ChanNode<T>> = new Option<_ChanNode<T>>.none();
        count: mut i64 = 0;

        fun new(mut this) {}

        fun size(mut this) -> i64 {
            return this.count;
        }

        fun push(mut this, v: T) {
            let node: mut _ChanNode<T> = new _ChanNode<T>(v);
            if (this.head.is_none()) {
                this.head = new Option<_ChanNode<T>>.some(node);
                this.count = 1;
                return;
            }
            let cur: mut _ChanNode<T> = cast<mut _ChanNode<T>>(this.head.some);
            while (cur.next.is_some()) {
                cur = cast<mut _ChanNode<T>>(cur.next.some);
            }
            cur.next = new Option<_ChanNode<T>>.some(node);
            this.count = this.count + 1;
        }

        fun at(mut this, index: i64) -> Option<T> {
            if (index < 0 || index >= this.count) {
                return new Option<T>.none();
            }
            let cur: mut _ChanNode<T> = cast<mut _ChanNode<T>>(this.head.some);
            let i: mut i64 = 0;
            while (i < index) {
                cur = cast<mut _ChanNode<T>>(cur.next.some);
                i = i + 1;
            }
            return new Option<T>.some(cur.value);
        }

        fun remove_at(mut this, index: i64) {
            if (index < 0 || index >= this.count) {
                return;
            }
            if (index == 0) {
                if (this.head.is_some()) {
                    let h0: _ChanNode<T> = this.head.some;
                    if (h0.next.is_some()) {
                        let hn: mut _ChanNode<T> = cast<mut _ChanNode<T>>(h0.next.some);
                        this.head = new Option<_ChanNode<T>>.some(hn);
                    } else {
                        this.head = new Option<_ChanNode<T>>.none();
                    }
                    this.count = this.count - 1;
                }
                return;
            }
            let prev: mut _ChanNode<T> = cast<mut _ChanNode<T>>(this.head.some);
            let i: mut i64 = 0;
            while (i < index - 1) {
                prev = cast<mut _ChanNode<T>>(prev.next.some);
                i = i + 1;
            }
            if (prev.next.is_some()) {
                let target: _ChanNode<T> = prev.next.some;
                if (target.next.is_some()) {
                    let tn: mut _ChanNode<T> = cast<mut _ChanNode<T>>(target.next.some);
                    prev.next = new Option<_ChanNode<T>>.some(tn);
                } else {
                    prev.next = new Option<_ChanNode<T>>.none();
                }
            }
            this.count = this.count - 1;
        }

        // Rotate the first `k` entries to the back (MultiInput round-robin).
        fun rotate(mut this, rotations: i64) {
            if (this.count < 2 || rotations <= 0) {
                return;
            }
            let k: mut i64 = rotations;
            if (k > this.count) {
                k = this.count;
            }
            let i: mut i64 = 0;
            while (i < k) {
                if (this.head.is_none()) {
                    return;
                }
                let h: mut _ChanNode<T> = cast<mut _ChanNode<T>>(this.head.some);
                if (h.next.is_some()) {
                    let hn: mut _ChanNode<T> = cast<mut _ChanNode<T>>(h.next.some);
                    this.head = new Option<_ChanNode<T>>.some(hn);
                } else {
                    this.head = new Option<_ChanNode<T>>.none();
                }
                h.next = new Option<_ChanNode<T>>.none();
                if (this.head.is_none()) {
                    this.head = new Option<_ChanNode<T>>.some(h);
                    return;
                }
                let cur: mut _ChanNode<T> = cast<mut _ChanNode<T>>(this.head.some);
                while (cur.next.is_some()) {
                    cur = cast<mut _ChanNode<T>>(cur.next.some);
                }
                cur.next = new Option<_ChanNode<T>>.some(h);
                i = i + 1;
            }
        }
    }

    enum FifoPolicy {
        backpressure;
        drop;

        fun is_backpressure(this) -> bool {
            return this is FifoPolicy.backpressure;
        }

        fun is_drop(this) -> bool {
            return this is FifoPolicy.drop;
        }
    }

    #template(T: type)
    interface ISource {
        impl IReferenceType;
        // Non-blocking probe: take one pending transaction, or none.
        fun try_poll(mut this) -> Option<T>;
        // Latest delivered slot, without consuming (none when never written).
        fun current(this) -> Option<T>;
    }

    #template(T: type)
    interface ISink {
        impl IReferenceType;
        // Deliver a transaction. On a full backpressuring channel this
        // suspends until a slot frees up (Go-channel semantics).
        fun write(mut this, v: T);
        // Non-blocking escape hatch: false when the channel was full.
        fun try_write(mut this, v: T) -> bool;
    }

    // EP has no interface inheritance, so IChannel declares only its own
    // methods (close/is_closed); every concrete channel additionally
    // implements ISource<T>, ISink<T> and IFuture<T> in separate blocks (the
    // same class shape as BabyPenguin's channels, whose IChannel surface is
    // inherited). Port fields are typed `mut IChannel<T>`; method calls on
    // them that belong to the source/sink surface (write/try_write/current/
    // try_poll) are rewritten by the compiler to an explicit interface cast
    // (same-named methods in two impl blocks of one class are not
    // expressible in EP, so the surface cannot live on IChannel itself).
    #template(T: type)
    interface IChannel {
        impl IReferenceType;
        fun close(mut this);
        fun is_closed(this) -> bool;
    }

    fun _channel_closed_error() {
        __throw_runtime_error("channel closed", 100);
    }

    #template(T: type)
    class Fifo {
        impl IReferenceType;

        queue: mut _ChanQueue<T> = new _ChanQueue<T>();
        capacity: i64 = 0;
        policy: FifoPolicy = new FifoPolicy.backpressure();
        closed: mut bool = false;
        latest: mut Option<T> = new Option<T>.none();

        fun new(mut this, capacity: i64, policy: mut FifoPolicy) {
            this.capacity = capacity;
            this.policy = policy;
        }

        fun check_closed(mut this) {
            if (this.closed) {
                _channel_closed_error();
            }
        }

        fun is_full(mut this) -> bool {
            return this.queue.size() >= this.capacity;
        }

        fun deliver(mut this, v: T) {
            _sim_activity();
            this.queue.enqueue(v);
            this.latest = new Option<T>.some(v);
        }

        impl ISink<T> {
            fun write(this: mut ISink<T>, v: T) {
                let self: mut Fifo<T> = cast<mut Fifo<T>>(this);
                self.check_closed();
                if (self.policy.is_drop()) {
                    // Drop policy: a full channel silently discards the new value.
                    if (!self.is_full()) {
                        self.deliver(v);
                    }
                    return;
                }
                // Backpressure: park (bare wait = one delta) until a slot
                // frees up; every wakeup re-checks close.
                while (self.is_full()) {
                    wait;
                    self.check_closed();
                }
                self.deliver(v);
            }

            fun try_write(this: mut ISink<T>, v: T) -> bool {
                let self: mut Fifo<T> = cast<mut Fifo<T>>(this);
                self.check_closed();
                if (self.is_full()) {
                    return false;
                }
                self.deliver(v);
                return true;
            }
        }

        impl ISource<T> {
            fun try_poll(this: mut ISource<T>) -> Option<T> {
                let self: mut Fifo<T> = cast<mut Fifo<T>>(this);
                self.check_closed();
                return self.queue.dequeue();
            }

            fun current(this: ISource<T>) -> Option<T> {
                let self: Fifo<T> = cast<Fifo<T>>(this);
                return self.latest;
            }
        }

        impl IChannel<T> {
            fun close(this: mut IChannel<T>) {
                let self: mut Fifo<T> = cast<mut Fifo<T>>(this);
                self.closed = true;
            }

            fun is_closed(this: IChannel<T>) -> bool {
                let self: Fifo<T> = cast<Fifo<T>>(this);
                return self.closed;
            }
        }

        // `wait fifo` — the next transaction, delivered in FIFO order.
        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                let self: mut Fifo<T> = cast<mut Fifo<T>>(this);
                self.check_closed();
                let v: Option<T> = self.queue.dequeue();
                if (v.is_some()) {
                    return new FutureState<T>.ready_finished(v.some);
                }
                return new FutureState<T>.not_ready();
            }
        }
    }

    // Wire / diagnostic channel: transaction-stream semantics with an
    // independent delivery cursor. Writes in the SAME delta round collapse
    // to the final value (a wire settles to one value per delta), while
    // writes in different rounds are each delivered, in order, to every
    // consumer whenever it polls — a late consumer never loses
    // transactions. A connect-time seed value is delivered at most once and
    // only while no real write has ever happened: any write supersedes it.
    // `current()` reads the latest delivered value (or the seed) without
    // consuming.
    #template(T: type)
    class LatestChannel {
        impl IReferenceType;

        // Committed transactions from earlier rounds (consumed entries
        // dequeue off the front).
        committed: mut _ChanQueue<T> = new _ChanQueue<T>();
        // The current round's write; same-round writes replace it while it
        // is still unconsumed. Flushed to `committed` when a later round
        // writes (FIFO order across rounds).
        pending: mut Option<T> = new Option<T>.none();
        pending_round: mut i64 = -1;
        ever_written: mut bool = false;
        last_value: mut Option<T> = new Option<T>.none();
        // Connect-time initial value: weak one-shot delivery, superseded by
        // any real transaction. Only wires granted by subscribe() /
        // connect_wire mark the seed deliverable (time-0 first-wait
        // wake-up); elsewhere the seed serves current() bare reads only.
        seed: mut Option<T> = new Option<T>.none();
        seed_taken: mut bool = false;
        seed_deliver: mut bool = false;
        closed: mut bool = false;

        fun new(mut this) {}

        fun set_seed(mut this, v: T, deliver: bool) {
            this.seed = new Option<T>.some(v);
            this.seed_deliver = deliver;
        }

        fun check_closed(mut this) {
            if (this.closed) {
                _channel_closed_error();
            }
        }

        fun push(mut this, v: T) {
            let d: i64 = _sim_delta();
            if (this.pending.is_some() && this.pending_round == d) {
                // Same delta round, previous write not yet consumed: the
                // wire settles to the final value.
                this.pending = new Option<T>.some(v);
            } else {
                if (this.pending.is_some()) {
                    this.committed.enqueue(this.pending.some);
                }
                this.pending = new Option<T>.some(v);
                this.pending_round = d;
            }
            this.ever_written = true;
            this.last_value = new Option<T>.some(v);
        }

        // Advance the cursor: oldest undelivered transaction, else the
        // one-shot seed (only before any real write), else none.
        fun take(mut this) -> Option<T> {
            let head: Option<T> = this.committed.dequeue();
            if (head.is_some()) {
                return head;
            }
            if (this.pending.is_some()) {
                let v: Option<T> = this.pending;
                this.pending = new Option<T>.none();
                return v;
            }
            if (!this.ever_written && this.seed.is_some() && !this.seed_taken && this.seed_deliver) {
                this.seed_taken = true;
                return this.seed;
            }
            return new Option<T>.none();
        }

        impl ISink<T> {
            fun write(this: mut ISink<T>, v: T) {
                let self: mut LatestChannel<T> = cast<mut LatestChannel<T>>(this);
                self.check_closed();
                _sim_activity();
                self.push(v);
            }

            fun try_write(this: mut ISink<T>, v: T) -> bool {
                let self: mut LatestChannel<T> = cast<mut LatestChannel<T>>(this);
                self.check_closed();
                _sim_activity();
                self.push(v);
                return true;
            }
        }

        impl ISource<T> {
            fun try_poll(this: mut ISource<T>) -> Option<T> {
                let self: mut LatestChannel<T> = cast<mut LatestChannel<T>>(this);
                self.check_closed();
                return self.take();
            }

            fun current(this: ISource<T>) -> Option<T> {
                let self: LatestChannel<T> = cast<LatestChannel<T>>(this);
                if (self.last_value.is_some()) {
                    return self.last_value;
                }
                return self.seed;
            }
        }

        impl IChannel<T> {
            fun close(this: mut IChannel<T>) {
                let self: mut LatestChannel<T> = cast<mut LatestChannel<T>>(this);
                self.closed = true;
            }

            fun is_closed(this: IChannel<T>) -> bool {
                let self: LatestChannel<T> = cast<LatestChannel<T>>(this);
                return self.closed;
            }
        }

        // v1 waiters share this channel's single cursor (competing
        // consumers, like any standalone channel). Broadcast fan-out with
        // per-consumer cursors is what an output port's subscribe() wires
        // and Event.connect_wire() grant.
        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                let self: mut LatestChannel<T> = cast<mut LatestChannel<T>>(this);
                self.check_closed();
                let v: Option<T> = self.take();
                if (v.is_some()) {
                    return new FutureState<T>.ready_finished(v.some);
                }
                return new FutureState<T>.not_ready();
            }
        }
    }

    // Two-source merge (fan-in): transactions arrive in arrival order across
    // both sources. Source-only in v1 (writes go to the channels it merges).
    #template(T: type)
    class MergeChannel {
        impl IReferenceType;

        a: mut ISource<T>;
        b: mut ISource<T>;
        closed: mut bool = false;

        fun new(mut this, a: mut ISource<T>, b: mut ISource<T>) {
            this.a = a;
            this.b = b;
        }

        fun check_closed(mut this) {
            if (this.closed) {
                _channel_closed_error();
            }
        }

        fun poll_once(mut this) -> Option<T> {
            let va: Option<T> = this.a.try_poll();
            if (va.is_some()) {
                return va;
            }
            return this.b.try_poll();
        }

        impl ISource<T> {
            fun try_poll(this: mut ISource<T>) -> Option<T> {
                let self: mut MergeChannel<T> = cast<mut MergeChannel<T>>(this);
                self.check_closed();
                return self.poll_once();
            }

            fun current(this: ISource<T>) -> Option<T> {
                let self: MergeChannel<T> = cast<MergeChannel<T>>(this);
                return self.a.current();
            }
        }

        impl IChannel<T> {
            fun close(this: mut IChannel<T>) {
                let self: mut MergeChannel<T> = cast<mut MergeChannel<T>>(this);
                self.closed = true;
            }

            fun is_closed(this: IChannel<T>) -> bool {
                let self: MergeChannel<T> = cast<MergeChannel<T>>(this);
                return self.closed;
            }
        }

        // `wait merge` — the next transaction across either source.
        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                let self: mut MergeChannel<T> = cast<mut MergeChannel<T>>(this);
                self.check_closed();
                let v: Option<T> = self.poll_once();
                if (v.is_some()) {
                    return new FutureState<T>.ready_finished(v.some);
                }
                return new FutureState<T>.not_ready();
            }
        }
    }

    // Permanently idle source: the placeholder behind an unconnected input
    // port without a default. Polls never deliver (wait parks — the routine
    // contributes identical rounds and ends at quiescence, per the "unbound
    // input wait blocks, it does not crash" rule), current() is none, and
    // writes are rejected.
    #template(T: type)
    class _NeverSource {
        impl IReferenceType;

        fun new(mut this) {}

        impl ISink<T> {
            fun write(this: mut ISink<T>, v: T) {
                _channel_closed_error();
            }

            fun try_write(this: mut ISink<T>, v: T) -> bool {
                _channel_closed_error();
                return false;
            }
        }

        impl ISource<T> {
            fun try_poll(this: mut ISource<T>) -> Option<T> {
                return new Option<T>.none();
            }

            fun current(this: ISource<T>) -> Option<T> {
                return new Option<T>.none();
            }
        }

        impl IChannel<T> {
            fun close(this: mut IChannel<T>) {
            }

            fun is_closed(this: IChannel<T>) -> bool {
                return false;
            }
        }

        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                return new FutureState<T>.not_ready();
            }
        }
    }

    // Late-binding relay: the object behind a passed-through input port
    // (connect(this.x, inner.x)). The class construct wires inner.x to this
    // view BEFORE the enclosing instance's own input is connected from the
    // outside; every poll/current/close re-reads the upstream FIELD, so the
    // real source is picked up whenever the outer connect binds it.
    // (EP adaptation: IChannel carries only close/is_closed — source/sink-
    // surface calls on the upstream field go through explicit interface casts.)
    #template(T: type)
    class _LateSource {
        impl IReferenceType;

        upstream: mut IChannel<T> = new _NeverSource<T>();

        fun new(mut this) {}

        // The outer connect calls this with the real source (wire/channel).
        fun bind(mut this, src: mut IChannel<T>) {
            this.upstream = src;
        }

        impl ISink<T> {
            fun write(this: mut ISink<T>, v: T) {
                _channel_closed_error();
            }

            fun try_write(this: mut ISink<T>, v: T) -> bool {
                _channel_closed_error();
                return false;
            }
        }

        impl ISource<T> {
            fun try_poll(this: mut ISource<T>) -> Option<T> {
                let self: mut _LateSource<T> = cast<mut _LateSource<T>>(this);
                return cast<mut ISource<T>>(self.upstream).try_poll();
            }

            fun current(this: ISource<T>) -> Option<T> {
                let self: _LateSource<T> = cast<_LateSource<T>>(this);
                return cast<ISource<T>>(self.upstream).current();
            }
        }

        impl IChannel<T> {
            fun close(this: mut IChannel<T>) {
                let self: mut _LateSource<T> = cast<mut _LateSource<T>>(this);
                self.upstream.close();
            }

            fun is_closed(this: IChannel<T>) -> bool {
                let self: _LateSource<T> = cast<_LateSource<T>>(this);
                return self.upstream.is_closed();
            }
        }

        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                let self: mut _LateSource<T> = cast<mut _LateSource<T>>(this);
                return cast<mut IFuture<T>>(self.upstream).poll();
            }
        }
    }

    // Constant payload source: an input port's default when left unconnected.
    // current() always yields the constant; it never delivers a transaction
    // (wait parks forever — the port is unconnected) and writes are invalid.
    #template(T: type)
    class ConstantSource {
        impl IReferenceType;

        value: T;
        closed: mut bool = false;

        fun new(mut this, value: T) {
            this.value = value;
        }

        fun check_closed(mut this) {
            if (this.closed) {
                _channel_closed_error();
            }
        }

        impl ISink<T> {
            fun write(this: mut ISink<T>, v: T) {
                _channel_closed_error();
            }

            fun try_write(this: mut ISink<T>, v: T) -> bool {
                _channel_closed_error();
                return false;
            }
        }

        impl ISource<T> {
            fun try_poll(this: mut ISource<T>) -> Option<T> {
                return new Option<T>.none();
            }

            fun current(this: ISource<T>) -> Option<T> {
                let self: ConstantSource<T> = cast<ConstantSource<T>>(this);
                return new Option<T>.some(self.value);
            }
        }

        impl IChannel<T> {
            fun close(this: mut IChannel<T>) {
                let self: mut ConstantSource<T> = cast<mut ConstantSource<T>>(this);
                self.closed = true;
            }

            fun is_closed(this: IChannel<T>) -> bool {
                let self: ConstantSource<T> = cast<ConstantSource<T>>(this);
                return self.closed;
            }
        }

        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                return new FutureState<T>.not_ready();
            }
        }
    }

    // Output-port fanout hub: the module's single driver writes here; every
    // connected input gets its OWN wire via subscribe() (independent delivery
    // cursors — each subscriber receives every transaction in order), while
    // the hub's own slot stream serves direct `wait out_port` /
    // `out_port.try_poll()` readers at the wiring level (one shared cursor,
    // competing consumers). The declared default / type zero value lives in
    // the slot as a weak seed: bare reads before any write return it, and
    // subscribe() seeds new wires from it (time-0 first-wait wake-up).
    #template(T: type)
    class _Fanout {
        impl IReferenceType;

        wires: mut _ChanList<LatestChannel<T>> = new _ChanList<LatestChannel<T>>();
        slot: mut LatestChannel<T> = new LatestChannel<T>();
        closed: mut bool = false;

        fun new(mut this) {}

        // The hub slot's seed: an EXPLICIT declared default (`output p = v`)
        // is a weak deliverable transaction (time-0 first-wait wake-up,
        // superseded by any real write); a synthesized type-zero seed only
        // backs current() bare reads — direct `wait port` parks until the
        // module actually writes.
        fun set_seed(mut this, v: T, deliver: bool) {
            this.slot.set_seed(v, deliver);
        }

        fun subscribe(mut this) -> mut LatestChannel<T> {
            let w: mut LatestChannel<T> = new LatestChannel<T>();
            // Connect-time seeding: whatever the hub slot currently holds
            // (a variable net's current value, an output port's declared
            // default or type zero) becomes the new wire's DELIVERABLE seed
            // — the subscriber's first `wait` wakes immediately at time 0
            // (Q3), and any real write supersedes it.
            let cur: Option<T> = this.slot.current();
            if (cur.is_some()) {
                w.set_seed(cur.some, true);
            }
            this.wires.push(w);
            return w;
        }

        fun check_closed(mut this) {
            if (this.closed) {
                _channel_closed_error();
            }
        }

        fun write_all(mut this, v: T) {
            _sim_activity();
            this.slot.push(v);
            let wi: mut i64 = 0;
            while (wi < this.wires.size()) {
                let w: mut LatestChannel<T> = cast<mut LatestChannel<T>>(this.wires.at(wi).some);
                w.write(v);
                wi = wi + 1;
            }
        }

        impl ISink<T> {
            fun write(this: mut ISink<T>, v: T) {
                let self: mut _Fanout<T> = cast<mut _Fanout<T>>(this);
                self.check_closed();
                self.write_all(v);
            }

            fun try_write(this: mut ISink<T>, v: T) -> bool {
                let self: mut _Fanout<T> = cast<mut _Fanout<T>>(this);
                self.check_closed();
                self.write_all(v);
                return true;
            }
        }

        impl ISource<T> {
            fun try_poll(this: mut ISource<T>) -> Option<T> {
                let self: mut _Fanout<T> = cast<mut _Fanout<T>>(this);
                self.check_closed();
                return self.slot.take();
            }

            fun current(this: ISource<T>) -> Option<T> {
                let self: _Fanout<T> = cast<_Fanout<T>>(this);
                return self.slot.current();
            }
        }

        impl IChannel<T> {
            fun close(this: mut IChannel<T>) {
                let self: mut _Fanout<T> = cast<mut _Fanout<T>>(this);
                self.closed = true;
            }

            fun is_closed(this: IChannel<T>) -> bool {
                let self: _Fanout<T> = cast<_Fanout<T>>(this);
                return self.closed;
            }
        }

        // Directly waitable: consumes the hub's own slot stream (single
        // shared cursor for wiring-level readers). Module-to-module wiring
        // goes through subscribe(), which grants each input an independent
        // cursor.
        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                let self: mut _Fanout<T> = cast<mut _Fanout<T>>(this);
                self.check_closed();
                let v: Option<T> = self.slot.take();
                if (v.is_some()) {
                    return new FutureState<T>.ready_finished(v.some);
                }
                return new FutureState<T>.not_ready();
            }
        }
    }

    // Dynamic fan-in: a port-like object accepting N connects. `wait mi`
    // returns the next transaction across ANY connected source — the scan
    // starts where the previous one stopped (rotating), so a busy source
    // cannot starve the others.
    #template(T: type)
    class MultiInput {
        impl IReferenceType;

        sources: mut _ChanList<ISource<T>> = new _ChanList<ISource<T>>();

        fun new(mut this) {}

        // Register a source view (the connect desugaring calls this).
        fun add(mut this, source: mut ISource<T>) {
            this.sources.push(source);
        }

        fun size(mut this) -> u64 {
            return cast<u64>(this.sources.size());
        }

        // Non-blocking probe across every registered source, round-robin:
        // after a hit, the producing source and everything skipped this
        // round move to the back, so a busy source cannot starve the rest.
        fun try_poll_any(mut this) -> Option<T> {
            let n: i64 = this.sources.size();
            if (n == 0) {
                return new Option<T>.none();
            }
            let skipped: mut i64 = 0;
            let i: mut i64 = 0;
            while (i < n) {
                let s: mut ISource<T> = cast<mut ISource<T>>(this.sources.at(i).some);
                let v: Option<T> = s.try_poll();
                if (v.is_some()) {
                    this.sources.rotate(skipped + 1);
                    return v;
                }
                skipped = skipped + 1;
                i = i + 1;
            }
            return new Option<T>.none();
        }

        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                let self: mut MultiInput<T> = cast<mut MultiInput<T>>(this);
                let v: Option<T> = self.try_poll_any();
                if (v.is_some()) {
                    return new FutureState<T>.ready_finished(v.some);
                }
                return new FutureState<T>.not_ready();
            }
        }
    }

    // The catch handler's error object: message + numeric code (panic uses
    // code 1, channel-closed 100 — mirrors BabyPenguin's RuntimeError).
    class RuntimeError {
        impl IReferenceType;
        message: string = "";
        code: i64 = 0;

        fun new(mut this, message: string, code: i64) {
            this.message = message;
            this.code = code;
        }
    }

    // ============ Event (anonymous broadcast) ============
    // First-class broadcast hub replacing the old event/emit/on keywords. An
    // event is an ordinary value: store it in a global, a class field or a
    // local, pass it to free functions, emit from anywhere. Any number of
    // waiters may park on one event and every emit reaches ALL of them —
    // each `wait ev` parks on its own one-slot subscription created by the
    // compiler's wait rewrite (the constructor subscribes). Values emitted
    // while nobody is waiting are lost (broadcast, not queueing — use Fifo
    // for store-and-forward), and two emits before a waiter re-parks
    // collapse to the last value, like a wire.
    #template(T: type)
    class _EventSubscription {
        impl IReferenceType;

        // Identity for unsubscribe (no reference-equality operator on classes).
        sid: i64 = 0;
        ev: mut Event<T>;
        value: mut Option<T> = new Option<T>.none();

        fun new(mut this, ev: mut Event<T>) {
            this.sid = _event_sub_next_id();
            this.ev = ev;
            ev.subscribe(this);
        }

        fun deliver(mut this, v: T) {
            this.value = new Option<T>.some(v);
        }

        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                let self: mut _EventSubscription<T> = cast<mut _EventSubscription<T>>(this);
                if (self.value.is_some()) {
                    let v: T = self.value.some;
                    self.value = new Option<T>.none();
                    self.ev.unsubscribe(self.sid);
                    return new FutureState<T>.ready_finished(v);
                }
                return new FutureState<T>.not_ready();
            }
        }
    }

    let _event_sub_counter: mut i64 = 0;
    fun _event_sub_next_id() -> i64 {
        _event_sub_counter = _event_sub_counter + 1;
        return _event_sub_counter;
    }

    #template(T: type)
    class Event {
        impl IReferenceType;

        subscribers: mut _ChanList<_EventSubscription<T>> = new _ChanList<_EventSubscription<T>>();
        // Wires granted to connected input ports (connect(ev, f.x)): unlike
        // a parked wait's one-shot subscription, a wire stays registered and
        // its own delivery cursor governs when the consumer sees a value.
        wires: mut _ChanList<LatestChannel<T>> = new _ChanList<LatestChannel<T>>();

        fun new(mut this) {}

        fun emit(mut this, v: T) {
            _sim_activity();
            let i: mut i64 = 0;
            while (i < this.subscribers.size()) {
                let s: mut _EventSubscription<T> = cast<mut _EventSubscription<T>>(this.subscribers.at(i).some);
                s.deliver(v);
                i = i + 1;
            }
            let w: mut i64 = 0;
            while (w < this.wires.size()) {
                let ch: mut LatestChannel<T> = cast<mut LatestChannel<T>>(this.wires.at(w).some);
                ch.write(v);
                w = w + 1;
            }
            wait;
        }

        fun subscribe(mut this, s: mut _EventSubscription<T>) {
            this.subscribers.push(s);
        }

        // The connect desugaring calls this: one fresh wire per connected
        // input (fan-out with independent cursors, like an output hub).
        fun connect_wire(mut this) -> mut LatestChannel<T> {
            let w: mut LatestChannel<T> = new LatestChannel<T>();
            this.wires.push(w);
            return w;
        }

        fun unsubscribe(mut this, sid: i64) {
            let i: mut i64 = 0;
            while (i < this.subscribers.size()) {
                let cur: Option<_EventSubscription<T>> = this.subscribers.at(i);
                if (cur.is_some()) {
                    if (cur.some.sid == sid) {
                        this.subscribers.remove_at(i);
                        return;
                    }
                }
                i = i + 1;
            }
        }
    }


    // JIT compilation API (backed by libpenguin_jit / LLVM ORC)
    extern fun penguin_jit_create() -> u64;
    extern fun penguin_jit_add_module(ctx: u64, name: string, ir_text: string) -> i32;
    extern fun penguin_jit_lookup(ctx: u64, name: string) -> u64;
    extern fun penguin_jit_destroy(ctx: u64);
    extern fun penguin_jit_get_error() -> string;

    // JIT trampolines — call a JIT-compiled function pointer with various
    // argument/return-type signatures (backed by libpenguin_jit)
    extern fun penguin_jit_call_i64_0(fn: u64) -> i64;
    extern fun penguin_jit_call_i64_i64(fn: u64, a: i64) -> i64;
    extern fun penguin_jit_call_i64_i64_i64(fn: u64, a: i64, b: i64) -> i64;
    extern fun penguin_jit_call_i64_i64_i64_i64(fn: u64, a: i64, b: i64, c: i64) -> i64;
    extern fun penguin_jit_call_ptr_ptr(fn: u64, a: u64) -> u64;
    extern fun penguin_jit_call_ptr_ptr_ptr(fn: u64, a: u64, b: u64) -> u64;

    fun panic(text : string) {
        print("panic: ");
        println(text);
        __throw_runtime_error(text, 1);
    }

    #template(T: type)
    class Box {
        value: T;
        impl IReferenceType;
        fun new(mut this, value: T) {
            this.value = value;
        }
    }

    class __ExternImpl {}

    #template(T: type)
    enum Option {
        some: T;
        none;

        fun is_some(this) -> bool {
            return this is Option<T>.some;
        }

        fun is_none(this) -> bool {
            return this is Option<T>.none;
        }

        fun value_or(this, default_val: T) -> T {
            if (this is Option<T>.some) {
                return this.some;
            } else {
                return default_val;
            }
        }
    }

    #template(T: type)
    interface ICopy {
        extern fun copy(this: T) -> T;
    }

    // IHash: hashes a value to a 64-bit hash code. Implemented for every
    // primitive via `impl IHash for <type>`; calls like `k.hash()` on a
    // primitive resolve to the impl's method as a direct call (primitive
    // interface-method dispatch).
    interface IHash {
        fun hash(this) -> i64;
    }

    // IReferenceType marks a class as a heap-allocated reference type, overriding
    // the all-value-fields heuristic in classify_class. Without it, a class whose
    // fields are all value-like (e.g. StringBuilder: string/i32/i32, where string
    // is PrimitiveKind=>value-like) is misclassified as a VALUE type — value-copy
    // semantics then break aliasing (the LLVMEmitter this.sb buffer swap copies the
    // 24B struct instead of aliasing, so the buffer is never written).
    interface IReferenceType {
        // Self-marker so the interface itself is reference-sized (callable as a
        // return type, e.g. the M6-step2 penguin_meta_get_object bridge);
        // mirrors IIterator's `impl IReferenceType`.
        impl IReferenceType;
    }

    // M6-step2: canonical, deterministic name for a non-scalar value-template
    // argument, used to mangle/dedup object value args (e.g. Foo<#make_list(...)>)
    // by VALUE rather than by address. get_unique_name() must be stable across
    // compilations (no embedded addresses/random) — it is the mangle key.
    // CONTRACT: the returned name must be an INJECTIVE encoding of the content
    // the template body may introspect — pass free-text content through
    // umangle_escape() so distinct values never share a name (the mangle-level
    // sanitizer maps ' ', '<', '>', ',' to '_', so raw text like "a b" and "a_b"
    // would otherwise collide and wrongly dedup two distinct instantiations).
    interface IUniqueMangleName {
        fun get_unique_name(this) -> string;
    }

    // Identifier-safe, injective escaping for IUniqueMangleName content:
    //   '_' → "_0", [A-Za-z0-9] → verbatim, everything else → "_x" + 2 hex digits
    // (e.g. ' ' → "_x20"). Because '_' itself is escaped, the mapping is
    // one-to-one: two different inputs always yield different names, and the
    // output survives the mangle sanitizer (it contains no ' ', '<', '>', ',')
    // byte-for-byte.
    fun umangle_escape(s: string) -> string {
        let digits: string = "0123456789abcdef";
        let sb: mut StringBuilder = new StringBuilder();
        let i: mut i64 = 0;
        while (i < string_length(s)) {
            let ch: string = string_char_at(s, i);
            let code: i64 = string_char_code(ch);
            if (code == 95) {
                sb.append("_0");
            } else {
                if ((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)) {
                    sb.append(ch);
                } else {
                    sb.append("_x");
                    sb.append(string_char_at(digits, code / 16));
                    sb.append(string_char_at(digits, code % 16));
                }
            }
            i = i + 1;
        }
        return sb.to_string();
    }

    // Marker for reference types that own raw memory (Array<T,N>,
    // HashMap<K,V>, ...). dispose_mem() may be called explicitly, and for
    // IReferenceType classes it is also invoked automatically by the GC when
    // a dead instance is swept (the emitter points the class metadata
    // destructor slot at dispose_mem). Implementations must be idempotent —
    // an owner's finalizer may dispose an inner object before that object's
    // own finalizer runs.
    interface IMemoryDispose {
        fun dispose_mem();
    }

    #template(T: type)
    interface IIterator {
        impl IReferenceType;
        fun next(mut this) -> Option<T>;
        fun iter(this) -> IIterator<T> {
            return this;
        }
    }

    #template(T: type)
    interface IIterable {
        // `iter()` is the read-only iteration path (non-mut-typed IIterator); `iter_mut()` is
        // the mutable path. Both are callable on immutable containers — creating an iterator
        // never mutates the container. The element type T is preserved as stored.
        fun iter(this) -> IIterator<T>;
        fun iter_mut(this) -> mut IIterator<T>;
    }

    #template(T: type)
    interface IMutIterator {
        fun iter_mut(this) -> mut IIterator<T>;
    }

    impl __builtin.ICopy<i64> for i64;
    impl __builtin.ICopy<u64> for u64;
    impl __builtin.ICopy<i32> for i32;
    impl __builtin.ICopy<u32> for u32;
    impl __builtin.ICopy<i16> for i16;
    impl __builtin.ICopy<u16> for u16;
    impl __builtin.ICopy<i8> for i8;

    // --- IUniqueMangleName for every primitive ----------------------------
    // Primitive interface impls (`impl Iface for <prim>`) are name-mangled to
    // `<method>$$<prim>` and dispatched directly (the IHash precedent). They let
    // the IUniqueMangleName render below be UNIFORM — every umangleable element
    // type answers `.get_unique_name()` — so the container impl bodies in the
    // #specializing blocks below contain NO meta calls (no JIT, no recursion).
    // Render text must distinguish kinds at a glance: digits for ints, quoted
    // for string, true/false for bool, decimal text for floats.
    impl IUniqueMangleName for i64 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for i32 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for i16 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for i8 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for u64 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for u32 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for u16 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for u8 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for f64 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for f32 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for bool {
        fun get_unique_name(this) -> string {
            if (this) { return "true"; }
            return "false";
        }
    }
    impl IUniqueMangleName for char { fun get_unique_name(this) -> string { return cast<string>(cast<i64>(this)); } }
    impl IUniqueMangleName for string { fun get_unique_name(this) -> string { return "\"" + this + "\""; } }

    // --- IUniqueMangleName auto-impls for the core/std generic wrappers -----
    // These #specializing blocks live in core_builtin deliberately: core_builtin
    // is (a) the stdlib of EVERY host compilation and (b) a base source of EVERY
    // unit-B (meta) compilation — so the impl is injected symmetrically in all
    // modules that specialize these types, keeping their specializations
    // layout/vtable-identical (the cross-module asymmetry was the crash).
    // The `umangleable(T)` gate is evaluated NATIVELY by the compiler (no JIT
    // gate — a JIT gate would recurse: its own unit-B compile re-fires these
    // blocks). The impl bodies use only the uniform `.get_unique_name()` render
    // above — no meta splices, nothing left to JIT.
    #specializing _utils.List<T> {
        if (umangleable(T)) {
            impl IUniqueMangleName {
                fun get_unique_name(this) -> string {
                    let sb: mut StringBuilder = new StringBuilder();
                    sb.append("Ls_");
                    sb.append(cast<string>(this.size()));
                    let i: mut i64 = 0;
                    while (i < cast<i64>(this.size())) {
                        sb.append("_");
                        sb.append(this.at(cast<u64>(i)).some.get_unique_name());
                        i = i + 1;
                    }
                    return sb.to_string();
                }
            }
        }
    }

    #specializing __builtin.Box<T> {
        if (umangleable(T)) {
            impl IUniqueMangleName {
                fun get_unique_name(this) -> string {
                    return "Bx_" + this.value.get_unique_name();
                }
            }
        }
    }

    #specializing __builtin.Option<T> {
        if (umangleable(T)) {
            impl IUniqueMangleName {
                fun get_unique_name(this) -> string {
                    if (this is Option<T>.none) { return "Op_n"; }
                    return "Op_s_" + this.some.get_unique_name();
                }
            }
        }
    }

    impl __builtin.ICopy<u8> for u8;
    impl __builtin.ICopy<bool> for bool;
    impl __builtin.ICopy<char> for char;
    impl __builtin.ICopy<string> for string;
    impl __builtin.ICopy<float> for float;
    impl __builtin.ICopy<double> for double;

    // IHash implementations for every primitive (primitive interface-method
    // dispatch: `k.hash()` lowers to a direct call of the mangled method).
    impl IHash<i64> for i64 {
        fun hash(this) -> i64 {
            return this;
        }
    }
    impl IHash<i32> for i32 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<i16> for i16 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<i8> for i8 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<u64> for u64 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<u32> for u32 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<u16> for u16 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<u8> for u8 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<char> for char {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<f32> for f32 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<f64> for f64 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<bool> for bool {
        fun hash(this) -> i64 {
            if (this) { return 1; }
            return 0;
        }
    }
    impl IHash<string> for string {
        fun hash(this) -> i64 {
            // FNV-1a 64-bit: h ^= byte; h *= prime. The standard offset basis
            // 0xCBF29CE484222325 overflows i64 literals, so its low 63 bits
            // (0x4BF29CE484222325) are used — hash distribution is unchanged.
            let h: mut i64 = 5472609002491880229;
            let i: mut i64 = 0;
            while (i < string_length(this)) {
                h = h ^ string_char_code(string_char_at(this, i));
                h = h * 1099511628211;
                i = i + 1;
            }
            return h;
        }
    }

    // StringBuilder is backed by the C struct in core_builtin.c. Its PenguinLang
    // field layout MUST match that C struct (EmperorPenguin always prepends a
    // metadata ptr at offset 0, so the C struct leads with `void* metadata`
    // too). The extern `new` initializes these fields in place via `this`; if the
    // layouts disagree, `_emperor_stringbuilder_append` would read the metadata
    // pointer as `data` and overwrite global metadata -> heap corruption.
    class StringBuilder {
        data: string;
        len: i32;
        cap: i32;
        impl IReferenceType;
        extern fun new(mut this);
        extern fun append(mut this, s: string);
        extern fun to_string(this) -> mut string;
        // M6-step2 4b: canonical value-level name for object value-template args
        // (stable mangle/dedup by VALUE, not address). Content-derived and ESCAPED
        // via umangle_escape so distinct contents never share a mangle (raw text
        // like "a b" vs "a_b" would collide in the mangle sanitizer's '_'
        // mapping) — it becomes part of the specialization's mangled symbol.
        impl IUniqueMangleName {
            fun get_unique_name(this) -> string {
                return "SB_" + umangle_escape(this.data);
            }
        }
    }

    // NOTE: the old M6-step2 generic unique-name trampoline
    // (`#fun penguin_meta_unique_name(l: IUniqueMangleName)`) was REMOVED — its
    // virtual dispatch ran on the UNIT-B object, where impls injected into the
    // host compilation (#specializing blocks) do not exist, producing a missing
    // vtable entry and a SEGV. The host now synthesizes a per-type STATIC
    // trampoline (SemanticModel.find_unique_name_trampoline); only impls written
    // in base-meta-source class bodies (like StringBuilder's above) are callable
    // that way.

    // String helper functions
    extern fun string_length(s: string) -> i64;
    extern fun string_find(s: string, sub: string) -> i64;
    extern fun string_find_from(s: string, sub: string, start: i64) -> i64;
    extern fun string_substring(s: string, start: i64, length: i64) -> string;
    extern fun string_char_at(s: string, index: i64) -> string;
    extern fun string_char_code(s: string) -> i64;
    extern fun string_to_int(s: string) -> i64;
    extern fun string_to_double(s: string) -> double;

    #template(T: type, E: type)
    enum Result {
        ok: T;
        error: E;

        fun is_ok(this) -> bool {
            return this is Result<T, E>.ok;
        }

        fun is_error(this) -> bool {
            return this is Result<T, E>.error;
        }

        fun value_or(this, default_val: T) -> T {
            if (this is Result<T, E>.ok) {
                return this.ok;
            } else {
                return default_val;
            }
        }
    }

    #template(K: type, V: type)
    class Pair {
        first: K;
        second: V;
    }

    // Range iterator: a simple numeric range for for-loop support
    class RangeIterator {
        current: mut i64 = 0;
        end: i64 = 0;
        fun new(mut this, start: i64, end: i64) {
            this.current = start;
            this.end = end;
        }
        fun next(mut this) -> __builtin.Option<i64> {
            if (this.current < this.end) {
                let val: i64 = this.current;
                this.current = this.current + 1;
                return new __builtin.Option<i64>.some(val);
            }
            return new __builtin.Option<i64>.none();
        }
        fun iter(this) -> RangeIterator {
            return this;
        }
        impl IIterator<i64> {
            fun next(mut this) -> __builtin.Option<i64> {
                if (this.current < this.end) {
                    let val: i64 = this.current;
                    this.current = this.current + 1;
                    return new __builtin.Option<i64>.some(val);
                }
                return new __builtin.Option<i64>.none();
            }
        }
    }

    class Range {
        start: i64 = 0;
        end: i64 = 0;
        fun new(mut this, start: i64, end: i64) {
            this.start = start;
            this.end = end;
        }
        fun iter(this) -> RangeIterator {
            return new RangeIterator(this.start, this.end);
        }
    }

    fun range(start: i64, end: i64) -> mut RangeIterator {
        return new RangeIterator(start, end);
    }

}
