namespace __builtin {
    extern fun exit(code : i32);
    extern fun print(text : string);
    extern fun println(text : string);
    extern fun eprint(text : string);
    extern fun eprintln(text : string);
    extern fun _exec_cmd(cmd: string) -> i64;

    extern fun lshift(value: i64, shift: i64) -> i64;
    extern fun rshift(value: i64, shift: i64) -> i64;

    extern fun gc_collect();
    extern fun gc_info() -> i64;

    // Raw heap allocation for manually-managed buffers (Array<T,N>, _ptr<T>).
    // Routed to @_emperor_malloc / @_emperor_mfree in core_builtin.c (libc
    // malloc/free, NOT the GC arena). Unreferenced externs are free.
    extern fun _malloc(size: u64) -> u64;
    extern fun _mfree(addr: u64);
    // GC scan-region registration for raw buffers that CONTAIN pointers to GC
    // objects (Vector/HashMap/Array element storage). The conservative
    // collector cannot see inside malloc'd memory: register the buffer right
    // after allocating it, and remove the region BEFORE freeing/replacing it
    // (dispose_mem / _grow). A missing registration means live elements get
    // swept; a stale one only retains garbage.
    extern fun _gc_scan_add(addr: u64, size: i64);
    extern fun _gc_scan_remove(addr: u64);

    // Byte-level helpers for generic HashMap<K,V>: hash and equality over the raw
    // bytes of a value-type key (address + #sizeof). Routed to @_emperor_hash_bytes
    // / @_emperor_bytes_equal in core_builtin.c.
    extern fun _hash_bytes(addr: u64, len: u64) -> u64;
    extern fun _bytes_equal(addr1: u64, addr2: u64, len: u64) -> i64;

    extern fun __args_count() -> i64;
    extern fun __args_get(index: i64) -> string;

    // JIT compilation API (backed by libpenguin_jit / LLVM ORC)
    extern fun penguin_jit_create() -> u64;
    extern fun penguin_jit_add_module(ctx: u64, name: string, ir_text: string) -> i32;
    extern fun penguin_jit_lookup(ctx: u64, name: string) -> u64;
    extern fun penguin_jit_destroy(ctx: u64);
    extern fun penguin_jit_get_error() -> string;

    // JIT trampolines — call a JIT-compiled function pointer with various
    // argument/return-type signatures (backed by libpenguin_jit)
    extern fun penguin_jit_call_i64_0(fn: u64) -> i64;
    extern fun penguin_jit_call_i64_i64(fn: u64, a: i64) -> i64;
    extern fun penguin_jit_call_i64_i64_i64(fn: u64, a: i64, b: i64) -> i64;
    extern fun penguin_jit_call_i64_i64_i64_i64(fn: u64, a: i64, b: i64, c: i64) -> i64;
    extern fun penguin_jit_call_ptr_ptr(fn: u64, a: u64) -> u64;
    extern fun penguin_jit_call_ptr_ptr_ptr(fn: u64, a: u64, b: u64) -> u64;

    fun panic(text : string) {
        print("panic: ");
        println(text);
        exit(1);
    }

    #template(T: type)
    class Box {
        value: T;
        impl IReferenceType;
        fun new(mut this, value: T) {
            this.value = value;
        }
    }

    class __ExternImpl {}

    #template(T: type)
    enum Option {
        some: T;
        none;

        fun is_some(this) -> bool {
            return this is Option<T>.some;
        }

        fun is_none(this) -> bool {
            return this is Option<T>.none;
        }

        fun value_or(this, default_val: T) -> T {
            if (this is Option<T>.some) {
                return this.some;
            } else {
                return default_val;
            }
        }
    }

    #template(T: type)
    interface ICopy {
        extern fun copy(this: T) -> T;
    }

    // IHash: hashes a value to a 64-bit hash code. Implemented for every
    // primitive via `impl IHash for <type>`; calls like `k.hash()` on a
    // primitive resolve to the impl's method as a direct call (primitive
    // interface-method dispatch).
    interface IHash {
        fun hash(this) -> i64;
    }

    // IReferenceType marks a class as a heap-allocated reference type, overriding
    // the all-value-fields heuristic in classify_class. Without it, a class whose
    // fields are all value-like (e.g. StringBuilder: string/i32/i32, where string
    // is PrimitiveKind=>value-like) is misclassified as a VALUE type — value-copy
    // semantics then break aliasing (the LLVMEmitter this.sb buffer swap copies the
    // 24B struct instead of aliasing, so the buffer is never written).
    interface IReferenceType {
        // Self-marker so the interface itself is reference-sized (callable as a
        // return type, e.g. the M6-step2 penguin_meta_get_object bridge);
        // mirrors IIterator's `impl IReferenceType`.
        impl IReferenceType;
    }

    // M6-step2: canonical, deterministic name for a non-scalar value-template
    // argument, used to mangle/dedup object value args (e.g. Foo<#make_list(...)>)
    // by VALUE rather than by address. get_unique_name() must be stable across
    // compilations (no embedded addresses/random) — it is the mangle key.
    // CONTRACT: the returned name must be an INJECTIVE encoding of the content
    // the template body may introspect — pass free-text content through
    // umangle_escape() so distinct values never share a name (the mangle-level
    // sanitizer maps ' ', '<', '>', ',' to '_', so raw text like "a b" and "a_b"
    // would otherwise collide and wrongly dedup two distinct instantiations).
    interface IUniqueMangleName {
        fun get_unique_name(this) -> string;
    }

    // Identifier-safe, injective escaping for IUniqueMangleName content:
    //   '_' → "_0", [A-Za-z0-9] → verbatim, everything else → "_x" + 2 hex digits
    // (e.g. ' ' → "_x20"). Because '_' itself is escaped, the mapping is
    // one-to-one: two different inputs always yield different names, and the
    // output survives the mangle sanitizer (it contains no ' ', '<', '>', ',')
    // byte-for-byte.
    fun umangle_escape(s: string) -> string {
        let digits: string = "0123456789abcdef";
        let sb: mut StringBuilder = new StringBuilder();
        let i: mut i64 = 0;
        while (i < string_length(s)) {
            let ch: string = string_char_at(s, i);
            let code: i64 = string_char_code(ch);
            if (code == 95) {
                sb.append("_0");
            } else {
                if ((code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)) {
                    sb.append(ch);
                } else {
                    sb.append("_x");
                    sb.append(string_char_at(digits, code / 16));
                    sb.append(string_char_at(digits, code % 16));
                }
            }
            i = i + 1;
        }
        return sb.to_string();
    }

    // Marker for reference types that own raw memory (Array<T,N>,
    // HashMap<K,V>, ...). dispose_mem() may be called explicitly, and for
    // IReferenceType classes it is also invoked automatically by the GC when
    // a dead instance is swept (the emitter points the class metadata
    // destructor slot at dispose_mem). Implementations must be idempotent —
    // an owner's finalizer may dispose an inner object before that object's
    // own finalizer runs.
    interface IMemoryDispose {
        fun dispose_mem();
    }

    #template(T: type)
    interface IIterator {
        impl IReferenceType;
        fun next(mut this) -> Option<T>;
        fun iter(this) -> IIterator<T> {
            return this;
        }
    }

    #template(T: type)
    interface IIterable {
        // `iter()` is the read-only iteration path (non-mut-typed IIterator); `iter_mut()` is
        // the mutable path. Both are callable on immutable containers — creating an iterator
        // never mutates the container. The element type T is preserved as stored.
        fun iter(this) -> IIterator<T>;
        fun iter_mut(this) -> mut IIterator<T>;
    }

    #template(T: type)
    interface IMutIterator {
        fun iter_mut(this) -> mut IIterator<T>;
    }

    impl __builtin.ICopy<i64> for i64;
    impl __builtin.ICopy<u64> for u64;
    impl __builtin.ICopy<i32> for i32;
    impl __builtin.ICopy<u32> for u32;
    impl __builtin.ICopy<i16> for i16;
    impl __builtin.ICopy<u16> for u16;
    impl __builtin.ICopy<i8> for i8;

    // --- IUniqueMangleName for every primitive ----------------------------
    // Primitive interface impls (`impl Iface for <prim>`) are name-mangled to
    // `<method>$$<prim>` and dispatched directly (the IHash precedent). They let
    // the IUniqueMangleName render below be UNIFORM — every umangleable element
    // type answers `.get_unique_name()` — so the container impl bodies in the
    // #specializing blocks below contain NO meta calls (no JIT, no recursion).
    // Render text must distinguish kinds at a glance: digits for ints, quoted
    // for string, true/false for bool, decimal text for floats.
    impl IUniqueMangleName for i64 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for i32 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for i16 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for i8 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for u64 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for u32 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for u16 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for u8 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for f64 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for f32 { fun get_unique_name(this) -> string { return cast<string>(this); } }
    impl IUniqueMangleName for bool {
        fun get_unique_name(this) -> string {
            if (this) { return "true"; }
            return "false";
        }
    }
    impl IUniqueMangleName for char { fun get_unique_name(this) -> string { return cast<string>(cast<i64>(this)); } }
    impl IUniqueMangleName for string { fun get_unique_name(this) -> string { return "\"" + this + "\""; } }

    // --- IUniqueMangleName auto-impls for the core/std generic wrappers -----
    // These #specializing blocks live in core_builtin deliberately: core_builtin
    // is (a) the stdlib of EVERY host compilation and (b) a base source of EVERY
    // unit-B (meta) compilation — so the impl is injected symmetrically in all
    // modules that specialize these types, keeping their specializations
    // layout/vtable-identical (the cross-module asymmetry was the crash).
    // The `umangleable(T)` gate is evaluated NATIVELY by the compiler (no JIT
    // gate — a JIT gate would recurse: its own unit-B compile re-fires these
    // blocks). The impl bodies use only the uniform `.get_unique_name()` render
    // above — no meta splices, nothing left to JIT.
    #specializing _utils.List<T> {
        if (umangleable(T)) {
            impl IUniqueMangleName {
                fun get_unique_name(this) -> string {
                    let sb: mut StringBuilder = new StringBuilder();
                    sb.append("Ls_");
                    sb.append(cast<string>(this.size()));
                    let i: mut i64 = 0;
                    while (i < cast<i64>(this.size())) {
                        sb.append("_");
                        sb.append(this.at(cast<u64>(i)).some.get_unique_name());
                        i = i + 1;
                    }
                    return sb.to_string();
                }
            }
        }
    }

    #specializing __builtin.Box<T> {
        if (umangleable(T)) {
            impl IUniqueMangleName {
                fun get_unique_name(this) -> string {
                    return "Bx_" + this.value.get_unique_name();
                }
            }
        }
    }

    #specializing __builtin.Option<T> {
        if (umangleable(T)) {
            impl IUniqueMangleName {
                fun get_unique_name(this) -> string {
                    if (this is Option<T>.none) { return "Op_n"; }
                    return "Op_s_" + this.some.get_unique_name();
                }
            }
        }
    }

    impl __builtin.ICopy<u8> for u8;
    impl __builtin.ICopy<bool> for bool;
    impl __builtin.ICopy<char> for char;
    impl __builtin.ICopy<string> for string;
    impl __builtin.ICopy<float> for float;
    impl __builtin.ICopy<double> for double;

    // IHash implementations for every primitive (primitive interface-method
    // dispatch: `k.hash()` lowers to a direct call of the mangled method).
    impl IHash<i64> for i64 {
        fun hash(this) -> i64 {
            return this;
        }
    }
    impl IHash<i32> for i32 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<i16> for i16 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<i8> for i8 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<u64> for u64 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<u32> for u32 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<u16> for u16 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<u8> for u8 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<char> for char {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<f32> for f32 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<f64> for f64 {
        fun hash(this) -> i64 {
            return cast<i64>(this);
        }
    }
    impl IHash<bool> for bool {
        fun hash(this) -> i64 {
            if (this) { return 1; }
            return 0;
        }
    }
    impl IHash<string> for string {
        fun hash(this) -> i64 {
            // FNV-1a 64-bit: h ^= byte; h *= prime. The standard offset basis
            // 0xCBF29CE484222325 overflows i64 literals, so its low 63 bits
            // (0x4BF29CE484222325) are used — hash distribution is unchanged.
            let h: mut i64 = 5472609002491880229;
            let i: mut i64 = 0;
            while (i < string_length(this)) {
                h = h ^ string_char_code(string_char_at(this, i));
                h = h * 1099511628211;
                i = i + 1;
            }
            return h;
        }
    }

    // StringBuilder is backed by the C struct in core_builtin.c. Its PenguinLang
    // field layout MUST match that C struct (EmperorPenguin always prepends a
    // metadata ptr at offset 0, so the C struct leads with `void* metadata`
    // too). The extern `new` initializes these fields in place via `this`; if the
    // layouts disagree, `_emperor_stringbuilder_append` would read the metadata
    // pointer as `data` and overwrite global metadata -> heap corruption.
    class StringBuilder {
        data: string;
        len: i32;
        cap: i32;
        impl IReferenceType;
        extern fun new(mut this);
        extern fun append(mut this, s: string);
        extern fun to_string(this) -> mut string;
        // M6-step2 4b: canonical value-level name for object value-template args
        // (stable mangle/dedup by VALUE, not address). Content-derived and ESCAPED
        // via umangle_escape so distinct contents never share a mangle (raw text
        // like "a b" vs "a_b" would collide in the mangle sanitizer's '_'
        // mapping) — it becomes part of the specialization's mangled symbol.
        impl IUniqueMangleName {
            fun get_unique_name(this) -> string {
                return "SB_" + umangle_escape(this.data);
            }
        }
    }

    // NOTE: the old M6-step2 generic unique-name trampoline
    // (`#fun penguin_meta_unique_name(l: IUniqueMangleName)`) was REMOVED — its
    // virtual dispatch ran on the UNIT-B object, where impls injected into the
    // host compilation (#specializing blocks) do not exist, producing a missing
    // vtable entry and a SEGV. The host now synthesizes a per-type STATIC
    // trampoline (SemanticModel.find_unique_name_trampoline); only impls written
    // in base-meta-source class bodies (like StringBuilder's above) are callable
    // that way.

    // String helper functions
    extern fun string_length(s: string) -> i64;
    extern fun string_find(s: string, sub: string) -> i64;
    extern fun string_find_from(s: string, sub: string, start: i64) -> i64;
    extern fun string_substring(s: string, start: i64, length: i64) -> string;
    extern fun string_char_at(s: string, index: i64) -> string;
    extern fun string_char_code(s: string) -> i64;
    extern fun string_to_int(s: string) -> i64;
    extern fun string_to_double(s: string) -> double;

    #template(T: type, E: type)
    enum Result {
        ok: T;
        error: E;

        fun is_ok(this) -> bool {
            return this is Result<T, E>.ok;
        }

        fun is_error(this) -> bool {
            return this is Result<T, E>.error;
        }

        fun value_or(this, default_val: T) -> T {
            if (this is Result<T, E>.ok) {
                return this.ok;
            } else {
                return default_val;
            }
        }
    }

    #template(K: type, V: type)
    class Pair {
        first: K;
        second: V;
    }

    // Range iterator: a simple numeric range for for-loop support
    class RangeIterator {
        current: mut i64 = 0;
        end: i64 = 0;
        fun new(mut this, start: i64, end: i64) {
            this.current = start;
            this.end = end;
        }
        fun next(mut this) -> __builtin.Option<i64> {
            if (this.current < this.end) {
                let val: i64 = this.current;
                this.current = this.current + 1;
                return new __builtin.Option<i64>.some(val);
            }
            return new __builtin.Option<i64>.none();
        }
        fun iter(this) -> RangeIterator {
            return this;
        }
        impl IIterator<i64> {
            fun next(mut this) -> __builtin.Option<i64> {
                if (this.current < this.end) {
                    let val: i64 = this.current;
                    this.current = this.current + 1;
                    return new __builtin.Option<i64>.some(val);
                }
                return new __builtin.Option<i64>.none();
            }
        }
    }

    class Range {
        start: i64 = 0;
        end: i64 = 0;
        fun new(mut this, start: i64, end: i64) {
            this.start = start;
            this.end = end;
        }
        fun iter(this) -> RangeIterator {
            return new RangeIterator(this.start, this.end);
        }
    }

    fun range(start: i64, end: i64) -> mut RangeIterator {
        return new RangeIterator(start, end);
    }

}
