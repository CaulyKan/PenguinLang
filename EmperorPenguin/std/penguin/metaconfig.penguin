namespace emperor {

// Build-variant real config for the compile-time meta JIT gate. This file lives
// in std/penguin/ (NOT src/meta/), so the in-process dotnet tests — which glob
// src/{ast,bound,ir,project,llvm,meta}/*.penguin — never pick it up; only the
// Full project (EmperorPenguinPass2.penguins, the bootstrap's pass2→pass3 and
// pass3→pass4 steps, make bootstrap) lists it. Those binaries ARE linked against
// libpenguin_jit via -enable-meta, so reporting the JIT available activates
// `_template_X` synthesis (M1) + M4 use-site routing there. The default project
// ships src/meta/MetaConfigStub.penguin (returns false) instead.
// export: since the std-dynlib split this file ships in
// libemperorpenguin-std.penguin-lib's symbol table; the compiler
// (libemperorpenguin.penguin-lib) consumes it via --lib, so the gate must be
// export-marked to be visible across the lib boundary.
export fun meta_runtime_available() -> bool {
    return true;
}

}
