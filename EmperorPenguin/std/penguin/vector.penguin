// Stdlib growable Vector, built with meta-programming (the pointer IR + #sizeof
// intrinsics). NOT auto-loaded — compile it explicitly (e.g. via a markdown
// test's Compile.Args). Grows by doubling (initial capacity 8); element storage
// is one contiguous _malloc'd buffer. Manual memory management via
// _malloc/_mfree; release with dispose_mem(). Iteration goes through the
// independent _VectorIterator<T> (not Self).
namespace std {

#template(T: type)
export class Vector {
    impl __builtin.IReferenceType;
    impl __builtin.IMemoryDispose;
    buf: mut u64;
    len: mut u64 = 0;
    cap: mut u64 = 0;

    fun new(mut this) {
        this.buf = 0;
        this.len = 0;
        this.cap = 0;
    }

    // Grow to new_cap, copying existing elements element-by-element.
    fun _grow(mut this, new_cap: u64) {
        let new_bytes: u64 = new_cap * cast<u64>(#sizeof(T));
        let new_buf: u64 = __builtin._malloc(new_bytes);
        // Register the new buffer with its PRECISE element layout (GC v2 3b)
        // BEFORE elements land in it: a minor collection rewrites young
        // references in place (the legacy _gc_scan_add byte-region could only
        // pin them). Primitive elements compile this to nothing.
        #__track_buffer(T, new_buf, new_cap, cast<u64>(#sizeof(T)));
        let i: mut u64 = 0;
        while (i < this.len) {
            let v: T = #__load(T, this.buf + i * cast<u64>(#sizeof(T)));
            #__store(T, new_buf + i * cast<u64>(#sizeof(T)), v);
            i = i + 1;
        }
        if (this.buf != 0) {
            __builtin._gc_scan_remove(this.buf);
            __builtin._mfree(this.buf);
        }
        this.buf = new_buf;
        this.cap = new_cap;
    }

    fun push(mut this, v: T) {
        if (this.len == this.cap) {
            let new_cap: u64 = if (this.cap == 0) { 8 } else { this.cap * 2 };
            this._grow(new_cap);
        }
        #__store(T, this.buf + this.len * cast<u64>(#sizeof(T)), v);
        this.len = this.len + 1;
    }

    // Grow the vector to hold at least n elements. Elements in [old_len, n)
    // are UNINITIALIZED (garbage) — callers must gate reads on their own
    // validity flags (HashMap uses this to pre-size its slot vectors).
    fun resize_to(mut this, n: u64) {
        if (n > this.cap) {
            this._grow(n);
        }
        if (n > this.len) {
            this.len = n;
        }
    }

    fun at(this, i: u64) -> __builtin.Option<T> {
        if (i >= this.len) {
            return new __builtin.Option<T>.none();
        }
        let v: T = #__load(T, this.buf + i * cast<u64>(#sizeof(T)));
        return new __builtin.Option<T>.some(v);
    }

    fun set(mut this, i: u64, v: T) {
        if (i >= this.len) { return; }
        #__store(T, this.buf + i * cast<u64>(#sizeof(T)), v);
    }

    fun size(this) -> u64 {
        return this.len;
    }

    fun capacity(this) -> u64 {
        return this.cap;
    }

    fun iter(this) -> mut _VectorIterator<T> {
        return new _VectorIterator<T>(this.buf, this.len);
    }

    fun iter_mut(mut this) -> mut _VectorIterator<T> {
        return new _VectorIterator<T>(this.buf, this.len);
    }

    fun dispose_mem(mut this) {
        if (this.buf != 0) {
            __builtin._gc_scan_remove(this.buf);
            __builtin._mfree(this.buf);
            this.buf = 0;
        }
    }
}

// Independent iterator for Vector<T>.
#template(T: type)
export class _VectorIterator {
    impl __builtin.IReferenceType;
    base: u64;
    cursor: mut u64 = 0;
    end: u64;

    fun new(mut this, base: u64, end: u64) {
        this.base = base;
        this.end = end;
        this.cursor = 0;
    }

    fun next(mut this) -> __builtin.Option<T> {
        if (this.cursor >= this.end) {
            return new __builtin.Option<T>.none();
        }
        let v: T = #__load(T, this.base + this.cursor * cast<u64>(#sizeof(T)));
        this.cursor = this.cursor + 1;
        return new __builtin.Option<T>.some(v);
    }

    // The combinators' `cast<IIterator<T>>(this)` requires the INTERFACE impl
    // (a bare same-shape `next` is not enough — the cast object would carry no
    // IIterator vtable entry and dispatch through it dereferences NULL).
    impl __builtin.IIterator<T> {
        fun next(mut this) -> __builtin.Option<T> {
            if (this.cursor >= this.end) {
                return new __builtin.Option<T>.none();
            }
            let v: T = #__load(T, this.base + this.cursor * cast<u64>(#sizeof(T)));
            this.cursor = this.cursor + 1;
            return new __builtin.Option<T>.some(v);
        }
    }

        #template(U: type)
        fun map(mut this, f: mut fun<U, T>) -> mut __builtin.MapIterator<T, U> {
            let it: mut __builtin.MapIterator<T, U> = new __builtin.MapIterator<T, U>(cast<mut __builtin.IIterator<T>>(this), f);
            return it;
        }
        fun filter(mut this, pred: mut fun<bool, T>) -> mut __builtin.FilterIterator<T> {
            let it: mut __builtin.FilterIterator<T> = new __builtin.FilterIterator<T>(cast<mut __builtin.IIterator<T>>(this), pred);
            return it;
        }
        #template(R: type)
        fun reduce(mut this, init: R, f: mut fun<R, R, T>) -> R {
            let mut acc = init;
            let mut v = this.next();
            while (v.is_some()) {
                acc = f(acc, v.some);
                v = this.next();
            }
            return acc;
        }
        fun all(mut this, pred: mut fun<bool, T>) -> bool {
            let mut v = this.next();
            while (v.is_some()) {
                if (!(pred(v.some))) { return false; }
                v = this.next();
            }
            return true;
        }
        fun any(mut this, pred: mut fun<bool, T>) -> bool {
            let mut v = this.next();
            while (v.is_some()) {
                if (pred(v.some)) { return true; }
                v = this.next();
            }
            return false;
        }
        #template(C: type)
        fun into(mut this) -> C {
            let mut c = new C();
            let mut v = this.next();
            while (v.is_some()) {
                c.push(v.some);
                v = this.next();
            }
            return c;
        }

    fun iter(this) -> mut _VectorIterator<T> {
        return this;
    }
}

} // namespace std
