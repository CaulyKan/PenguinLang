// Stdlib growable Vector over the NATIVE array `array<T>` (the native-arrays
// round): element storage is a GC-managed array object traced precisely via
// its REFARR ref-map — no manual memory management, no dispose. NOT
// auto-loaded — compile it explicitly (e.g. via a markdown test's
// Compile.Args). Grows by doubling (initial capacity 8). Iteration goes
// through the independent _VectorIterator<T> (not Self).
namespace std {

#template(T: type)
export class Vector {
    impl __builtin.IReferenceType;
    // Element storage: a native array<T>. Stays null until the first push
    // (len == 0 gates every read).
    buf: mut array<T>;
    len: mut u64 = 0;
    cap: mut u64 = 0;

    fun new(mut this) {}

    // Grow to new_cap slots, copying existing elements over. The fresh
    // array is zero-filled at allocation; the old one becomes garbage the
    // next sweep reclaims.
    fun _grow(mut this, new_cap: u64) {
        let new_buf: mut array<T> = __builtin.__array_new<T>(new_cap);
        __builtin.__array_copy_range<T>(new_buf, this.buf, this.len);
        this.buf = new_buf;
        this.cap = new_cap;
    }

    fun push(mut this, v: T) {
        if (this.len == this.cap) {
            let new_cap: u64 = if (this.cap == 0) { 8 } else { this.cap * 2 };
            this._grow(new_cap);
        }
        __builtin.__array_set<T>(this.buf, this.len, v);
        this.len = this.len + 1;
    }

    // Grow the vector to hold at least n elements. Elements in [old_len, n)
    // are ZERO (the array is zero-filled at allocation, unlike the old raw
    // buffer's garbage tail) — callers gating reads on their own validity
    // flags (HashMap's occupied flags read 0 = empty slot, which is exactly
    // the zero value) keep working, and nothing can observe stale data.
    fun resize_to(mut this, n: u64) {
        if (n > this.cap) {
            this._grow(n);
        }
        if (n > this.len) {
            this.len = n;
        }
    }

    fun at(this, i: u64) -> __builtin.Option<T> {
        if (i >= this.len) {
            return new __builtin.Option<T>.none();
        }
        let v: T = __builtin.__array_get<T>(this.buf, i);
        return new __builtin.Option<T>.some(v);
    }

    fun set(mut this, i: u64, v: T) {
        if (i >= this.len) { return; }
        __builtin.__array_set<T>(this.buf, i, v);
    }

    fun size(this) -> u64 {
        return this.len;
    }

    fun capacity(this) -> u64 {
        return this.cap;
    }

    fun iter(this) -> mut _VectorIterator<T> {
        return new _VectorIterator<T>(this);
    }

    fun iter_mut(mut this) -> mut _VectorIterator<T> {
        return new _VectorIterator<T>(this);
    }
}

// Independent iterator for Vector<T>. Holds a reference to the Vector and
// re-reads buf/len on every next(): the GC traces iterator -> vector ->
// element array (so iterating a temporary Vector keeps its storage alive),
// and a push() during iteration swaps in the fresh array instead of a stale
// reference.
#template(T: type)
export class _VectorIterator {
    impl __builtin.IReferenceType;
    vector: Vector<T>;
    cursor: mut u64 = 0;

    fun new(mut this, vector: Vector<T>) {
        this.vector = vector;
        this.cursor = 0;
    }

    fun next(mut this) -> __builtin.Option<T> {
        if (this.cursor >= this.vector.len) {
            return new __builtin.Option<T>.none();
        }
        let v: T = __builtin.__array_get<T>(this.vector.buf, this.cursor);
        this.cursor = this.cursor + 1;
        return new __builtin.Option<T>.some(v);
    }

    // The combinators' `cast<IIterator<T>>(this)` requires the INTERFACE impl
    // (a bare same-shape `next` is not enough — the cast object would carry no
    // IIterator vtable entry and dispatch through it dereferences NULL).
    impl __builtin.IIterator<T> {
        fun next(mut this) -> __builtin.Option<T> {
            if (this.cursor >= this.vector.len) {
                return new __builtin.Option<T>.none();
            }
            let v: T = __builtin.__array_get<T>(this.vector.buf, this.cursor);
            this.cursor = this.cursor + 1;
            return new __builtin.Option<T>.some(v);
        }
    }

        #template(U: type)
        fun map(mut this, f: mut fun<U, T>) -> mut __builtin.MapIterator<T, U> {
            let it: mut __builtin.MapIterator<T, U> = new __builtin.MapIterator<T, U>(cast<mut __builtin.IIterator<T>>(this), f);
            return it;
        }
        fun filter(mut this, pred: mut fun<bool, T>) -> mut __builtin.FilterIterator<T> {
            let it: mut __builtin.FilterIterator<T> = new __builtin.FilterIterator<T>(cast<mut __builtin.IIterator<T>>(this), pred);
            return it;
        }
        #template(R: type)
        fun reduce(mut this, init: R, f: mut fun<R, R, T>) -> R {
            let mut acc = init;
            let mut v = this.next();
            while (v.is_some()) {
                acc = f(acc, v.some);
                v = this.next();
            }
            return acc;
        }
        fun all(mut this, pred: mut fun<bool, T>) -> bool {
            let mut v = this.next();
            while (v.is_some()) {
                if (!(pred(v.some))) { return false; }
                v = this.next();
            }
            return true;
        }
        fun any(mut this, pred: mut fun<bool, T>) -> bool {
            let mut v = this.next();
            while (v.is_some()) {
                if (pred(v.some)) { return true; }
                v = this.next();
            }
            return false;
        }
        #template(C: type)
        fun into(mut this) -> C {
            let mut c = new C();
            let mut v = this.next();
            while (v.is_some()) {
                c.push(v.some);
                v = this.next();
            }
            return c;
        }

    fun iter(this) -> mut _VectorIterator<T> {
        return this;
    }
}

} // namespace std
