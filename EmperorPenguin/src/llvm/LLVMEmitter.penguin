namespace emperor {

class FieldLayout {
    field_name: string = "";
    llvm_type: string = "";
    byte_offset: i64 = 0;
    field_index: i64 = 0;
    bound_type: Option<BoundType> = new Option<BoundType>.none();

    fun new(mut this, field_name: string, llvm_type: string, byte_offset: i64, field_index: i64) {
        _utils.trace_enter("Enter new(field_name=" + cast<string>(field_name) + ", llvm_type=" + cast<string>(llvm_type) + ", byte_offset=" + cast<string>(byte_offset) + ", field_index=" + cast<string>(field_index) + ")");
        this.field_name = field_name;
        this.llvm_type = llvm_type;
        this.byte_offset = byte_offset;
        this.field_index = field_index;
    }
    fun to_string(this) -> string {
        _utils.trace_enter("Enter to_string");
        return "FieldLayout{name=" + this.field_name + ", type=" + this.llvm_type + ", offset=" + cast<string>(this.byte_offset) + "}";
    }
}

class InterfaceVTable {
    interface_name: string = "";
    method_ptrs: mut _utils.List<string> = new _utils.List<string>();

    fun new(mut this, interface_name: string) {
        _utils.trace_enter("Enter new(interface_name=" + cast<string>(interface_name) + ")");
        this.interface_name = interface_name;
    }
}

class ClassLayout {
    type_name: string = "";
    is_value_type: bool = true;
    llvm_struct_type: string = "";
    fields: mut _utils.List<FieldLayout> = new _utils.List<FieldLayout>();
    sizeof_object: mut i64 = 0;
    has_metadata: bool = false;
    interface_vtables: mut _utils.List<InterfaceVTable> = new _utils.List<InterfaceVTable>();

    fun new(mut this, type_name: string, is_value_type: bool, has_metadata: bool) {
        _utils.trace_enter("Enter new(type_name=" + cast<string>(type_name) + ", is_value_type=" + cast<string>(is_value_type) + ", has_metadata=" + cast<string>(has_metadata) + ")");
        this.type_name = type_name;
        this.is_value_type = is_value_type;
        this.has_metadata = has_metadata;
        this.llvm_struct_type = "%class." + type_name;
    }

    fun total_vtable_entries(this) -> i64 {
        _utils.trace_enter("Enter total_vtable_entries");
        let count: mut i64 = 0;
        let i: mut i64 = 0;
        while (i < cast<i64>(this.interface_vtables.size())) {
            count = count + cast<i64>(this.interface_vtables.at(cast<u64>(i)).some.method_ptrs.size());
            i = i + 1;
        }
        return count;
    }
    fun to_string(this) -> string {
        _utils.trace_enter("Enter to_string");
        return "ClassLayout{name=" + this.type_name + ", is_value=" + cast<string>(this.is_value_type) + ", size=" + cast<string>(this.sizeof_object) + ", fields=" + cast<string>(this.fields.size()) + "}";
    }
}

class EnumVariantLayout {
    name: string = "";
    index: i64 = 0;
    payload_llvm_type: string = "";
    payload_bound_type: mut Option<BoundType> = new Option<BoundType>.none();

    fun new(mut this, name: string, index: i64, payload_llvm_type: string) {
        _utils.trace_enter("Enter new(name=" + cast<string>(name) + ", index=" + cast<string>(index) + ", payload_llvm_type=" + cast<string>(payload_llvm_type) + ")");
        this.name = name;
        this.index = index;
        this.payload_llvm_type = payload_llvm_type;
    }
}

class EnumLayout {
    type_name: string = "";
    llvm_struct_type: string = "";
    variants: mut _utils.List<EnumVariantLayout> = new _utils.List<EnumVariantLayout>();
    payload_llvm_type: string = "";
    has_payload: bool = false;
    interface_vtables: mut _utils.List<InterfaceVTable> = new _utils.List<InterfaceVTable>();

    fun new(mut this, type_name: string) {
        _utils.trace_enter("Enter new(type_name=" + cast<string>(type_name) + ")");
        this.type_name = type_name;
        this.llvm_struct_type = "%enum." + type_name;
    }
    fun to_string(this) -> string {
        _utils.trace_enter("Enter to_string");
        return "EnumLayout{name=" + this.type_name + ", has_payload=" + cast<string>(this.has_payload) + ", payload_type=" + this.payload_llvm_type + ", variants=" + cast<string>(this.variants.size()) + "}";
    }
}

class StringLitEntry {
    id: mut i64 = 0;
    value: mut string = "";
    fun new(mut this, id: i64, value: string) {
        _utils.trace_enter("Enter new(id=" + cast<string>(id) + ", value=" + cast<string>(value) + ")");
        this.id = id;
        this.value = value;
    }
    fun global_name(this) -> string {
        _utils.trace_enter("Enter global_name");
        return "@str_" + cast<string>(this.id);
    }
}

class RegMapping {
    ir_name: mut string = "";
    llvm_value: mut string = "";
    fun new(mut this, ir_name: string, llvm_value: string) {
        _utils.trace_enter("Enter new(ir_name=" + cast<string>(ir_name) + ", llvm_value=" + cast<string>(llvm_value) + ")");
        this.ir_name = ir_name;
        this.llvm_value = llvm_value;
    }
}

// Records a CALL whose sret return value flows directly into a register via the
// immediately-following ASSIGN (i.e. `let x = func()`). Such a pair is an RVO
// (return-value-optimization) candidate: the callee can write its return value
// straight into the destination's storage, avoiding a separate sret buffer and
// the copy that overflowed mutable-reg allocas (the pass2 binding crash).
class SretElision {
    call_result: mut string = "";      // the CALL's result register (e.g. %t12)
    dest_reg: mut string = "";         // the ASSIGN destination (e.g. %bound_init)
    assign_index: mut i64 = 0;         // instruction index of the ASSIGN (to skip it)
    callee_sret_llvm_type: mut string = "";  // LLVM struct type returned via sret
    fun new(mut this, call_result: string, dest_reg: string, assign_index: i64, callee_sret_llvm_type: string) {
        _utils.trace_enter("Enter new(call_result=" + cast<string>(call_result) + ", dest_reg=" + cast<string>(dest_reg) + ", assign_index=" + cast<string>(assign_index) + ")");
        this.call_result = call_result;
        this.dest_reg = dest_reg;
        this.assign_index = assign_index;
        this.callee_sret_llvm_type = callee_sret_llvm_type;
    }
}

class TypeIdConstant {
    global_name: mut string = "";
    display_name: mut string = "";
    len: mut i64 = 0;
    fun new(mut this, global_name: string, display_name: string, len: i64) {
        _utils.trace_enter("Enter new(global_name=" + cast<string>(global_name) + ", display_name=" + cast<string>(display_name) + ", len=" + cast<string>(len) + ")");
        this.global_name = global_name;
        this.display_name = display_name;
        this.len = len;
    }
}

class FuncParamTypes {
    func_name: string = "";
    param_types: mut _utils.List<string> = new _utils.List<string>();

    fun new(mut this, func_name: string) {
        _utils.trace_enter("Enter new(func_name=" + cast<string>(func_name) + ")");
        this.func_name = func_name;
    }
    fun to_string(this) -> string {
        _utils.trace_enter("Enter to_string");
        return "FuncParamTypes{name=" + this.func_name + ", params=" + cast<string>(this.param_types.size()) + "}";
    }
}

class LLVMEmitter {
    verbose: mut i64 = 0;
    string_lits: mut _utils.List<StringLitEntry> = new _utils.List<StringLitEntry>();
    next_str_id: mut i64 = 0;
    reg_map: mut _utils.List<RegMapping> = new _utils.List<RegMapping>();
    reg_type_map: mut _utils.List<RegMapping> = new _utils.List<RegMapping>();
    mutable_regs: mut _utils.List<string> = new _utils.List<string>();
    alloca_map: mut _utils.List<RegMapping> = new _utils.List<RegMapping>();
    sb: mut StringBuilder = new StringBuilder();
    // During function emission, body_sb receives instruction output
    // and entry_allocas collects alloca instructions for the entry block.
    body_sb: mut StringBuilder = new StringBuilder();
    entry_allocas: mut StringBuilder = new StringBuilder();
    cond_counter: mut i64 = 0;
    current_ret_type: mut string = "void";
    class_layouts: mut _utils.List<ClassLayout> = new _utils.List<ClassLayout>();
    enum_layouts: mut _utils.List<EnumLayout> = new _utils.List<EnumLayout>();
    tmp_counter: mut i64 = 0;
    has_iref_class: mut bool = false;
    needs_int_to_string: mut bool = false;
    needs_string_concat: mut bool = false;
    needs_bool_to_string: mut bool = false;
    needs_string_equal: mut bool = false;
    needs_vtable_lookup: mut bool = false;
    needs_isinstance: mut bool = false;
    needs_check_class: mut bool = false;
    has_boxing: mut bool = false;
    has_main: mut bool = false;
    needs_memset: mut bool = false;
    icmp_results: mut _utils.List<string> = new _utils.List<string>();
    type_id_constants: mut _utils.List<TypeIdConstant> = new _utils.List<TypeIdConstant>();
    emitted_interface_ids: mut _utils.List<string> = new _utils.List<string>();
    pending_iface_ids: mut StringBuilder = new StringBuilder();
    current_unit: Option<BoundCompilationUnit> = new Option<BoundCompilationUnit>.none();
    func_param_types: mut _utils.List<FuncParamTypes> = new _utils.List<FuncParamTypes>();
    current_sret_llvm_type: mut string = "";
    current_sret_param: mut string = "";
    // RVO / sret-elision state (reset per function by scan_sret_elision).
    sret_elision_map: mut _utils.List<SretElision> = new _utils.List<SretElision>();
    elided_assigns: mut _utils.List<i64> = new _utils.List<i64>();

    // Debug info state
    debug_enabled: mut bool = false;
    debug_id_counter: mut i64 = 0;
    debug_metadata: mut _utils.List<string> = new _utils.List<string>();
    debug_file_cache: mut _utils.List<RegMapping> = new _utils.List<RegMapping>();  // filename -> DIFile id
    current_compile_unit_id: mut string = "";
    current_file_id: mut string = "";
    current_subprogram_id: mut string = "";
    current_dbg: mut string = "";  // current instruction's !dbg suffix
    current_module_flags: mut string = "";  // module flags metadata IDs
    current_subroutine_type: mut string = "";  // DISubroutineType ID
    current_scope_dbg: mut string = "";  // !dbg for instructions without source loc

    // Debug variable support state
    debug_type_cache: mut _utils.List<RegMapping> = new _utils.List<RegMapping>();  // ir_type string -> metadata ID string
    mutable_reg_ir_types: mut _utils.List<string> = new _utils.List<string>();  // parallel to mutable_regs
    mutable_reg_lines: mut _utils.List<i64> = new _utils.List<i64>();  // parallel to mutable_regs (decl line)
    param_names: mut _utils.List<string> = new _utils.List<string>();  // reset per function
    current_scope_loc_id: mut string = "";  // bare metadata id of the function-scope DILocation
    current_loc_id: mut string = "";  // bare metadata id of the current instruction's DILocation

    fun new(mut this) {}

    // Emit an alloca instruction to the entry block (not inline).
    // This prevents stack growth in loops. Only call during function body emission.
    fun emit_entry_alloca(mut this, name: string, llvm_type: string) {
        _utils.trace_enter("Enter emit_entry_alloca(name=" + cast<string>(name) + ", llvm_type=" + cast<string>(llvm_type) + ")");
        this.entry_allocas.append("  " + name + " = alloca " + llvm_type + "\n");
        this.entry_allocas.append("  store " + llvm_type + " zeroinitializer, ptr " + name + "\n");
    }

    // Allocate a new debug metadata ID (returns just the number string, e.g. "0", "1")
    fun next_debug_id(mut this) -> string {
        _utils.trace_enter("Enter next_debug_id");
        let id: string = cast<string>(this.debug_id_counter);
        this.debug_id_counter = this.debug_id_counter + 1;
        return id;
    }

    // Initialize debug info for a compilation unit
    fun debug_init_compile_unit(mut this, filename: string) {
        _utils.trace_enter("Enter debug_init_compile_unit(filename=" + cast<string>(filename) + ")");
        if (!this.debug_enabled) { return; }
        this.debug_id_counter = 0;
        this.debug_metadata = new _utils.List<string>();
        this.debug_type_cache = new _utils.List<RegMapping>();
        this.debug_file_cache = new _utils.List<RegMapping>();
        // Allocate all IDs upfront to avoid ordering issues
        let file_id: string = this.next_debug_id();       // 0
        let cu_id: string = this.next_debug_id();          // 1
        let sp_type_id: string = this.next_debug_id();     // 2
        let types_list_id: string = this.next_debug_id();  // 3
        let mf0: string = this.next_debug_id();            // 4
        let mf1: string = this.next_debug_id();            // 5
        // Emit metadata in dependency order
        this.current_file_id = file_id;
        this.debug_file_cache.push(new RegMapping(filename, file_id));
        this.debug_metadata.push("!" + file_id + " = !DIFile(filename: \"" + filename + "\", directory: \"\")");
        this.current_compile_unit_id = cu_id;
        this.debug_metadata.push("!" + cu_id + " = distinct !DICompileUnit(language: DW_LANG_C, file: !" + file_id + ", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug)");
        this.current_subroutine_type = sp_type_id;
        this.debug_metadata.push("!" + sp_type_id + " = !DISubroutineType(types: !" + types_list_id + ")");
        this.debug_metadata.push("!" + types_list_id + " = !{null}");
        this.debug_metadata.push("!" + mf0 + " = !{i32 2, !\"Dwarf Version\", i32 4}");
        this.debug_metadata.push("!" + mf1 + " = !{i32 2, !\"Debug Info Version\", i32 3}");
        this.current_module_flags = "!" + mf0 + ", !" + mf1;
    }

    // Begin debug info for a function
    fun debug_begin_function(mut this, func_name: string, loc: SourceLocation) {
        _utils.trace_enter("Enter debug_begin_function(func_name=" + cast<string>(func_name) + ")");
        if (!this.debug_enabled) { return; }
        // Attribute the function (and the locals/types emitted while it is
        // current) to its own source file, not whichever file was used to init
        // the compile unit. Without this every function's DISubprogram pointed
        // at main.penguin, so a debugger showed all parser code as main.penguin.
        this.current_file_id = this.current_file_id;
        let sp_id: string = this.next_debug_id();
        this.current_subprogram_id = sp_id;
        let line_str: string = cast<string>(loc.line);
        this.debug_metadata.push("!" + sp_id + " = distinct !DISubprogram(name: \"" + func_name + "\", file: !" + this.current_file_id + ", line: " + line_str + ", scope: !" + this.current_file_id + ", type: !" + this.current_subroutine_type + ", isLocal: false, isDefinition: true, scopeLine: " + line_str + ", isOptimized: false, unit: !" + this.current_compile_unit_id + ")");
        // Cache the !dbg suffix for this function's scope (used for instructions without source loc)
        let scope_loc_id: string = this.next_debug_id();
        this.debug_metadata.push("!" + scope_loc_id + " = !DILocation(line: " + line_str + ", column: 0, scope: !" + sp_id + ")");
        this.current_scope_dbg = ", !dbg !" + scope_loc_id;
        this.current_scope_loc_id = scope_loc_id;
        this.current_loc_id = scope_loc_id;
    }

    // Get-or-create a !DIFile metadata node for `filename` (cached so each source
    // file maps to a single DIFile id). Falls back to the compile-unit's file
    // for an empty filename so functions without a location still resolve.
    fun debug_get_file(mut this, filename: string) -> string {
        _utils.trace_enter("Enter debug_get_file(filename=" + cast<string>(filename) + ")");
        if (string_length(filename) == 0) { return this.current_file_id; }
        let i: mut i64 = 0;
        while (i < cast<i64>(this.debug_file_cache.size())) {
            let entry: RegMapping = this.debug_file_cache.at(cast<u64>(i)).some;
            if (entry.ir_name == filename) { return entry.llvm_value; }
            i = i + 1;
        }
        let file_id: string = this.next_debug_id();
        this.debug_metadata.push("!" + file_id + " = !DIFile(filename: \"" + filename + "\", directory: \"\")");
        this.debug_file_cache.push(new RegMapping(filename, file_id));
        return file_id;
    }

    // Get debug location suffix for an instruction at the given source location
    // Always emits !dbg when debug is enabled (LLVM requires all instructions in debug functions to have !dbg)
    fun debug_loc(mut this, loc: SourceLocation) -> string {
        _utils.trace_enter("Enter debug_loc");
        if (!this.debug_enabled) { return ""; }
        let line: i64 = loc.line;
        let col: i64 = loc.col;
        if (line == 0) {
            // No source location — use the function scope location
            this.current_loc_id = this.current_scope_loc_id;
            return this.current_scope_dbg;
        }
        let loc_id: string = this.next_debug_id();
        this.debug_metadata.push("!" + loc_id + " = !DILocation(line: " + cast<string>(line) + ", column: " + cast<string>(col) + ", scope: !" + this.current_subprogram_id + ")");
        this.current_loc_id = loc_id;
        return ", !dbg !" + loc_id;
    }

    // Emit all debug metadata at the end of the module
    fun debug_emit_metadata(mut this) {
        _utils.trace_enter("Enter debug_emit_metadata");
        if (!this.debug_enabled) { return; }
        if (cast<i64>(this.debug_metadata.size()) == 0) { return; }
        this.sb.append("\n!llvm.dbg.cu = !{!" + this.current_compile_unit_id + "}\n");
        this.sb.append("!llvm.module.flags = !{" + this.current_module_flags + "}\n");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.debug_metadata.size())) {
            this.sb.append(this.debug_metadata.at(cast<u64>(i)).some + "\n");
            i = i + 1;
        }
    }

    // --- Debug variable helpers ---

    // A register display string is a temp (%tN) iff, after '%', it is 't' followed by digits.
    fun is_debug_temp(this, display: string) -> bool {
        _utils.trace_enter("Enter is_debug_temp(display=" + cast<string>(display) + ")");
        let s: string = display;
        if (string_length(s) < 2) { return false; }
        if (string_char_at(s, 0) != "%") { return false; }
        if (string_char_at(s, 1) != "t") { return false; }
        let i: mut i64 = 2;
        while (i < string_length(s)) {
            let c: string = string_char_at(s, i);
            let code: i64 = string_char_code(c);
            if (code < string_char_code("0") || code > string_char_code("9")) { return false; }
            i = i + 1;
        }
        return true;
    }

    fun is_debug_param(this, name: string) -> bool {
        _utils.trace_enter("Enter is_debug_param(name=" + cast<string>(name) + ")");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.param_names.size())) {
            if (this.param_names.at(cast<u64>(i)).some == name) { return true; }
            i = i + 1;
        }
        return false;
    }

    // Create a !DILocalVariable node; arg_no>0 means parameter (1-based), 0 means local. Returns the var id.
    fun debug_make_local(mut this, name: string, ir_type: string, line: i64, arg_no: i64) -> string {
        _utils.trace_enter("Enter debug_make_local(name=" + cast<string>(name) + ", ir_type=" + cast<string>(ir_type) + ", line=" + cast<string>(line) + ", arg_no=" + cast<string>(arg_no) + ")");
        let type_id: string = this.get_debug_type(ir_type);
        let var_id: string = this.next_debug_id();
        let line_str: string = cast<string>(line);
        if (arg_no > 0) {
            this.debug_metadata.push("!" + var_id + " = !DILocalVariable(name: \"" + name + "\", arg: " + cast<string>(arg_no) + ", scope: !" + this.current_subprogram_id + ", file: !" + this.current_file_id + ", line: " + line_str + ", type: !" + type_id + ")");
        } else {
            this.debug_metadata.push("!" + var_id + " = !DILocalVariable(name: \"" + name + "\", scope: !" + this.current_subprogram_id + ", file: !" + this.current_file_id + ", line: " + line_str + ", type: !" + type_id + ")");
        }
        return var_id;
    }

    // Emit a `#dbg_declare` record binding an alloca slot to a variable (LLVM 22+ record form).
    fun emit_dbg_declare(mut this, alloca_name: string, var_id: string, loc_id: string) {
        _utils.trace_enter("Enter emit_dbg_declare(alloca_name=" + cast<string>(alloca_name) + ", var_id=" + cast<string>(var_id) + ", loc_id=" + cast<string>(loc_id) + ")");
        this.sb.append("  #dbg_declare(ptr " + alloca_name + ", !" + var_id + ", !DIExpression(), !" + loc_id + ")\n");
    }

    // Emit a `#dbg_value` record binding an SSA value to a variable (LLVM 22+ record form).
    fun emit_dbg_value(mut this, llvm_type: string, value_str: string, var_id: string, loc_id: string) {
        _utils.trace_enter("Enter emit_dbg_value(llvm_type=" + cast<string>(llvm_type) + ", value_str=" + cast<string>(value_str) + ", var_id=" + cast<string>(var_id) + ", loc_id=" + cast<string>(loc_id) + ")");
        this.sb.append("  #dbg_value(" + llvm_type + " " + value_str + ", !" + var_id + ", !DIExpression(), !" + loc_id + ")\n");
    }

    // An LLVM type is an aggregate (struct/enum by-value) — dbg.value cannot take these as a
    // first-class value operand (LLVM nulls them on upgrade). Such vars are reached via dbg.declare instead.
    fun is_aggregate_llvm_type(this, llvm_type: string) -> bool {
        _utils.trace_enter("Enter is_aggregate_llvm_type(llvm_type=" + cast<string>(llvm_type) + ")");
        if (this.string_starts_with(llvm_type, "%class.")) { return true; }
        if (this.string_starts_with(llvm_type, "%enum.")) { return true; }
        if (this.string_starts_with(llvm_type, "%struct.")) { return true; }
        return false;
    }

    // For an immutable (single-def) named local: emit a dbg.value right after its SSA definition.
    // Skips temps, params, mutable locals (handled elsewhere), and value-less dests.
    fun maybe_emit_imm_dbg(mut this, dest: IRValue, dbg_suffix: string) {
        _utils.trace_enter("Enter maybe_emit_imm_dbg(dbg_suffix=" + cast<string>(dbg_suffix) + ")");
        if (!this.debug_enabled) { return; }
        if (!(dest is IRValue.named_reg)) { return; }
        let name: string = dest.named_reg.name;
        let display: string = dest.display();
        if (this.is_debug_temp(display)) { return; }
        if (this.is_debug_param(name)) { return; }
        if (this.is_mutable_reg(display)) { return; }
        let ir_type: string = dest.get_ir_type();
        if (ir_type == "" || ir_type == "unknown") { return; }
        let llvm_type: string = this.ir_type_to_llvm(ir_type);
        if (this.is_aggregate_llvm_type(llvm_type)) { return; }
        let var_id: string = this.debug_make_local(name, ir_type, dest.named_reg.location.line, 0);
        let resolved: string = this.resolve_value(dest);
        if (string_length(resolved) > 0 && string_char_at(resolved, 0) == "@") {
            // Constant/global value: a #dbg_value of a global is dropped from DWARF, so back the
            // variable with a dedicated debug alloca (entry slot) + store + #dbg_declare.
            let dbg_alloca: string = this.next_tmp();
            this.emit_entry_alloca(dbg_alloca, llvm_type);
            this.sb.append("  store " + llvm_type + " " + resolved + ", ptr " + dbg_alloca + "\n");
            this.emit_dbg_declare(dbg_alloca, var_id, this.current_loc_id);
        } else {
            this.emit_dbg_value(llvm_type, resolved, var_id, this.current_loc_id);
        }
    }

    fun lower(mut this, module: IRModule, unit: BoundCompilationUnit) -> string {
        _utils.trace_enter("Enter lower(module=" + module.to_string() + ")");
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] Starting LLVM lowering..."); }
        this.string_lits = new _utils.List<StringLitEntry>();
        this.next_str_id = 0;
        this.class_layouts = new _utils.List<ClassLayout>();
        this.enum_layouts = new _utils.List<EnumLayout>();
        this.tmp_counter = 0;
        this.has_iref_class = false;
        this.needs_int_to_string = false;
        this.needs_string_concat = false;
        this.needs_bool_to_string = false;
        this.needs_string_equal = false;
        this.needs_vtable_lookup = false;
        this.needs_isinstance = false;
        this.needs_check_class = false;
        this.has_boxing = false;
        this.has_main = false;
        this.needs_memset = false;
        this.type_id_constants = new _utils.List<TypeIdConstant>();
        this.emitted_interface_ids = new _utils.List<string>();
        this.func_param_types = new _utils.List<FuncParamTypes>();
        this.current_unit = new Option<BoundCompilationUnit>.some(unit);
        // Disable debug info due to compiler codegen bug affecting
        // SourceLocation field access (filename/line/col offsets).
        this.debug_enabled = false;
        this.debug_init_compile_unit(module.location.filename);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] Collecting strings..."); }
        this.collect_strings(module);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] Building layout tables..."); }
        this.build_layout_tables(unit);
        // Emit functions first to determine which runtime declarations are needed
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] Emitting functions..."); }
        let func_sb: mut StringBuilder = new StringBuilder();
        let saved_sb: mut StringBuilder = this.sb;
        this.sb = func_sb;
        this.emit_functions(module);
        this.emit_main(module);
        this.sb = saved_sb;
        // Now build the full output: types + globals + declarations + functions
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] Emitting type definitions..."); }
        this.emit_type_definitions();
        // Flush any interface ID constants that were lazily emitted during
        // function emission (vtable calls may reference interfaces whose
        // implementing classes haven't had their metadata emitted yet).
        this.sb.append(this.pending_iface_ids.to_string());
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] Emitting global strings..."); }
        this.emit_global_strings();
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] Emitting global variables..."); }
        this.emit_global_variables(module);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] Emitting extern declarations..."); }
        this.emit_extern_declarations_to(this.sb, module);
        this.emit_extern_declarations_runtime_to(this.sb);
        this.sb.append("\n");
        this.sb.append(func_sb.to_string());
        // Emit debug metadata
        this.debug_emit_metadata();
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] LLVM lowering done"); }
        return this.sb.to_string();
    }

    // --- Pass 1: collect string literals ---

    fun collect_strings(mut this, module: IRModule) {
        _utils.trace_enter("Enter collect_strings(module=" + module.to_string() + ")");
        let fi: mut i64 = 0;
        while (fi < cast<i64>(module.functions.size())) {
            let func: IRFunction = module.functions.at(cast<u64>(fi)).some;
            if (!func.is_extern) {
                this.collect_strings_in_func(func);
            }
            fi = fi + 1;
        }
        // Collect strings from global variable initializers
        let gi: mut i64 = 0;
        while (gi < cast<i64>(module.global_variables.size())) {
            let gv: IRGlobalVariable = module.global_variables.at(cast<u64>(gi)).some;
            if (this.is_string_type(gv.ir_type) && gv.initializer_value != "null" && gv.initializer_value != "") {
                let val: string = this.strip_string_quotes(gv.initializer_value);
                if (!this.find_string_lit(val).is_some()) {
                    let id: i64 = this.next_str_id;
                    this.next_str_id = this.next_str_id + 1;
                    this.string_lits.push(new StringLitEntry(id, val));
                }
            }
            gi = gi + 1;
        }
    }

    fun collect_strings_in_func(mut this, func: IRFunction) {
        _utils.trace_enter("Enter collect_strings_in_func(func=" + func.to_string() + ")");
        let ii: mut i64 = 0;
        while (ii < cast<i64>(func.instructions.size())) {
            let inst: IRInstruction = func.instructions.at(cast<u64>(ii)).some;
            if (inst is IRInstruction.const_inst) {
                let ir_type: string = inst.const_inst.result.get_ir_type();
                if (this.is_string_type(ir_type)) {
                    let raw_val: string = inst.const_inst.value;
                    let val: string = this.strip_string_quotes(raw_val);
                    if (!this.find_string_lit(val).is_some()) {
                        let id: i64 = this.next_str_id;
                        this.next_str_id = this.next_str_id + 1;
                        this.string_lits.push(new StringLitEntry(id, val));
                    }
                }
            }
            ii = ii + 1;
        }
    }

    fun find_string_lit(this, value: string) -> Option<StringLitEntry> {
        _utils.trace_enter("Enter find_string_lit(value=" + cast<string>(value) + ")");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.string_lits.size())) {
            let entry: StringLitEntry = this.string_lits.at(cast<u64>(i)).some;
            if (entry.value == value) {
                return new Option<StringLitEntry>.some(entry);
            }
            i = i + 1;
        }
        return new Option<StringLitEntry>.none();
    }

    // --- Pass 2: emit LLVM IR ---

    fun emit_global_strings(mut this) {
        _utils.trace_enter("Enter emit_global_strings");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.string_lits.size())) {
            let entry: StringLitEntry = this.string_lits.at(cast<u64>(i)).some;
            let byte_len: i64 = cast<i64>(string_length(entry.value)) + 1;
            this.sb.append(entry.global_name() + " = private unnamed_addr constant [" + cast<string>(byte_len) + " x i8] c\"" + this.escape_llvm_string(entry.value) + "\\00\"\n");
            i = i + 1;
        }
        // Emit type ID string constants for ISINSTANCE
        let ti: mut i64 = 0;
        while (ti < cast<i64>(this.type_id_constants.size())) {
            let tc: TypeIdConstant = this.type_id_constants.at(cast<u64>(ti)).some;
            this.sb.append(tc.global_name + " = private unnamed_addr constant [" + cast<string>(tc.len) + " x i8] c\"" + this.escape_llvm_string(tc.display_name) + "\\00\"\n");
            ti = ti + 1;
        }
    }

    fun emit_global_variables(mut this, module: IRModule) {
        _utils.trace_enter("Enter emit_global_variables(module=" + module.to_string() + ")");
        let i: mut i64 = 0;
        while (i < cast<i64>(module.global_variables.size())) {
            let gv: IRGlobalVariable = module.global_variables.at(cast<u64>(i)).some;
            let llvm_type: string = this.ir_type_to_llvm(gv.ir_type);
            let global_name: string = "@" + this.sanitize_name(gv.name);
            if (gv.initializer_value == "null") {
                this.sb.append(global_name + " = global " + llvm_type + " null\n");
            } else if (this.is_int_type(gv.ir_type)) {
                this.sb.append(global_name + " = global " + llvm_type + " " + gv.initializer_value + "\n");
            } else if (this.is_bool_type(gv.ir_type)) {
                let val: mut string = "0";
                if (gv.initializer_value == "true") { val = "1"; }
                this.sb.append(global_name + " = global " + llvm_type + " " + val + "\n");
            } else {
                this.sb.append(global_name + " = global " + llvm_type + " zeroinitializer\n");
            }
            i = i + 1;
        }
    }

    fun emit_extern_declarations_to(mut this, target: mut StringBuilder, module: IRModule) {
        _utils.trace_enter("Enter emit_extern_declarations_to(module=" + module.to_string() + ")");
        let emitted: mut _utils.List<string> = new _utils.List<string>();
        let fi: mut i64 = 0;
        while (fi < cast<i64>(module.functions.size())) {
            let func: IRFunction = module.functions.at(cast<u64>(fi)).some;
            if (func.is_extern) {
                let llvm_name: string = this.llvm_func_name(func.name);
                let already: mut bool = false;
                let ei: mut i64 = 0;
                while (ei < cast<i64>(emitted.size())) {
                    if (emitted.at(cast<u64>(ei)).some == llvm_name) {
                        already = true;
                    }
                    ei = ei + 1;
                }
                if (!already) {
                    emitted.push(llvm_name);
                    target.append("declare " + this.ir_type_to_llvm(func.return_type) + " " + llvm_name + "(");
                    let pi: mut i64 = 0;
                    while (pi < cast<i64>(func.parameters.size())) {
                        if (pi > 0) { target.append(", "); }
                        let p: IRParameter = func.parameters.at(cast<u64>(pi)).some;
                        target.append(this.ir_type_to_llvm(p.ir_type));
                        pi = pi + 1;
                    }
                    target.append(")\n");
                }
            }
            fi = fi + 1;
        }
    }

    fun emit_extern_declarations_runtime_to(mut this, target: mut StringBuilder) {
        _utils.trace_enter("Enter emit_extern_declarations_runtime_to");
        let has_layouts: bool = cast<i64>(this.class_layouts.size()) > 0 || cast<i64>(this.enum_layouts.size()) > 0;
        let needs_its: bool = this.needs_int_to_string;
        let needs_sc: bool = this.needs_string_concat;
        if (this.has_iref_class || this.has_boxing) {
            target.append("declare ptr @_emperor_alloc_impl(i32)\n");
        }
        if (this.has_boxing) {
            target.append("declare void @llvm.memcpy.p0.p0.i32(ptr, ptr, i32, i1)\n");
        }
        if (has_layouts || needs_its) {
            target.append("declare ptr @_emperor_int_to_string(i32)\n");
            target.append("declare ptr @_emperor_i64_to_string(i64)\n");
        }
        if (has_layouts || needs_sc) {
            target.append("declare ptr @_emperor_string_concat(ptr, ptr)\n");
        }
        if (this.needs_bool_to_string) {
            target.append("declare ptr @_emperor_bool_to_string(i8)\n");
        }
        if (this.needs_string_equal) {
            target.append("declare i32 @_emperor_string_equal(ptr, ptr)\n");
        }
        if (this.needs_vtable_lookup) {
            target.append("declare ptr @_emperor_vtable_lookup(ptr, ptr, i32)\n");
        }
        if (this.needs_isinstance) {
            target.append("declare i32 @_emperor_isinstance(ptr, ptr)\n");
        }
        if (this.needs_check_class) {
            target.append("declare i32 @_emperor_check_class(ptr, ptr)\n");
        target.append("declare ptr @_emperor_icopy_copy(ptr)\n");
        }
        if (this.has_main) {
            target.append("declare void @_emperor_gc_init(ptr)\n");
            target.append("declare void @_emperor_gc_add_root(ptr)\n");
            target.append("declare void @_emperor_args_init(i32, ptr)\n");
            target.append("declare void @_emperor_boost_stack()\n");
        }
        if (this.needs_memset) {
            target.append("declare void @llvm.memset.p0.i64(ptr nocapture writeonly, i8, i64, i1 immarg)\n");
        }
    }

    fun precompute_function_signatures(mut this, module: IRModule) {
        _utils.trace_enter("Enter precompute_function_signatures");
        let fi: mut i64 = 0;
        while (fi < cast<i64>(module.functions.size())) {
            let func: IRFunction = module.functions.at(cast<u64>(fi)).some;
            let fpt: mut FuncParamTypes = new FuncParamTypes(this.strip_global_prefix(func.name));
            let ppi: mut i64 = 0;
            while (ppi < cast<i64>(func.parameters.size())) {
                let pp: IRParameter = func.parameters.at(cast<u64>(ppi)).some;
                fpt.param_types.push(this.ir_type_to_llvm(pp.ir_type));
                ppi = ppi + 1;
            }
            this.func_param_types.push(fpt);
            fi = fi + 1;
        }
    }

    fun emit_functions(mut this, module: IRModule) {
        _utils.trace_enter("Enter emit_functions(module=" + module.to_string() + ")");
        // Pre-compute every function's parameter signature BEFORE emitting any body, so
        // forward-reference call sites resolve callee param types via find_func_param_types.
        // Without this, emit_args_coerced defaults the param type and produces by-ref vs
        // by-val ABI mismatches (the enum-param crash, mechanism D).
        this.precompute_function_signatures(module);
        let emitted: mut _utils.List<string> = new _utils.List<string>();
        let fi: mut i64 = 0;
        while (fi < cast<i64>(module.functions.size())) {
            let func: IRFunction = module.functions.at(cast<u64>(fi)).some;
            // Skip already-emitted functions (dedup)
            let fname: string = this.llvm_func_name(func.name);
            let already: mut bool = false;
            let ei: mut i64 = 0;
            while (ei < cast<i64>(emitted.size())) {
                if (emitted.at(cast<u64>(ei)).some == fname) { already = true; }
                ei = ei + 1;
            }
            if (already) { fi = fi + 1; continue; }
            emitted.push(fname);
            // Skip truly extern functions (those with only ARG/ret/ret_void instructions)
            if (func.is_extern) {
                let has_body: mut bool = false;
                let ii: mut i64 = 0;
                while (ii < cast<i64>(func.instructions.size())) {
                    let inst: IRInstruction = func.instructions.at(cast<u64>(ii)).some;
                    if (!(inst is IRInstruction.ret) && !(inst is IRInstruction.ret_void) && !(inst is IRInstruction.arg)) {
                        has_body = true;
                    }
                    ii = ii + 1;
                }
                if (!has_body) {
                    fi = fi + 1;
                    continue;
                }
            }
            this.emit_function(func);
            if (this.verbose >= 2) { __builtin.eprintln("[EmperorPenguin LLVM]   Emitted function " + func.name); }
            fi = fi + 1;
        }
    }

    fun emit_function(mut this, func: IRFunction) {
        _utils.trace_enter("Enter emit_function(func=" + func.to_string() + ")");
        this.reg_map = new _utils.List<RegMapping>();
        this.reg_type_map = new _utils.List<RegMapping>();
        this.icmp_results = new _utils.List<string>();
        this.cond_counter = 0;
        this.current_ret_type = func.return_type;
        this.param_names = new _utils.List<string>();

        // Determine if this function returns an aggregate that needs sret (RVO)
        let use_sret: bool = !func.is_extern && this.needs_sret(func.return_type);
        if (use_sret) {
            this.current_sret_llvm_type = this.get_sret_llvm_type(func.return_type);
            this.current_sret_param = "%_sret_result";
        } else {
            this.current_sret_llvm_type = "";
            this.current_sret_param = "";
        }

        // Parameter types for call argument coercion are pre-computed for all
        // functions in emit_functions (precompute_function_signatures), so forward
        // references resolve. Nothing to populate here.
        // Map parameters: ARG instruction creates %tN → %paramname mapping
        let pi: mut i64 = 0;
        while (pi < cast<i64>(func.parameters.size())) {
            let p: IRParameter = func.parameters.at(cast<u64>(pi)).some;
            this.reg_map.push(new RegMapping("%" + p.name, "%" + p.name));
            this.param_names.push(p.name);
            let param_llvm_type: string = this.ir_type_to_llvm(p.ir_type);
            if (param_llvm_type != "") {
                this.register_llvm_type("%" + p.name, param_llvm_type);
            }
            pi = pi + 1;
        }

        // Pre-scan for RVO / sret-elision (must precede scan_mutable_regs so the
        // mutable-reg alloca can be sized to fit the callee's sret return type).
        this.scan_sret_elision(func);

        // Pre-scan for mutable registers (reassigned multiple times)
        this.scan_mutable_regs(func);

        // Initialize debug info for this function
        this.debug_begin_function(func.name, func.location);
        let func_dbg: mut string = "";
        let dbg_on: bool = this.debug_enabled;
        if (dbg_on && this.current_subprogram_id != "") {
            func_dbg = " !dbg !" + this.current_subprogram_id;
        }

        // Build debug variables for parameters (dbg.value calls emitted in the entry block below).
        let param_dbg_sb: mut StringBuilder = new StringBuilder();
        if (dbg_on && !func.is_extern) {
            let pai: mut i64 = 0;
            while (pai < cast<i64>(func.parameters.size())) {
                let p: IRParameter = func.parameters.at(cast<u64>(pai)).some;
                let p_llvm_type: string = this.ir_type_to_llvm(p.ir_type);
                if (this.is_aggregate_llvm_type(p_llvm_type)) { pai = pai + 1; continue; }
                let var_id: string = this.debug_make_local(p.name, p.ir_type, p.location.line, pai + 1);
                param_dbg_sb.append("  #dbg_value(" + p_llvm_type + " %" + p.name + ", !" + var_id + ", !DIExpression(), !" + this.current_scope_loc_id + ")\n");
                pai = pai + 1;
            }
        }

        // Emit function signature
        if (use_sret) {
            this.sb.append("define void " + this.llvm_func_name(func.name) + "(ptr sret(" + this.current_sret_llvm_type + ") " + this.current_sret_param);
        } else {
            this.sb.append("define " + this.ir_type_to_llvm(func.return_type) + " " + this.llvm_func_name(func.name) + "(");
        }
        pi = 0;
        while (pi < cast<i64>(func.parameters.size())) {
            if (pi > 0 || use_sret) { this.sb.append(", "); }
            let p: IRParameter = func.parameters.at(cast<u64>(pi)).some;
            let p_llvm_type: string = this.ir_type_to_llvm(p.ir_type);
            // For >16-byte aggregates (value-type classes and large enums), use
            // byval so clang passes the argument via a pointer consistently between
            // caller and callee (System V ABI for large structs).
            if (this.llvm_type_size(p_llvm_type) > 16) {
                this.sb.append("ptr byval(" + p_llvm_type + ") %" + p.name);
            } else {
                this.sb.append(p_llvm_type + " %" + p.name);
            }
            pi = pi + 1;
        }
        this.sb.append(")" + func_dbg + " {\n");
        this.sb.append("entry:\n");

        // For byval aggregate parameters (>16 bytes), register the parameter name as
        // a pointer so coerce_operand / materialize_enum_ptr correctly handle
        // ptr->struct loads.
        {
            let bi: mut i64 = 0;
            while (bi < cast<i64>(func.parameters.size())) {
                let p: IRParameter = func.parameters.at(cast<u64>(bi)).some;
                let p_llvm_type: string = this.ir_type_to_llvm(p.ir_type);
                if (this.llvm_type_size(p_llvm_type) > 16) {
                    this.register_llvm_type("%" + p.name, "ptr");
                }
                bi = bi + 1;
            }
        }

        // Emit allocas for mutable registers at function entry
        let ai: mut i64 = 0;
        while (ai < cast<i64>(this.mutable_regs.size())) {
            let name: string = this.mutable_regs.at(cast<u64>(ai)).some;
            let alloca_name: string = this.get_alloca_name(name);
            let llvm_type: string = this.get_llvm_type(name);
            this.sb.append("  " + alloca_name + " = alloca " + llvm_type + "\n");
            // Zero-initialize mutable-reg allocas so i32-tag padding (and any other
            // partial-write gap) doesn't retain stack residuals — same rationale as
            // emit_entry_alloca's zero-init. Mutable locals are the value-type structs
            // (Option<BoundExpression>, BoundSymbol, SourceLocation, ...) the semantic
            // model builds on the stack; without this, their i32-tag stores leave the
            // upper 32 bits of the slot as a prior pointer's high bits, which composes
            // into a corrupted value that overwrites a return-address slot on stack
            // reuse → control-flow hijack (the binding crash at get_temp_folder,
            // RA = 0x555500000000).
            if (llvm_type != "" && llvm_type != "void") {
                this.sb.append("  store " + llvm_type + " zeroinitializer, ptr " + alloca_name + "\n");
            }
            if (dbg_on && !func.is_extern && !this.is_debug_temp(name)) {
                let mr_ir_type: string = this.mutable_reg_ir_types.at(cast<u64>(ai)).some;
                let mr_line: i64 = this.mutable_reg_lines.at(cast<u64>(ai)).some;
                let clean_name: mut string = name;
                if (string_length(name) > 1 && string_char_at(name, 0) == "%") {
                    clean_name = string_substring(name, 1, string_length(name) - 1);
                }
                let var_id: string = this.debug_make_local(clean_name, mr_ir_type, mr_line, 0);
                this.emit_dbg_declare(alloca_name, var_id, this.current_scope_loc_id);
            }
            ai = ai + 1;
        }

        // Emit parameter dbg.value calls in the entry block (after allocas).
        if (dbg_on && !func.is_extern) {
            this.sb.append(param_dbg_sb.to_string());
        }

        // Switch to body_sb for instruction emission and entry_allocas for alloca collection.
        // This ensures all alloca instructions land in the entry block (preventing stack growth in loops).
        let saved_sb: mut StringBuilder = this.sb;
        this.body_sb = new StringBuilder();
        this.entry_allocas = new StringBuilder();
        this.sb = this.body_sb;

        let block_terminated: mut bool = false;
        let ii: mut i64 = 0;
        while (ii < cast<i64>(func.instructions.size())) {
            let inst: IRInstruction = func.instructions.at(cast<u64>(ii)).some;
            let is_label: bool = inst is IRInstruction.label_inst;
            if (is_label) {
                if (block_terminated == false) {
                    this.sb.append("  br label %" + inst.label_inst.label_name + "\n");
                }
                block_terminated = false;
            }
            if (block_terminated == false) {
                // RVO: an elided ASSIGN (its source CALL wrote the value directly
                // into the destination's storage) must be skipped to avoid a
                // redundant/overflowing store.
                let skip_inst: bool = inst is IRInstruction.assign && this.is_elided_assign(ii);
                if (!skip_inst) {
                    this.emit_instruction(inst);
                }
            }
            if (inst is IRInstruction.br || inst is IRInstruction.br_cond || inst is IRInstruction.ret || inst is IRInstruction.ret_void) {
                block_terminated = true;
            }
            ii = ii + 1;
        }

        // Restore sb and emit: entry_allocas first, then body
        this.sb = saved_sb;
        this.sb.append(this.entry_allocas.to_string());
        this.sb.append(this.body_sb.to_string());
        this.sb.append("}\n\n");
    }

    fun emit_main(mut this, module: IRModule) {
        _utils.trace_enter("Enter emit_main(module=" + module.to_string() + ")");
        if (cast<i64>(module.entry_functions.size()) > 0 || cast<i64>(module.init_functions.size()) > 0) {
            this.has_main = true;
            this.sb.append("define i32 @main(i32 %argc, ptr %argv) {\n");
            this.sb.append("entry:\n");
            // Increase stack limit early (before any deep recursion).
            // The semantic analysis passes use deep recursion and may overflow
            // the default 8 MB stack, causing intermittent SIGSEGV.
            this.sb.append("  call void @_emperor_boost_stack()\n");
            // Initialize args
            this.sb.append("  call void @_emperor_args_init(i32 %argc, ptr %argv)\n");
            // Initialize GC
            this.sb.append("  %_gc_sp = call ptr @llvm.frameaddress(i32 0)\n");
            this.sb.append("  call void @_emperor_gc_init(ptr %_gc_sp)\n");
            // Register global reference-type variables as GC roots
            let gi: mut i64 = 0;
            while (gi < cast<i64>(module.global_variables.size())) {
                let gv: IRGlobalVariable = module.global_variables.at(cast<u64>(gi)).some;
                if (this.is_string_type(gv.ir_type) || this.is_ref_type(gv.ir_type)) {
                    let global_name: string = "@" + this.sanitize_name(gv.name);
                    this.sb.append("  call void @_emperor_gc_add_root(ptr " + global_name + ")\n");
                }
                gi = gi + 1;
            }
            // Initialize global variables with non-trivial initializers
            gi = 0;
            while (gi < cast<i64>(module.global_variables.size())) {
                let gv: IRGlobalVariable = module.global_variables.at(cast<u64>(gi)).some;
                if (this.is_string_type(gv.ir_type) && gv.initializer_value != "null" && gv.initializer_value != "") {
                    let val: string = this.strip_string_quotes(gv.initializer_value);
                    let entry: Option<StringLitEntry> = this.find_string_lit(val);
                    if (entry.is_some()) {
                        let global_name: string = "@" + this.sanitize_name(gv.name);
                        this.sb.append("  store ptr " + entry.some.global_name() + ", ptr " + global_name + "\n");
                    }
                }
                gi = gi + 1;
            }
            // Call global init functions (non-literal initializers)
            let ini: mut i64 = 0;
            while (ini < cast<i64>(module.init_functions.size())) {
                let init_func: IRFunction = module.init_functions.at(cast<u64>(ini)).some;
                this.sb.append("  call void " + this.llvm_func_name(init_func.name) + "()\n");
                ini = ini + 1;
            }
            let i: mut i64 = 0;
            while (i < cast<i64>(module.entry_functions.size())) {
                let entry: IRFunction = module.entry_functions.at(cast<u64>(i)).some;
                this.sb.append("  call void " + this.llvm_func_name(entry.name) + "()\n");
                i = i + 1;
            }
            this.sb.append("  ret i32 0\n");
            this.sb.append("}\n");
        }
    }

    // --- Layout building ---

    fun build_layout_tables(mut this, unit: BoundCompilationUnit) {
        _utils.trace_enter("Enter build_layout_tables");
        // Pass 1: build all enum layouts first (classes may reference them)
        let di: mut i64 = 0;
        while (di < cast<i64>(unit.definitions.size())) {
            let def: BoundDefinition = unit.definitions.at(cast<u64>(di)).some;
            this.build_enum_layouts_for_def(def);
            di = di + 1;
        }
        // Pass 2: build class layouts (can now reference enum layouts)
        di = 0;
        while (di < cast<i64>(unit.definitions.size())) {
            let def: BoundDefinition = unit.definitions.at(cast<u64>(di)).some;
            this.build_class_layouts_for_def(def);
            di = di + 1;
        }
    }

    fun build_enum_layouts_for_def(mut this, def: BoundDefinition) {
        _utils.trace_enter("Enter build_enum_layouts_for_def");
        if (def is BoundDefinition.enum_def) {
            if (cast<i64>(def.enum_def.generic_params.size()) == 0) {
                this.build_enum_layout(def.enum_def);
            }
        }
        if (def is BoundDefinition.namespace_def) {
            let ns: BoundNamespaceDefinition = def.namespace_def;
            let i: mut i64 = 0;
            while (i < cast<i64>(ns.children.size())) {
                this.build_enum_layouts_for_def(ns.children.at(cast<u64>(i)).some);
                i = i + 1;
            }
        }
    }

    fun build_class_layouts_for_def(mut this, def: BoundDefinition) {
        _utils.trace_enter("Enter build_class_layouts_for_def");
        if (def is BoundDefinition.class_def) {
            if (!def.class_def.is_generic_template) {
                this.build_class_layout(def.class_def);
            }
        }
        if (def is BoundDefinition.namespace_def) {
            let ns: BoundNamespaceDefinition = def.namespace_def;
            let i: mut i64 = 0;
            while (i < cast<i64>(ns.children.size())) {
                this.build_class_layouts_for_def(ns.children.at(cast<u64>(i)).some);
                i = i + 1;
            }
        }
    }

    fun build_class_layout(mut this, cls: BoundClassDefinition) {
        _utils.trace_enter("Enter build_class_layout");
        let is_value: mut bool = true;
        if (cls.is_value_class.is_some()) {
            is_value = cls.is_value_class.some;

        }
        // Both ICopy and IRef classes have metadata pointers
        let has_metadata: bool = true;
        if (!is_value) {
            this.has_iref_class = true;
        }
        let layout: mut ClassLayout = new ClassLayout(this.strip_global_prefix(cls.full_name), is_value, has_metadata);

        let offset: mut i64 = 0;
        if (has_metadata) {
            offset = 8;
        }
        let field_idx: mut i64 = 1;
        let fi: mut i64 = 0;
        while (fi < cast<i64>(cls.fields.size())) {
            let fdef: BoundDefinition = cls.fields.at(cast<u64>(fi)).some;
            if (fdef is BoundDefinition.class_field) {
                let cf: BoundClassFieldDefinition = fdef.class_field;
                let field_llvm_type: string = this.bound_type_to_llvm_type(cf.bound_type);
                let field_size: i64 = this.llvm_type_size(field_llvm_type);
                let field_align: i64 = this.llvm_type_align(field_llvm_type);
                let aligned_offset: i64 = this.align_up(offset, field_align);
                let fl: mut FieldLayout = new FieldLayout(cf.name, field_llvm_type, aligned_offset, field_idx);
                fl.bound_type = new Option<BoundType>.some(cf.bound_type);
                layout.fields.push(fl);
                offset = aligned_offset + field_size;
                field_idx = field_idx + 1;
            }
            fi = fi + 1;
        }
        layout.sizeof_object = this.align_up(offset, 8);

        // Collect vtable info from class's implemented interfaces
        let vi: mut i64 = 0;
        while (vi < cast<i64>(cls.vtables.size())) {
            let vtable: BoundVTable = cls.vtables.at(cast<u64>(vi)).some;
            let iface_name: string = vtable.interface_type.display_name();
            let iface_vtable: mut InterfaceVTable = new InterfaceVTable(iface_name);
            let si: mut i64 = 0;
            while (si < cast<i64>(vtable.slots.size())) {
                let slot: BoundVTableSlot = vtable.slots.at(cast<u64>(si)).some;
                if (slot.implementation_method.is_some()) {
                    let func_name: string = this.llvm_func_name(slot.implementation_method.some.full_name);
                    iface_vtable.method_ptrs.push(func_name);
                }
                si = si + 1;
            }
            layout.interface_vtables.push(iface_vtable);
            vi = vi + 1;
        }

        // Skip if already added (dedup for classes that appear in multiple definitions)
        let existing: Option<ClassLayout> = this.find_class_layout(layout.type_name);
        if (existing.is_some()) { return; }
        this.class_layouts.push(layout);
    }

    fun build_enum_layout(mut this, enum_def: BoundEnumDefinition) {
        _utils.trace_enter("Enter build_enum_layout");
        let layout: mut EnumLayout = new EnumLayout(this.strip_global_prefix(enum_def.full_name));
        let has_payload: mut bool = false;
        let payload_type: mut string = "";
        let enum_name: string = enum_def.name;

        let mi: mut i64 = 0;
        while (mi < cast<i64>(enum_def.members.size())) {
            let member: BoundEnumMemberDefinition = enum_def.members.at(cast<u64>(mi)).some;
            let mt: BoundType = member.member_type;
            let is_void: bool = mt.kind is TypeKind.PrimitiveKind
                && mt.primitive is PrimitiveType.VoidType;
            let is_self_enum: bool = mt.kind is TypeKind.EnumKind
                && mt.display_name() == enum_name;
            if (is_void || is_self_enum) {
                let variant: EnumVariantLayout = new EnumVariantLayout(member.name, member.value, "");
                layout.variants.push(variant);
            } else {
                let member_llvm_type: string = this.bound_type_to_llvm_type(mt);
                let variant: EnumVariantLayout = new EnumVariantLayout(member.name, member.value, member_llvm_type);
                variant.payload_bound_type = new Option<BoundType>.some(mt);
                layout.variants.push(variant);
                has_payload = true;
                if (payload_type == "" || this.llvm_type_size(member_llvm_type) > this.llvm_type_size(payload_type)) {
                    payload_type = member_llvm_type;
                }
            }
            mi = mi + 1;
        }

        layout.has_payload = has_payload;
        layout.payload_llvm_type = payload_type;

        // Collect vtable info from enum's implemented interfaces
        let vi: mut i64 = 0;
        while (vi < cast<i64>(enum_def.vtables.size())) {
            let vtable: BoundVTable = enum_def.vtables.at(cast<u64>(vi)).some;
            let iface_name: string = vtable.interface_type.display_name();
            let iface_vtable: mut InterfaceVTable = new InterfaceVTable(iface_name);
            let si: mut i64 = 0;
            while (si < cast<i64>(vtable.slots.size())) {
                let slot: BoundVTableSlot = vtable.slots.at(cast<u64>(si)).some;
                if (slot.implementation_method.is_some()) {
                    let func_name: string = this.llvm_func_name(slot.implementation_method.some.full_name);
                    iface_vtable.method_ptrs.push(func_name);
                }
                si = si + 1;
            }
            layout.interface_vtables.push(iface_vtable);
            vi = vi + 1;
        }

        // Skip if already added (dedup)
        let existing_enum: Option<EnumLayout> = this.find_enum_layout(layout.type_name);
        if (existing_enum.is_some()) { return; }
        this.enum_layouts.push(layout);
    }

    fun find_class_layout(this, type_name: string) -> Option<ClassLayout> {
        _utils.trace_enter("Enter find_class_layout(type_name=" + cast<string>(type_name) + ")");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.class_layouts.size())) {
            let layout: ClassLayout = this.class_layouts.at(cast<u64>(i)).some;
            if (layout.type_name == type_name) {
                return new Option<ClassLayout>.some(layout);
            }
            i = i + 1;
        }
        // Suffix match: simple name "Point" matches "__ns.Point"
        let tn_len: i64 = string_length(type_name);
        i = 0;
        while (i < cast<i64>(this.class_layouts.size())) {
            let layout: ClassLayout = this.class_layouts.at(cast<u64>(i)).some;
            let ln: i64 = string_length(layout.type_name);
            if (ln > tn_len) {
                let suffix: string = string_substring(layout.type_name, ln - tn_len, tn_len);
                let sep: string = string_substring(layout.type_name, ln - tn_len - 1, 1);
                if (suffix == type_name && sep == ".") {
                    return new Option<ClassLayout>.some(layout);
                }
            }
            i = i + 1;
        }
        // Reverse suffix match: "_utils.List__string" matches layout "List__string"
        let dot_pos: mut i64 = -1;
        let si: mut i64 = 0;
        while (si < string_length(type_name)) {
            if (string_substring(type_name, si, 1) == ".") {
                dot_pos = si;
            }
            si = si + 1;
        }
        if (dot_pos >= 0) {
            let short_name: string = string_substring(type_name, dot_pos + 1, string_length(type_name) - dot_pos - 1);
            i = 0;
            while (i < cast<i64>(this.class_layouts.size())) {
                let layout: ClassLayout = this.class_layouts.at(cast<u64>(i)).some;
                if (layout.type_name == short_name) {
                    return new Option<ClassLayout>.some(layout);
                }
                i = i + 1;
            }
        }
        return new Option<ClassLayout>.none();
    }

    fun find_enum_layout(this, type_name: string) -> Option<EnumLayout> {
        _utils.trace_enter("Enter find_enum_layout(type_name=" + cast<string>(type_name) + ")");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.enum_layouts.size())) {
            let layout: EnumLayout = this.enum_layouts.at(cast<u64>(i)).some;
            if (layout.type_name == type_name) {
                return new Option<EnumLayout>.some(layout);
            }
            i = i + 1;
        }
        // Suffix match: simple name "Color" matches "__ns.Color"
        let tn_len: i64 = string_length(type_name);
        i = 0;
        while (i < cast<i64>(this.enum_layouts.size())) {
            let layout: EnumLayout = this.enum_layouts.at(cast<u64>(i)).some;
            let ln: i64 = string_length(layout.type_name);
            if (ln > tn_len) {
                let suffix: string = string_substring(layout.type_name, ln - tn_len, tn_len);
                let sep: string = string_substring(layout.type_name, ln - tn_len - 1, 1);
                if (suffix == type_name && sep == ".") {
                    return new Option<EnumLayout>.some(layout);
                }
            }
            i = i + 1;
        }
        // Reverse suffix match: "_utils.Option__string" matches layout "Option__string"
        let dot_pos: mut i64 = -1;
        let si: mut i64 = 0;
        while (si < string_length(type_name)) {
            if (string_substring(type_name, si, 1) == ".") {
                dot_pos = si;
            }
            si = si + 1;
        }
        if (dot_pos >= 0) {
            let short_name: string = string_substring(type_name, dot_pos + 1, string_length(type_name) - dot_pos - 1);
            i = 0;
            while (i < cast<i64>(this.enum_layouts.size())) {
                let layout: EnumLayout = this.enum_layouts.at(cast<u64>(i)).some;
                if (layout.type_name == short_name) {
                    return new Option<EnumLayout>.some(layout);
                }
                i = i + 1;
            }
        }
        return new Option<EnumLayout>.none();
    }

    fun extract_type_name(this, ir_type: string) -> string {
        _utils.trace_enter("Enter extract_type_name(ir_type=" + cast<string>(ir_type) + ")");
        // Parse "ref<X>" or "enum<X>" → "X"
        if (this.string_starts_with(ir_type, "ref<")) {
            return string_substring(ir_type, 4, string_length(ir_type) - 5);
        }
        if (this.string_starts_with(ir_type, "enum<")) {
            return string_substring(ir_type, 5, string_length(ir_type) - 6);
        }
        return ir_type;
    }

    fun is_value_class_ref(this, ir_type: string) -> bool {
        _utils.trace_enter("Enter is_value_class_ref(ir_type=" + cast<string>(ir_type) + ")");
        if (!this.string_starts_with(ir_type, "ref<")) { return false; }
        let type_name: string = this.extract_type_name(ir_type);
        let found: Option<ClassLayout> = this.find_class_layout(type_name);
        if (found.is_some()) { return found.some.is_value_type; }
        return false;
    }

    // Determine whether a return type needs sret (RVO). Both value-type classes
    // (ref<ValueClass>) and enums (enum<...>) always use sret, so that their
    // LLVM codegen behavior is uniform and consistent. Extern functions are
    // excluded by the caller (emit_function checks !func.is_extern).
    fun needs_sret(this, ir_type: string) -> bool {
        _utils.trace_enter("Enter needs_sret(ir_type=" + cast<string>(ir_type) + ")");
        if (this.is_value_class_ref(ir_type)) { return true; }
        if (this.string_starts_with(ir_type, "enum<")) {
            let llvm_type: string = this.ir_type_to_llvm(ir_type);
            if (this.string_starts_with(llvm_type, "%enum.")) {
                return true;
            }
        }
        return false;
    }

    // Get the LLVM struct type used for sret, for both value-type classes and
    // enums.
    fun get_sret_llvm_type(this, ir_type: string) -> string {
        _utils.trace_enter("Enter get_sret_llvm_type(ir_type=" + cast<string>(ir_type) + ")");
        if (this.string_starts_with(ir_type, "ref<")) {
            let type_name: string = this.extract_type_name(ir_type);
            let found: Option<ClassLayout> = this.find_class_layout(type_name);
            if (found.is_some()) { return found.some.llvm_struct_type; }
            return "";
        }
        if (this.string_starts_with(ir_type, "enum<")) {
            return this.ir_type_to_llvm(ir_type);
        }
        return "";
    }

    fun get_value_class_llvm_struct_type(this, ir_type: string) -> string {
        _utils.trace_enter("Enter get_value_class_llvm_struct_type(ir_type=" + cast<string>(ir_type) + ")");
        let type_name: string = this.extract_type_name(ir_type);
        let found: Option<ClassLayout> = this.find_class_layout(type_name);
        if (found.is_some()) { return found.some.llvm_struct_type; }
        return "";
    }

    fun next_tmp(mut this) -> string {
        _utils.trace_enter("Enter next_tmp");
        let name: string = "%tmp_" + cast<string>(this.tmp_counter);
        this.tmp_counter = this.tmp_counter + 1;
        return name;
    }

    // --- Type definitions ---

    fun emit_type_definitions(mut this) {
        _utils.trace_enter("Enter emit_type_definitions");
        // Emit ICopy class struct types (with metadata ptr at field 0)
        let ci: mut i64 = 0;
        while (ci < cast<i64>(this.class_layouts.size())) {
            let layout: ClassLayout = this.class_layouts.at(cast<u64>(ci)).some;
            if (layout.is_value_type) {
                this.sb.append(layout.llvm_struct_type + " = type { ptr");
                let fi: mut i64 = 0;
                while (fi < cast<i64>(layout.fields.size())) {
                    this.sb.append(", " + layout.fields.at(cast<u64>(fi)).some.llvm_type);
                    fi = fi + 1;
                }
                this.sb.append(" }\n");
            }
            ci = ci + 1;
        }

        // Emit enum struct types: { ptr metadata, i32 variant, payload? }
        let ei: mut i64 = 0;
        while (ei < cast<i64>(this.enum_layouts.size())) {
            let layout: EnumLayout = this.enum_layouts.at(cast<u64>(ei)).some;
            this.sb.append(layout.llvm_struct_type + " = type { ptr, i32");
            if (layout.has_payload) {
                this.sb.append(", " + layout.payload_llvm_type);
            }
            this.sb.append(" }\n");
            ei = ei + 1;
        }

        // Emit metadata globals for all classes (both ICopy and IRef)
        ci = 0;
        while (ci < cast<i64>(this.class_layouts.size())) {
            let layout: ClassLayout = this.class_layouts.at(cast<u64>(ci)).some;
            if (cast<i64>(layout.interface_vtables.size()) > 0) {
                // Full metadata with vtable and interface_map
                this.emit_full_class_metadata(layout);
            } else {
                // Full metadata format (no interfaces, but consistent struct layout for C runtime)
                let name: string = layout.type_name;
                let name_len: i64 = string_length(name);
                let field_count: i64 = cast<i64>(layout.fields.size());
                this.emit_field_arrays(name, layout.fields);
                this.sb.append("@" + name + "_metadata = private constant { ptr, i32, i32, ptr, ptr, ptr, i32, ptr, ptr } {\n");
                this.sb.append("  ptr @." + name + "_name,\n");
                this.sb.append("  i32 " + cast<string>(layout.sizeof_object) + ",\n");
                this.sb.append("  i32 " + cast<string>(field_count) + ",\n");
                this.sb.append("  ptr @" + name + "_field_offsets,\n");
                this.sb.append("  ptr @" + name + "_field_is_ptr,\n");
                this.sb.append("  ptr null,\n");
                this.sb.append("  i32 0,\n");
                this.sb.append("  ptr null,\n");
                this.sb.append("  ptr null\n");
                this.sb.append("}\n");
                this.sb.append("@." + name + "_name = private unnamed_addr constant [" + cast<string>(name_len + 1) + " x i8] c\"" + name + "\\00\"\n");
            }
            ci = ci + 1;
        }

        // Emit metadata globals for enums — always use full metadata format
        ei = 0;
        while (ei < cast<i64>(this.enum_layouts.size())) {
            let layout: EnumLayout = this.enum_layouts.at(cast<u64>(ei)).some;
            this.emit_full_enum_metadata(layout);
            ei = ei + 1;
        }

        if (cast<i64>(this.class_layouts.size()) > 0 || cast<i64>(this.enum_layouts.size()) > 0) {
            this.sb.append("\n");
        }
    }

    fun emit_full_class_metadata(mut this, layout: ClassLayout) {
        _utils.trace_enter("Enter emit_full_class_metadata(layout=" + layout.to_string() + ")");
        let name: string = layout.type_name;

        // Emit interface ID string constants (deduplicated)
        let ii: mut i64 = 0;
        while (ii < cast<i64>(layout.interface_vtables.size())) {
            let ivt: InterfaceVTable = layout.interface_vtables.at(cast<u64>(ii)).some;
            let iface_name: string = ivt.interface_name;
            if (!this.list_contains(this.emitted_interface_ids, iface_name)) {
                this.emitted_interface_ids.push(iface_name);
                let len: i64 = string_length(iface_name);
                this.sb.append("@." + iface_name + "_interface_id = private unnamed_addr constant [" + cast<string>(len + 1) + " x i8] c\"" + iface_name + "\\00\"\n");
            }
            ii = ii + 1;
        }

        // Emit per-interface vtable arrays
        ii = 0;
        while (ii < cast<i64>(layout.interface_vtables.size())) {
            let ivt: InterfaceVTable = layout.interface_vtables.at(cast<u64>(ii)).some;
            let iface_name: string = ivt.interface_name;
            let method_count: i64 = cast<i64>(ivt.method_ptrs.size());
            if (method_count > 0) {
                this.sb.append("@" + name + "_" + iface_name + "_vtable = private constant [" + cast<string>(method_count) + " x ptr] [");
                let mi: mut i64 = 0;
                while (mi < method_count) {
                    if (mi > 0) { this.sb.append(", "); }
                    this.sb.append("ptr " + ivt.method_ptrs.at(cast<u64>(mi)).some);
                    mi = mi + 1;
                }
                this.sb.append("]\n");
            } else {
                this.sb.append("@" + name + "_" + iface_name + "_vtable = private constant [0 x ptr] zeroinitializer\n");
            }
            ii = ii + 1;
        }

        // Emit interface map (one entry per interface, pointing to its own vtable)
        let iface_count: i64 = cast<i64>(layout.interface_vtables.size());
        this.sb.append("@" + name + "_interface_map = private constant [" + cast<string>(iface_count) + " x { ptr, ptr }] [");
        ii = 0;
        while (ii < iface_count) {
            if (ii > 0) { this.sb.append(", "); }
            let ivt: InterfaceVTable = layout.interface_vtables.at(cast<u64>(ii)).some;
            let iface_name: string = ivt.interface_name;
            this.sb.append("{ ptr, ptr } { ptr @." + iface_name + "_interface_id, ptr @" + name + "_" + iface_name + "_vtable }");
            ii = ii + 1;
        }
        this.sb.append("]\n");

        // Emit field arrays for GC traversal
        this.emit_field_arrays(name, layout.fields);

        // Emit full ClassMetadata
        // struct: { ptr name, i32 instance_size, i32 field_count, ptr field_offsets, ptr field_is_ptr, ptr vtable, i32 interface_count, ptr interface_map, ptr destructor }
        this.sb.append("@" + name + "_metadata = private constant { ptr, i32, i32, ptr, ptr, ptr, i32, ptr, ptr } {\n");
        this.sb.append("  ptr @." + name + "_name,\n");
        this.sb.append("  i32 " + cast<string>(layout.sizeof_object) + ",\n");
        this.sb.append("  i32 " + cast<string>(layout.fields.size()) + ",\n");
        this.sb.append("  ptr @" + name + "_field_offsets,\n");
        this.sb.append("  ptr @" + name + "_field_is_ptr,\n");
        this.sb.append("  ptr null,\n");
        this.sb.append("  i32 " + cast<string>(iface_count) + ",\n");
        this.sb.append("  ptr @" + name + "_interface_map,\n");
        this.sb.append("  ptr null\n");
        this.sb.append("}\n");

        // Emit name string constant
        let name_len: i64 = string_length(name);
        this.sb.append("@." + name + "_name = private unnamed_addr constant [" + cast<string>(name_len + 1) + " x i8] c\"" + name + "\\00\"\n");
    }

    fun emit_field_arrays(mut this, name: string, fields: _utils.List<FieldLayout>) {
        _utils.trace_enter("Enter emit_field_arrays(name=" + cast<string>(name) + ")");
        let field_count: i64 = cast<i64>(fields.size());
        if (field_count == 0) {
            this.sb.append("@" + name + "_field_offsets = private constant [0 x i32] zeroinitializer\n");
            this.sb.append("@" + name + "_field_is_ptr = private constant [0 x i32] zeroinitializer\n");
            return;
        }
        // Emit field_offsets array
        this.sb.append("@" + name + "_field_offsets = private constant [" + cast<string>(field_count) + " x i32] [");
        let fi: mut i64 = 0;
        while (fi < field_count) {
            if (fi > 0) { this.sb.append(", "); }
            let f: FieldLayout = fields.at(cast<u64>(fi)).some;
            this.sb.append("i32 " + cast<string>(f.byte_offset));
            fi = fi + 1;
        }
        this.sb.append("]\n");
        // Emit field_is_ptr array
        this.sb.append("@" + name + "_field_is_ptr = private constant [" + cast<string>(field_count) + " x i32] [");
        fi = 0;
        while (fi < field_count) {
            if (fi > 0) { this.sb.append(", "); }
            let f: FieldLayout = fields.at(cast<u64>(fi)).some;
            let is_ptr: mut string = "0";
            if (f.llvm_type == "ptr") { is_ptr = "1"; }
            this.sb.append("i32 " + is_ptr);
            fi = fi + 1;
        }
        this.sb.append("]\n");
    }

    fun emit_full_enum_metadata(mut this, layout: EnumLayout) {
        _utils.trace_enter("Enter emit_full_enum_metadata(layout=" + layout.to_string() + ")");
        let name: string = layout.type_name;

        // Emit interface ID string constants (deduplicated)
        let ii: mut i64 = 0;
        while (ii < cast<i64>(layout.interface_vtables.size())) {
            let ivt: InterfaceVTable = layout.interface_vtables.at(cast<u64>(ii)).some;
            let iface_name: string = ivt.interface_name;
            if (!this.list_contains(this.emitted_interface_ids, iface_name)) {
                this.emitted_interface_ids.push(iface_name);
                let len: i64 = string_length(iface_name);
                this.sb.append("@." + iface_name + "_interface_id = private unnamed_addr constant [" + cast<string>(len + 1) + " x i8] c\"" + iface_name + "\\00\"\n");
            }
            ii = ii + 1;
        }

        // Emit per-interface vtable arrays
        ii = 0;
        while (ii < cast<i64>(layout.interface_vtables.size())) {
            let ivt: InterfaceVTable = layout.interface_vtables.at(cast<u64>(ii)).some;
            let iface_name: string = ivt.interface_name;
            let method_count: i64 = cast<i64>(ivt.method_ptrs.size());
            if (method_count > 0) {
                this.sb.append("@" + name + "_" + iface_name + "_vtable = private constant [" + cast<string>(method_count) + " x ptr] [");
                let mi: mut i64 = 0;
                while (mi < method_count) {
                    if (mi > 0) { this.sb.append(", "); }
                    this.sb.append("ptr " + ivt.method_ptrs.at(cast<u64>(mi)).some);
                    mi = mi + 1;
                }
                this.sb.append("]\n");
            } else {
                this.sb.append("@" + name + "_" + iface_name + "_vtable = private constant [0 x ptr] zeroinitializer\n");
            }
            ii = ii + 1;
        }

        // Emit interface map
        let iface_count: i64 = cast<i64>(layout.interface_vtables.size());
        this.sb.append("@" + name + "_interface_map = private constant [" + cast<string>(iface_count) + " x { ptr, ptr }] [");
        ii = 0;
        while (ii < iface_count) {
            if (ii > 0) { this.sb.append(", "); }
            let ivt: InterfaceVTable = layout.interface_vtables.at(cast<u64>(ii)).some;
            let iface_name: string = ivt.interface_name;
            this.sb.append("{ ptr, ptr } { ptr @." + iface_name + "_interface_id, ptr @" + name + "_" + iface_name + "_vtable }");
            ii = ii + 1;
        }
        this.sb.append("]\n");

        // Emit full metadata matching PenguinClassMetadata layout:
        // { ptr name, i32 size, i32 field_count, ptr field_offsets, ptr field_is_ptr, ptr vtable, i32 interface_count, ptr interface_map, ptr destructor }
        this.sb.append("@" + name + "_metadata = private constant { ptr, i32, i32, ptr, ptr, ptr, i32, ptr, ptr } {\n");
        this.sb.append("  ptr @." + name + "_name,\n");
        this.sb.append("  i32 0,\n");
        this.sb.append("  i32 0,\n");
        this.sb.append("  ptr null,\n");
        this.sb.append("  ptr null,\n");
        this.sb.append("  ptr null,\n");
        this.sb.append("  i32 " + cast<string>(iface_count) + ",\n");
        this.sb.append("  ptr @" + name + "_interface_map,\n");
        this.sb.append("  ptr null\n");
        this.sb.append("}\n");

        // Emit name string constant
        let name_len: i64 = string_length(name);
        this.sb.append("@." + name + "_name = private unnamed_addr constant [" + cast<string>(name_len + 1) + " x i8] c\"" + name + "\\00\"\n");
    }

    // --- BoundType to LLVM type ---

    fun bound_type_to_llvm_type(this, bt: BoundType) -> string {
        _utils.trace_enter("Enter bound_type_to_llvm_type");
        if (bt.kind is TypeKind.PrimitiveKind) {
            return this.primitive_to_llvm(bt.primitive);
        }
        if (bt.kind is TypeKind.ClassKind) {
            return this.class_type_to_llvm(bt);
        }
        if (bt.kind is TypeKind.EnumKind) {
            let name: string = this.resolve_type_layout_name(bt);
            let found: Option<EnumLayout> = this.find_enum_layout(name);
            if (found.is_some()) {
                return found.some.llvm_struct_type;
            }
            __builtin.eprintln("error[E_INTERNAL]: Enum layout not found in bound_type_to_llvm_type"); __builtin.exit(1);
            return "i64";
        }
        if (bt.kind is TypeKind.InterfaceKind) {
            __builtin.eprintln("error[E_INTERNAL]: Class layout not found in class_type_to_llvm"); __builtin.exit(1);
        return "ptr";
        }
        return "ptr";
    }

    fun resolve_type_layout_name(this, bt: BoundType) -> string {
        _utils.trace_enter("Enter resolve_type_layout_name");
        if (bt.type_definition.is_some()) {
            let def: BoundDefinition = bt.type_definition.some;
            if (def is BoundDefinition.class_def) {
                let cls: BoundClassDefinition = def.class_def;
                if (cast<i64>(bt.generic_args.size()) > 0 && cast<i64>(cls.generic_params.size()) > 0) {
                    return this.compute_mangled_name(cls.name, bt);
                }
                return this.strip_global_prefix(cls.full_name);
            }
            if (def is BoundDefinition.enum_def) {
                let e: BoundEnumDefinition = def.enum_def;
                if (cast<i64>(bt.generic_args.size()) > 0 && cast<i64>(e.generic_params.size()) > 0) {
                    return this.compute_mangled_name(e.name, bt);
                }
                return this.strip_global_prefix(e.full_name);
            }
        }
        return bt.display_name();
    }

    fun compute_mangled_name(this, base_name: string, bt: BoundType) -> string {
        _utils.trace_enter("Enter compute_mangled_name(base_name=" + cast<string>(base_name) + ")");
        let sb2: mut StringBuilder = new StringBuilder();
        sb2.append(base_name);
        let i: mut i64 = 0;
        while (i < cast<i64>(bt.generic_args.size())) {
            sb2.append("__");
            let arg: BoundType = bt.generic_args.at(cast<u64>(i)).some;
            let arg_name: string = arg.display_name();
            let sanitized: mut StringBuilder = new StringBuilder();
            let j: mut i64 = 0;
            while (j < string_length(arg_name)) {
                let ch: string = string_char_at(arg_name, j);
                if (ch == " " || ch == "<" || ch == ">" || ch == ",") {
                    sanitized.append("_");
                } else {
                    sanitized.append(ch);
                }
                j = j + 1;
            }
            sb2.append(sanitized.to_string());
            i = i + 1;
        }
        return sb2.to_string();
    }

    fun class_type_to_llvm(this, bt: BoundType) -> string {
        _utils.trace_enter("Enter class_type_to_llvm");
        let name: string = this.resolve_type_layout_name(bt);
        let found: Option<ClassLayout> = this.find_class_layout(name);
        if (found.is_some()) {
            if (found.some.is_value_type) {
                return found.some.llvm_struct_type;
            } else {
                return "ptr";
            }
        }
        return "ptr";
    }

    fun primitive_to_llvm(this, p: PrimitiveType) -> string {
        _utils.trace_enter("Enter primitive_to_llvm");
        if (p is PrimitiveType.I8) { return "i8"; }
        if (p is PrimitiveType.I16) { return "i16"; }
        if (p is PrimitiveType.I32) { return "i32"; }
        if (p is PrimitiveType.I64) { return "i64"; }
        if (p is PrimitiveType.U8) { return "i8"; }
        if (p is PrimitiveType.U16) { return "i16"; }
        if (p is PrimitiveType.U32) { return "i32"; }
        if (p is PrimitiveType.U64) { return "i64"; }
        if (p is PrimitiveType.F32) { return "float"; }
        if (p is PrimitiveType.F64) { return "double"; }
        if (p is PrimitiveType.BoolType) { return "i8"; }
        if (p is PrimitiveType.CharType) { return "i32"; }
        if (p is PrimitiveType.StringType) { return "ptr"; }
        if (p is PrimitiveType.VoidType) { return "void"; }
        return "ptr";
    }

    // --- Type size/align helpers ---

    fun llvm_type_size(this, llvm_type: string) -> i64 {
        _utils.trace_enter("Enter llvm_type_size(llvm_type=" + cast<string>(llvm_type) + ")");
        if (llvm_type == "i8") { return 1; }
        if (llvm_type == "i16") { return 2; }
        if (llvm_type == "i32") { return 4; }
        if (llvm_type == "i64") { return 8; }
        if (llvm_type == "float") { return 4; }
        if (llvm_type == "double") { return 8; }
        if (llvm_type == "ptr") { return 8; }
        // Check class layouts for value-type struct sizes
        if (this.string_starts_with(llvm_type, "%class.")) {
            let name: string = string_substring(llvm_type, 7, string_length(llvm_type) - 7);
            let found: Option<ClassLayout> = this.find_class_layout(name);
            if (found.is_some()) { return found.some.sizeof_object; }
        }
        if (this.string_starts_with(llvm_type, "%enum.")) {
            let name: string = string_substring(llvm_type, 6, string_length(llvm_type) - 6);
            let found_enum: Option<EnumLayout> = this.find_enum_layout(name);
            if (found_enum.is_some()) {
                // Enum struct = { ptr metadata, i32 tag, payload? }
                // metadata ptr: 8 bytes, tag i32: 4 bytes, padding: 4 bytes, payload: variable
                let base_size: i64 = 16; // ptr(8) + i32(4) + padding(4)
                if (found_enum.some.has_payload) {
                    if (string_length(found_enum.some.payload_llvm_type) > 0) {
                        let payload_size: i64 = this.llvm_type_size(found_enum.some.payload_llvm_type);
                        let payload_align: i64 = this.llvm_type_align(found_enum.some.payload_llvm_type);
                        let aligned_base: i64 = this.align_up(base_size, payload_align);
                        return aligned_base + payload_size;
                    }
                }
                return base_size;
            }
        }
        return 8;
    }

    fun llvm_type_align(this, llvm_type: string) -> i64 {
        _utils.trace_enter("Enter llvm_type_align(llvm_type=" + cast<string>(llvm_type) + ")");
        if (llvm_type == "i8") { return 1; }
        if (llvm_type == "i16") { return 2; }
        if (llvm_type == "i32") { return 4; }
        if (llvm_type == "i64") { return 8; }
        if (llvm_type == "float") { return 4; }
        if (llvm_type == "double") { return 8; }
        if (llvm_type == "ptr") { return 8; }
        // Struct types have 8-byte alignment
        if (this.string_starts_with(llvm_type, "%class.") || this.string_starts_with(llvm_type, "%enum.")) {
            return 8;
        }
        return 8;
    }

    fun align_up(this, offset: i64, alignment: i64) -> i64 {
        _utils.trace_enter("Enter align_up(offset=" + cast<string>(offset) + ", alignment=" + cast<string>(alignment) + ")");
        if (alignment <= 1) { return offset; }
        let remainder: i64 = offset % alignment;
        if (remainder == 0) { return offset; }
        return offset + alignment - remainder;
    }

    // --- DWARF debug type cache ---

    fun debug_type_cache_get(this, key: string) -> string {
        _utils.trace_enter("Enter debug_type_cache_get(key=" + cast<string>(key) + ")");
        let i: mut i64 = cast<i64>(this.debug_type_cache.size()) - 1;
        while (i >= 0) {
            if (this.debug_type_cache.at(cast<u64>(i)).some.ir_name == key) {
                return this.debug_type_cache.at(cast<u64>(i)).some.llvm_value;
            }
            i = i - 1;
        }
        return "";
    }

    fun debug_type_cache_set(mut this, key: string, id: string) {
        _utils.trace_enter("Enter debug_type_cache_set(key=" + cast<string>(key) + ", id=" + cast<string>(id) + ")");
        this.debug_type_cache.push(new RegMapping(key, id));
    }

    // Build (or fetch cached) a !DIBasicType and return its metadata id.
    fun make_debug_basic_type(mut this, key: string, name: string, size_bits: i64, align_bits: i64, encoding: string) -> string {
        _utils.trace_enter("Enter make_debug_basic_type(key=" + cast<string>(key) + ", name=" + cast<string>(name) + ", size_bits=" + cast<string>(size_bits) + ", align_bits=" + cast<string>(align_bits) + ", encoding=" + cast<string>(encoding) + ")");
        let cached: string = this.debug_type_cache_get(key);
        if (cached != "") { return cached; }
        let id: string = this.next_debug_id();
        this.debug_type_cache_set(key, id);
        this.debug_metadata.push("!" + id + " = !DIBasicType(name: \"" + name + "\", size: " + cast<string>(size_bits) + ", align: " + cast<string>(align_bits) + ", encoding: " + encoding + ")");
        return id;
    }

    // Map a bound PrimitiveType to its IR-type string (for debug type lookup).
    fun primitive_to_debug_ir(this, p: PrimitiveType) -> string {
        _utils.trace_enter("Enter primitive_to_debug_ir");
        if (p is PrimitiveType.BoolType) { return "bool"; }
        if (p is PrimitiveType.I8) { return "i8"; }
        if (p is PrimitiveType.I16) { return "i16"; }
        if (p is PrimitiveType.I32) { return "i32"; }
        if (p is PrimitiveType.I64) { return "i64"; }
        if (p is PrimitiveType.U8) { return "u8"; }
        if (p is PrimitiveType.U16) { return "u16"; }
        if (p is PrimitiveType.U32) { return "u32"; }
        if (p is PrimitiveType.U64) { return "u64"; }
        if (p is PrimitiveType.F32) { return "f32"; }
        if (p is PrimitiveType.F64) { return "f64"; }
        if (p is PrimitiveType.CharType) { return "char"; }
        if (p is PrimitiveType.StringType) { return "ref<string>"; }
        if (p is PrimitiveType.VoidType) { return "void"; }
        return "ptr";
    }

    // Map a BoundType to an IR-type string for debug purposes (reuses layout name resolution for generics).
    fun bound_type_to_debug_ir(this, bt: BoundType) -> string {
        _utils.trace_enter("Enter bound_type_to_debug_ir");
        if (bt.kind is TypeKind.PrimitiveKind) {
            return this.primitive_to_debug_ir(bt.primitive);
        }
        if (bt.kind is TypeKind.ClassKind) {
            return "ref<" + this.resolve_type_layout_name(bt) + ">";
        }
        if (bt.kind is TypeKind.EnumKind) {
            return "enum<" + this.resolve_type_layout_name(bt) + ">";
        }
        return "ptr";
    }

    // Normalize an LLVM type string to an IR-type-ish key for debug lookup.
    fun llvm_type_to_debug_ir(this, lt: string) -> string {
        _utils.trace_enter("Enter llvm_type_to_debug_ir(lt=" + cast<string>(lt) + ")");
        if (lt == "float") { return "f32"; }
        if (lt == "double") { return "f64"; }
        return lt;
    }

    // Build a `!{...}` elements metadata node from a list of member ids; returns the list node id.
    fun debug_make_elements_list(mut this, member_ids: _utils.List<string>) -> string {
        _utils.trace_enter("Enter debug_make_elements_list");
        let id: string = this.next_debug_id();
        let s: mut string = "!" + id + " = !{";
        let first: mut bool = true;
        let i: mut i64 = 0;
        while (i < cast<i64>(member_ids.size())) {
            if (!first) { s = s + ", "; }
            first = false;
            s = s + "!" + member_ids.at(cast<u64>(i)).some;
            i = i + 1;
        }
        s = s + "}";
        this.debug_metadata.push(s);
        return id;
    }

    // Main entry: get (creating if needed) the DWARF type metadata id for an IR type.
    fun get_debug_type(mut this, ir_type: string) -> string {
        _utils.trace_enter("Enter get_debug_type(ir_type=" + cast<string>(ir_type) + ")");
        if (!this.debug_enabled) { return ""; }
        let cached: string = this.debug_type_cache_get(ir_type);
        if (cached != "") { return cached; }

        // Primitives → DIBasicType
        if (ir_type == "i8") { return this.make_debug_basic_type("i8", "i8", 8, 8, "DW_ATE_signed"); }
        if (ir_type == "i16") { return this.make_debug_basic_type("i16", "i16", 16, 16, "DW_ATE_signed"); }
        if (ir_type == "i32") { return this.make_debug_basic_type("i32", "i32", 32, 32, "DW_ATE_signed"); }
        if (ir_type == "i64") { return this.make_debug_basic_type("i64", "i64", 64, 64, "DW_ATE_signed"); }
        if (ir_type == "u8") { return this.make_debug_basic_type("u8", "u8", 8, 8, "DW_ATE_unsigned"); }
        if (ir_type == "u16") { return this.make_debug_basic_type("u16", "u16", 16, 16, "DW_ATE_unsigned"); }
        if (ir_type == "u32") { return this.make_debug_basic_type("u32", "u32", 32, 32, "DW_ATE_unsigned"); }
        if (ir_type == "u64") { return this.make_debug_basic_type("u64", "u64", 64, 64, "DW_ATE_unsigned"); }
        if (ir_type == "f32") { return this.make_debug_basic_type("f32", "float", 32, 32, "DW_ATE_float"); }
        if (ir_type == "f64") { return this.make_debug_basic_type("f64", "double", 64, 64, "DW_ATE_float"); }
        if (ir_type == "bool") { return this.make_debug_basic_type("bool", "bool", 8, 8, "DW_ATE_boolean"); }
        if (ir_type == "char") { return this.make_debug_basic_type("char", "char", 32, 32, "DW_ATE_unsigned"); }

        // ref<string> → char* (GDB prints the C string)
        if (ir_type == "ref<string>") {
            let char_id: string = this.make_debug_basic_type("c_char", "char", 8, 8, "DW_ATE_signed");
            let id: string = this.next_debug_id();
            this.debug_type_cache_set(ir_type, id);
            this.debug_metadata.push("!" + id + " = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: !" + char_id + ", size: 64, align: 64)");
            return id;
        }

        // ref<Name> → pointer to DICompositeType(Name)
        if (this.string_starts_with(ir_type, "ref<")) {
            let name: string = this.extract_type_name(ir_type);
            let id: string = this.next_debug_id();
            this.debug_type_cache_set(ir_type, id);  // reserve before building composite (recursion-safe)
            let comp_id: string = this.get_debug_composite(name);
            if (comp_id != "") {
                this.debug_metadata.push("!" + id + " = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: !" + comp_id + ", size: 64, align: 64)");
            } else {
                this.debug_metadata.push("!" + id + " = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: null, size: 64, align: 64)");
            }
            return id;
        }

        // enum<Name> → enum struct composite (struct { metadata, tag, payload })
        if (this.string_starts_with(ir_type, "enum<")) {
            let name: string = this.extract_type_name(ir_type);
            let comp_id: string = this.get_debug_enum_type(name);
            if (comp_id != "") { return comp_id; }
        }

        // ptr, funptr, void, unknown → opaque pointer
        let id: string = this.next_debug_id();
        this.debug_type_cache_set(ir_type, id);
        this.debug_metadata.push("!" + id + " = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: null, size: 64, align: 64)");
        return id;
    }

    // Build a DICompositeType (struct) for a class from its ClassLayout. Reserve-before-build for recursion.
    fun get_debug_composite(mut this, name: string) -> string {
        _utils.trace_enter("Enter get_debug_composite(name=" + cast<string>(name) + ")");
        let cache_key: string = "composite:" + name;
        let cached: string = this.debug_type_cache_get(cache_key);
        if (cached != "") { return cached; }
        let found: Option<ClassLayout> = this.find_class_layout(name);
        if (found.is_none()) { return ""; }
        let layout: ClassLayout = found.some;
        let id: string = this.next_debug_id();
        this.debug_type_cache_set(cache_key, id);  // reserve before building members (recursion-safe)

        let member_ids: mut _utils.List<string> = new _utils.List<string>();
        let fi: mut i64 = 0;
        while (fi < cast<i64>(layout.fields.size())) {
            let f: FieldLayout = layout.fields.at(cast<u64>(fi)).some;
            let field_ir_type: mut string = "ptr";
            if (f.bound_type.is_some()) {
                field_ir_type = this.bound_type_to_debug_ir(f.bound_type.some);
            } else {
                field_ir_type = this.llvm_type_to_debug_ir(f.llvm_type);
            }
            let field_type_id: string = this.get_debug_type(field_ir_type);
            let field_size: i64 = this.llvm_type_size(f.llvm_type);
            let member_id: string = this.next_debug_id();
            this.debug_metadata.push("!" + member_id + " = !DIDerivedType(tag: DW_TAG_member, name: \"" + f.field_name + "\", scope: !" + id + ", baseType: !" + field_type_id + ", size: " + cast<string>(field_size * 8) + ", offset: " + cast<string>(f.byte_offset * 8) + ")");
            member_ids.push(member_id);
            fi = fi + 1;
        }
        let elems_id: string = this.debug_make_elements_list(member_ids);
        let size_bits: i64 = layout.sizeof_object * 8;
        this.debug_metadata.push("!" + id + " = !DICompositeType(tag: DW_TAG_structure_type, name: \"" + name + "\", file: !" + this.current_file_id + ", size: " + cast<string>(size_bits) + ", elements: !" + elems_id + ", identifier: \"" + name + "\")");
        return id;
    }

    // Build a DICompositeType (struct) for an enum: { ptr metadata, i32 tag, payload? }.
    fun get_debug_enum_type(mut this, name: string) -> string {
        _utils.trace_enter("Enter get_debug_enum_type(name=" + cast<string>(name) + ")");
        let cache_key: string = "enumstruct:" + name;
        let cached: string = this.debug_type_cache_get(cache_key);
        if (cached != "") { return cached; }
        let found: Option<EnumLayout> = this.find_enum_layout(name);
        if (found.is_none()) { return ""; }
        let layout: EnumLayout = found.some;
        let id: string = this.next_debug_id();
        this.debug_type_cache_set(cache_key, id);

        let member_ids: mut _utils.List<string> = new _utils.List<string>();
        let tag_type_id: string = this.get_debug_type("i32");
        let tag_member: string = this.next_debug_id();
        this.debug_metadata.push("!" + tag_member + " = !DIDerivedType(tag: DW_TAG_member, name: \"tag\", scope: !" + id + ", baseType: !" + tag_type_id + ", size: 32, offset: 64)");
        member_ids.push(tag_member);
        if (layout.has_payload) {
            if (string_length(layout.payload_llvm_type) > 0) {
                let payload_ir: string = this.llvm_type_to_debug_ir(layout.payload_llvm_type);
                let payload_type_id: string = this.get_debug_type(payload_ir);
                let payload_align: i64 = this.llvm_type_align(layout.payload_llvm_type);
                let payload_offset: i64 = this.align_up(16, payload_align);
                let payload_size: i64 = this.llvm_type_size(layout.payload_llvm_type);
                let payload_member: string = this.next_debug_id();
                this.debug_metadata.push("!" + payload_member + " = !DIDerivedType(tag: DW_TAG_member, name: \"payload\", scope: !" + id + ", baseType: !" + payload_type_id + ", size: " + cast<string>(payload_size * 8) + ", offset: " + cast<string>(payload_offset * 8) + ")");
                member_ids.push(payload_member);
            }
        }
        let elems_id: string = this.debug_make_elements_list(member_ids);
        let size_bits: i64 = this.llvm_type_size(layout.llvm_struct_type) * 8;
        this.debug_metadata.push("!" + id + " = !DICompositeType(tag: DW_TAG_structure_type, name: \"" + name + "\", file: !" + this.current_file_id + ", size: " + cast<string>(size_bits) + ", elements: !" + elems_id + ", identifier: \"" + name + "\")");
        return id;
    }

    fun find_class_field_layout(this, type_name: string, field_name: string) -> Option<FieldLayout> {
        _utils.trace_enter("Enter find_class_field_layout(type_name=" + cast<string>(type_name) + ", field_name=" + cast<string>(field_name) + ")");
        let found: Option<ClassLayout> = this.find_class_layout(type_name);
        if (found.is_none()) { return new Option<FieldLayout>.none(); }
        let layout: ClassLayout = found.some;
        let fi: mut i64 = 0;
        while (fi < cast<i64>(layout.fields.size())) {
            let f: FieldLayout = layout.fields.at(cast<u64>(fi)).some;
            if (f.field_name == field_name) {
                return new Option<FieldLayout>.some(f);
            }
            fi = fi + 1;
        }
        return new Option<FieldLayout>.none();
    }

    // --- Instruction lowering ---

    // Get source location from an IR instruction
    fun get_inst_loc(inst: IRInstruction) -> SourceLocation {
        _utils.trace_enter("Enter get_inst_loc");
        if (inst is IRInstruction.const_inst) { return inst.const_inst.location; }
        if (inst is IRInstruction.arg) { return inst.arg.location; }
        if (inst is IRInstruction.assign) { return inst.assign.location; }
        if (inst is IRInstruction.cast_inst) { return inst.cast_inst.location; }
        if (inst is IRInstruction.binop) { return inst.binop.location; }
        if (inst is IRInstruction.unaryop) { return inst.unaryop.location; }
        if (inst is IRInstruction.rdmbr) { return inst.rdmbr.location; }
        if (inst is IRInstruction.wrmbr) { return inst.wrmbr.location; }
        if (inst is IRInstruction.br) { return inst.br.location; }
        if (inst is IRInstruction.br_cond) { return inst.br_cond.location; }
        if (inst is IRInstruction.ret) { return inst.ret.location; }
        if (inst is IRInstruction.ret_void) { return inst.ret_void.location; }
        if (inst is IRInstruction.call) { return inst.call.location; }
        if (inst is IRInstruction.call_void) { return inst.call_void.location; }
        if (inst is IRInstruction.call_virt) { return inst.call_virt.location; }
        if (inst is IRInstruction.new_inst) { return inst.new_inst.location; }
        if (inst is IRInstruction.new_enum) { return inst.new_enum.location; }
        if (inst is IRInstruction.isenum) { return inst.isenum.location; }
        if (inst is IRInstruction.rdenum) { return inst.rdenum.location; }
        if (inst is IRInstruction.isinstance) { return inst.isinstance.location; }
        if (inst is IRInstruction.box) { return inst.box.location; }
        if (inst is IRInstruction.unbox) { return inst.unbox.location; }
        if (inst is IRInstruction.global_load) { return inst.global_load.location; }
        if (inst is IRInstruction.global_store) { return inst.global_store.location; }
        return new SourceLocation("", 0, 0);
    }

    // Emit an instruction line with debug info suffix
    fun emit_line(mut this, line: string) {
        _utils.trace_enter("Enter emit_line(line=" + cast<string>(line) + ")");
        this.sb.append(line + this.current_dbg + "\n");
    }

    fun emit_instruction(mut this, inst: IRInstruction) {
        _utils.trace_enter("Enter emit_instruction");
        // Set current debug location from instruction
        let loc: SourceLocation = get_inst_loc(inst);
        this.current_dbg = this.debug_loc(loc);
        // Skip debug for labels
        if (inst is IRInstruction.label_inst) { this.current_dbg = ""; this.emit_label(inst.label_inst); return; }
        if (inst is IRInstruction.const_inst) { this.emit_const(inst.const_inst); this.maybe_emit_imm_dbg(inst.const_inst.result, this.current_dbg); return; }
        if (inst is IRInstruction.arg) { this.emit_arg(inst.arg); return; }
        if (inst is IRInstruction.assign) { this.emit_assign(inst.assign); this.maybe_emit_imm_dbg(inst.assign.dest, this.current_dbg); return; }
        if (inst is IRInstruction.cast_inst) { this.emit_cast(inst.cast_inst); return; }
        if (inst is IRInstruction.binop) { this.emit_binop(inst.binop); return; }
        if (inst is IRInstruction.unaryop) { this.emit_unaryop(inst.unaryop); return; }
        if (inst is IRInstruction.rdmbr) { this.emit_rdmbr(inst.rdmbr); return; }
        if (inst is IRInstruction.wrmbr) { this.emit_wrmbr(inst.wrmbr); return; }
        if (inst is IRInstruction.br) { this.emit_br(inst.br); return; }
        if (inst is IRInstruction.br_cond) { this.emit_br_cond(inst.br_cond); return; }
        if (inst is IRInstruction.ret) { this.emit_ret(inst.ret); return; }
        if (inst is IRInstruction.ret_void) { this.emit_ret_void(); return; }
        if (inst is IRInstruction.call) { this.emit_call(inst.call); return; }
        if (inst is IRInstruction.call_void) { this.emit_call_void(inst.call_void); return; }
        if (inst is IRInstruction.call_virt) { this.emit_call_virt(inst.call_virt); return; }
        if (inst is IRInstruction.new_inst) { this.emit_new(inst.new_inst); return; }
        if (inst is IRInstruction.new_enum) { this.emit_new_enum(inst.new_enum); return; }
        if (inst is IRInstruction.isenum) { this.emit_isenum(inst.isenum); return; }
        if (inst is IRInstruction.rdenum) { this.emit_rdenum(inst.rdenum); return; }
        if (inst is IRInstruction.isinstance) { this.emit_isinstance(inst.isinstance); return; }
        if (inst is IRInstruction.box) { this.emit_box(inst.box); return; }
        if (inst is IRInstruction.unbox) { this.emit_unbox(inst.unbox); return; }
        if (inst is IRInstruction.global_load) { this.emit_global_load(inst.global_load); return; }
        if (inst is IRInstruction.global_store) { this.emit_global_store(inst.global_store); return; }
    }

    fun emit_const(mut this, inst: IRConst) {
        _utils.trace_enter("Enter emit_const(inst=" + inst.display() + ")");
        let ir_type: string = inst.result.get_ir_type();
        let result_name: string = inst.result.display();
        // void has no LLVM value; skip emission entirely to avoid
        // generating invalid IR like "add void 0, void"
        if (ir_type == "void") { return; }
        if (this.is_string_type(ir_type)) {
            let stripped: string = this.strip_string_quotes(inst.value);
            let found: Option<StringLitEntry> = this.find_string_lit(stripped);
            if (found.is_some()) {
                if (this.is_mutable_reg(result_name)) {
                    let alloca_name: string = this.get_alloca_name(result_name);
                    this.emit_line("  store ptr " + found.some.global_name() + ", ptr " + alloca_name);
                } else {
                    this.reg_map.push(new RegMapping(result_name, found.some.global_name()));
                }
            }
            return;
        }
        if (this.is_bool_type(ir_type)) {
            let val: mut string = "0";
            if (inst.value == "true") { val = "1"; }
            if (this.is_mutable_reg(result_name)) {
                let alloca_name: string = this.get_alloca_name(result_name);
                this.emit_line("  store i8 " + val + ", ptr " + alloca_name);
            } else {
                this.emit_line("  " + result_name + " = add i8 0, " + val);
            }
            this.register_llvm_type(result_name, "i8");
            return;
        }
        if (this.is_int_type(ir_type)) {
            let llvm_type: string = this.ir_type_to_llvm(ir_type);
            // Coerce the value register if its type differs from the result type
            // (e.g. an i64 constant being assigned to an i16 variable)
            let coerced: string = this.coerce_operand(inst.value, llvm_type);
            if (this.is_mutable_reg(result_name)) {
                let alloca_name: string = this.get_alloca_name(result_name);
                this.emit_line("  store " + llvm_type + " " + coerced + ", ptr " + alloca_name);
            } else {
                this.emit_line("  " + result_name + " = add " + llvm_type + " 0, " + coerced);
            }
            this.register_llvm_type(result_name, llvm_type);
            return;
        }
        // fallback
        let llvm_type: string = this.ir_type_to_llvm(ir_type);
        if (this.is_mutable_reg(result_name)) {
            let alloca_name: string = this.get_alloca_name(result_name);
            this.emit_line("  store " + llvm_type + " " + inst.value + ", ptr " + alloca_name);
        } else if (this.string_starts_with(llvm_type, "%enum.")) {
            // Enum struct values cannot use add; map directly
            this.reg_map.push(new RegMapping(result_name, inst.value));
        } else {
            this.emit_line("  " + result_name + " = add " + llvm_type + " 0, " + inst.value);
        }
        this.register_llvm_type(result_name, llvm_type);
    }

    fun emit_arg(mut this, inst: IRArg) {
        _utils.trace_enter("Enter emit_arg(inst=" + inst.display() + ")");
        let result_name: string = inst.result.display();
        let param_name: string = "%" + inst.param_name;
        this.reg_map.push(new RegMapping(result_name, param_name));
        let llvm_type: string = this.ir_type_to_llvm(inst.result.get_ir_type());
        // For byval aggregate parameters (>16 bytes), the LLVM IR parameter is a
        // pointer; register it as "ptr" so coerce_operand / materialize_enum_ptr
        // emit proper ptr->struct loads.
        if (this.llvm_type_size(llvm_type) > 16) {
            this.register_llvm_type(param_name, "ptr");
        } else if (llvm_type != "") {
            this.register_llvm_type(param_name, llvm_type);
        }
    }

    fun emit_assign(mut this, inst: IRAssign) {
        _utils.trace_enter("Enter emit_assign(inst=" + inst.display() + ")");
        let dest_name: string = inst.dest.display();
        let src_resolved: string = this.resolve_value(inst.src);
        let ir_type: string = inst.dest.get_ir_type();
        let llvm_type: string = this.ir_type_to_llvm(ir_type);
        // Skip void/unknown assignments (can occur from VM enum variant check issues)
        if (llvm_type == "void" || src_resolved == "unknown") {
            this.emit_line("  ; skipped void/unknown assign to " + dest_name);
            return;
        }
        if (this.is_mutable_reg(dest_name)) {
            // Mutable: store to alloca slot
            let alloca_name: string = this.get_alloca_name(dest_name);
            let coerced: string = this.coerce_operand(src_resolved, llvm_type);
            this.emit_line("  store " + llvm_type + " " + coerced + ", ptr " + alloca_name);
        } else if (llvm_type == "ptr") {
            // pointer assignment: map dest to source directly
            this.reg_map.push(new RegMapping(dest_name, src_resolved));
        } else if (this.string_starts_with(llvm_type, "%enum.")) {
            // enum struct assignment: coerce ptr->struct if needed, then map
            let coerced: string = this.coerce_operand(src_resolved, llvm_type);
            this.reg_map.push(new RegMapping(dest_name, coerced));
        } else {
            let coerced: string = this.coerce_operand(src_resolved, llvm_type);
            this.emit_line("  " + dest_name + " = add " + llvm_type + " 0, " + coerced);
        }
        this.register_llvm_type(dest_name, llvm_type);
    }

    fun emit_cast(mut this, inst: IRCast) {
        _utils.trace_enter("Enter emit_cast(inst=" + inst.display() + ")");
        let result_name: string = inst.result.display();
        let operand_resolved: mut string = this.resolve_value(inst.operand);
        let from_ir_type: string = inst.from_type;
        // When the IR source type is void (e.g. from RDENUM whose payload_type
        // was not resolved), fall back to the operand's registered LLVM type.
        let from_llvm: string = if (from_ir_type == "void") {
            let reg_type: string = this.get_llvm_type(operand_resolved);
            if (reg_type != "" && reg_type != "void") { reg_type } else { this.ir_type_to_llvm(from_ir_type) }
        } else {
            this.ir_type_to_llvm(from_ir_type)
        };
        let to_llvm: string = this.ir_type_to_llvm(inst.to_type);

        // If operand is an icmp result (i1) and target is string, use bool_to_string
        if (this.is_string_type(inst.to_type) && this.is_icmp_value(operand_resolved)) {
            this.needs_bool_to_string = true;
            this.emit_line("  " + result_name + " = call ptr @_emperor_bool_to_string(i1 " + operand_resolved + ")");
            return;
        }

        // If operand is an icmp result (i1) but from_llvm expects wider type, zext first
        if (this.is_icmp_value(operand_resolved) && from_llvm != "i1") {
            let zext_tmp: string = this.next_tmp();
            this.emit_line("  " + zext_tmp + " = zext i1 " + operand_resolved + " to " + from_llvm);
            operand_resolved = zext_tmp;
        }

        // int → string: call runtime. When inst.from_type is void (from RDENUM),
        // use the resolved from_llvm type to detect the actual integer type.
        let effective_from: string = if (inst.from_type == "void" && this.is_int_type(from_llvm)) {
            from_llvm
        } else {
            inst.from_type
        };
        if (this.is_string_type(inst.to_type) && this.is_int_type(effective_from)) {
            this.needs_int_to_string = true;
            if (effective_from == "i64") {
                this.emit_line("  " + result_name + " = call ptr @_emperor_i64_to_string(" + from_llvm + " " + operand_resolved + ")");
            } else if (effective_from == "i8" || effective_from == "i16") {
                // Signed i8/i16 must be sign-extended to i32 before calling
                // _emperor_int_to_string(i32); otherwise LLVM zero-extends,
                // turning negative values into large positive integers.
                let sext_tmp: string = this.next_tmp();
                this.emit_line("  " + sext_tmp + " = sext " + from_llvm + " " + operand_resolved + " to i32");
                this.emit_line("  " + result_name + " = call ptr @_emperor_int_to_string(i32 " + sext_tmp + ")");
            } else {
                this.emit_line("  " + result_name + " = call ptr @_emperor_int_to_string(" + from_llvm + " " + operand_resolved + ")");
            }
            return;
        }

        // bool → string: call runtime
        if (this.is_string_type(inst.to_type) && this.is_bool_type(inst.from_type)) {
            this.needs_bool_to_string = true;
            this.emit_line("  " + result_name + " = call ptr @_emperor_bool_to_string(i8 " + operand_resolved + ")");
            return;
        }

        // enum → string: extract tag index, convert to string
        if (this.is_string_type(inst.to_type) && this.is_enum_type(inst.from_type)) {
            this.needs_int_to_string = true;            
            // operand_resolved may be a ptr (from NEW_ENUM registered as ptr);
            // coerce it to the struct value before extractvalue.
            let coerced_operand: string = this.coerce_operand(operand_resolved, from_llvm);
            
            let tag_tmp: string = this.next_tmp();
            this.emit_line("  " + tag_tmp + " = extractvalue " + from_llvm + " " + coerced_operand + ", 1");
            this.emit_line("  " + result_name + " = call ptr @_emperor_int_to_string(i32 " + tag_tmp + ")");
            return;
        }

        let cast_op: string = this.cast_op(from_llvm, to_llvm);
        if (from_llvm == to_llvm) {
            if (from_llvm == "ptr") {
                this.emit_line("  " + result_name + " = getelementptr i8, ptr " + operand_resolved + ", i64 0");
            } else {
                this.emit_line("  " + result_name + " = add " + to_llvm + " 0, " + operand_resolved);
            }
            return;
        }
        this.emit_line("  " + result_name + " = " + cast_op + " " + from_llvm + " " + operand_resolved + " to " + to_llvm);
    }

    fun emit_binop(mut this, inst: IRBinOp) {
        _utils.trace_enter("Enter emit_binop(inst=" + inst.display() + ")");
        let result_name: string = inst.result.display();
        let left_resolved: string = this.resolve_value(inst.left);
        let right_resolved: string = this.resolve_value(inst.right);
        let llvm_type: string = this.ir_type_to_llvm(inst.ir_type);

        // String concatenation: BINOP add with ref<string> type
        if (inst.op == "add" && this.is_string_type(inst.ir_type)) {
            this.needs_string_concat = true;
            this.emit_line("  " + result_name + " = call ptr @_emperor_string_concat(ptr " + left_resolved + ", ptr " + right_resolved + ")");
            return;
        }

        // Comparison operators: use operand types for the comparison, result is i1
        if (this.is_comparison_binop(inst.op)) {
            // Strings must be compared by content, not by char* pointer value
            // (every literal is a distinct global and every substring/concat is a
            // fresh GC allocation, so `icmp eq ptr` is almost always false for
            // equal text — e.g. the lexer's keyword match). Route eq/ne on
            // ref<string> through a runtime strcmp-based helper.
            if (inst.op == "eq" || inst.op == "ne") {
                if (this.is_string_type(inst.left.get_ir_type()) || this.is_string_type(inst.right.get_ir_type())) {
                    this.needs_string_equal = true;
                    let eq_tmp: string = this.next_tmp();
                    this.emit_line("  " + eq_tmp + " = call i32 @_emperor_string_equal(ptr " + left_resolved + ", ptr " + right_resolved + ")");
                    if (inst.op == "eq") {
                        this.emit_line("  " + result_name + " = icmp ne i32 " + eq_tmp + ", 0");
                    } else {
                        this.emit_line("  " + result_name + " = icmp eq i32 " + eq_tmp + ", 0");
                    }
                    this.icmp_results.push(result_name);
                    this.register_llvm_type(result_name, "i1");
                    return;
                }
            }
            let operand_llvm_type: string = this.ir_type_to_llvm(inst.left.get_ir_type());
            let coerced_left: string = this.coerce_operand(left_resolved, operand_llvm_type);
            let coerced_right: string = this.coerce_operand(right_resolved, operand_llvm_type);
            let llvm_op: string = this.binop_to_llvm(inst.op, inst.left.get_ir_type());
            this.emit_line("  " + result_name + " = " + llvm_op + " " + operand_llvm_type + " " + coerced_left + ", " + coerced_right);
            this.icmp_results.push(result_name);
            this.register_llvm_type(result_name, "i1");
            return;
        }

        // Coerce operands to expected LLVM type
        let coerced_left: string = this.coerce_operand(left_resolved, llvm_type);
        let coerced_right: string = this.coerce_operand(right_resolved, llvm_type);

        let llvm_op: string = this.binop_to_llvm(inst.op, inst.ir_type);
        this.emit_line("  " + result_name + " = " + llvm_op + " " + llvm_type + " " + coerced_left + ", " + coerced_right);
        this.register_llvm_type(result_name, llvm_type);
    }

    fun is_comparison_binop(this, op: string) -> bool {
        _utils.trace_enter("Enter is_comparison_binop(op=" + cast<string>(op) + ")");
        if (op == "eq") { return true; }
        if (op == "ne") { return true; }
        if (op == "slt") { return true; }
        if (op == "sgt") { return true; }
        if (op == "sle") { return true; }
        if (op == "sge") { return true; }
        if (op == "lt") { return true; }
        if (op == "gt") { return true; }
        if (op == "le") { return true; }
        if (op == "ge") { return true; }
        return false;
    }

    fun emit_unaryop(mut this, inst: IRUnaryOp) {
        _utils.trace_enter("Enter emit_unaryop(inst=" + inst.display() + ")");
        let result_name: string = inst.result.display();
        let operand_resolved: string = this.resolve_value(inst.operand);
        let llvm_type: string = this.ir_type_to_llvm(inst.ir_type);
        if (inst.op == "neg") {
            let coerced: string = this.coerce_operand(operand_resolved, llvm_type);
            this.emit_line("  " + result_name + " = sub " + llvm_type + " 0, " + coerced);
            return;
        }
        if (inst.op == "plus") {
            let coerced: string = this.coerce_operand(operand_resolved, llvm_type);
            this.emit_line("  " + result_name + " = freeze " + llvm_type + " " + coerced);
            return;
        }
        if (inst.op == "not") {
            // If operand is an icmp result (i1), zext to i8 first to avoid
            // type mismatch (xor i8 expects i8, not i1)
            let operand: mut string = operand_resolved;
            if (this.is_icmp_value(operand_resolved)) {
                let zext_tmp: string = this.next_tmp();
                this.emit_line("  " + zext_tmp + " = zext i1 " + operand_resolved + " to i8");
                operand = zext_tmp;
            }
            this.emit_line("  " + result_name + " = xor i8 " + operand + ", 1");
            return;
        }
        if (inst.op == "bitnot") {
            let coerced: string = this.coerce_operand(operand_resolved, llvm_type);
            this.emit_line("  " + result_name + " = xor " + llvm_type + " " + coerced + ", -1");
            return;
        }
        this.emit_line("  ; unknown unaryop " + inst.op);
    }

    // Compute a pointer to a class field, handling the IRef (byte-offset GEP) vs
    // ICopy (struct-index GEP) split in one place (Requirement 1 centralization).
    // Returned name is a fresh %tmp holding the field address.
    fun gep_class_field(mut this, obj_resolved: string, layout: ClassLayout, fl: FieldLayout) -> string {
        _utils.trace_enter("Enter gep_class_field");
        let field_ptr: string = this.next_tmp();
        if (!layout.is_value_type) {
            // IRef: object is an opaque heap ptr; address the field by byte offset.
            this.emit_line("  " + field_ptr + " = getelementptr i8, ptr " + obj_resolved + ", i32 " + cast<string>(fl.byte_offset));
        } else {
            // ICopy: object is an alloca'd struct; address the field by struct index.
            this.emit_line("  " + field_ptr + " = getelementptr " + layout.llvm_struct_type + ", ptr " + obj_resolved + ", i32 0, i32 " + cast<string>(fl.field_index));
        }
        return field_ptr;
    }

    // For GEP-based member access on a value class / enum, return a POINTER to the
    // object's storage. resolve_value on a mutable register holding an aggregate
    // returns a loaded struct VALUE, which cannot be a GEP base — so use the
    // register's own alloca. For immutable refs and primitives, resolve_value
    // already yields the correct pointer (or the loaded primitive). This matters
    // once mutable-reg allocas are correctly sized as the full struct (scan_mutable_regs
    // picks the largest def type), so resolve_value returns a struct value, not a ptr.
    fun member_base_ptr(mut this, val: IRValue) -> string {
        _utils.trace_enter("Enter member_base_ptr");
        let name: string = val.display();
        if (this.is_mutable_reg(name)) {
            let reg_llvm: string = this.get_llvm_type(name);
            if (this.string_starts_with(reg_llvm, "%class.") || this.string_starts_with(reg_llvm, "%enum.")) {
                return this.get_alloca_name(name);
            }
        }
        return this.resolve_value(val);
    }

    // Return a POINTER to a value-class/enum struct, for passing as a call argument
    // whose parameter is declared `ptr` (value classes map to ref<X> -> ptr). A mutable
    // register holding the struct resolves to a loaded struct VALUE, which is not a
    // valid `ptr` argument — so use the register's own alloca. An immutable struct value
    // (e.g. an sret-RVO alias) is materialized into a fresh temp alloca. This mirrors
    // member_base_ptr's mutable-reg handling and is the call-argument counterpart to it.
    fun struct_value_to_ptr(mut this, val: IRValue, llvm_struct_type: string) -> string {
        _utils.trace_enter("Enter struct_value_to_ptr");
        let name: string = val.display();
        if (this.is_mutable_reg(name)) {
            let reg_llvm: string = this.get_llvm_type(name);
            if (this.string_starts_with(reg_llvm, "%class.") || this.string_starts_with(reg_llvm, "%enum.")) {
                return this.get_alloca_name(name);
            }
        }
        let resolved: string = this.resolve_value(val);
        return this.materialize_enum_ptr(resolved, llvm_struct_type);
    }

    fun emit_rdmbr(mut this, inst: IRRdmbr) {
        _utils.trace_enter("Enter emit_rdmbr(inst=" + inst.display() + ")");
        let result_name: string = inst.result.display();
        let obj_resolved: string = this.resolve_value(inst.obj);
        let llvm_type: string = this.ir_type_to_llvm(inst.ir_type);
        let field_name: string = inst.field_name;

        // Try to find class layout from obj IR type
        let obj_ir_type: string = inst.obj.get_ir_type();
        let type_name: string = this.extract_type_name(obj_ir_type);
        let found_class: Option<ClassLayout> = this.find_class_layout(type_name);

        if (found_class.is_some()) {
            let layout: ClassLayout = found_class.some;
            let found_field: Option<FieldLayout> = this.find_class_field_layout(type_name, field_name);

            if (found_field.is_some()) {
                let fl: FieldLayout = found_field.some;
                // Member access needs a POINTER to the object storage; a mutable reg
                // holding a value-class struct resolves to a loaded struct value, so
                // gep its alloca instead.
                let base_ptr: string = this.member_base_ptr(inst.obj);
                // Use the field's actual LLVM type from the layout (may differ from ir_type for value-type class fields)
                if (fl.llvm_type != "ptr" && llvm_type == "ptr") {
                    // Value-type class field stored inline, but IR expects a ref (ptr).
                    // Return the pointer to the inline field (GEP result) instead of loading the struct.
                    if (!layout.is_value_type) {
                        // IRef: byte-offset GEP, return the field pointer directly
                        this.emit_line("  " + result_name + " = getelementptr i8, ptr " + base_ptr + ", i32 " + cast<string>(fl.byte_offset));
                    } else {
                        // ICopy: struct field index GEP, return the field pointer directly
                        this.emit_line("  " + result_name + " = getelementptr " + layout.llvm_struct_type + ", ptr " + base_ptr + ", i32 0, i32 " + cast<string>(fl.field_index));
                    }
                    this.register_llvm_type(result_name, "ptr");
                } else {
                    let field_ptr: string = this.gep_class_field(base_ptr, layout, fl);
                    this.emit_line("  " + result_name + " = load " + llvm_type + ", ptr " + field_ptr);
                    this.register_llvm_type(result_name, llvm_type);
                }
                return;
            }
        }

        // Fallback: check if the base is an enum struct — extract payload first
        let obj_ir_llvm_type: string = this.ir_type_to_llvm(obj_ir_type);
        let obj_llvm_type: string = this.resolve_enum_struct_type(obj_ir_llvm_type, obj_resolved);
        if (this.string_starts_with(obj_llvm_type, "%enum.")) {
            // The base is an enum struct, extract payload (field 2).
            // obj_resolved may be a struct value or a pointer; materialize to ptr.
            let alloca_name: string = this.materialize_enum_ptr(obj_resolved, obj_llvm_type);
            let payload_ptr: string = this.next_tmp();
            this.emit_line("  " + payload_ptr + " = getelementptr " + obj_llvm_type + ", ptr " + alloca_name + ", i32 0, i32 2");
            let payload_type: string = this.get_enum_payload_type(obj_llvm_type);
            let payload_val: string = this.next_tmp();
            this.emit_line("  " + payload_val + " = load " + payload_type + ", ptr " + payload_ptr);
            this.register_llvm_type(payload_val, payload_type);
            // Now try class layout lookup on the payload for the field
            let payload_class_found: Option<ClassLayout> = this.find_class_layout_by_llvm(payload_type);
            if (payload_class_found.is_some()) {
                let cls_layout: ClassLayout = payload_class_found.some;
                let cls_field: Option<FieldLayout> = this.find_class_field_layout_llvm(cls_layout, field_name);
                if (cls_field.is_some()) {
                    let fl: FieldLayout = cls_field.some;
                    if (cls_layout.is_value_type) {
                        let field_ptr: string = this.next_tmp();
                        this.emit_line("  " + field_ptr + " = getelementptr " + cls_layout.llvm_struct_type + ", ptr " + payload_val + ", i32 0, i32 " + cast<string>(fl.field_index));
                        this.emit_line("  " + result_name + " = load " + llvm_type + ", ptr " + field_ptr);
                    } else {
                        let field_ptr: string = this.next_tmp();
                        this.emit_line("  " + field_ptr + " = getelementptr i8, ptr " + payload_val + ", i32 " + cast<string>(fl.byte_offset));
                        this.emit_line("  " + result_name + " = load " + llvm_type + ", ptr " + field_ptr);
                    }
                    this.register_llvm_type(result_name, llvm_type);
                    return;
                }
            }
            // Final fallback: plain load from the payload pointer
            this.emit_line("  " + result_name + " = load " + llvm_type + ", ptr " + payload_val);
            this.register_llvm_type(result_name, llvm_type);
            return;
        }

        // Fallback: plain load
        this.emit_line("  " + result_name + " = load " + llvm_type + ", ptr " + obj_resolved);
    }

    fun emit_wrmbr(mut this, inst: IRWrmbr) {
        _utils.trace_enter("Enter emit_wrmbr(inst=" + inst.display() + ")");
        let obj_resolved: string = this.resolve_value(inst.obj);
        let value_resolved: string = this.resolve_value(inst.value);
        let value_type: string = inst.value.get_ir_type();
        let llvm_type: string = this.ir_type_to_llvm(value_type);
        let field_name: string = inst.field_name;

        // Try to find class layout from obj IR type
        let obj_ir_type: string = inst.obj.get_ir_type();
        let type_name: string = this.extract_type_name(obj_ir_type);
        let found_class: Option<ClassLayout> = this.find_class_layout(type_name);

        if (found_class.is_some()) {
            let layout: ClassLayout = found_class.some;
            let found_field: Option<FieldLayout> = this.find_class_field_layout(type_name, field_name);

            if (found_field.is_some()) {
                let fl: FieldLayout = found_field.some;
                let store_type: string = fl.llvm_type;
                let coerced_value: string = this.coerce_operand(value_resolved, store_type);
                // Field store needs a POINTER to the object storage; a mutable reg
                // holding a value-class struct resolves to a loaded struct value, so
                // gep its alloca instead.
                let base_ptr: string = this.member_base_ptr(inst.obj);
                let field_ptr: string = this.gep_class_field(base_ptr, layout, fl);
                this.emit_line("  store " + store_type + " " + coerced_value + ", ptr " + field_ptr);
                return;
            }
        }

        // Fallback: plain store
        this.emit_line("  store " + llvm_type + " " + value_resolved + ", ptr " + obj_resolved);
    }

    fun emit_br(mut this, inst: IRBr) {
        _utils.trace_enter("Enter emit_br");
        this.emit_line("  br label %" + inst.target_name);
    }

    fun emit_br_cond(mut this, inst: IRBrCond) {
        _utils.trace_enter("Enter emit_br_cond");
        let cond_resolved: string = this.resolve_value(inst.cond);
        let is_icmp_result: bool = this.is_icmp_value(cond_resolved);
        if (is_icmp_result) {
            this.emit_line("  br i1 " + cond_resolved + ", label %" + inst.true_name + ", label %" + inst.false_name);
        } else {
            let cond_i1: string = "%cond_" + cast<string>(this.cond_counter);
            this.cond_counter = this.cond_counter + 1;
            this.emit_line("  " + cond_i1 + " = trunc i8 " + cond_resolved + " to i1");
            this.emit_line("  br i1 " + cond_i1 + ", label %" + inst.true_name + ", label %" + inst.false_name);
        }
    }

    fun emit_ret(mut this, inst: IRRet) {
        _utils.trace_enter("Enter emit_ret(inst=" + inst.display() + ")");
        if (this.current_sret_llvm_type != "") {
            // sret: store the return struct into the sret buffer, ret void
            let val_resolved: string = this.resolve_value(inst.value);
            // val_resolved may be a struct value (e.g. from NEW_ENUM) or a pointer
            // (e.g. an sret alloca from a forwarded call). Coerce to struct value first.
            let coerced: string = this.coerce_operand(val_resolved, this.current_sret_llvm_type);
            this.emit_line("  store " + this.current_sret_llvm_type + " " + coerced + ", ptr " + this.current_sret_param);
            this.emit_line("  ret void");
        } else {
            let val_resolved: mut string = this.resolve_value(inst.value);
            let llvm_type: string = this.ir_type_to_llvm(this.current_ret_type);
            // Coerce i1 (icmp result) to the expected return type (e.g. i8 for bool)
            if (this.is_icmp_value(val_resolved) && llvm_type != "i1") {
                let zext_tmp: string = this.next_tmp();
                this.emit_line("  " + zext_tmp + " = zext i1 " + val_resolved + " to " + llvm_type);
                val_resolved = zext_tmp;
            }
            this.emit_line("  ret " + llvm_type + " " + val_resolved);
        }
    }

    fun emit_ret_void(mut this) {
        _utils.trace_enter("Enter emit_ret_void");
        if (this.current_ret_type == "void") {
            this.emit_line("  ret void");
        } else {
            this.emit_line("  unreachable");
        }
    }

    fun emit_call(mut this, inst: IRCall) {
        _utils.trace_enter("Enter emit_call(inst=" + inst.display() + ")");
        let result_name: string = inst.result_value.display();
        let func_name: string = this.llvm_func_name(inst.func_name);

        // Check if callee returns an aggregate that uses sret (RVO)
        let callee_sret_type: mut string = "";
        if (this.needs_sret(inst.ret_type)) {
            callee_sret_type = this.get_sret_llvm_type(inst.ret_type);
        }

        if (callee_sret_type != "") {
            // Callee uses sret. If this CALL's result is an RVO-elision target
            // (CALL immediately followed by ASSIGN into a register), write the
            // return value directly into the destination's storage instead of
            // allocating a separate buffer and copying. For a mutable destination
            // this is mandatory: a separate ptr-sized buffer + store into an
            // undersized alloca overflows the return-address slot (pass2 crash).
            let elision: Option<SretElision> = this.find_sret_elision(result_name);
            if (elision.is_some()) {
                let dest_reg: string = elision.some.dest_reg;
                let args_str: string = this.emit_args_coerced(inst.func_name, inst.args);
                if (this.is_mutable_reg(dest_reg)) {
                    // RVO, mutable destination: the destination's alloca IS the
                    // sret buffer — the callee writes the return value straight
                    // into dest.addr. No separate buffer, no load/store copy.
                    let alloca_name: string = this.get_alloca_name(dest_reg);
                    if (string_length(args_str) > 0) {
                        this.emit_line("  call void " + func_name + "(ptr sret(" + callee_sret_type + ") " + alloca_name + ", " + args_str + ")");
                    } else {
                        this.emit_line("  call void " + func_name + "(ptr sret(" + callee_sret_type + ") " + alloca_name + ")");
                    }
                    this.reg_map.push(new RegMapping(result_name, alloca_name));
                    this.register_llvm_type(result_name, "ptr");
                } else {
                    // RVO, immutable destination: there is no alloca, so the sret
                    // buffer is the value's home. We take over what emit_assign's
                    // immutable branches would have done, so the following ASSIGN
                    // can be elided. The representation depends on the type:
                    //   - value-class ref (ref<T> -> ptr): alias dest to the sret
                    //     buffer POINTER (member access geps through it), like the
                    //     emit_assign "ptr" branch;
                    //   - enum: load the struct once and alias dest to that value,
                    //     like the emit_assign "%enum." branch.
                    let sret_tmp: string = this.next_tmp();
                    this.emit_entry_alloca(sret_tmp, callee_sret_type);
                    if (string_length(args_str) > 0) {
                        this.emit_line("  call void " + func_name + "(ptr sret(" + callee_sret_type + ") " + sret_tmp + ", " + args_str + ")");
                    } else {
                        this.emit_line("  call void " + func_name + "(ptr sret(" + callee_sret_type + ") " + sret_tmp + ")");
                    }
                    this.reg_map.push(new RegMapping(result_name, sret_tmp));
                    this.register_llvm_type(result_name, "ptr");
                    this.register_llvm_type(sret_tmp, "ptr");
                    let dest_llvm: string = this.ir_type_to_llvm(inst.ret_type);
                    if (dest_llvm == "ptr") {
                        // value-class ref: dest is the buffer pointer.
                        this.reg_map.push(new RegMapping(dest_reg, sret_tmp));
                        this.register_llvm_type(dest_reg, "ptr");
                    } else {
                        // enum (or other aggregate): dest is the loaded struct.
                        let loaded: string = this.next_tmp();
                        this.emit_line("  " + loaded + " = load " + callee_sret_type + ", ptr " + sret_tmp);
                        this.register_llvm_type(loaded, callee_sret_type);
                        this.reg_map.push(new RegMapping(dest_reg, loaded));
                        this.register_llvm_type(dest_reg, callee_sret_type);
                    }
                }
                // The ASSIGN that consumes this CALL's result is now redundant.
                this.elided_assigns.push(elision.some.assign_index);
                return;
            }
            // No elision: alloca a fresh sret buffer in the caller, pass as first arg.
            let sret_tmp: string = this.next_tmp();
            this.emit_entry_alloca(sret_tmp, callee_sret_type);
            let args_str: string = this.emit_args_coerced(inst.func_name, inst.args);
            if (string_length(args_str) > 0) {
                this.emit_line("  call void " + func_name + "(ptr sret(" + callee_sret_type + ") " + sret_tmp + ", " + args_str + ")");
            } else {
                this.emit_line("  call void " + func_name + "(ptr sret(" + callee_sret_type + ") " + sret_tmp + ")");
            }
            // Map result register to the sret alloca pointer
            this.reg_map.push(new RegMapping(result_name, sret_tmp));
            this.register_llvm_type(result_name, "ptr");
            // Register the alloca slot name as a pointer too, so that when the
            // result is later consumed as a value-type struct (e.g. stored into a
            // field), coerce_operand's get_llvm_type can resolve it and emit the
            // required ptr->struct load instead of using the slot pointer directly.
            this.register_llvm_type(sret_tmp, "ptr");
            // If the result register is mutable, the caller expects the value to
            // live in its alloca slot. Copy the sret buffer into that slot so
            // subsequent loads (via resolve_value's mutable path) see the struct.
            if (this.is_mutable_reg(result_name)) {
                let dst_alloca: string = this.get_alloca_name(result_name);
                let loaded: string = this.next_tmp();
                this.emit_line("  " + loaded + " = load " + callee_sret_type + ", ptr " + sret_tmp);
                this.emit_line("  store " + callee_sret_type + " " + loaded + ", ptr " + dst_alloca);
            }
        } else {
            let ret_llvm: string = this.ir_type_to_llvm(inst.ret_type);
            let args_str: string = this.emit_args_coerced(inst.func_name, inst.args);
            this.emit_line("  " + result_name + " = call " + ret_llvm + " " + func_name + "(" + args_str + ")");
            if (ret_llvm != "void") {
                this.register_llvm_type(result_name, ret_llvm);
            }
        }
    }

    fun emit_call_void(mut this, inst: IRCallVoid) {
        _utils.trace_enter("Enter emit_call_void(inst=" + inst.display() + ")");
        let args_str: string = this.emit_args_coerced(inst.func_name, inst.args);
        let func_name: string = this.llvm_func_name(inst.func_name);
        this.emit_line("  call void " + func_name + "(" + args_str + ")");
    }

    fun emit_call_virt(mut this, inst: IRCallVirt) {
        _utils.trace_enter("Enter emit_call_virt");
        this.needs_vtable_lookup = true;
        let obj_resolved: string = this.resolve_value(inst.obj);
        let result_name: string = inst.result_value.display();

        // Check if callee returns an aggregate that uses sret (RVO),
        // mirroring emit_call's sret logic for enum/struct returns.
        let callee_sret_type: mut string = "";
        if (this.needs_sret(inst.ret_type)) {
            callee_sret_type = this.get_sret_llvm_type(inst.ret_type);
        }

        // Enums are now registered as ptr (like value classes), so obj_resolved
        // is already a pointer — no need to materialize enum structs.

        // 1. Look up function pointer via C runtime helper
        let func_ptr_name: string = this.next_tmp();
        // Ensure the interface ID string constant is emitted (the class/enum that
        // implements this interface may not have its metadata emitted yet).
        if (!this.list_contains(this.emitted_interface_ids, inst.interface_id)) {
            this.emitted_interface_ids.push(inst.interface_id);
            let id_len: i64 = string_length(inst.interface_id);
            this.pending_iface_ids.append("@." + inst.interface_id + "_interface_id = private unnamed_addr constant [" + cast<string>(id_len + 1) + " x i8] c\"" + inst.interface_id + "\\00\"\n");
        }
        let iface_id_name: string = "@." + inst.interface_id + "_interface_id";
        this.emit_line("  " + func_ptr_name + " = call ptr @_emperor_vtable_lookup(ptr " + obj_resolved + ", ptr " + iface_id_name + ", i32 " + cast<string>(inst.vtable_slot) + ")");

        // 2. Build args string and sret buffer (if needed).
        // Use if-expression value form (trailing expression, no `;`) — PenguinLang
        // locals are not reassignable, and an if whose branches are statements is void.
        let rest_args: string = this.emit_args(inst.args);
        let sret_tmp: string = if (callee_sret_type != "") {
            let tmp: string = this.next_tmp();
            this.emit_entry_alloca(tmp, callee_sret_type);
            tmp
        } else {
            ""
        };
        let args_str: string = if (callee_sret_type != "") {
            if (string_length(rest_args) > 0) {
                "ptr sret(" + callee_sret_type + ") " + sret_tmp + ", " + rest_args
            } else {
                "ptr sret(" + callee_sret_type + ") " + sret_tmp
            }
        } else {
            rest_args
        };

        // 3. Indirect call through function pointer
        if (callee_sret_type != "") {
            // sret: call void, then map result to sret buffer
            this.emit_line("  call void " + func_ptr_name + "(" + args_str + ")");
            this.reg_map.push(new RegMapping(result_name, sret_tmp));
            this.register_llvm_type(result_name, "ptr");
            this.register_llvm_type(sret_tmp, "ptr");
            // If the result register is mutable, copy sret buffer into its alloca
            if (this.is_mutable_reg(result_name)) {
                let dst_alloca: string = this.get_alloca_name(result_name);
                let loaded: string = this.next_tmp();
                this.emit_line("  " + loaded + " = load " + callee_sret_type + ", ptr " + sret_tmp);
                this.emit_line("  store " + callee_sret_type + " " + loaded + ", ptr " + dst_alloca);
            }
        } else if (inst.ret_type != "void") {
            let ret_llvm: string = this.ir_type_to_llvm(inst.ret_type);
            this.emit_line("  " + result_name + " = call " + ret_llvm + " " + func_ptr_name + "(" + args_str + ")");
            if (ret_llvm != "void") {
                this.register_llvm_type(result_name, ret_llvm);
            }
        } else {
            this.emit_line("  call void " + func_ptr_name + "(" + args_str + ")");
        }
    }

    // Centralized object allocation (Requirement 1). Allocates a zero-initialized,
    // metadata-stamped slot for a class: value types (ICopy) use an entry-block alloca,
    // reference types (IRef) use the GC heap. Registers the result as "ptr". All
    // class-construction paths route through here so the value/ref decision, zero-init,
    // and metadata stamp live in exactly one place — eliminating the per-callsite
    // inconsistencies that caused native value-type crashes (mechanisms C/E).
    fun allocate_class(mut this, result_name: string, layout: ClassLayout) {
        _utils.trace_enter("Enter allocate_class(result_name=" + cast<string>(result_name) + ")");
        if (!layout.is_value_type) {
            // IRef: heap allocation. Zero the heap object via memset (no alloca, so
            // emit_entry_alloca's zero-init doesn't apply here).
            this.has_iref_class = true;
            this.emit_line("  " + result_name + " = call ptr @_emperor_alloc_impl(i32 " + cast<string>(layout.sizeof_object) + ")");
            this.needs_memset = true;
            this.emit_line("  call void @llvm.memset.p0.i64(ptr " + result_name + ", i8 0, i64 " + cast<string>(layout.sizeof_object) + ", i1 false)");
        } else {
            // ICopy: stack allocation. emit_entry_alloca emits `alloca` + `store T
            // zeroinitializer`, which zeroes the whole struct (including i32-tag padding
            // — mechanism C). No separate memset needed.
            this.emit_entry_alloca(result_name, layout.llvm_struct_type);
        }
        // Stamp the metadata pointer at offset 0.
        this.emit_line("  store ptr @" + layout.type_name + "_metadata, ptr " + result_name);
        // Register as ptr so coerce_operand can load the struct when a by-value use needs it.
        this.register_llvm_type(result_name, "ptr");
    }

    fun emit_new(mut this, inst: IRNew) {
        _utils.trace_enter("Enter emit_new(inst=" + inst.display() + ")");
        let result_name: string = inst.result.display();
        let type_name: string = this.strip_global_prefix(inst.type_name);
        let found: Option<ClassLayout> = this.find_class_layout(type_name);

        if (found.is_none()) {
            this.emit_line("  ; NEW " + type_name + " (no layout)");
            return;
        }

        let layout: ClassLayout = found.some;
        this.allocate_class(result_name, layout);
        // Call constructor
        let ctor_name: string = this.llvm_func_name("<global>." + type_name + ".new");
        let ctor_args: string = this.emit_args_with_first(inst.args, "ptr " + result_name);
        this.emit_line("  call void " + ctor_name + "(" + ctor_args + ")");
    }

    fun emit_args_with_first(mut this, args: _utils.List<IRValue>, first_arg: string) -> string {
        _utils.trace_enter("Enter emit_args_with_first(first_arg=" + cast<string>(first_arg) + ")");
        let sb2: mut StringBuilder = new StringBuilder();
        sb2.append(first_arg);
        let i: mut i64 = 0;
        while (i < cast<i64>(args.size())) {
            sb2.append(", ");
            let arg: IRValue = args.at(cast<u64>(i)).some;
            let resolved: string = this.resolve_value(arg);
            let arg_type: string = arg.get_ir_type();
            let llvm_type: string = this.ir_type_to_llvm(arg_type);
            // For >16-byte aggregate constructor arguments, the callee declares the
            // parameter as `ptr byval(type)` (emit_function), so the caller MUST pass a
            // pointer (materialize the value into a temp alloca). Passing the struct value
            // directly made the callee dereference the value's bits as a pointer — the
            // pass2 BoundScope/Option corruption (parent field garbage, scope mis-offset).
            let byval_type: string = this.resolve_byval_type(arg_type);
            if (byval_type != "") {
                let arg_ptr: string = this.materialize_enum_ptr(resolved, byval_type);
                sb2.append("ptr " + arg_ptr);
            } else {
                // Coerce ptr→struct for enum/value-class operands registered as ptr
                let actual_type: string = this.get_llvm_type(resolved);
                if (actual_type == "ptr" && (this.string_starts_with(llvm_type, "%enum.") || this.string_starts_with(llvm_type, "%class."))) {
                    let coerced: string = this.coerce_operand(resolved, llvm_type);
                    sb2.append(llvm_type + " " + coerced);
                } else {
                    if (llvm_type == "ptr" && (this.string_starts_with(actual_type, "%class.") || this.string_starts_with(actual_type, "%enum."))) {
                        // value-class ctor arg (ref<X> -> ptr) but resolved to a struct value:
                        // the callee treats the ptr as &struct, so pass a pointer to the storage.
                        let arg_ptr: string = this.struct_value_to_ptr(arg, actual_type);
                        sb2.append("ptr " + arg_ptr);
                    } else {
                        sb2.append(llvm_type + " " + resolved);
                    }
                }
            }
            i = i + 1;
        }
        return sb2.to_string();
    }

    fun emit_new_enum(mut this, inst: IRNewEnum) {
        _utils.trace_enter("Enter emit_new_enum(inst=" + inst.display() + ")");
        let result_name: string = inst.result.display();
        let raw_type_name: string = inst.type_name;
        let type_name: string = this.extract_type_name(raw_type_name);
        let found: Option<EnumLayout> = this.find_enum_layout(type_name);

        if (found.is_none()) {
            this.emit_line("  " + result_name + " = add i64 0, " + cast<string>(inst.variant_idx));
            return;
        }

        let layout: EnumLayout = found.some;

        // alloca enum struct directly as result (like emit_new for value classes)
        this.emit_entry_alloca(result_name, layout.llvm_struct_type);

        // store metadata at field 0
        let md_ptr: string = this.next_tmp();
        this.emit_line("  " + md_ptr + " = getelementptr " + layout.llvm_struct_type + ", ptr " + result_name + ", i32 0, i32 0");
        this.emit_line("  store ptr @" + layout.type_name + "_metadata, ptr " + md_ptr);

        // store variant index at field 1
        let var_ptr: string = this.next_tmp();
        this.emit_line("  " + var_ptr + " = getelementptr " + layout.llvm_struct_type + ", ptr " + result_name + ", i32 0, i32 1");
        this.emit_line("  store i32 " + cast<string>(inst.variant_idx) + ", ptr " + var_ptr);

        // store payload at field 2 if present
        if (inst.payload.is_some()) {
            if (layout.has_payload) {
                let pay_val_raw: string = this.resolve_value(inst.payload.some);
                // Find the variant's specific payload type; fall back to layout max-type
                let pay_type: mut string = layout.payload_llvm_type;
                let variant_payload_bound_type: mut Option<BoundType> = new Option<BoundType>.none();
                let vi2: mut i64 = 0;
                while (vi2 < cast<i64>(layout.variants.size())) {
                    let var2: EnumVariantLayout = layout.variants.at(cast<u64>(vi2)).some;
                    if (var2.index == inst.variant_idx) {
                        if (string_length(var2.payload_llvm_type) > 0) {
                            pay_type = var2.payload_llvm_type;
                        }
                        variant_payload_bound_type = var2.payload_bound_type;
                    }
                    vi2 = vi2 + 1;
                }
                let pay_val: string = this.coerce_operand(pay_val_raw, pay_type);
                let pay_ptr: string = this.next_tmp();
                this.emit_line("  " + pay_ptr + " = getelementptr " + layout.llvm_struct_type + ", ptr " + result_name + ", i32 0, i32 2");

                // If payload type is "ptr" and the value is a value-type class,
                // we must heap-allocate a copy to prevent dangling stack pointers.
                // Value types have copy semantics, so storing a ptr to a stack value
                // would violate that when the creating function returns.
                if (pay_type == "ptr") {
                    let heap_copied: mut bool = false;
                    if (variant_payload_bound_type.is_some()) {
                        let pbt: BoundType = variant_payload_bound_type.some;
                        // Check if the payload is a class type (not string, not primitive)
                        if (pbt.kind is TypeKind.ClassKind) {
                            if (pbt.type_definition.is_some()) {
                                let class_full_name: string = pbt.type_definition.some.class_def.full_name;
                                let class_name: string = this.strip_global_prefix(class_full_name);
                                let payload_class_layout: Option<ClassLayout> = this.find_class_layout(class_name);
                                if (payload_class_layout.is_some()) {
                                    if (payload_class_layout.some.is_value_type) {
                                        // Heap-allocate a copy of the value type
                                        this.has_iref_class = true;
                                        let heap_ptr: string = this.next_tmp();
                                        this.emit_line("  " + heap_ptr + " = call ptr @_emperor_alloc_impl(i32 " + cast<string>(payload_class_layout.some.sizeof_object) + ")");
                                        let struct_type: string = payload_class_layout.some.llvm_struct_type;
                                        // Load struct from stack ptr, store to heap ptr
                                        let loaded: string = this.next_tmp();
                                        this.emit_line("  " + loaded + " = load " + struct_type + ", ptr " + pay_val);
                                        this.emit_line("  store " + struct_type + " " + loaded + ", ptr " + heap_ptr);
                                        this.emit_line("  store ptr " + heap_ptr + ", ptr " + pay_ptr);
                                        heap_copied = true;
                                    }
                                }
                            }
                        }
                    }
                    if (!heap_copied) {
                        this.emit_line("  store " + pay_type + " " + pay_val + ", ptr " + pay_ptr);
                    }
                } else {
                    // If the variant's payload type differs from the struct field type
                    // (e.g. i32 vs ptr for Result<u32,string>.ok), convert via inttoptr
                    // so the store matches the struct field declaration.
                    if (pay_type != layout.payload_llvm_type && layout.payload_llvm_type == "ptr") {
                        let inttoptr_val: string = if (this.is_wider_int("i64", pay_type)) {
                            let ext_tmp2: string = this.next_tmp();
                            this.emit_line("  " + ext_tmp2 + " = zext " + pay_type + " " + pay_val + " to i64");
                            ext_tmp2
                        } else {
                            pay_val
                        };
                        let as_ptr: string = this.next_tmp();
                        this.emit_line("  " + as_ptr + " = inttoptr i64 " + inttoptr_val + " to ptr");
                        this.emit_line("  store ptr " + as_ptr + ", ptr " + pay_ptr);
                    } else {
                        this.emit_line("  store " + pay_type + " " + pay_val + ", ptr " + pay_ptr);
                    }
                }
            }
        }

        // Register result as ptr (consistent with emit_new for value-type classes).
        // Downstream consumers use coerce_operand to load the struct when needed.
        this.register_llvm_type(result_name, "ptr");
    }

    fun emit_isenum(mut this, inst: IRIsEnum) {
        _utils.trace_enter("Enter emit_isenum(inst=" + inst.display() + ")");
        let result_name: string = inst.result.display();
        let enum_resolved: string = this.resolve_value(inst.enum_value);
        let idx_resolved: string = this.resolve_value(inst.variant_idx);
        let enum_ir_type: string = inst.enum_value.get_ir_type();
        let type_name: string = this.extract_type_name(enum_ir_type);
        let found: Option<EnumLayout> = this.find_enum_layout(type_name);

        if (found.is_none()) {
            // Determine LLVM type: prefer IR type (ir_type_to_llvm) over the
            // registered type, because sret/byval operands may be registered as
            // "ptr" or not registered at all.
            let ir_llvm_type: string = this.ir_type_to_llvm(enum_ir_type);
            let resolved_llvm_type: string = this.resolve_enum_struct_type(ir_llvm_type, enum_resolved);
            if (this.string_starts_with(resolved_llvm_type, "%enum.")) {
                // The value is an enum struct — extract the tag (field 1) and compare.
                // enum_resolved may be a struct value or a pointer; materialize to ptr.
                let tmp_ptr: string = this.materialize_enum_ptr(enum_resolved, resolved_llvm_type);
                let tag_ptr: string = this.next_tmp();
                this.emit_line("  " + tag_ptr + " = getelementptr " + resolved_llvm_type + ", ptr " + tmp_ptr + ", i32 0, i32 1");
                let tag_val: string = this.next_tmp();
                this.emit_line("  " + tag_val + " = load i32, ptr " + tag_ptr);
                // Truncate variant idx to i32 if needed
                let idx_ir_type2: string = inst.variant_idx.get_ir_type();
                let idx_llvm_type2: string = this.ir_type_to_llvm(idx_ir_type2);
                let idx_i32_2: mut string = idx_resolved;
                if (idx_llvm_type2 != "i32") {
                    let trunc2: string = this.next_tmp();
                    this.emit_line("  " + trunc2 + " = trunc " + idx_llvm_type2 + " " + idx_resolved + " to i32");
                    idx_i32_2 = trunc2;
                }
                let cmp2: string = this.next_tmp();
                this.emit_line("  " + cmp2 + " = icmp eq i32 " + tag_val + ", " + idx_i32_2);
                this.emit_line("  " + result_name + " = zext i1 " + cmp2 + " to i8");
            } else {
                // Simple enum (i64 from ir_type_to_llvm fallback) — compare as i64
                let idx_ir_type3: string = inst.variant_idx.get_ir_type();
                let idx_llvm_type3: string = this.ir_type_to_llvm(idx_ir_type3);
                let cmp_type: mut string = resolved_llvm_type;
                if (cmp_type == "") { cmp_type = "i64"; }
                let idx_cmp: mut string = idx_resolved;
                if (idx_llvm_type3 != cmp_type) {
                    let trunc3: string = this.next_tmp();
                    this.emit_line("  " + trunc3 + " = trunc " + idx_llvm_type3 + " " + idx_resolved + " to " + cmp_type);
                    idx_cmp = trunc3;
                }
                let cmp3: string = this.next_tmp();
                this.emit_line("  " + cmp3 + " = icmp eq " + cmp_type + " " + enum_resolved + ", " + idx_cmp);
                this.emit_line("  " + result_name + " = zext i1 " + cmp3 + " to i8");
            }
            return;
        }

        let layout: EnumLayout = found.some;
        // enum_resolved may be a struct value or a pointer (byval/sret); materialize to ptr
        let tmp_name: string = this.materialize_enum_ptr(enum_resolved, layout.llvm_struct_type);

        // GEP field 1 (variant tag)
        let var_ptr: string = this.next_tmp();
        this.emit_line("  " + var_ptr + " = getelementptr " + layout.llvm_struct_type + ", ptr " + tmp_name + ", i32 0, i32 1");
        let tag_name: string = this.next_tmp();
        this.emit_line("  " + tag_name + " = load i32, ptr " + var_ptr);

        // compare — variant idx may be i64, truncate to i32
        let idx_i32: mut string = idx_resolved;
        let idx_name: string = inst.variant_idx.display();
        let idx_ir_type: string = inst.variant_idx.get_ir_type();
        let idx_llvm_type: string = this.ir_type_to_llvm(idx_ir_type);
        if (idx_llvm_type != "i32") {
            let trunc_name: string = this.next_tmp();
            this.emit_line("  " + trunc_name + " = trunc " + idx_llvm_type + " " + idx_resolved + " to i32");
            idx_i32 = trunc_name;
        }
        let cmp_name: string = this.next_tmp();
        this.emit_line("  " + cmp_name + " = icmp eq i32 " + tag_name + ", " + idx_i32);
        this.emit_line("  " + result_name + " = zext i1 " + cmp_name + " to i8");
    }

    fun emit_isinstance(mut this, inst: IRIsInstance) {
        _utils.trace_enter("Enter emit_isinstance(inst=" + inst.display() + ")");
        this.needs_isinstance = true;
        let result_name: string = inst.result.display();
        let obj_resolved: string = this.resolve_value(inst.obj);
        let type_id: string = inst.type_id;
        // Determine if this is an interface check or class check
        let is_interface: bool = this.is_interface_type_id(type_id);
        let call_result: string = this.next_tmp();
        let type_id_global: string = "@." + this.sanitize_type_id(type_id) + "_type_id";
        this.ensure_type_id_constant(type_id);

        // The operand may be an enum/value-class struct held in a register (e.g. an
        // alloca'd %enum.X loaded into a temp). _emperor_isinstance / _emperor_check_class
        // take a ptr, so materialize the struct to a temporary alloca when it isn't already
        // a pointer. (This was the enum-isinstance boxing bug: passing a %enum.X value
        // directly caused "'%tmp_N' defined with type '%enum.X' but expected 'ptr'".)
        let obj_ir_type: string = inst.obj.get_ir_type();
        let obj_llvm_type: string = this.resolve_enum_struct_type(this.ir_type_to_llvm(obj_ir_type), obj_resolved);
        let obj_ptr: string = this.materialize_enum_ptr(obj_resolved, obj_llvm_type);

        if (is_interface) {
            this.emit_line("  " + call_result + " = call i32 @_emperor_isinstance(ptr " + obj_ptr + ", ptr " + type_id_global + ")");
        } else {
            this.needs_check_class = true;
            this.emit_line("  " + call_result + " = call i32 @_emperor_check_class(ptr " + obj_ptr + ", ptr " + type_id_global + ")");
        }
        let cmp_name: string = this.next_tmp();
        this.emit_line("  " + cmp_name + " = icmp ne i32 " + call_result + ", 0");
        this.icmp_results.push(cmp_name);
        this.register_llvm_type(cmp_name, "i1");
        this.emit_line("  " + result_name + " = zext i1 " + cmp_name + " to i8");
        this.register_llvm_type(result_name, "i8");
    }

    fun emit_box(mut this, inst: IRBox) {
        _utils.trace_enter("Enter emit_box(inst=" + inst.display() + ")");
        this.has_boxing = true;
        let result_name: string = inst.result.display();
        let operand_resolved: string = this.resolve_value(inst.operand);
        let type_name: string = inst.source_type_name;

        // Try class layout first, then enum layout
        let found_cls: Option<ClassLayout> = this.find_class_layout(type_name);
        if (found_cls.is_some()) {
            let layout: ClassLayout = found_cls.some;
            this.emit_line("  " + result_name + " = call ptr @_emperor_alloc_impl(i32 " + cast<string>(layout.sizeof_object) + ")");
            this.emit_line("  call void @llvm.memcpy.p0.p0.i32(ptr " + result_name + ", ptr " + operand_resolved + ", i32 " + cast<string>(layout.sizeof_object) + ", i1 false)");
            this.register_llvm_type(result_name, "ptr");
            return;
        }

        let found_enum: Option<EnumLayout> = this.find_enum_layout(type_name);
        if (found_enum.is_some()) {
            let layout: EnumLayout = found_enum.some;
            let enum_size: i64 = this.compute_enum_struct_size(layout);
            let alloca_tmp: string = this.next_tmp();
            this.emit_entry_alloca(alloca_tmp, layout.llvm_struct_type);
            this.emit_line("  store " + layout.llvm_struct_type + " " + operand_resolved + ", ptr " + alloca_tmp);
            this.emit_line("  " + result_name + " = call ptr @_emperor_alloc_impl(i32 " + cast<string>(enum_size) + ")");
            this.emit_line("  call void @llvm.memcpy.p0.p0.i32(ptr " + result_name + ", ptr " + alloca_tmp + ", i32 " + cast<string>(enum_size) + ", i1 false)");
            this.register_llvm_type(result_name, "ptr");
            return;
        }
    }

    fun emit_unbox(mut this, inst: IRUnbox) {
        _utils.trace_enter("Enter emit_unbox(inst=" + inst.display() + ")");
        this.has_boxing = true;
        let result_name: string = inst.result.display();
        let operand_resolved: string = this.resolve_value(inst.operand);
        let type_name: string = inst.target_type_name;

        // Try class layout first, then enum layout
        let found_cls: Option<ClassLayout> = this.find_class_layout(type_name);
        if (found_cls.is_some()) {
            let layout: ClassLayout = found_cls.some;
            this.emit_entry_alloca(result_name, layout.llvm_struct_type);
            this.emit_line("  call void @llvm.memcpy.p0.p0.i32(ptr " + result_name + ", ptr " + operand_resolved + ", i32 " + cast<string>(layout.sizeof_object) + ", i1 false)");
            this.register_llvm_type(result_name, "ptr");
            return;
        }

        let found_enum: Option<EnumLayout> = this.find_enum_layout(type_name);
        if (found_enum.is_some()) {
            let layout: EnumLayout = found_enum.some;
            this.emit_line("  " + result_name + " = load " + layout.llvm_struct_type + ", ptr " + operand_resolved);
            this.register_llvm_type(result_name, layout.llvm_struct_type);
            return;
        }
    }

    fun compute_enum_struct_size(mut this, layout: EnumLayout) -> i64 {
        _utils.trace_enter("Enter compute_enum_struct_size(layout=" + layout.to_string() + ")");
        // ptr (8 bytes) + i32 variant tag (4 bytes) = 12, aligned to 8 = 16
        // if has payload, add payload size + alignment
        let base_size: mut i64 = 16;
        if (layout.has_payload) {
            let payload_size: i64 = this.llvm_type_size(layout.payload_llvm_type);
            base_size = base_size + payload_size;
            // align to 8
            let remainder: i64 = base_size % 8;
            if (remainder > 0) {
                base_size = base_size + 8 - remainder;
            }
        }
        return base_size;
    }


    fun is_interface_type_id(this, type_id: string) -> bool {
        _utils.trace_enter("Enter is_interface_type_id(type_id=" + cast<string>(type_id) + ")");
        // Walk the bound compilation unit to check if type_id refers to an interface
        if (this.current_unit.is_some()) {
            let i: mut i64 = 0;
            while (i < cast<i64>(this.current_unit.some.definitions.size())) {
                if (this.def_is_interface_type(this.current_unit.some.definitions.at(cast<u64>(i)).some, type_id)) {
                    return true;
                }
                i = i + 1;
            }
        }
        return false;
    }

    fun def_is_interface_type(this, def: BoundDefinition, type_id: string) -> bool {
        _utils.trace_enter("Enter def_is_interface_type(type_id=" + cast<string>(type_id) + ")");
        if (def is BoundDefinition.interface_def) {
            if (def.interface_def.type_symbol.is_some()) {
                if (def.interface_def.type_symbol.some.full_name == type_id) {
                    return true;
                }
            }
        }
        if (def is BoundDefinition.namespace_def) {
            let i: mut i64 = 0;
            while (i < cast<i64>(def.namespace_def.children.size())) {
                if (this.def_is_interface_type(def.namespace_def.children.at(cast<u64>(i)).some, type_id)) {
                    return true;
                }
                i = i + 1;
            }
        }
        return false;
    }

    fun sanitize_type_id(this, type_id: string) -> string {
        _utils.trace_enter("Enter sanitize_type_id(type_id=" + cast<string>(type_id) + ")");
        let result: mut string = "";
        let i: mut i64 = 0;
        while (i < cast<i64>(string_length(type_id))) {
            let ch: string = string_char_at(type_id, i);
            if (ch == ".") {
                result = result + "_";
            } else if (ch == "<" || ch == ">" || ch == " ") {
                result = result + "_";
            } else {
                result = result + ch;
            }
            i = i + 1;
        }
        return result;
    }

    fun ensure_type_id_constant(mut this, type_id: string) {
        _utils.trace_enter("Enter ensure_type_id_constant(type_id=" + cast<string>(type_id) + ")");
        let sanitized: string = this.sanitize_type_id(type_id);
        let global_name: string = "@." + sanitized + "_type_id";
        // Check for duplicates
        let i: mut i64 = 0;
        while (i < cast<i64>(this.type_id_constants.size())) {
            if (this.type_id_constants.at(cast<u64>(i)).some.global_name == global_name) {
                return;
            }
            i = i + 1;
        }
        let display_name: string = this.type_id_display_name(type_id);
        let len: i64 = cast<i64>(string_length(display_name)) + 1;
        this.type_id_constants.push(new TypeIdConstant(global_name, display_name, len));
    }

    fun type_id_display_name(this, type_id: string) -> string {
        _utils.trace_enter("Enter type_id_display_name(type_id=" + cast<string>(type_id) + ")");
        let prefix: string = "<global>.";
        if (this.string_starts_with(type_id, prefix)) {
            return string_substring(type_id, string_length(prefix), cast<i64>(string_length(type_id)) - string_length(prefix));
        }
        return type_id;
    }

    // If enum_value is a pointer (e.g. an sret alloca) to an enum struct, return it
    // directly so the caller can GEP its fields. Otherwise (enum_value is an inlined
    // struct value), allocate a temporary slot, store the struct, and return the slot
    // pointer.
    fun materialize_enum_ptr(mut this, enum_value: string, llvm_struct_type: string) -> string {
        _utils.trace_enter("Enter materialize_enum_ptr(enum_value=" + cast<string>(enum_value) + ", llvm_struct_type=" + cast<string>(llvm_struct_type) + ")");
        let actual_type: string = this.get_llvm_type(enum_value);
        if (actual_type == "ptr" || actual_type == "") {
            return enum_value;
        }
        let tmp_alloca: string = this.next_tmp();
        this.emit_entry_alloca(tmp_alloca, llvm_struct_type);
        this.emit_line("  store " + llvm_struct_type + " " + enum_value + ", ptr " + tmp_alloca);
        return tmp_alloca;
    }

    // Resolve the LLVM struct type of an enum value for payload extraction.
    // Prefer the IR-derived type; fall back to the registered LLVM type only when the
    // IR type is not an enum (e.g. for non-enum struct operands). This is needed because
    // sret call results are registered as "ptr" even though they hold an enum struct.
    fun resolve_enum_struct_type(this, ir_llvm_type: string, enum_resolved: string) -> string {
        _utils.trace_enter("Enter resolve_enum_struct_type(ir_llvm_type=" + cast<string>(ir_llvm_type) + ", enum_resolved=" + cast<string>(enum_resolved) + ")");
        if (this.string_starts_with(ir_llvm_type, "%enum.")) {
            return ir_llvm_type;
        }
        return this.get_llvm_type(enum_resolved);
    }

    fun emit_rdenum(mut this, inst: IRRdenum) {
        _utils.trace_enter("Enter emit_rdenum(inst=" + inst.display() + ")");
        let result_name: string = inst.result.display();
        let enum_resolved: string = this.resolve_value(inst.enum_value);
        let llvm_type: string = this.ir_type_to_llvm(inst.payload_type);
        let enum_ir_type: string = inst.enum_value.get_ir_type();
        let type_name: string = this.extract_type_name(enum_ir_type);
        let found: Option<EnumLayout> = this.find_enum_layout(type_name);

        if (found.is_none()) {
            // Check if the resolved value is an enum struct that needs payload extraction.
            // Prefer the IR type (ir_type_to_llvm) over the registered LLVM type, because
            // sret call results are registered as "ptr" even though they hold an enum struct.
            let ir_llvm_type: string = this.ir_type_to_llvm(enum_ir_type);
            let resolved_llvm_type: string = this.resolve_enum_struct_type(ir_llvm_type, enum_resolved);
            if (this.string_starts_with(resolved_llvm_type, "%enum.")) {
                // Extract payload (field 2) from the enum struct.
                let tmp_name: string = this.materialize_enum_ptr(enum_resolved, resolved_llvm_type);
                let pay_ptr: string = this.next_tmp();
                this.emit_line("  " + pay_ptr + " = getelementptr " + resolved_llvm_type + ", ptr " + tmp_name + ", i32 0, i32 2");
                this.emit_line("  " + result_name + " = load " + llvm_type + ", ptr " + pay_ptr);
                this.register_llvm_type(result_name, llvm_type);
            } else {
                this.emit_line("  " + result_name + " = load " + llvm_type + ", ptr " + enum_resolved);
            }
            return;
        }

        let layout: EnumLayout = found.some;
        // Use the IR instruction's payload type for correct load.
        // llvm_type is derived from inst.payload_type (the variant-specific type);
        // layout.payload_llvm_type is the max-size union field type and may differ
        // (e.g. "ptr" vs "i32" for Result<u32,string>.ok).
        let payload_load_type: mut string = llvm_type;
        if (payload_load_type == "void" && layout.has_payload && string_length(layout.payload_llvm_type) > 0) {
            payload_load_type = layout.payload_llvm_type;
        }
        // enum_resolved may be an enum struct value or a pointer to one (sret alloca).
        // If it is a pointer, GEP the payload directly; otherwise alloca+store first.
        let tmp_name: string = this.materialize_enum_ptr(enum_resolved, layout.llvm_struct_type);

        // GEP field 2 (payload)
        let pay_ptr: string = this.next_tmp();
        this.emit_line("  " + pay_ptr + " = getelementptr " + layout.llvm_struct_type + ", ptr " + tmp_name + ", i32 0, i32 2");
        this.emit_line("  " + result_name + " = load " + payload_load_type + ", ptr " + pay_ptr);
        this.register_llvm_type(result_name, payload_load_type);
    }

    fun emit_label(mut this, inst: IRLabelInst) {
        _utils.trace_enter("Enter emit_label(inst=" + inst.display() + ")");
        this.sb.append(inst.label_name + ":\n");
    }

    fun emit_global_load(mut this, inst: IRGlobalLoad) {
        _utils.trace_enter("Enter emit_global_load(inst=" + inst.display() + ")");
        let result_name: string = inst.result.display();
        let llvm_type: string = this.ir_type_to_llvm(inst.ir_type);
        let global_name: string = "@" + this.sanitize_name(inst.global_name);
        this.emit_line("  " + result_name + " = load " + llvm_type + ", ptr " + global_name);
        this.register_llvm_type(result_name, llvm_type);
    }

    fun emit_global_store(mut this, inst: IRGlobalStore) {
        _utils.trace_enter("Enter emit_global_store(inst=" + inst.display() + ")");
        let value_resolved: string = this.resolve_value(inst.value);
        let value_type: string = inst.value.get_ir_type();
        let llvm_type: string = this.ir_type_to_llvm(value_type);
        let coerced: string = this.coerce_operand(value_resolved, llvm_type);
        let global_name: string = "@" + this.sanitize_name(inst.global_name);
        this.emit_line("  store " + llvm_type + " " + coerced + ", ptr " + global_name);
    }

    // --- Argument list emission ---

    fun find_func_param_types(this, func_name: string) -> Option<FuncParamTypes> {
        _utils.trace_enter("Enter find_func_param_types(func_name=" + cast<string>(func_name) + ")");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.func_param_types.size())) {
            let fpt: FuncParamTypes = this.func_param_types.at(cast<u64>(i)).some;
            if (fpt.func_name == func_name) {
                return new Option<FuncParamTypes>.some(fpt);
            }
            i = i + 1;
        }
        return new Option<FuncParamTypes>.none();
    }

    fun coerce_arg(mut this, resolved: string, arg_llvm_type: string, param_llvm_type: string) -> string {
        _utils.trace_enter("Enter coerce_arg(resolved=" + cast<string>(resolved) + ", arg_llvm_type=" + cast<string>(arg_llvm_type) + ", param_llvm_type=" + cast<string>(param_llvm_type) + ")");
        if (arg_llvm_type == param_llvm_type) { return resolved; }
        // Integer truncation: i64 -> i32, i64 -> i16, etc.
        if (arg_llvm_type == "i64" && param_llvm_type == "i32") {
            let tmp: string = this.next_tmp();
            this.emit_line("  " + tmp + " = trunc i64 " + resolved + " to i32");
            return tmp;
        }
        if (arg_llvm_type == "i64" && param_llvm_type == "i16") {
            let tmp: string = this.next_tmp();
            this.emit_line("  " + tmp + " = trunc i64 " + resolved + " to i16");
            return tmp;
        }
        if (arg_llvm_type == "i64" && param_llvm_type == "i8") {
            let tmp: string = this.next_tmp();
            this.emit_line("  " + tmp + " = trunc i64 " + resolved + " to i8");
            return tmp;
        }
        // Integer extension: i32 -> i64, etc.
        if (arg_llvm_type == "i32" && param_llvm_type == "i64") {
            let tmp: string = this.next_tmp();
            this.emit_line("  " + tmp + " = sext i32 " + resolved + " to i64");
            return tmp;
        }
        if (arg_llvm_type == "i16" && param_llvm_type == "i64") {
            let tmp: string = this.next_tmp();
            this.emit_line("  " + tmp + " = sext i16 " + resolved + " to i64");
            return tmp;
        }
        if (arg_llvm_type == "i8" && param_llvm_type == "i64") {
            let tmp: string = this.next_tmp();
            this.emit_line("  " + tmp + " = sext i8 " + resolved + " to i64");
            return tmp;
        }
        // Pointer → struct: when an enum or value-type class operand is registered
        // as "ptr" (e.g. from emit_new_enum) but the callee expects the struct value
        // directly via register (≤16-byte aggregate without byval), load the struct.
        if (arg_llvm_type == "ptr" && this.string_starts_with(param_llvm_type, "%")) {
            return this.coerce_operand(resolved, param_llvm_type);
        }
        return resolved;
    }

    // Determine the byval struct type for a call argument, if the argument's
    // IR type is a >16-byte aggregate. Returns "" otherwise.
    fun resolve_byval_type(this, arg_ir_type: string) -> string {
        _utils.trace_enter("Enter resolve_byval_type(arg_ir_type=" + cast<string>(arg_ir_type) + ")");
        let ir_llvm_type: string = this.ir_type_to_llvm(arg_ir_type);
        if (this.llvm_type_size(ir_llvm_type) > 16) {
            return ir_llvm_type;
        }
        return "";
    }

    // Determine the struct type for a call argument when the operand is registered
    // as "ptr" but the callee expects the struct value (≤16-byte aggregate without
    // byval). Returns "" if no coercion is needed.
    fun resolve_arg_struct_type(this, arg_llvm_type: string, arg_ir_llvm_type: string, param_llvm_type: string) -> string {
        _utils.trace_enter("Enter resolve_arg_struct_type(arg_llvm_type=" + cast<string>(arg_llvm_type) + ", arg_ir_llvm_type=" + cast<string>(arg_ir_llvm_type) + ", param_llvm_type=" + cast<string>(param_llvm_type) + ")");
        if (arg_llvm_type == "ptr") {
            if (this.string_starts_with(arg_ir_llvm_type, "%enum.")) { return arg_ir_llvm_type; }
            if (this.string_starts_with(arg_ir_llvm_type, "%class.")) { return arg_ir_llvm_type; }
            if (this.string_starts_with(param_llvm_type, "%enum.")) { return param_llvm_type; }
            if (this.string_starts_with(param_llvm_type, "%class.")) { return param_llvm_type; }
        }
        return "";
    }

    fun emit_args_coerced(mut this, func_name: string, args: _utils.List<IRValue>) -> string {
        _utils.trace_enter("Enter emit_args_coerced(func_name=" + cast<string>(func_name) + ")");
        let sb2: mut StringBuilder = new StringBuilder();
        let fpt: Option<FuncParamTypes> = this.find_func_param_types(func_name);
        let first: mut bool = true;
        let i: mut i64 = 0;
        while (i < cast<i64>(args.size())) {
            let arg: IRValue = args.at(cast<u64>(i)).some;
            let arg_ir_type: string = arg.get_ir_type();
            let resolved: string = this.resolve_value(arg);
            // Skip void/unknown arguments only if there is no registered LLVM type
            // (e.g. enum payload access may have void IR type but ptr LLVM type).
            if (arg_ir_type == "void" || resolved == "unknown") {
                if (this.get_llvm_type(resolved) == "" || this.get_llvm_type(resolved) == "void") {
                    i = i + 1;
                    continue;
                }
            }
            if (!first) { sb2.append(", "); }
            first = false;
            // Prefer registered LLVM type over IR type (handles enum payload correctly)
            let registered_type: string = this.get_llvm_type(resolved);
            let arg_struct_type: string = this.ir_type_to_llvm(arg_ir_type);
            let arg_llvm_type: mut string = arg_struct_type;
            if (registered_type != "") {
                arg_llvm_type = registered_type;
            }
            let param_llvm_type: mut string = arg_llvm_type;
            if (fpt.is_some()) {
                if (i < cast<i64>(fpt.some.param_types.size())) {
                    param_llvm_type = fpt.some.param_types.at(cast<u64>(i)).some;
                }
            }
            let final_resolved: string = this.coerce_arg(resolved, arg_llvm_type, param_llvm_type);
            // For >16-byte aggregate parameters (byval), pass a pointer.
            // Use the IR-derived type (not the registered type, which may be "ptr"
            // for sret/byval operands) to match the callee's emit_function decision.
            let byval_type: string = this.resolve_byval_type(arg_ir_type);
            if (byval_type != "") {
                let arg_ptr: string = this.materialize_enum_ptr(final_resolved, byval_type);
                sb2.append("ptr " + arg_ptr);
            } else {
                // For ≤16-byte aggregates (enums, value classes), the callee expects
                // the struct value by register. precompute_function_signatures (Phase 3.0)
                // populated func_param_types for every function, so param_llvm_type is the
                // callee's true declared type — use coerce_operand to handle ptr→struct
                // conversion when needed (e.g. from emit_new_enum registered as ptr).
                let coerced_type: string = param_llvm_type;
                let actual_reg_type: string = this.get_llvm_type(final_resolved);
                if (this.string_starts_with(coerced_type, "%enum.") || this.string_starts_with(coerced_type, "%class.")) {
                    if (actual_reg_type == "ptr" || actual_reg_type != coerced_type) {
                        let coerced: string = this.coerce_operand(final_resolved, coerced_type);
                        sb2.append(coerced_type + " " + coerced);
                    } else {
                        sb2.append(coerced_type + " " + final_resolved);
                    }
                } else {
                    if (coerced_type == "ptr" && (this.string_starts_with(actual_reg_type, "%class.") || this.string_starts_with(actual_reg_type, "%enum."))) {
                        // Parameter is a pointer (value classes map to ref<X> -> ptr) but
                        // the argument resolved to a struct VALUE (mutable/immutable reg
                        // holding the struct). The callee treats the ptr as &struct for GEP
                        // member access, so pass a pointer to the struct's storage.
                        let arg_ptr: string = this.struct_value_to_ptr(arg, actual_reg_type);
                        sb2.append("ptr " + arg_ptr);
                    } else {
                        sb2.append(param_llvm_type + " " + final_resolved);
                    }
                }
            }
            i = i + 1;
        }
        return sb2.to_string();
    }

    fun emit_args(mut this, args: _utils.List<IRValue>) -> string {
        _utils.trace_enter("Enter emit_args");
        let sb2: mut StringBuilder = new StringBuilder();
        let first: mut bool = true;
        let i: mut i64 = 0;
        while (i < cast<i64>(args.size())) {
            let arg: IRValue = args.at(cast<u64>(i)).some;
            let resolved: string = this.resolve_value(arg);
            let arg_type: string = arg.get_ir_type();
            // Skip void/unknown arguments
            if (arg_type == "void" || resolved == "unknown") {
                i = i + 1;
                continue;
            }
            if (!first) { sb2.append(", "); }
            first = false;
            let llvm_type: string = this.ir_type_to_llvm(arg_type);
            // Coerce ptr→struct for enum/value-class operands registered as ptr
            let actual_type: string = this.get_llvm_type(resolved);
            if (actual_type == "ptr" && (this.string_starts_with(llvm_type, "%enum.") || this.string_starts_with(llvm_type, "%class."))) {
                let coerced: string = this.coerce_operand(resolved, llvm_type);
                sb2.append(llvm_type + " " + coerced);
            } else {
                sb2.append(llvm_type + " " + resolved);
            }
            i = i + 1;
        }
        return sb2.to_string();
    }

    // --- Value resolution ---

    fun resolve_value(mut this, val: IRValue) -> string {
        _utils.trace_enter("Enter resolve_value(val=" + val.display() + ")");
        let display: string = val.display();
        // Mutable register: emit load from alloca
        if (this.is_mutable_reg(display)) {
            let alloca_name: string = this.get_alloca_name(display);
            let llvm_type: string = this.get_llvm_type(display);
            if (llvm_type != "") {
                let loaded: string = this.next_tmp();
                this.sb.append("  " + loaded + " = load " + llvm_type + ", ptr " + alloca_name + "\n");
                this.register_llvm_type(loaded, llvm_type);
                return loaded;
            }
        }
        // Check register mapping (immutable registers and aliases)
        let i: mut i64 = 0;
        while (i < cast<i64>(this.reg_map.size())) {
            let mapping: RegMapping = this.reg_map.at(cast<u64>(i)).some;
            if (mapping.ir_name == display) {
                return mapping.llvm_value;
            }
            i = i + 1;
        }
        return display;
    }

    // --- Type mapping ---

    // Pre-scan a function for RVO / sret-elision opportunities: a CALL that
    // returns an aggregate via sret, immediately followed by an ASSIGN whose
    // source is exactly that CALL's result register (`let x = func()`). For each
    // such pair we record the destination register so emit_call can pass the
    // destination's storage directly as the sret buffer, and the dispatch loop
    // can skip the now-redundant ASSIGN. Must run before scan_mutable_regs so the
    // mutable-reg alloca can be sized to fit the sret return type.
    fun scan_sret_elision(mut this, func: IRFunction) {
        _utils.trace_enter("Enter scan_sret_elision");
        this.sret_elision_map = new _utils.List<SretElision>();
        this.elided_assigns = new _utils.List<i64>();
        let n: i64 = cast<i64>(func.instructions.size());
        let i: mut i64 = 0;
        while (i < n - 1) {
            let inst: IRInstruction = func.instructions.at(cast<u64>(i)).some;
            let next: IRInstruction = func.instructions.at(cast<u64>(i + 1)).some;
            if (inst is IRInstruction.call) {
                if (next is IRInstruction.assign) {
                    let call_result: string = inst.call.result_value.display();
                    let assign_dest: string = next.assign.dest.display();
                    let assign_src: string = next.assign.src.display();
                    if (assign_src == call_result) {
                        if (this.needs_sret(inst.call.ret_type)) {
                            let sret_type: string = this.get_sret_llvm_type(inst.call.ret_type);
                            this.sret_elision_map.push(new SretElision(call_result, assign_dest, i + 1, sret_type));
                        }
                    }
                }
            }
            i = i + 1;
        }
    }

    // Find the sret-elision record (if any) whose CALL result matches result_name.
    fun find_sret_elision(this, result_name: string) -> Option<SretElision> {
        _utils.trace_enter("Enter find_sret_elision(result_name=" + cast<string>(result_name) + ")");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.sret_elision_map.size())) {
            let e: SretElision = this.sret_elision_map.at(cast<u64>(i)).some;
            if (e.call_result == result_name) { return new Option<SretElision>.some(e); }
            i = i + 1;
        }
        return new Option<SretElision>.none();
    }

    // Find the sret-elision record (if any) whose destination register is dest_reg.
    // Used by scan_mutable_regs to size an RVO destination's alloca to fit the
    // callee's sret return type.
    fun sret_elision_for_dest(this, dest_reg: string) -> Option<SretElision> {
        _utils.trace_enter("Enter sret_elision_for_dest(dest_reg=" + cast<string>(dest_reg) + ")");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.sret_elision_map.size())) {
            let e: SretElision = this.sret_elision_map.at(cast<u64>(i)).some;
            if (e.dest_reg == dest_reg) { return new Option<SretElision>.some(e); }
            i = i + 1;
        }
        return new Option<SretElision>.none();
    }

    // True if the instruction at `index` is an ASSIGN that RVO has elided.
    fun is_elided_assign(this, index: i64) -> bool {
        _utils.trace_enter("Enter is_elided_assign(index=" + cast<string>(index) + ")");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.elided_assigns.size())) {
            if (this.elided_assigns.at(cast<u64>(i)).some == index) { return true; }
            i = i + 1;
        }
        return false;
    }

    fun scan_mutable_regs(mut this, func: IRFunction) {
        _utils.trace_enter("Enter scan_mutable_regs(func=" + func.to_string() + ")");
        // Collect all register names that appear as definition targets
        let all_defs: mut _utils.List<string> = new _utils.List<string>();
        let ii: mut i64 = 0;
        while (ii < cast<i64>(func.instructions.size())) {
            let inst: IRInstruction = func.instructions.at(cast<u64>(ii)).some;
            if (inst is IRInstruction.const_inst) {
                all_defs.push(inst.const_inst.result.display());
            }
            if (inst is IRInstruction.assign) {
                all_defs.push(inst.assign.dest.display());
            }
            ii = ii + 1;
        }

        // Find names that appear more than once (mutable)
        this.mutable_regs = new _utils.List<string>();
        this.mutable_reg_ir_types = new _utils.List<string>();
        this.mutable_reg_lines = new _utils.List<i64>();
        let i: mut i64 = 0;
        while (i < cast<i64>(all_defs.size())) {
            let name: string = all_defs.at(cast<u64>(i)).some;
            let count: mut i64 = 0;
            let j: mut i64 = 0;
            while (j < cast<i64>(all_defs.size())) {
                if (all_defs.at(cast<u64>(j)).some == name) {
                    count = count + 1;
                }
                j = j + 1;
            }
            if (count > 1 && !this.is_mutable_reg(name)) {
                this.mutable_regs.push(name);
            }
            i = i + 1;
        }

        // Create alloca names and determine types from first definition
        this.alloca_map = new _utils.List<RegMapping>();
        let m: mut i64 = 0;
        while (m < cast<i64>(this.mutable_regs.size())) {
            let name: string = this.mutable_regs.at(cast<u64>(m)).some;
            let alloca_name: string = name + ".addr";
            this.alloca_map.push(new RegMapping(name, alloca_name));

            // Determine the alloca type by scanning ALL definitions of this register
            // and picking the one with the largest LLVM size. Using only the first
            // definition is unsound: when one def writes a ptr-sized value and another
            // (or the sret return) writes a 40-byte enum, the first-def-typed alloca is
            // too small and the larger store overflows into the return-address slot on
            // stack reuse (the pass2 binding crash, RA = 0x555500000000). If this reg is
            // an RVO/sret-elision destination, also consider the callee's sret type.
            let best_llvm: mut string = "ptr";
            let best_size: mut i64 = 0;
            let best_ir_type: mut string = "ptr";
            let mr_line: mut i64 = 0;
            let found_line: mut bool = false;
            let elision_for_dest: Option<SretElision> = this.sret_elision_for_dest(name);
            if (elision_for_dest.is_some()) {
                let st: string = elision_for_dest.some.callee_sret_llvm_type;
                let sz: i64 = this.llvm_type_size(st);
                if (sz > best_size) {
                    best_llvm = st;
                    best_size = sz;
                    best_ir_type = elision_for_dest.some.callee_sret_llvm_type;
                }
            }
            let fi: mut i64 = 0;
            while (fi < cast<i64>(func.instructions.size())) {
                let inst: IRInstruction = func.instructions.at(cast<u64>(fi)).some;
                if (inst is IRInstruction.const_inst) {
                    if (inst.const_inst.result.display() == name) {
                        let res: IRValue = inst.const_inst.result;
                        let it: string = res.get_ir_type();
                        let lt: string = this.ir_type_to_llvm(it);
                        let sz: i64 = this.llvm_type_size(lt);
                        if (sz > best_size) {
                            best_llvm = lt;
                            best_size = sz;
                            best_ir_type = it;
                        }
                        if (!found_line) {
                            if (res is IRValue.named_reg) { mr_line = res.named_reg.location.line; found_line = true; }
                        }
                    }
                }
                if (inst is IRInstruction.assign) {
                    if (inst.assign.dest.display() == name) {
                        let res: IRValue = inst.assign.dest;
                        let it: string = res.get_ir_type();
                        let lt: string = this.ir_type_to_llvm(it);
                        let sz: i64 = this.llvm_type_size(lt);
                        if (sz > best_size) {
                            best_llvm = lt;
                            best_size = sz;
                            best_ir_type = it;
                        }
                        if (!found_line) {
                            if (res is IRValue.named_reg) { mr_line = res.named_reg.location.line; found_line = true; }
                        }
                    }
                }
                fi = fi + 1;
            }
            this.register_llvm_type(name, best_llvm);
            this.mutable_reg_ir_types.push(best_ir_type);
            this.mutable_reg_lines.push(mr_line);
            m = m + 1;
        }
    }

    fun is_mutable_reg(this, name: string) -> bool {
        _utils.trace_enter("Enter is_mutable_reg(name=" + cast<string>(name) + ")");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.mutable_regs.size())) {
            if (this.mutable_regs.at(cast<u64>(i)).some == name) { return true; }
            i = i + 1;
        }
        return false;
    }

    fun get_alloca_name(this, name: string) -> string {
        _utils.trace_enter("Enter get_alloca_name(name=" + cast<string>(name) + ")");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.alloca_map.size())) {
            let entry: RegMapping = this.alloca_map.at(cast<u64>(i)).some;
            if (entry.ir_name == name) { return entry.llvm_value; }
            i = i + 1;
        }
        return name + ".addr";
    }

    fun ir_type_to_llvm(this, ir_type: string) -> string {
        _utils.trace_enter("Enter ir_type_to_llvm(ir_type=" + cast<string>(ir_type) + ")");
        if (ir_type == "i8") { return "i8"; }
        if (ir_type == "i16") { return "i16"; }
        if (ir_type == "i32") { return "i32"; }
        if (ir_type == "i64") { return "i64"; }
        if (ir_type == "u8") { return "i8"; }
        if (ir_type == "u16") { return "i16"; }
        if (ir_type == "u32") { return "i32"; }
        if (ir_type == "u64") { return "i64"; }
        if (ir_type == "f32") { return "float"; }
        if (ir_type == "f64") { return "double"; }
        if (ir_type == "bool") { return "i8"; }
        if (ir_type == "char") { return "i32"; }
        if (ir_type == "void") { return "void"; }
        if (ir_type == "ptr") { return "ptr"; }
        if (ir_type == "funptr") { return "ptr"; }
        // ref<...> → ptr
        if (this.string_starts_with(ir_type, "ref<")) { return "ptr"; }
        // enum<...> → struct type if layout available, else i64
        if (this.string_starts_with(ir_type, "enum<")) {
            let type_name: string = this.extract_type_name(ir_type);
            let found: Option<EnumLayout> = this.find_enum_layout(type_name);
            if (found.is_some()) {
                return found.some.llvm_struct_type;
            }
            return "i64";
        }
        return "ptr";
    }

    // --- Cast operation mapping ---

    fun cast_op(this, from: string, to: string) -> string {
        _utils.trace_enter("Enter cast_op(from=" + cast<string>(from) + ", to=" + cast<string>(to) + ")");
        // Integer widening
        if (from == "i8" && to == "i16") { return "zext"; }
        if (from == "i8" && to == "i32") { return "zext"; }
        if (from == "i8" && to == "i64") { return "zext"; }
        if (from == "i16" && to == "i32") { return "zext"; }
        if (from == "i16" && to == "i64") { return "zext"; }
        if (from == "i32" && to == "i64") { return "zext"; }
        // Integer truncation
        if (from == "i64" && to == "i32") { return "trunc"; }
        if (from == "i64" && to == "i16") { return "trunc"; }
        if (from == "i64" && to == "i8") { return "trunc"; }
        if (from == "i32" && to == "i16") { return "trunc"; }
        if (from == "i32" && to == "i8") { return "trunc"; }
        if (from == "i16" && to == "i8") { return "trunc"; }
        // Bool → integer
        if (from == "i8" && (to == "i16" || to == "i32" || to == "i64")) { return "zext"; }
        // Integer → float
        if (from == "i32" && to == "float") { return "sitofp"; }
        if (from == "i64" && to == "float") { return "sitofp"; }
        if (from == "i32" && to == "double") { return "sitofp"; }
        if (from == "i64" && to == "double") { return "sitofp"; }
        // Float → integer
        if (from == "float" && to == "i32") { return "fptosi"; }
        if (from == "float" && to == "i64") { return "fptosi"; }
        if (from == "double" && to == "i32") { return "fptosi"; }
        if (from == "double" && to == "i64") { return "fptosi"; }
        // Float precision
        if (from == "float" && to == "double") { return "fpext"; }
        if (from == "double" && to == "float") { return "fptrunc"; }
        return "bitcast";
    }

    // --- BINOP mapping ---

    fun binop_to_llvm(this, op: string, ir_type: string) -> string {
        _utils.trace_enter("Enter binop_to_llvm(op=" + cast<string>(op) + ", ir_type=" + cast<string>(ir_type) + ")");
        let is_float: bool = ir_type == "f32" || ir_type == "f64";
        if (op == "add") { if (is_float) { return "fadd"; } return "add"; }
        if (op == "sub") { if (is_float) { return "fsub"; } return "sub"; }
        if (op == "mul") { if (is_float) { return "fmul"; } return "mul"; }
        if (op == "div") { if (is_float) { return "fdiv"; } return "sdiv"; }
        if (op == "mod") { if (is_float) { return "frem"; } return "srem"; }
        if (op == "eq") { if (is_float) { return "fcmp oeq"; } return "icmp eq"; }
        if (op == "ne") { if (is_float) { return "fcmp une"; } return "icmp ne"; }
        if (op == "slt") { if (is_float) { return "fcmp olt"; } return "icmp slt"; }
        if (op == "sgt") { if (is_float) { return "fcmp ogt"; } return "icmp sgt"; }
        if (op == "sle") { if (is_float) { return "fcmp ole"; } return "icmp sle"; }
        if (op == "sge") { if (is_float) { return "fcmp oge"; } return "icmp sge"; }
        if (op == "ult") { return "icmp ult"; }
        if (op == "ugt") { return "icmp ugt"; }
        if (op == "ule") { return "icmp ule"; }
        if (op == "uge") { return "icmp uge"; }
        if (op == "and") { return "and"; }
        if (op == "or") { return "or"; }
        if (op == "xor") { return "xor"; }
        __builtin.eprintln("error[E_INTERNAL]: Unhandled LLVM op in llvm_op_to_llvm"); __builtin.exit(1);
        return "add";
    }

    // --- Function name ---

    fun llvm_func_name(this, name: string) -> string {
        _utils.trace_enter("Enter llvm_func_name(name=" + cast<string>(name) + ")");
        let cleaned: string = this.strip_global_prefix(name);
        let sanitized: string = this.sanitize_name(cleaned);
        // Map __builtin.* functions to C runtime @_emperor_* functions
        if (sanitized == "println" || sanitized == "__builtin_println") { return "@_emperor_println"; }
        if (sanitized == "print" || sanitized == "__builtin_print") { return "@_emperor_print"; }
        if (sanitized == "eprintln" || sanitized == "__builtin_eprintln") { return "@_emperor_eprintln"; }
        if (sanitized == "eprint" || sanitized == "__builtin_eprint") { return "@_emperor_eprint"; }
        if (sanitized == "exit" || sanitized == "__builtin_exit") { return "@_emperor_exit"; }
        if (sanitized == "lshift" || sanitized == "__builtin_lshift") { return "@_emperor_lshift"; }
        if (sanitized == "rshift" || sanitized == "__builtin_rshift") { return "@_emperor_rshift"; }
        if (sanitized == "string_length" || sanitized == "__builtin_string_length") { return "@_emperor_string_length"; }
        if (sanitized == "__builtin_ICopy_copy") { return "@_emperor_icopy_copy"; }
        if (sanitized == "string_find" || sanitized == "__builtin_string_find") { return "@_emperor_string_find"; }
        if (sanitized == "string_find_from" || sanitized == "__builtin_string_find_from") { return "@_emperor_string_find_from"; }
        if (sanitized == "string_substring" || sanitized == "__builtin_string_substring") { return "@_emperor_string_substring"; }
        if (sanitized == "string_char_at" || sanitized == "__builtin_string_char_at") { return "@_emperor_string_char_at"; }
        if (sanitized == "string_char_code" || sanitized == "__builtin_string_char_code") { return "@_emperor_string_char_code"; }
        if (sanitized == "string_to_int" || sanitized == "__builtin_string_to_int") { return "@_emperor_string_to_int"; }
        if (sanitized == "__builtin___args_count") { return "@_emperor_args_count"; }
        if (sanitized == "__builtin___args_get") { return "@_emperor_args_get"; }
        if (sanitized == "__builtin__exec_cmd") { return "@_emperor_exec_cmd"; }
        // Map _utils.* extern functions to C runtime
        if (sanitized == "_utils_file_read_text") { return "@_emperor_file_read_text"; }
        if (sanitized == "_utils_file_write_text") { return "@_emperor_file_write_text"; }
        if (sanitized == "_utils_mkdir") { return "@_emperor_mkdir"; }
        if (sanitized == "_utils_file_exists") { return "@_emperor_file_exists"; }
        if (sanitized == "_utils_dir_exists") { return "@_emperor_dir_exists"; }
        if (sanitized == "_utils_dir_get_entries") { return "@_emperor_dir_get_entries"; }
        if (sanitized == "_utils_create_temp_dir") { return "@_emperor_create_temp_dir"; }
        // StringBuilder methods
        if (sanitized == "__builtin_StringBuilder_new") { return "@_emperor_stringbuilder_new"; }
        if (sanitized == "__builtin_StringBuilder_append") { return "@_emperor_stringbuilder_append"; }
        if (sanitized == "__builtin_StringBuilder_to_string") { return "@_emperor_stringbuilder_to_string"; }
        // PenguinJIT extern functions (backed by libpenguin_jit, linked with --enable-meta)
        if (sanitized == "__builtin_penguin_jit_create")     { return "@penguin_jit_create"; }
        if (sanitized == "__builtin_penguin_jit_add_module") { return "@penguin_jit_add_module"; }
        if (sanitized == "__builtin_penguin_jit_lookup")     { return "@penguin_jit_lookup"; }
        if (sanitized == "__builtin_penguin_jit_destroy")    { return "@penguin_jit_destroy"; }
        if (sanitized == "__builtin_penguin_jit_get_error")  { return "@penguin_jit_get_error"; }
        if (sanitized == "__builtin_penguin_jit_call_i64_0")           { return "@penguin_jit_call_i64_0"; }
        if (sanitized == "__builtin_penguin_jit_call_i64_i64")         { return "@penguin_jit_call_i64_i64"; }
        if (sanitized == "__builtin_penguin_jit_call_i64_i64_i64")     { return "@penguin_jit_call_i64_i64_i64"; }
        if (sanitized == "__builtin_penguin_jit_call_i64_i64_i64_i64") { return "@penguin_jit_call_i64_i64_i64_i64"; }
        if (sanitized == "__builtin_penguin_jit_call_ptr_ptr")         { return "@penguin_jit_call_ptr_ptr"; }
        if (sanitized == "__builtin_penguin_jit_call_ptr_ptr_ptr")     { return "@penguin_jit_call_ptr_ptr_ptr"; }
        // Phase 6 v2: the only reflection host-callback is the token→pointer bridge
        // (real-reuse: t.fields()/methods()/variants() are direct method calls on the
        // real emperor.BoundType in unit B, resolved to the host's emperor_BoundType_*
        // exports by weak-dedup). #typeof + the caller-stub call this from JIT'd code.
        // The create_* bridges are codegen (computed-string → ast token), not reflection.
        if (sanitized == "__builtin_penguin_meta_get_type") { return "@emperor_penguin_meta_get_type"; }
        if (sanitized == "__builtin_penguin_meta_create_expression") { return "@emperor_penguin_meta_create_expression"; }
        if (sanitized == "__builtin_penguin_meta_create_definition") { return "@emperor_penguin_meta_create_definition"; }
        return "@" + sanitized;
    }

    fun strip_global_prefix(this, name: string) -> string {
        _utils.trace_enter("Enter strip_global_prefix(name=" + cast<string>(name) + ")");
        let prefix: string = "<global>.";
        let prefix_len: i64 = string_length(prefix);
        let name_len: i64 = string_length(name);
        if (name_len > prefix_len && this.string_starts_with(name, prefix)) {
            return string_substring(name, prefix_len, name_len - prefix_len);
        }
        return name;
    }

    fun sanitize_name(this, name: string) -> string {
        _utils.trace_enter("Enter sanitize_name(name=" + cast<string>(name) + ")");
        let sb2: mut StringBuilder = new StringBuilder();
        let len: i64 = string_length(name);
        let i: mut i64 = 0;
        while (i < len) {
            let ch: string = string_char_at(name, i);
            if (ch == "<" || ch == ">" || ch == " " || ch == "," || ch == ".") {
                sb2.append("_");
            } else {
                sb2.append(ch);
            }
            i = i + 1;
        }
        return sb2.to_string();
    }

    // --- Type helpers ---

    fun register_llvm_type(mut this, reg_name: string, llvm_type: string) {
        _utils.trace_enter("Enter register_llvm_type(reg_name=" + cast<string>(reg_name) + ", llvm_type=" + cast<string>(llvm_type) + ")");
        this.reg_type_map.push(new RegMapping(reg_name, llvm_type));
    }

    fun get_llvm_type(this, reg_name: string) -> string {
        _utils.trace_enter("Enter get_llvm_type(reg_name=" + cast<string>(reg_name) + ")");
        let i: mut i64 = cast<i64>(this.reg_type_map.size()) - 1;
        while (i >= 0) {
            let entry: RegMapping = this.reg_type_map.at(cast<u64>(i)).some;
            if (entry.ir_name == reg_name) { return entry.llvm_value; }
            i = i - 1;
        }
        return "";
    }

    fun coerce_operand(mut this, resolved: string, expected_llvm: string) -> string {
        _utils.trace_enter("Enter coerce_operand(resolved=" + cast<string>(resolved) + ", expected_llvm=" + cast<string>(expected_llvm) + ")");
        // Skip if expected type is ptr (opaque in LLVM)
        if (expected_llvm == "ptr") { return resolved; }
        // Look up actual type of register
        let actual_type: string = this.get_llvm_type(resolved);
        if (actual_type == "" || actual_type == expected_llvm) { return resolved; }
        // ptr -> struct: load the value type from the reference pointer
        if (actual_type == "ptr" && (this.string_starts_with(expected_llvm, "%class.") || this.string_starts_with(expected_llvm, "%struct.") || this.string_starts_with(expected_llvm, "%enum."))) {
            let tmp: string = this.next_tmp();
            this.sb.append("  " + tmp + " = load " + expected_llvm + ", ptr " + resolved + "\n");
            this.register_llvm_type(tmp, expected_llvm);
            return tmp;
        }
        // Insert truncation or extension
        let tmp: string = this.next_tmp();
        if (this.is_wider_int(actual_type, expected_llvm)) {
            this.sb.append("  " + tmp + " = trunc " + actual_type + " " + resolved + " to " + expected_llvm + "\n");
        } else {
            this.sb.append("  " + tmp + " = zext " + actual_type + " " + resolved + " to " + expected_llvm + "\n");
        }
        this.register_llvm_type(tmp, expected_llvm);
        return tmp;
    }

    fun is_wider_int(this, a: string, b: string) -> bool {
        _utils.trace_enter("Enter is_wider_int(a=" + cast<string>(a) + ", b=" + cast<string>(b) + ")");
        let wa: i64 = this.int_width(a);
        let wb: i64 = this.int_width(b);
        return wa > wb;
    }

    fun int_width(this, t: string) -> i64 {
        _utils.trace_enter("Enter int_width(t=" + cast<string>(t) + ")");
        if (t == "i8") { return 8; }
        if (t == "i16") { return 16; }
        if (t == "i32") { return 32; }
        if (t == "i64") { return 64; }
        return 0;
    }

    fun is_icmp_value(this, resolved: string) -> bool {
        _utils.trace_enter("Enter is_icmp_value(resolved=" + cast<string>(resolved) + ")");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.icmp_results.size())) {
            if (this.icmp_results.at(cast<u64>(i)).some == resolved) { return true; }
            i = i + 1;
        }
        return false;
    }

    fun is_string_type(this, ir_type: string) -> bool {
        _utils.trace_enter("Enter is_string_type(ir_type=" + cast<string>(ir_type) + ")");
        if (string_length(ir_type) >= 5) {
            let prefix: string = "ref<";
            let i: mut i64 = 0;
            while (i < 4) {
                if (string_char_at(ir_type, i) != string_char_at(prefix, i)) { return false; }
                i = i + 1;
            }
            // Check if content starts with "string"
            let content: string = string_substring(ir_type, 4, string_length(ir_type) - 5);
            if (content == "string") { return true; }
        }
        return false;
    }

    fun is_bool_type(this, ir_type: string) -> bool {
        _utils.trace_enter("Enter is_bool_type(ir_type=" + cast<string>(ir_type) + ")");
        return ir_type == "bool";
    }

    fun is_enum_type(this, ir_type: string) -> bool {
        _utils.trace_enter("Enter is_enum_type(ir_type=" + cast<string>(ir_type) + ")");
        if (string_length(ir_type) >= 5) {
            let prefix: string = "enum<";
            let i: mut i64 = 0;
            while (i < 5) {
                if (string_char_at(ir_type, i) != string_char_at(prefix, i)) { return false; }
                i = i + 1;
            }
            return true;
        }
        return false;
    }

    // Get the payload LLVM type for an enum struct type like "%enum.bound.BoundSymbol"
    // Returns "ptr" by default (reference-type payload)
    fun get_enum_payload_type(this, llvm_struct_type: string) -> string {
        _utils.trace_enter("Enter get_enum_payload_type(llvm_struct_type=" + cast<string>(llvm_struct_type) + ")");
        let type_name: string = string_substring(llvm_struct_type, 6, string_length(llvm_struct_type) - 6);
        let found: Option<EnumLayout> = this.find_enum_layout(type_name);
        if (found.is_some()) {
            let layout: EnumLayout = found.some;
            if (layout.has_payload) {
                if (string_length(layout.payload_llvm_type) > 0) {
                    return layout.payload_llvm_type;
                }
            }
        }
        return "ptr";
    }

    // Find class layout by LLVM struct type (e.g., "%class.bound.BoundScope")
    fun find_class_layout_by_llvm(this, llvm_type: string) -> Option<ClassLayout> {
        _utils.trace_enter("Enter find_class_layout_by_llvm(llvm_type=" + cast<string>(llvm_type) + ")");
        if (!this.string_starts_with(llvm_type, "%class.")) {
            return new Option<ClassLayout>.none();
        }
        let type_name: string = string_substring(llvm_type, 7, string_length(llvm_type) - 7);
        return this.find_class_layout(type_name);
    }

    // Find class field layout using a ClassLayout directly
    fun find_class_field_layout_llvm(this, layout: ClassLayout, field_name: string) -> Option<FieldLayout> {
        _utils.trace_enter("Enter find_class_field_layout_llvm(layout=" + layout.to_string() + ", field_name=" + cast<string>(field_name) + ")");
        let fi: mut i64 = 0;
        while (fi < cast<i64>(layout.fields.size())) {
            let fl: FieldLayout = layout.fields.at(cast<u64>(fi)).some;
            if (fl.field_name == field_name) {
                return new Option<FieldLayout>.some(fl);
            }
            fi = fi + 1;
        }
        return new Option<FieldLayout>.none();
    }

    fun is_ref_type(this, ir_type: string) -> bool {
        _utils.trace_enter("Enter is_ref_type(ir_type=" + cast<string>(ir_type) + ")");
        if (string_length(ir_type) >= 5) {
            let prefix: string = "ref<";
            let i: mut i64 = 0;
            while (i < 4) {
                if (string_char_at(ir_type, i) != string_char_at(prefix, i)) { return false; }
                i = i + 1;
            }
            return true;
        }
        return false;
    }

    fun is_int_type(this, ir_type: string) -> bool {
        _utils.trace_enter("Enter is_int_type(ir_type=" + cast<string>(ir_type) + ")");
        if (ir_type == "i8") { return true; }
        if (ir_type == "i16") { return true; }
        if (ir_type == "i32") { return true; }
        if (ir_type == "i64") { return true; }
        if (ir_type == "u8") { return true; }
        if (ir_type == "u16") { return true; }
        if (ir_type == "u32") { return true; }
        if (ir_type == "u64") { return true; }
        return false;
    }

    fun list_contains(this, list: _utils.List<string>, value: string) -> bool {
        _utils.trace_enter("Enter list_contains(value=" + cast<string>(value) + ")");
        let i: mut i64 = 0;
        while (i < cast<i64>(list.size())) {
            if (list.at(cast<u64>(i)).some == value) { return true; }
            i = i + 1;
        }
        return false;
    }

    fun string_starts_with(this, s: string, prefix: string) -> bool {
        _utils.trace_enter("Enter string_starts_with(s=" + cast<string>(s) + ", prefix=" + cast<string>(prefix) + ")");
        let prefix_len: i64 = string_length(prefix);
        if (string_length(s) < prefix_len) { return false; }
        let i: mut i64 = 0;
        while (i < prefix_len) {
            if (string_char_at(s, i) != string_char_at(prefix, i)) { return false; }
            i = i + 1;
        }
        return true;
    }

    fun strip_string_quotes(this, s: string) -> string {
        _utils.trace_enter("Enter strip_string_quotes(s=" + cast<string>(s) + ")");
        let len: i64 = string_length(s);
        let inner: mut string = s;
        if (len >= 2 && string_char_at(s, 0) == "\"" && string_char_at(s, len - 1) == "\"") {
            inner = string_substring(s, 1, len - 2);
        }
        return this.unescape_string(inner);
    }

    // Decode C-style escape sequences in a string literal's inner text, matching
    // the BabyPenguin reference VM's UnescapeString (RuntimeFrame.cs). This is
    // essential for self-hosting: without it, `"\n"` keeps its two literal bytes
    // (backslash + 'n'), so when EmperorPenguin compiles *itself* the Lexer's
    // newline check `ch == "\n"` (ch is a real 0x0A) never matches, line tracking
    // collapses to line 1, every string literal's "\n" prints as literal `\n`,
    // and escape_llvm_string's `ch == "\n"` branch never fires. The cascade is
    // sound because Pass 1 runs on the VM (which decodes these same literals), so
    // it emits already-decoded `@str_N` globals and Pass 2 inherits real control
    // characters in every `"\n"`/`"\t"`/... constant.
    fun unescape_string(this, s: string) -> string {
        _utils.trace_enter("Enter unescape_string(s=" + cast<string>(s) + ")");
        let sb2: mut StringBuilder = new StringBuilder();
        let len: i64 = string_length(s);
        let i: mut i64 = 0;
        while (i < len) {
            let ch: string = string_char_at(s, i);
            if (ch == "\\" && i + 1 < len) {
                let next: string = string_char_at(s, i + 1);
                if (next == "n") { sb2.append("\n"); i = i + 2; }
                else if (next == "t") { sb2.append("\t"); i = i + 2; }
                else if (next == "r") { sb2.append("\r"); i = i + 2; }
                else if (next == "\\") { sb2.append("\\"); i = i + 2; }
                else if (next == "\"") { sb2.append("\""); i = i + 2; }
                else if (next == "'") { sb2.append("'"); i = i + 2; }
                else if (next == "0") { sb2.append("\0"); i = i + 2; }
                else { sb2.append(ch); i = i + 1; }
            } else {
                sb2.append(ch);
                i = i + 1;
            }
        }
        return sb2.to_string();
    }

    // --- String escaping for LLVM c"..." format ---
    // LLVM c"..." uses \xx hex escapes only. No \\ or \" escapes exist.

    fun escape_llvm_string(this, s: string) -> string {
        _utils.trace_enter("Enter escape_llvm_string(s=" + cast<string>(s) + ")");
        let sb2: mut StringBuilder = new StringBuilder();
        let len: i64 = string_length(s);
        let i: mut i64 = 0;
        while (i < len) {
            let ch: string = string_char_at(s, i);
            if (ch == "\\") {
                sb2.append("\\5C");
            } else {
                if (ch == "\"") {
                    sb2.append("\\22");
                } else {
                    if (ch == "\n") {
                        sb2.append("\\0A");
                    } else {
                        if (ch == "\r") {
                            sb2.append("\\0D");
                        } else {
                            if (ch == "\t") {
                                sb2.append("\\09");
                            } else {
                                sb2.append(ch);
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        return sb2.to_string();
    }
}

}
