// LLVM emission driver (batch 0.1 split of the former 8391-line LLVMEmitter:
// all shared emission state and the lower()/emit_function/emit_main pipeline
// stay here; per-concern collaborators live in LLVMTypes/LLVMInstructions/
// LLVMObjects/LLVMValues/LLVMCalls/LLVMGCScan/LLVMMetadata/LLVMDebug/
// LLVMGlobals, free helpers in LLVMUtil, data classes in LLVMData).
namespace emperor {

class LLVMEmitter {
    verbose: mut i64 = 0;
    // The emitted IR is platform-independent: the try/catch sjlj landing pad
    // always uses the TWO-argument _setjmp form (jmp_buf, frame). mingw-w64's
    // x64 _setjmp takes (jmp_buf, frame) and needs the explicit NULL frame (a
    // garbage second register would become the stored SEH frame and the paired
    // longjmp would unwind through it); glibc's _setjmp takes (jmp_buf) only
    // and simply ignores the extra register argument under the SysV/AAPCS
    // calling conventions. One IR, both link targets.
    string_lits: mut _utils.List<StringLitEntry> = new _utils.List<StringLitEntry>();
    // value -> string_lits index. find_string_lit used to linear-scan every
    // entry per lookup (O(n^2) over a whole-module collection pass; 2.7% of
    // the bootstrap profile).
    string_lit_index: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    next_str_id: mut i64 = 0;
    reg_map: mut _utils.List<RegMapping> = new _utils.List<RegMapping>();
    reg_type_map: mut _utils.List<RegMapping> = new _utils.List<RegMapping>();
    mutable_regs: mut _utils.List<string> = new _utils.List<string>();
    alloca_map: mut _utils.List<RegMapping> = new _utils.List<RegMapping>();
    // Maps each extern function's penguin name -> its C-runtime LLVM symbol
    // ("@_emperor_<tail>"), built once per lower() from module.functions.
    // Discriminating on is_extern (not namespace) is essential: __builtin/_utils
    // also hold real functions (List.push, Option.is_some, ...) that must NOT be
    // rewritten as externs.
    extern_map: mut _utils.List<RegMapping> = new _utils.List<RegMapping>();
    // BARE top-level externs (is_extern, not lib-export, no namespace dot,
    // outside __builtin/_utils): they bind literal libc symbols whose ABI is
    // char* — string ARGUMENTS are marshaled to the data pointer (+16 GEP) and
    // string RETURNS are adopt-copied at the call site (see emit_args_coerced
    // / emit_call). Our own C entry points (_emperor_*, std_io_*, namespaced
    // externs) speak the native _emperor_string* ABI and never marshal.
    bare_libc_externs: mut _utils.List<string> = new _utils.List<string>();
    sb: mut StringBuilder = new StringBuilder();
    // During function emission, body_sb receives instruction output
    // and entry_allocas collects alloca instructions for the entry block.
    body_sb: mut StringBuilder = new StringBuilder();
    entry_allocas: mut StringBuilder = new StringBuilder();
    // Per-function: names emitted as entry-block allocas (registers that ARE
    // storage). Used by enum_value_storage_ptr to resolve a mut payload access
    // to the enum's own storage instead of a materialized copy.
    entry_alloca_names: mut _utils.List<string> = new _utils.List<string>();
    // Per-function: RDMBR/RDENUM result registers that must ALIAS the slot
    // they read (lvalue addressing) — the result is consumed as the owner of
    // a WRMBR, as a method-call receiver, or through a chain of such uses
    // (see scan_write_chains). Everything else reads a COPY (value-copy
    // semantics: binding / extraction / by-value argument).
    write_chain_regs: mut _utils.List<string> = new _utils.List<string>();
    // Per-function: ASSIGN destinations that must ALIAS their source instead
    // of copying (receiver materialization feeding a call, and the unbox
    // idiom `let self: mut Self = cast<mut Self>(this)` whose WRMBR owner is
    // the assigned register).
    alias_assign_regs: mut _utils.List<string> = new _utils.List<string>();
    // Per-function: value-class parameters (except `this`) copied into local
    // storage at function entry — maps "%" + param name to the copy alloca.
    // `this` receivers are deliberately absent: they point at the caller's
    // slot so mut-this writes go through.
    value_param_copies: mut _utils.List<RegMapping> = new _utils.List<RegMapping>();
    // Per-function: struct SSA values produced by coerce_operand's ptr→struct
    // load, mapped back to the POINTER they were loaded from. Lets storage-
    // resolving paths (write-chain payload extraction) recover the enum's
    // STORAGE from a register that was resolved (and loaded) through the
    // alias map.
    struct_value_sources: mut _utils.List<RegMapping> = new _utils.List<RegMapping>();
    // Per-function: struct values produced by RDMBR of an INLINE field (a
    // `load %class./%enum.` from a field slot), mapped back to the FIELD
    // ADDRESS they were loaded from. A chained write whose WRMBR base is such
    // a register (`this.tail.link = x` lowers to WRMBR(RDMBR(this, tail),
    // link, x)) must write THROUGH to the real field — the loaded copy's own
    // alloca would silently swallow the store. Cleared on ASSIGN to the
    // register (the reg then holds unrelated content).
    struct_field_sources: mut _utils.List<RegMapping> = new _utils.List<RegMapping>();
    cond_counter: mut i64 = 0;
    current_ret_type: mut string = "void";
    class_layouts: mut _utils.List<ClassLayout> = new _utils.List<ClassLayout>();
    // Native-array metadata globals, one per element type (see ArrayMetaEntry).
    array_meta_entries: mut _utils.List<ArrayMetaEntry> = new _utils.List<ArrayMetaEntry>();
    enum_layouts: mut _utils.List<EnumLayout> = new _utils.List<EnumLayout>();
    // Completion order of layout building (leaves finish first). LLVM textual
    // IR requires a named struct to be DEFINED before it is referenced by
    // another `= type`, and on-demand recursive building may interleave
    // class/enum layouts — so emission follows this order, which is a valid
    // topological order of the type-nesting graph. Entries are llvm struct
    // type names ("%class.X" / "%enum.X").
    layout_done_order: mut _utils.List<string> = new _utils.List<string>();
    // Names of layouts currently being built (for the E_SIZE_CYCLE chain dump).
    building_stack: mut _utils.List<string> = new _utils.List<string>();
    tmp_counter: mut i64 = 0;
    // GC v2 3c cover-retirement diagnostic (EMPEROR_GC_SCAN_DEBUG=1): report
    // every pointer-bearing register scan_gc_regs leaves unhomed, with the
    // exclusion reason — the un-homed SSA spill families are what the
    // conservative main-stack cover exists to catch.
    gcscan_dbg: mut bool = false;
    // try/catch: declare @_setjmp (returns_twice, attr #1) and the #1 attr line.
    // Set in lower() from unit.has_suspension: emit_main spawns initials as
    // coroutines only in suspend mode (see there).
    suspend_mode: mut bool = false;
    icmp_results: mut _utils.List<string> = new _utils.List<string>();
    type_id_constants: mut _utils.List<TypeIdConstant> = new _utils.List<TypeIdConstant>();
    emitted_interface_ids: mut _utils.List<string> = new _utils.List<string>();
    // Set when a ref-map build hit a nested layout it could not resolve — the
    // affected type's metadata keeps a NULL refmap slot, which the collector
    // answers with the (sound) conservative body scan.
    refmap_failed: mut bool = false;
    // GC v2 phase 2 — precise frame roots (see gc.c EmperorGcFrame):
    // registers promoted to entry allocas because they can hold GC
    // references (single-def immutable ones join the mutable storage model),
    // their LLVM types, and the per-function descriptor slots.
    gc_only_regs: mut _utils.List<string> = new _utils.List<string>();
    gc_reg_llvm_types: mut _utils.List<string> = new _utils.List<string>();
    gc_frame_slots: mut _utils.List<GcSlotEntry> = new _utils.List<GcSlotEntry>();
    // The current function's frame local ("" when it has no descriptor) and
    // the entry-block gep of its prev field, used by every ret's unlink.
    // Set at SCAN time (gc_frame_predicted): the descriptor is emitted at
    // the END of the entry block — after late slot discovery — but rets are
    // emitted DURING the body and must already know whether to unlink.
    gc_frame_local: mut string = "";
    gc_frame_prev_gep: mut string = "";
    gc_frame_predicted: mut bool = false;
    // Function-value singletons (see ensure_funval): synthesized lazily when a
    // function's address is taken as a `fun` value. Function DEFINITIONS
    // (thunks) and their constant globals interleave freely — LLVM textual IR
    // is order-insensitive at module level — so one pending section suffices.
    // Pre-triggered by the EmitPlan sweep in emission order.
    pending_iface_ids: mut StringBuilder = new StringBuilder();
    pending_funvals: mut StringBuilder = new StringBuilder();
    emitted_funvals: mut _utils.List<string> = new _utils.List<string>();
    current_unit: Option<BoundCompilationUnit> = new Option<BoundCompilationUnit>.none();
    func_param_types: mut _utils.List<FuncParamTypes> = new _utils.List<FuncParamTypes>();
    current_sret_llvm_type: mut string = "";
    current_sret_param: mut string = "";
    // RVO / sret-elision state (reset per function by scan_sret_elision).
    sret_elision_map: mut _utils.List<SretElision> = new _utils.List<SretElision>();
    elided_assigns: mut _utils.List<i64> = new _utils.List<i64>();

    // ---- Lookup acceleration (_utils.StrMap<i64> string->i64 hashes) ----
    // The emitter's name lookups were linear list scans paying one string
    // content compare per element (find_class_layout's three passes even
    // paid two substring allocations per element); on the self-compile
    // profile those scans plus their allocation churn dominated the pure
    // code-speed gap to the pre-GC-v2 baseline. The maps memoize:
    //   per unit  — class/enum layout name -> index (+1; 0 = confirmed
    //               miss), func-param-types name -> index (+1; 0 = miss;
    //               the table is filled before emission and frozen), and
    //               the ensure_gc_layout flat def index below.
    //   per func  — reg name -> latest reg_type_map index, alloca name ->
    //               alloca_map index, mutable/gc-only membership, and the
    //               scan-pass flag sets (see each scan).
    // Layout maps are cleared (not updated) when ensure_*_layout appends a
    // new layout: a miss memoized before the layout existed must not
    // survive its creation. Layout creation is one-per-type — rare.
    fcl_memo: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    fel_memo: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    fpt_memo: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    gc_ensured_class: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    gc_ensured_enum: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    gc_defidx_class_names: mut _utils.List<string> = new _utils.List<string>();
    gc_defidx_class_defs: mut _utils.List<BoundClassDefinition> = new _utils.List<BoundClassDefinition>();
    gc_defidx_enum_names: mut _utils.List<string> = new _utils.List<string>();
    gc_defidx_enum_defs: mut _utils.List<BoundEnumDefinition> = new _utils.List<BoundEnumDefinition>();
    gc_defidx_built: mut bool = false;
    rtt_map: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    alloca_idx_map: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    mut_reg_map: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    // gc_only_regs name -> index+1 (gc_only_home's linear scan sat on the
    // register_llvm_type path — every def-site type registration).
    gconly_home_map: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    // scan_write_chains def table: (name, kind) -> instruction index (+1;
    // 0 = multi-def, excluded from chains). Two maps because the table is
    // keyed by BOTH display name and temp/named kind.
    wch_def_t: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    wch_def_n: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    // write_chain_regs / alias_assign_regs membership hashes (queried per
    // instruction on emission paths).
    wcr_map: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    aar_map: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    // Chain-pin mirrors (cover retirement): write-chain / alias-assign /
    // unbox registers homed as write-only PIN slots. Their pointer exists
    // only as an SSA/gep value (reg_map alias — lvalue addressing), so the
    // descriptor slot must PIN the target in place instead of promoting the
    // register onto storage (which would break lvalue emission).
    gc_chain_pin_regs: mut _utils.List<string> = new _utils.List<string>();
    gcpin_map: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    // Pin-mirror clear points (RSS): parallel lists (instruction index,
    // register name) sorted by index — the emission loop nulls %reg.gcpin
    // right after the instruction that LAST reads the register, so the pin
    // dies with the chain instead of living to frame exit (a stale mirror
    // keeps pinning the last target's chunk → 64KB page retention).
    gcpin_clear_idx: mut _utils.List<i64> = new _utils.List<i64>();
    gcpin_clear_name: mut _utils.List<string> = new _utils.List<string>();
    gcpin_clear_cursor: mut i64 = 0;
    // scan_gc_regs flag bits per register name (see scan_gc_regs).
    gcscan_flags: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    // scan_mutable_regs: first-occurrence order of const/assign-defined
    // names + duplicate/mixed markers for the order-preserving rewrite
    // (bits: 1=temp def seen, 2=named def seen, 4=mixed kinds, 8=dup name),
    // plus per-duplicate best-type candidates indexed by ordinal.
    smr_first_names: mut _utils.List<string> = new _utils.List<string>();
    smr_name_flags: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    smr_ord_map: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    smr_cand_best_llvm: mut _utils.List<string> = new _utils.List<string>();
    smr_cand_best_ir: mut _utils.List<string> = new _utils.List<string>();
    smr_cand_best_size: mut _utils.List<i64> = new _utils.List<i64>();
    smr_cand_line: mut _utils.List<i64> = new _utils.List<i64>();

    // Debug info state
    debug_enabled: mut bool = false;
    debug_id_counter: mut i64 = 0;
    debug_metadata: mut _utils.List<string> = new _utils.List<string>();
    debug_file_cache: mut _utils.List<RegMapping> = new _utils.List<RegMapping>();  // filename -> DIFile id
    current_compile_unit_id: mut string = "";
    current_file_id: mut string = "";
    current_subprogram_id: mut string = "";
    current_dbg: mut string = "";  // current instruction's !dbg suffix
    current_module_flags: mut string = "";  // module flags metadata IDs
    current_subroutine_type: mut string = "";  // DISubroutineType ID
    current_scope_dbg: mut string = "";  // !dbg for instructions without source loc

    // Debug variable support state
    debug_type_cache: mut _utils.List<RegMapping> = new _utils.List<RegMapping>();  // ir_type string -> metadata ID string
    mutable_reg_ir_types: mut _utils.List<string> = new _utils.List<string>();  // parallel to mutable_regs
    mutable_reg_lines: mut _utils.List<i64> = new _utils.List<i64>();  // parallel to mutable_regs (decl line)
    param_names: mut _utils.List<string> = new _utils.List<string>();  // reset per function
    current_scope_loc_id: mut string = "";  // bare metadata id of the function-scope DILocation
    current_loc_id: mut string = "";  // bare metadata id of the current instruction's DILocation

    // ---- Per-concern collaborator modules (batch 0.1 split) ----
    types: mut LLVMTypes;
    instructions: mut LLVMInstructions;
    objects: mut LLVMObjects;
    values: mut LLVMValues;
    calls: mut LLVMCalls;
    gcscan: mut LLVMGCScan;
    metadata: mut LLVMMetadata;
    debug: mut LLVMDebug;
    globals: mut LLVMGlobals;
    // The explicit emission plan (batch 1.1): built by the single
    // pre-emission sweep (EmitPlan.precollect) before any function body is
    // emitted; the emission trunk consumes it, the assembly stage reads it.
    // Re-created per lower() call — multi-unit compilations get a fresh plan.
    plan: mut EmitPlan;

    fun new(mut this) {
        this.types = new LLVMTypes(this);
        this.instructions = new LLVMInstructions(this);
        this.objects = new LLVMObjects(this);
        this.values = new LLVMValues(this);
        this.calls = new LLVMCalls(this);
        this.gcscan = new LLVMGCScan(this);
        this.metadata = new LLVMMetadata(this);
        this.debug = new LLVMDebug(this);
        this.globals = new LLVMGlobals(this);
        this.plan = new EmitPlan(this);
    }

    fun lower(mut this, module: IRModule, unit: BoundCompilationUnit) -> string {
        if (_utils.verbose_level >= 3) { _utils.trace_enter("Enter lower(module=" + module.to_string() + ")");
 }
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] Starting LLVM lowering..."); }
        this.string_lits = new _utils.List<StringLitEntry>();
        this.string_lit_index = new _utils.StrMap<i64>();
        this.next_str_id = 0;
        this.class_layouts = new _utils.List<ClassLayout>();
        this.array_meta_entries = new _utils.List<ArrayMetaEntry>();
        this.enum_layouts = new _utils.List<EnumLayout>();
        this.tmp_counter = 0;
        this.gcscan_dbg = _utils.getenv("EMPEROR_GC_SCAN_DEBUG") != "";
        // Suspension mode: only modules that actually contain suspension points
        // (wait forms / async spawns, stdlib channel code included) run their
        // initials on the coroutine scheduler; wait-free programs keep the
        // plain sequential main either way — flag-independent binaries keep
        // bootstrap md5 convergence intact.
        this.suspend_mode = unit.has_suspension;
        this.type_id_constants = new _utils.List<TypeIdConstant>();
        this.emitted_interface_ids = new _utils.List<string>();
        this.pending_funvals = new StringBuilder();
        this.emitted_funvals = new _utils.List<string>();
        this.func_param_types = new _utils.List<FuncParamTypes>();
        // Per-unit lookup acceleration state (see the field block).
        this.fcl_memo = new _utils.StrMap<i64>();
        this.fel_memo = new _utils.StrMap<i64>();
        this.fpt_memo = new _utils.StrMap<i64>();
        this.gc_ensured_class = new _utils.StrMap<i64>();
        this.gc_ensured_enum = new _utils.StrMap<i64>();
        this.gc_defidx_class_names = new _utils.List<string>();
        this.gc_defidx_class_defs = new _utils.List<BoundClassDefinition>();
        this.gc_defidx_enum_names = new _utils.List<string>();
        this.gc_defidx_enum_defs = new _utils.List<BoundEnumDefinition>();
        this.gc_defidx_built = false;
        this.current_unit = new Option<BoundCompilationUnit>.some(unit);
        this.plan = new EmitPlan(this);
        this.debug.debug_init_compile_unit(module.location.filename);
        // ---- Pre-emission sweep: the explicit EmitPlan (batch 1.1). One
        // pass over the module freezes the extern face, the string table,
        // the function-signature table, the type-layout closure, the
        // needs_*/has_* runtime-declaration booleans and the lazily-ensured
        // metadata tables (array/type-id/interface-id/funval) BEFORE any
        // function body is emitted. The emission trunk below consumes the
        // plan; only the emission-decision-dependent booleans (memcpy /
        // pin-refmap / string coercion) are still registered into it while
        // emitting.
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] Pre-collecting emit plan..."); }
        this.plan.precollect(module, unit);
        // Emit functions first to determine which runtime declarations are needed
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] Emitting functions..."); }
        let func_sb: mut StringBuilder = new StringBuilder();
        let saved_sb: mut StringBuilder = this.sb;
        this.sb = func_sb;
        this.emit_functions();
        this.emit_main(module);
        this.sb = saved_sb;
        // Now build the full output: types + globals + declarations + functions
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] Emitting type definitions..."); }
        this.metadata.emit_type_definitions();
        this.globals.emit_array_metadata();
        // Flush any interface ID constants that were lazily emitted during
        // function emission (vtable calls may reference interfaces whose
        // implementing classes haven't had their metadata emitted yet).
        this.sb.append(this.plan.pending_iface_ids.to_string());
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] Emitting global strings..."); }
        this.globals.emit_global_strings();
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] Emitting global variables..."); }
        this.globals.emit_global_variables(module);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] Emitting extern declarations..."); }
        this.globals.emit_extern_declarations_to(this.sb, module);
        this.globals.emit_extern_declarations_runtime_to(this.sb);
        this.sb.append("\n");
        this.sb.append(func_sb.to_string());
        // Synthesized function-value singletons (thunk defines + constant
        // globals), pre-triggered by the plan sweep in emission order.
        this.sb.append(this.plan.pending_funvals.to_string());
        // Emit debug metadata
        this.debug.debug_emit_metadata();
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin LLVM] LLVM lowering done"); }
        return this.sb.to_string();
    }

    fun precompute_function_signatures(mut this, module: IRModule) {
        _utils.trace_enter("Enter precompute_function_signatures");
        let fi: mut i64 = 0;
        while (fi < cast<i64>(module.functions.size())) {
            let func: IRFunction = module.functions.at(cast<u64>(fi)).some;
            let fpt: mut FuncParamTypes = new FuncParamTypes(this.globals.strip_global_prefix(func.name));
            fpt.ret_ir_type = func.return_type;
            let ppi: mut i64 = 0;
            while (ppi < cast<i64>(func.parameters.size())) {
                let pp: IRParameter = func.parameters.at(cast<u64>(ppi)).some;
                // void-as-unit: void-typed parameters are ELIDED from the
                // LLVM signature (emit_function skips p_llvm_type == "void"),
                // so the coercion table must skip them too — a table entry
                // for an elided slot shifted every later argument one slot
                // left at the call site (a `fun m(self, v)` method — the
                // untyped `self` parameter lowers to void — made the call
                // annotate its first REAL argument with the phantom void
                // slot: `call ..._m(void %t1)` — SpecializedImmutableSelfMethodParam).
                let pp_llvm: string = this.types.ir_type_to_llvm(pp.ir_type);
                if (pp_llvm != "void") {
                    fpt.param_types.push(pp_llvm);
                }
                if (ppi == 0 && pp.name == "this") {
                    fpt.first_param_is_this = true;
                    if (this.string_starts_with(pp.ir_type, "mut ")) {
                        fpt.first_param_mut_this = true;
                    }
                }
                ppi = ppi + 1;
            }
            this.func_param_types.push(fpt);
            fi = fi + 1;
        }
    }

    fun emit_functions(mut this) {
        if (_utils.verbose_level >= 3) { _utils.trace_enter("Enter emit_functions()");
 }
        // Canonical emission order (batch 1.2): the dedup (first spelling by
        // LLVM name) and the extern-without-body skip were decided by
        // plan.build_emission_order BEFORE the sweep, and the list is
        // stable-sorted by LLVM symbol name. Emitting in THIS order makes
        // the function section — and every order-dependent side effect that
        // rides it (tmp/cond/debug counters, the lazily-ensured tables) —
        // independent of the module's construction order (input file order,
        // specialization discovery order).
        // Every function's parameter signature was pre-computed by the
        // EmitPlan sweep (precollect) BEFORE any body emission, so
        // forward-reference call sites resolve callee param types via
        // find_func_param_types. Without this, emit_args_coerced defaults
        // the param type and produces by-ref vs by-val ABI mismatches (the
        // enum-param crash, mechanism D).
        let fi: mut i64 = 0;
        while (fi < cast<i64>(this.plan.emit_order.size())) {
            let func: IRFunction = this.plan.emit_order.at(cast<u64>(fi)).some;
            this.emit_function(func);
            if (this.verbose >= 2) { __builtin.eprintln("[EmperorPenguin LLVM]   Emitted function " + func.name); }
            fi = fi + 1;
        }
    }

    fun emit_function(mut this, func: IRFunction) {
        if (_utils.verbose_level >= 3) { _utils.trace_enter("Enter emit_function(func=" + func.to_string() + ")");
 }
        this.reg_map = new _utils.List<RegMapping>();
        this.reg_type_map = new _utils.List<RegMapping>();
        this.icmp_results = new _utils.List<string>();
        this.cond_counter = 0;
        this.current_ret_type = func.return_type;
        this.param_names = new _utils.List<string>();
        this.entry_alloca_names = new _utils.List<string>();
        this.write_chain_regs = new _utils.List<string>();
        this.alias_assign_regs = new _utils.List<string>();
        this.value_param_copies = new _utils.List<RegMapping>();
        this.struct_value_sources = new _utils.List<RegMapping>();
        this.struct_field_sources = new _utils.List<RegMapping>();
        // GC v2 per-function state — reset BEFORE the scans so a stale
        // gc_only_regs from the previous function cannot leak into
        // scan_mutable_regs' multi-def decisions (is_mutable_reg consults it).
        this.gc_only_regs = new _utils.List<string>();
        this.gc_reg_llvm_types = new _utils.List<string>();
        this.gc_frame_slots = new _utils.List<GcSlotEntry>();
        this.gc_frame_local = "";
        this.gc_frame_prev_gep = "";
        // Per-function lookup maps (mirror the lists reset above/below).
        this.rtt_map = new _utils.StrMap<i64>();
        this.mut_reg_map = new _utils.StrMap<i64>();
        this.gconly_home_map = new _utils.StrMap<i64>();
        this.wch_def_t = new _utils.StrMap<i64>();
        this.wch_def_n = new _utils.StrMap<i64>();
        this.wcr_map = new _utils.StrMap<i64>();
        this.aar_map = new _utils.StrMap<i64>();
        this.gc_chain_pin_regs = new _utils.List<string>();
        this.gcpin_map = new _utils.StrMap<i64>();
        this.gcpin_clear_idx = new _utils.List<i64>();
        this.gcpin_clear_name = new _utils.List<string>();
        this.gcpin_clear_cursor = 0;
        this.gcscan_flags = new _utils.StrMap<i64>();

        // Determine if this function returns an aggregate that needs sret (RVO)
        let use_sret: bool = !func.is_extern && this.types.needs_sret(func.return_type);
        if (use_sret) {
            this.current_sret_llvm_type = this.types.get_sret_llvm_type(func.return_type);
            this.current_sret_param = "%_sret_result";
        } else {
            this.current_sret_llvm_type = "";
            this.current_sret_param = "";
        }

        // Parameter types for call argument coercion are pre-computed for all
        // functions in emit_functions (precompute_function_signatures), so forward
        // references resolve. Nothing to populate here.
        // Map parameters: ARG instruction creates %tN → %paramname mapping
        let pi: mut i64 = 0;
        while (pi < cast<i64>(func.parameters.size())) {
            let p: IRParameter = func.parameters.at(cast<u64>(pi)).some;
            this.reg_map.push(new RegMapping("%" + p.name, "%" + p.name));
            this.param_names.push(p.name);
            let param_llvm_type: string = this.types.ir_type_to_llvm(p.ir_type);
            if (param_llvm_type != "") {
                this.values.register_llvm_type("%" + p.name, param_llvm_type);
            }
            pi = pi + 1;
        }

        // Pre-scan for RVO / sret-elision (must precede scan_mutable_regs so the
        // mutable-reg alloca can be sized to fit the callee's sret return type).
        this.gcscan.scan_sret_elision(func);

        // Pre-scan for mutable registers (reassigned multiple times)
        this.gcscan.scan_mutable_regs(func);

        // Pre-scan for write chains (WRMBR owners / method receivers that must
        // alias their slot instead of copying — see scan_write_chains).
        this.gcscan.scan_write_chains(func);

        // GC v2 phase 2: promote GC-reference registers to slots + build the
        // frame-descriptor slot list (must follow write chains — aliased
        // registers are skipped, their parent slot covers them).
        this.gcscan.scan_gc_regs(func);

        // Pin-mirror clear points (RSS) — after the mirrors are granted.
        this.gcscan.scan_gcpin_clears(func);

        // Initialize debug info for this function
        this.debug.debug_begin_function(func.name, func.location);
        let func_dbg: mut string = "";
        let dbg_on: bool = this.debug_enabled;
        if (dbg_on && this.current_subprogram_id != "") {
            func_dbg = " !dbg !" + this.current_subprogram_id;
        }

        // Build debug variables for parameters (dbg.value calls emitted in the entry block below).
        let param_dbg_sb: mut StringBuilder = new StringBuilder();
        if (dbg_on && !func.is_extern) {
            let pai: mut i64 = 0;
            while (pai < cast<i64>(func.parameters.size())) {
                let p: IRParameter = func.parameters.at(cast<u64>(pai)).some;
                let p_llvm_type: string = this.types.ir_type_to_llvm(p.ir_type);
                // void-as-unit: void params are elided from the signature; no dbg either
                if (p_llvm_type == "void") { pai = pai + 1; continue; }
                if (this.types.is_aggregate_llvm_type(p_llvm_type)) { pai = pai + 1; continue; }
                let var_id: string = this.debug.debug_make_local(p.name, p.ir_type, p.location.line, pai + 1);
                param_dbg_sb.append("  #dbg_value(" + p_llvm_type + " %" + p.name + ", !" + var_id + ", !DIExpression(), !" + this.current_scope_loc_id + ")\n");
                pai = pai + 1;
            }
        }

        // Emit function signature
        if (use_sret) {
            this.sb.append("define void " + this.globals.llvm_func_name(func.name) + "(ptr sret(" + this.current_sret_llvm_type + ") " + this.current_sret_param);
        } else {
            this.sb.append("define " + this.types.ir_type_to_llvm(func.return_type) + " " + this.globals.llvm_func_name(func.name) + "(");
        }
        // void-as-unit: void-typed parameters are elided from the LLVM
        // signature; call sites drop the matching void arguments (emit_args /
        // emit_args_coerced / emit_args_with_first) so the arities agree.
        let wrote_any_param: mut bool = use_sret;
        pi = 0;
        while (pi < cast<i64>(func.parameters.size())) {
            let p: IRParameter = func.parameters.at(cast<u64>(pi)).some;
            let p_llvm_type: string = this.types.ir_type_to_llvm(p.ir_type);
            if (p_llvm_type == "void") { pi = pi + 1; continue; }
            if (wrote_any_param) { this.sb.append(", "); }
            wrote_any_param = true;
            // For >16-byte aggregates (value-type classes and large enums), use
            // byval so clang passes the argument via a pointer consistently between
            // caller and callee (System V ABI for large structs).
            if (this.types.llvm_type_size(p_llvm_type) > 16) {
                this.sb.append("ptr byval(" + p_llvm_type + ") %" + p.name);
            } else {
                this.sb.append(p_llvm_type + " %" + p.name);
            }
            pi = pi + 1;
        }
        this.sb.append(")" + func_dbg + " {\n");
        this.sb.append("entry:\n");

        // For byval aggregate parameters (>16 bytes), register the parameter name as
        // a pointer so coerce_operand / materialize_enum_ptr correctly handle
        // ptr->struct loads.
        {
            let bi: mut i64 = 0;
            while (bi < cast<i64>(func.parameters.size())) {
                let p: IRParameter = func.parameters.at(cast<u64>(bi)).some;
                let p_llvm_type: string = this.types.ir_type_to_llvm(p.ir_type);
                if (this.types.llvm_type_size(p_llvm_type) > 16) {
                    this.values.register_llvm_type("%" + p.name, "ptr");
                }
                bi = bi + 1;
            }
        }

        // Value-copy semantics for value-class parameters: the ABI passes a
        // POINTER (ref<X> -> ptr), so a plain `mut` parameter would alias the
        // caller's storage and writes would leak back. Copy the pointee into
        // local storage at entry. `this` receivers are deliberately excluded —
        // they point at the caller's slot so mut-this methods (and
        // constructors) write through; method bodies already address `this`
        // as ptr-to-struct.
        if (!func.is_extern) {
            let ci: mut i64 = 0;
            while (ci < cast<i64>(func.parameters.size())) {
                let p: IRParameter = func.parameters.at(cast<u64>(ci)).some;
                if (p.name != "this" && p.name != "_sret_result") {
                    let vc_struct: string = this.types.value_class_struct_type(p.ir_type);
                    if (string_length(vc_struct) > 0) {
                        let copy_name: string = "%" + p.name + ".copy";
                        let vc_size: i64 = this.types.llvm_type_size(vc_struct);
                        this.sb.append("  " + copy_name + " = alloca " + vc_struct + "\n");
                        this.sb.append("  call void @llvm.memcpy.p0.p0.i32(ptr " + copy_name + ", ptr %" + p.name + ", i32 " + cast<string>(vc_size) + ", i1 false)\n");
                        this.plan.needs_memcpy = true;
                        this.value_param_copies.push(new RegMapping("%" + p.name, copy_name));
                        this.values.register_llvm_type(copy_name, "ptr");
                        // GC v2: the copy is the parameter's local storage —
                        // an inline struct home for the frame descriptor.
                        let cps: string = this.gcscan.gc_param_slot_for_ir_type(p.ir_type);
                        if (cps != "" && cps != "ptr null") {
                            this.gc_frame_slots.push(new GcSlotEntry(copy_name, cps));
                        }
                    } else {
                        // GC v2 slots for reference-carrying params: a scalar
                        // ref/string param gets a PIN-mirror alloca. The body's
                        // uses keep the SSA parameter, so live copies of the
                        // value ALSO sit in clang spill slots no descriptor can
                        // rewrite — the mirror therefore roots the object AND
                        // pins it in place (promotion would leave the spill
                        // copies pointing into a recycled chunk); a >16-byte
                        // aggregate is passed byval — the param IS the pointer
                        // to the caller's storage, walk the struct at it
                        // directly (that storage is the caller's own slot).
                        let pslot: string = this.gcscan.gc_param_slot_for_ir_type(p.ir_type);
                        if (pslot != "") {
                            let pt_base: string = this.types.value_class_struct_type(this.types.strip_mut_ir_prefix(p.ir_type));
                            let pt: string = if (string_length(pt_base) > 0) { pt_base } else { this.types.ir_type_to_llvm(p.ir_type) };
                            let psize: i64 = this.types.llvm_type_size(pt);
                            if (pslot != "ptr null" && psize > 16) {
                                this.gc_frame_slots.push(new GcSlotEntry("%" + p.name, pslot));
                            } else if (pslot == "ptr null") {
                                this.sb.append("  %" + p.name + ".gcaddr = alloca ptr\n");
                                this.sb.append("  store ptr %" + p.name + ", ptr %" + p.name + ".gcaddr\n");
                                this.gc_frame_slots.push(new GcSlotEntry("%" + p.name + ".gcaddr", "ptr @_emperor_gc_pin_refmap"));
                                this.plan.needs_gc_pin_refmap = true;
                            }
                        }
                    }
                }
                ci = ci + 1;
            }
            // GC v2: the receiver — a PIN-mirror slot when the receiver is a
            // reference object (method bodies use the SSA %this across every
            // poll; the pin keeps the receiver at its address for the call —
            // the same spill-copy exposure as scalar ref params). A
            // value-class/enum `this` is the STRUCT itself, passed by value —
            // no stable slot (the conservative scan covers it in this phase).
            if (cast<i64>(func.parameters.size()) > 0 && func.parameters.at(cast<u64>(0)).some.name == "this") {
                let this_it: string = func.parameters.at(cast<u64>(0)).some.ir_type;
                let this_slot: string = this.gcscan.gc_slot_for_ir_type(this_it);
                if (this_slot == "ptr null") {
                    this.sb.append("  %this.gcaddr = alloca ptr\n");
                    this.sb.append("  store ptr %this, ptr %this.gcaddr\n");
                    this.gc_frame_slots.push(new GcSlotEntry("%this.gcaddr", "ptr @_emperor_gc_pin_refmap"));
                    this.plan.needs_gc_pin_refmap = true;
                }
            }
        }

        // Emit allocas for mutable registers at function entry
        let ai: mut i64 = 0;
        while (ai < cast<i64>(this.mutable_regs.size())) {
            let name: string = this.mutable_regs.at(cast<u64>(ai)).some;
            let alloca_name: string = this.values.get_alloca_name(name);
            let llvm_type: string = this.values.get_llvm_type(name);
            // void-as-unit: a multi-def void register has no storage — every
            // def/use of it is dropped elsewhere (assign/args/ret), so an
            // `alloca void` here would only produce invalid IR.
            if (llvm_type == "" || llvm_type == "void") { ai = ai + 1; continue; }
            this.sb.append("  " + alloca_name + " = alloca " + llvm_type + "\n");
            // Zero-initialize mutable-reg allocas so i32-tag padding (and any other
            // partial-write gap) doesn't retain stack residuals — same rationale as
            // emit_entry_alloca's zero-init. Mutable locals are the value-type structs
            // (Option<BoundExpression>, BoundSymbol, SourceLocation, ...) the semantic
            // model builds on the stack; without this, their i32-tag stores leave the
            // upper 32 bits of the slot as a prior pointer's high bits, which composes
            // into a corrupted value that overwrites a return-address slot on stack
            // reuse → control-flow hijack (the binding crash at get_temp_folder,
            // RA = 0x555500000000).
            if (llvm_type != "" && llvm_type != "void") {
                this.sb.append("  store " + llvm_type + " zeroinitializer, ptr " + alloca_name + "\n");
            }
            // GC v2 phase 3a: pointer-bearing STRUCT mutable locals are frame
            // slots too (Option<...> accumulators holding heap objects).
            if (this.string_starts_with(llvm_type, "%class.") || this.string_starts_with(llvm_type, "%enum.")) {
                let mmap: string = this.metadata.gc_struct_refmap_operand(llvm_type);
                if (mmap != "") {
                    this.gc_frame_slots.push(new GcSlotEntry(alloca_name, mmap));
                }
            }
            if (dbg_on && !func.is_extern && !this.debug.is_debug_temp(name)) {
                let mr_ir_type: string = this.mutable_reg_ir_types.at(cast<u64>(ai)).some;
                let mr_line: i64 = this.mutable_reg_lines.at(cast<u64>(ai)).some;
                let clean_name: mut string = name;
                if (string_length(name) > 1 && string_char_at(name, 0) == "%") {
                    clean_name = string_substring(name, 1, string_length(name) - 1);
                }
                let var_id: string = this.debug.debug_make_local(clean_name, mr_ir_type, mr_line, 0);
                this.debug.emit_dbg_declare(alloca_name, var_id, this.current_scope_loc_id);
            }
            ai = ai + 1;
        }

        // GC v2 phase 2: allocas for the promoted GC registers (same model
        // as the mutable ones above — the storage holds one reference or one
        // inline value-class/enum struct, zero-initialized so early safepoint
        // polls never see a stale slot value).
        let gi: mut i64 = 0;
        while (gi < cast<i64>(this.gc_only_regs.size())) {
            let gname: string = this.gc_only_regs.at(cast<u64>(gi)).some;
            let galloca: string = this.values.get_alloca_name(gname);
            let gltype: string = this.gc_reg_llvm_types.at(cast<u64>(gi)).some;
            if (gltype == "" || gltype == "void") { gi = gi + 1; continue; }
            this.sb.append("  " + galloca + " = alloca " + gltype + "\n");
            this.sb.append("  store " + gltype + " zeroinitializer, ptr " + galloca + "\n");
            gi = gi + 1;
        }

        // Chain-pin mirrors (see scan_gc_regs): write-only PIN slots for
        // write-chain / alias-assign / unbox registers. Zero-initialized so
        // a poll before the def's mirror store sees NULL, never a stale
        // slot value from an earlier frame reusing the stack.
        let cpi: mut i64 = 0;
        while (cpi < cast<i64>(this.gc_chain_pin_regs.size())) {
            let cpname: string = this.gc_chain_pin_regs.at(cast<u64>(cpi)).some;
            this.sb.append("  " + cpname + ".gcpin = alloca ptr\n");
            this.sb.append("  store ptr null, ptr " + cpname + ".gcpin\n");
            cpi = cpi + 1;
        }

        // Emit parameter dbg.value calls in the entry block (after allocas).
        if (dbg_on && !func.is_extern) {
            this.sb.append(param_dbg_sb.to_string());
        }

        // Switch to body_sb for instruction emission and entry_allocas for alloca collection.
        // This ensures all alloca instructions land in the entry block (preventing stack growth in loops).
        let saved_sb: mut StringBuilder = this.sb;
        this.body_sb = new StringBuilder();
        this.entry_allocas = new StringBuilder();
        this.sb = this.body_sb;

        let block_terminated: mut bool = false;
        let ii: mut i64 = 0;
        while (ii < cast<i64>(func.instructions.size())) {
            let inst: IRInstruction = func.instructions.at(cast<u64>(ii)).some;
            let is_label: bool = inst is IRInstruction.label_inst;
            if (is_label) {
                if (block_terminated == false) {
                    this.sb.append("  br label %" + inst.label_inst.label_name + "\n");
                }
                block_terminated = false;
            }
            if (block_terminated == false) {
                // RVO: an elided ASSIGN (its source CALL wrote the value directly
                // into the destination's storage) must be skipped to avoid a
                // redundant/overflowing store.
                let skip_inst: bool = inst is IRInstruction.assign && this.gcscan.is_elided_assign(ii);
                if (!skip_inst) {
                    this.instructions.emit_instruction(inst);
                }
                // Pin-mirror clear (RSS): null %reg.gcpin right after the
                // instruction that last reads the register — the pin dies
                // with the chain instead of living to frame exit.
                while (this.gcpin_clear_cursor < cast<i64>(this.gcpin_clear_idx.size())
                    && this.gcpin_clear_idx.at(cast<u64>(this.gcpin_clear_cursor)).some == ii) {
                    this.instructions.emit_line("  store ptr null, ptr "
                        + this.gcpin_clear_name.at(cast<u64>(this.gcpin_clear_cursor)).some
                        + ".gcpin");
                    this.gcpin_clear_cursor = this.gcpin_clear_cursor + 1;
                }
            }
            if (inst is IRInstruction.br || inst is IRInstruction.br_cond || inst is IRInstruction.ret || inst is IRInstruction.ret_void) {
                block_terminated = true;
            }
            ii = ii + 1;
        }

        // Restore sb and emit: entry_allocas first, then the GC frame
        // descriptor (slot collection continues through body emission —
        // struct temps create entry allocas along the way), then body.
        //
        // The rets were emitted BEFORE that final slot set was known, so
        // emit_gc_frame_unlink writes the unlink unconditionally. A function
        // whose only slots appeared during body emission (or in the entry
        // parameter setup — e.g. a native `array<T>` parameter, which the
        // pre-scan prediction cannot classify) still gets a descriptor here,
        // so the unlinks are WANTED; one that ends with no slots gets them
        // stripped. Deciding it here is what makes every ret consistent:
        // deciding at ret-emission time leaked the descriptor onto the frame
        // chain forever, and later calls then chained their `prev` through
        // the dead, stack-reused frame (the corrupt-ref-map / lost-wake mt
        // crash family).
        this.sb = saved_sb;
        this.sb.append(this.entry_allocas.to_string());
        let framed: bool = this.emit_gc_frame_descriptor();
        if (framed) {
            this.sb.append(this.body_sb.to_string());
        } else {
            this.sb.append(this.strip_gc_frame_unlinks(this.body_sb.to_string()));
        }
        this.sb.append("}\n\n");
    }

    // Remove the optimistic ret-side unlinks from a body whose function
    // ended up with no frame descriptor. The two lines are identified by
    // content — `%__gcf.prev` and `_emperor_gc_frame_set` occur in the body
    // only as an unlink pair (the entry link lives in the descriptor block,
    // which is emitted before this body).
    fun strip_gc_frame_unlinks(this, body: string) -> string {
        let out: mut StringBuilder = new StringBuilder();
        let pos: mut i64 = 0;
        let total: i64 = string_length(body);
        while (pos < total) {
            let nl: mut i64 = string_find_from(body, "\n", pos);
            if (nl < 0) { nl = total; }
            let line: string = string_substring(body, pos, nl - pos);
            pos = nl + 1;
            if (string_find_from(line, "%__gcf.prev", 0) >= 0
                || string_find_from(line, "@_emperor_gc_frame_set", 0) >= 0) {
                continue;
            }
            out.append(line);
            out.append("\n");
        }
        return out.to_string();
    }

    // GC v2: the frame descriptor — { prev, slot_count, slots } linked onto
    // the current stack's chain. Emitted at the END of the entry block (all
    // referenced allocas and their zero-initializers precede it), every ret
    // restores the head from prev (the try/throw path restores it from the
    // try frame — scheduler.c).
    fun emit_gc_frame_descriptor(mut this) -> bool {
        // Predicted functions get a frame even with zero slots: their rets
        // already emitted the unlink (slot discovery finishes after the
        // body), so the frame local must exist regardless.
        if (cast<i64>(this.gc_frame_slots.size()) == 0 && !this.gc_frame_predicted) { return false; }
        let nslots: i64 = cast<i64>(this.gc_frame_slots.size());
        let ftype: string = "{ ptr, i32, [" + cast<string>(nslots) + " x { ptr, ptr }] }";
        this.sb.append("  %__gcf = alloca " + ftype + "\n");
        this.sb.append("  %__gcf.prev = getelementptr " + ftype + ", ptr %__gcf, i32 0, i32 0\n");
        this.sb.append("  %__gcf.n = getelementptr " + ftype + ", ptr %__gcf, i32 0, i32 1\n");
        this.sb.append("  %__gcf.save = call ptr @_emperor_gc_frame_get()\n");
        this.sb.append("  store ptr %__gcf.save, ptr %__gcf.prev\n");
        this.sb.append("  store i32 " + cast<string>(nslots) + ", ptr %__gcf.n\n");
        this.sb.append("  call void @_emperor_gc_frame_set(ptr %__gcf)\n");
        let si: mut i64 = 0;
        while (si < nslots) {
            let slot: GcSlotEntry = this.gc_frame_slots.at(cast<u64>(si)).some;
            this.sb.append("  %__gcf.s" + cast<string>(si) + ".a = getelementptr " + ftype + ", ptr %__gcf, i32 0, i32 2, i32 " + cast<string>(si) + ", i32 0\n");
            this.sb.append("  %__gcf.s" + cast<string>(si) + ".m = getelementptr " + ftype + ", ptr %__gcf, i32 0, i32 2, i32 " + cast<string>(si) + ", i32 1\n");
            this.sb.append("  store ptr " + slot.addr + ", ptr %__gcf.s" + cast<string>(si) + ".a\n");
            this.sb.append("  store " + slot.map_operand + ", ptr %__gcf.s" + cast<string>(si) + ".m\n");
            si = si + 1;
        }
        this.gc_frame_local = "%__gcf";
        this.gc_frame_prev_gep = "%__gcf.prev";
        return true;
    }

    fun emit_main(mut this, module: IRModule) {
        if (_utils.verbose_level >= 3) { _utils.trace_enter("Enter emit_main(module=" + module.to_string() + ")");
 }
        if (cast<i64>(module.entry_functions.size()) > 0 || cast<i64>(module.init_functions.size()) > 0) {

            this.sb.append("define i32 @main(i32 %argc, ptr %argv) {\n");
            this.sb.append("entry:\n");
            // Increase stack limit early (before any deep recursion).
            // The semantic analysis passes use deep recursion and may overflow
            // the default 8 MB stack, causing intermittent SIGSEGV.
            this.sb.append("  call void @_emperor_boost_stack()\n");
            // Initialize args
            this.sb.append("  call void @_emperor_args_init(i32 %argc, ptr %argv)\n");
            // Initialize GC
            this.sb.append("  %_gc_sp = call ptr @llvm.frameaddress(i32 0)\n");
            this.sb.append("  call void @_emperor_gc_init(ptr %_gc_sp)\n");
            // Batch 1.2/1.3: every loop below walks a canonical index order
            // (symbol name) so @main's body — like every other section — no
            // longer depends on the module's construction order. The
            // registrations are order-independent (root set / initialization
            // of distinct globals), so reordering is semantically neutral.
            let gkeys: mut _utils.List<string> = new _utils.List<string>();
            let gk: mut i64 = 0;
            while (gk < cast<i64>(module.global_variables.size())) {
                gkeys.push(sanitize_name(module.global_variables.at(cast<u64>(gk)).some.name));
                gk = gk + 1;
            }
            let gidx: _utils.List<i64> = merge_sort_string_indices(gkeys);
            // Register global reference-type variables as GC roots. A
            // value-class global stores its STRUCT inline, so a single-slot
            // root would only cover the metadata word — register the whole
            // struct as a conservative SCAN REGION instead (every
            // pointer-looking field, e.g. strings, stays reachable).
            let gi: mut i64 = 0;
            while (gi < cast<i64>(gidx.size())) {
                let gv: IRGlobalVariable = module.global_variables.at(cast<u64>(gidx.at_unchecked(cast<u64>(gi)))).some;
                let global_name: string = "@" + sanitize_name(gv.name);
                let vc_struct: string = this.types.value_class_struct_type(gv.ir_type);
                if (string_length(vc_struct) > 0) {
                    let vc_size: i64 = this.types.llvm_type_size(vc_struct);
                    // Match the std extern's ABI (_gc_scan_add(addr: u64, size: i64)).
                    let addr_tmp: string = this.values.next_tmp();
                    this.sb.append("  " + addr_tmp + " = ptrtoint ptr " + global_name + " to i64\n");
                    this.sb.append("  call void @_emperor_gc_scan_add(i64 " + addr_tmp + ", i64 " + cast<string>(vc_size) + ")\n");
                } else if (this.types.is_string_type(gv.ir_type) || this.types.is_ref_type(gv.ir_type)) {
                    this.sb.append("  call void @_emperor_gc_add_root(ptr " + global_name + ")\n");
                } else {
                    // ENUM-typed global: storage is an inline {meta, tag,
                    // payload} struct whose payload may hold references
                    // (Option<T>/Result<T,E>/user enums) — register the whole
                    // struct as a conservative scan region like value-class
                    // globals. Without this the payload's referent is
                    // unrooted; the v2 nursery masked it (promotion made the
                    // closure effectively immortal), the single-generation
                    // greentea collector judges it dead every cycle
                    // (LambdaCaptureGcOptionPayload).
                    let enum_lt: string = this.types.ir_type_to_llvm(gv.ir_type);
                    if (this.string_starts_with(enum_lt, "%enum.")) {
                        let enum_name: string = string_substring(enum_lt, 6, string_length(enum_lt) - 6);
                        if (this.types.find_enum_layout(enum_name).is_none()) {
                            this.gcscan.ensure_gc_layout(enum_name, false);
                        }
                        let found_enum: Option<EnumLayout> = this.types.find_enum_layout(enum_name);
                        if (found_enum.is_some()) {
                            let enum_size: i64 = this.types.llvm_type_size(enum_lt);
                            if (enum_size > 0) {
                                let addr_tmp: string = this.values.next_tmp();
                                this.sb.append("  " + addr_tmp + " = ptrtoint ptr " + global_name + " to i64\n");
                                this.sb.append("  call void @_emperor_gc_scan_add(i64 " + addr_tmp + ", i64 " + cast<string>(enum_size) + ")\n");
                            }
                        }
                    }
                }
                gi = gi + 1;
            }
            // Initialize global variables with non-trivial initializers
            // (canonical index order, see the gidx note above).
            gi = 0;
            while (gi < cast<i64>(gidx.size())) {
                let gv: IRGlobalVariable = module.global_variables.at(cast<u64>(gidx.at_unchecked(cast<u64>(gi)))).some;
                if (this.types.is_string_type(gv.ir_type) && gv.initializer_value != "null" && gv.initializer_value != "") {
                    let val: string = strip_string_quotes(gv.initializer_value);
                    let entry: Option<StringLitEntry> = this.globals.find_string_lit(val);
                    if (entry.is_some()) {
                        let global_name: string = "@" + sanitize_name(gv.name);
                        this.sb.append("  store ptr " + entry.some.global_name() + ", ptr " + global_name + "\n");
                    }
                }
                gi = gi + 1;
            }
            // Call global init functions (non-literal initializers).
            // Deliberately MODULE order (NOT canonical): initialization and
            // entry routines are EXECUTION-order semantics (RTL construct
            // order; the scheduler drains spawns FIFO) — reordering them
            // would change program behavior, not just output layout.
            let ini: mut i64 = 0;
            while (ini < cast<i64>(module.init_functions.size())) {
                let init_func: IRFunction = module.init_functions.at(cast<u64>(ini)).some;
                this.sb.append("  call void " + this.globals.llvm_func_name(init_func.name) + "()\n");
                ini = ini + 1;
            }
            let i: mut i64 = 0;
            let spawned: mut bool = false;
            while (i < cast<i64>(module.entry_functions.size())) {
                let entry: IRFunction = module.entry_functions.at(cast<u64>(i)).some;
                if (this.suspend_mode) {
                    // Initial routines run as coroutines on their own stacks: a
                    // wait inside an initial (or anything it calls) parks that
                    // coroutine instead of being a compile error. With no waits,
                    // the scheduler drains the ready queue FIFO to completion —
                    // sequentially equivalent to the old direct calls.
                    this.sb.append("  call void @_emperor_co_spawn_fn0(ptr " + this.globals.llvm_func_name(entry.name) + ")\n");
                    spawned = true;
                } else {
                    // Wait-free module: plain sequential entry call (no scheduler
                    // runtime linked, binary identical with/without the flag).
                    this.sb.append("  call void " + this.globals.llvm_func_name(entry.name) + "()\n");
                }
                i = i + 1;
            }
            // init_functions (global initializers, __construct elaboration)
            // may have spawned coroutines of their own (module constructors
            // spawn class initials) — sched_run also when only those ran; an
            // empty ready queue returns immediately. Suspend mode only.
            if (this.suspend_mode && (spawned || cast<i64>(module.init_functions.size()) > 0)) {
                
                // Call the compiled scheduler loop directly (sanitize of
                // "__builtin.__sched_run"): scheduler.penguin is auto-loaded
                // with --enable-coroutine, so a suspending module always
                // defines it — no C trampoline. The loop returns i64; main
                // returns i32 (exit codes are small, trunc is exact).
                let run_tmp: string = this.values.next_tmp();
                let trunc_tmp: string = this.values.next_tmp();
                this.sb.append("  " + run_tmp + " = call i64 @__builtin___sched_run()\n");
                this.sb.append("  " + trunc_tmp + " = trunc i64 " + run_tmp + " to i32\n");
                this.sb.append("  ret i32 " + trunc_tmp + "\n");
            } else {
                this.sb.append("  ret i32 0\n");
            }
            this.sb.append("}\n");
        }
    }

    // --- Cast operation mapping ---

    fun cast_op(this, from: string, to: string) -> string {
        if (_utils.verbose_level >= 3) { _utils.trace_enter("Enter cast_op(from=" + cast<string>(from) + ", to=" + cast<string>(to) + ")");
 }
        // Integer widening
        if (from == "i8" && to == "i16") { return "zext"; }
        if (from == "i8" && to == "i32") { return "zext"; }
        if (from == "i8" && to == "i64") { return "zext"; }
        if (from == "i16" && to == "i32") { return "zext"; }
        if (from == "i16" && to == "i64") { return "zext"; }
        if (from == "i32" && to == "i64") { return "zext"; }
        // Integer truncation
        if (from == "i64" && to == "i32") { return "trunc"; }
        if (from == "i64" && to == "i16") { return "trunc"; }
        if (from == "i64" && to == "i8") { return "trunc"; }
        if (from == "i32" && to == "i16") { return "trunc"; }
        if (from == "i32" && to == "i8") { return "trunc"; }
        if (from == "i16" && to == "i8") { return "trunc"; }
        // Bool → integer
        if (from == "i8" && (to == "i16" || to == "i32" || to == "i64")) { return "zext"; }
        // Integer → float
        if (from == "i32" && to == "float") { return "sitofp"; }
        if (from == "i64" && to == "float") { return "sitofp"; }
        if (from == "i32" && to == "double") { return "sitofp"; }
        if (from == "i64" && to == "double") { return "sitofp"; }
        // Float → integer
        if (from == "float" && to == "i32") { return "fptosi"; }
        if (from == "float" && to == "i64") { return "fptosi"; }
        if (from == "double" && to == "i32") { return "fptosi"; }
        if (from == "double" && to == "i64") { return "fptosi"; }
        // Float precision
        if (from == "float" && to == "double") { return "fpext"; }
        if (from == "double" && to == "float") { return "fptrunc"; }
        // Raw pointer<->integer and pointer<->pointer reinterpret, dispatched
        // purely on IR types. References lower to LLVM ptr; these conversions
        // are only reachable through compiler-internal channels now (the
        // unsafe_cast keyword is gone) — e.g. checked casts the binder proves
        // to be pointer-shaped.
        if (from == "ptr" && (to == "i64" || to == "i32" || to == "i16" || to == "i8")) { return "ptrtoint"; }
        if ((from == "i64" || from == "i32" || from == "i16" || from == "i8") && to == "ptr") { return "inttoptr"; }
        return "bitcast";
    }

    fun string_ends_with(this, s: string, suffix: string) -> bool {
        let suffix_len: i64 = string_length(suffix);
        let s_len: i64 = string_length(s);
        if (s_len < suffix_len) { return false; }
        let i: mut i64 = 0;
        while (i < suffix_len) {
            if (string_char_code_at(s, s_len - suffix_len + i) != string_char_code_at(suffix, i)) { return false; }
            i = i + 1;
        }
        return true;
    }

    fun string_starts_with(this, s: string, prefix: string) -> bool {
        if (_utils.verbose_level >= 3) { _utils.trace_enter("Enter string_starts_with(s=" + cast<string>(s) + ", prefix=" + cast<string>(prefix) + ")");
 }
        let prefix_len: i64 = string_length(prefix);
        if (string_length(s) < prefix_len) { return false; }
        let i: mut i64 = 0;
        while (i < prefix_len) {
            // char_code_at compares by integer — string_char_at would
            // allocate a fresh 1-char string per position (two per compare),
            // and this predicate sits on every hot classification path.
            if (string_char_code_at(s, i) != string_char_code_at(prefix, i)) { return false; }
            i = i + 1;
        }
        return true;
    }
}

}
