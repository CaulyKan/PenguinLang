// Pure helper functions of the LLVM emitter (batch 0.1 split): string/
// number utilities that touch no emitter state (SemanticShared-style
// namespace-level free functions).
namespace emperor {


    // --- BINOP mapping ---

    fun binop_to_llvm(op: string, ir_type: string) -> string {
        if (_utils.verbose_level >= 3) { _utils.trace_enter("Enter binop_to_llvm(op=" + cast<string>(op) + ", ir_type=" + cast<string>(ir_type) + ")");
 }
        let is_float: bool = ir_type == "f32" || ir_type == "f64";
        if (op == "add") { if (is_float) { return "fadd"; } return "add"; }
        if (op == "sub") { if (is_float) { return "fsub"; } return "sub"; }
        if (op == "mul") { if (is_float) { return "fmul"; } return "mul"; }
        if (op == "div") { if (is_float) { return "fdiv"; } return "sdiv"; }
        if (op == "mod") { if (is_float) { return "frem"; } return "srem"; }
        if (op == "eq") { if (is_float) { return "fcmp oeq"; } return "icmp eq"; }
        if (op == "ne") { if (is_float) { return "fcmp une"; } return "icmp ne"; }
        if (op == "slt") { if (is_float) { return "fcmp olt"; } return "icmp slt"; }
        if (op == "sgt") { if (is_float) { return "fcmp ogt"; } return "icmp sgt"; }
        if (op == "sle") { if (is_float) { return "fcmp ole"; } return "icmp sle"; }
        if (op == "sge") { if (is_float) { return "fcmp oge"; } return "icmp sge"; }
        if (op == "ult") { return "icmp ult"; }
        if (op == "ugt") { return "icmp ugt"; }
        if (op == "ule") { return "icmp ule"; }
        if (op == "uge") { return "icmp uge"; }
        if (op == "and") { return "and"; }
        if (op == "or") { return "or"; }
        if (op == "xor") { return "xor"; }
        __builtin.eprintln("error[E_INTERNAL]: Unhandled LLVM op in llvm_op_to_llvm"); __builtin.exit(1);
        return "add";
    }

    fun sanitize_name(name: string) -> string {
        if (_utils.verbose_level >= 3) { _utils.trace_enter("Enter sanitize_name(name=" + cast<string>(name) + ")");
 }
        let sb2: mut StringBuilder = new StringBuilder();
        let len: i64 = string_length(name);
        let i: mut i64 = 0;
        while (i < len) {
            let ch: string = string_char_at(name, i);
            // `:` appears in synthetic source names (dyn-lib sources are
            // "<lib>:<name>" → file namespaces like _ns___lib:std_xxxx).
            if (ch == "<" || ch == ">" || ch == " " || ch == "," || ch == "." || ch == ":") {
                sb2.append("_");
            } else {
                sb2.append(ch);
            }
            i = i + 1;
        }
        return sb2.to_string();
    }

    fun is_wider_int(a: string, b: string) -> bool {
        if (_utils.verbose_level >= 3) { _utils.trace_enter("Enter is_wider_int(a=" + cast<string>(a) + ", b=" + cast<string>(b) + ")");
 }
        let wa: i64 = int_width(a);
        let wb: i64 = int_width(b);
        return wa > wb;
    }

    fun int_width(t: string) -> i64 {
        if (_utils.verbose_level >= 3) { _utils.trace_enter("Enter int_width(t=" + cast<string>(t) + ")");
 }
        if (t == "i8") { return 8; }
        if (t == "i16") { return 16; }
        if (t == "i32") { return 32; }
        if (t == "i64") { return 64; }
        return 0;
    }

    // LLVM float/double constants must contain a '.' or an exponent ('e'/'E')
    // (e.g. "3.5", "1e5"); a bare integer literal like "3" is invalid and
    // rejected by clang ("integer constant must have integer type"). Append
    // ".0" to such literals; negative literals ("-3.5") and scientific
    // notation ("1e5") are left untouched.
    fun normalize_float_literal(value: string) -> string {
        if (_utils.verbose_level >= 3) { _utils.trace_enter("Enter normalize_float_literal(value=" + cast<string>(value) + ")");
 }
        let len: i64 = string_length(value);
        let i: mut i64 = 0;
        while (i < len) {
            let ch: string = string_char_at(value, i);
            if (ch == "." || ch == "e" || ch == "E") { return value; }
            i = i + 1;
        }
        return value + ".0";
    }

    fun list_contains(list: _utils.List<string>, value: string) -> bool {
        if (_utils.verbose_level >= 3) { _utils.trace_enter("Enter list_contains(value=" + cast<string>(value) + ")");
 }
        let i: mut i64 = 0;
        while (i < cast<i64>(list.size())) {
            if (list.at(cast<u64>(i)).some == value) { return true; }
            i = i + 1;
        }
        return false;
    }

    // s ends with suffix, compared by char codes (no substring allocation).
    // Caller guarantees string_length(s) >= string_length(suffix).
    fun string_suffix_eq(s: string, suffix: string) -> bool {
        let sl: i64 = string_length(s);
        let fl: i64 = string_length(suffix);
        let i: mut i64 = 0;
        while (i < fl) {
            if (string_char_code_at(s, sl - fl + i) != string_char_code_at(suffix, i)) { return false; }
            i = i + 1;
        }
        return true;
    }

    fun strip_string_quotes(s: string) -> string {
        if (_utils.verbose_level >= 3) { _utils.trace_enter("Enter strip_string_quotes(s=" + cast<string>(s) + ")");
 }
        let len: i64 = string_length(s);
        let inner: mut string = s;
        if (len >= 2 && string_char_at(s, 0) == "\"" && string_char_at(s, len - 1) == "\"") {
            inner = string_substring(s, 1, len - 2);
        }
        return unescape_string(inner);
    }

    // Decode C-style escape sequences in a string literal's inner text, matching
    // the BabyPenguin reference VM's UnescapeString (RuntimeFrame.cs). This is
    // essential for self-hosting: without it, `"\n"` keeps its two literal bytes
    // (backslash + 'n'), so when EmperorPenguin compiles *itself* the Lexer's
    // newline check `ch == "\n"` (ch is a real 0x0A) never matches, line tracking
    // collapses to line 1, every string literal's "\n" prints as literal `\n`,
    // and escape_llvm_string's `ch == "\n"` branch never fires. The cascade is
    // sound because Pass 1 runs on the VM (which decodes these same literals), so
    // it emits already-decoded `@str_N` globals and Pass 2 inherits real control
    // characters in every `"\n"`/`"\t"`/... constant.
    fun unescape_string(s: string) -> string {
        if (_utils.verbose_level >= 3) { _utils.trace_enter("Enter unescape_string(s=" + cast<string>(s) + ")");
 }
        let sb2: mut StringBuilder = new StringBuilder();
        let len: i64 = string_length(s);
        let i: mut i64 = 0;
        while (i < len) {
            let ch: string = string_char_at(s, i);
            if (ch == "\\" && i + 1 < len) {
                let next: string = string_char_at(s, i + 1);
                if (next == "n") { sb2.append("\n"); i = i + 2; }
                else if (next == "t") { sb2.append("\t"); i = i + 2; }
                else if (next == "r") { sb2.append("\r"); i = i + 2; }
                else if (next == "\\") { sb2.append("\\"); i = i + 2; }
                else if (next == "\"") { sb2.append("\""); i = i + 2; }
                else if (next == "'") { sb2.append("'"); i = i + 2; }
                else if (next == "0") { sb2.append("\0"); i = i + 2; }
                else { sb2.append(ch); i = i + 1; }
            } else {
                sb2.append(ch);
                i = i + 1;
            }
        }
        return sb2.to_string();
    }

    // --- String escaping for LLVM c"..." format ---
    // LLVM c"..." uses \xx hex escapes only. No \\ or \" escapes exist.

    // UTF-8 byte length of a literal, host-independent (see the literal
    // emission note): the C# VM counts UTF-16 units in string_length while
    // the .ll's array type and the native runtime's header length field
    // need BYTES. Code-point weighting gives UTF-8 bytes there and the
    // plain byte count on native (a native "char" is one byte 0-255, which
    // never lands in the surrogate range).
    fun utf8_byte_len(s: string) -> i64 {
        // Host probe: on the C# VM the probe literal is ONE UTF-16 unit; on
        // native it is its 3 UTF-8 bytes. Byte hosts are already accurate
        // through string_length; only UTF-16 hosts need the weighting.
        if (string_length("中") != 1) {
            return string_length(s);
        }
        let n: i64 = string_length(s);
        let total: mut i64 = 0;
        let i: mut i64 = 0;
        while (i < n) {
            let c: i64 = string_char_code_at(s, i);
            if (c < 0x80) {
                total = total + 1;
            } else {
                if (c < 0x800) {
                    total = total + 2;
                } else {
                    if (c >= 0xD800 && c <= 0xDBFF) {
                        // surrogate pair: one code point, 4 UTF-8 bytes
                        total = total + 4;
                        i = i + 1;
                    } else {
                        if (c < 0x10000) {
                            total = total + 3;
                        } else {
                            total = total + 4;
                        }
                    }
                }
            }
            i = i + 1;
        }
        return total;
    }

    // ---- Canonical-order sort (batch 1.2) ----

    // Bottom-up (iterative) STABLE merge sort over a key list, returning the
    // list of INDICES in ascending lexicographic key order — i.e.
    // keys.at(order.at(i)) is non-decreasing, and equal keys keep their
    // original relative order. Index-based so one routine serves every
    // canonical-ordering site of the emitter (functions by LLVM symbol name,
    // string literals by content, class/enum metadata by type name, globals
    // and extern declares by symbol); O(n log n) comparisons, O(n) scratch,
    // no recursion (the self-compile has thousands of functions).
    // Keys are compared with string.compare (unit-wise lexicographic; every
    // emitted symbol goes through sanitize_name, so keys are plain ASCII).
    fun merge_sort_string_indices(keys: _utils.List<string>) -> _utils.List<i64> {
        let n: i64 = cast<i64>(keys.size());
        let a: mut _utils.List<i64> = new _utils.List<i64>();
        let b: mut _utils.List<i64> = new _utils.List<i64>();
        let i: mut i64 = 0;
        while (i < n) {
            a.push(i);
            b.push(0);
            i = i + 1;
        }
        let width: mut i64 = 1;
        while (width < n) {
            // One pass: merge adjacent run pairs [lo,lo+width)+[lo+width,lo+2w)
            // from a into b.
            let lo: mut i64 = 0;
            while (lo < n) {
                let mid: i64 = if (lo + width < n) { lo + width } else { n };
                let hi: i64 = if (lo + width + width < n) { lo + width + width } else { n };
                let li: mut i64 = lo;
                let ri: mut i64 = mid;
                let k: mut i64 = lo;
                while (k < hi) {
                    // Stable: the left run wins ties (<=).
                    let take_left: bool = ri >= hi
                        || (li < mid && keys.at_unchecked(cast<u64>(li)).compare(keys.at_unchecked(cast<u64>(ri))) <= 0);
                    if (take_left) {
                        b.set(cast<u64>(k), a.at_unchecked(cast<u64>(li)));
                        li = li + 1;
                    } else {
                        b.set(cast<u64>(k), a.at_unchecked(cast<u64>(ri)));
                        ri = ri + 1;
                    }
                    k = k + 1;
                }
                lo = lo + width + width;
            }
            // Swap the buffers (List is a reference type; a mutable binding
            // so the reassignment chain passes the mutability check).
            let mut t = a;
            a = b;
            b = t;
            width = width + width;
        }
        return a;
    }

    fun escape_llvm_string(s: string) -> string {
        if (_utils.verbose_level >= 3) { _utils.trace_enter("Enter escape_llvm_string(s=" + cast<string>(s) + ")");
 }
        let sb2: mut StringBuilder = new StringBuilder();
        let len: i64 = string_length(s);
        let i: mut i64 = 0;
        while (i < len) {
            let ch: string = string_char_at(s, i);
            if (ch == "\\") {
                sb2.append("\\5C");
            } else {
                if (ch == "\"") {
                    sb2.append("\\22");
                } else {
                    if (ch == "\n") {
                        sb2.append("\\0A");
                    } else {
                        if (ch == "\r") {
                            sb2.append("\\0D");
                        } else {
                            if (ch == "\t") {
                                sb2.append("\\09");
                            } else {
                                sb2.append(ch);
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        return sb2.to_string();
    }

}
