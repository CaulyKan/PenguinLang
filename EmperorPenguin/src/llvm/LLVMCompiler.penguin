namespace emperor {

// The output pipeline: IR generation + LLVM lowering, written as a
// platform-independent .ll file. Linking (clang, the C runtime archive, the
// meta/JIT archives, stack flags) lives OUTSIDE the compiler — in the
// `emperor` / `emperor.bat` driver scripts — so one .ll serves every link
// target (linux native, linux->win cross, native windows).
class LLVMCompiler {
    verbose: mut i64 = 0;

    fun new(mut this) {}

    // IR-generate + LLVM-lower + write the .ll file.
    fun build_ll(mut this, result: BoundCompilationUnit, ll_path: string) -> bool {
        let mut generator = new IRGenerator();
        generator.verbose = this.verbose;
        let module = generator.generate(result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin] IR generation done"); }

        let mut emitter = new LLVMEmitter();
        emitter.verbose = this.verbose;
        let llvm_ir: string = emitter.lower(module, result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin] LLVM IR generation done"); }

        _utils.file_write_text(ll_path, llvm_ir);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin] Wrote " + ll_path); }
        return true;
    }

    // Emit an lld-link /DEF file listing every extern the module declares
    // (the JIT's DynamicLibrarySearchGenerator resolves host symbols through
    // the process export table, so each declared extern must be exported).
    // Only consumed by the native-Windows-LLVM meta link flavor; the driver
    // script picks it up next to the .ll when needed.
    fun write_export_def(mut this, ll_path: string, def_path: string) {
        let text: string = _utils.file_read_text(ll_path);
        let out: mut _utils.List<string> = new _utils.List<string>();
        out.push("EXPORTS");
        let pos: mut i64 = 0;
        let len: i64 = string_length(text);
        while (pos >= 0 && pos < len) {
            let d: i64 = string_find_from(text, "declare ", pos);
            if (d < 0) { break; }
            let at: i64 = string_find_from(text, "@", d);
            let line_end: i64 = string_find_from(text, "\n", d);
            if (at > d && (line_end < 0 || at < line_end)) {
                let name_end : mut i64 = string_find_from(text, "(", at);
                if (name_end < 0 || (line_end >= 0 && name_end > line_end)) {
                    name_end = line_end;
                }
                if (name_end > at + 1) {
                    let name: string = string_substring(text, at + 1, name_end - at - 1);
                    // llvm.* intrinsics resolve inside LLVM itself; only host
                    // externs need export entries. _emperor_sjlj_setjmp is a
                    // MARKER extern (every call is inlined to a direct _setjmp
                    // by the emitter) — it has no definition anywhere, and a
                    // /DEF entry for it is an unresolved external at link.
                    if (string_length(name) > 0
                        && !(string_length(name) > 5 && string_substring(name, 0, 5) == "llvm.")
                        && name != "_emperor_sjlj_setjmp") {
                        out.push("  " + name);
                    }
                }
            }
            pos = line_end;
        }
        let body: mut string = "";
        let oi: mut i64 = 0;
        while (oi < cast<i64>(out.size())) {
            body = body + out.at(cast<u64>(oi)).some + "\n";
            oi = oi + 1;
        }
        _utils.file_write_text(def_path, body);
    }
}

} // namespace emperor
