namespace _utils {
    extern fun file_read_text(file: string) -> mut string;
    extern fun file_write_text(file: string, text: string);
    extern fun mkdir(path: string) -> bool;
    extern fun file_exists(path: string) -> bool;
    extern fun dir_exists(path: string) -> bool;
    extern fun dir_get_entries(path: string) -> string;

    // Create a fresh, process-unique temporary directory and return its path.
    // Backed by the C runtime (_emperor_create_temp_dir): atomic on POSIX via
    // mkdtemp, and a pid+counter mkdir retry loop on Windows. Guarantees no
    // conflict across parallel compiler invocations.
    extern fun create_temp_dir(prefix: string) -> string;

    // Returns a guaranteed-unique temporary directory path, already created.
    // Use this for build intermediates so parallel EmperorPenguin runs do not
    // collide on a shared fixed path like "tmp/".
    fun get_temp_folder() -> string {
        let dir: string = create_temp_dir("penguin");
        return dir;
    }

    let verbose_level: mut i64 = 0;
    fun trace_set_verbose(level: i64) {
        verbose_level = level;
    }

    fun trace_enter(str: string) {
        if (verbose_level >= 3) {
            __builtin.eprintln(str);
        }
    }

    fun args() -> _utils.List<string> {
        let result = new _utils.List<string>();
        let count: i64 = __builtin.__args_count();
        let i: mut i64 = 0;
        while (i < count) {
            result.push(__builtin.__args_get(i));
            i = i + 1;
        }
        return result;
    }

    #template(T: type)
    class _ListNode {
        value: mut __builtin.Option<T> = new __builtin.Option<T>.none();
        next: mut __builtin.Option<_ListNode<T>> = new __builtin.Option<_ListNode<T>>.none();
        prev: mut __builtin.Option<_ListNode<T>> = new __builtin.Option<_ListNode<T>>.none();
    }

    #template(T: type)
    class _ListIterator {
        current: mut __builtin.Option<_ListNode<T>> = new __builtin.Option<_ListNode<T>>.none();

        fun new(mut this, start: __builtin.Option<_ListNode<T>>) {
            this.current = start;
        }

        fun next(mut this) -> __builtin.Option<T> {
            if (this.current.is_some()) {
                let result: __builtin.Option<T> = this.current.some.value;
                this.current = this.current.some.next;
                return result;
            }
            return new __builtin.Option<T>.none();
        }

        fun iter(this) -> _ListIterator<T> {
            return new _ListIterator<T>(this.current);
        }
    }

    #template(T: type)
    class List {
        head: mut __builtin.Option<_ListNode<T>> = new __builtin.Option<_ListNode<T>>.none();
        tail: mut __builtin.Option<_ListNode<T>> = new __builtin.Option<_ListNode<T>>.none();
        count: mut u64 = 0;
        // Access cursor: caches the node + index most recently returned by node_at, so
        // sequential / short-distance access (the parser's token-stream pattern) is O(1)
        // instead of re-walking from the head every call (which made parse O(n^2)).
        // This is pure internal cache state — callers only ever use at()/set(); the node
        // structure is never exposed upward. Invalidated by pop()/remove().
        cursor_node: mut __builtin.Option<_ListNode<T>> = new __builtin.Option<_ListNode<T>>.none();
        cursor_index: mut u64 = 0;

        fun new(mut this) {}

        fun push(mut this, value: T) {
            let node: mut _ListNode<T> = new _ListNode<T>();
            node.value = new __builtin.Option<T>.some(value);
            node.prev = new __builtin.Option<_ListNode<T>>.none();
            if (this.count == 0) {
                this.head = new __builtin.Option<_ListNode<T>>.some(node);
                this.tail = new __builtin.Option<_ListNode<T>>.some(node);
            } else {
                node.prev = new __builtin.Option<_ListNode<T>>.some(this.tail.some);
                let t: mut _ListNode<T> = this.tail.some;
                t.next = new __builtin.Option<_ListNode<T>>.some(node);
                this.tail = new __builtin.Option<_ListNode<T>>.some(node);
            }
            this.count = this.count + 1;
        }

        // Return the node at `index`, updating the access cursor. Assumes index < count
        // (callers gate on that). Picks the closest starting point — head, tail, or the
        // cached cursor — and walks forward (via next) or backward (via prev), so cost is
        // O(distance) from the nearest of those three. For sequential + short-backtrack
        // access this is O(1) amortized.
        fun node_at(this, index: u64) -> _ListNode<T> {
            let start_node: mut _ListNode<T> = this.head.some;
            let start_index: mut u64 = 0;
            let forward: mut bool = true;
            let best: mut u64 = index;
            // From tail, walking backward.
            let dist_tail: u64 = this.count - 1 - index;
            if (dist_tail < best) {
                start_node = this.tail.some;
                start_index = this.count - 1;
                forward = false;
                best = dist_tail;
            }
            // From the cached cursor, walking forward or backward.
            if (this.cursor_node.is_some()) {
                let dist_c: mut u64 = 0;
                let fwd_c: mut bool = true;
                if (index >= this.cursor_index) {
                    dist_c = index - this.cursor_index;
                    fwd_c = true;
                } else {
                    dist_c = this.cursor_index - index;
                    fwd_c = false;
                }
                if (dist_c < best) {
                    start_node = this.cursor_node.some;
                    start_index = this.cursor_index;
                    forward = fwd_c;
                    best = dist_c;
                }
            }
            let cur: mut _ListNode<T> = start_node;
            let ci: mut u64 = start_index;
            if (forward) {
                while (ci < index) {
                    cur = cur.next.some;
                    ci = ci + 1;
                }
            } else {
                while (ci > index) {
                    cur = cur.prev.some;
                    ci = ci - 1;
                }
            }
            this.cursor_node = new __builtin.Option<_ListNode<T>>.some(cur);
            this.cursor_index = index;
            return cur;
        }

        fun at(this, index: u64) -> __builtin.Option<T> {
            if (index >= this.count) {
                return new __builtin.Option<T>.none();
            }
            return this.node_at(index).value;
        }

        fun set(mut this, index: u64, value: T) {
            if (index >= this.count) {
                return;
            }
            let node: mut _ListNode<T> = this.node_at(index);
            node.value = new __builtin.Option<T>.some(value);
        }

        fun pop(mut this) -> __builtin.Option<T> {
            if (this.count == 0) {
                return new __builtin.Option<T>.none();
            }
            let result: __builtin.Option<T> = this.tail.some.value;
            if (this.count == 1) {
                this.head = new __builtin.Option<_ListNode<T>>.none();
                this.tail = new __builtin.Option<_ListNode<T>>.none();
                this.count = 0;
                this.cursor_node = new __builtin.Option<_ListNode<T>>.none();
                this.cursor_index = 0;
                return result;
            }
            // Doubly-linked: the new tail is the old tail's prev (O(1), no walk).
            let old_tail: _ListNode<T> = this.tail.some;
            let new_tail: mut _ListNode<T> = old_tail.prev.some;
            new_tail.next = new __builtin.Option<_ListNode<T>>.none();
            this.tail = new __builtin.Option<_ListNode<T>>.some(new_tail);
            this.count = this.count - 1;
            this.cursor_node = new __builtin.Option<_ListNode<T>>.none();
            this.cursor_index = 0;
            return result;
        }

        fun remove(mut this, index: u64) {
            if (index >= this.count) {
                return;
            }
            if (this.count == 1) {
                this.head = new __builtin.Option<_ListNode<T>>.none();
                this.tail = new __builtin.Option<_ListNode<T>>.none();
                this.count = 0;
                this.cursor_node = new __builtin.Option<_ListNode<T>>.none();
                this.cursor_index = 0;
                return;
            }
            if (index == 0) {
                let new_head: mut _ListNode<T> = this.head.some.next.some;
                new_head.prev = new __builtin.Option<_ListNode<T>>.none();
                this.head = new __builtin.Option<_ListNode<T>>.some(new_head);
                this.count = this.count - 1;
                this.cursor_node = new __builtin.Option<_ListNode<T>>.none();
                this.cursor_index = 0;
                return;
            }
            let target: _ListNode<T> = this.node_at(index);
            let target_prev: mut _ListNode<T> = target.prev.some;
            let target_next_opt: __builtin.Option<_ListNode<T>> = target.next;
            if (target_next_opt.is_some()) {
                let target_next: mut _ListNode<T> = target_next_opt.some;
                target_next.prev = new __builtin.Option<_ListNode<T>>.some(target_prev);
                target_prev.next = new __builtin.Option<_ListNode<T>>.some(target_next);
            } else {
                target_prev.next = new __builtin.Option<_ListNode<T>>.none();
                this.tail = new __builtin.Option<_ListNode<T>>.some(target_prev);
            }
            this.count = this.count - 1;
            this.cursor_node = new __builtin.Option<_ListNode<T>>.none();
            this.cursor_index = 0;
        }

        fun size(this) -> u64 {
            return this.count;
        }

        fun iter(this) -> _ListIterator<T> {
            return new _ListIterator<T>(this.head);
        }

        fun iter_mut(this) -> mut _ListIterator<T> {
            return new _ListIterator<T>(this.head);
        }
    }

    #template(T: type)
    class _QueueNode {
        value: mut __builtin.Option<T> = new __builtin.Option<T>.none();
        next: mut __builtin.Option<_QueueNode<T>> = new __builtin.Option<_QueueNode<T>>.none();
    }

    #template(T: type)
    class Queue {
        front: mut __builtin.Option<_QueueNode<T>> = new __builtin.Option<_QueueNode<T>>.none();
        rear: mut __builtin.Option<_QueueNode<T>> = new __builtin.Option<_QueueNode<T>>.none();
        count: mut u64 = 0;

        fun new(mut this) {}

        fun enqueue(mut this, value: T) {
            let node: mut _QueueNode<T> = new _QueueNode<T>();
            node.value = new __builtin.Option<T>.some(value);
            if (this.count == 0) {
                this.front = new __builtin.Option<_QueueNode<T>>.some(node);
                this.rear = new __builtin.Option<_QueueNode<T>>.some(node);
            } else {
                let r: mut _QueueNode<T> = this.rear.some;
                r.next = new __builtin.Option<_QueueNode<T>>.some(node);
                this.rear = new __builtin.Option<_QueueNode<T>>.some(node);
            }
            this.count = this.count + 1;
        }

        fun dequeue(mut this) -> __builtin.Option<T> {
            if (this.count == 0) {
                return new __builtin.Option<T>.none();
            }
            let result: __builtin.Option<T> = this.front.some.value;
            this.front = this.front.some.next;
            if (this.front.is_none()) {
                this.rear = new __builtin.Option<_QueueNode<T>>.none();
            }
            this.count = this.count - 1;
            return result;
        }

        fun peek(this) -> __builtin.Option<T> {
            if (this.count == 0) {
                return new __builtin.Option<T>.none();
            }
            return this.front.some.value;
        }

        fun size(this) -> u64 {
            return this.count;
        }
    }

    fun exec(exe: string, args: List<string>) -> i64 {
        let cmd: mut string = exe;
        let i: mut i64 = 0;
        while (i < cast<i64>(args.size())) {
            let arg: string = args.at(cast<u64>(i)).some;
            cmd = cmd + " " + arg;
            i = i + 1;
        }
        return __builtin._exec_cmd(cmd);
    }
}
