namespace _utils {
    extern fun file_read_text(file: string) -> mut string;
    extern fun file_write_text(file: string, text: string);
    extern fun mkdir(path: string) -> bool;
    extern fun file_exists(path: string) -> bool;
    extern fun dir_exists(path: string) -> bool;
    extern fun dir_get_entries(path: string) -> string;

    // Binary-mode file I/O for dynamic-linking (.penguin-lib) support. Read paths
    // use "rb"/"ab" so Windows does not CRLF-mangle a .so/.dll tail or the JSON
    // metadata + PENGUINLIB footer appended to it. Metadata is ASCII, so the
    // NUL-terminated string contract holds.
    extern fun file_size(file: string) -> i64;
    extern fun file_read_range(file: string, offset: i64, size: i64) -> string;
    extern fun file_append(file: string, text: string);
    extern fun exe_path() -> string;

    // Create a fresh, process-unique temporary directory and return its path.
    // Backed by the C runtime (_emperor_create_temp_dir): atomic on POSIX via
    // mkdtemp, and a pid+counter mkdir retry loop on Windows. Guarantees no
    // conflict across parallel compiler invocations.
    extern fun create_temp_dir(prefix: string) -> string;

    // Returns a guaranteed-unique temporary directory path, already created.
    // Use this for build intermediates so parallel EmperorPenguin runs do not
    // collide on a shared fixed path like "tmp/".
    fun get_temp_folder() -> string {
        let dir: string = create_temp_dir("penguin");
        return dir;
    }

    let verbose_level: mut i64 = 0;
    fun trace_set_verbose(level: i64) {
        verbose_level = level;
    }

    fun trace_enter(str: string) {
        if (verbose_level >= 3) {
            __builtin.eprintln(str);
        }
    }

    fun args() -> _utils.List<string> {
        let mut result = new _utils.List<string>();
        let count: i64 = __builtin.__args_count();
        let i: mut i64 = 0;
        while (i < count) {
            result.push(__builtin.__args_get(i));
            i = i + 1;
        }
        return result;
    }

    // Contiguous-buffer List (the std.Vector design: one _malloc'd element
    // buffer, doubling growth, #sizeof/#__load/#__store intrinsics), replacing
    // the old per-element _ListNode linked list — one allocation per grow
    // instead of one per element, and O(1) random access without the old
    // head/tail/cursor walk. The public surface (push/at/set/pop/remove/size/
    // iter/iter_mut and their signatures) is unchanged, so callers are
    // untouched.
    //
    // Each slot stores a bare T (loaded/stored via #__load(T)/#__store(T)),
    // NOT Option<T>: value-type elements nest INLINE in the buffer (their
    // whole struct is copied in/out by the pointer intrinsics — value
    // semantics, no per-element boxing), and reference-type elements store
    // their pointer. at()/pop()/next() wrap the loaded element in a fresh
    // Option<T>.some on return, which for value-type payloads is an inline
    // struct copy — no heap allocation. The buffer is raw malloc memory that
    // may hold GC references, so it is registered as a GC scan region right
    // after allocation and unregistered before free/grow-replace; dispose_mem
    // is also wired into the GC finalizer (IReferenceType + IMemoryDispose),
    // so unreachable lists release their buffer automatically.
    #template(T: type)
    class List {
        impl __builtin.IReferenceType;
        impl __builtin.IMemoryDispose;
        buf: mut u64 = 0;
        len: mut u64 = 0;
        cap: mut u64 = 0;

        fun new(mut this) {}

        fun slot_size(this) -> u64 {
            return cast<u64>(#sizeof(T));
        }

        fun slot_addr(this, index: u64) -> u64 {
            return this.buf + index * this.slot_size();
        }

        // Reallocate to new_cap slots, copying existing elements over. The new
        // buffer is registered as a GC scan region BEFORE elements (which may
        // be GC references) land in it, and the old region is removed before
        // the old buffer is freed — the collector must never scan freed memory.
        fun _grow(mut this, new_cap: u64) {
            let bytes: u64 = new_cap * this.slot_size();
            let new_buf: u64 = __builtin._malloc(bytes);
            __builtin._gc_scan_add(new_buf, cast<i64>(bytes));
            let i: mut u64 = 0;
            while (i < this.len) {
                #__store(T, new_buf + i * this.slot_size(), #__load(T, this.buf + i * this.slot_size()));
                i = i + 1;
            }
            if (this.buf != 0) {
                __builtin._gc_scan_remove(this.buf);
                __builtin._mfree(this.buf);
            }
            this.buf = new_buf;
            this.cap = new_cap;
        }

        fun push(mut this, value: T) {
            if (this.len == this.cap) {
                let new_cap: u64 = if (this.cap == 0) { 8 } else { this.cap * 2 };
                this._grow(new_cap);
            }
            #__store(T, this.slot_addr(this.len), value);
            this.len = this.len + 1;
        }

        fun at(this, index: u64) -> __builtin.Option<T> {
            if (index >= this.len) {
                return new __builtin.Option<T>.none();
            }
            return new __builtin.Option<T>.some(#__load(T, this.slot_addr(index)));
        }

        fun set(mut this, index: u64, value: T) {
            if (index >= this.len) {
                return;
            }
            #__store(T, this.slot_addr(index), value);
        }

        fun pop(mut this) -> __builtin.Option<T> {
            if (this.len == 0) {
                return new __builtin.Option<T>.none();
            }
            this.len = this.len - 1;
            return new __builtin.Option<T>.some(#__load(T, this.slot_addr(this.len)));
        }

        // Shift [index+1, len) left one slot, then shrink. Same observable
        // behavior as the old linked-list unlink (elements keep their order).
        fun remove(mut this, index: u64) {
            if (index >= this.len) {
                return;
            }
            let i: mut u64 = index;
            while (i + 1 < this.len) {
                #__store(T, this.slot_addr(i), #__load(T, this.slot_addr(i + 1)));
                i = i + 1;
            }
            this.len = this.len - 1;
        }

        fun size(this) -> u64 {
            return this.len;
        }

        fun iter(this) -> _ListIterator<T> {
            return new _ListIterator<T>(this);
        }

        fun iter_mut(this) -> mut _ListIterator<T> {
            return new _ListIterator<T>(this);
        }

        fun dispose_mem(mut this) {
            if (this.buf != 0) {
                __builtin._gc_scan_remove(this.buf);
                __builtin._mfree(this.buf);
                this.buf = 0;
            }
        }
    }

    // Iterator over List<T>. It holds a reference to the List and re-reads
    // buf/len on every next() rather than snapshotting them, on purpose:
    //  - the GC traces iterator -> list -> scan region, so iterating a
    //    temporary list (e.g. `for (x in f())`) keeps its buffer alive;
    //  - a push() during iteration may reallocate the buffer — the fresh
    //    buf is picked up instead of dereferencing a freed snapshot;
    //  - len is re-read, so elements appended or popped during iteration
    //    are seen/hidden exactly as they were with the linked list.
    #template(T: type)
    class _ListIterator {
        impl __builtin.IReferenceType;
        list: List<T>;
        cursor: mut u64 = 0;

        fun new(mut this, list: List<T>) {
            this.list = list;
            this.cursor = 0;
        }

        fun next(mut this) -> __builtin.Option<T> {
            if (this.cursor >= this.list.len) {
                return new __builtin.Option<T>.none();
            }
            let result: T = #__load(T, this.list.slot_addr(this.cursor));
            this.cursor = this.cursor + 1;
            return new __builtin.Option<T>.some(result);
        }

        fun iter(this) -> _ListIterator<T> {
            return this;
        }
    }

    #template(T: type)
    class _QueueNode {
        value: mut __builtin.Option<T> = new __builtin.Option<T>.none();
        next: mut __builtin.Option<_QueueNode<T>> = new __builtin.Option<_QueueNode<T>>.none();
    }

    #template(T: type)
    class Queue {
        front: mut __builtin.Option<_QueueNode<T>> = new __builtin.Option<_QueueNode<T>>.none();
        rear: mut __builtin.Option<_QueueNode<T>> = new __builtin.Option<_QueueNode<T>>.none();
        count: mut u64 = 0;

        fun new(mut this) {}

        fun enqueue(mut this, value: T) {
            let node: mut _QueueNode<T> = new _QueueNode<T>();
            node.value = new __builtin.Option<T>.some(value);
            if (this.count == 0) {
                this.front = new __builtin.Option<_QueueNode<T>>.some(node);
                this.rear = new __builtin.Option<_QueueNode<T>>.some(node);
            } else {
                let r: mut _QueueNode<T> = this.rear.some;
                r.next = new __builtin.Option<_QueueNode<T>>.some(node);
                this.rear = new __builtin.Option<_QueueNode<T>>.some(node);
            }
            this.count = this.count + 1;
        }

        fun dequeue(mut this) -> __builtin.Option<T> {
            if (this.count == 0) {
                return new __builtin.Option<T>.none();
            }
            let result: __builtin.Option<T> = this.front.some.value;
            this.front = this.front.some.next;
            if (this.front.is_none()) {
                this.rear = new __builtin.Option<_QueueNode<T>>.none();
            }
            this.count = this.count - 1;
            return result;
        }

        fun peek(this) -> __builtin.Option<T> {
            if (this.count == 0) {
                return new __builtin.Option<T>.none();
            }
            return this.front.some.value;
        }

        fun size(this) -> u64 {
            return this.count;
        }
    }

    fun exec(exe: string, args: List<string>) -> i64 {
        let cmd: mut string = exe;
        let i: mut i64 = 0;
        while (i < cast<i64>(args.size())) {
            let arg: string = args.at(cast<u64>(i)).some;
            cmd = cmd + " " + arg;
            i = i + 1;
        }
        return __builtin._exec_cmd(cmd);
    }
}
