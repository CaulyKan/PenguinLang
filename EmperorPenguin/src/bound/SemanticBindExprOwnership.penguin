// ownership escape analysis (§9.2 rule 1, form 3) for spawn argument
// freshness — the linear-use audit family of pass 8.
// Batch 0.2 mechanical split of SemanticBindExpressions.penguin —
// method bodies moved verbatim (see the driver class there).
namespace emperor {

// NOTE: the class is deliberately NOT named *Ownership*: bind_new_expr's
// construction gate used to substring-match `new <type>(...)` type names
// against "Ownership" (design doc §9 freshness rule), and a class whose own
// name contained that substring gated every `new BindExprLinear(this)` in
// the pass wiring (batch 0.2 hit this: the self-compile bootstrap failed
// with E_MUTABILITY on the driver constructor). The gate is now EXACT
// (new_type_is_builtin_ownership, SemanticShared.penguin —
// MtOwnershipSubstringClassNameFalsePositive), so the name would be safe —
// the spelling is kept for git history continuity.
class BindExprLinear {
    // Back-reference to the owning pass (the src/bound pass-class
    // `model: mut Option<SemanticModel>` pattern, mirroring the batch 0.1
    // LLVMEmitter split): all shared binding state stays on
    // BindExpressionsPass (whose own model field is reached via owner).
    owner: mut Option<BindExpressionsPass> = new Option<BindExpressionsPass>.none();

    fun new(mut this, owner: mut BindExpressionsPass) {
        this.owner = new Option<BindExpressionsPass>.some(owner);
    }

    fun ownership_arg_is_fresh(mut this, a: Expression) -> bool {
        // Primitive literals carry no aliases by construction (values are
        // copied; the design doc's Imm basis).
        if (a is Expression.constant) {
            return true;
        }
        if (a is Expression.string_literal) {
            return true;
        }
        if (a is Expression.bool_literal) {
            return true;
        }
        if (a is Expression.new_expr) {
            return true;
        }
        if (a is Expression.function_call) {
            let fc: FunctionCallExpression = a.function_call;
            if (fc.callee.is_some()) {
                let callee: Expression = fc.callee.some;
                if (callee is Expression.member_access) {
                    if (callee.member_access.member_name == "move") {
                        return true;
                    }
                }
            }
        }
        // Form 3 (escape analysis, §9.2 rule 1): a LINEARLY HELD local —
        // fresh at birth and only ever touched as a receiver until the
        // wrap. See ownership_local_is_linear below.
        if (a is Expression.identifier) {
            let visited: mut _utils.List<string> = new _utils.List<string>();
            return this.ownership_local_is_linear(a.identifier.name, visited);
        }
        return false;
    }

    // ============ Ownership escape analysis (§9.2 rule 1, form 3) ============
    // `new Ownership<T>(l)` with a locally built l: accept iff l is linearly
    // held from birth to the wrap —
    //   * its let-initializer is itself fresh (literal / new / .move() /
    //     another linearly-held local, cycle-guarded by name), and
    //   * every OTHER textual use of the name in the enclosing function body
    //     is RECEIVER-position (l.push(..), l.field) or a == / != comparison
    //     — no argument passing, no aliasing assignment, no field/global
    //     store, no capture by spawn/lambda/return.
    // Receiver-position method calls are accepted as mutations of the object
    // being transferred — the classic linear-type compromise (auditing every
    // method for a `this`-capture is out of scope; §9.4 documents the
    // residual hole). Any same-named let in a NESTED block disqualifies the
    // name (shadow ambiguity — conservative).
    fun ownership_local_is_linear(mut this, name: string, visited: mut _utils.List<string>) -> bool {
        let owner: mut BindExpressionsPass = this.owner.some;
        // Cycle guard (l1 from l2, l2 from l1).
        let vi: mut i64 = 0;
        while (vi < cast<i64>(visited.size())) {
            if (visited.at(cast<u64>(vi)).some == name) {
                return false;
            }
            vi = vi + 1;
        }
        visited.push(name);
        if (owner.model.some.current_fn_ast_body.is_none()) {
            return false;
        }
        let body: Expression = owner.model.some.current_fn_ast_body.some;
        // A same-named let anywhere OTHER than the top-level statement list
        // of the body block means shadowing — refuse the name outright.
        if (this.ownership_body_has_shadowing_let(body, name)) {
            return false;
        }
        let init: Option<Expression> = this.ownership_find_let_init(body, name);
        if (init.is_none()) {
            return false;
        }
        if (!this.ownership_arg_is_fresh_inner(init.some, visited)) {
            return false;
        }
        // Audit every use outside the initializer and the wrap itself.
        return this.ownership_uses_are_linear(body, name, init.some);
    }
    fun ownership_arg_is_fresh_inner(mut this, a: Expression, visited: mut _utils.List<string>) -> bool {
        if (a is Expression.constant) { return true; }
        if (a is Expression.string_literal) { return true; }
        if (a is Expression.bool_literal) { return true; }
        if (a is Expression.new_expr) { return true; }
        if (a is Expression.function_call) {
            let fc: FunctionCallExpression = a.function_call;
            if (fc.callee.is_some()) {
                let callee: Expression = fc.callee.some;
                if (callee is Expression.member_access) {
                    if (callee.member_access.member_name == "move") {
                        return true;
                    }
                }
            }
        }
        if (a is Expression.identifier) {
            return this.ownership_local_is_linear(a.identifier.name, visited);
        }
        return false;
    }

    // The body's top-level lets (the only binding level we trust): a let in
    // any nested block/branch/loop with the same name = shadow ambiguity.
    fun ownership_body_has_shadowing_let(this, body: Expression, name: string) -> bool {
        if (!(body is Expression.code_block)) {
            return false;
        }
        let cb: CodeBlockExpression = body.code_block;
        let i: mut i64 = 0;
        while (i < cast<i64>(cb.statements.size())) {
            let st: Statement = cb.statements.at(cast<u64>(i)).some;
            if (st is Statement.let_decl) {
                if (st.let_decl.variable_name == name) {
                    return false; // the top-level binding itself
                }
            }
            if (this.ownership_stmt_declares_name(st, name)) {
                return true;
            }
            i = i + 1;
        }
        if (cb.trailing_expr.is_some()) {
            return this.ownership_expr_declares_name(cb.trailing_expr.some, name);
        }
        return false;
    }
    fun ownership_find_let_init(this, body: Expression, name: string) -> Option<Expression> {
        // The LAST top-level binding wins (a later `let x = ...` rebinds;
        // the wrap textually follows it).
        if (!(body is Expression.code_block)) {
            return new Option<Expression>.none();
        }
        let cb: CodeBlockExpression = body.code_block;
        let found: mut Option<Expression> = new Option<Expression>.none();
        let i: mut i64 = 0;
        while (i < cast<i64>(cb.statements.size())) {
            let st: Statement = cb.statements.at(cast<u64>(i)).some;
            if (st is Statement.let_decl) {
                if (st.let_decl.variable_name == name) {
                    found = st.let_decl.initializer;
                }
            }
            i = i + 1;
        }
        return found;
    }

    // Nested-block let/for/try-catch binders with the same name.
    fun ownership_stmt_declares_name(this, st: Statement, name: string) -> bool {
        if (st is Statement.let_decl) {
            return st.let_decl.variable_name == name;
        }
        if (st is Statement.for_stmt) {
            return st.for_stmt.variable_name == name;
        }
        if (st is Statement.try_stmt) {
            return st.try_stmt.catch_var_name == name;
        }
        if (st is Statement.if_stmt) {
            if (st.if_stmt.then_statement.is_some() &&
                this.ownership_stmt_declares_name(st.if_stmt.then_statement.some, name)) {
                return true;
            }
            if (st.if_stmt.else_statement.is_some() &&
                this.ownership_stmt_declares_name(st.if_stmt.else_statement.some, name)) {
                return true;
            }
            return false;
        }
        if (st is Statement.while_stmt) {
            return st.while_stmt.body.is_some() &&
                this.ownership_stmt_declares_name(st.while_stmt.body.some, name);
        }
        if (st is Statement.block_expr) {
            return st.block_expr.expression.is_some() &&
                this.ownership_expr_declares_name(st.block_expr.expression.some, name);
        }
        return false;
    }
    fun ownership_expr_declares_name(this, e: Expression, name: string) -> bool {
        if (e is Expression.code_block) {
            let cb: CodeBlockExpression = e.code_block;
            let i: mut i64 = 0;
            while (i < cast<i64>(cb.statements.size())) {
                if (this.ownership_stmt_declares_name(cb.statements.at(cast<u64>(i)).some, name)) {
                    return true;
                }
                i = i + 1;
            }
            if (cb.trailing_expr.is_some()) {
                return this.ownership_expr_declares_name(cb.trailing_expr.some, name);
            }
            return false;
        }
        if (e is Expression.if_expr) {
            if (e.if_expr.then_block.is_some() &&
                this.ownership_expr_declares_name(e.if_expr.then_block.some, name)) {
                return true;
            }
            if (e.if_expr.else_block.is_some() &&
                this.ownership_expr_declares_name(e.if_expr.else_block.some, name)) {
                return true;
            }
            return false;
        }
        if (e is Expression.while_expr) {
            return e.while_expr.body.is_some() &&
                this.ownership_expr_declares_name(e.while_expr.body.some, name);
        }
        return false;
    }

    // The use audit: every identifier occurrence of NAME must be (a) the
    // base of a member access, (b) an operand of an all-==/!= binary, (c)
    // inside the let's own initializer (the freshness check covers it), or
    // (d) an Ownership wrap argument. Everything else escapes.
    fun ownership_uses_are_linear(mut this, body: Expression, name: string, init: Expression) -> bool {
        return this.ownership_walk_expr_linear(body, name, init, false);
    }
    fun ownership_walk_expr_linear(mut this, e: Expression, name: string, init: Expression, recv_ok: bool) -> bool {
        if (e is Expression.identifier) {
            if (e.identifier.name != name) {
                return true;
            }
            return recv_ok;
        }
        if (e is Expression.parenthesized) {
            if (e.parenthesized.inner.is_none()) { return true; }
            return this.ownership_walk_expr_linear(e.parenthesized.inner.some, name, init, false);
        }
        if (e is Expression.member_access) {
            let base_ok: bool = e.member_access.base_expr.is_some()
                && this.ownership_walk_expr_linear(e.member_access.base_expr.some, name, init, true);
            return base_ok;
        }
        if (e is Expression.function_call) {
            let fc: FunctionCallExpression = e.function_call;
            if (fc.callee.is_some()) {
                if (!this.ownership_walk_expr_linear(fc.callee.some, name, init, false)) {
                    return false;
                }
            }
            let i: mut i64 = 0;
            while (i < cast<i64>(fc.arguments.size())) {
                if (!this.ownership_walk_expr_linear(fc.arguments.at(cast<u64>(i)).some, name, init, false)) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        if (e is Expression.binary) {
            let b: BinaryExpression = e.binary;
            let all_eq: mut bool = true;
            let oi: mut i64 = 0;
            while (oi < cast<i64>(b.operators.size())) {
                let op: BinaryOperator = b.operators.at(cast<u64>(oi)).some;
                if (!(op is BinaryOperator.Equal) && !(op is BinaryOperator.NotEqual)) {
                    all_eq = false;
                }
                oi = oi + 1;
            }
            let bi: mut i64 = 0;
            while (bi < cast<i64>(b.operands.size())) {
                if (!this.ownership_walk_expr_linear(b.operands.at(cast<u64>(bi)).some, name, init, all_eq)) {
                    return false;
                }
                bi = bi + 1;
            }
            return true;
        }
        if (e is Expression.unary) {
            if (e.unary.operand.is_none()) { return true; }
            return this.ownership_walk_expr_linear(e.unary.operand.some, name, init, false);
        }
        if (e is Expression.code_block) {
            let cb: CodeBlockExpression = e.code_block;
            let i: mut i64 = 0;
            while (i < cast<i64>(cb.statements.size())) {
                if (!this.ownership_walk_stmt_linear(cb.statements.at(cast<u64>(i)).some, name, init)) {
                    return false;
                }
                i = i + 1;
            }
            if (cb.trailing_expr.is_some()) {
                return this.ownership_walk_expr_linear(cb.trailing_expr.some, name, init, false);
            }
            return true;
        }
        if (e is Expression.new_expr) {
            let ne: NewExpression = e.new_expr;
            // The wrap itself: the freshness check judged the argument.
            if (new_type_is_builtin_ownership(ne.type_name) &&
                cast<i64>(ne.arguments.size()) == 1) {
                let arg: Expression = ne.arguments.at(cast<u64>(0)).some;
                if (arg is Expression.identifier && arg.identifier.name == name) {
                    return true;
                }
            }
            let j: mut i64 = 0;
            while (j < cast<i64>(ne.arguments.size())) {
                if (!this.ownership_walk_expr_linear(ne.arguments.at(cast<u64>(j)).some, name, init, false)) {
                    return false;
                }
                j = j + 1;
            }
            return true;
        }
        if (e is Expression.cast_expr) {
            if (e.cast_expr.inner.is_some()) {
                return this.ownership_walk_expr_linear(e.cast_expr.inner.some, name, init, false);
            }
            return true;
        }
        if (e is Expression.if_expr) {
            let ie: IfExpression = e.if_expr;
            if (ie.condition.is_some() &&
                !this.ownership_walk_expr_linear(ie.condition.some, name, init, false)) {
                return false;
            }
            if (ie.then_block.is_some() &&
                !this.ownership_walk_expr_linear(ie.then_block.some, name, init, false)) {
                return false;
            }
            if (ie.else_block.is_some() &&
                !this.ownership_walk_expr_linear(ie.else_block.some, name, init, false)) {
                return false;
            }
            return true;
        }
        if (e is Expression.while_expr) {
            let we: WhileExpression = e.while_expr;
            if (we.condition.is_some() &&
                !this.ownership_walk_expr_linear(we.condition.some, name, init, false)) {
                return false;
            }
            if (we.body.is_some() &&
                !this.ownership_walk_expr_linear(we.body.some, name, init, false)) {
                return false;
            }
            return true;
        }
        if (e is Expression.spawn_async) {
            // Any mention inside a spawn escapes by capture.
            if (e.spawn_async.expression.is_none()) { return true; }
            return !this.ownership_expr_mentions(e.spawn_async.expression.some, name);
        }
        if (e is Expression.lambda_expr) {
            if (e.lambda_expr.body.is_none()) { return true; }
            return !this.ownership_expr_mentions(e.lambda_expr.body.some, name);
        }
        // Literals, void, meta calls, try_bind, function_call_arguments,
        // specializing_impl: no identifier surface beyond their children
        // (conservatively re-walk the generic children where they exist).
        return true;
    }
    fun ownership_walk_stmt_linear(mut this, st: Statement, name: string, init: Expression) -> bool {
        if (st is Statement.expression) {
            return st.expression.expression.is_some() &&
                this.ownership_walk_expr_linear(st.expression.expression.some, name, init, false);
        }
        if (st is Statement.block_expr) {
            return st.block_expr.expression.is_some() &&
                this.ownership_walk_expr_linear(st.block_expr.expression.some, name, init, false);
        }
        if (st is Statement.assignment) {
            // RHS mention escapes (aliasing); a TARGET that is a member of
            // the name (l.field = ...) is a receiver use.
            if (st.assignment.value.is_some() &&
                !this.ownership_walk_expr_linear(st.assignment.value.some, name, init, false)) {
                return false;
            }
            if (st.assignment.target.is_some() &&
                !this.ownership_walk_expr_linear(st.assignment.target.some, name, init, true)) {
                return false;
            }
            return true;
        }
        if (st is Statement.let_decl) {
            // The binding's own initializer is judged by freshness; any
            // OTHER let initialized from the name aliases it.
            if (st.let_decl.initializer.is_none()) {
                return true;
            }
            if (this.ownership_expr_is(st.let_decl.initializer.some, init)) {
                return true;
            }
            return this.ownership_walk_expr_linear(st.let_decl.initializer.some, name, init, false);
        }
        if (st is Statement.if_stmt) {
            if (st.if_stmt.condition.is_some() &&
                !this.ownership_walk_expr_linear(st.if_stmt.condition.some, name, init, false)) {
                return false;
            }
            if (st.if_stmt.then_statement.is_some() &&
                !this.ownership_walk_stmt_linear(st.if_stmt.then_statement.some, name, init)) {
                return false;
            }
            if (st.if_stmt.else_statement.is_some() &&
                !this.ownership_walk_stmt_linear(st.if_stmt.else_statement.some, name, init)) {
                return false;
            }
            return true;
        }
        if (st is Statement.while_stmt) {
            if (st.while_stmt.condition.is_some() &&
                !this.ownership_walk_expr_linear(st.while_stmt.condition.some, name, init, false)) {
                return false;
            }
            if (st.while_stmt.body.is_some() &&
                !this.ownership_walk_stmt_linear(st.while_stmt.body.some, name, init)) {
                return false;
            }
            return true;
        }
        if (st is Statement.for_stmt) {
            if (st.for_stmt.iterable.is_some() &&
                !this.ownership_walk_expr_linear(st.for_stmt.iterable.some, name, init, false)) {
                return false;
            }
            if (st.for_stmt.body.is_some() &&
                !this.ownership_walk_stmt_linear(st.for_stmt.body.some, name, init)) {
                return false;
            }
            return true;
        }
        if (st is Statement.return_stmt) {
            if (st.return_stmt.value.is_some()) {
                return this.ownership_walk_expr_linear(st.return_stmt.value.some, name, init, false);
            }
            return true;
        }
        if (st is Statement.connect_stmt) {
            if (st.connect_stmt.source.is_some() &&
                !this.ownership_walk_expr_linear(st.connect_stmt.source.some, name, init, false)) {
                return false;
            }
            if (st.connect_stmt.sink.is_some() &&
                !this.ownership_walk_expr_linear(st.connect_stmt.sink.some, name, init, false)) {
                return false;
            }
            return true;
        }
        if (st is Statement.try_stmt) {
            if (st.try_stmt.try_block.is_some() &&
                !this.ownership_walk_stmt_linear(st.try_stmt.try_block.some, name, init)) {
                return false;
            }
            if (st.try_stmt.catch_block.is_some() &&
                !this.ownership_walk_stmt_linear(st.try_stmt.catch_block.some, name, init)) {
                return false;
            }
            return true;
        }
        return true;
    }

    // Pointer identity over the AST nodes (the initializer we judged).
    fun ownership_expr_is(this, a: Expression, b: Expression) -> bool {
        return this.ownership_expr_key(a) == this.ownership_expr_key(b);
    }
    fun ownership_expr_key(this, e: Expression) -> string {
        // Reference-keyed identity is not available; the text form is
        // sufficient to recognize the SAME let initializer walked twice
        // (identical text in one function implies the same binding).
        return e.build_text();
    }
    fun ownership_expr_mentions(this, e: Expression, name: string) -> bool {
        return string_find(e.build_text(), name) >= 0;
    }
}

}
