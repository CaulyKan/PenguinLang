enum BoundDefinition {
    function_def: BoundFunctionDefinition;
    class_def: BoundClassDefinition;
    enum_def: BoundEnumDefinition;
    interface_def: BoundInterfaceDefinition;
    impl_def: BoundInterfaceImplementation;
    impl_for_def: BoundInterfaceForImplementation;
    namespace_def: BoundNamespaceDefinition;
    initial_routine: BoundInitialRoutineDefinition;
    type_ref_def: BoundTypeReferenceDefinition;
    class_field: BoundClassFieldDefinition;
    global_var_def: BoundGlobalVariableDefinition;
    meta_function_def: BoundMetaFunctionDefinition;
    meta_if_def: BoundMetaIfDefinition;
    meta_for_def: BoundMetaForDefinition;
    meta_while_def: BoundMetaWhileDefinition;
    meta_call_def: BoundMetaCallDefinition;

    fun get_name(this) -> string {
        if (this is BoundDefinition.function_def) { return this.function_def.get_name(); }
        if (this is BoundDefinition.class_def) { return this.class_def.get_name(); }
        if (this is BoundDefinition.enum_def) { return this.enum_def.get_name(); }
        if (this is BoundDefinition.interface_def) { return this.interface_def.get_name(); }
        if (this is BoundDefinition.impl_def) { return this.impl_def.get_name(); }
        if (this is BoundDefinition.impl_for_def) { return this.impl_for_def.get_name(); }
        if (this is BoundDefinition.namespace_def) { return this.namespace_def.get_name(); }
        if (this is BoundDefinition.initial_routine) { return this.initial_routine.get_name(); }
        if (this is BoundDefinition.type_ref_def) { return this.type_ref_def.get_name(); }
        if (this is BoundDefinition.class_field) { return this.class_field.get_name(); }
        if (this is BoundDefinition.global_var_def) { return this.global_var_def.name; }
        if (this is BoundDefinition.meta_function_def) { return this.meta_function_def.get_name(); }
        if (this is BoundDefinition.meta_if_def) { return this.meta_if_def.get_name(); }
        if (this is BoundDefinition.meta_for_def) { return this.meta_for_def.get_name(); }
        if (this is BoundDefinition.meta_while_def) { return this.meta_while_def.get_name(); }
        if (this is BoundDefinition.meta_call_def) { return this.meta_call_def.get_name(); }
        return "";
    }

    fun get_pass_index(def: BoundDefinition) -> i64 {
        if (def is BoundDefinition.function_def) { return def.function_def.pass_index; }
        if (def is BoundDefinition.class_def) { return def.class_def.pass_index; }
        if (def is BoundDefinition.enum_def) { return def.enum_def.pass_index; }
        if (def is BoundDefinition.interface_def) { return def.interface_def.pass_index; }
        if (def is BoundDefinition.impl_def) { return def.impl_def.pass_index; }
        if (def is BoundDefinition.impl_for_def) { return def.impl_for_def.pass_index; }
        if (def is BoundDefinition.namespace_def) { return def.namespace_def.pass_index; }
        if (def is BoundDefinition.initial_routine) { return def.initial_routine.pass_index; }
        if (def is BoundDefinition.type_ref_def) { return def.type_ref_def.pass_index; }
        if (def is BoundDefinition.class_field) { return def.class_field.pass_index; }
        if (def is BoundDefinition.global_var_def) { return def.global_var_def.pass_index; }
        if (def is BoundDefinition.meta_function_def) { return def.meta_function_def.pass_index; }
        if (def is BoundDefinition.meta_if_def) { return def.meta_if_def.pass_index; }
        if (def is BoundDefinition.meta_for_def) { return def.meta_for_def.pass_index; }
        if (def is BoundDefinition.meta_while_def) { return def.meta_while_def.pass_index; }
        if (def is BoundDefinition.meta_call_def) { return def.meta_call_def.pass_index; }
        return 0;
    }

    fun set_pass_index(def: BoundDefinition, v: i64) {
        if (def is BoundDefinition.function_def) { def.function_def.pass_index = v; }
        if (def is BoundDefinition.class_def) { def.class_def.pass_index = v; }
        if (def is BoundDefinition.enum_def) { def.enum_def.pass_index = v; }
        if (def is BoundDefinition.interface_def) { def.interface_def.pass_index = v; }
        if (def is BoundDefinition.impl_def) { def.impl_def.pass_index = v; }
        if (def is BoundDefinition.impl_for_def) { def.impl_for_def.pass_index = v; }
        if (def is BoundDefinition.namespace_def) { def.namespace_def.pass_index = v; }
        if (def is BoundDefinition.initial_routine) { def.initial_routine.pass_index = v; }
        if (def is BoundDefinition.type_ref_def) { def.type_ref_def.pass_index = v; }
        if (def is BoundDefinition.class_field) { def.class_field.pass_index = v; }
        if (def is BoundDefinition.global_var_def) { def.global_var_def.pass_index = v; }
        if (def is BoundDefinition.meta_function_def) { def.meta_function_def.pass_index = v; }
        if (def is BoundDefinition.meta_if_def) { def.meta_if_def.pass_index = v; }
        if (def is BoundDefinition.meta_for_def) { def.meta_for_def.pass_index = v; }
        if (def is BoundDefinition.meta_while_def) { def.meta_while_def.pass_index = v; }
        if (def is BoundDefinition.meta_call_def) { def.meta_call_def.pass_index = v; }
    }
}

}
