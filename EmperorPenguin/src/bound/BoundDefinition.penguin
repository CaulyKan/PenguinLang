namespace emperor {

class BoundVTableSlot {
    interface_method: mut Option<BoundFunctionSymbol> = new Option<BoundFunctionSymbol>.none();
    implementation_method: mut Option<BoundFunctionSymbol> = new Option<BoundFunctionSymbol>.none();
}

class BoundVTable {
    interface_type: BoundType = new BoundType();
    slots: mut _utils.List<BoundVTableSlot> = new _utils.List<BoundVTableSlot>();
}

class BoundEnumMemberDefinition {
    name: string = "";
    member_symbol: Option<BoundEnumMemberSymbol> = new Option<BoundEnumMemberSymbol>.none();
    member_type: BoundType = new BoundType();
    value: i64 = 0;

    fun new(mut this, name: string, value: i64, member_type: mut BoundType) {
        this.name = name;
        this.value = value;
        this.member_type = member_type;
    }
}

class BoundFunctionDefinition {
    pass_index: mut i64 = 0;
    name: string = "";
    full_name: string = "";
    symbol: Option<BoundFunctionSymbol> = new Option<BoundFunctionSymbol>.none();
    parameters: mut _utils.List<BoundFunctionParameter> = new _utils.List<BoundFunctionParameter>();
    return_type: BoundType = new BoundType();
    body: Option<BoundExpression> = new Option<BoundExpression>.none();
    scope: Option<BoundScope> = new Option<BoundScope>.none();
    is_extern: bool = false;
    is_pure: bool = false;
    is_static: bool = false;
    is_new: bool = false;
    generic_params: mut _utils.List<string> = new _utils.List<string>();
    is_generic_template: bool = false;
    // D6: non-type (value) template params of a value-template FUNCTION (e.g. N in
    // #template<N:i32> fun filled()), and the concrete values bound at specialization.
    // Parallel lists; the specialized body substitutes N -> the constant (mirrors
    // BoundClassDefinition.value_param_names/values).
    value_param_names: mut _utils.List<string> = new _utils.List<string>();
    value_param_values: mut _utils.List<i64> = new _utils.List<i64>();
    // D6: source text of non-i64 value params (bool/string/double), parallel to
    // value_param_names/values. Empty for i64 value params. Used by
    // substitute_value_params to emit the correctly-typed literal.
    value_param_texts: mut _utils.List<string> = new _utils.List<string>();
    // D6: static kind of each value param ("i64"/"bool"/"string"/"double"),
    // parallel to value_param_names. Used by substitute_value_params to build the
    // correctly-typed literal (no text heuristics).
    value_param_kinds: mut _utils.List<string> = new _utils.List<string>();
    // Dyn-lib routing: this def's compiled symbol lives in a .penguin-lib, so the
    // consumer emits a declaration (extern) and links against the lib instead of
    // lowering a body. Set for lib-source defs and shipped generic instances.
    is_lib_export: bool = false;
    // Set on monomorphized generic instances (produced by specialize_*), so
    // collect_instances can list the shipped instances in a lib's metadata.
    is_specialized: bool = false;

    fun new(mut this, name: string, full_name: string, is_extern: mut bool, is_pure: mut bool, is_new: mut bool, is_static: mut bool) {
        this.name = name;
        this.full_name = full_name;
        this.is_extern = is_extern;
        this.is_pure = is_pure;
        this.is_new = is_new;
        this.is_static = is_static;
    }

    fun get_name(this) -> string {
        return this.name;
    }
}

class BoundClassDefinition {
    pass_index: mut i64 = 0;
    name: string = "";
    full_name: string = "";
    type_symbol: Option<BoundTypeSymbol> = new Option<BoundTypeSymbol>.none();
    bound_type: BoundType = new BoundType();
    scope: Option<BoundScope> = new Option<BoundScope>.none();
    fields: mut _utils.List<BoundDefinition> = new _utils.List<BoundDefinition>();
    methods: mut _utils.List<BoundDefinition> = new _utils.List<BoundDefinition>();
    constructors: mut _utils.List<BoundDefinition> = new _utils.List<BoundDefinition>();
    interface_impls: mut _utils.List<BoundDefinition> = new _utils.List<BoundDefinition>();
    vtables: mut _utils.List<BoundVTable> = new _utils.List<BoundVTable>();
    generic_params: mut _utils.List<string> = new _utils.List<string>();
    // req5: non-type (value) template params (e.g. N in #template<N:i32> class A),
    // and the concrete values bound at specialization (parallel lists). Used to
    // substitute the param identifier -> a constant literal in field initializers
    // and method bodies of the specialized class.
    value_param_names: mut _utils.List<string> = new _utils.List<string>();
    value_param_values: mut _utils.List<i64> = new _utils.List<i64>();
    is_value_class: mut Option<bool> = new Option<bool>.none();
    constructor: Option<BoundFunctionDefinition> = new Option<BoundFunctionDefinition>.none();
    ast_source: Option<Definition> = new Option<Definition>.none();
    is_generic_template: bool = false;
    is_lib_export: bool = false;
    is_specialized: bool = false;
    // Interface names this class implements (from its `impl ...` members), populated
    // by the AST-fallback reflection (MetaEngine.spec_to_bound_type) so meta codegen
    // can check e.g. whether a field's type implements IJsonSerializable at
    // def-splice time. Only filled on the AST-fallback dummies, not the bound defs.
    implemented_interfaces: mut _utils.List<string> = new _utils.List<string>();

    fun new(mut this, name: string, full_name: string) {
        this.name = name;
        this.full_name = full_name;
    }

    // True if this class has an `impl <iface>` / `impl <iface> for ...` member
    // named `iface_name` (compared on the interface's simple name).
    fun has_interface(this, iface_name: string) -> bool {
        let i: mut i64 = 0;
        while (i < cast<i64>(this.implemented_interfaces.size())) {
            if (this.implemented_interfaces.at(cast<u64>(i)).some == iface_name) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    fun get_name(this) -> string {
        return this.name;
    }

    fun typed_fields(this) -> _utils.List<BoundClassFieldDefinition> {
        let result: mut _utils.List<BoundClassFieldDefinition> = new _utils.List<BoundClassFieldDefinition>();
        for (let d in this.fields) {
            if (d is BoundDefinition.class_field) {
                result.push(d.class_field);
            }
        }
        return result;
    }

    fun typed_methods(this) -> _utils.List<BoundFunctionDefinition> {
        let result: mut _utils.List<BoundFunctionDefinition> = new _utils.List<BoundFunctionDefinition>();
        for (let d in this.methods) {
            if (d is BoundDefinition.function_def) {
                result.push(d.function_def);
            }
        }
        return result;
    }
}

class BoundEnumDefinition {
    pass_index: mut i64 = 0;
    name: string = "";
    full_name: string = "";
    type_symbol: Option<BoundTypeSymbol> = new Option<BoundTypeSymbol>.none();
    bound_type: BoundType = new BoundType();
    scope: Option<BoundScope> = new Option<BoundScope>.none();
    members: mut _utils.List<BoundEnumMemberDefinition> = new _utils.List<BoundEnumMemberDefinition>();
    methods: mut _utils.List<BoundDefinition> = new _utils.List<BoundDefinition>();
    generic_params: mut _utils.List<string> = new _utils.List<string>();
    value_symbol: Option<BoundVariableSymbol> = new Option<BoundVariableSymbol>.none();
    interface_impls: mut _utils.List<BoundDefinition> = new _utils.List<BoundDefinition>();
    vtables: mut _utils.List<BoundVTable> = new _utils.List<BoundVTable>();
    ast_source: Option<Definition> = new Option<Definition>.none();
    is_lib_export: bool = false;
    is_specialized: bool = false;
    // D6/req5: non-type (value) template params (N in #template(N: i32) enum E) and
    // the concrete values/texts/kinds bound at specialization. Parallel lists; the
    // specialized methods' bodies substitute N -> the constant. Mirrors
    // BoundClassDefinition.value_param_*.
    value_param_names: mut _utils.List<string> = new _utils.List<string>();
    value_param_values: mut _utils.List<i64> = new _utils.List<i64>();
    value_param_texts: mut _utils.List<string> = new _utils.List<string>();
    value_param_kinds: mut _utils.List<string> = new _utils.List<string>();

    fun new(mut this, name: string, full_name: string) {
        this.name = name;
        this.full_name = full_name;
    }

    fun get_name(this) -> string {
        return this.name;
    }
}

class BoundInterfaceDefinition {
    pass_index: mut i64 = 0;
    name: string = "";
    full_name: string = "";
    type_symbol: Option<BoundTypeSymbol> = new Option<BoundTypeSymbol>.none();
    bound_type: BoundType = new BoundType();
    scope: Option<BoundScope> = new Option<BoundScope>.none();
    methods: mut _utils.List<BoundDefinition> = new _utils.List<BoundDefinition>();
    // Nested `impl IOther<T> { ... }` blocks: each is a BoundDefinition.impl_def
    // whose methods implement another interface (interface inheritance). These
    // methods are bound/emitted and feed the interface's own vtables.
    interface_impls: mut _utils.List<BoundDefinition> = new _utils.List<BoundDefinition>();
    // Vtables this interface provides for OTHER interfaces via its nested impls
    // (e.g. IBar has an IFoo vtable). Classes implementing this interface inherit
    // them transitively (see merge_class_vtables).
    vtables: mut _utils.List<BoundVTable> = new _utils.List<BoundVTable>();
    generic_params: mut _utils.List<string> = new _utils.List<string>();
    ast_source: Option<Definition> = new Option<Definition>.none();
    is_lib_export: bool = false;
    is_specialized: bool = false;
    // D6/req5: non-type (value) template params (N in #template(N: i32) interface I)
    // and the concrete values bound at specialization. Parallel lists; the
    // specialized default methods' bodies substitute N -> the constant.
    value_param_names: mut _utils.List<string> = new _utils.List<string>();
    value_param_values: mut _utils.List<i64> = new _utils.List<i64>();
    value_param_texts: mut _utils.List<string> = new _utils.List<string>();
    value_param_kinds: mut _utils.List<string> = new _utils.List<string>();

    fun new(mut this, name: string, full_name: string) {
        this.name = name;
        this.full_name = full_name;
    }

    fun get_name(this) -> string {
        return this.name;
    }
}

class BoundInterfaceImplementation {
    pass_index: mut i64 = 0;
    interface_type: BoundType = new BoundType();
    implementing_type: BoundType = new BoundType();
    methods: mut _utils.List<BoundDefinition> = new _utils.List<BoundDefinition>();
    vtable: Option<BoundVTable> = new Option<BoundVTable>.none();
    // For impls injected by a `#specializing` block: the AST impl fragment it was
    // bound from. The specialized class's AST template does NOT contain this impl
    // (it is conditional per-instantiation), so pass 6 (vtable building) and pass 8
    // (method-body binding) need the fragment here to build slots / bind bodies.
    source_impl_def: Option<Definition> = new Option<Definition>.none();
    fun get_name(this) -> string {
        return "<impl>";
    }
}

class BoundInterfaceForImplementation {
    pass_index: mut i64 = 0;
