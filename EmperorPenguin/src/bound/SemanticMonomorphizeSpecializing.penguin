// #specializing INJECTION + name MANGLING (batch 0.3 mechanical split of
// SemanticMonomorphize.penguin — method bodies moved verbatim, see the
// driver class there): run_one_specializing_block executes each
// #specializing block against a specialization and injects its impl
// fragments (plus the native Box interface-forwarding round), while the
// mangle helpers (native_umangleable_*, bound_type_meta_name,
// replace_name_in_full_name) serve the gates and the meta type-token
// bridge.
namespace emperor {

class MonoSpecializing {
    // Back-reference to the owning pass (the src/bound pass-class
    // `model: mut Option<SemanticModel>` pattern, mirroring the batch 0.1/0.2
    // splits): all shared monomorphize state stays on MonomorphizePass
    // (whose own model field is reached via owner).
    owner: mut Option<MonomorphizePass> = new Option<MonomorphizePass>.none();

    fun new(mut this, owner: mut MonomorphizePass) {
        this.owner = new Option<MonomorphizePass>.some(owner);
    }

    // #specializing hook (run inside pass_monomorphize after specialize_class_def
    // / specialize_enum_def): run every #specializing block targeting `target_name`
    // with the concrete type/value args of `inst`, then inject the activated impl
    // fragments into the specialized def. Only runs when blocks exist (i.e. in a
    // meta-enabled compilation of a program that uses #specializing), so on
    // non-meta builds this is a no-op.
    fun run_specializing_for_spec(mut this, target_name: string, inst: BoundType, spec: BoundDefinition, global_scope: mut BoundScope) -> BoundDefinition {
        let owner: mut MonomorphizePass = this.owner.some;
        _utils.trace_enter("Enter run_specializing_for_spec");
        if (cast<i64>(owner.model.some.specializing_blocks.size()) == 0) { return spec; }
        // Match on the template's QUALIFIED SPELLING: strip the `<global>.`
        // prefix from the full name so it aligns with the block target
        // (`<global>._utils.List` → `_utils.List`; `__builtin.Box` blocks never
        // match a user `Box` whose full name is `<global>.Box` → `Box`).
        let qualified: mut string = target_name;
        // "<global>." is 9 chars.
        if (string_length(target_name) > 9 && string_substring(target_name, 0, 9) == "<global>.") {
            qualified = string_substring(target_name, 9, string_length(target_name) - 9);
        }
        // Short name (last dotted segment) for legacy blocks that target the
        // bare name (`#specializing foo<N>` inside a namespace).
        let short: mut string = qualified;
        let dot: mut i64 = string_find(qualified, ".");
        while (dot >= 0) {
            let nd: i64 = string_find_from(qualified, ".", dot + 1);
            if (nd < 0) { break; }
            dot = nd;
        }
        if (dot >= 0) {
            short = string_substring(qualified, dot + 1, string_length(qualified) - dot - 1);
        }
        let bi: mut i64 = 0;
        while (bi < cast<i64>(owner.model.some.specializing_blocks.size())) {
            let block: SpecializingBlockInfo = owner.model.some.specializing_blocks.at(cast<u64>(bi)).some;
            if (block.target_name == qualified || block.target_name == short) {
                this.run_one_specializing_block(block, inst, spec, global_scope);
            }
            bi = bi + 1;
        }
        return spec;
    }

    fun run_one_specializing_block(mut this, block: SpecializingBlockInfo, inst: BoundType, spec: BoundDefinition, global_scope: mut BoundScope) {
        let owner: mut MonomorphizePass = this.owner.some;
        _utils.trace_enter("Enter run_one_specializing_block");
        // NOTE: no meta_runtime_available() gate here — that flag tracks the
        // metaconfig build variant (stub in the default project), NOT whether
        // the JIT is linked. The bootstrap's pass2 carries the stub config but
        // IS JIT-linked and must run the blocks, or pass3 (built by stub-pass2)
        // and pass4 (built by full-pass3) diverge and the bootstrap never
        // converges. Block-bearing files (json & friends) are Full-project only,
        // so pass1/VM/dotnet builds never collect blocks in the first place.
        //
        // NATIVE GATE: blocks whose gate is exactly `umangleable(<param>)` (the
        // core_builtin IUniqueMangleName blocks) are evaluated natively — no
        // JIT. A JIT gate would recurse: compiling the gate is a unit-B
        // compilation whose base sources (core_builtin) carry these very
        // blocks, which would fire again. Native evaluation terminates and is
        // also available in non-JIT nested contexts. On success ALL impl
        // fragments activate (these blocks have a single branch); on failure
        // none do. Other gates (e.g. json_deserializable_type) keep the JIT
        // path — their files are not base sources, so no recursion.
        let native: Option<bool> = this.native_umangleable_gate(block, inst);
        if (native.is_some()) {
            if (native.some) {
                let ni: mut i64 = 0;
                while (ni < cast<i64>(block.impl_fragments.size())) {
                    let frag: Definition = block.impl_fragments.at(cast<u64>(ni)).some;
                    if (frag is Definition.impl_def) {
                        this.inject_specializing_impl(frag.impl_def, spec, global_scope);
                    }
                    ni = ni + 1;
                }
            }
            return;
        }
        // Ensure the module-global active_meta is THIS model's engine so the
        // callback's emperor.penguin_meta_activate_impl pushes land on the
        // specializing_active_slots we read back below.
        owner.model.some.meta_rewriter.seed_meta_engine();
        // Build the callback args positionally from inst.generic_args, matching the
        // callback's param kinds (type → token, i64/bool → value, string → value).
        let args: mut _utils.List<i64> = new _utils.List<i64>();
        let ai: mut i64 = 0;
        while (ai < cast<i64>(block.bmf.parameters.size())) {
            let arg_val: mut i64 = 0;
            if (ai < cast<i64>(inst.generic_args.size())) {
                let arg: BoundTypeArg = inst.generic_args.at(cast<u64>(ai)).some;
                let kind: string = block.bmf.parameters.at(cast<u64>(ai)).some.kind;
                if (kind == "type") {
                    let name: string = this.bound_type_meta_name(arg_as_bound_type(arg));
                    let token: u64 = owner.model.some.meta_engine.get_or_assign_type_token(name);
                    arg_val = cast<i64>(token);
                } else if (kind == "bool") {
                    if (arg is BoundTypeArg.value_arg) {
                        if (arg.value_arg.bool_val) { arg_val = 1; }
                    }
                } else {
                    if (arg is BoundTypeArg.value_arg) { arg_val = arg.value_arg.as_i64(); }
                }
            }
            args.push(arg_val);
            ai = ai + 1;
        }
        owner.model.some.meta_engine.specializing_active_slots = new _utils.List<i64>();
        owner.model.some.meta_engine.call_meta_function_stub(block.bmf, args);
        // Inject every activated impl slot.
        let si: mut i64 = 0;
        while (si < cast<i64>(owner.model.some.meta_engine.specializing_active_slots.size())) {
            let slot: i64 = owner.model.some.meta_engine.specializing_active_slots.at(cast<u64>(si)).some;
            if (slot >= 0 && slot < cast<i64>(block.impl_fragments.size())) {
                let frag: Definition = block.impl_fragments.at(cast<u64>(slot)).some;
                if (frag is Definition.impl_def) {
                    this.inject_specializing_impl(frag.impl_def, spec, global_scope);
                }
            }
            si = si + 1;
        }
    }

    // ==== Box interface forwarding (primitive interfaces round) ====
    //
    // When __builtin.Box<T> is specialized, every interface T implements (per
    // the pass-1-visible declarations: class/enum interface_impls, the
    // primitive_impl registry for primitives incl. string, and the interface
    // set of an inner specialization for nested Box<Box<...>>) is automatically
    // re-implemented on the Box by a forwarding impl:
    //     fun m(this, args...) -> R { return this.value.m(args...); }
    // Runtime-marker interfaces are NOT forwarded (forwarding ICopy would flip
    // Box's reference semantics); interfaces Box already carries (its own
    // IReferenceType, a #specializing-injected impl like std.IJsonSerializable)
    // are skipped by the has-impl check. Generic interfaces and interfaces
    // with generic methods are skipped for now (their method signatures
    // reference the interface's own template parameters, which do not resolve
    // in the Box specialization's scope).
    //
    // The impl text is assembled natively (no JIT — the core_builtin blocks'
    // native-gate precedent) and parsed through the ordinary Lexer/Parser, so
    // the fragment flows through inject_specializing_impl exactly like a
    // source #specializing fragment and the caller's A5 late bind binds the
    // forwarding bodies.

    fun box_forward_iface_excluded(this, tail: string) -> bool {
        return tail == "ICopy" || tail == "IReferenceType" || tail == "IValueType"
            || tail == "IMemoryDispose" || tail == "IUniqueMangleName" || tail == "ISync";
    }

    fun try_inject_box_forwarding(mut this, template_full_name: string, inst: BoundType, spec: BoundDefinition, global_scope: mut BoundScope) {
        let owner: mut MonomorphizePass = this.owner.some;
        // The template's full_name carries the compilation's scope prefix
        // (e.g. "<global>.__builtin.Box"), so match on the qualified suffix.
        if (string_find(template_full_name, "__builtin.Box") < 0) { return; }
        if (cast<i64>(inst.generic_args.size()) != 1) { return; }
        if (!(spec is BoundDefinition.class_def)) { return; }
        let cls: mut BoundClassDefinition = spec.class_def;
        if (cls.scope.is_none()) { return; }
        let t_bt: BoundType = arg_as_bound_type(inst.generic_args.at(cast<u64>(0)).some);
        // Nested boxes: when T is itself a generic instantiation, make sure
        // ITS specialization (and therefore ITS forwarding impls) exists
        // BEFORE reading T's interface set — ensure_specialized_def is
        // idempotent, so this is safe when the inner spec already exists.
        let t_iface_defs: mut _utils.List<BoundInterfaceDefinition> = new _utils.List<BoundInterfaceDefinition>();
        if (cast<i64>(t_bt.generic_args.size()) > 0) {
            // ensure returns none when the inner spec ALREADY exists — recover
            // it by mangled-name lookup (the same lookup
            // is_instantiation_already_exists uses, so the name is exact).
            let inner_def: mut Option<BoundDefinition> = owner.specialize.ensure_specialized_def(t_bt, global_scope);
            if (inner_def.is_none()) {
                if (let tmpl := t_bt.type_definition.some) {
                    let iname: mut string = "";
                    if (tmpl is BoundDefinition.class_def) { iname = tmpl.class_def.full_name; }
                    if (tmpl is BoundDefinition.enum_def) { iname = tmpl.enum_def.full_name; }
                    if (tmpl is BoundDefinition.interface_def) { iname = tmpl.interface_def.full_name; }
                    if (string_length(iname) > 0) {
                        let imangled: string = MonomorphizePass.mangle_generic_name(iname, t_bt.generic_args);
                        let isym: Option<BoundSymbol> = global_scope.lookup_type_in_scope(imangled);
                        if (isym.is_some() && isym.some is BoundSymbol.type_sym) {
                            if (let itd := isym.some.type_sym.bound_type.type_definition.some) {
                                inner_def = new Option<BoundDefinition>.some(itd);
                            }
                        }
                    }
                }
            }
            if (inner_def.is_some() && inner_def.some is BoundDefinition.class_def) {
                this.box_collect_class_ifaces(inner_def.some.class_def, t_iface_defs);
            }
            if (inner_def.is_some() && inner_def.some is BoundDefinition.enum_def) {
                this.box_collect_enum_ifaces(inner_def.some.enum_def, t_iface_defs);
            }
        } else {
            if (t_bt.kind is TypeKind.PrimitiveKind) {
                this.box_collect_primitive_ifaces(t_bt.display_name(), t_iface_defs, global_scope);
            } else {
                if (let td := t_bt.type_definition.some) {
                    if (td is BoundDefinition.class_def) { this.box_collect_class_ifaces(td.class_def, t_iface_defs); }
                    if (td is BoundDefinition.enum_def) { this.box_collect_enum_ifaces(td.enum_def, t_iface_defs); }
                }
            }
        }
        // For each forwarded interface: assemble the impl text, parse, inject.
        let ii: mut i64 = 0;
        while (ii < cast<i64>(t_iface_defs.size())) {
            let iface: BoundInterfaceDefinition = t_iface_defs.at(cast<u64>(ii)).some;
            ii = ii + 1;
            let tail: string = owner.model.some.iface_name_key(iface.full_name);
            if (this.box_forward_iface_excluded(tail)) { continue; }
            // Generic interfaces: skip (method signatures reference the
            // interface's own template params — unresolvable in the Box scope).
            if (cast<i64>(iface.generic_params.size()) > 0) { continue; }
            // Already implemented on the Box (its own IReferenceType, a
            // #specializing-injected impl, or a previous forwarding round)?
            if (this.box_class_implements(cls, tail)) { continue; }
            let text_opt: Option<string> = this.box_forward_impl_text(iface);
            if (text_opt.is_none()) { continue; }
            let lex: Lexer = new Lexer(text_opt.some, "<box_forward>");
            let toks: _utils.List<Token> = lex.tokenize();
            let p: Parser = new Parser(toks);
            let unit: CompilationUnit = p.parse_definitions_unit();
            if (p.has_errors()) {
                owner.model.some.report_error(new ErrorCode.E_INTERNAL(),
                    "Box interface forwarding: generated impl for '" + iface.full_name + "' failed to parse",
                    new SourceLocation("", 0, 0));
                continue;
            }
            if (cast<i64>(unit.definitions.size()) != 1) { continue; }
            let def: Definition = unit.definitions.at(cast<u64>(0)).some;
            if (def is Definition.impl_def) {
                this.inject_specializing_impl(def.impl_def, spec, global_scope);
            }
        }
    }

    fun box_class_implements(this, cls: BoundClassDefinition, iface_tail: string) -> bool {
        let owner: mut MonomorphizePass = this.owner.some;
        let i: mut i64 = 0;
        while (i < cast<i64>(cls.interface_impls.size())) {
            let bi: BoundDefinition = cls.interface_impls.at(cast<u64>(i)).some;
            if (bi is BoundDefinition.impl_def) {
                if (owner.model.some.iface_name_key(bi.impl_def.interface_type.display_name()) == iface_tail) {
                    return true;
                }
            }
            i = i + 1;
        }
        return false;
    }

    fun box_collect_class_ifaces(this, cls: BoundClassDefinition, out: mut _utils.List<BoundInterfaceDefinition>) {
        let i: mut i64 = 0;
        while (i < cast<i64>(cls.interface_impls.size())) {
            let bi: BoundDefinition = cls.interface_impls.at(cast<u64>(i)).some;
            if (bi is BoundDefinition.impl_def) {
                this.box_push_iface(bi.impl_def.interface_type, out);
            }
            i = i + 1;
        }
    }

    fun box_collect_enum_ifaces(this, e: BoundEnumDefinition, out: mut _utils.List<BoundInterfaceDefinition>) {
        let i: mut i64 = 0;
        while (i < cast<i64>(e.interface_impls.size())) {
            let bi: BoundDefinition = e.interface_impls.at(cast<u64>(i)).some;
            if (bi is BoundDefinition.impl_def) {
                this.box_push_iface(bi.impl_def.interface_type, out);
            }
            i = i + 1;
        }
    }

    fun box_collect_primitive_ifaces(this, prim_name: string, out: mut _utils.List<BoundInterfaceDefinition>, global_scope: mut BoundScope) {
        let owner: mut MonomorphizePass = this.owner.some;
        let i: mut i64 = 0;
        while (i < cast<i64>(owner.model.some.primitive_impl_for_type.size())) {
            if (owner.model.some.primitive_impl_for_type.at(cast<u64>(i)).some == prim_name) {
                let iface_name: string = owner.model.some.primitive_impl_iface.at(cast<u64>(i)).some;
                let sym: Option<BoundSymbol> = global_scope.lookup_type_anywhere(iface_name);
                if (sym.is_some() && sym.some is BoundSymbol.type_sym) {
                    this.box_push_iface(sym.some.type_sym.bound_type, out);
                }
            }
            i = i + 1;
        }
    }

    fun box_push_iface(this, iface_bt: BoundType, out: mut _utils.List<BoundInterfaceDefinition>) {
        let owner: mut MonomorphizePass = this.owner.some;
        if (iface_bt.type_definition.is_none()) { return; }
        let td: BoundDefinition = iface_bt.type_definition.some;
        if (!(td is BoundDefinition.interface_def)) { return; }
        let iface: BoundInterfaceDefinition = td.interface_def;
        let tail: string = owner.model.some.iface_name_key(iface.full_name);
        let i: mut i64 = 0;
        while (i < cast<i64>(out.size())) {
            if (owner.model.some.iface_name_key(out.at(cast<u64>(i)).some.full_name) == tail) { return; }
            i = i + 1;
        }
        out.push(iface);
    }

    // Assemble `impl <iface> { fun m(this, args...) -> R { return
    // this.value.m(args...); } ... }` from the interface's declared methods
    // (their AST signatures re-spelled verbatim). Returns none when the
    // interface has a generic method (not forwardable yet) or no usable
    // signature.
    fun box_forward_impl_text(this, iface: BoundInterfaceDefinition) -> Option<string> {
        let mut body = "";
        let count: mut i64 = 0;
        let mi: mut i64 = 0;
        while (mi < cast<i64>(iface.methods.size())) {
            let bm: BoundDefinition = iface.methods.at(cast<u64>(mi)).some;
            if (bm is BoundDefinition.function_def) {
                if (cast<i64>(bm.function_def.generic_params.size()) > 0) { return new Option<string>.none(); }
                if (bm.function_def.ast_source.is_none()) { return new Option<string>.none(); }
                let ast_src: Definition = bm.function_def.ast_source.some;
                if (!(ast_src is Definition.function_def)) { return new Option<string>.none(); }
                let astf: FunctionDefinition = ast_src.function_def;
                let one: Option<string> = this.box_forward_method_text(astf);
                if (one.is_none()) { return new Option<string>.none(); }
                body = body + " " + one.some;
                count = count + 1;
            }
            mi = mi + 1;
        }
        if (count == 0) { return new Option<string>.none(); }
        // Short interface name: the impl binds in the Box specialization's
        // scope, where bind_impl_def's anywhere fallback resolves
        // cross-namespace interfaces (the #specializing-injection precedent).
        // The full_name's "<global>." file-namespace prefix is NOT valid
        // source syntax.
        return new Option<string>.some("impl " + iface.name + " {" + body + " }");
    }

    fun box_forward_method_text(this, astf: FunctionDefinition) -> Option<string> {
        // A `mut this` method's forwarding (`this.value.m()`) would need a
        // mutable value slot, which Box deliberately does not provide (the
        // constructor's immutable parameter cannot feed it on both
        // compilers) — interfaces containing one are not forwarded.
        let pi0: mut i64 = 0;
        while (pi0 < cast<i64>(astf.parameters.size())) {
            let prm0: Parameter = astf.parameters.at(cast<u64>(pi0)).some;
            if (prm0.is_this && prm0.is_mutable) { return new Option<string>.none(); }
            pi0 = pi0 + 1;
        }
        // Signature: this param mutability verbatim, other params re-spelled
        // from their AST type specifiers.
        let mut sig = "fun " + astf.name + "(";
        let mut call_args = "";
        let pi: mut i64 = 0;
        let first: mut bool = true;
        while (pi < cast<i64>(astf.parameters.size())) {
            let prm: Parameter = astf.parameters.at(cast<u64>(pi)).some;
            if (!first) { sig = sig + ", "; }
            if (prm.is_this) {
                if (prm.is_mutable) { sig = sig + "mut this"; } else { sig = sig + "this"; }
            } else {
                if (prm.type_spec.is_none()) { return new Option<string>.none(); }
                sig = sig + prm.name + " : " + prm.type_spec.some.build_text();
                if (string_length(call_args) > 0) { call_args = call_args + ", "; }
                call_args = call_args + prm.name;
            }
            first = false;
            pi = pi + 1;
        }
        sig = sig + ")";
        if (astf.return_type.is_some()) {
            sig = sig + " -> " + astf.return_type.some.build_text();
            sig = sig + " { return this.value." + astf.name + "(" + call_args + "); }";
        } else {
            sig = sig + " { this.value." + astf.name + "(" + call_args + "); }";
        }
        return new Option<string>.some(sig);
    }

    // Recognize the native-gate form `umangleable(<param>)` on a #specializing
    // block and evaluate it against the specialization's args. Returns:
    //   some(true)  — the gate passed (inject all impl fragments)
    //   some(false) — the gate failed (inject none)
    //   none        — the gate is NOT the native form (caller uses the JIT path)
    // The umangleable predicate itself, natively: primitives are renderable;
    // a class/enum is renderable iff its interface_impls carry IUniqueMangleName
    // (declared impls bind at pass 1; #specializing-injected impls push into the
    // same list); a template+args resolves its specialization and checks that.
    fun native_umangleable_gate(this, block: SpecializingBlockInfo, inst: BoundType) -> Option<bool> {
        if (block.bmf.body.is_none()) { return new Option<bool>.none(); }
        let body: Expression = block.bmf.body.some;
        if (!(body is Expression.code_block)) { return new Option<bool>.none(); }
        let cb: CodeBlockExpression = body.code_block;
        if (cast<i64>(cb.statements.size()) == 0) { return new Option<bool>.none(); }
        // The gate's `if` is the first statement (block_expr- or expression-wrapped).
        let st: Statement = cb.statements.at(cast<u64>(0)).some;
        let cond: mut Option<Expression> = new Option<Expression>.none();
        if (st is Statement.block_expr) {
            if (st.block_expr.expression.is_some()) {
                let e: Expression = st.block_expr.expression.some;
                if (e is Expression.if_expr) {
                    if (e.if_expr.condition.is_some()) { cond = e.if_expr.condition; }
                }
            }
        } else if (st is Statement.expression) {
            if (st.expression.expression.is_some()) {
                let e: Expression = st.expression.expression.some;
                if (e is Expression.if_expr) {
                    if (e.if_expr.condition.is_some()) { cond = e.if_expr.condition; }
                }
            }
        }
        if (cond.is_none()) { return new Option<bool>.none(); }
        // The condition must be `umangleable(<identifier>)`.
        if (!(cond.some is Expression.function_call)) { return new Option<bool>.none(); }
        let fc: FunctionCallExpression = cond.some.function_call;
        if (fc.callee.is_none()) { return new Option<bool>.none(); }
        if (!(fc.callee.some is Expression.identifier)) { return new Option<bool>.none(); }
        if (fc.callee.some.identifier.name != "umangleable") { return new Option<bool>.none(); }
        if (cast<i64>(fc.arguments.items.size()) != 1) { return new Option<bool>.none(); }
        let arg0: Expression = fc.arguments.items.at(cast<u64>(0)).some;
        if (!(arg0 is Expression.identifier)) { return new Option<bool>.none(); }
        let param_name: string = arg0.identifier.name;
        // Map the param name to the specialization's arg position.
        let pi: mut i64 = -1;
        let bi: mut i64 = 0;
        while (bi < cast<i64>(block.bmf.parameters.size())) {
            if (block.bmf.parameters.at(cast<u64>(bi)).some.name == param_name) { pi = bi; }
            bi = bi + 1;
        }
        if (pi < 0 || pi >= cast<i64>(inst.generic_args.size())) { return new Option<bool>.some(false); }
        let bt: BoundType = arg_as_bound_type(inst.generic_args.at(cast<u64>(pi)).some);
        return new Option<bool>.some(this.native_umangleable_type(bt));
    }

    fun native_umangleable_type(this, bt: BoundType) -> bool {
        let owner: mut MonomorphizePass = this.owner.some;
        if (bt.kind is TypeKind.PrimitiveKind) {
            // void is a primitive in the type registry but has no VALUE to
            // name: an `Option<void>`-style payload arg must not inject the
            // IUniqueMangleName impl (its body would call get_unique_name()
            // on a void payload, which has no impl).
            if (bt.primitive is PrimitiveType.VoidType) { return false; }
            return true;
        }
        if (bt.type_definition.is_none()) { return false; }
        let td: BoundDefinition = bt.type_definition.some;
        // CORE WRAPPERS: the IUniqueMangleName impl for List/Box/Option/Result/
        // Pair is injected by the core_builtin #specializing blocks gated on
        // `umangleable(<element>)` — so the wrapper is renderable EXACTLY when
        // its type arguments are. This is computed from the args alone (no
        // dependence on whether the specialization/injection has happened yet),
        // which is what makes the object-arg gate work during early passes.
        // Match by FULL name: a user-defined top-level `class Box` must not
        // masquerade as the wrapper — the short name would report it umangleable
        // with zero generic args, and the injected impl bodies would then call
        // get_unique_name() on a type that has none.
        let wrapper_name: mut string = "";
        if (td is BoundDefinition.class_def) { wrapper_name = td.class_def.full_name; }
        if (td is BoundDefinition.enum_def) { wrapper_name = td.enum_def.full_name; }
        let is_core_wrapper: bool = wrapper_name == "_utils.List" || wrapper_name == "__builtin.Box"
            || wrapper_name == "__builtin.Option" || wrapper_name == "__builtin.Result"
            || wrapper_name == "__builtin.Pair";
        if (is_core_wrapper) {
            let ai: mut i64 = 0;
            while (ai < cast<i64>(bt.generic_args.size())) {
                let arg: BoundTypeArg = bt.generic_args.at(cast<u64>(ai)).some;
                if (!arg_is_value(arg)) {
                    if (!this.native_umangleable_type(arg_as_bound_type(arg))) { return false; }
                }
                ai = ai + 1;
            }
            return true;
        }
        // Other class/enum: renderable iff its (specialized) def carries the impl.
        if (cast<i64>(bt.generic_args.size()) > 0) {
            let name: mut string = "";
            if (td is BoundDefinition.class_def) { name = td.class_def.full_name; }
            if (td is BoundDefinition.enum_def) { name = td.enum_def.full_name; }
            if (td is BoundDefinition.interface_def) { name = td.interface_def.full_name; }
            if (string_length(name) > 0) {
                let mangled: string = MonomorphizePass.mangle_generic_name(name, bt.generic_args);
                let spec_sym: Option<BoundSymbol> = owner.model.some.global_scope.lookup_type_in_scope(mangled);
                if (spec_sym.is_some() && spec_sym.some is BoundSymbol.type_sym) {
                    let spec_bt: BoundType = spec_sym.some.type_sym.bound_type;
                    if (spec_bt.type_definition.is_some()) {
                        return this.def_has_unique_mangle_impl(spec_bt.type_definition.some);
                    }
                }
            }
            return false;
        }
        return this.def_has_unique_mangle_impl(td);
    }

    fun def_has_unique_mangle_impl(this, td: BoundDefinition) -> bool {
        let impls: mut Option<_utils.List<BoundDefinition>> = new Option<_utils.List<BoundDefinition>>.none();
        if (td is BoundDefinition.class_def) {
            impls = new Option<_utils.List<BoundDefinition>>.some(td.class_def.interface_impls);
        }
        if (td is BoundDefinition.enum_def) {
            impls = new Option<_utils.List<BoundDefinition>>.some(td.enum_def.interface_impls);
        }
        if (impls.is_none()) { return false; }
        let i: mut i64 = 0;
        while (i < cast<i64>(impls.some.size())) {
            let d: BoundDefinition = impls.some.at(cast<u64>(i)).some;
            if (d is BoundDefinition.impl_def) {
                if (string_find(d.impl_def.interface_type.display_name(), "IUniqueMangleName") >= 0) { return true; }
            }
            i = i + 1;
        }
        return false;
    }

    // A resolvable name for a concrete BoundType, for the meta type-token bridge
    // (get_or_assign_type_token / emperor_penguin_meta_get_type). Primitives and
    // concrete defs use their name; generic references use the mangled name.
    fun bound_type_meta_name(this, bt: BoundType) -> string {
        let owner: mut MonomorphizePass = this.owner.some;
        if (bt.type_definition.is_some()) {
            let def_name: string = bt.type_definition.some.get_name();
            let def_full: mut string = def_name;
            let td: BoundDefinition = bt.type_definition.some;
            if (td is BoundDefinition.class_def) { def_full = td.class_def.full_name; }
            if (td is BoundDefinition.enum_def) { def_full = td.enum_def.full_name; }
            if (td is BoundDefinition.interface_def) { def_full = td.interface_def.full_name; }
            if (cast<i64>(bt.generic_args.size()) > 0) {
                return MonomorphizePass.mangle_generic_name(def_full, bt.generic_args);
            }
            return def_name;
        }
        return bt.display_name();
    }

    // Bind one activated impl fragment into the specialized class/enum and record
    // its AST fragment (source_impl_def) so pass 6 (vtables) and pass 8 (method
    // bodies) can process it. The fragment's `T` resolves in the specialized
    // class/enum scope.
    fun inject_specializing_impl(mut this, frag: InterfaceImplementation, spec: BoundDefinition, global_scope: mut BoundScope) {
        let owner: mut MonomorphizePass = this.owner.some;
        _utils.trace_enter("Enter inject_specializing_impl");
        if (spec is BoundDefinition.class_def) {
            let cls: mut BoundClassDefinition = spec.class_def;
            if (cls.scope.is_some()) {
                let bound: Option<BoundDefinition> = owner.model.some.build_scopes_pass.bind_impl_def(frag, cls.scope.some);
                if (bound.is_some() && bound.some is BoundDefinition.impl_def) {
                    let bi: mut BoundInterfaceImplementation = bound.some.impl_def;
                    bi.source_impl_def = new Option<Definition>.some(new Definition.impl_def(frag));
                    // The injected impl is created in pass 3 (after pass 2 resolved
                    // the template's own impl params), so resolve its method params
                    // + return types here against the specialized class scope.
                    this.resolve_injected_impl_methods(frag, bi, cls.scope.some, cls);
                    cls.interface_impls.push(bound.some);
                }
            }
        }
        if (spec is BoundDefinition.enum_def) {
            let e: mut BoundEnumDefinition = spec.enum_def;
            if (e.scope.is_some()) {
                let bound: Option<BoundDefinition> = owner.model.some.build_scopes_pass.bind_impl_def(frag, e.scope.some);
                if (bound.is_some() && bound.some is BoundDefinition.impl_def) {
                    let bi: mut BoundInterfaceImplementation = bound.some.impl_def;
                    bi.source_impl_def = new Option<Definition>.some(new Definition.impl_def(frag));
                    this.resolve_injected_impl_methods_for_enum(frag, bi, e.scope.some, e);
                    e.interface_impls.push(bound.some);
                    let mdump: mut string = "";
                    let di: mut i64 = 0;
                    while (di < cast<i64>(bi.methods.size())) {
                        let bm2: BoundDefinition = bi.methods.at(cast<u64>(di)).some;
                        if (bm2 is BoundDefinition.function_def) {
                            mdump = mdump + bm2.function_def.name + "(";
                            let pi2: mut i64 = 0;
                            while (pi2 < cast<i64>(bm2.function_def.parameters.size())) {
                                if (pi2 > 0) { mdump = mdump + ","; }
                                mdump = mdump + bm2.function_def.parameters.at(cast<u64>(pi2)).some.bound_type.display_name();
                                pi2 = pi2 + 1;
                            }
                            mdump = mdump + ") ";
                        }
                        di = di + 1;
                    }
                }
            }
        }
    }

    fun resolve_injected_impl_methods(mut this, ast_impl: InterfaceImplementation, bound_impl: mut BoundInterfaceImplementation, scope: BoundScope, cls: BoundClassDefinition) {
        let owner: mut MonomorphizePass = this.owner.some;
        let fi: mut i64 = 0;
        while (fi < cast<i64>(ast_impl.functions.size())) {
            let ast_func_def: Definition = ast_impl.functions.at(cast<u64>(fi)).some;
            if (ast_func_def is Definition.function_def) {
                let mi: mut i64 = 0;
                while (mi < cast<i64>(bound_impl.methods.size())) {
                    let bound_method: BoundDefinition = bound_impl.methods.at(cast<u64>(mi)).some;
                    if (bound_method is BoundDefinition.function_def && bound_method.function_def.name == ast_func_def.function_def.name) {
                        let bm: mut BoundFunctionDefinition = bound_method.function_def;
                        owner.model.some.resolve_types_pass.resolve_class_method_pair(ast_func_def.function_def, bm, scope, cls);
                        bound_impl.methods.set(cast<u64>(mi), new BoundDefinition.function_def(bm));
                    }
                    mi = mi + 1;
                }
            }
            fi = fi + 1;
        }
    }

    fun resolve_injected_impl_methods_for_enum(mut this, ast_impl: InterfaceImplementation, bound_impl: mut BoundInterfaceImplementation, scope: BoundScope, e: BoundEnumDefinition) {
        let owner: mut MonomorphizePass = this.owner.some;
        let fi: mut i64 = 0;
        while (fi < cast<i64>(ast_impl.functions.size())) {
            let ast_func_def: Definition = ast_impl.functions.at(cast<u64>(fi)).some;
            if (ast_func_def is Definition.function_def) {
                let mi: mut i64 = 0;
                while (mi < cast<i64>(bound_impl.methods.size())) {
                    let bound_method: BoundDefinition = bound_impl.methods.at(cast<u64>(mi)).some;
                    if (bound_method is BoundDefinition.function_def && bound_method.function_def.name == ast_func_def.function_def.name) {
                        let bm: mut BoundFunctionDefinition = bound_method.function_def;
                        owner.model.some.resolve_types_pass.resolve_enum_method_pair(ast_func_def.function_def, bm, scope, e);
                        bound_impl.methods.set(cast<u64>(mi), new BoundDefinition.function_def(bm));
                    }
                    mi = mi + 1;
                }
            }
            fi = fi + 1;
        }
    }

    fun replace_name_in_full_name(this, full_name: string, old_name: string, new_name: string) -> string {
        _utils.trace_enter("Enter replace_name_in_full_name");
        let dot_pos: i64 = string_find(full_name, "." + old_name);
        if (dot_pos >= 0) {
            let before: string = string_substring(full_name, 0, dot_pos);
            return before + "." + new_name;
        }
        return new_name;
    }
}

}
