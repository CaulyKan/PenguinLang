namespace emperor {

enum Mutability {
    Mutable;
    Immutable;
    Auto;
}

enum PrimitiveType {
    I8;
    I16;
    I32;
    I64;
    U8;
    U16;
    U32;
    U64;
    F32;
    F64;
    BoolType;
    CharType;
    StringType;
    VoidType;
}

enum TypeKind {
    PrimitiveKind;
    ClassKind;
    EnumKind;
    InterfaceKind;
    FunctionKind;
    TypeReferenceKind;
    ErrorKind;
}

// D5: the sub-kind of a value (non-type) template argument. Scalars carry their
// value directly; ObjectArg carries a live address (object_ref, M3b) + canonical
// unique_name for stable mangling/dedup of arbitrary data-structure args.
enum ValueArgSubKind {
    IntArg;
    BoolArg;
    StringArg;
    DoubleArg;
    ObjectArg;
}

// D5: a TYPE template argument (the T in Foo<T>). Thin wrapper so generic_args
// is a uniform List<BoundTypeArg> holding both type and value args.
class BoundTypeArgType {
    bound_type: BoundType = new BoundType();
}

// D5: a VALUE (non-type) template argument (the 5/true/"hi"/2.5/#make_list(...)
// in Foo<...>). value_type is the value's STATIC type (self-describing —
// distinguishes Foo<Option.some(5)> from Foo<my_box>). unique_name is the stable
// canonical name for non-scalar args (IUniqueName), used for mangling/dedup;
// "" for scalar args (mangled by value). object_ref is the live address for
// ObjectArg (M3b). Replaces the former is_template_value_arg hack fields.
class BoundTypeArgValue {
    value_type: BoundType = new BoundType();
    unique_name: mut string = "";
    value_arg_kind: mut ValueArgSubKind = new ValueArgSubKind.IntArg();
    int_val: mut i64 = 0;
    bool_val: mut bool = false;
    // StringArg: the string content. DoubleArg: the source text (cast<string> of a
    // double does not round-trip, so the canonical mangle text is kept here).
    string_val: mut string = "";
    double_val: mut double = 0.0;
    object_ref: mut i64 = 0;

    // The (value, text, kind) triple consumed by make_value_literal when
    // substituting a value param -> its constant inside a specialized body.
    fun as_i64(this) -> i64 {
        if (this.value_arg_kind is ValueArgSubKind.BoolArg) {
            if (this.bool_val) { return 1; }
            return 0;
        }
        // M6-step2 4b: an object arg's i64 projection is the LIVE ADDRESS — value
        // substitution into template bodies (and stub tokens) uses it.
        if (this.value_arg_kind is ValueArgSubKind.ObjectArg) {
            return this.object_ref;
        }
        return this.int_val;
    }

    fun as_text(this) -> string {
        if (this.value_arg_kind is ValueArgSubKind.StringArg) { return this.string_val; }
        if (this.value_arg_kind is ValueArgSubKind.DoubleArg) { return this.string_val; }
        if (this.value_arg_kind is ValueArgSubKind.BoolArg) {
            if (this.bool_val) { return "true"; }
            return "false";
        }
        return "";
    }

    fun kind_str(this) -> string {
        if (this.value_arg_kind is ValueArgSubKind.BoolArg) { return "bool"; }
        if (this.value_arg_kind is ValueArgSubKind.StringArg) { return "string"; }
        if (this.value_arg_kind is ValueArgSubKind.DoubleArg) { return "double"; }
        return "i64";
    }

    fun display_name(this) -> string {
        if (this.value_arg_kind is ValueArgSubKind.IntArg) { return cast<string>(this.int_val); }
        if (this.value_arg_kind is ValueArgSubKind.BoolArg) {
            if (this.bool_val) { return "true"; }
            return "false";
        }
        if (this.value_arg_kind is ValueArgSubKind.StringArg) { return this.string_val; }
        if (this.value_arg_kind is ValueArgSubKind.DoubleArg) { return this.string_val; }
        // ObjectArg: the stable canonical name (value-level mangle/dedup, D5).
        return this.unique_name;
    }

    fun is_same(this, other: BoundTypeArgValue) -> bool {
        if (cast<string>(this.value_arg_kind) != cast<string>(other.value_arg_kind)) { return false; }
        if (this.value_arg_kind is ValueArgSubKind.IntArg) { return this.int_val == other.int_val; }
        if (this.value_arg_kind is ValueArgSubKind.BoolArg) { return this.bool_val == other.bool_val; }
        if (this.value_arg_kind is ValueArgSubKind.StringArg) { return this.string_val == other.string_val; }
        if (this.value_arg_kind is ValueArgSubKind.DoubleArg) { return this.double_val == other.double_val; }
        // ObjectArg: compare by canonical unique_name (value-level dedup, D5).
        return this.unique_name == other.unique_name;
    }
}

// D5: a generic-template argument — either a TYPE arg or a VALUE arg.
// generic_args: List<BoundTypeArg>.
enum BoundTypeArg {
    type_arg: BoundTypeArgType;
    value_arg: BoundTypeArgValue;
}

// --- BoundTypeArg helpers (free, namespace emperor; usable from all units) ---
// NOTE: a BoundType passed for storage must be `mut BoundType` — assigning an
// immutable value to a field is rejected by the binder (mirrors
// BoundEnumMemberDefinition's `mut BoundType` constructor param).

fun make_type_arg(bt: mut BoundType) -> BoundTypeArg {
    let t: mut BoundTypeArgType = new BoundTypeArgType();
    t.bound_type = bt;
    return new BoundTypeArg.type_arg(t);
}

fun make_int_value_arg(val: i64) -> BoundTypeArg {
    let v: mut BoundTypeArgValue = new BoundTypeArgValue();
    v.value_arg_kind = new ValueArgSubKind.IntArg();
    v.int_val = val;
    return new BoundTypeArg.value_arg(v);
}

// Takes 0/1 (i64) rather than bool: the LLVMEmitter doesn't zext an inline i1
// (e.g. a `==` result) to the i8 bool ABI on call args, so callers pass an i64
// and we branch on it to assign bool literals (no i1 store).
fun make_bool_value_arg(val: i64) -> BoundTypeArg {
    let v: mut BoundTypeArgValue = new BoundTypeArgValue();
    v.value_arg_kind = new ValueArgSubKind.BoolArg();
    if (val != 0) { v.bool_val = true; } else { v.bool_val = false; }
    return new BoundTypeArg.value_arg(v);
}

fun make_string_value_arg(val: string) -> BoundTypeArg {
    let v: mut BoundTypeArgValue = new BoundTypeArgValue();
    v.value_arg_kind = new ValueArgSubKind.StringArg();
    v.string_val = val;
    return new BoundTypeArg.value_arg(v);
}

fun make_double_value_arg(val: double, text: string) -> BoundTypeArg {
    let v: mut BoundTypeArgValue = new BoundTypeArgValue();
    v.value_arg_kind = new ValueArgSubKind.DoubleArg();
    v.double_val = val;
    v.string_val = text;
    return new BoundTypeArg.value_arg(v);
}

fun make_object_value_arg(vt: mut BoundType, unique_name: string, object_ref: i64) -> BoundTypeArg {
    let v: mut BoundTypeArgValue = new BoundTypeArgValue();
    v.value_type = vt;
    v.value_arg_kind = new ValueArgSubKind.ObjectArg();
    v.unique_name = unique_name;
    v.object_ref = object_ref;
    return new BoundTypeArg.value_arg(v);
}

fun arg_is_value(a: BoundTypeArg) -> bool {
    return a is BoundTypeArg.value_arg;
}

// The underlying BoundType: type arg -> its type; value arg -> the value's STATIC
// type. Lets type-only consumers treat a generic_args slot uniformly.
fun arg_as_bound_type(a: BoundTypeArg) -> mut BoundType {
    if (a is BoundTypeArg.type_arg) { return a.type_arg.bound_type; }
    if (a is BoundTypeArg.value_arg) { return a.value_arg.value_type; }
    let e: mut BoundType = new BoundType();
    return e;
}

fun arg_display_name(a: BoundTypeArg) -> string {
    if (a is BoundTypeArg.type_arg) { return a.type_arg.bound_type.display_name(); }
    if (a is BoundTypeArg.value_arg) { return a.value_arg.display_name(); }
    return "?";
}

fun arg_is_same(a: BoundTypeArg, b: BoundTypeArg) -> bool {
    if (a is BoundTypeArg.type_arg) {
        if (b is BoundTypeArg.type_arg) {
            return a.type_arg.bound_type.is_same_type(b.type_arg.bound_type);
        }
        return false;
    }
    if (a is BoundTypeArg.value_arg) {
        if (b is BoundTypeArg.value_arg) {
            return a.value_arg.is_same(b.value_arg);
        }
    }
    return false;
}

fun primitive_type_to_string(p: PrimitiveType) -> string {
    if (p is PrimitiveType.I8) { return "i8"; }
    if (p is PrimitiveType.I16) { return "i16"; }
    if (p is PrimitiveType.I32) { return "i32"; }
    if (p is PrimitiveType.I64) { return "i64"; }
    if (p is PrimitiveType.U8) { return "u8"; }
    if (p is PrimitiveType.U16) { return "u16"; }
    if (p is PrimitiveType.U32) { return "u32"; }
    if (p is PrimitiveType.U64) { return "u64"; }
    if (p is PrimitiveType.F32) { return "f32"; }
    if (p is PrimitiveType.F64) { return "f64"; }
    if (p is PrimitiveType.BoolType) { return "bool"; }
    if (p is PrimitiveType.CharType) { return "char"; }
    if (p is PrimitiveType.StringType) { return "string"; }
    if (p is PrimitiveType.VoidType) { return "void"; }
    return "?";
}

fun mutability_to_string(m: Mutability) -> string {
    if (m is Mutability.Mutable) { return "mut "; }
    // Immutable is the default — no prefix (matches BabyPenguin behavior)
    // Auto also has no prefix (inherits from context)
    return "";
}

class BoundType {
    kind: TypeKind = new TypeKind.PrimitiveKind();
    primitive: PrimitiveType = new PrimitiveType.VoidType();
    type_definition: Option<BoundDefinition> = new Option<BoundDefinition>.none();
    // D5: template args (type AND value) as a uniform List<BoundTypeArg>. Value
    // args are BoundTypeArgValue (no longer hack fields on BoundType).
    generic_args: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
    mutability: Mutability = new Mutability.Immutable();
    is_async_function: bool = false;


    fun display_name(this) -> string {
        if (this.kind is TypeKind.PrimitiveKind) {
            return primitive_type_to_string(this.primitive);
        }
        if (this.kind is TypeKind.ErrorKind) {
            return "<error>";
        }
        if (this.kind is TypeKind.FunctionKind) {
            let prefix: mut string = "fun<";
            if (this.is_async_function) { prefix = "async_fun<"; }
            let sb : mut StringBuilder = new StringBuilder();
            sb.append(prefix);
            let i: mut i64 = 0;
            while (i < cast<i64>(this.generic_args.size())) {
                if (i > 0) { sb.append(", "); }
                sb.append(arg_display_name(this.generic_args.at(cast<u64>(i)).some));
                i = i + 1;
            }
            sb.append(">");
            return sb.to_string();
        }
        if (this.kind is TypeKind.TypeReferenceKind) {
            if (cast<i64>(this.generic_args.size()) > 0) {
                return arg_display_name(this.generic_args.at(cast<u64>(0)).some);
            }
            return "?";
        }
        let prefix: string = mutability_to_string(this.mutability);
        let base_name: mut string = "?";
        if (let td := this.type_definition.some) {
            base_name = td.get_name();
        }
        if (cast<i64>(this.generic_args.size()) > 0) {
            let mut sb = new StringBuilder();
            sb.append(prefix);
            sb.append(base_name);
            sb.append("<");
            let i: mut i64 = 0;
            while (i < cast<i64>(this.generic_args.size())) {
                if (i > 0) { sb.append(", "); }
                sb.append(arg_display_name(this.generic_args.at(cast<u64>(i)).some));
                i = i + 1;
            }
            sb.append(">");
            return sb.to_string();
        }
        return prefix + base_name;
    }

    fun with_mutability(this, m: mut Mutability) -> mut BoundType {
        let result: mut BoundType = new BoundType();
        result.kind = this.kind;
        result.primitive = this.primitive;
        result.type_definition = this.type_definition;
        let i: mut i64 = 0;
        while (i < cast<i64>(this.generic_args.size())) {
            result.generic_args.push(this.generic_args.at(cast<u64>(i)).some);
            i = i + 1;
        }
        result.mutability = m;
        result.is_async_function = this.is_async_function;
        return result;
    }

    fun with_generic_args(this, args: _utils.List<BoundTypeArg>) -> mut BoundType {
        let result: mut BoundType = new BoundType();
        result.kind = this.kind;
        result.primitive = this.primitive;
        result.type_definition = this.type_definition;
        let i: mut i64 = 0;
        while (i < cast<i64>(args.size())) {
            result.generic_args.push(args.at(cast<u64>(i)).some);
            i = i + 1;
        }
        result.mutability = this.mutability;
        result.is_async_function = this.is_async_function;
        return result;
    }

    fun is_same_type(this, other: BoundType) -> bool {
        if (cast<string>(this.kind) != cast<string>(other.kind)) { return false; }
        if (this.kind is TypeKind.PrimitiveKind) {
            return cast<string>(this.primitive) == cast<string>(other.primitive);
        }
        // M1b unification: a template+args type (Foo<X>, type_def = the template,
        // carries generic_args) and its specialized def (Foo__X, type_def = the
        // specialized class, no generic_args) are the SAME instantiation but stored
        // differently. Recognize the equivalence so e.g. `iter() -> _Iter<T>`'s
        // declared return type (template+args) matches the `new _Iter<T>()` value
        // (specialized). Without this, is_same_type returns false at the
        // generic_args-size check below (1 vs 0).
        if (this._matches_specialization_of(other)) { return true; }
        if (cast<i64>(this.generic_args.size()) != cast<i64>(other.generic_args.size())) {
            return false;
        }
        let i: mut i64 = 0;
        while (i < cast<i64>(this.generic_args.size())) {
            if (!arg_is_same(this.generic_args.at(cast<u64>(i)).some, other.generic_args.at(cast<u64>(i)).some)) {
                return false;
            }
            i = i + 1;
        }
        if (this.is_async_function != other.is_async_function) { return false; }
        if (this.type_definition.is_some() && other.type_definition.is_some()) {
            return this.type_definition.some.get_name() == other.type_definition.some.get_name();
        }
        return true;
    }

    // True if `this` and `other` are the same generic instantiation, one stored as
    // template+args (Foo<X>) and the other as a specialized def (Foo__X).
    fun _matches_specialization_of(this, other: BoundType) -> bool {
        if (this.type_definition.is_none() || other.type_definition.is_none()) { return false; }
        if (this._is_template_args_of(other)) { return true; }
        if (other._is_template_args_of(this)) { return true; }
        return false;
    }

    // `this` is template+args (Foo<X>, type_def = template, has generic_args) and
    // `other` is its specialized def (Foo__X, type_def = specialized, no args)?
    fun _is_template_args_of(this, other: BoundType) -> bool {
        let td_a: Option<BoundDefinition> = this.type_definition;
        let td_b: Option<BoundDefinition> = other.type_definition;
        if (td_a.is_none() || td_b.is_none()) { return false; }
        if (td_a.some is BoundDefinition.class_def && td_b.some is BoundDefinition.class_def) {
            let ca: BoundClassDefinition = td_a.some.class_def;
            let cb: BoundClassDefinition = td_b.some.class_def;
            if (ca.is_generic_template && !cb.is_generic_template
                && cast<i64>(this.generic_args.size()) > 0
                && cast<i64>(other.generic_args.size()) == 0) {
                // Compute the specialized name (mangle of template name + args) inline
                // (mangle_generic_name is a SemanticModel method, not callable here) and
                // compare to the specialized def's name.
                let mangled: mut string = ca.name;
                let mi: mut i64 = 0;
                while (mi < cast<i64>(this.generic_args.size())) {
                    let arg_name: string = arg_display_name(this.generic_args.at(cast<u64>(mi)).some);
                    let sanitized: mut string = "";
                    let mj: mut i64 = 0;
                    while (mj < string_length(arg_name)) {
                        let ch: string = string_char_at(arg_name, mj);
                        if (ch == " " || ch == "<" || ch == ">" || ch == ",") {
                            sanitized = sanitized + "_";
                        } else {
                            sanitized = sanitized + ch;
                        }
                        mj = mj + 1;
                    }
                    mangled = mangled + "__" + sanitized;
                    mi = mi + 1;
                }
                return mangled == cb.name;
            }
        }
        return false;
    }

    fun is_value_type(this) -> bool {
        if (this.kind is TypeKind.PrimitiveKind) {
            return true; // All primitives (including string) are value types
        }
        if (this.kind is TypeKind.EnumKind) { return true; }
        if (this.kind is TypeKind.ClassKind) {
            if (let def := this.type_definition.some) {
                if (def is BoundDefinition.class_def) {
                    let cls: BoundClassDefinition = def.class_def;
                    if (let vc := cls.is_value_class.some) {
                        return vc;
                    }
                }
            }
            return false;
        }
        return false;
    }

    fun is_reference_type(this) -> bool {
        if (this.kind is TypeKind.PrimitiveKind) {
            return false; // All primitives (including string) are value types
        }
        if (this.kind is TypeKind.EnumKind) { return false; }
        if (this.kind is TypeKind.ClassKind) {
            if (let def := this.type_definition.some) {
                if (def is BoundDefinition.class_def) {
                    let cls: BoundClassDefinition = def.class_def;
                    if (let vc := cls.is_value_class.some) {
                        return !vc;
                    }
                }
            }
            return true;
        }
        if (this.kind is TypeKind.InterfaceKind) { return true; }
        return false;
    }

    fun is_class(this) -> bool {
        return this.kind is TypeKind.ClassKind;
    }

    fun is_enum(this) -> bool {
        return this.kind is TypeKind.EnumKind;
    }

    fun is_interface(this) -> bool {
        return this.kind is TypeKind.InterfaceKind;
    }

    fun is_primitive(this) -> bool {
        return this.kind is TypeKind.PrimitiveKind;
    }

    fun class_def(this) -> Option<BoundClassDefinition> {
        if (let def := this.type_definition.some) {
            if (def is BoundDefinition.class_def) {
                return new Option<BoundClassDefinition>.some(def.class_def);
            }
        }
        return new Option<BoundClassDefinition>.none();
    }

    fun enum_def(this) -> Option<BoundEnumDefinition> {
        if (let def := this.type_definition.some) {
            if (def is BoundDefinition.enum_def) {
                return new Option<BoundEnumDefinition>.some(def.enum_def);
            }
        }
        return new Option<BoundEnumDefinition>.none();
    }

    fun interface_def(this) -> Option<BoundInterfaceDefinition> {
        if (let def := this.type_definition.some) {
            if (def is BoundDefinition.interface_def) {
                return new Option<BoundInterfaceDefinition>.some(def.interface_def);
            }
        }
        return new Option<BoundInterfaceDefinition>.none();
    }

    fun fields(this) -> _utils.List<BoundClassFieldDefinition> {
        let cd_opt: Option<BoundClassDefinition> = this.class_def();
        if (let cd := cd_opt.some) {
            return cd.typed_fields();
        }
        return new _utils.List<BoundClassFieldDefinition>();
    }

    fun methods(this) -> _utils.List<BoundFunctionDefinition> {
        if (this.kind is TypeKind.ClassKind) {
            let cd_opt: Option<BoundClassDefinition> = this.class_def();
            if (let cd := cd_opt.some) {
                return cd.typed_methods();
            }
        }
        if (this.kind is TypeKind.InterfaceKind) {
            let id_opt: Option<BoundInterfaceDefinition> = this.interface_def();
            if (let iface := id_opt.some) {
                let result: mut _utils.List<BoundFunctionDefinition> = new _utils.List<BoundFunctionDefinition>();
                let i: mut i64 = 0;
                while (i < cast<i64>(iface.methods.size())) {
                    let d: BoundDefinition = iface.methods.at(cast<u64>(i)).some;
                    if (d is BoundDefinition.function_def) {
                        result.push(d.function_def);
                    }
                    i = i + 1;
                }
                return result;
            }
        }
        return new _utils.List<BoundFunctionDefinition>();
    }

    fun variants(this) -> _utils.List<BoundEnumMemberDefinition> {
        let ed_opt: Option<BoundEnumDefinition> = this.enum_def();
        if (let ed := ed_opt.some) {
            return ed.members;
        }
        return new _utils.List<BoundEnumMemberDefinition>();
    }

    // Compile-time byte-size mirroring LLVMEmitter.llvm_type_size /
    // build_class_layout / build_enum_layout, so #sizeof(T) agrees with the
    // actual LLVM object size. Keep in sync with the emitter's layout rules.
    fun byte_size(this) -> i64 {
        if (this.kind is TypeKind.PrimitiveKind) {
            if (this.primitive is PrimitiveType.I8) { return 1; }
            if (this.primitive is PrimitiveType.U8) { return 1; }
            if (this.primitive is PrimitiveType.BoolType) { return 1; }
            if (this.primitive is PrimitiveType.I16) { return 2; }
            if (this.primitive is PrimitiveType.U16) { return 2; }
            if (this.primitive is PrimitiveType.I32) { return 4; }
            if (this.primitive is PrimitiveType.U32) { return 4; }
            if (this.primitive is PrimitiveType.F32) { return 4; }
            if (this.primitive is PrimitiveType.CharType) { return 4; }
            return 8;
        }
        if (this.kind is TypeKind.InterfaceKind) { return 8; }
        if (this.kind is TypeKind.ClassKind) {
            if (this.is_value_type()) {
                // Value class: metadata ptr (8) + aligned fields, final align_up(.,8).
                let offset: mut i64 = 8;
                let flds: _utils.List<BoundClassFieldDefinition> = this.fields();
                let fi: mut i64 = 0;
                while (fi < cast<i64>(flds.size())) {
                    let f: BoundClassFieldDefinition = flds.at(cast<u64>(fi)).some;
                    let fsize: i64 = f.bound_type.byte_size();
                    let falign: i64 = this.byte_align(f.bound_type);
                    offset = this.byte_align_up(offset, falign) + fsize;
                    fi = fi + 1;
                }
                return this.byte_align_up(offset, 8);
            }
            return 8;
        }
        if (this.kind is TypeKind.EnumKind) {
            let base: i64 = 16;
            let largest: mut i64 = 0;
            let vs: _utils.List<BoundEnumMemberDefinition> = this.variants();
            let vi: mut i64 = 0;
            while (vi < cast<i64>(vs.size())) {
                let vm: BoundEnumMemberDefinition = vs.at(cast<u64>(vi)).some;
                let mt: BoundType = vm.member_type;
                let is_void: bool = mt.kind is TypeKind.PrimitiveKind && mt.primitive is PrimitiveType.VoidType;
                // Tag-only variants (like Option.none) carry member_type == the
                // enum's OWN type — a sentinel set by resolve_enum_types, NOT a
                // recursive payload. Skip them like void (mirrors the
                // build_enum_layout is_self_enum check). Without this, #sizeof on
                // an enum with a tag-only variant infinite-recurses in byte_size
                // (Vector<Enum> segfault).
                let is_self: bool = mt.kind is TypeKind.EnumKind && mt.display_name() == this.display_name();
                if (!is_void && !is_self) {
                    let sz: i64 = mt.byte_size();
                    if (sz > largest) { largest = sz; }
                }
                vi = vi + 1;
            }
            if (largest == 0) { return base; }
            return this.byte_align_up(base, 8) + largest;
        }
        return 8;
    }

    fun byte_align(this, bt: BoundType) -> i64 {
        if (bt.kind is TypeKind.PrimitiveKind) {
            if (bt.primitive is PrimitiveType.I8) { return 1; }
            if (bt.primitive is PrimitiveType.U8) { return 1; }
            if (bt.primitive is PrimitiveType.BoolType) { return 1; }
            if (bt.primitive is PrimitiveType.I16) { return 2; }
            if (bt.primitive is PrimitiveType.U16) { return 2; }
            if (bt.primitive is PrimitiveType.I32) { return 4; }
            if (bt.primitive is PrimitiveType.U32) { return 4; }
            if (bt.primitive is PrimitiveType.F32) { return 4; }
            if (bt.primitive is PrimitiveType.CharType) { return 4; }
            return 8;
        }
        return 8;
    }

    fun byte_align_up(this, offset: i64, alignment: i64) -> i64 {
        if (alignment <= 1) { return offset; }
        let r: i64 = offset % alignment;
        if (r == 0) { return offset; }
        return offset + alignment - r;
    }
}

}
