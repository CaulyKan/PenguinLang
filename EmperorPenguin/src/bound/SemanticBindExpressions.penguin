// Pass 8 (phase 2 of 3) of the SemanticModel pipeline, extracted from
// SemanticModel.penguin: EXPRESSION binding. This pass dispatches every
// expression (literals/identifiers, operators, member access, function calls,
// control-flow expressions, casts, new, try-binds, code blocks) to its bound
// form, resolving symbols, field types, vtables, argument type checks and
// #specializing-injected container members. The meta call family
// (bind_meta_call & descendants) stays in SemanticModel core; M8c will split
// it out next.
namespace emperor {

class BindExpressionsPass {
    // 共享编译状态（M1 pass 类模式）：.none() 哑默认 + 构造函数 .some(model) 赋值，
    // 破除 SemanticModel <-> 本 pass 的类环。
    model: mut Option<SemanticModel> = new Option<SemanticModel>.none();

    fun new(mut this, model: mut SemanticModel) {
        this.model = new Option<SemanticModel>.some(model);
    }


    fun bind_expression(mut this, expr: Expression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_expression");
        // mut-this core methods (bind_meta_call / resolve_type_name) need a
        // mutable SemanticModel: rebind the Option payload once here.
        let m: mut SemanticModel = this.model.some;
        if (expr is Expression.constant) {
            return this.bind_constant(expr.constant, scope);
        }
        if (expr is Expression.string_literal) {
            return this.bind_string_literal(expr.string_literal, scope);
        }
        if (expr is Expression.bool_literal) {
            return this.bind_bool_literal(expr.bool_literal, scope);
        }
        if (expr is Expression.void_literal) {
            return this.bind_void_literal(scope);
        }
        if (expr is Expression.parenthesized) {
            if (expr.parenthesized.inner.is_some()) {
                if (scope.is_region) {
                    // Already inside a try-bind region: parens are transparent.
                    return this.bind_expression(expr.parenthesized.inner.some, scope);
                }
                // A parenthesized expression is a try-bind region boundary:
                // pattern variables bound inside die with the parens.
                let paren_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<paren>", scope.full_name + ".<paren>", new Option<BoundScope>.some(scope));
                paren_scope.is_region = true;
                return this.bind_expression(expr.parenthesized.inner.some, paren_scope);
            }
        }
        if (expr is Expression.identifier) {
            return this.bind_identifier(expr.identifier, scope);
        }
        if (expr is Expression.binary) {
            return this.bind_binary(expr.binary, scope);
        }
        if (expr is Expression.unary) {
            return this.bind_unary(expr.unary, scope);
        }
        if (expr is Expression.member_access) {
            let ma_result: Option<BoundExpression> = this.bind_member_access(expr.member_access, scope);
            if (ma_result.is_some() && ma_result.some is BoundExpression.member_access) {
                return new Option<BoundExpression>.some(this.adjust_method_ref_type(ma_result.some.member_access));
            }
            return ma_result;
        }
        if (expr is Expression.function_call) {
            return this.bind_function_call(expr.function_call, scope);
        }
        if (expr is Expression.if_expr) {
            return this.bind_if_expr(expr.if_expr, scope);
        }
        if (expr is Expression.while_expr) {
            return this.bind_while_expr(expr.while_expr, scope);
        }
        if (expr is Expression.code_block) {
            return this.bind_code_block(expr.code_block, scope);
        }
        if (expr is Expression.cast_expr) {
            return this.bind_cast(expr.cast_expr, scope);
        }
        if (expr is Expression.new_expr) {
            return this.bind_new_expr(expr.new_expr, scope);
        }
        if (expr is Expression.meta_call) {
            return m.bind_meta_calls_pass.bind_meta_call(expr.meta_call, scope);
        }
        if (expr is Expression.try_bind) {
            // P2: general try-bind expression — bind the RHS, register the
            // pattern variable into the current region scope, return a bool
            // expression that writes the payload when the check succeeds.
            return this.bind_try_bind(expr.try_bind, scope);
        }
        if (expr is Expression.wait_expr) {
            // wait is a scheduler suspension point — desugared per form into
            // extern calls / poll loops / do_wait member calls (see
            // bind_wait_expr), mirroring the BabyPenguin lowering.
            return this.bind_wait_expr(expr.wait_expr, scope);
        }
        if (expr is Expression.spawn_async) {
            return this.bind_spawn_async(expr.spawn_async, scope);
        }
        if (expr is Expression.lambda_expr) {
            return this.bind_lambda(expr.lambda_expr, scope);
        }
        return new Option<BoundExpression>.none();
    }

    // ---- wait / async lowering (coroutine scheduler) ----

    // Build `__builtin.<name>(args...)`.
    fun mk_builtin_call(this, name: string, args: mut _utils.List<Expression>) -> Expression {
        let base: IdentifierExpression = new IdentifierExpression("__builtin");
        let ma: MemberAccessExpression = new MemberAccessExpression();
        ma.base_expr = new Option<Expression>.some(new Expression.identifier(base));
        ma.member_name = name;
        let fc: FunctionCallExpression = new FunctionCallExpression();
        fc.callee = new Option<Expression>.some(new Expression.member_access(ma));
        let i: mut i64 = 0;
        while (i < cast<i64>(args.size())) {
            fc.arguments.push(args.at(cast<u64>(i)).some);
            i = i + 1;
        }
        return new Expression.function_call(fc);
    }

    // Build `__builtin._co_wait()`.
    fun mk_park_call(this) -> Expression {
        let no_args: mut _utils.List<Expression> = new _utils.List<Expression>();
        return this.mk_builtin_call("_co_wait", no_args);
    }

    // Build `<base>.do_wait()`.
    fun mk_do_wait_call(this, base: Expression) -> Expression {
        let ma: MemberAccessExpression = new MemberAccessExpression();
        ma.base_expr = new Option<Expression>.some(base);
        ma.member_name = "do_wait";
        let fc: FunctionCallExpression = new FunctionCallExpression();
        fc.callee = new Option<Expression>.some(new Expression.member_access(ma));
        return new Expression.function_call(fc);
    }

    fun mk_block_expr(this, stmts: mut _utils.List<Statement>, trailing: mut Option<Expression>) -> Expression {
        let cb: CodeBlockExpression = new CodeBlockExpression();
        cb.statements = stmts;
        cb.trailing_expr = trailing;
        return new Expression.code_block(cb);
    }

    // ---- E5 port sugar (bare reads, permission matrix, raw channel reads) ----

    // Bind an expression with port sugar suppressed: bare port reads stay
    // RAW channel-object accesses. Used for member-access receivers (a
    // method call on `this.y` needs the channel, not the payload slot) and
    // for the connect desugaring's generated field writes.
    fun bind_expr_no_port_sugar(mut this, e: Expression, scope: mut BoundScope) -> Option<BoundExpression> {
        this.model.some.port_sugar_suppressed = this.model.some.port_sugar_suppressed + 1;
        let r: Option<BoundExpression> = this.bind_expression(e, scope);
        this.model.some.port_sugar_suppressed = this.model.some.port_sugar_suppressed - 1;
        return r;
    }

    // The enclosing routine's scope full name (nearest Function or
    // InitialRoutine scope up the chain), or "".
    fun enclosing_routine_name(this, scope: mut BoundScope) -> string {
        let s: mut Option<BoundScope> = new Option<BoundScope>.some(scope);
        while (s.is_some()) {
            if (s.some.kind is ScopeKind.FunctionScope || s.some.kind is ScopeKind.InitialRoutineScope) {
                return s.some.full_name;
            }
            s = s.some.parent;
        }
        return "";
    }

    // True when the nearest enclosing routine is a hidden construct function
    // (top-level `__construct_<n>` or class `__class_construct_<n>`) —
    // construct bodies must not suspend, so port reads are rejected there.
    fun in_construct_routine(this, scope: mut BoundScope) -> bool {
        let r: string = this.enclosing_routine_name(scope);
        if (string_find(r, ".__construct_") >= 0) { return true; }
        if (string_find(r, ".__class_construct_") >= 0) { return true; }
        return false;
    }

    // The topology-audit pool seen from a file-namespace scope (a
    // construct-hoisted global's own scope).
    fun top_level_pool_id(this, scope: mut BoundScope) -> string {
        return "top:" + scope.full_name;
    }

    // The topology-audit pool for a construct context: all constructs of one
    // namespace/class share a pool (their lets/fields share that scope, so
    // connects and instantiations agree on instance names).
    fun construct_pool_id(this, scope: mut BoundScope) -> string {
        let s: mut Option<BoundScope> = new Option<BoundScope>.some(scope);
        while (s.is_some()) {
            if (s.some.kind is ScopeKind.ClassScope) { return "class:" + s.some.full_name; }
            if (s.some.kind is ScopeKind.NamespaceScope) { return "top:" + s.some.full_name; }
            s = s.some.parent;
        }
        return "top:<global>";
    }

    // If `e` is a member access onto a declared port field, its port info.
    fun resolve_port_access_for_base(mut this, e: Expression, scope: mut BoundScope) -> Option<PortAccessInfo> {
        if (!(e is Expression.member_access)) { return new Option<PortAccessInfo>.none(); }
        return this.resolve_port_access(e.member_access, scope);
    }

    // Resolve a member access that lands on a declared RTL port field
    // (`X.p`, p an input/output of X's class): binds the base (sugar
    // suppressed — this is a probe) and returns the port info. Purely
    // diagnostic; callers decide how to consume the access.
    fun resolve_port_access(mut this, expr: MemberAccessExpression, scope: mut BoundScope) -> Option<PortAccessInfo> {
        if (expr.base_expr.is_none()) { return new Option<PortAccessInfo>.none(); }
        let bound_base: Option<BoundExpression> = this.bind_expr_no_port_sugar(expr.base_expr.some, scope);
        if (bound_base.is_none()) { return new Option<PortAccessInfo>.none(); }
        let base_type: BoundType = bound_base.some.get_bound_type();
        if (base_type.type_definition.is_none()) { return new Option<PortAccessInfo>.none(); }
        let td: BoundDefinition = base_type.type_definition.some;
        if (!(td is BoundDefinition.class_def)) { return new Option<PortAccessInfo>.none(); }
        let cls: BoundClassDefinition = td.class_def;
        let idx: i64 = this.model.some.find_port_index(cls.full_name, expr.member_name);
        if (idx < 0) { return new Option<PortAccessInfo>.none(); }
        let info: mut PortAccessInfo = new PortAccessInfo();
        info.is_input = this.model.some.port_is_input.at(cast<u64>(idx)).some;
        info.has_default = this.model.some.port_has_default.at(cast<u64>(idx)).some;
        info.class_full_name = cls.full_name;
        if (expr.base_expr.some is Expression.identifier) {
            if (expr.base_expr.some.identifier.name == "this") { info.base_is_this = true; }
        }
        if (cls.scope.is_some()) {
            let fs: Option<BoundSymbol> = cls.scope.some.lookup_symbol(expr.member_name);
            if (fs.is_some()) {
                if (fs.some is BoundSymbol.variable) {
                    info.field_sym = fs.some.variable;
                    let ft: BoundType = fs.some.variable.bound_type;
                    if (cast<i64>(ft.generic_args.size()) == 1) {
                        info.payload = arg_as_bound_type(ft.generic_args.at(cast<u64>(0)).some);
                    }
                }
            }
        }
        return new Option<PortAccessInfo>.some(info);
    }

    // The RAW port payload read as an expression:
    // `{ let __port_opt = cast<mut ISource<T>>(<base>).current();
    //    if (!__port_opt.is_some()) { __builtin.__throw_runtime_error(...); }
    //    __port_opt.some }` — no settle point; a seedless channel that never
    // delivered raises the clear runtime error. Backs bare reads (after
    // their settle loop) and `wait change(port)` sampling.
    fun mk_checked_raw_port_read(mut this, base_ast: Expression, payload: BoundType, scope: mut BoundScope) -> Expression {
        this.ensure_generic_iface_spec("ISource", payload, scope);
        let loc: SourceLocation = new SourceLocation("", 0, 0);
        let src_ts: mut TypeSpecifier = new TypeSpecifier();
        src_ts.qualified_parts.push("__builtin");
        src_ts.name = "ISource";
        src_ts.generic_args.push(this.spawn_type_spec(payload));
        src_ts.is_mutable = true;
        let cast_node: mut CastExpression = new CastExpression();
        cast_node.target_type = new Option<TypeSpecifier>.some(src_ts);
        cast_node.type_name = "ISource";
        cast_node.inner = new Option<Expression>.some(base_ast);
        let cur_ma: mut MemberAccessExpression = new MemberAccessExpression();
        cur_ma.base_expr = new Option<Expression>.some(new Expression.cast_expr(cast_node));
        cur_ma.member_name = "current";
        let cur_call: mut FunctionCallExpression = new FunctionCallExpression();
        cur_call.callee = new Option<Expression>.some(new Expression.member_access(cur_ma));
        let ld: mut LetDeclarationStatement = new LetDeclarationStatement();
        ld.variable_name = "__port_opt";
        ld.initializer = new Option<Expression>.some(new Expression.function_call(cur_call));
        ld.location = loc;
        let opt_id: IdentifierExpression = new IdentifierExpression("__port_opt");
        let is_some_ma: mut MemberAccessExpression = new MemberAccessExpression();
        is_some_ma.base_expr = new Option<Expression>.some(new Expression.identifier(opt_id));
        is_some_ma.member_name = "is_some";
        let is_some_call: mut FunctionCallExpression = new FunctionCallExpression();
        is_some_call.callee = new Option<Expression>.some(new Expression.member_access(is_some_ma));
        let not_e: mut UnaryExpression = new UnaryExpression();
        not_e.operator_value = new UnaryOperator.Not();
        not_e.operand = new Option<Expression>.some(new Expression.function_call(is_some_call));
        let throw_args: mut _utils.List<Expression> = new _utils.List<Expression>();
        throw_args.push(new Expression.string_literal(new StringLiteralExpression("\"port read before any value was delivered\"")));
        throw_args.push(new Expression.constant(new ConstantExpression("100")));
        let throw_call: Expression = this.mk_builtin_call("__throw_runtime_error", throw_args);
        let throw_es: mut ExpressionStatement = new ExpressionStatement();
        throw_es.expression = new Option<Expression>.some(throw_call);
        throw_es.location = loc;
        let then_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        then_stmts.push(new Statement.expression(throw_es));
        let if_stmt: mut IfStatement = new IfStatement();
        if_stmt.condition = new Option<Expression>.some(new Expression.unary(not_e));
        let then_block: mut BlockExpressionStatement = new BlockExpressionStatement();
        then_block.expression = new Option<Expression>.some(this.mk_block_expr(then_stmts, new Option<Expression>.none()));
        then_block.location = loc;
        if_stmt.then_statement = new Option<Statement>.some(new Statement.block_expr(then_block));
        if_stmt.location = loc;
        let some_id: IdentifierExpression = new IdentifierExpression("__port_opt");
        let some_ma: mut MemberAccessExpression = new MemberAccessExpression();
        some_ma.base_expr = new Option<Expression>.some(new Expression.identifier(some_id));
        some_ma.member_name = "some";
        let stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        stmts.push(new Statement.let_decl(ld));
        stmts.push(new Statement.if_stmt(if_stmt));
        return this.mk_block_expr(stmts, new Option<Expression>.some(new Expression.member_access(some_ma)));
    }

    // The bare port read (Q1 settle point): park one delta at a time until
    // the current simulation time has settled, then read the channel's
    // CURRENT slot as the payload value. The spin counter perturbs the
    // parked frame's fingerprint every round so the quiescence detector
    // cannot end the program before this reader observes a settled round.
    fun mk_bare_port_read_expr(mut this, base_ast: Expression, payload: BoundType, scope: mut BoundScope) -> Expression {
        let loc: SourceLocation = new SourceLocation("", 0, 0);
        let spin_ld: mut LetDeclarationStatement = new LetDeclarationStatement();
        spin_ld.variable_name = "__port_spin";
        spin_ld.variable_type = "i64";
        spin_ld.type_spec = new Option<TypeSpecifier>.some(this.mk_plain_spec("i64", true));
        spin_ld.initializer = new Option<Expression>.some(new Expression.constant(new ConstantExpression("0")));
        spin_ld.location = loc;
        // while (!__builtin._sim_settled()) { __port_spin = __port_spin + 1; park; }
        let settled_call: Expression = this.mk_builtin_call("_sim_settled", new _utils.List<Expression>());
        let not_settled: mut UnaryExpression = new UnaryExpression();
        not_settled.operator_value = new UnaryOperator.Not();
        not_settled.operand = new Option<Expression>.some(settled_call);
        let spin_id: IdentifierExpression = new IdentifierExpression("__port_spin");
        let spin_bump: mut AssignmentStatement = new AssignmentStatement();
        spin_bump.target = new Option<Expression>.some(new Expression.identifier(spin_id));
        spin_bump.operator_value = new AssignmentOperator.PlusAssign();
        spin_bump.value = new Option<Expression>.some(new Expression.constant(new ConstantExpression("1")));
        spin_bump.location = loc;
        let park_es: mut ExpressionStatement = new ExpressionStatement();
        park_es.expression = new Option<Expression>.some(this.mk_park_call());
        park_es.location = loc;
        let body_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        body_stmts.push(new Statement.assignment(spin_bump));
        body_stmts.push(new Statement.expression(park_es));
        let we: mut WhileExpression = new WhileExpression();
        we.condition = new Option<Expression>.some(new Expression.unary(not_settled));
        we.body = new Option<Expression>.some(this.mk_block_expr(body_stmts, new Option<Expression>.none()));
        let ws: mut BlockExpressionStatement = new BlockExpressionStatement();
        ws.expression = new Option<Expression>.some(new Expression.while_expr(we));
        ws.location = loc;
        let stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        stmts.push(new Statement.let_decl(spin_ld));
        stmts.push(new Statement.block_expr(ws));
        return this.mk_block_expr(stmts, new Option<Expression>.some(this.mk_checked_raw_port_read(base_ast, payload, scope)));
    }

    // A plain (non-generic) type specifier, e.g. `mut i64` for generated lets.
    fun mk_plain_spec(this, name: string, is_mutable: bool) -> TypeSpecifier {
        let ts: mut TypeSpecifier = new TypeSpecifier();
        ts.name = name;
        ts.is_mutable = is_mutable;
        return ts;
    }

    // Register a module-body driver of an output port (topology check).
    fun register_body_driver(mut this, info: PortAccessInfo, scope: mut BoundScope) {
        let key: string = info.class_full_name + "." + info.field_sym.name;
        let fn_name: string = this.enclosing_routine_name(scope);
        let i: mut i64 = 0;
        while (i < cast<i64>(this.model.some.driver_keys.size())) {
            if (this.model.some.driver_keys.at(cast<u64>(i)).some == key) {
                if (string_length(this.model.some.driver_body_fns.at(cast<u64>(i)).some) > 0) {
                    if (this.model.some.driver_body_fns.at(cast<u64>(i)).some == fn_name) { return; }
                }
            }
            i = i + 1;
        }
        this.model.some.driver_keys.push(key);
        this.model.some.driver_wire_locs.push("");
        this.model.some.driver_body_fns.push(fn_name);
        this.model.some.driver_body_locs.push(fn_name);
    }

    // `wait change(x)` detection: the operand is a one-argument call to the
    // simple identifier `change` (not a real function — edge-detection sugar;
    // mirrors the BabyPenguin WaitExpression.IsChangeUnit heuristic).
    fun wait_is_change_unit(this, expr: WaitExpression) -> bool {
        if (expr.expression.is_none()) { return false; }
        let inner: Expression = expr.expression.some;
        if (!(inner is Expression.function_call)) { return false; }
        let fc: FunctionCallExpression = inner.function_call;
        if (fc.callee.is_none()) { return false; }
        if (!(fc.callee.some is Expression.identifier)) { return false; }
        let id: IdentifierExpression = fc.callee.some.identifier;
        if (id.name != "change") { return false; }
        if (cast<i64>(id.generic_args.size()) != 0) { return false; }
        if (cast<i64>(fc.arguments.size()) != 1) { return false; }
        return true;
    }

    // The sampled/compared operand of `wait change(x)`: a port reads its RAW
    // slot (no settle), anything else is the expression as-is.
    fun wait_change_operand(mut this, watched: Expression, pai: Option<PortAccessInfo>, scope: mut BoundScope) -> Expression {
        if (pai.is_some()) {
            return this.mk_checked_raw_port_read(watched, pai.some.payload, scope);
        }
        return watched;
    }

    // A wait operand's type probe: member accesses bind with port sugar
    // suppressed (a port must stay its IChannel type for the branch below).
    fun wait_probe_inner(mut this, inner: Expression, scope: mut BoundScope) -> Option<BoundExpression> {
        if (inner is Expression.member_access) {
            return this.bind_expr_no_port_sugar(inner, scope);
        }
        return this.bind_expression(inner, scope);
    }

    fun bind_wait_expr(mut this, expr: WaitExpression, scope: mut BoundScope) -> Option<BoundExpression> {        let m: mut SemanticModel = this.model.some;
        let loc: SourceLocation = new SourceLocation("", 0, 0);

        // --enable-coroutine gate; every wait form marks the unit as
        // suspending (drives emit_main's scheduler-vs-sequential choice).
        if (!m.require_coroutine("wait", loc)) {
            return new Option<BoundExpression>.none();
        }
        m.has_suspension = true;

        // bare `wait` — park the current coroutine for one delta round.
        if (expr.expression.is_none()) {
            let stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
            let es: mut ExpressionStatement = new ExpressionStatement();
            es.expression = new Option<Expression>.some(this.mk_park_call());
            es.location = loc;
            stmts.push(new Statement.expression(es));
            return this.bind_expression(this.mk_block_expr(stmts, new Option<Expression>.none()), scope);
        }

        let inner: Expression = expr.expression.some;

        // `wait <n> tick` — __builtin._after(<n>).do_wait() (an i64: the deadline).
        if (expr.is_tick_unit) {
            return this.bind_timer_wait(inner, scope);
        }

        // `wait change(x)` — sample x, park while unchanged, yield the new value.
        if (this.wait_is_change_unit(expr)) {
            let fc: FunctionCallExpression = inner.function_call;
            let watched: Expression = fc.arguments.at(cast<u64>(0)).some;
            // A port operand samples the RAW slot (no settle): the idiom this
            // sugars (`let v = x; while (x == v) { wait x; }`) watches the
            // instantaneous level, and settle-point granularity would miss
            // single-round pulses.
            let pai: Option<PortAccessInfo> = this.resolve_port_access_for_base(watched, scope);
            let watched_expr: Expression = this.wait_change_operand(watched, pai, scope);
            // let __wait_sample = <x>;
            let ld: mut LetDeclarationStatement = new LetDeclarationStatement();
            ld.is_mutable = false;
            ld.variable_name = "__wait_sample";
            ld.initializer = new Option<Expression>.some(watched_expr);
            ld.location = loc;
            let stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
            stmts.push(new Statement.let_decl(ld));
            // while (<x> == __wait_sample) { __builtin._co_wait(); }
            let sample_id: IdentifierExpression = new IdentifierExpression("__wait_sample");
            let operands: mut _utils.List<Expression> = new _utils.List<Expression>();
            operands.push(watched_expr);
            operands.push(new Expression.identifier(sample_id));
            let operators: mut _utils.List<BinaryOperator> = new _utils.List<BinaryOperator>();
            operators.push(new BinaryOperator.Equal());
            let cmp: mut BinaryExpression = new BinaryExpression();
            cmp.operands = operands;
            cmp.operators = operators;
            let park_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
            let park_es: mut ExpressionStatement = new ExpressionStatement();
            park_es.expression = new Option<Expression>.some(this.mk_park_call());
            park_es.location = loc;
            park_stmts.push(new Statement.expression(park_es));
            let we: mut WhileExpression = new WhileExpression();
            we.condition = new Option<Expression>.some(new Expression.binary(cmp));
            we.body = new Option<Expression>.some(this.mk_block_expr(park_stmts, new Option<Expression>.none()));
            let ws: mut BlockExpressionStatement = new BlockExpressionStatement();
            ws.expression = new Option<Expression>.some(new Expression.while_expr(we));
            ws.location = loc;
            stmts.push(new Statement.block_expr(ws));
            // trailing <x> — the new value
            return this.bind_expression(this.mk_block_expr(stmts, new Option<Expression>.some(watched_expr)), scope);
        }

        // Probe the operand's type to pick the condition-loop vs future form.
        // A member-access operand probes with port sugar suppressed so a port
        // stays its IChannel type here (the port branch below re-binds the
        // operand itself through the cast path, which reads the channel RAW).
        let bound_inner: Option<BoundExpression> = this.wait_probe_inner(inner, scope);
        if (bound_inner.is_none()) { return new Option<BoundExpression>.none(); }
        let inner_type: BoundType = bound_inner.some.get_bound_type();

        // `wait <bool>` — level-sensitive: re-evaluate every round.
        if (inner_type.kind is TypeKind.PrimitiveKind && inner_type.primitive is PrimitiveType.BoolType) {
            let notcond: mut UnaryExpression = new UnaryExpression();
            notcond.operator_value = new UnaryOperator.Not();
            notcond.operand = new Option<Expression>.some(inner);
            let park_stmts2: mut _utils.List<Statement> = new _utils.List<Statement>();
            let park_es2: mut ExpressionStatement = new ExpressionStatement();
            park_es2.expression = new Option<Expression>.some(this.mk_park_call());
            park_es2.location = loc;
            park_stmts2.push(new Statement.expression(park_es2));
            let we2: mut WhileExpression = new WhileExpression();
            we2.condition = new Option<Expression>.some(new Expression.unary(notcond));
            we2.body = new Option<Expression>.some(this.mk_block_expr(park_stmts2, new Option<Expression>.none()));
            let stmts2: mut _utils.List<Statement> = new _utils.List<Statement>();
            let ws2: mut BlockExpressionStatement = new BlockExpressionStatement();
            ws2.expression = new Option<Expression>.some(new Expression.while_expr(we2));
            ws2.location = loc;
            stmts2.push(new Statement.block_expr(ws2));
            return this.bind_expression(this.mk_block_expr(stmts2, new Option<Expression>.none()), scope);
        }

        // `wait <integer>` — the short timer form: `wait n;` == `wait n tick;`.
        // Any integer width (literal, variable, expression); the deadline unit
        // is i64 (bind_timer_wait inserts the cast).
        if (this.model.some.type_registry.is_integer(inner_type)) {
            return this.bind_timer_wait(inner, scope);
        }

        // `wait ev` on an Event<T>: one fresh one-slot subscription per wait
        // (the ctor subscribes; poll delivers once and auto-unsubscribes) —
        // exactly BabyPenguin's wait-rewrite shape. The do_wait goes through
        // an explicit cast<mut IFuture<T>> so it dispatches through the
        // SPECIALIZED interface's default method (a direct member call would
        // bind the unspecialized template's do_wait).
        let ev_t: Option<BoundType> = this.find_event_class_type(inner_type);
        if (ev_t.is_some()) {
            let sub_new: mut NewExpression = new NewExpression();
            sub_new.type_name = "__builtin._EventSubscription";
            sub_new.generic_args.push(this.spawn_type_spec(ev_t.some));
            sub_new.arguments.push(inner);
            let ifut_ts: mut TypeSpecifier = new TypeSpecifier();
            ifut_ts.qualified_parts.push("__builtin");
            ifut_ts.name = "IFuture";
            ifut_ts.generic_args.push(this.spawn_type_spec(ev_t.some));
            ifut_ts.is_mutable = true;
            let cast_node: mut CastExpression = new CastExpression();
            cast_node.target_type = new Option<TypeSpecifier>.some(ifut_ts);
            cast_node.type_name = "IFuture";
            cast_node.inner = new Option<Expression>.some(new Expression.new_expr(sub_new));
            return this.bind_expression(this.mk_do_wait_call(new Expression.cast_expr(cast_node)), scope);
        }

        // `wait <port>` on a port field (IChannel<T> — own input or someone's
        // output): the backing channel is directly waitable; cast to
        // IFuture<T> so do_wait dispatches virtually (hub slot stream for an
        // output, the connected wire/source for an input). Read matrix: only
        // the owning module may wait its input; any module may wait another's
        // output.
        if (inner_type.kind is TypeKind.InterfaceKind && cast<i64>(inner_type.generic_args.size()) == 1) {
            if (inner_type.type_definition.is_some() && inner_type.type_definition.some is BoundDefinition.interface_def) {
                if (inner_type.type_definition.some.interface_def.name == "IChannel") {
                    let wpai: Option<PortAccessInfo> = this.resolve_port_access_for_base(inner, scope);
                    if (wpai.is_some()) {
                        if (wpai.some.is_input && !wpai.some.base_is_this) {
                            this.model.some.report_error(new ErrorCode.E_MUTABILITY(),
                                "Cannot wait on input port '" + wpai.some.field_sym.name + "' of another module - inputs are only visible inside their module",
                                new SourceLocation("", 0, 0));
                            return new Option<BoundExpression>.none();
                        }
                    }
                    let port_payload: BoundType = arg_as_bound_type(inner_type.generic_args.at(cast<u64>(0)).some);
                    this.ensure_generic_iface_spec("IFuture", port_payload, scope);
                    let fut_ts: mut TypeSpecifier = new TypeSpecifier();
                    fut_ts.qualified_parts.push("__builtin");
                    fut_ts.name = "IFuture";
                    fut_ts.generic_args.push(this.spawn_type_spec(port_payload));
                    fut_ts.is_mutable = true;
                    let port_cast: mut CastExpression = new CastExpression();
                    port_cast.target_type = new Option<TypeSpecifier>.some(fut_ts);
                    port_cast.type_name = "IFuture";
                    port_cast.inner = new Option<Expression>.some(inner);
                    return this.bind_expression(this.mk_do_wait_call(new Expression.cast_expr(port_cast)), scope);
                }
            }
        }

        // `wait <call>` on a non-future-typed call: a sequential (interleaved)
        // call — the callee's own waits park the shared stack; the call's
        // result is the wait's value (BabyPenguin implicit-wait semantics).
        if (this.find_ifuture_iface_type(inner_type).is_none()) {
            if (inner is Expression.function_call) {
                return bound_inner;
            }
            // A void-typed non-call operand (e.g. `wait void_expr`) has no
            // delivery semantics either — treat like the call form.
            if (inner_type.kind is TypeKind.PrimitiveKind && inner_type.primitive is PrimitiveType.VoidType) {
                return bound_inner;
            }
            // Anything else has no wait semantics — report cleanly instead of
            // emitting a doomed do_wait member call (which surfaces as an
            // E_INTERNAL "no callee symbol" at IR time).
            this.model.some.report_error(new ErrorCode.E_TYPE_MISMATCH(),
                "wait operand must be an integer (timer ticks), bool, IFuture, Event or port, got '" + inner_type.display_name() + "'",
                new SourceLocation("", 0, 0));
            return new Option<BoundExpression>.none();
        }

        // `wait <future/channel>` — cast<mut IFuture<T>>(<expr>).do_wait(); the
        // explicit interface cast makes the call dispatch through the vtable
        // (the specialized default method), exactly like BabyPenguin.
        return this.bind_wait_on_expr2(inner, inner_type, scope);
    }

    // `wait <n> [tick]` — timer wait: __builtin._after(cast<i64>(<n>)).do_wait().
    // The operand may be any integer width (literal, variable, expression);
    // _after takes the deadline as i64, so narrower ints get an explicit cast.
    fun bind_timer_wait(mut this, inner: Expression, scope: mut BoundScope) -> Option<BoundExpression> {
        let probe: Option<BoundExpression> = this.bind_expression(inner, scope);
        if (probe.is_none()) { return new Option<BoundExpression>.none(); }
        let arg_t: BoundType = probe.some.get_bound_type();
        if (!this.model.some.type_registry.is_integer(arg_t)) {
            this.model.some.report_error(new ErrorCode.E_TYPE_MISMATCH(),
                "timer wait operand must be an integer, got '" + arg_t.display_name() + "'",
                new SourceLocation("", 0, 0));
            return new Option<BoundExpression>.none();
        }
        let after_args: mut _utils.List<Expression> = new _utils.List<Expression>();
        if (arg_t.primitive is PrimitiveType.I64) {
            after_args.push(inner);
        } else {
            let i64_ts: TypeSpecifier = this.spawn_type_spec(this.model.some.type_registry.i64_type);
            let cn: mut CastExpression = new CastExpression();
            cn.target_type = new Option<TypeSpecifier>.some(i64_ts);
            cn.type_name = "i64";
            cn.inner = new Option<Expression>.some(inner);
            after_args.push(new Expression.cast_expr(cn));
        }
        let after_call: Expression = this.mk_builtin_call("_after", after_args);
        let probe_after: Option<BoundExpression> = this.bind_expression(after_call, scope);
        if (probe_after.is_none()) { return new Option<BoundExpression>.none(); }
        return this.bind_wait_on_expr2(after_call, probe_after.some.get_bound_type(), scope);
    }

    // Shared future-wait lowering: cast the receiver to its (mutable)
    // IFuture<T> interface type so do_wait dispatches virtually.
    fun bind_wait_on_expr2(mut this, inner: Expression, inner_type: BoundType, scope: mut BoundScope) -> Option<BoundExpression> {
        let iface_bt: Option<BoundType> = this.find_ifuture_iface_type(inner_type);
        if (iface_bt.is_some()) {
            let cast_ts: TypeSpecifier = this.spawn_type_spec(iface_bt.some);
            cast_ts.is_mutable = true;
            let cast_node: mut CastExpression = new CastExpression();
            cast_node.target_type = new Option<TypeSpecifier>.some(cast_ts);
            cast_node.type_name = iface_bt.some.display_name();
            cast_node.inner = new Option<Expression>.some(inner);
            let cast_call: Expression = this.mk_do_wait_call(new Expression.cast_expr(cast_node));
            return this.bind_expression(cast_call, scope);
        }
        // No IFuture implementation found (e.g. a plain interface-typed value
        // or a class without IFuture) — fall back to the direct member call
        // and let the resolver report if do_wait does not exist.
        return this.bind_expression(this.mk_do_wait_call(inner), scope);
    }

    // The IFuture<T> interface type a bound type implements (with its generic
    // args), or the type itself when it already IS an IFuture value. Drives
    // the cast<IFuture<T>>(x).do_wait() wait lowering.
    fun find_ifuture_iface_type(this, bt: BoundType) -> Option<BoundType> {
        if (bt.kind is TypeKind.InterfaceKind) {
            if (bt.type_definition.is_some() && bt.type_definition.some is BoundDefinition.interface_def) {
                if (bt.type_definition.some.interface_def.name == "IFuture") {
                    return new Option<BoundType>.some(bt);
                }
            }
            return new Option<BoundType>.none();
        }
        if (bt.type_definition.is_none()) { return new Option<BoundType>.none(); }
        let td: BoundDefinition = bt.type_definition.some;
        if (td is BoundDefinition.class_def) {
            let i: mut i64 = 0;
            while (i < cast<i64>(td.class_def.interface_impls.size())) {
                let impl_d: BoundDefinition = td.class_def.interface_impls.at(cast<u64>(i)).some;
                if (impl_d is BoundDefinition.impl_def) {
                    let iface_t: BoundType = impl_d.impl_def.interface_type;
                    if (iface_t.type_definition.is_some() && iface_t.type_definition.some is BoundDefinition.interface_def) {
                        if (iface_t.type_definition.some.interface_def.name == "IFuture") {
                            return new Option<BoundType>.some(this.substitute_template_arg_placeholders(iface_t, bt));
                        }
                    }
                }
                i = i + 1;
            }
        }
        if (td is BoundDefinition.enum_def) {
            let j: mut i64 = 0;
            while (j < cast<i64>(td.enum_def.interface_impls.size())) {
                let impl_e: BoundDefinition = td.enum_def.interface_impls.at(cast<u64>(j)).some;
                if (impl_e is BoundDefinition.impl_def) {
                    let iface_t2: BoundType = impl_e.impl_def.interface_type;
                    if (iface_t2.type_definition.is_some() && iface_t2.type_definition.some is BoundDefinition.interface_def) {
                        if (iface_t2.type_definition.some.interface_def.name == "IFuture") {
                            return new Option<BoundType>.some(this.substitute_template_arg_placeholders(iface_t2, bt));
                        }
                    }
                }
                j = j + 1;
            }
        }
        return new Option<BoundType>.none();
    }

    // An impl's interface_type resolved against a TEMPLATE class carries the
    // template's placeholder param types (dummy defs named after the params,
    // e.g. `wait fifo` on a `Fifo<i64>`-typed value seeing IFuture<Fifo's T>).
    // Replace each placeholder arg positionally with the receiver's concrete
    // generic arg so the wait lowering casts to IFuture<i64>, not to an
    // unresolvable placeholder name.
    fun substitute_template_arg_placeholders(this, iface_bt: BoundType, recv_bt: BoundType) -> BoundType {
        if (recv_bt.type_definition.is_none()) { return iface_bt; }
        let rtd: BoundDefinition = recv_bt.type_definition.some;
        let params: _utils.List<string> = if (rtd is BoundDefinition.class_def) {
            rtd.class_def.generic_params
        } else if (rtd is BoundDefinition.enum_def) {
            rtd.enum_def.generic_params
        } else {
            new _utils.List<string>()
        };
        if (cast<i64>(params.size()) == 0 || cast<i64>(recv_bt.generic_args.size()) == 0) { return iface_bt; }
        let new_args: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
        let changed: mut bool = false;
        let i: mut i64 = 0;
        while (i < cast<i64>(iface_bt.generic_args.size())) {
            let arg: BoundTypeArg = iface_bt.generic_args.at(cast<u64>(i)).some;
            let substituted: mut bool = false;
            if (!arg_is_value(arg)) {
                let argt: BoundType = arg_as_bound_type(arg);
                if (argt.type_definition.is_some() && argt.type_definition.some is BoundDefinition.class_def) {
                    let pname: string = argt.type_definition.some.class_def.name;
                    let j: mut i64 = 0;
                    while (j < cast<i64>(params.size())) {
                        if (params.at(cast<u64>(j)).some == pname && j < cast<i64>(recv_bt.generic_args.size())) {
                            let rarg: BoundTypeArg = recv_bt.generic_args.at(cast<u64>(j)).some;
                            if (!arg_is_value(rarg)) {
                                new_args.push(make_type_arg(arg_as_bound_type(rarg)));
                                substituted = true;
                                changed = true;
                            }
                        }
                        j = j + 1;
                    }
                }
            }
            if (!substituted) {
                new_args.push(arg);
            }
            i = i + 1;
        }
        if (!changed) { return iface_bt; }
        return iface_bt.with_generic_args(new_args);
    }

    // The payload type argument of an Event<X> bound type, or none. Drives
    // the `wait ev` -> `new _EventSubscription<X>(ev).do_wait()` rewrite.
    fun find_event_class_type(this, bt: BoundType) -> Option<BoundType> {
        if (bt.kind is TypeKind.ClassKind) {
            if (bt.type_definition.is_some() && bt.type_definition.some is BoundDefinition.class_def) {
                if (bt.type_definition.some.class_def.name == "Event") {
                    if (cast<i64>(bt.generic_args.size()) > 0) {
                        if (!arg_is_value(bt.generic_args.at(cast<u64>(0)).some)) {
                            return new Option<BoundType>.some(arg_as_bound_type(bt.generic_args.at(cast<u64>(0)).some));
                        }
                    }
                }
            }
        }
        return new Option<BoundType>.none();
    }

    // ---- `async f(args)` spawn lowering ----
    //
    // Rewrites the spawn into a site block
    //   { let __s = new __SpawnCtx_<n>(); __s.<f...> = <f/args...>;
    //     __s.fut = new __SpawnFuture<R>(); __builtin._co_spawn_entry(__s); __s.fut }
    // and synthesizes the ctx class (bound into the spawn site's enclosing
    // namespace, then caught up through the remaining passes):
    //   class __SpawnCtx_<n> { ...fields...;
    //     impl __builtin.__ICoroutineEntry {
    //       fun __enter(mut this) { this.fut.complete(f(this.a0, ...)); } } }
    // The C runtime spawns a coroutine that dispatches __enter through the
    // vtable; the site expression evaluates to the future.

    // The nearest enclosing namespace (or global) scope of a binding site —
    // where a synthesized definition becomes visible to the site itself.
    fun enclosing_def_scope(this, scope: mut BoundScope) -> mut BoundScope {
        let cur: mut Option<BoundScope> = new Option<BoundScope>.some(scope);
        let guard: mut i64 = 0;
        while (guard < 128) {
            let s: BoundScope = cur.some;
            if (s.kind is ScopeKind.NamespaceScope || s.kind is ScopeKind.GlobalScope) { return s; }
            if (s.parent.is_some()) {
                cur = new Option<BoundScope>.some(s.parent.some);
                guard = guard + 1;
            } else {
                return s;
            }
        }
        return cur.some;
    }

    // TypeSpecifier text for a bound type (ctx class field types). Handles
    // primitives and class/enum/interface definitions with type generic args;
    // mutability is preserved (`mut T` fields for mutable values).
    fun spawn_type_spec(mut this, bt: BoundType) -> TypeSpecifier {
        let m: mut SemanticModel = this.model.some;
        let ts: mut TypeSpecifier = new TypeSpecifier();
        if (bt.kind is TypeKind.PrimitiveKind) {
            ts.name = primitive_type_to_string(bt.primitive);
        } else if (bt.kind is TypeKind.FunctionKind) {
            // fun/async_fun type: generic_args[0] = return, rest = params (the
            // resolve side reads function_params in exactly this order).
            ts.is_function_type = true;
            ts.is_async_function_type = bt.is_async_function;
            let fgi: mut i64 = 0;
            while (fgi < cast<i64>(bt.generic_args.size())) {
                let farg: BoundTypeArg = bt.generic_args.at(cast<u64>(fgi)).some;
                if (farg is BoundTypeArg.type_arg) {
                    ts.function_params.push(this.spawn_type_spec(farg.type_arg.bound_type));
                }
                fgi = fgi + 1;
            }
        } else {
            let full: mut string = "";
            if (bt.type_definition.is_some()) {
                let td: BoundDefinition = bt.type_definition.some;
                if (td is BoundDefinition.class_def) { full = td.class_def.full_name; }
                if (td is BoundDefinition.enum_def) { full = td.enum_def.full_name; }
                if (td is BoundDefinition.interface_def) { full = td.interface_def.full_name; }
            }
            if (string_length(full) == 0) {
                m.report_error(new ErrorCode.E_ASYNC_INVALID(),
                    "cannot spawn a call whose argument/return type is unresolved here",
                    new SourceLocation("", 0, 0));
            }
            // The global scope's full_name marker ("<global>.") is a scope
            // label, not a resolvable namespace — strip it so the produced
            // specifier resolves from the global scope (a payload enum under
            // a top-level namespace, e.g. <global>.lsp.LspFrameAction,
            // otherwise re-fails resolution with "mut <global>.lsp....").
            if (string_length(full) >= 9) {
                if (string_substring(full, 0, 9) == "<global>.") {
                    full = string_substring(full, 9, string_length(full) - 9);
                }
            }
            // split full name into qualified parts + the simple name
            let rest: mut string = full;
            let parts: mut _utils.List<string> = new _utils.List<string>();
            let dot: mut i64 = string_find(full, ".");
            while (dot >= 0) {
                parts.push(string_substring(rest, 0, dot));
                rest = string_substring(rest, dot + 1, string_length(rest) - dot - 1);
                dot = string_find(rest, ".");
            }
            let qi: mut i64 = 0;
            while (qi < cast<i64>(parts.size())) {
                ts.qualified_parts.push(parts.at(cast<u64>(qi)).some);
                qi = qi + 1;
            }
            ts.name = rest;
            // generic type args (specialized instantiations re-specialize
            // identically from the template + args)
            let gi: mut i64 = 0;
            while (gi < cast<i64>(bt.generic_args.size())) {
                let arg: BoundTypeArg = bt.generic_args.at(cast<u64>(gi)).some;
                if (arg is BoundTypeArg.type_arg) {
                    ts.generic_args.push(this.spawn_type_spec(arg.type_arg.bound_type));
                }
                gi = gi + 1;
            }
        }
        // Ctx fields are always mutable: the site block assigns them after
        // construction (field mutability, not value semantics, is what the
        // assignment check reads).
        ts.is_mutable = true;
        return ts;
    }

    fun mk_ident_expr(this, name: string) -> Expression {
        return new Expression.identifier(new IdentifierExpression(name));
    }

    fun mk_this_member(this, member: string) -> Expression {
        let ma: MemberAccessExpression = new MemberAccessExpression();
        ma.base_expr = new Option<Expression>.some(this.mk_ident_expr("this"));
        ma.member_name = member;
        return new Expression.member_access(ma);
    }

    fun mk_assign_stmt(this, target: Expression, value: Expression) -> Statement {
        let a: mut AssignmentStatement = new AssignmentStatement();
        a.target = new Option<Expression>.some(target);
        a.operator_value = new AssignmentOperator.Assign();
        a.value = new Option<Expression>.some(value);
        a.location = new SourceLocation("", 0, 0);
        return new Statement.assignment(a);
    }

    // ---- lambda desugar (fun-value closures) ----
    // A lambda becomes a synthesized closure class `__lambda_<n>`:
    //   class __lambda_<n> {
    //     <cap>: <T>; ...                                  // by-value snapshot
    //     fun new(mut this, <cap>: <T>, ...) { this.<cap> = <cap>; ... }
    //     fun __call(mut this, <params>) -> <ret> { <body, captures -> this.<cap>> }
    //   }
    // The class is marked is_funval: its metadata carries a .__FunVal entry
    // (slot 0 = __call), so the closure OBJECT is the fun value — one
    // allocation, single indirection (no invoker wrapper).
    // Captured identifiers are rewritten to `this.<name>` member accesses in
    // place; a miss in this traversal is loud (E_UNDEFINED inside __call), so
    // unhandled expression kinds fail compilation instead of misbehaving.

    fun lam_shadow_has(this, a: mut LamAnalysis, name: string) -> bool {
        let i: mut i64 = 0;
        while (i < cast<i64>(a.shadow.size())) {
            if (a.shadow.at(cast<u64>(i)).some == name) { return true; }
            i = i + 1;
        }
        return false;
    }

    fun lam_shadow_mark(this, a: mut LamAnalysis) -> i64 {
        return cast<i64>(a.shadow.size());
    }

    fun lam_shadow_restore(mut this, a: mut LamAnalysis, mark: i64) {
        while (cast<i64>(a.shadow.size()) > mark) {
            if (a.shadow.pop().is_none()) { return; }
        }
    }

    fun lam_capture_index(this, a: mut LamAnalysis, name: string) -> i64 {
        let i: mut i64 = 0;
        while (i < cast<i64>(a.names.size())) {
            if (a.names.at(cast<u64>(i)).some == name) { return i; }
            i = i + 1;
        }
        return -1;
    }

    // Walk the scope chain from the lambda's lexical position upward and
    // classify where the first VARIABLE symbol with this name lives:
    //   Function/Block/InitialRoutine scope -> a local/param: capturable
    //   Class/Enum/Interface/Impl scope      -> a type member: unsupported (v1)
    //   Namespace/Global scope               -> global: resolves inside __call
    fun lam_classify(this, name: string, scope: mut BoundScope, a: mut LamAnalysis) -> LamCaptureKind {
        a.last_found_type = new Option<BoundType>.none();
        let cur: mut Option<BoundScope> = new Option<BoundScope>.some(scope);
        let guard: mut i64 = 0;
        while (guard < 128) {
            if (cur.is_none()) { return new LamCaptureKind.NotVariable(); }
            let s: BoundScope = cur.some;
            let i: mut i64 = 0;
            while (i < cast<i64>(s.symbols.size())) {
                let sym: BoundSymbol = s.symbols.at(cast<u64>(i)).some;
                if (sym is BoundSymbol.variable && sym.variable.name == name) {
                    if (name == "this") { return new LamCaptureKind.ThisParam(); }
                    if (s.kind is ScopeKind.FunctionScope || s.kind is ScopeKind.BlockScope || s.kind is ScopeKind.InitialRoutineScope) {
                        a.last_found_type = new Option<BoundType>.some(sym.variable.bound_type);
                        return new LamCaptureKind.Capturable();
                    }
                    if (s.kind is ScopeKind.ClassScope || s.kind is ScopeKind.EnumScope || s.kind is ScopeKind.InterfaceScope || s.kind is ScopeKind.ImplScope) {
                        return new LamCaptureKind.ClassMember();
                    }
                    return new LamCaptureKind.NotVariable();
                }
                i = i + 1;
            }
            if (s.parent.is_some()) {
                cur = new Option<BoundScope>.some(s.parent.some);
            } else {
                return new LamCaptureKind.NotVariable();
            }
            guard = guard + 1;
        }
        return new LamCaptureKind.NotVariable();
    }

    // Visit an expression: rewrite captured identifiers into `this.<name>`
    // (returning the replacement so the PARENT slot can be updated — EP has
    // no by-reference parameters), collecting captures in first-appearance
    // order. `shadow` carries names declared inside the lambda body that hide
    // outer locals (params, lets, loop vars, catch vars).
    fun lam_visit_expr(mut this, e: Expression, a: mut LamAnalysis, scope: mut BoundScope) -> Expression {
        if (e is Expression.identifier) {
            let id: IdentifierExpression = e.identifier;
            if (!this.lam_shadow_has(a, id.name)
                && cast<i64>(id.generic_args.size()) == 0
                && cast<i64>(id.value_generic_args.size()) == 0) {
                let kind: LamCaptureKind = this.lam_classify(id.name, scope, a);
                if (kind is LamCaptureKind.ThisParam) {
                    this.model.some.report_error(new ErrorCode.E_UNSUPPORTED(),
                        "lambda cannot capture 'this' (v1); copy the needed members into locals first",
                        new SourceLocation("", 0, 0));
                    a.error_count = a.error_count + 1;
                    return e;
                }
                if (kind is LamCaptureKind.ClassMember) {
                    this.model.some.report_error(new ErrorCode.E_UNSUPPORTED(),
                        "lambda cannot capture class members (v1); copy the member into a local first",
                        new SourceLocation("", 0, 0));
                    a.error_count = a.error_count + 1;
                    return e;
                }
                if (kind is LamCaptureKind.Capturable) {
                    if (this.lam_capture_index(a, id.name) < 0) {
                        a.names.push(id.name);
                        a.types.push(a.last_found_type.some);
                    }
                    return this.mk_this_member(id.name);
                }
            }
            return e;
        }
        if (e is Expression.parenthesized) {
            let p: mut ParenthesizedExpression = e.parenthesized;
            if (p.inner.is_some()) {
                p.inner = new Option<Expression>.some(this.lam_visit_expr(p.inner.some, a, scope));
            }
            return e;
        }
        if (e is Expression.binary) {
            let b: mut BinaryExpression = e.binary;
            let i: mut i64 = 0;
            while (i < cast<i64>(b.operands.size())) {
                b.operands.set(cast<u64>(i), this.lam_visit_expr(b.operands.at(cast<u64>(i)).some, a, scope));
                i = i + 1;
            }
            return e;
        }
        if (e is Expression.unary) {
            let u: mut UnaryExpression = e.unary;
            if (u.operand.is_some()) {
                u.operand = new Option<Expression>.some(this.lam_visit_expr(u.operand.some, a, scope));
            }
            return e;
        }
        if (e is Expression.member_access) {
            let ma: mut MemberAccessExpression = e.member_access;
            if (ma.base_expr.is_some()) {
                ma.base_expr = new Option<Expression>.some(this.lam_visit_expr(ma.base_expr.some, a, scope));
            }
            return e;
        }
        if (e is Expression.function_call) {
            let fc: mut FunctionCallExpression = e.function_call;
            if (fc.callee.is_some()) {
                fc.callee = new Option<Expression>.some(this.lam_visit_expr(fc.callee.some, a, scope));
            }
            let i: mut i64 = 0;
            while (i < cast<i64>(fc.arguments.items.size())) {
                fc.arguments.items.set(cast<u64>(i), this.lam_visit_expr(fc.arguments.items.at(cast<u64>(i)).some, a, scope));
                i = i + 1;
            }
            return e;
        }
        if (e is Expression.function_call_arguments) {
            let fca: mut FunctionCallArguments = e.function_call_arguments;
            let i: mut i64 = 0;
            while (i < cast<i64>(fca.items.size())) {
                fca.items.set(cast<u64>(i), this.lam_visit_expr(fca.items.at(cast<u64>(i)).some, a, scope));
                i = i + 1;
            }
            return e;
        }
        if (e is Expression.if_expr) {
            let ie: mut IfExpression = e.if_expr;
            if (ie.condition.is_some()) {
                ie.condition = new Option<Expression>.some(this.lam_visit_expr(ie.condition.some, a, scope));
            }
            if (ie.then_block.is_some()) {
                ie.then_block = new Option<Expression>.some(this.lam_visit_expr(ie.then_block.some, a, scope));
            }
            if (ie.else_block.is_some()) {
                ie.else_block = new Option<Expression>.some(this.lam_visit_expr(ie.else_block.some, a, scope));
            }
            return e;
        }
        if (e is Expression.while_expr) {
            let we: mut WhileExpression = e.while_expr;
            if (we.condition.is_some()) {
                we.condition = new Option<Expression>.some(this.lam_visit_expr(we.condition.some, a, scope));
            }
            if (we.body.is_some()) {
                we.body = new Option<Expression>.some(this.lam_visit_expr(we.body.some, a, scope));
            }
            return e;
        }
        if (e is Expression.code_block) {
            // Block-lexical scoping: declarations inside the block die at its
            // end (also covers if/while block children, which arrive here as
            // code-block expressions).
            let cb: mut CodeBlockExpression = e.code_block;
            let mark: i64 = this.lam_shadow_mark(a);
            let i: mut i64 = 0;
            while (i < cast<i64>(cb.statements.size())) {
                this.lam_visit_stmt(cb.statements.at(cast<u64>(i)).some, a, scope);
                i = i + 1;
            }
            if (cb.trailing_expr.is_some()) {
                cb.trailing_expr = new Option<Expression>.some(this.lam_visit_expr(cb.trailing_expr.some, a, scope));
            }
            this.lam_shadow_restore(a, mark);
            return e;
        }
        if (e is Expression.cast_expr) {
            let ce: mut CastExpression = e.cast_expr;
            if (ce.inner.is_some()) {
                ce.inner = new Option<Expression>.some(this.lam_visit_expr(ce.inner.some, a, scope));
            }
            return e;
        }
        if (e is Expression.new_expr) {
            let ne: mut NewExpression = e.new_expr;
            let i: mut i64 = 0;
            while (i < cast<i64>(ne.arguments.size())) {
                ne.arguments.set(cast<u64>(i), this.lam_visit_expr(ne.arguments.at(cast<u64>(i)).some, a, scope));
                i = i + 1;
            }
            return e;
        }
        if (e is Expression.lambda_expr) {
            // Nested lambda: its params shadow within its body only; capture
            // analysis still runs against the OUTER site's scope chain, so
            // outer-function locals it references become captures of THIS
            // closure (a nested lambda referencing them again later fails
            // loudly at its own __call binding — documented v1 limit).
            let inner: mut LambdaFunctionExpression = e.lambda_expr;
            let mark: i64 = this.lam_shadow_mark(a);
            let i: mut i64 = 0;
            while (i < cast<i64>(inner.parameters.size())) {
                a.shadow.push(inner.parameters.at(cast<u64>(i)).some.name);
                i = i + 1;
            }
            if (inner.body.is_some()) {
                inner.body = new Option<Expression>.some(this.lam_visit_expr(inner.body.some, a, scope));
            }
            this.lam_shadow_restore(a, mark);
            return e;
        }
        if (e is Expression.spawn_async) {
            let se: mut SpawnAsyncExpression = e.spawn_async;
            if (se.expression.is_some()) {
                se.expression = new Option<Expression>.some(this.lam_visit_expr(se.expression.some, a, scope));
            }
            return e;
        }
        if (e is Expression.wait_expr) {
            let we2: mut WaitExpression = e.wait_expr;
            if (we2.expression.is_some()) {
                we2.expression = new Option<Expression>.some(this.lam_visit_expr(we2.expression.some, a, scope));
            }
            return e;
        }
        if (e is Expression.meta_call) {
            let mc: mut MetaCallExpression = e.meta_call;
            let i: mut i64 = 0;
            while (i < cast<i64>(mc.arguments.size())) {
                mc.arguments.set(cast<u64>(i), this.lam_visit_expr(mc.arguments.at(cast<u64>(i)).some, a, scope));
                i = i + 1;
            }
            return e;
        }
        if (e is Expression.try_bind) {
            let tb: mut TryBindExpression = e.try_bind;
            if (tb.rhs.is_some()) {
                tb.rhs = new Option<Expression>.some(this.lam_visit_expr(tb.rhs.some, a, scope));
            }
            // The pattern variable is bound for the rest of the region.
            if (string_length(tb.variable_name) > 0) { a.shadow.push(tb.variable_name); }
            return e;
        }
        // constant / string / bool / void literals and specializing_impl
        // carry no capturable identifiers.
        return e;
    }

    fun lam_visit_stmt(mut this, s: Statement, a: mut LamAnalysis, scope: mut BoundScope) {
        if (s is Statement.expression) {
            let es: mut ExpressionStatement = s.expression;
            if (es.expression.is_some()) {
                es.expression = new Option<Expression>.some(this.lam_visit_expr(es.expression.some, a, scope));
            }
            return;
        }
        if (s is Statement.block_expr) {
            let bs: mut BlockExpressionStatement = s.block_expr;
            if (bs.expression.is_some()) {
                bs.expression = new Option<Expression>.some(this.lam_visit_expr(bs.expression.some, a, scope));
            }
            return;
        }
        if (s is Statement.assignment) {
            let as2: mut AssignmentStatement = s.assignment;
            if (as2.target.is_some()) {
                as2.target = new Option<Expression>.some(this.lam_visit_expr(as2.target.some, a, scope));
            }
            if (as2.value.is_some()) {
                as2.value = new Option<Expression>.some(this.lam_visit_expr(as2.value.some, a, scope));
            }
            return;
        }
        if (s is Statement.if_stmt) {
            let is2: mut IfStatement = s.if_stmt;
            if (is2.condition.is_some()) {
                is2.condition = new Option<Expression>.some(this.lam_visit_expr(is2.condition.some, a, scope));
            }
            if (is2.then_statement.is_some()) {
                let mark: i64 = this.lam_shadow_mark(a);
                this.lam_visit_stmt(is2.then_statement.some, a, scope);
                this.lam_shadow_restore(a, mark);
            }
            if (is2.else_statement.is_some()) {
                let mark2: i64 = this.lam_shadow_mark(a);
                this.lam_visit_stmt(is2.else_statement.some, a, scope);
                this.lam_shadow_restore(a, mark2);
            }
            return;
        }
        if (s is Statement.while_stmt) {
            let ws: mut WhileStatement = s.while_stmt;
            if (ws.condition.is_some()) {
                ws.condition = new Option<Expression>.some(this.lam_visit_expr(ws.condition.some, a, scope));
            }
            if (ws.body.is_some()) {
                let mark: i64 = this.lam_shadow_mark(a);
                this.lam_visit_stmt(ws.body.some, a, scope);
                this.lam_shadow_restore(a, mark);
            }
            return;
        }
        if (s is Statement.for_stmt) {
            let fs: mut ForStatement = s.for_stmt;
            if (fs.iterable.is_some()) {
                fs.iterable = new Option<Expression>.some(this.lam_visit_expr(fs.iterable.some, a, scope));
            }
            if (fs.body.is_some()) {
                let mark: i64 = this.lam_shadow_mark(a);
                if (string_length(fs.variable_name) > 0) { a.shadow.push(fs.variable_name); }
                this.lam_visit_stmt(fs.body.some, a, scope);
                this.lam_shadow_restore(a, mark);
            }
            return;
        }
        if (s is Statement.return_stmt) {
            let rs: mut ReturnStatement = s.return_stmt;
            if (rs.value.is_some()) {
                rs.value = new Option<Expression>.some(this.lam_visit_expr(rs.value.some, a, scope));
            }
            return;
        }
        if (s is Statement.let_decl) {
            let ls: mut LetDeclarationStatement = s.let_decl;
            if (ls.initializer.is_some()) {
                ls.initializer = new Option<Expression>.some(this.lam_visit_expr(ls.initializer.some, a, scope));
            }
            // Sequential scoping: the declared name is visible only AFTER
            // its own initializer (mirrors progressive symbol binding).
            if (string_length(ls.variable_name) > 0) { a.shadow.push(ls.variable_name); }
            return;
        }
        if (s is Statement.connect_stmt) {
            let cs: mut ConnectStatement = s.connect_stmt;
            if (cs.source.is_some()) {
                cs.source = new Option<Expression>.some(this.lam_visit_expr(cs.source.some, a, scope));
            }
            if (cs.sink.is_some()) {
                cs.sink = new Option<Expression>.some(this.lam_visit_expr(cs.sink.some, a, scope));
            }
            return;
        }
        if (s is Statement.try_stmt) {
            let ts: mut TryStatement = s.try_stmt;
            if (ts.try_block.is_some()) {
                let mark: i64 = this.lam_shadow_mark(a);
                this.lam_visit_stmt(ts.try_block.some, a, scope);
                this.lam_shadow_restore(a, mark);
            }
            if (ts.catch_block.is_some()) {
                let mark2: i64 = this.lam_shadow_mark(a);
                if (string_length(ts.catch_var_name) > 0) { a.shadow.push(ts.catch_var_name); }
                this.lam_visit_stmt(ts.catch_block.some, a, scope);
                this.lam_shadow_restore(a, mark2);
            }
            return;
        }
        if (s is Statement.yield_stmt) {
            let ys: mut YieldStatement = s.yield_stmt;
            if (ys.value.is_some()) {
                ys.value = new Option<Expression>.some(this.lam_visit_expr(ys.value.some, a, scope));
            }
            return;
        }
        if (s is Statement.signal_stmt) {
            let ss: mut SignalStatement = s.signal_stmt;
            if (ss.expression.is_some()) {
                ss.expression = new Option<Expression>.some(this.lam_visit_expr(ss.expression.some, a, scope));
            }
            return;
        }
        if (s is Statement.break_stmt) {
            let bs2: mut BreakStatement = s.break_stmt;
            if (bs2.value.is_some()) {
                bs2.value = new Option<Expression>.some(this.lam_visit_expr(bs2.value.some, a, scope));
            }
            return;
        }
        if (s is Statement.meta_if_stmt) {
            let ms: mut MetaIfStatement = s.meta_if_stmt;
            if (ms.condition.is_some()) {
                ms.condition = new Option<Expression>.some(this.lam_visit_expr(ms.condition.some, a, scope));
            }
            if (ms.then_statement.is_some()) {
                let mark: i64 = this.lam_shadow_mark(a);
                this.lam_visit_stmt(ms.then_statement.some, a, scope);
                this.lam_shadow_restore(a, mark);
            }
            let i: mut i64 = 0;
            while (i < cast<i64>(ms.elif_branches.size())) {
                let eb: mut MetaElifBranch = ms.elif_branches.at(cast<u64>(i)).some;
                if (eb.condition.is_some()) {
                    eb.condition = new Option<Expression>.some(this.lam_visit_expr(eb.condition.some, a, scope));
                }
                if (eb.body_statement.is_some()) {
                    let mark2: i64 = this.lam_shadow_mark(a);
                    this.lam_visit_stmt(eb.body_statement.some, a, scope);
                    this.lam_shadow_restore(a, mark2);
                }
                i = i + 1;
            }
            if (ms.else_statement.is_some()) {
                let mark3: i64 = this.lam_shadow_mark(a);
                this.lam_visit_stmt(ms.else_statement.some, a, scope);
                this.lam_shadow_restore(a, mark3);
            }
            return;
        }
        if (s is Statement.meta_while_stmt) {
            let mws: mut MetaWhileStatement = s.meta_while_stmt;
            if (mws.condition.is_some()) {
                mws.condition = new Option<Expression>.some(this.lam_visit_expr(mws.condition.some, a, scope));
            }
            if (mws.body.is_some()) {
                let mark: i64 = this.lam_shadow_mark(a);
                this.lam_visit_stmt(mws.body.some, a, scope);
                this.lam_shadow_restore(a, mark);
            }
            return;
        }
        if (s is Statement.meta_for_stmt) {
            let mfs: mut MetaForStatement = s.meta_for_stmt;
            if (mfs.iterable.is_some()) {
                mfs.iterable = new Option<Expression>.some(this.lam_visit_expr(mfs.iterable.some, a, scope));
            }
            if (mfs.body.is_some()) {
                let mark: i64 = this.lam_shadow_mark(a);
                if (string_length(mfs.variable_name) > 0) { a.shadow.push(mfs.variable_name); }
                this.lam_visit_stmt(mfs.body.some, a, scope);
                this.lam_shadow_restore(a, mark);
            }
            return;
        }
        if (s is Statement.meta_break_stmt) {
            let mbs: mut MetaBreakStatement = s.meta_break_stmt;
            if (mbs.value.is_some()) {
                mbs.value = new Option<Expression>.some(this.lam_visit_expr(mbs.value.some, a, scope));
            }
            return;
        }
        // continue / meta_continue carry no expressions.
    }

    fun bind_lambda(mut this, lam: mut LambdaFunctionExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        let m: mut SemanticModel = this.model.some;
        let loc: SourceLocation = new SourceLocation("", 0, 0);
        if (m.current_unit.is_none()) {
            m.report_error(new ErrorCode.E_INTERNAL(), "lambda outside a compilation unit", loc);
            return new Option<BoundExpression>.none();
        }
        if (lam.body.is_none()) {
            m.report_error(new ErrorCode.E_INTERNAL(), "lambda without a body", loc);
            return new Option<BoundExpression>.none();
        }
        // Resolve param/return types in the ENCLOSING scope (the closure class
        // lives under the enclosing namespace; lambda-local type names would
        // not survive there).
        let param_bts: mut _utils.List<BoundType> = new _utils.List<BoundType>();
        let pi: mut i64 = 0;
        while (pi < cast<i64>(lam.parameters.size())) {
            let p: Parameter = lam.parameters.at(cast<u64>(pi)).some;
            if (p.type_spec.is_none()) {
                m.report_error(new ErrorCode.E_RESOLVE_TYPE(),
                    "lambda parameter '" + p.name + "' needs an explicit type", loc);
                return new Option<BoundExpression>.none();
            }
            param_bts.push(m.resolve_type_specifier(p.type_spec.some, scope));
            pi = pi + 1;
        }
        let ret_bt: mut BoundType = m.type_registry.void_type;
        if (lam.return_type.is_some()) {
            ret_bt = m.resolve_type_specifier(lam.return_type.some, scope);
        }
        // Capture analysis + in-place body rewrite.
        let a: mut LamAnalysis = new LamAnalysis();
        let si: mut i64 = 0;
        while (si < cast<i64>(lam.parameters.size())) {
            a.shadow.push(lam.parameters.at(cast<u64>(si)).some.name);
            si = si + 1;
        }
        lam.body = new Option<Expression>.some(this.lam_visit_expr(lam.body.some, a, scope));
        if (a.error_count > 0) { return new Option<BoundExpression>.none(); }

        // ---- synthesize the closure class ----
        m.lambda_site_counter = m.lambda_site_counter + 1;
        let cls_name: string = "__lambda_" + cast<string>(m.lambda_site_counter);
        let cls: mut ClassDefinition = new ClassDefinition(cls_name);
        cls.location = loc;
        cls.source_file = "<lambda>";
        cls.is_funval = true;

        // Capture fields: by-value snapshot, mutability preserved from the
        // source variable (a mut local's snapshot stays assignable inside
        // the lambda body; an immutable local's does not).
        let ci: mut i64 = 0;
        while (ci < cast<i64>(a.names.size())) {
            let cap_name: string = a.names.at(cast<u64>(ci)).some;
            let cap_bt: BoundType = a.types.at(cast<u64>(ci)).some;
            let fd: mut ClassFieldDefinition = new ClassFieldDefinition(cap_name);
            let fts: mut TypeSpecifier = this.spawn_type_spec(cap_bt);
            fts.is_mutable = cap_bt.mutability is Mutability.Mutable;
            fd.type_spec = new Option<TypeSpecifier>.some(fts);
            fd.location = loc;
            cls.members.push(new Definition.class_field(fd));
            ci = ci + 1;
        }
        // Constructor: fun new(mut this, caps...) { this.<cap> = <cap>; ... }
        let ctor: mut FunctionDefinition = new FunctionDefinition("new");
        ctor.is_new = true;
        let this_p: Parameter = new Parameter("this");
        this_p.is_this = true;
        this_p.is_mutable = true;
        ctor.parameters.push(this_p);
        let ctor_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        ci = 0;
        while (ci < cast<i64>(a.names.size())) {
            let cap_name2: string = a.names.at(cast<u64>(ci)).some;
            let cap_bt2: BoundType = a.types.at(cast<u64>(ci)).some;
            let cp: Parameter = new Parameter(cap_name2);
            let cts: mut TypeSpecifier = this.spawn_type_spec(cap_bt2);
            cts.is_mutable = cap_bt2.mutability is Mutability.Mutable;
            cp.type_spec = new Option<TypeSpecifier>.some(cts);
            ctor.parameters.push(cp);
            ctor_stmts.push(this.mk_assign_stmt(this.mk_this_member(cap_name2), this.mk_ident_expr(cap_name2)));
            ci = ci + 1;
        }
        ctor.body = new Option<Expression>.some(this.mk_block_expr(ctor_stmts, new Option<Expression>.none()));
        cls.members.push(new Definition.function_def(ctor));
        // __call: the callable body (captures already rewritten to this.<name>).
        let call_fn: mut FunctionDefinition = new FunctionDefinition("__call");
        let call_this: Parameter = new Parameter("this");
        call_this.is_this = true;
        call_this.is_mutable = true;
        call_fn.parameters.push(call_this);
        let mi: mut i64 = 0;
        while (mi < cast<i64>(lam.parameters.size())) {
            call_fn.parameters.push(lam.parameters.at(cast<u64>(mi)).some);
            mi = mi + 1;
        }
        call_fn.return_type = lam.return_type;
        call_fn.is_async = lam.is_async;
        call_fn.body = lam.body;
        cls.members.push(new Definition.function_def(call_fn));

        // ---- bind into the enclosing namespace, resolve, catch up (spawn
        // pattern: the pushed def's bodies are bound by the pass-8 loop) ----
        let def_scope: mut BoundScope = this.enclosing_def_scope(scope);
        let cls_ast: Definition = new Definition.class_def(cls);
        let bound_cls: Option<BoundDefinition> = m.build_scopes_pass.bind_definition(cls_ast, def_scope);
        if (bound_cls.is_none()) { return new Option<BoundExpression>.none(); }
        let saved_pass: i64 = m.current_pass_index;
        m.current_pass_index = 2;
        let resolved: BoundDefinition = m.resolve_types_pass.resolve_pair(cls_ast, bound_cls.some, def_scope);
        m.current_pass_index = saved_pass;
        let unit_ref: mut BoundCompilationUnit = m.current_unit.some;
        unit_ref.definitions.push(resolved);
        m.catch_up_def_before_bodies(resolved, unit_ref);

        // ---- the lambda expression binds as `new __lambda_N(<captures>)`,
        // re-typed to its fun type: the closure object IS the fun value ----
        let fun_bt: BoundType = m.type_registry.make_function_type(ret_bt, param_bts, lam.is_async);
        let new_ast: mut NewExpression = new NewExpression();
        new_ast.type_name = cls_name;
        let ni: mut i64 = 0;
        while (ni < cast<i64>(a.names.size())) {
            new_ast.arguments.push(this.mk_ident_expr(a.names.at(cast<u64>(ni)).some));
            ni = ni + 1;
        }
        let bound_new: Option<BoundExpression> = this.bind_new_expr(new_ast, scope);
        if (bound_new.is_none()) { return new Option<BoundExpression>.none(); }
        if (bound_new.some is BoundExpression.new_expr) {
            // Re-type as the fun type (fresh node — the closure object IS the
            // fun value; lower_new keys on type_symbol, not bound_type).
            let orig: BoundNewExpression = bound_new.some.new_expr;
            let re_typed: mut BoundNewExpression = new BoundNewExpression(fun_bt, orig.type_symbol, orig.constructor_symbol, orig.arguments);
            return new Option<BoundExpression>.some(new BoundExpression.new_expr(re_typed));
        }
        return bound_new;
    }


    // ===================== Generic call type-arg inference =====================
    // A call to a template function/method WITHOUT explicit <...> args infers
    // the type parameters from the bound argument types: a direct match
    // (param `x: U` vs an i64 argument), a fun-type match (param
    // `f: fun<U, P>` vs a lambda/fun value — arg 0 is the RETURN type), and a
    // same-base container match (param `List<U>` vs `List<i64>`). Partial
    // solutions abandon inference (the call falls back to the historical
    // unspecialized form — a loud link error today).

    // Structural unification of one (declared param type, actual arg type)
    // pair into the solved-params lists. Conflicts keep the first solution.
    fun infer_unify_type(mut this, ts: TypeSpecifier, bt: BoundType, generic_params: _utils.List<string>, names: mut _utils.List<string>, types: mut _utils.List<BoundType>) {
        if (ts.is_function_type) {
            if (bt.kind is TypeKind.FunctionKind) {
                if (cast<i64>(ts.function_params.size()) == cast<i64>(bt.generic_args.size())) {
                    let i: mut i64 = 0;
                    while (i < cast<i64>(ts.function_params.size())) {
                        this.infer_unify_type(ts.function_params.at(cast<u64>(i)).some, arg_as_bound_type(bt.generic_args.at(cast<u64>(i)).some), generic_params, names, types);
                        i = i + 1;
                    }
                }
            }
            return;
        }
        if (cast<i64>(ts.qualified_parts.size()) == 0 && cast<i64>(ts.generic_args.size()) == 0) {
            let gp: mut i64 = 0;
            while (gp < cast<i64>(generic_params.size())) {
                if (generic_params.at(cast<u64>(gp)).some == ts.name) {
                    let ni: mut i64 = 0;
                    while (ni < cast<i64>(names.size())) {
                        if (names.at(cast<u64>(ni)).some == ts.name) { return; }
                        ni = ni + 1;
                    }
                    names.push(ts.name);
                    types.push(bt);
                    return;
                }
                gp = gp + 1;
            }
            return;
        }
        // Same-base container (List<U> vs List<i64>): unify the args pairwise.
        if (cast<i64>(ts.generic_args.size()) > 0 && cast<i64>(bt.generic_args.size()) == cast<i64>(ts.generic_args.size())) {
            let base_match: mut bool = false;
            if (bt.type_definition.is_some()) {
                if (string_find(bt.type_definition.some.get_name(), ts.name) >= 0) { base_match = true; }
            }
            if (base_match) {
                let i2: mut i64 = 0;
                while (i2 < cast<i64>(ts.generic_args.size())) {
                    this.infer_unify_type(ts.generic_args.at(cast<u64>(i2)).some, arg_as_bound_type(bt.generic_args.at(cast<u64>(i2)).some), generic_params, names, types);
                    i2 = i2 + 1;
                }
            }
        }
    }

    // Find the BoundFunctionDefinition for a symbol's full name (top-level,
    // namespace, class methods, impl methods — the search_return_type walker's
    // shape, returning the def instead of its return type).
    fun find_function_def_in_defs(this, target_full_name: string, defs: _utils.List<BoundDefinition>) -> Option<BoundDefinition> {
        let i: mut i64 = 0;
        while (i < cast<i64>(defs.size())) {
            let def: BoundDefinition = defs.at(cast<u64>(i)).some;
            if (def is BoundDefinition.function_def) {
                if (def.function_def.full_name == target_full_name) {
                    return new Option<BoundDefinition>.some(def);
                }
            }
            if (def is BoundDefinition.namespace_def) {
                let r: Option<BoundDefinition> = this.find_function_def_in_defs(target_full_name, def.namespace_def.children);
                if (r.is_some()) { return r; }
            }
            if (def is BoundDefinition.class_def) {
                let rm: Option<BoundDefinition> = this.find_function_def_in_defs(target_full_name, def.class_def.methods);
                if (rm.is_some()) { return rm; }
                let rc: Option<BoundDefinition> = this.find_function_def_in_defs(target_full_name, def.class_def.constructors);
                if (rc.is_some()) { return rc; }
                let ri: Option<BoundDefinition> = this.find_function_def_in_defs(target_full_name, def.class_def.interface_impls);
                if (ri.is_some()) { return ri; }
            }
            if (def is BoundDefinition.impl_for_def) {
                let rf: Option<BoundDefinition> = this.find_function_def_in_defs(target_full_name, def.impl_for_def.methods);
                if (rf.is_some()) { return rf; }
            }
            if (def is BoundDefinition.impl_def) {
                let r2: Option<BoundDefinition> = this.find_function_def_in_defs(target_full_name, def.impl_def.methods);
                if (r2.is_some()) { return r2; }
            }
            i = i + 1;
        }
        return new Option<BoundDefinition>.none();
    }

    // Infer a template callee's type args from the bound arguments and return
    // the SPECIALIZED function's symbol (existing or created on demand).
    // out_types receives the solved types in generic_params order.
    fun try_infer_generic_call(mut this, sym: BoundFunctionSymbol, args: _utils.List<BoundExpression>, skip_this: bool, scope: mut BoundScope, out_types: mut _utils.List<BoundType>) -> Option<BoundFunctionSymbol> {
        let m: mut SemanticModel = this.model.some;
        if (m.current_unit.is_none()) { return new Option<BoundFunctionSymbol>.none(); }
        let tmpl_def: Option<BoundDefinition> = this.find_function_def_in_defs(sym.full_name, m.current_unit.some.definitions);
        if (tmpl_def.is_none()) { return new Option<BoundFunctionSymbol>.none(); }
        if (!(tmpl_def.some is BoundDefinition.function_def)) { return new Option<BoundFunctionSymbol>.none(); }
        let tf: BoundFunctionDefinition = tmpl_def.some.function_def;
        if (cast<i64>(tf.generic_params.size()) == 0) { return new Option<BoundFunctionSymbol>.none(); }
        if (cast<i64>(tf.value_param_names.size()) > 0) { return new Option<BoundFunctionSymbol>.none(); }
        let ast_def2: Option<Definition> = if (tf.ast_source.is_some()) {
            tf.ast_source
        } else {
            m.monomorphize_pass.find_ast_def_by_name(m.ast_definitions, tf.name)
        };
        if (ast_def2.is_none()) { return new Option<BoundFunctionSymbol>.none(); }
        if (!(ast_def2.some is Definition.function_def)) { return new Option<BoundFunctionSymbol>.none(); }
        let ast_func: FunctionDefinition = ast_def2.some.function_def;
        let skip: i64 = if (skip_this) { 1 } else { 0 };
        let names: mut _utils.List<string> = new _utils.List<string>();
        let types: mut _utils.List<BoundType> = new _utils.List<BoundType>();
        let pi: mut i64 = 0;
        while (pi < cast<i64>(ast_func.parameters.size())) {
            let ai2: i64 = pi - skip;
            if (ai2 >= 0 && ai2 < cast<i64>(args.size())) {
                let p: Parameter = ast_func.parameters.at(cast<u64>(pi)).some;
                if (p.type_spec.is_some()) {
                    this.infer_unify_type(p.type_spec.some, args.at(cast<u64>(ai2)).some.get_bound_type(), tf.generic_params, names, types);
                }
            }
            pi = pi + 1;
        }
        if (cast<i64>(names.size()) != cast<i64>(tf.generic_params.size())) { return new Option<BoundFunctionSymbol>.none(); }
        let type_args: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
        let gi: mut i64 = 0;
        while (gi < cast<i64>(tf.generic_params.size())) {
            let want: string = tf.generic_params.at(cast<u64>(gi)).some;
            let found: mut bool = false;
            let ni2: mut i64 = 0;
            while (ni2 < cast<i64>(names.size())) {
                if (names.at(cast<u64>(ni2)).some == want) {
                    let solved: BoundType = types.at(cast<u64>(ni2)).some;
                    type_args.push(make_type_arg(solved));
                    out_types.push(solved);
                    found = true;
                }
                ni2 = ni2 + 1;
            }
            if (!found) { return new Option<BoundFunctionSymbol>.none(); }
            gi = gi + 1;
        }
        // Refuse template-param solutions: inference firing inside a
        // still-generic body can "solve" params to dummy template-param types —
        // specializing over them manufactures garbage instantiations (see
        // bound_type_is_template_param).
        let ti: mut i64 = 0;
        while (ti < cast<i64>(type_args.size())) {
            if (bound_type_is_template_param(arg_as_bound_type(type_args.at(cast<u64>(ti)).some))) {
                return new Option<BoundFunctionSymbol>.none();
            }
            ti = ti + 1;
        }
        let mangled: string = MonomorphizePass.mangle_generic_name(sym.full_name, type_args);
        let spec_sym: Option<BoundSymbol> = scope.lookup_symbol(mangled);
        if (spec_sym.is_some() && spec_sym.some is BoundSymbol.function_sym) {
            return new Option<BoundFunctionSymbol>.some(spec_sym.some.function_sym);
        }
        return m.monomorphize_pass.ensure_function_specialization_now(tmpl_def.some, type_args, m.current_unit.some);
    }

    // ===================== Generator functions =====================
    // `fun g(params) -> IGenerator<T> { ... yield v; ... }` rewrites onto the
    // stackful-coroutine runtime, mirroring BabyPenguin's RewriteGenerator:
    //   class __GenCtx_<n> {
    //     <params as snapshot fields>                  (the lambda capture
    //     started/done/resume: mut bool;               machinery rewrites
    //     value: mut Option<T>;                         identifiers to this.<p>)
    //     fun new(mut this, params...) { ... }
    //     fun __gen_yield(mut this, v: T) { this.value = some(v); this.resume = false;
    //                                      while (!this.resume) { _co_wait(); } }
    //     fun __gen_finish(mut this, v: T) { this.value = some(v); this.done = true; }
    //     fun __gen_finish_void(mut this) { this.done = true; }
    //     impl __ICoroutineEntry { fun __enter(mut this) { <body: yield -> publish,
    //                                 return -> finish; fall-off -> finish_void> } }
    //     impl IGenerator<T> { fun next(mut this) -> Option<T> { <drive protocol> } }
    //   }
    // and the function itself becomes { let __gen = new __GenCtx_<n>(params...);
    // return cast<IGenerator<T>>(__gen); }. Protocol: next() spawns __enter on
    // its own stack on first call, then parks one delta round between polls;
    // __gen_yield publishes the value and parks until next() consumes it (the
    // handshake costs ~1 round per element, like BabyPenguin's do_wait_any).

    fun is_generator_return_type(this, bt: BoundType) -> bool {
        // The instantiated interface's def name is the MANGLED specialization
        // (IGenerator$2Fib...), so match on the display spelling — the same
        // approach is_iterator_type uses for IIterator<.
        if (bt.kind is TypeKind.InterfaceKind) {
            if (string_find(bt.display_name(), "IGenerator<") >= 0) { return true; }
        }
        return false;
    }

    // yield/return surgery AFTER lam_visit (identifiers are already this.<p>;
    // the synthetic this.__gen_* calls are never visited by it).
    fun gen_stmt_replace(mut this, s: Statement) -> Option<Statement> {
        let loc: SourceLocation = new SourceLocation("", 0, 0);
        if (s is Statement.yield_stmt) {
            let ys: mut YieldStatement = s.yield_stmt;
            if (ys.value.is_none()) {
                this.model.some.report_error(new ErrorCode.E_YIELD_CONTEXT(),
                    "yield without a value is only valid in IGenerator<void> (not supported on EmperorPenguin)", loc);
                return new Option<Statement>.none();
            }
            let args: mut _utils.List<Expression> = new _utils.List<Expression>();
            args.push(ys.value.some);
            let call: Expression = this.mk_member_call_expr(this.mk_ident_expr("this"), "__gen_yield", args);
            let es: mut ExpressionStatement = new ExpressionStatement();
            es.expression = new Option<Expression>.some(call);
            es.location = loc;
            return new Option<Statement>.some(new Statement.expression(es));
        }
        if (s is Statement.return_stmt) {
            let rs: mut ReturnStatement = s.return_stmt;
            let stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
            let noargs: mut _utils.List<Expression> = new _utils.List<Expression>();
            let fin: Expression = if (rs.value.is_some()) {
                let fargs: mut _utils.List<Expression> = new _utils.List<Expression>();
                fargs.push(rs.value.some);
                this.mk_member_call_expr(this.mk_ident_expr("this"), "__gen_finish", fargs)
            } else {
                this.mk_member_call_expr(this.mk_ident_expr("this"), "__gen_finish_void", noargs)
            };
            let fs: mut ExpressionStatement = new ExpressionStatement();
            fs.expression = new Option<Expression>.some(fin);
            fs.location = loc;
            stmts.push(new Statement.expression(fs));
            let ret: mut ReturnStatement = new ReturnStatement();
            ret.location = loc;
            stmts.push(new Statement.return_stmt(ret));
            let cb: mut CodeBlockExpression = new CodeBlockExpression();
            cb.statements = stmts;
            let bes: mut BlockExpressionStatement = new BlockExpressionStatement();
            bes.expression = new Option<Expression>.some(new Expression.code_block(cb));
            bes.location = loc;
            return new Option<Statement>.some(new Statement.block_expr(bes));
        }
        // containers: recurse into single-statement slots and statement lists
        if (s is Statement.if_stmt) {
            let is2: mut IfStatement = s.if_stmt;
            if (is2.then_statement.is_some()) {
                let r1: Option<Statement> = this.gen_stmt_replace(is2.then_statement.some);
                if (r1.is_some()) { is2.then_statement = new Option<Statement>.some(r1.some); }
            }
            if (is2.else_statement.is_some()) {
                let r2: Option<Statement> = this.gen_stmt_replace(is2.else_statement.some);
                if (r2.is_some()) { is2.else_statement = new Option<Statement>.some(r2.some); }
            }
            return new Option<Statement>.none();
        }
        if (s is Statement.while_stmt) {
            let ws: mut WhileStatement = s.while_stmt;
            if (ws.body.is_some()) {
                let r3: Option<Statement> = this.gen_stmt_replace(ws.body.some);
                if (r3.is_some()) { ws.body = new Option<Statement>.some(r3.some); }
            }
            return new Option<Statement>.none();
        }
        if (s is Statement.for_stmt) {
            let fs2: mut ForStatement = s.for_stmt;
            if (fs2.body.is_some()) {
                let r4: Option<Statement> = this.gen_stmt_replace(fs2.body.some);
                if (r4.is_some()) { fs2.body = new Option<Statement>.some(r4.some); }
            }
            return new Option<Statement>.none();
        }
        if (s is Statement.try_stmt) {
            let ts: mut TryStatement = s.try_stmt;
            if (ts.try_block.is_some()) {
                let r5: Option<Statement> = this.gen_stmt_replace(ts.try_block.some);
                if (r5.is_some()) { ts.try_block = new Option<Statement>.some(r5.some); }
            }
            if (ts.catch_block.is_some()) {
                let r6: Option<Statement> = this.gen_stmt_replace(ts.catch_block.some);
                if (r6.is_some()) { ts.catch_block = new Option<Statement>.some(r6.some); }
            }
            return new Option<Statement>.none();
        }
        if (s is Statement.block_expr) {
            let bs: mut BlockExpressionStatement = s.block_expr;
            if (bs.expression.is_some()) {
                this.gen_transform_expr(bs.expression.some);
            }
            return new Option<Statement>.none();
        }
        if (s is Statement.expression) {
            let es2: mut ExpressionStatement = s.expression;
            if (es2.expression.is_some()) {
                this.gen_transform_expr(es2.expression.some);
            }
            return new Option<Statement>.none();
        }
        return new Option<Statement>.none();
    }

    // Block-level control flow inside a code block parses as an EXPRESSION
    // (`{ while ... }` arrives as block_expr{while_expr} — see
    // parse_codeBlockExpression), so the statement surgery above must also
    // descend through while/if EXPRESSION bodies to reach their statements.
    fun gen_transform_expr(mut this, e: Expression) {
        if (e is Expression.code_block) {
            this.gen_transform_stmt_list(e.code_block.statements);
        }
        if (e is Expression.while_expr) {
            let we: mut WhileExpression = e.while_expr;
            if (we.body.is_some()) { this.gen_transform_expr(we.body.some); }
        }
        if (e is Expression.if_expr) {
            let ie: mut IfExpression = e.if_expr;
            if (ie.then_block.is_some()) { this.gen_transform_expr(ie.then_block.some); }
            if (ie.else_block.is_some()) { this.gen_transform_expr(ie.else_block.some); }
        }
    }

    fun gen_transform_stmt_list(mut this, stmts: mut _utils.List<Statement>) {
        let i: mut i64 = 0;
        while (i < cast<i64>(stmts.size())) {
            let r: Option<Statement> = this.gen_stmt_replace(stmts.at(cast<u64>(i)).some);
            if (r.is_some()) { stmts.set(cast<u64>(i), r.some); }
            i = i + 1;
        }
    }

    fun bind_generator_function(mut this, ast_func: FunctionDefinition, bound_func: BoundFunctionDefinition, elem_bt: BoundType, func_scope: mut BoundScope) -> Option<Expression> {
        let m: mut SemanticModel = this.model.some;
        let loc: SourceLocation = new SourceLocation("", 0, 0);
        if (!m.require_coroutine("yield (generator function)", loc)) {
            return new Option<Expression>.none();
        }
        // The ctx's yield/park protocol suspends: mark the unit so emit_main
        // runs the scheduler (initials on coroutine stacks).
        m.has_suspension = true;
        if (elem_bt.kind is TypeKind.PrimitiveKind && elem_bt.primitive is PrimitiveType.VoidType) {
            m.report_error(new ErrorCode.E_UNSUPPORTED(), "IGenerator<void> is not supported on EmperorPenguin yet (every yield must carry a value)", loc);
            return new Option<Expression>.none();
        }
        if (cast<i64>(bound_func.generic_params.size()) > 0) {
            m.report_error(new ErrorCode.E_UNSUPPORTED(), "generic generator functions are not supported on EmperorPenguin yet", loc);
            return new Option<Expression>.none();
        }
        if (ast_func.body.is_none() || !(ast_func.body.some is Expression.code_block)) {
            m.report_error(new ErrorCode.E_INTERNAL(), "generator function without a block body", loc);
            return new Option<Expression>.none();
        }

        // 1) identifier rewrite (the lambda machinery): parameters (and any
        // capturables) become this.<name> snapshot fields; this/class-member
        // references error loudly (v1 limits, same as lambdas).
        let a: mut LamAnalysis = new LamAnalysis();
        let body_cb: mut CodeBlockExpression = ast_func.body.some.code_block;
        this.lam_visit_expr(new Expression.code_block(body_cb), a, func_scope);
        if (a.error_count > 0) { return new Option<Expression>.none(); }

        // 2) yield/return surgery + implicit finish at fall-off
        this.gen_transform_stmt_list(body_cb.statements);
        let finargs: mut _utils.List<Expression> = new _utils.List<Expression>();
        let fin_call: Expression = this.mk_member_call_expr(this.mk_ident_expr("this"), "__gen_finish_void", finargs);
        let fin_stmt: mut ExpressionStatement = new ExpressionStatement();
        fin_stmt.expression = new Option<Expression>.some(fin_call);
        fin_stmt.location = loc;
        body_cb.statements.push(new Statement.expression(fin_stmt));

        // 3) the ctx class
        m.generator_site_counter = m.generator_site_counter + 1;
        let n: i64 = m.generator_site_counter;
        let ctx_name: string = "__GenCtx_" + cast<string>(n);
        let cls: mut ClassDefinition = new ClassDefinition(ctx_name);
        cls.location = loc;
        cls.source_file = "<generator>";
        
        // protocol fields
        let pf_names: mut _utils.List<string> = new _utils.List<string>();
        pf_names.push("started");
        pf_names.push("done");
        pf_names.push("resume");
        let pfi: mut i64 = 0;
        while (pfi < 3) {
            let fname: string = pf_names.at(cast<u64>(pfi)).some;
            let fd: mut ClassFieldDefinition = new ClassFieldDefinition(fname);
            let bts: mut TypeSpecifier = new TypeSpecifier();
            bts.name = "bool";
            bts.is_mutable = true;
            fd.type_spec = new Option<TypeSpecifier>.some(bts);
            let fl: mut BoolLiteralExpression = new BoolLiteralExpression();
            fl.value = "false";
            fd.initializer = new Option<Expression>.some(new Expression.bool_literal(fl));
            fd.location = loc;
            cls.members.push(new Definition.class_field(fd));
            pfi = pfi + 1;
        }
        // value: mut Option<T> = new Option<T>.none()
        let val_fd: mut ClassFieldDefinition = new ClassFieldDefinition("value");
        let opt_ts: mut TypeSpecifier = new TypeSpecifier();
        opt_ts.qualified_parts.push("__builtin");
        opt_ts.name = "Option";
        opt_ts.generic_args.push(this.spawn_type_spec(elem_bt));
        opt_ts.is_mutable = true;
        val_fd.type_spec = new Option<TypeSpecifier>.some(opt_ts);
        let none_new: mut NewExpression = new NewExpression();
        none_new.type_name = "__builtin.Option.none";
        none_new.generic_args.push(this.spawn_type_spec(elem_bt));
        let none_args: mut _utils.List<Expression> = new _utils.List<Expression>();
        none_new.arguments = none_args;
        val_fd.initializer = new Option<Expression>.some(new Expression.new_expr(none_new));
        val_fd.location = loc;
        cls.members.push(new Definition.class_field(val_fd));

        // capture fields (the generator's parameters) + ctor — by-value
        // snapshot, mutability preserved (same as lambda captures)
        let ci: mut i64 = 0;
        while (ci < cast<i64>(a.names.size())) {
            let cap_name: string = a.names.at(cast<u64>(ci)).some;
            let cap_bt: BoundType = a.types.at(cast<u64>(ci)).some;
            let cfd: mut ClassFieldDefinition = new ClassFieldDefinition(cap_name);
            let cts: mut TypeSpecifier = this.spawn_type_spec(cap_bt);
            cts.is_mutable = cap_bt.mutability is Mutability.Mutable;
            cfd.type_spec = new Option<TypeSpecifier>.some(cts);
            cfd.location = loc;
            cls.members.push(new Definition.class_field(cfd));
            ci = ci + 1;
        }
        let ctor: mut FunctionDefinition = new FunctionDefinition("new");
        ctor.is_new = true;
        let ctor_this: Parameter = new Parameter("this");
        ctor_this.is_this = true;
        ctor_this.is_mutable = true;
        ctor.parameters.push(ctor_this);
        let ctor_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        ci = 0;
        while (ci < cast<i64>(a.names.size())) {
            let cap2: string = a.names.at(cast<u64>(ci)).some;
            let cap_bt2: BoundType = a.types.at(cast<u64>(ci)).some;
            let cp: Parameter = new Parameter(cap2);
            let cts2: mut TypeSpecifier = this.spawn_type_spec(cap_bt2);
            cts2.is_mutable = cap_bt2.mutability is Mutability.Mutable;
            cp.type_spec = new Option<TypeSpecifier>.some(cts2);
            ctor.parameters.push(cp);
            ctor_stmts.push(this.mk_assign_stmt(this.mk_this_member(cap2), this.mk_ident_expr(cap2)));
            ci = ci + 1;
        }
        ctor.body = new Option<Expression>.some(this.mk_block_expr(ctor_stmts, new Option<Expression>.none()));
        cls.members.push(new Definition.function_def(ctor));

        // fun __gen_yield(mut this, v: T) {
        //     this.value = new Option<T>.some(v);
        //     this.resume = false;
        //     while (!this.resume) { __builtin._co_wait(); }
        // }
        let yf: mut FunctionDefinition = new FunctionDefinition("__gen_yield");
        let yf_this: Parameter = new Parameter("this");
        yf_this.is_this = true;
        yf_this.is_mutable = true;
        yf.parameters.push(yf_this);
        let yf_vp: Parameter = new Parameter("v");
        yf_vp.type_spec = new Option<TypeSpecifier>.some(this.spawn_type_spec(elem_bt));
        yf.parameters.push(yf_vp);
        let yf_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        let some_new: mut NewExpression = new NewExpression();
        some_new.type_name = "__builtin.Option.some";
        some_new.generic_args.push(this.spawn_type_spec(elem_bt));
        let some_args: mut _utils.List<Expression> = new _utils.List<Expression>();
        some_args.push(this.mk_ident_expr("v"));
        some_new.arguments = some_args;
        yf_stmts.push(this.mk_assign_stmt(this.mk_this_member("value"), new Expression.new_expr(some_new)));
        let f_lit: mut BoolLiteralExpression = new BoolLiteralExpression();
        f_lit.value = "false";
        yf_stmts.push(this.mk_assign_stmt(this.mk_this_member("resume"), new Expression.bool_literal(f_lit)));
        let notres: mut UnaryExpression = new UnaryExpression();
        notres.operator_value = new UnaryOperator.Not();
        notres.operand = new Option<Expression>.some(this.mk_this_member("resume"));
        let park_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        let park_es: mut ExpressionStatement = new ExpressionStatement();
        park_es.expression = new Option<Expression>.some(this.mk_park_call());
        park_es.location = loc;
        park_stmts.push(new Statement.expression(park_es));
        let yw: mut WhileExpression = new WhileExpression();
        yw.condition = new Option<Expression>.some(new Expression.unary(notres));
        yw.body = new Option<Expression>.some(this.mk_block_expr(park_stmts, new Option<Expression>.none()));
        let yws: mut BlockExpressionStatement = new BlockExpressionStatement();
        yws.expression = new Option<Expression>.some(new Expression.while_expr(yw));
        yws.location = loc;
        yf_stmts.push(new Statement.block_expr(yws));
        yf.body = new Option<Expression>.some(this.mk_block_expr(yf_stmts, new Option<Expression>.none()));
        cls.members.push(new Definition.function_def(yf));

        // fun __gen_finish(mut this, v: T) { value=some(v); done=true; }
        // fun __gen_finish_void(mut this) { done=true; }
        let ff: mut FunctionDefinition = new FunctionDefinition("__gen_finish");
        let ff_this: Parameter = new Parameter("this");
        ff_this.is_this = true;
        ff_this.is_mutable = true;
        ff.parameters.push(ff_this);
        let ff_vp: Parameter = new Parameter("v");
        ff_vp.type_spec = new Option<TypeSpecifier>.some(this.spawn_type_spec(elem_bt));
        ff.parameters.push(ff_vp);
        let ff_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        let fs_new: mut NewExpression = new NewExpression();
        fs_new.type_name = "__builtin.Option.some";
        fs_new.generic_args.push(this.spawn_type_spec(elem_bt));
        let fs_args: mut _utils.List<Expression> = new _utils.List<Expression>();
        fs_args.push(this.mk_ident_expr("v"));
        fs_new.arguments = fs_args;
        ff_stmts.push(this.mk_assign_stmt(this.mk_this_member("value"), new Expression.new_expr(fs_new)));
        let t_lit: mut BoolLiteralExpression = new BoolLiteralExpression();
        t_lit.value = "true";
        ff_stmts.push(this.mk_assign_stmt(this.mk_this_member("done"), new Expression.bool_literal(t_lit)));
        ff.body = new Option<Expression>.some(this.mk_block_expr(ff_stmts, new Option<Expression>.none()));
        cls.members.push(new Definition.function_def(ff));

        let fv: mut FunctionDefinition = new FunctionDefinition("__gen_finish_void");
        let fv_this: Parameter = new Parameter("this");
        fv_this.is_this = true;
        fv_this.is_mutable = true;
        fv.parameters.push(fv_this);
        let fv_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        let t_lit2: mut BoolLiteralExpression = new BoolLiteralExpression();
        t_lit2.value = "true";
        fv_stmts.push(this.mk_assign_stmt(this.mk_this_member("done"), new Expression.bool_literal(t_lit2)));
        fv.body = new Option<Expression>.some(this.mk_block_expr(fv_stmts, new Option<Expression>.none()));
        cls.members.push(new Definition.function_def(fv));

        // impl __builtin.__ICoroutineEntry { fun __enter(mut this) { <body> } }
        let enter_impl: mut InterfaceImplementation = new InterfaceImplementation("__ICoroutineEntry");
        let enter_ts: mut TypeSpecifier = new TypeSpecifier();
        enter_ts.qualified_parts.push("__builtin");
        enter_ts.name = "__ICoroutineEntry";
        enter_impl.type_spec = new Option<TypeSpecifier>.some(enter_ts);
        let enter_fun: mut FunctionDefinition = new FunctionDefinition("__enter");
        let enter_this: Parameter = new Parameter("this");
        enter_this.is_this = true;
        enter_this.is_mutable = true;
        enter_fun.parameters.push(enter_this);
        enter_fun.body = new Option<Expression>.some(new Expression.code_block(body_cb));
        enter_impl.functions.push(new Definition.function_def(enter_fun));
        cls.members.push(new Definition.impl_def(enter_impl));

        // impl __builtin.IGenerator<T> { fun next(mut this) -> Option<T> {
        //     if (!this.started) { this.started = true; __builtin._co_spawn_entry(this); }
        //     while (true) {
        //         if (this.value.is_some()) {
        //             let __ret = new Option<T>.some(this.value.some);
        //             this.value = new Option<T>.none();
        //             this.resume = true;
        //             return __ret;
        //         }
        //         if (this.done) { return new Option<T>.none(); }
        //         __builtin._co_wait();
        //     }
        // } }
        let next_impl: mut InterfaceImplementation = new InterfaceImplementation("IGenerator");
        let next_ts: mut TypeSpecifier = new TypeSpecifier();
        next_ts.qualified_parts.push("__builtin");
        next_ts.name = "IGenerator";
        next_ts.generic_args.push(this.spawn_type_spec(elem_bt));
        next_impl.type_spec = new Option<TypeSpecifier>.some(next_ts);
        let next_fun: mut FunctionDefinition = new FunctionDefinition("next");
        let next_this: Parameter = new Parameter("this");
        next_this.is_this = true;
        next_this.is_mutable = true;
        next_fun.parameters.push(next_this);
        let nret_ts: mut TypeSpecifier = new TypeSpecifier();
        nret_ts.qualified_parts.push("__builtin");
        nret_ts.name = "Option";
        nret_ts.generic_args.push(this.spawn_type_spec(elem_bt));
        next_fun.return_type = new Option<TypeSpecifier>.some(nret_ts);
        let nx_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        // if (!this.started) { started=true; spawn }
        let nstart: mut UnaryExpression = new UnaryExpression();
        nstart.operator_value = new UnaryOperator.Not();
        nstart.operand = new Option<Expression>.some(this.mk_this_member("started"));
        let spawn_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        let t_lit3: mut BoolLiteralExpression = new BoolLiteralExpression();
        t_lit3.value = "true";
        spawn_stmts.push(this.mk_assign_stmt(this.mk_this_member("started"), new Expression.bool_literal(t_lit3)));
        let sp_args: mut _utils.List<Expression> = new _utils.List<Expression>();
        // __builtin._co_spawn_entry(cast<mut __builtin.__ICoroutineEntry>(this));
        let entry_ts: mut TypeSpecifier = new TypeSpecifier();
        entry_ts.qualified_parts.push("__builtin");
        entry_ts.name = "__ICoroutineEntry";
        entry_ts.is_mutable = true;
        let entry_cast: mut CastExpression = new CastExpression();
        entry_cast.target_type = new Option<TypeSpecifier>.some(entry_ts);
        entry_cast.type_name = "__builtin.__ICoroutineEntry";
        entry_cast.inner = new Option<Expression>.some(this.mk_ident_expr("this"));
        sp_args.push(new Expression.cast_expr(entry_cast));
        let sp_call: Expression = this.mk_member_call_expr(this.mk_ident_expr("__builtin"), "_co_spawn_entry", sp_args);
        let sp_es: mut ExpressionStatement = new ExpressionStatement();
        sp_es.expression = new Option<Expression>.some(sp_call);
        sp_es.location = loc;
        spawn_stmts.push(new Statement.expression(sp_es));
        let spawn_blk: Expression = this.mk_block_expr(spawn_stmts, new Option<Expression>.none());
        let nif: mut IfStatement = new IfStatement();
        nif.condition = new Option<Expression>.some(new Expression.unary(nstart));
        nif.then_statement = new Option<Statement>.some(this.wrap_block(spawn_blk));
        nif.location = loc;
        nx_stmts.push(new Statement.if_stmt(nif));
        // while (true) { ... }
        let loop_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        let isom_args: mut _utils.List<Expression> = new _utils.List<Expression>();
        let isom_call: Expression = this.mk_member_call_expr(this.mk_this_member("value"), "is_some", isom_args);
        let take_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        let take_new: mut NewExpression = new NewExpression();
        take_new.type_name = "__builtin.Option.some";
        take_new.generic_args.push(this.spawn_type_spec(elem_bt));
        let take_args: mut _utils.List<Expression> = new _utils.List<Expression>();
        let vsome_ma: mut MemberAccessExpression = new MemberAccessExpression();
        vsome_ma.base_expr = new Option<Expression>.some(this.mk_this_member("value"));
        vsome_ma.member_name = "some";
        take_args.push(new Expression.member_access(vsome_ma));
        take_new.arguments = take_args;
        let take_let: mut LetDeclarationStatement = new LetDeclarationStatement();
        take_let.is_mutable = false;
        take_let.variable_name = "__ret";
        take_let.initializer = new Option<Expression>.some(new Expression.new_expr(take_new));
        take_let.location = loc;
        take_stmts.push(new Statement.let_decl(take_let));
        let clr_new: mut NewExpression = new NewExpression();
        clr_new.type_name = "__builtin.Option.none";
        clr_new.generic_args.push(this.spawn_type_spec(elem_bt));
        let clr_args: mut _utils.List<Expression> = new _utils.List<Expression>();
        clr_new.arguments = clr_args;
        take_stmts.push(this.mk_assign_stmt(this.mk_this_member("value"), new Expression.new_expr(clr_new)));
        let t_lit4: mut BoolLiteralExpression = new BoolLiteralExpression();
        t_lit4.value = "true";
        take_stmts.push(this.mk_assign_stmt(this.mk_this_member("resume"), new Expression.bool_literal(t_lit4)));
        let take_ret: mut ReturnStatement = new ReturnStatement();
        take_ret.value = new Option<Expression>.some(this.mk_ident_expr("__ret"));
        take_ret.location = loc;
        take_stmts.push(new Statement.return_stmt(take_ret));
        let isom_if: mut IfStatement = new IfStatement();
        isom_if.condition = new Option<Expression>.some(isom_call);
        isom_if.then_statement = new Option<Statement>.some(this.wrap_block(this.mk_block_expr(take_stmts, new Option<Expression>.none())));
        isom_if.location = loc;
        loop_stmts.push(new Statement.if_stmt(isom_if));
        // if (this.done) { return none; }
        let doneret_new: mut NewExpression = new NewExpression();
        doneret_new.type_name = "__builtin.Option.none";
        doneret_new.generic_args.push(this.spawn_type_spec(elem_bt));
        let doneret_args: mut _utils.List<Expression> = new _utils.List<Expression>();
        doneret_new.arguments = doneret_args;
        let done_ret: mut ReturnStatement = new ReturnStatement();
        done_ret.value = new Option<Expression>.some(new Expression.new_expr(doneret_new));
        done_ret.location = loc;
        let done_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        done_stmts.push(new Statement.return_stmt(done_ret));
        let done_if: mut IfStatement = new IfStatement();
        done_if.condition = new Option<Expression>.some(this.mk_this_member("done"));
        done_if.then_statement = new Option<Statement>.some(this.wrap_block(this.mk_block_expr(done_stmts, new Option<Expression>.none())));
        done_if.location = loc;
        loop_stmts.push(new Statement.if_stmt(done_if));
        // __builtin._co_wait();
        let park_es2: mut ExpressionStatement = new ExpressionStatement();
        park_es2.expression = new Option<Expression>.some(this.mk_park_call());
        park_es2.location = loc;
        loop_stmts.push(new Statement.expression(park_es2));
        let t_lit5: mut BoolLiteralExpression = new BoolLiteralExpression();
        t_lit5.value = "true";
        let nloop: mut WhileExpression = new WhileExpression();
        nloop.condition = new Option<Expression>.some(new Expression.bool_literal(t_lit5));
        nloop.body = new Option<Expression>.some(this.mk_block_expr(loop_stmts, new Option<Expression>.none()));
        let nloops: mut BlockExpressionStatement = new BlockExpressionStatement();
        nloops.expression = new Option<Expression>.some(new Expression.while_expr(nloop));
        nloops.location = loc;
        nx_stmts.push(new Statement.block_expr(nloops));
        next_fun.body = new Option<Expression>.some(this.mk_block_expr(nx_stmts, new Option<Expression>.none()));
        next_impl.functions.push(new Definition.function_def(next_fun));
        cls.members.push(new Definition.impl_def(next_impl));

        // 4) the IGenerator<T> and Option<T> instantiations are referenced
        // only by pass-8-synthesized code (invisible to the pass-3 fixpoint) —
        // ensure their specs are created, resolved AND registered, or the
        // emitter finds no layout and lowers every slot to a default scalar
        // (an unregistered Option<T> made every value/next signature i64).
        this.gen_ensure_builtin_spec("IGenerator", elem_bt, func_scope);
        this.gen_ensure_builtin_spec("Option", elem_bt, func_scope);

        // 5) register the ctx class (spawn pattern)
        let def_scope: mut BoundScope = this.enclosing_def_scope(func_scope);
        let cls_ast: Definition = new Definition.class_def(cls);
        let bound_cls: Option<BoundDefinition> = m.build_scopes_pass.bind_definition(cls_ast, def_scope);
        if (bound_cls.is_none()) { return new Option<Expression>.none(); }
        let saved_pass: i64 = m.current_pass_index;
        m.current_pass_index = 2;
        let resolved: BoundDefinition = m.resolve_types_pass.resolve_pair(cls_ast, bound_cls.some, def_scope);
        m.current_pass_index = saved_pass;
        if (m.current_unit.is_none()) {
            m.report_error(new ErrorCode.E_INTERNAL(), "generator outside a compilation unit", loc);
            return new Option<Expression>.none();
        }
        let unit_ref: mut BoundCompilationUnit = m.current_unit.some;
        unit_ref.definitions.push(resolved);
        m.catch_up_def_before_bodies(resolved, unit_ref);

        // 6) the function's replacement body:
        //    { let __gen = new __GenCtx_<n>(<params...>);
        //      return cast<IGenerator<T>>(__gen); }
        let wrap_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        let gnew: mut NewExpression = new NewExpression();
        gnew.type_name = ctx_name;
        let gnew_args: mut _utils.List<Expression> = new _utils.List<Expression>();
        let wi: mut i64 = 0;
        while (wi < cast<i64>(a.names.size())) {
            gnew_args.push(this.mk_ident_expr(a.names.at(cast<u64>(wi)).some));
            wi = wi + 1;
        }
        gnew.arguments = gnew_args;
        let glet: mut LetDeclarationStatement = new LetDeclarationStatement();
        glet.is_mutable = false;
        glet.variable_name = "__gen";
        glet.initializer = new Option<Expression>.some(new Expression.new_expr(gnew));
        glet.location = loc;
        wrap_stmts.push(new Statement.let_decl(glet));
        let gcast_ts: mut TypeSpecifier = new TypeSpecifier();
        gcast_ts.qualified_parts.push("__builtin");
        gcast_ts.name = "IGenerator";
        gcast_ts.generic_args.push(this.spawn_type_spec(elem_bt));
        // Mirror the declared return mutability (`-> mut IGenerator<T>` and the
        // immutable form both occur in source).
        gcast_ts.is_mutable = bound_func.return_type.mutability is Mutability.Mutable;
        let gcast: mut CastExpression = new CastExpression();
        gcast.target_type = new Option<TypeSpecifier>.some(gcast_ts);
        gcast.type_name = "IGenerator";
        gcast.inner = new Option<Expression>.some(this.mk_ident_expr("__gen"));
        let gret: mut ReturnStatement = new ReturnStatement();
        gret.value = new Option<Expression>.some(new Expression.cast_expr(gcast));
        gret.location = loc;
        wrap_stmts.push(new Statement.return_stmt(gret));
        return new Option<Expression>.some(this.mk_block_expr(wrap_stmts, new Option<Expression>.none()));
    }

    // Wrap a code-block EXPRESSION into a block STATEMENT (if/while body slots
    // take Statement, not Expression).
    fun wrap_block(mut this, blk: Expression) -> Statement {
        let bes: mut BlockExpressionStatement = new BlockExpressionStatement();
        bes.expression = new Option<Expression>.some(blk);
        bes.location = new SourceLocation("", 0, 0);
        return new Statement.block_expr(bes);
    }

    // Ensure a __builtin generic's <elem> specialization exists AND is
    // emitted: pass-8-synthesized references are invisible to the pass-3
    // fixpoint, and a spec that resolve creates without registration leaves
    // the emitter without a layout (every use then lowers to a default
    // scalar). Protocol mirrors ensure_generic_iface_spec: create, resolve at
    // pass index 3 (resolving at 8 would stamp the def fully-processed and
    // skip vtables/classification), then signature-level catch-up + push.
    fun gen_ensure_builtin_spec(mut this, short: string, elem_bt: BoundType, scope: mut BoundScope) {
        let m: mut SemanticModel = this.model.some;
        let ts: mut TypeSpecifier = new TypeSpecifier();
        ts.qualified_parts.push("__builtin");
        ts.name = short;
        ts.generic_args.push(this.spawn_type_spec(elem_bt));
        let bt: BoundType = m.resolve_type_specifier(ts, scope);
        if (bt.type_definition.is_none()) { return; }
        let td: BoundDefinition = bt.type_definition.some;
        let full_base: mut string = "";
        let nparams: mut i64 = 0;
        if (td is BoundDefinition.interface_def) {
            full_base = td.interface_def.full_name;
            nparams = cast<i64>(td.interface_def.generic_params.size());
        }
        if (td is BoundDefinition.enum_def) {
            full_base = td.enum_def.full_name;
            nparams = cast<i64>(td.enum_def.generic_params.size());
        }
        if (nparams == 0 || cast<i64>(bt.generic_args.size()) == 0) { return; }
        let mangled: string = MonomorphizePass.mangle_generic_name(full_base, bt.generic_args);
        if (m.global_scope.lookup_type_in_scope(mangled).is_some()) { return; }
        let spec: Option<BoundDefinition> = m.monomorphize_pass.ensure_specialized_def(bt, m.global_scope);
        if (spec.is_none()) { return; }
        if (m.current_unit.is_none()) { return; }
        let ast_spec: Option<Definition> = m.monomorphize_pass.find_ast_def_by_name(m.ast_definitions, short);
        let saved_idx: i64 = m.current_pass_index;
        if (ast_spec.is_some()) {
            m.current_pass_index = 3;
            let resolved_def: BoundDefinition = m.resolve_types_pass.resolve_pair(ast_spec.some, spec.some, this.spec_resolve_scope(spec.some));
            m.current_pass_index = saved_idx;
            m.catch_up_def_before_bodies(resolved_def, m.current_unit.some);
            m.current_unit.some.definitions.push(resolved_def);
        } else {
            m.catch_up_def_before_bodies(spec.some, m.current_unit.some);
            m.current_unit.some.definitions.push(spec.some);
        }
    }

    fun bind_spawn_async(mut this, expr: SpawnAsyncExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        let m: mut SemanticModel = this.model.some;
        let loc: SourceLocation = new SourceLocation("", 0, 0);
        if (!m.require_coroutine("'async' expression", loc)) {
            return new Option<BoundExpression>.none();
        }
        m.has_suspension = true;
        if (expr.expression.is_none()) {
            m.report_error(new ErrorCode.E_ASYNC_INVALID(), "'async' requires a function call", loc);
            return new Option<BoundExpression>.none();
        }
        let inner: Expression = expr.expression.some;
        if (!(inner is Expression.function_call)) {
            m.report_error(new ErrorCode.E_ASYNC_INVALID(), "'async' requires a function call", loc);
            return new Option<BoundExpression>.none();
        }
        let fc: FunctionCallExpression = inner.function_call;
        if (fc.callee.is_none()) {
            m.report_error(new ErrorCode.E_ASYNC_INVALID(), "'async' requires a callee", loc);
            return new Option<BoundExpression>.none();
        }
        let is_member: bool = fc.callee.some is Expression.member_access;

        // Indirect spawn: `async f(args)` where f is a local/param fun value.
        // The ctx captures the callable into a `__fn` field and __enter calls
        // through it (the fun-field call path). Plain member callees keep the
        // receiver capture (a bound ref `async x.m(a)` is equivalent to the
        // synthesized `this.__recv.m(a)`).
        let is_indirect_fun: mut bool = false;
        let indirect_fun_bt: mut Option<BoundType> = new Option<BoundType>.none();
        if (!is_member && fc.callee.some is Expression.identifier) {
            let cid: IdentifierExpression = fc.callee.some.identifier;
            let cs: Option<BoundSymbol> = scope.lookup_symbol(cid.name);
            if (cs.is_some() && cs.some is BoundSymbol.variable
                && cs.some.variable.bound_type.kind is TypeKind.FunctionKind) {
                is_indirect_fun = true;
                indirect_fun_bt = new Option<BoundType>.some(cs.some.variable.bound_type);
            }
        }

        // Probe: bind the whole call once (compile-time) to learn the return
        // type and argument types. The moved AST nodes are bound again inside
        // the synthesized code below; identical argument types resolve to the
        // same specializations, so nothing doubles at runtime.
        let probe: Option<BoundExpression> = this.bind_expression(inner, scope);
        if (probe.is_none()) { return new Option<BoundExpression>.none(); }
        let ret_bt: BoundType = probe.some.get_bound_type();
        let arg_bts: mut _utils.List<BoundType> = new _utils.List<BoundType>();
        if (probe.some is BoundExpression.function_call) {
            let ai: mut i64 = 0;
            while (ai < cast<i64>(probe.some.function_call.arguments.size())) {
                arg_bts.push(probe.some.function_call.arguments.at(cast<u64>(ai)).some.get_bound_type());
                ai = ai + 1;
            }
            // Prefer the callee's DECLARED parameter types: a bare literal
            // binds as i64 standalone but coerces to the parameter type at a
            // direct call — the ctx field must carry the declared type so
            // __enter's call type-checks.
            let pc: BoundFunctionCallExpression = probe.some.function_call;
            if (pc.callee_symbol.is_some() && pc.callee_symbol.some is BoundSymbol.function_sym) {
                let fsym: BoundFunctionSymbol = pc.callee_symbol.some.function_sym;
                let skip: i64 = if (is_member) { 1 } else { 0 };
                if (cast<i64>(fsym.parameters.size()) == cast<i64>(arg_bts.size()) + skip) {
                    let rewritten: mut _utils.List<BoundType> = new _utils.List<BoundType>();
                    let pi: mut i64 = 0;
                    while (pi < cast<i64>(arg_bts.size())) {
                        let param_bt: BoundType = fsym.parameters.at(cast<u64>(pi + skip)).some.bound_type;
                        let arg_bt: BoundType = arg_bts.at(cast<u64>(pi)).some;
                        // Only trust the declaration for PRIMITIVE mismatches
                        // (literal coercions); keep inferred types elsewhere.
                        if (param_bt.kind is TypeKind.PrimitiveKind && arg_bt.kind is TypeKind.PrimitiveKind) {
                            rewritten.push(param_bt);
                        } else {
                            rewritten.push(arg_bt);
                        }
                        pi = pi + 1;
                    }
                    arg_bts = rewritten;
                }
            }
        }
        let recv_bt: mut Option<BoundType> = new Option<BoundType>.none();
        if (is_member) {
            let ma: MemberAccessExpression = fc.callee.some.member_access;
            if (ma.base_expr.is_none()) {
                m.report_error(new ErrorCode.E_ASYNC_INVALID(), "'async' requires a callee", loc);
                return new Option<BoundExpression>.none();
            }
            let probe_recv: Option<BoundExpression> = this.bind_expression(ma.base_expr.some, scope);
            if (probe_recv.is_none()) { return new Option<BoundExpression>.none(); }
            recv_bt = new Option<BoundType>.some(probe_recv.some.get_bound_type());
            // Static interface-impl calls (`Type.member(...)`) have no receiver
            // value to capture — not spawnable in v1.
            if (recv_bt.some.kind is TypeKind.ErrorKind) {
                m.report_error(new ErrorCode.E_ASYNC_INVALID(),
                    "'async' cannot spawn a static member call -- wrap it in a local function", loc);
                return new Option<BoundExpression>.none();
            }
        }
        let is_void: bool = ret_bt.kind is TypeKind.PrimitiveKind && ret_bt.primitive is PrimitiveType.VoidType;

        m.spawn_site_counter = m.spawn_site_counter + 1;
        let n: i64 = m.spawn_site_counter;
        let ctx_name: string = "__SpawnCtx_" + cast<string>(n);
        let fut_cls_name: string = "__SpawnFut_" + cast<string>(n);

        // ---- synthesize the ctx class AST ----
        let cls: mut ClassDefinition = new ClassDefinition(ctx_name);
        cls.location = loc;
        cls.source_file = "<spawn>";

        let enter_fun: mut FunctionDefinition = new FunctionDefinition("__enter");
        let this_param: Parameter = new Parameter("this");
        this_param.is_this = true;
        this_param.is_mutable = true;
        enter_fun.parameters.push(this_param);

        // fields: receiver (member calls), args, future
        let arg_names: mut _utils.List<string> = new _utils.List<string>();
        let ai2: mut i64 = 0;
        while (ai2 < cast<i64>(arg_bts.size())) {
            let an: string = "a" + cast<string>(ai2);
            arg_names.push(an);
            let fd: mut ClassFieldDefinition = new ClassFieldDefinition(an);
            fd.type_spec = new Option<TypeSpecifier>.some(this.spawn_type_spec(arg_bts.at(cast<u64>(ai2)).some));
            fd.location = loc;
            cls.members.push(new Definition.class_field(fd));
            ai2 = ai2 + 1;
        }
        if (is_member) {
            let recv_field: mut ClassFieldDefinition = new ClassFieldDefinition("__recv");
            recv_field.type_spec = new Option<TypeSpecifier>.some(this.spawn_type_spec(recv_bt.some));
            recv_field.location = loc;
            cls.members.push(new Definition.class_field(recv_field));
        }
        if (is_indirect_fun) {
            let fn_field: mut ClassFieldDefinition = new ClassFieldDefinition("__fn");
            fn_field.type_spec = new Option<TypeSpecifier>.some(this.spawn_type_spec(indirect_fun_bt.some));
            fn_field.location = loc;
            cls.members.push(new Definition.class_field(fn_field));
        }
        // fut: mut __SpawnFut_<n>  (or __builtin.__SpawnUnitFuture for void)
        let fut_field: mut ClassFieldDefinition = new ClassFieldDefinition("fut");
        let fut_ts: mut TypeSpecifier = new TypeSpecifier();
        if (is_void) {
            fut_ts.qualified_parts.push("__builtin");
            fut_ts.name = "__SpawnUnitFuture";
        } else {
            fut_ts.name = fut_cls_name;
        }
        fut_ts.is_mutable = true;
        fut_field.type_spec = new Option<TypeSpecifier>.some(fut_ts);
        fut_field.location = loc;
        cls.members.push(new Definition.class_field(fut_field));

        // impl __builtin.__ICoroutineEntry { fun __enter(mut this) { ... } }
        let enter_impl: mut InterfaceImplementation = new InterfaceImplementation("__ICoroutineEntry");
        let enter_ts: mut TypeSpecifier = new TypeSpecifier();
        enter_ts.qualified_parts.push("__builtin");
        enter_ts.name = "__ICoroutineEntry";
        enter_impl.type_spec = new Option<TypeSpecifier>.some(enter_ts);
        let enter_body_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        // the call inside __enter: <f | this.__recv.m>(this.a0, ...)
        let inner_call: mut FunctionCallExpression = new FunctionCallExpression();
        if (is_member) {
            let orig_ma: MemberAccessExpression = fc.callee.some.member_access;
            let recv_ma: MemberAccessExpression = new MemberAccessExpression();
            recv_ma.base_expr = new Option<Expression>.some(this.mk_this_member("__recv"));
            recv_ma.member_name = orig_ma.member_name;
            let gi: mut i64 = 0;
            while (gi < cast<i64>(orig_ma.generic_args.size())) {
                recv_ma.generic_args.push(orig_ma.generic_args.at(cast<u64>(gi)).some);
                gi = gi + 1;
            }
            inner_call.callee = new Option<Expression>.some(new Expression.member_access(recv_ma));
        } else {
            if (is_indirect_fun) {
                inner_call.callee = new Option<Expression>.some(this.mk_this_member("__fn"));
            } else {
                inner_call.callee = fc.callee;
            }
        }
        let xi: mut i64 = 0;
        while (xi < cast<i64>(arg_names.size())) {
            inner_call.arguments.push(this.mk_this_member(arg_names.at(cast<u64>(xi)).some));
            xi = xi + 1;
        }
        // this.fut.complete(<call>) / this.fut.complete_unit(<call>)
        let fut_access: Expression = this.mk_this_member("fut");
        let complete_ma: MemberAccessExpression = new MemberAccessExpression();
        complete_ma.base_expr = new Option<Expression>.some(fut_access);
        if (is_void) {
            complete_ma.member_name = "complete_unit";
        } else {
            complete_ma.member_name = "complete";
        }
        let complete_fc: FunctionCallExpression = new FunctionCallExpression();
        complete_fc.callee = new Option<Expression>.some(new Expression.member_access(complete_ma));
        if (is_void) {
            // void spawn: evaluate the call, discard, then mark done
            let void_call_stmt: mut ExpressionStatement = new ExpressionStatement();
            void_call_stmt.expression = new Option<Expression>.some(new Expression.function_call(inner_call));
            void_call_stmt.location = loc;
            enter_body_stmts.push(new Statement.expression(void_call_stmt));
            let unit_args: mut _utils.List<Expression> = new _utils.List<Expression>();
            let unit_call: Expression = this.mk_member_call_expr(fut_access, "complete_unit", unit_args);
            let unit_stmt: mut ExpressionStatement = new ExpressionStatement();
            unit_stmt.expression = new Option<Expression>.some(unit_call);
            unit_stmt.location = loc;
            enter_body_stmts.push(new Statement.expression(unit_stmt));
        } else {
            complete_fc.arguments.push(new Expression.function_call(inner_call));
            let cs: mut ExpressionStatement = new ExpressionStatement();
            cs.expression = new Option<Expression>.some(new Expression.function_call(complete_fc));
            cs.location = loc;
            enter_body_stmts.push(new Statement.expression(cs));
        }
        let enter_block: Expression = this.mk_block_expr(enter_body_stmts, new Option<Expression>.none());
        enter_fun.body = new Option<Expression>.some(enter_block);
        enter_impl.functions.push(new Definition.function_def(enter_fun));
        cls.members.push(new Definition.impl_def(enter_impl));

        // ---- synthesize the per-site future class (non-generic: R spelled
        // out — avoids on-demand generic instantiation for synthesized ASTs,
        // which the pass-3 fixpoint cannot see) ----
        let fut_cls: mut ClassDefinition = new ClassDefinition(fut_cls_name);
        if (!is_void) {
            fut_cls.location = loc;
            fut_cls.source_file = "<spawn>";
            // done: mut bool = false;
            let done_field: mut ClassFieldDefinition = new ClassFieldDefinition("done");
            let bool_ts: mut TypeSpecifier = new TypeSpecifier();
            bool_ts.name = "bool";
            bool_ts.is_mutable = true;
            done_field.type_spec = new Option<TypeSpecifier>.some(bool_ts);
            let false_lit: mut BoolLiteralExpression = new BoolLiteralExpression();
            false_lit.value = "false";
            done_field.initializer = new Option<Expression>.some(new Expression.bool_literal(false_lit));
            done_field.location = loc;
            fut_cls.members.push(new Definition.class_field(done_field));
            // result: <R>;
            let res_field: mut ClassFieldDefinition = new ClassFieldDefinition("result");
            res_field.type_spec = new Option<TypeSpecifier>.some(this.spawn_type_spec(ret_bt));
            res_field.location = loc;
            fut_cls.members.push(new Definition.class_field(res_field));
            // fun complete(mut this, v: <R>) { this.result = v; this.done = true; }
            let complete_fun: mut FunctionDefinition = new FunctionDefinition("complete");
            let complete_this: Parameter = new Parameter("this");
            complete_this.is_this = true;
            complete_this.is_mutable = true;
            complete_fun.parameters.push(complete_this);
            let v_param: Parameter = new Parameter("v");
            v_param.type_spec = new Option<TypeSpecifier>.some(this.spawn_type_spec(ret_bt));
            complete_fun.parameters.push(v_param);
            let complete_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
            complete_stmts.push(this.mk_assign_stmt(this.mk_this_member("result"), this.mk_ident_expr("v")));
            let true_lit: mut BoolLiteralExpression = new BoolLiteralExpression();
            true_lit.value = "true";
            complete_stmts.push(this.mk_assign_stmt(this.mk_this_member("done"), new Expression.bool_literal(true_lit)));
            complete_fun.body = new Option<Expression>.some(this.mk_block_expr(complete_stmts, new Option<Expression>.none()));
            fut_cls.members.push(new Definition.function_def(complete_fun));
            // impl __builtin.IFuture<R> { fun poll(this) -> mut FutureState<R> { ... } }
            let poll_impl: mut InterfaceImplementation = new InterfaceImplementation("IFuture");
            let poll_ts: mut TypeSpecifier = new TypeSpecifier();
            poll_ts.qualified_parts.push("__builtin");
            poll_ts.name = "IFuture";
            poll_ts.generic_args.push(this.spawn_type_spec(ret_bt));
            poll_impl.type_spec = new Option<TypeSpecifier>.some(poll_ts);
            let poll_fun: mut FunctionDefinition = new FunctionDefinition("poll");
            let poll_this: Parameter = new Parameter("this");
            poll_this.is_this = true;
            poll_fun.parameters.push(poll_this);
            let poll_ret: mut TypeSpecifier = new TypeSpecifier();
            poll_ret.qualified_parts.push("__builtin");
            poll_ret.name = "FutureState";
            poll_ret.generic_args.push(this.spawn_type_spec(ret_bt));
            poll_ret.is_mutable = true;
            poll_fun.return_type = new Option<TypeSpecifier>.some(poll_ret);
            let poll_stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
            // if (this.done) { return new __builtin.FutureState<R>.ready_finished(this.result); }
            // return new __builtin.FutureState<R>.not_ready();
            let ready_new: mut NewExpression = new NewExpression();
            ready_new.type_name = "__builtin.FutureState.ready_finished";
            ready_new.generic_args.push(this.spawn_type_spec(ret_bt));
            ready_new.arguments.push(this.mk_this_member("result"));
            let ready_ret: mut ReturnStatement = new ReturnStatement();
            ready_ret.value = new Option<Expression>.some(new Expression.new_expr(ready_new));
            ready_ret.location = loc;
            let notready_new: mut NewExpression = new NewExpression();
            notready_new.type_name = "__builtin.FutureState.not_ready";
            notready_new.generic_args.push(this.spawn_type_spec(ret_bt));
            let notready_args: mut _utils.List<Expression> = new _utils.List<Expression>();
            notready_new.arguments = notready_args;
            let notready_ret: mut ReturnStatement = new ReturnStatement();
            notready_ret.value = new Option<Expression>.some(new Expression.new_expr(notready_new));
            notready_ret.location = loc;
            let if_done: mut IfStatement = new IfStatement();
            if_done.condition = new Option<Expression>.some(this.mk_this_member("done"));
            if_done.then_statement = new Option<Statement>.some(new Statement.return_stmt(ready_ret));
            if_done.location = loc;
            poll_stmts.push(new Statement.if_stmt(if_done));
            poll_stmts.push(new Statement.return_stmt(notready_ret));
            poll_fun.body = new Option<Expression>.some(this.mk_block_expr(poll_stmts, new Option<Expression>.none()));
            poll_impl.functions.push(new Definition.function_def(poll_fun));
            fut_cls.members.push(new Definition.impl_def(poll_impl));
        }

        // ---- bind the classes into the site's enclosing namespace, resolve
        // their types, append to the unit, and catch them up through the
        // passes ----
        let def_scope: mut BoundScope = this.enclosing_def_scope(scope);
        if (!is_void) {
            // The IFuture<R> specialization (the future class's vtable slots
            // and every wait on the future resolve through it) is invisible to
            // the pass-3 fixpoint — create it on demand first.
            let ifut_args: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
            ifut_args.push(make_type_arg(ret_bt));
            let ifut_mangled: string = MonomorphizePass.mangle_generic_name("__builtin.IFuture", ifut_args);
            if (m.global_scope.lookup_type_in_scope(ifut_mangled).is_none()) {
                let ifut_parts: mut _utils.List<string> = new _utils.List<string>();
                ifut_parts.push("__builtin");
                ifut_parts.push("IFuture");
                let ifut_sym: Option<BoundSymbol> = m.global_scope.resolve_qualified(ifut_parts);
                if (ifut_sym.is_some() && ifut_sym.some is BoundSymbol.type_sym) {
                    let ifut_inst: BoundType = ifut_sym.some.type_sym.bound_type.with_generic_args(ifut_args);
                    let ifut_spec: Option<BoundDefinition> = m.monomorphize_pass.ensure_specialized_def(ifut_inst, m.global_scope);
                    if (ifut_spec.is_some() && m.current_unit.is_some()) {
                        let unit_ref9: mut BoundCompilationUnit = m.current_unit.some;
                        unit_ref9.definitions.push(ifut_spec.some);
                        m.catch_up_def_before_bodies(ifut_spec.some, unit_ref9);
                    }
                }
            }
        }
        if (!is_void) {
            let fut_cls_ast: Definition = new Definition.class_def(fut_cls);
            let bound_fut: Option<BoundDefinition> = m.build_scopes_pass.bind_definition(fut_cls_ast, def_scope);
            if (bound_fut.is_none()) { return new Option<BoundExpression>.none(); }
            let saved_fut_pass: i64 = m.current_pass_index;
            m.current_pass_index = 2;
            let resolved_fut: BoundDefinition = m.resolve_types_pass.resolve_pair(fut_cls_ast, bound_fut.some, def_scope);
            m.current_pass_index = saved_fut_pass;
            if (m.current_unit.is_some()) {
                let unit_ref0: mut BoundCompilationUnit = m.current_unit.some;
                unit_ref0.definitions.push(resolved_fut);
                m.catch_up_def_before_bodies(resolved_fut, unit_ref0);
            }
        }
        let cls_ast: Definition = new Definition.class_def(cls);
        let bound_cls: Option<BoundDefinition> = m.build_scopes_pass.bind_definition(cls_ast, def_scope);
        if (bound_cls.is_none()) { return new Option<BoundExpression>.none(); }
        let saved_pass: i64 = m.current_pass_index;
        m.current_pass_index = 2;
        let resolved: BoundDefinition = m.resolve_types_pass.resolve_pair(cls_ast, bound_cls.some, def_scope);
        m.current_pass_index = saved_pass;
        if (m.current_unit.is_some()) {
            let unit_ref: mut BoundCompilationUnit = m.current_unit.some;
            unit_ref.definitions.push(resolved);
            m.catch_up_def_before_bodies(resolved, unit_ref);
        } else {
            m.report_error(new ErrorCode.E_INTERNAL(), "spawn outside a compilation unit", loc);
            return new Option<BoundExpression>.none();
        }

        // ---- build and bind the site block ----
        // { let __s = new __SpawnCtx_<n>(); __s.__recv = <recv>; __s.a0 = <a0>; ...
        //   __s.fut = new __builtin.__SpawnFuture<R>();
        //   __builtin._co_spawn_entry(__s); __s.fut }
        let stmts: mut _utils.List<Statement> = new _utils.List<Statement>();
        let s_name: string = "__s";
        let new_ts: mut TypeSpecifier = new TypeSpecifier();
        new_ts.name = ctx_name;
        let new_expr: mut NewExpression = new NewExpression();
        new_expr.type_name = ctx_name;
        let new_args: mut _utils.List<Expression> = new _utils.List<Expression>();
        new_expr.arguments = new_args;
        let let_s: mut LetDeclarationStatement = new LetDeclarationStatement();
        let_s.is_mutable = false;
        let_s.variable_name = s_name;
        let_s.initializer = new Option<Expression>.some(new Expression.new_expr(new_expr));
        let_s.location = loc;
        stmts.push(new Statement.let_decl(let_s));
        // receiver assignment first (natural evaluation order)
        if (is_member) {
            let orig_ma2: MemberAccessExpression = fc.callee.some.member_access;
            let target_ma: MemberAccessExpression = new MemberAccessExpression();
            target_ma.base_expr = new Option<Expression>.some(this.mk_ident_expr(s_name));
            target_ma.member_name = "__recv";
            stmts.push(this.mk_assign_stmt(new Expression.member_access(target_ma), orig_ma2.base_expr.some));
        }
        if (is_indirect_fun) {
            let fn_target: MemberAccessExpression = new MemberAccessExpression();
            fn_target.base_expr = new Option<Expression>.some(this.mk_ident_expr(s_name));
            fn_target.member_name = "__fn";
            stmts.push(this.mk_assign_stmt(new Expression.member_access(fn_target), fc.callee.some));
        }
        // arg assignments
        let yi: mut i64 = 0;
        while (yi < cast<i64>(arg_names.size())) {
            let arg_ma: MemberAccessExpression = new MemberAccessExpression();
            arg_ma.base_expr = new Option<Expression>.some(this.mk_ident_expr(s_name));
            arg_ma.member_name = arg_names.at(cast<u64>(yi)).some;
            stmts.push(this.mk_assign_stmt(new Expression.member_access(arg_ma), fc.arguments.at(cast<u64>(yi)).some));
            yi = yi + 1;
        }
        // __s.fut = new __SpawnFut_<n>()  (or __builtin.__SpawnUnitFuture);
        let fut_new: mut NewExpression = new NewExpression();
        if (is_void) {
            fut_new.type_name = "__builtin.__SpawnUnitFuture";
        } else {
            fut_new.type_name = fut_cls_name;
        }
        let fut_new_args: mut _utils.List<Expression> = new _utils.List<Expression>();
        fut_new.arguments = fut_new_args;
        let fut_target: MemberAccessExpression = new MemberAccessExpression();
        fut_target.base_expr = new Option<Expression>.some(this.mk_ident_expr(s_name));
        fut_target.member_name = "fut";
        stmts.push(this.mk_assign_stmt(new Expression.member_access(fut_target), new Expression.new_expr(fut_new)));
        // __builtin._co_spawn_entry(cast<mut __builtin.__ICoroutineEntry>(__s));
        let entry_ts: mut TypeSpecifier = new TypeSpecifier();
        entry_ts.qualified_parts.push("__builtin");
        entry_ts.name = "__ICoroutineEntry";
        entry_ts.is_mutable = true;
        let entry_cast: mut CastExpression = new CastExpression();
        entry_cast.target_type = new Option<TypeSpecifier>.some(entry_ts);
        entry_cast.type_name = "__builtin.__ICoroutineEntry";
        entry_cast.inner = new Option<Expression>.some(this.mk_ident_expr(s_name));
        let spawn_args: mut _utils.List<Expression> = new _utils.List<Expression>();
        spawn_args.push(new Expression.cast_expr(entry_cast));
        let spawn_call: Expression = this.mk_builtin_call("_co_spawn_entry", spawn_args);
        let spawn_stmt: mut ExpressionStatement = new ExpressionStatement();
        spawn_stmt.expression = new Option<Expression>.some(spawn_call);
        spawn_stmt.location = loc;
        stmts.push(new Statement.expression(spawn_stmt));
        // trailing: __s.fut
        let trailing: MemberAccessExpression = new MemberAccessExpression();
        trailing.base_expr = new Option<Expression>.some(this.mk_ident_expr(s_name));
        trailing.member_name = "fut";
        return this.bind_expression(this.mk_block_expr(stmts, new Option<Expression>.some(new Expression.member_access(trailing))), scope);
    }

    fun mk_member_call_expr(this, base: Expression, member: string, args: mut _utils.List<Expression>) -> Expression {
        let ma: MemberAccessExpression = new MemberAccessExpression();
        ma.base_expr = new Option<Expression>.some(base);
        ma.member_name = member;
        let fc: FunctionCallExpression = new FunctionCallExpression();
        fc.callee = new Option<Expression>.some(new Expression.member_access(ma));
        let i: mut i64 = 0;
        while (i < cast<i64>(args.size())) {
            fc.arguments.push(args.at(cast<u64>(i)).some);
            i = i + 1;
        }
        return new Expression.function_call(fc);
    }


    fun bind_constant(mut this, expr: ConstantExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_constant");
        // Float literals (value contains '.' or 'e'/'E', optionally after a
        // leading '-', e.g. "3.5", "1e5", "-2.5") bind as f64 with FloatLiteral
        // kind; everything else defaults to i64 + IntegerLiteral. Previously
        // every numeric literal bound as i64, so the operand of `-3.5` was an
        // i64 literal with value "3.5" — the IR emitted `add i64 0, 3.5`
        // (float value in an i64 register) which clang rejected. Binding the
        // float literal as f64 makes unary neg emit `fsub double 0.0, 3.5`
        // (LLVMEmitter.emit_unaryop already dispatches on is_float_type).
        let value: string = expr.value;
        // A char literal ('a', '\n') binds as its integer code point. The
        // quoted token text must never flow into the IR as-is ("add i32 0,
        // 'a'" is invalid LLVM), and the float-shape test below would even
        // misread 'e' as a float literal. Char contexts accept the i64 via
        // the ordinary numeric implicit cast.
        if (string_length(value) >= 3 && string_char_code_at(value, 0) == 39 && string_char_code_at(value, string_length(value) - 1) == 39) {
            let ch_code: i64 = this.char_literal_code(value);
            let bt_ch: BoundType = this.model.some.type_registry.resolve_type("i64").some;
            let lit_ch: mut BoundLiteralExpression = new BoundLiteralExpression(cast<string>(ch_code), bt_ch, new LiteralKind.IntegerLiteral());
            return new Option<BoundExpression>.some(new BoundExpression.literal(lit_ch));
        }
        if (string_find(value, ".") >= 0 || string_find(value, "e") >= 0 || string_find(value, "E") >= 0) {
            let bt: BoundType = this.model.some.type_registry.resolve_type("f64").some;
            let result: mut BoundLiteralExpression = new BoundLiteralExpression(value, bt, new LiteralKind.FloatLiteral());
            return new Option<BoundExpression>.some(new BoundExpression.literal(result));
        }
        let bt: BoundType = this.model.some.type_registry.resolve_type("i64").some;
        let result: mut BoundLiteralExpression = new BoundLiteralExpression(expr.value, bt, new LiteralKind.IntegerLiteral());
        return new Option<BoundExpression>.some(new BoundExpression.literal(result));
    }


    // The code point of a char literal's payload. `value` is the raw token
    // text INCLUDING the single quotes; escape sequences ('\n', '\t', '\r',
    // '\0', '\\', '\'', '\"') fold to their character, an unknown escape
    // yields the escaped character itself. Comparisons are on char codes —
    // the lexer/codebase idiom.
    fun char_literal_code(mut this, value: string) -> i64 {
        let inner: string = string_substring(value, 1, string_length(value) - 2);
        if (string_length(inner) >= 2 && string_char_code_at(inner, 0) == 92) {
            let esc: i64 = string_char_code_at(inner, 1);
            if (esc == 110) { return 10; }
            if (esc == 116) { return 9; }
            if (esc == 114) { return 13; }
            if (esc == 48) { return 0; }
            if (esc == 92) { return 92; }
            if (esc == 39) { return 39; }
            if (esc == 34) { return 34; }
            return esc;
        }
        return string_char_code_at(inner, 0);
    }

    fun bind_string_literal(mut this, expr: StringLiteralExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_string_literal");
        let bt: BoundType = this.model.some.type_registry.resolve_type("string").some;
        let result: mut BoundLiteralExpression = new BoundLiteralExpression(expr.value, bt, new LiteralKind.StringLiteral());
        return new Option<BoundExpression>.some(new BoundExpression.literal(result));
    }


    fun bind_bool_literal(mut this, expr: BoolLiteralExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_bool_literal");
        let bt: BoundType = this.model.some.type_registry.resolve_type("bool").some;
        let result: mut BoundLiteralExpression = new BoundLiteralExpression(expr.value, bt, new LiteralKind.BoolLiteral());
        return new Option<BoundExpression>.some(new BoundExpression.literal(result));
    }


    fun bind_void_literal(mut this, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_void_literal");
        let result: mut BoundLiteralExpression = new BoundLiteralExpression("void", this.model.some.type_registry.void_type, new LiteralKind.VoidLiteral());
        return new Option<BoundExpression>.some(new BoundExpression.literal(result));
    }


    fun bind_identifier(mut this, expr: IdentifierExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_identifier");
        let sym: Option<BoundSymbol> = scope.lookup_symbol(expr.name);
        // A generic TYPE name used as an expression (`Box<i64>.bar("5")` static
        // impl call): resolve to the specialized type if already instantiated,
        // otherwise fall back to the template+args type so member access can find
        // the (generic) method and the IR mangles it per the receiver's args.
        // Only applies when `expr.name` is actually a TYPE (not a generic function
        // like `count_fields<Point>(...)`, which must bind as a function call).
        if (cast<i64>(expr.generic_args.size()) > 0 && this.identifier_is_type_name(expr.name, scope)) {
            let resolved_args: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
            let ok: mut bool = true;
            let gi: mut i64 = 0;
            while (gi < cast<i64>(expr.generic_args.size())) {
                let arg_bt: mut BoundType = this.model.some.resolve_type_specifier(expr.generic_args.at(cast<u64>(gi)).some, scope);
                if (arg_bt.kind is TypeKind.ErrorKind) { ok = false; }
                resolved_args.push(make_type_arg(arg_bt));
                gi = gi + 1;
            }
            if (ok) {
                // Full base from the type symbol (mangle encodes the qualified name).
                let base_full: mut string = expr.name;
                let tsrc: Option<BoundSymbol> = scope.lookup_type_in_scope(expr.name);
                if (tsrc.is_some() && tsrc.some is BoundSymbol.type_sym) {
                    let tbt: BoundType = tsrc.some.type_sym.bound_type;
                    if (tbt.type_definition.is_some()) {
                        let td2: BoundDefinition = tbt.type_definition.some;
                        if (td2 is BoundDefinition.class_def) { base_full = td2.class_def.full_name; }
                        if (td2 is BoundDefinition.enum_def) { base_full = td2.enum_def.full_name; }
                        if (td2 is BoundDefinition.interface_def) { base_full = td2.interface_def.full_name; }
                    }
                }
                let mangled: string = MonomorphizePass.mangle_generic_name(base_full, resolved_args);
                let spec_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(mangled);
                if (spec_sym.is_some() && spec_sym.some is BoundSymbol.type_sym) {
                    let spec_type: BoundType = spec_sym.some.type_sym.bound_type;
                    let pr: mut BoundIdentifierExpression = new BoundIdentifierExpression(spec_type, spec_sym);
                    return new Option<BoundExpression>.some(new BoundExpression.identifier(pr));
                }
                let ts2: mut TypeSpecifier = new TypeSpecifier();
                ts2.name = expr.name;
                let gi2: mut i64 = 0;
                while (gi2 < cast<i64>(expr.generic_args.size())) {
                    ts2.generic_args.push(expr.generic_args.at(cast<u64>(gi2)).some);
                    gi2 = gi2 + 1;
                }
                let tmpl_bt: mut BoundType = this.model.some.resolve_type_specifier(ts2, scope);
                let tsym2: mut BoundTypeSymbol = new BoundTypeSymbol(expr.name, expr.name);
                tsym2.bound_type = tmpl_bt;
                let pr2: mut BoundIdentifierExpression = new BoundIdentifierExpression(tmpl_bt, new Option<BoundSymbol>.some(new BoundSymbol.type_sym(tsym2)));
                return new Option<BoundExpression>.some(new BoundExpression.identifier(pr2));
            }
        }
        // A primitive-type name used as an expression (`i64.bar("5")` static impl
        // call): the type isn't a scope symbol, so fall back to the type registry
        // and bind a type reference.
        if (sym.is_none()) {
            let prim_opt: Option<BoundType> = this.model.some.type_registry.resolve_type(expr.name);
            if (prim_opt.is_some()) {
                let prim_bt: mut BoundType = prim_opt.some;
                if (prim_bt.kind is TypeKind.PrimitiveKind && !(prim_bt.primitive is PrimitiveType.VoidType)) {
                    let ts: mut BoundTypeSymbol = new BoundTypeSymbol(expr.name, expr.name);
                    ts.bound_type = prim_bt;
                    let pr: mut BoundIdentifierExpression = new BoundIdentifierExpression(prim_bt, new Option<BoundSymbol>.some(new BoundSymbol.type_sym(ts)));
                    return new Option<BoundExpression>.some(new BoundExpression.identifier(pr));
                }
            }
        }
        if (sym.is_some()) {
            // Reject class field access from methods without `this` parameter.
            // For example, `fun foo() { a = 1; }` inside a class where `a` is a
            // field but `foo` has no `this` — the identifier `a` resolves to the
            // field, but IR generation later crashes when it can't find a register
            // for the field. Catch it early with a proper E_RESOLVE_SYMBOL error.
            if (sym.some is BoundSymbol.variable) {
                if (sym.some.variable.variable_kind is VariableSymbolKind.Field) {
                    let this_sym: Option<BoundSymbol> = scope.lookup_symbol("this");
                    if (this_sym.is_none()) {
                        this.model.some.report_error(new ErrorCode.E_RESOLVE_SYMBOL(),
                            "Cannot access field '" + expr.name + "' without a 'this' reference; add 'this.' prefix or add a 'this' parameter to the function",
                            new SourceLocation("", 0, 0));
                        let result: mut BoundIdentifierExpression = new BoundIdentifierExpression(new BoundType(), new Option<BoundSymbol>.none());
                        return new Option<BoundExpression>.some(new BoundExpression.identifier(result));
                    }
                }
            }
            let bt: BoundType = this.resolve_symbol_type(sym.some);
            let result: mut BoundIdentifierExpression = new BoundIdentifierExpression(bt, sym);
            return new Option<BoundExpression>.some(new BoundExpression.identifier(result));
        }
        let result: mut BoundIdentifierExpression = new BoundIdentifierExpression(new BoundType(), sym);
        // Report E_RESOLVE_SYMBOL for undefined identifiers instead of
        // letting them silently produce E_INTERNAL in the IR generator.
        this.model.some.report_error(new ErrorCode.E_RESOLVE_SYMBOL(),
            "Cannot resolve symbol '" + expr.name + "'",
            new SourceLocation("", 0, 0));
        return new Option<BoundExpression>.some(new BoundExpression.identifier(result));
    }


    // True when `name` resolves to a TYPE (generic class/enum/interface or a
    // primitive) rather than a function/variable — used to disambiguate a generic
    // type-name expression (`Box<i64>.bar(...)`) from a generic function call
    // (`count_fields<Point>(...)`).
    fun identifier_is_type_name(this, name: string, scope: BoundScope) -> bool {
        if (this.model.some.type_registry.resolve_type(name).is_some()) { return true; }
        let tsym: Option<BoundSymbol> = scope.lookup_type_in_scope(name);
        if (tsym.is_some()) { return true; }
        return false;
    }


    fun resolve_symbol_type(this, sym: BoundSymbol) -> BoundType {
        _utils.trace_enter("Enter resolve_symbol_type");
        if (sym is BoundSymbol.variable) {
            return sym.variable.bound_type;
        }
        if (sym is BoundSymbol.function_sym) {
            return sym.function_sym.bound_type;
        }
        if (sym is BoundSymbol.type_sym) {
            return sym.type_sym.bound_type;
        }
        if (sym is BoundSymbol.enum_member) {
            return sym.enum_member.bound_type;
        }
        return new BoundType();
    }


    fun expr_contains_try_bind(mut this, expr: Expression) -> bool {
        if (expr is Expression.try_bind) { return true; }
        if (expr is Expression.parenthesized) {
            if (expr.parenthesized.inner.is_some()) {
                return this.expr_contains_try_bind(expr.parenthesized.inner.some);
            }
        }
        if (expr is Expression.binary) {
            let i: mut i64 = 0;
            while (i < cast<i64>(expr.binary.operands.size())) {
                if (this.expr_contains_try_bind(expr.binary.operands.at(cast<u64>(i)).some)) { return true; }
                i = i + 1;
            }
        }
        return false;
    }


    // P2: bind a logical chain (&& or ||) that contains try-binds with region
    // scoping. `&&` operands share one region (left-to-right: an earlier
    // try-bind's variable is visible to later operands, and — inside an
    // if/while condition region — promotes into the then-branch). `||` operands
    // are isolated: a variable bound in one operand is invisible to the others.
    fun bind_logical_chain(mut this, expr: BinaryExpression, scope: mut BoundScope, is_and: bool) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_logical_chain");
        let operators: mut _utils.List<BinaryOperator> = new _utils.List<BinaryOperator>();
        let j: mut i64 = 0;
        while (j < cast<i64>(expr.operators.size())) {
            operators.push(expr.operators.at(cast<u64>(j)).some);
            j = j + 1;
        }
        let operands: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
        if (is_and) {
            if (scope.is_condition_region) {
                // Whole if/while condition is the region: bind operands directly
                // so bindings promote into the then-branch.
                let i: mut i64 = 0;
                while (i < cast<i64>(expr.operands.size())) {
                    let bound_op: Option<BoundExpression> = this.bind_expression(expr.operands.at(cast<u64>(i)).some, scope);
                    if (bound_op.is_some()) { operands.push(bound_op.some); }
                    i = i + 1;
                }
            } else {
                let chain_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<logical-and>", scope.full_name + ".<logical-and>", new Option<BoundScope>.some(scope));
                chain_scope.is_region = true;
                let i: mut i64 = 0;
                while (i < cast<i64>(expr.operands.size())) {
                    let bound_op: Option<BoundExpression> = this.bind_expression(expr.operands.at(cast<u64>(i)).some, chain_scope);
                    if (bound_op.is_some()) { operands.push(bound_op.some); }
                    i = i + 1;
                }
            }
        } else {
            let chain_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<logical-or>", scope.full_name + ".<logical-or>", new Option<BoundScope>.some(scope));
            chain_scope.is_region = true;
            let i: mut i64 = 0;
            while (i < cast<i64>(expr.operands.size())) {
                let op_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<logical-or-operand>", scope.full_name + ".<logical-or-operand>", new Option<BoundScope>.some(chain_scope));
                op_scope.is_region = true;
                let bound_op: Option<BoundExpression> = this.bind_expression(expr.operands.at(cast<u64>(i)).some, op_scope);
                if (bound_op.is_some()) { operands.push(bound_op.some); }
                i = i + 1;
            }
        }
        let result: mut BoundBinaryExpression = new BoundBinaryExpression(this.model.some.type_registry.bool_type, operators, operands);
        return new Option<BoundExpression>.some(new BoundExpression.binary(result));
    }


    fun bind_binary(mut this, expr: BinaryExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_binary");
        // P2: a logical chain containing try-binds needs region scoping.
        if (cast<i64>(expr.operators.size()) > 0 && this.expr_contains_try_bind(new Expression.binary(expr))) {
            let all_and: mut bool = true;
            let all_or: mut bool = true;
            let oi: mut i64 = 0;
            while (oi < cast<i64>(expr.operators.size())) {
                let op: BinaryOperator = expr.operators.at(cast<u64>(oi)).some;
                if (!(op is BinaryOperator.LogicalAnd)) { all_and = false; }
                if (!(op is BinaryOperator.LogicalOr)) { all_or = false; }
                oi = oi + 1;
            }
            if (all_and) { return this.bind_logical_chain(expr, scope, true); }
            if (all_or) { return this.bind_logical_chain(expr, scope, false); }
            this.model.some.report_error(new ErrorCode.E_UNSUPPORTED(),
                "try-bind in a mixed && / || chain is not supported yet",
                new SourceLocation("", 0, 0));
            return new Option<BoundExpression>.none();
        }
        let operands: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
        let i: mut i64 = 0;
        while (i < cast<i64>(expr.operands.size())) {
            let bound_op: Option<BoundExpression> = this.bind_expression(expr.operands.at(cast<u64>(i)).some, scope);
            if (bound_op.is_some()) {
                operands.push(bound_op.some);
            }
            i = i + 1;
        }
        let operators: mut _utils.List<BinaryOperator> = new _utils.List<BinaryOperator>();
        let j: mut i64 = 0;
        while (j < cast<i64>(expr.operators.size())) {
            operators.push(expr.operators.at(cast<u64>(j)).some);
            j = j + 1;
        }
        // Integer-literal FIRST operand: `1 + b` binds the literal as i64,
        // and the binary result type is operand 0's type — so `return 1+b` in
        // an i32 function fails while `b+1` compiles. Mirror the
        // literal-second behavior: re-type a leading integer literal to the
        // first non-literal integer operand's type.
        if (cast<i64>(operands.size()) >= 2) {
            let op0: BoundExpression = operands.at(cast<u64>(0)).some;
            if (op0 is BoundExpression.literal && op0.literal.literal_kind is LiteralKind.IntegerLiteral) {
                let t0: BoundType = op0.get_bound_type();
                if (t0.kind is TypeKind.PrimitiveKind) {
                    // Track the operand INDEX (not the BoundType itself):
                    // get_bound_type() yields an immutable reference, which
                    // cannot be assigned into a mut slot.
                    let hit: mut i64 = -1;
                    let k: mut i64 = 1;
                    while (k < cast<i64>(operands.size())) {
                        let cand: BoundExpression = operands.at(cast<u64>(k)).some;
                        let is_lit: bool = if (cand is BoundExpression.literal) {
                            cand.literal.literal_kind is LiteralKind.IntegerLiteral
                        } else {
                            false
                        };
                        if (!is_lit) {
                            let tk: BoundType = cand.get_bound_type();
                            if (tk.kind is TypeKind.PrimitiveKind && this.model.some.type_registry.is_integer(tk)) {
                                hit = k;
                            }
                            k = cast<i64>(operands.size());
                        }
                        k = k + 1;
                    }
                    if (hit >= 0) {
                        let target: BoundType = operands.at(cast<u64>(hit)).some.get_bound_type();
                        if (!target.is_same_type(t0)) {
                            let re_lit: mut BoundLiteralExpression = new BoundLiteralExpression(op0.literal.value, target, new LiteralKind.IntegerLiteral());
                            operands.set(cast<u64>(0), new BoundExpression.literal(re_lit));
                        }
                    }
                }
            }
        }
        // Constant-fold string-literal `+` runs ("a" + "b" -> "ab") so the
        // result lowers to ONE static .rodata literal instead of a runtime
        // _emperor_string_concat heap allocation per evaluation.
        if (this.fold_string_literal_concats(operands, operators)) {
            if (cast<i64>(operands.size()) == 1 && cast<i64>(operators.size()) == 0) {
                return new Option<BoundExpression>.some(operands.at(cast<u64>(0)).some);
            }
        }
        if (cast<i64>(operands.size()) > 0) {
            let bt: BoundType = operands.at(cast<u64>(0)).some.get_bound_type();
            // Comparison and `is` operators produce bool result
            if (cast<i64>(operators.size()) > 0) {
                let first_op: BinaryOperator = operators.at(cast<u64>(0)).some;
                if (first_op is BinaryOperator.Is
                    || first_op is BinaryOperator.Equal
                    || first_op is BinaryOperator.NotEqual
                    || first_op is BinaryOperator.LessThan
                    || first_op is BinaryOperator.GreaterThan
                    || first_op is BinaryOperator.LessThanOrEqual
                    || first_op is BinaryOperator.GreaterThanOrEqual) {
                    let bool_type: BoundType = this.model.some.type_registry.resolve_type("bool").some;
                    let result: mut BoundBinaryExpression = new BoundBinaryExpression(bool_type, operators, operands);
                    return new Option<BoundExpression>.some(new BoundExpression.binary(result));
                }
            }
            let result: mut BoundBinaryExpression = new BoundBinaryExpression(bt, operators, operands);
            return new Option<BoundExpression>.some(new BoundExpression.binary(result));
        }
        let result: mut BoundBinaryExpression = new BoundBinaryExpression(new BoundType(), operators, operands);
        return new Option<BoundExpression>.some(new BoundExpression.binary(result));
    }

    // True when `e` is a plain string literal. `value` holds the raw quoted
    // token text with escape sequences still encoded (bind_string_literal).
    fun is_string_literal_expr(this, e: BoundExpression) -> bool {
        if (e is BoundExpression.literal) {
            if (e.literal.literal_kind is LiteralKind.StringLiteral) {
                return true;
            }
        }
        return false;
    }

    // The inner text of a string literal's value: quotes stripped, escape
    // sequences kept VERBATIM. Concatenating inner texts therefore produces
    // exactly what the merged source literal would lex to.
    fun string_literal_inner(this, e: BoundExpression) -> string {
        let v: string = e.literal.value;
        let len: i64 = string_length(v);
        if (len >= 2 && string_char_at(v, 0) == "\"" && string_char_at(v, len - 1) == "\"") {
            return string_substring(v, 1, len - 2);
        }
        return v;
    }

    // Fold ADJACENT string-literal operands joined by Add into one literal,
    // rewriting `operands`/`operators` in place. A folded chain becomes a
    // single StringLiteral bound expression, so IRGenerator emits one CONST
    // and LLVMEmitter places the whole text in a static @str_N constant —
    // no runtime _emperor_string_concat, no GC allocation. Mixed chains
    // ("lit" + x + "a" + "b") keep their non-literal operands; only the
    // adjacent literal runs merge. Returns true when anything folded.
    fun fold_string_literal_concats(mut this, operands: mut _utils.List<BoundExpression>, operators: mut _utils.List<BinaryOperator>) -> bool {
        if (cast<i64>(operands.size()) < 2) { return false; }
        if (cast<i64>(operators.size()) != cast<i64>(operands.size()) - 1) { return false; }
        let folded_any: mut bool = false;
        let out_operands: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
        let out_operators: mut _utils.List<BinaryOperator> = new _utils.List<BinaryOperator>();
        let i: mut i64 = 0;
        while (i < cast<i64>(operands.size())) {
            let cur: BoundExpression = operands.at(cast<u64>(i)).some;
            let merge: mut bool = false;
            if (i > 0 && this.is_string_literal_expr(cur) && cast<i64>(out_operands.size()) > 0) {
                let prev_op: BinaryOperator = operators.at(cast<u64>(i - 1)).some;
                let last_idx: i64 = cast<i64>(out_operands.size()) - 1;
                if (prev_op is BinaryOperator.Add && this.is_string_literal_expr(out_operands.at(cast<u64>(last_idx)).some)) {
                    merge = true;
                }
            }
            if (merge) {
                let last: BoundExpression = out_operands.pop().some;
                let merged_inner: string = this.string_literal_inner(last) + this.string_literal_inner(cur);
                let merged: mut BoundLiteralExpression = new BoundLiteralExpression("\"" + merged_inner + "\"", last.literal.bound_type, new LiteralKind.StringLiteral());
                out_operands.push(new BoundExpression.literal(merged));
                folded_any = true;
                // the Add between the merged pair is consumed: not carried over
            } else {
                out_operands.push(cur);
                if (i > 0) {
                    out_operators.push(operators.at(cast<u64>(i - 1)).some);
                }
            }
            i = i + 1;
        }
        if (folded_any) {
            while (cast<i64>(operands.size()) > 0) { operands.pop(); }
            let oi: mut i64 = 0;
            while (oi < cast<i64>(out_operands.size())) {
                operands.push(out_operands.at(cast<u64>(oi)).some);
                oi = oi + 1;
            }
            while (cast<i64>(operators.size()) > 0) { operators.pop(); }
            let pj: mut i64 = 0;
            while (pj < cast<i64>(out_operators.size())) {
                operators.push(out_operators.at(cast<u64>(pj)).some);
                pj = pj + 1;
            }
        }
        return folded_any;
    }


    fun bind_unary(mut this, expr: UnaryExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_unary");
        if (expr.operand.is_some()) {
            let bound_inner: Option<BoundExpression> = this.bind_expression(expr.operand.some, scope);
            if (bound_inner.is_some()) {
                let bt: BoundType = bound_inner.some.get_bound_type();
                let result: mut BoundUnaryExpression = new BoundUnaryExpression(bt, expr.operator_value, bound_inner);
                return new Option<BoundExpression>.some(new BoundExpression.unary(result));
            }
        }
        let result: mut BoundUnaryExpression = new BoundUnaryExpression(new BoundType(), expr.operator_value, new Option<BoundExpression>.none());
        return new Option<BoundExpression>.some(new BoundExpression.unary(result));
    }


    fun get_field_mutability_from_class(this, cls: BoundClassDefinition, field_name: string) -> Mutability {
        _utils.trace_enter("Enter get_field_mutability_from_class");
        let fi: mut i64 = 0;
        while (fi < cast<i64>(cls.fields.size())) {
            let fd: BoundDefinition = cls.fields.at(cast<u64>(fi)).some;
            if (fd is BoundDefinition.class_field) {
                if (fd.class_field.name == field_name) {
                    return fd.class_field.mutability;
                }
            }
            fi = fi + 1;
        }
        return new Mutability.Mutable();
    }


    // True when a field's declared type is one of the class's generic params
    // (e.g. `a: T` in `#template(T: type) class A`). Such fields are implicitly
    // immutable — you can't know whether T is a value or reference type, so
    // BabyPenguin treats the substituted arg as immutable (`A<!mut i32>.a`).
    fun field_is_generic_param(this, cls: BoundClassDefinition, field_name: string) -> bool {
        _utils.trace_enter("Enter field_is_generic_param");
        if (let ast_def := cls.ast_source.some) {
            if (ast_def is Definition.class_def) {
                let ast_cls: ClassDefinition = ast_def.class_def;
                let mi: mut i64 = 0;
                while (mi < cast<i64>(ast_cls.members.size())) {
                    let member: Definition = ast_cls.members.at(cast<u64>(mi)).some;
                    if (member is Definition.class_field) {
                        if (member.class_field.name == field_name) {
                            if (let ts := member.class_field.type_spec.some) {
                                // `auto T` explicitly follows container mutability,
                                // so it is not implicitly immutable.
                                if (ts.is_auto_mutability) { return false; }
                                let ts_name: string = ts.name;
                                let gi: mut i64 = 0;
                                while (gi < cast<i64>(cls.generic_params.size())) {
                                    if (cls.generic_params.at(cast<u64>(gi)).some == ts_name) {
                                        return true;
                                    }
                                    gi = gi + 1;
                                }
                            }
                        }
                    }
                    mi = mi + 1;
                }
            }
        }
        return false;
    }


    fun resolve_field_type_from_class(this, base_type: BoundType, cls: BoundClassDefinition, field_name: string, scope: BoundScope) -> mut BoundType {
        _utils.trace_enter("Enter resolve_field_type_from_class");
        // If base type has generic args, look up the field in the specialized class
        if (cast<i64>(base_type.generic_args.size()) > 0) {
            let mangled: string = MonomorphizePass.mangle_generic_name(cls.full_name, base_type.generic_args);
            let spec_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(mangled);
            if (spec_sym.is_some() && spec_sym.some is BoundSymbol.type_sym) {
                let spec_bt: BoundType = spec_sym.some.type_sym.bound_type;
                if (let spec_td := spec_bt.type_definition.some) {
                    if (spec_td is BoundDefinition.class_def) {
                        let spec_cls: BoundClassDefinition = spec_td.class_def;
                        let fi: mut i64 = 0;
                        while (fi < cast<i64>(spec_cls.fields.size())) {
                            let fd: BoundDefinition = spec_cls.fields.at(cast<u64>(fi)).some;
                            if (fd is BoundDefinition.class_field) {
                                if (fd.class_field.name == field_name) {
                                    return fd.class_field.bound_type;
                                }
                            }
                            fi = fi + 1;
                        }
                    }
                }
            }
        }
        // Fallback: search in generic class fields
        let fi: mut i64 = 0;
        while (fi < cast<i64>(cls.fields.size())) {
            let fd: BoundDefinition = cls.fields.at(cast<u64>(fi)).some;
            if (fd is BoundDefinition.class_field) {
                if (fd.class_field.name == field_name) {
                    return fd.class_field.bound_type;
                }
            }
            fi = fi + 1;
        }
        return new BoundType();
    }


    // Resolve the specialized class/enum def for a generic base type reference
    // (e.g. Option<i64> → Option__i64) so member lookup can search the specialized
    // def's vtables (which include #specializing-injected impls that the template
    // does not carry). Returns the template def unchanged when the base is
    // non-generic, or none when no specialized def exists yet.
    fun resolve_specialized_container_def(this, base_type: BoundType, scope: BoundScope) -> Option<BoundDefinition> {
        if (cast<i64>(base_type.generic_args.size()) == 0) { return base_type.type_definition; }
        if (base_type.type_definition.is_none()) { return new Option<BoundDefinition>.none(); }
        let td: BoundDefinition = base_type.type_definition.some;
        let name: mut string = "";
        if (td is BoundDefinition.class_def) { name = td.class_def.full_name; }
        if (td is BoundDefinition.enum_def) { name = td.enum_def.full_name; }
        if (td is BoundDefinition.interface_def) { name = td.interface_def.full_name; }
        if (string_length(name) == 0) { return new Option<BoundDefinition>.none(); }
        let mangled: string = MonomorphizePass.mangle_generic_name(name, base_type.generic_args);
        let spec_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(mangled);
        if (spec_sym.is_some() && spec_sym.some is BoundSymbol.type_sym) {
            return spec_sym.some.type_sym.bound_type.type_definition;
        }
        return new Option<BoundDefinition>.none();
    }


    // Bind a namespace-scope member access that carries GENERIC ARGS
    // (`__builtin.Option<i64>.member`, `ns.Enum<T>.variant`): the plain
    // namespace lookup returns the TEMPLATE type symbol and drops the args, so
    // the following member lookup misses #specializing-injected impls (they
    // live on the SPECIALIZED def only, e.g. Option__i64). Mirror
    // bind_identifier's generic-type branch: resolve the args, mangle from the
    // template def's full name, prefer the specialized type symbol; with no
    // specialization yet, fall back to the template+args type so the member
    // lookup still takes the generic-base (specialized-def) search paths.
    // Returns none when the member isn't a type or an arg fails to resolve —
    // callers then fall through to the plain namespace lookup.
    fun bind_namespaced_generic_type_member(mut this, ns_scope: BoundScope, expr: MemberAccessExpression, bound_base: Option<BoundExpression>, scope: mut BoundScope) -> Option<BoundExpression> {
        let found: Option<BoundSymbol> = ns_scope.lookup_symbol(expr.member_name);
        if (found.is_none()) { return new Option<BoundExpression>.none(); }
        if (!(found.some is BoundSymbol.type_sym)) { return new Option<BoundExpression>.none(); }
        let resolved_args: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
        let gi: mut i64 = 0;
        while (gi < cast<i64>(expr.generic_args.size())) {
            let arg_bt: BoundType = this.model.some.resolve_type_specifier(expr.generic_args.at(cast<u64>(gi)).some, scope);
            if (arg_bt.kind is TypeKind.ErrorKind) { return new Option<BoundExpression>.none(); }
            resolved_args.push(make_type_arg(arg_bt));
            gi = gi + 1;
        }
        let tmpl_bt: BoundType = found.some.type_sym.bound_type;
        if (tmpl_bt.type_definition.is_some()) {
            let td: BoundDefinition = tmpl_bt.type_definition.some;
            let base_full: mut string = "";
            if (td is BoundDefinition.class_def) { base_full = td.class_def.full_name; }
            if (td is BoundDefinition.enum_def) { base_full = td.enum_def.full_name; }
            if (td is BoundDefinition.interface_def) { base_full = td.interface_def.full_name; }
            if (string_length(base_full) > 0) {
                let mangled: string = MonomorphizePass.mangle_generic_name(base_full, resolved_args);
                let spec_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(mangled);
                if (spec_sym.is_some() && spec_sym.some is BoundSymbol.type_sym) {
                    let bt: BoundType = spec_sym.some.type_sym.bound_type;
                    let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, spec_sym);
                    return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                }
            }
        }
        let tmpl_with_args: mut BoundType = tmpl_bt.with_generic_args(resolved_args);
        let result2: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(tmpl_with_args, bound_base, expr.member_name, found);
        return new Option<BoundExpression>.some(new BoundExpression.member_access(result2));
    }


    // Look up `member_name` in the SPECIALIZED class/enum scope for a generic base
    // type (e.g. Option<i64> → Option__i64). #specializing-injected impl methods are
    // registered in the specialized scope, not the template's. Returns none when the
    // base is non-generic or the member isn't found there.
    fun lookup_specialized_scope_member(this, base_type: BoundType, member_name: string, scope: BoundScope) -> Option<BoundSymbol> {
        if (let spec_def := this.resolve_specialized_container_def(base_type, scope).some) {
            if (spec_def is BoundDefinition.class_def) {
                if (spec_def.class_def.scope.is_some()) {
                    return spec_def.class_def.scope.some.lookup_symbol(member_name);
                }
            }
            if (spec_def is BoundDefinition.enum_def) {
                if (spec_def.enum_def.scope.is_some()) {
                    return spec_def.enum_def.scope.some.lookup_symbol(member_name);
                }
            }
        }
        return new Option<BoundSymbol>.none();
    }


    // The vtables to search for a member access on `base_type`: the SPECIALIZED
    // class/enum def's vtables when the base is generic (Option<i64>), else the
    // template's vtables. #specializing-injected impl vtables live on the
    // specialized def, not the template.
    fun resolve_container_vtables(this, base_type: BoundType, template_vtables: _utils.List<BoundVTable>, scope: BoundScope) -> _utils.List<BoundVTable> {
        if (let spec_def := this.resolve_specialized_container_def(base_type, scope).some) {
            if (spec_def is BoundDefinition.class_def) {
                return spec_def.class_def.vtables;
            }
            if (spec_def is BoundDefinition.enum_def) {
                return spec_def.enum_def.vtables;
            }
        }
        return template_vtables;
    }


    // Ensure the specialized def of a generic interface instantiation
    // (`__builtin.ISource` + i64 -> ISource$<mangle>) exists — created,
    // type-resolved, signature-caught-up and registered for body binding.
    // The virtual call sites (cast<ISink<T>>(port).write) resolve their
    // signatures through the specialized def; without it the template's
    // unresolved T-shaped returns poison the call ABI.
    fun ensure_generic_iface_spec(mut this, iface_short: string, payload: BoundType, scope: mut BoundScope) {
        if (this.model.some.current_unit.is_none()) { return; }
        let ts: mut TypeSpecifier = new TypeSpecifier();
        ts.qualified_parts.push("__builtin");
        ts.name = iface_short;
        ts.generic_args.push(this.spawn_type_spec(payload));
        let bt: BoundType = this.model.some.resolve_type_specifier(ts, scope);
        if (bt.type_definition.is_none()) { return; }
        let td: BoundDefinition = bt.type_definition.some;
        let full_base: mut string = "";
        let is_generic_iface: mut bool = false;
        if (td is BoundDefinition.interface_def) {
            is_generic_iface = cast<i64>(td.interface_def.generic_params.size()) > 0;
            full_base = td.interface_def.full_name;
        }
        if (!is_generic_iface || cast<i64>(bt.generic_args.size()) == 0) { return; }
        let mangled: string = MonomorphizePass.mangle_generic_name(full_base, bt.generic_args);
        if (this.model.some.global_scope.lookup_type_in_scope(mangled).is_some()) { return; }
        let spec: Option<BoundDefinition> = this.model.some.monomorphize_pass.ensure_specialized_def(bt, this.model.some.global_scope);
        if (spec.is_none()) { return; }
        let ast_spec: Option<Definition> = this.model.some.monomorphize_pass.find_ast_def_by_name(this.model.some.ast_definitions, iface_short);
        // Sequence the new def through pass 2 (resolve) + passes 4-7
        // (catch-up) with the monomorphize-loop's pass-index protocol:
        // resolve_pair stamps the def with the CURRENT pass index, so binding
        // it at 8 would mark it fully processed and every catch-up sub-pass
        // (vtables! classification!) would skip — leaving the class
        // unclassified (defaults to value type = stack allocation) and
        // vtable-less. Resolve at index 3, then catch up at 8.
        let m1: mut SemanticModel = this.model.some;
        let saved_idx1: i64 = m1.current_pass_index;
        if (ast_spec.is_some()) {
            m1.current_pass_index = 3;
            let resolved_def1: BoundDefinition = this.model.some.resolve_types_pass.resolve_pair(ast_spec.some, spec.some, this.spec_resolve_scope(spec.some));
            m1.current_pass_index = saved_idx1;
            m1.catch_up_def_before_bodies(resolved_def1, this.model.some.current_unit.some);
            this.model.some.current_unit.some.definitions.push(resolved_def1);
        } else {
            m1.catch_up_def_before_bodies(spec.some, this.model.some.current_unit.some);
            this.model.some.current_unit.some.definitions.push(spec.some);
        }
    }

    // Bind a member access's base: RAW (port sugar suppressed) when the base
    // is itself a member access onto a port field (a channel-object receiver).
    fun bind_member_base(mut this, base: Expression, base_is_port: Option<PortAccessInfo>, scope: mut BoundScope) -> Option<BoundExpression> {
        if (base_is_port.is_some()) {
            return this.bind_expr_no_port_sugar(base, scope);
        }
        return this.bind_expression(base, scope);
    }

    // True when a member-access BASE denotes a VALUE (an object), as opposed
    // to a type / namespace reference (the base of an unbound or static
    // method reference).
    fun member_base_is_value(mut this, ma: BoundMemberAccessExpression) -> bool {
        if (ma.base_expr.is_none()) { return false; }
        let b: BoundExpression = ma.base_expr.some;
        if (b is BoundExpression.identifier) {
            if (b.identifier.symbol.is_some()) {
                let s: BoundSymbol = b.identifier.symbol.some;
                if (s is BoundSymbol.type_sym) { return false; }
                if (s is BoundSymbol.namespace_sym) { return false; }
            }
            return true;
        }
        if (b is BoundExpression.member_access) {
            let inner: BoundMemberAccessExpression = b.member_access;
            if (inner.member_symbol.is_some()) {
                let s2: BoundSymbol = inner.member_symbol.some;
                if (s2 is BoundSymbol.type_sym) { return false; }
                if (s2 is BoundSymbol.namespace_sym) { return false; }
            }
            return true;
        }
        return true;
    }

    // A method reference in VALUE position: bind_member_access gives the
    // method's full fun type (receiver included). A reference through a VALUE
    // base (`x.call`) is BOUND — the receiver is baked into the callable
    // object, so the value's type STRIPS the this parameter
    // (fun<Ret, Params...>). A reference through a TYPE base (`Temp.call`)
    // stays UNBOUND — the full type keeps the receiver as the first parameter
    // (fun<Ret, Temp, Params...>; h(a, x) ≡ Temp.b(a, x)). Call positions are
    // unaffected: bind_function_call dispatches on member_symbol, not on this
    // type.
    fun adjust_method_ref_type(mut this, ma: BoundMemberAccessExpression) -> BoundExpression {
        if (ma.member_symbol.is_none()) { return new BoundExpression.member_access(ma); }
        let sym: BoundSymbol = ma.member_symbol.some;
        if (!(sym is BoundSymbol.function_sym)) { return new BoundExpression.member_access(ma); }
        let fsym: BoundFunctionSymbol = sym.function_sym;
        if (!this.function_is_method(fsym)) { return new BoundExpression.member_access(ma); }
        let bt: BoundType = ma.get_bound_type();
        if (!(bt.kind is TypeKind.FunctionKind)) { return new BoundExpression.member_access(ma); }
        if (cast<i64>(bt.generic_args.size()) < 2) { return new BoundExpression.member_access(ma); }
        if (this.member_base_is_value(ma)) {
            // Receiver mutability: a `mut this` method referenced on an
            // immutable binding must fail (same rule as calling it).
            if (cast<i64>(fsym.parameters.size()) > 0) {
                let this_param: BoundFunctionParameter = fsym.parameters.at(cast<u64>(0)).some;
                if (this_param.is_mutable && ma.base_expr.is_some()) {
                    let base_type: BoundType = ma.base_expr.some.get_bound_type();
                    if (base_type.mutability is Mutability.Immutable) {
                        this.model.some.report_error(new ErrorCode.E_TYPE_MISMATCH(),
                            "Cannot bind method '" + fsym.name + "' with 'mut this' on an immutable binding",
                            fsym.location);
                    }
                }
            }
            let ret: BoundType = arg_as_bound_type(bt.generic_args.at(cast<u64>(0)).some);
            let params: mut _utils.List<BoundType> = new _utils.List<BoundType>();
            let i: mut i64 = 2;
            while (i < cast<i64>(bt.generic_args.size())) {
                params.push(arg_as_bound_type(bt.generic_args.at(cast<u64>(i)).some));
                i = i + 1;
            }
            let stripped: BoundType = this.model.some.type_registry.make_function_type(ret, params, bt.is_async_function);
            let replacement: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(stripped, ma.base_expr, ma.member_name, ma.member_symbol);
            return new BoundExpression.member_access(replacement);
        }
        return new BoundExpression.member_access(ma);
    }

    fun bind_member_access(mut this, expr: MemberAccessExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_member_access");        if (expr.base_expr.is_some()) {
            // E5 receiver-raw rule: when the base of this member access is
            // itself a member access onto a declared port field, the access
            // operates on the port's CHANNEL OBJECT (a method call like
            // `this.y.write(v)` / `f.x.close()`) — bind the base RAW, without
            // the bare-read payload conversion.
            let base_is_port: Option<PortAccessInfo> = this.resolve_port_access_for_base(expr.base_expr.some, scope);
            let bound_base: Option<BoundExpression> = this.bind_member_base(expr.base_expr.some, base_is_port, scope);
            if (bound_base.is_some()) {
                let base_type: BoundType = bound_base.some.get_bound_type();
                // E5 bare port READ: `X.p` in value position (p a declared
                // port of X's class) is the settle-point payload read. The
                // read matrix lets outsiders read outputs but only the owner
                // read its inputs; construct bodies may not read ports (a
                // settle point is a suspension).
                if (base_is_port.is_none() && this.model.some.port_sugar_suppressed == 0) {
                    let pai: Option<PortAccessInfo> = this.resolve_port_access(expr, scope);
                    if (pai.is_some()) {
                        let info: PortAccessInfo = pai.some;
                        if (this.in_construct_routine(scope)) {
                            this.model.some.report_error(new ErrorCode.E_EVENT_INVALID(),
                                "Cannot read port '" + expr.member_name + "' inside a construct block - a port read is a settle point (it waits for the current time to settle), and construct bodies must not wait",
                                new SourceLocation("", 0, 0));
                            return new Option<BoundExpression>.none();
                        }
                        if (info.is_input && !info.base_is_this) {
                            this.model.some.report_error(new ErrorCode.E_MUTABILITY(),
                                "Cannot read input port '" + expr.member_name + "' of another module - inputs are only visible inside their module",
                                new SourceLocation("", 0, 0));
                            return new Option<BoundExpression>.none();
                        }
                        // The full `X.p` member access AST (the read's channel
                        // operand), rebuilt fresh — the generated code embeds
                        // it inside a cast expression.
                        let port_ma: mut MemberAccessExpression = new MemberAccessExpression();
                        port_ma.base_expr = expr.base_expr;
                        port_ma.member_name = expr.member_name;
                        return this.bind_expression(this.mk_bare_port_read_expr(new Expression.member_access(port_ma), info.payload, scope), scope);
                    }
                }
                // Port-field source/sink surface: EP's IChannel carries only
                // close/is_closed (no interface inheritance), so write/
                // try_write/current/try_poll on an IChannel-typed value (a
                // module's port field) resolve nowhere. Rewrite to an explicit
                // interface cast — `cast<mut ISink<T>>(x).write(v)` /
                // `cast<mut ISource<T>>(x).current()` — which dispatches
                // virtually to the backing channel.
                if (base_type.kind is TypeKind.InterfaceKind && cast<i64>(base_type.generic_args.size()) == 1) {
                    if (base_type.type_definition.is_some() && base_type.type_definition.some is BoundDefinition.interface_def) {
                        if (base_type.type_definition.some.interface_def.name == "IChannel") {
                            if (expr.member_name == "write" || expr.member_name == "try_write" || expr.member_name == "current" || expr.member_name == "try_poll") {
                                // Write-side permission matrix for the method form:
                                // driving a port through `this.y.write(v)` /
                                // `f.y.write(v)` obeys the assignment-sugar rules
                                // (inputs are connect-only; outputs are driven by
                                // their owner only), and counts as a body driver.
                                if (base_is_port.is_some()) {
                                    let winfo: PortAccessInfo = base_is_port.some;
                                    if (expr.member_name == "write" || expr.member_name == "try_write") {
                                        if (winfo.is_input) {
                                            this.model.some.report_error(new ErrorCode.E_MUTABILITY(),
                                                "Cannot write input port '" + winfo.field_sym.name + "' - inputs are wired exclusively through connect",
                                                new SourceLocation("", 0, 0));
                                            return new Option<BoundExpression>.none();
                                        }
                                        if (!winfo.base_is_this) {
                                            this.model.some.report_error(new ErrorCode.E_MUTABILITY(),
                                                "Cannot drive output port '" + winfo.field_sym.name + "' of another module from outside '" + winfo.class_full_name + "'",
                                                new SourceLocation("", 0, 0));
                                            return new Option<BoundExpression>.none();
                                        }
                                        this.register_body_driver(winfo, scope);
                                    }
                                }
                                let iface_name: string = if (expr.member_name == "write" || expr.member_name == "try_write") { "ISink" } else { "ISource" };
                                let payload: BoundType = arg_as_bound_type(base_type.generic_args.at(cast<u64>(0)).some);
                                this.ensure_generic_iface_spec(iface_name, payload, scope);
                                let iface_ts: mut TypeSpecifier = new TypeSpecifier();
                                iface_ts.qualified_parts.push("__builtin");
                                iface_ts.name = iface_name;
                                iface_ts.generic_args.push(this.spawn_type_spec(payload));
                                iface_ts.is_mutable = true;
                                let cast_node: mut CastExpression = new CastExpression();
                                cast_node.target_type = new Option<TypeSpecifier>.some(iface_ts);
                                cast_node.type_name = iface_name;
                                cast_node.inner = new Option<Expression>.some(expr.base_expr.some);
                                let rew: mut MemberAccessExpression = new MemberAccessExpression();
                                rew.base_expr = new Option<Expression>.some(new Expression.cast_expr(cast_node));
                                rew.member_name = expr.member_name;
                                return this.bind_member_access(rew, scope);
                            }
                        }
                    }
                }
                // Primitive interface-method dispatch: `impl IHash for i64 { ... }`
                // methods are mangled to `<name>$$<primitive>` at bind time and
                // recorded in the primitive_impl registry. Resolve `k.hash()` on a
                // primitive base to the mangled symbol (direct call, no vtable).
                // Unmatched names fall through to the existing paths below.
                if (base_type.kind is TypeKind.PrimitiveKind) {
                    let base_name: string = base_type.display_name();
                    let pi2: mut i64 = 0;
                    while (pi2 < cast<i64>(this.model.some.primitive_impl_for_type.size())) {
                        if (this.model.some.primitive_impl_for_type.at(cast<u64>(pi2)).some == base_name
                            && this.model.some.primitive_impl_method_name.at(cast<u64>(pi2)).some == expr.member_name) {
                            let impl_sym: mut BoundFunctionSymbol = this.model.some.primitive_impl_method_sym.at(cast<u64>(pi2)).some;
                            let bt: mut BoundType = this.find_function_return_type(impl_sym);
                            let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, new Option<BoundSymbol>.some(new BoundSymbol.function_sym(impl_sym)));
                            return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                        }
                        pi2 = pi2 + 1;
                    }
                }
                if (let td := base_type.type_definition.some) {
                    if (td is BoundDefinition.class_def) {
                        let cls: BoundClassDefinition = td.class_def;
                        if (cls.scope.is_some()) {
                            let found: Option<BoundSymbol> = cls.scope.some.lookup_symbol(expr.member_name);
                            if (found.is_some()) {
                                let bt: mut BoundType = this.resolve_symbol_type(found.some);
                                // For fields, look up the field definition for accurate type
                                if (found.some is BoundSymbol.variable) {
                                    if (found.some.variable.variable_kind is VariableSymbolKind.Field) {
                                        bt = this.resolve_field_type_from_class(base_type, cls, expr.member_name, scope);
                                        // Adjust field type mutability based on field's declared
                                        // mutability (Auto/Mutable/Immutable) and container mutability.
                                        let field_mut: Mutability = this.get_field_mutability_from_class(cls, expr.member_name);
                                        if (field_mut is Mutability.Auto) {
                                            // For Auto fields, use container's mutability
                                            // UNLESS the field type already has explicit Mutable
                                            // (from generic specialization like A<mut i32>), or the
                                            // field's type is a generic param (implicitly immutable).
                                            // A generic-param field is only immutable when the
                                            // substituted arg is NOT explicitly mutable (A<mut i32>
                                            // stays mutable — the field's own type carries it).
                                            if (this.field_is_generic_param(cls, expr.member_name)) {
                                                if (!(bt.mutability is Mutability.Mutable)) {
                                                    bt = bt.with_mutability(new Mutability.Immutable());
                                                }
                                            } else if (!(bt.mutability is Mutability.Mutable)) {
                                                bt = bt.with_mutability(base_type.mutability);
                                            }
                                        } else if (field_mut is Mutability.Mutable) {
                                            bt = bt.with_mutability(new Mutability.Mutable());
                                        } else if (field_mut is Mutability.Immutable) {
                                            bt = bt.with_mutability(new Mutability.Immutable());
                                        }
                                    }
                                }
                                let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, found);
                                return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                            }
                            // For a generic base (Box<i64>), the #specializing-injected impl
                            // methods live in the SPECIALIZED scope (not the template's), so
                            // resolve them there — they lower to a direct call on the
                            // specialized impl (matching how normal `impl` methods resolve).
                            let spec_scope_found: Option<BoundSymbol> = this.lookup_specialized_scope_member(base_type, expr.member_name, scope);
                            if (spec_scope_found.is_some()) {
                                let bt: BoundType = this.resolve_symbol_type(spec_scope_found.some);
                                let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, spec_scope_found);
                                return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                            }
                            // Fallback: search implemented interface scopes for default methods.
                            // Detect ambiguity: if two or more implemented interfaces each
                            // provide a member with this name, the access is ambiguous
                            // (e.g. Foo.foo() where Foo implements both IB and IC, each
                            // defining foo). Collect every matching interface first so we
                            // never silently pick the first. For a generic base (Box<i64>),
                            // search the SPECIALIZED def's vtables (the template's are empty
                            // for #specializing-injected impls).
                            let vtables_src: _utils.List<BoundVTable> = this.resolve_container_vtables(base_type, cls.vtables, scope);
                            let vi: mut i64 = 0;
                            let match_iface_names: mut _utils.List<string> = new _utils.List<string>();
                            while (vi < cast<i64>(vtables_src.size())) {
                                let vtable: BoundVTable = vtables_src.at(cast<u64>(vi)).some;
                                let iface_type: BoundType = vtable.interface_type;
                                if (let iface_def := iface_type.type_definition.some) {
                                    if (iface_def is BoundDefinition.interface_def) {
                                        let iface: BoundInterfaceDefinition = iface_def.interface_def;
                                        if (iface.scope.is_some()) {
                                            let iface_found: Option<BoundSymbol> = iface.scope.some.lookup_symbol(expr.member_name);
                                            if (iface_found.is_some()) {
                                                match_iface_names.push(iface.name);
                                            }
                                        }
                                    }
                                }
                                vi = vi + 1;
                            }
                            if (cast<i64>(match_iface_names.size()) > 1) {
                                this.model.some.report_error(new ErrorCode.E_INTERNAL(),
                                    "Ambiguous member '" + expr.member_name + "' on type '" + cls.name +
                                    "': provided by multiple implemented interfaces ('" +
                                    match_iface_names.at(cast<u64>(0)).some + "', '" +
                                    match_iface_names.at(cast<u64>(1)).some + "')",
                                    new SourceLocation("", 0, 0));
                                let ambig_result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(this.model.some.type_registry.make_error_type(), bound_base, expr.member_name, new Option<BoundSymbol>.none());
                                return new Option<BoundExpression>.some(new BoundExpression.member_access(ambig_result));
                            }
                            if (cast<i64>(match_iface_names.size()) == 1) {
                                // Exactly one interface provides the member — resolve it.
                                let vi2: mut i64 = 0;
                                while (vi2 < cast<i64>(vtables_src.size())) {
                                    let vtable: BoundVTable = vtables_src.at(cast<u64>(vi2)).some;
                                    let iface_type: BoundType = vtable.interface_type;
                                    if (let iface_def := iface_type.type_definition.some) {
                                        if (iface_def is BoundDefinition.interface_def) {
                                            let iface: BoundInterfaceDefinition = iface_def.interface_def;
                                            if (iface.scope.is_some()) {
                                                let iface_found: Option<BoundSymbol> = iface.scope.some.lookup_symbol(expr.member_name);
                                                if (iface_found.is_some()) {
                                                    let bt: BoundType = this.resolve_symbol_type(iface_found.some);
                                                    let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, iface_found);
                                                    return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                                                }
                                            }
                                        }
                                    }
                                    vi2 = vi2 + 1;
                                }
                            }
                        }
                    }
                    if (td is BoundDefinition.enum_def) {
                        let e: BoundEnumDefinition = td.enum_def;
                        if (e.scope.is_some()) {
                            let found: Option<BoundSymbol> = e.scope.some.lookup_symbol(expr.member_name);
                            if (let sym := found.some) {
                                let bt: mut BoundType = this.resolve_symbol_type(sym);
                                if (sym is BoundSymbol.enum_member) {
                                    // Prefer the enum definition's member_type, which
                                    // resolve_enum_types updates (pass 2). The scope
                                    // symbol's member_type can be stale (void) on the
                                    // BabyPenguin VM (pass1) because the value-copy
                                    // there does not propagate the mutation.
                                    bt = sym.enum_member.member_type;
                                    let midx: i64 = sym.enum_member.enum_value;
                                    if (midx >= 0 && midx < cast<i64>(e.members.size())) {
                                        bt = e.members.at(cast<u64>(midx)).some.member_type;
                                    }
                                    bt = this.model.some.substitute_generic_args(bt, base_type, new BoundDefinition.enum_def(e));
                                }
                                let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, found);
                                return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                            }
                        }
                        // For a generic base (Option<i64>), the #specializing-injected
                        // impl methods live in the SPECIALIZED scope (not the template's),
                        // so resolve them there — they lower to a direct call on the
                        // specialized impl (matching how normal `impl` methods resolve).
                        let spec_scope_found: Option<BoundSymbol> = this.lookup_specialized_scope_member(base_type, expr.member_name, scope);
                        if (spec_scope_found.is_some()) {
                            let bt: BoundType = this.resolve_symbol_type(spec_scope_found.some);
                            let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, spec_scope_found);
                            return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                        }
                        // Fallback: search implemented interface scopes for methods.
                        // For a generic base (Option<i64>), search the SPECIALIZED def's
                        // vtables — #specializing-injected impls live there, not on the
                        // template (whose vtables are empty).
                        let vtables_src: _utils.List<BoundVTable> = this.resolve_container_vtables(base_type, e.vtables, scope);
                        let vi: mut i64 = 0;
                        while (vi < cast<i64>(vtables_src.size())) {
                            let vtable: BoundVTable = vtables_src.at(cast<u64>(vi)).some;
                            let iface_type: BoundType = vtable.interface_type;
                            if (let iface_def := iface_type.type_definition.some) {
                                if (iface_def is BoundDefinition.interface_def) {
                                    let iface: BoundInterfaceDefinition = iface_def.interface_def;
                                    if (iface.scope.is_some()) {
                                        let iface_found: Option<BoundSymbol> = iface.scope.some.lookup_symbol(expr.member_name);
                                        if (iface_found.is_some()) {
                                            let bt: BoundType = this.resolve_symbol_type(iface_found.some);
                                            let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, iface_found);
                                            return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                                        }
                                    }
                                }
                            }
                            vi = vi + 1;
                        }
                    }
                    if (td is BoundDefinition.interface_def) {
                        let iface: BoundInterfaceDefinition = td.interface_def;
                        // For a generic interface base (e.g. f.bar() where f: IFoo<u8>),
                        // resolve through the specialized def (IFoo__u8) so method
                        // signatures use concrete types (T -> u8) and the symbol points
                        // to the specialized method (ns.IFoo__u8.bar). Falls back to
                        // the template scope for non-generic interfaces.
                        let search_scope: Option<BoundScope> = this.specialized_interface_scope(iface, base_type, scope);
                        if (search_scope.is_some()) {
                            let found: Option<BoundSymbol> = search_scope.some.lookup_symbol(expr.member_name);
                            if (found.is_some()) {
                                let bt: BoundType = this.resolve_symbol_type(found.some);
                                let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, found);
                                return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                            }
                        }
                    }
                }
                // Handle namespace-qualified access (e.g., Foo.msg where Foo is a namespace)
                if (bound_base.some is BoundExpression.identifier) {
                    let base_id: BoundIdentifierExpression = bound_base.some.identifier;
                    if (let base_sym := base_id.symbol.some) {
                        if (base_sym is BoundSymbol.namespace_sym) {
                            let ns_scope: Option<BoundScope> = base_sym.namespace_sym.namespace_scope;
                            if (ns_scope.is_some()) {
                                // Generic args on the namespaced member (`__builtin.Option<i64>.member`):
                                // resolve through the specialized def — see
                                // bind_namespaced_generic_type_member.
                                if (cast<i64>(expr.generic_args.size()) > 0) {
                                    let gen: Option<BoundExpression> = this.bind_namespaced_generic_type_member(ns_scope.some, expr, bound_base, scope);
                                    if (gen.is_some()) { return gen; }
                                }
                                let found: Option<BoundSymbol> = ns_scope.some.lookup_symbol(expr.member_name);
                                if (found.is_some()) {
                                    let bt: BoundType = this.resolve_symbol_type(found.some);
                                    let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, found);
                                    return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                                }
                            }
                        }
                    }
                }
                // Chained namespace access (depth >= 2, e.g. std.io.probe): the
                // inner member access (std.io) bound above as a member access
                // carrying the nested namespace symbol in member_symbol —
                // continue the namespace-qualified lookup from THAT scope.
                // Without this branch only one dot of namespace qualification
                // resolves and every deeper call falls to the void fallback.
                if (bound_base.some is BoundExpression.member_access) {
                    let inner_ma: BoundMemberAccessExpression = bound_base.some.member_access;
                    if (let inner_sym := inner_ma.member_symbol.some) {
                        if (inner_sym is BoundSymbol.namespace_sym) {
                            let inner_ns_scope: Option<BoundScope> = inner_sym.namespace_sym.namespace_scope;
                            if (inner_ns_scope.is_some()) {
                                // Generic args on the chained namespaced member
                                // (`std.ns.Enum<T>.member`): same specialized-def
                                // resolution as the single-namespace case above.
                                if (cast<i64>(expr.generic_args.size()) > 0) {
                                    let gen: Option<BoundExpression> = this.bind_namespaced_generic_type_member(inner_ns_scope.some, expr, bound_base, scope);
                                    if (gen.is_some()) { return gen; }
                                }
                                let found: Option<BoundSymbol> = inner_ns_scope.some.lookup_symbol(expr.member_name);
                                if (found.is_some()) {
                                    let bt: BoundType = this.resolve_symbol_type(found.some);
                                    let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, found);
                                    return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                                }
                            }
                        }
                    }
                }
                // Member not found: if base is a concrete type (class, enum),
                // report E_RESOLVE_SYMBOL instead of silently creating an empty
                // member access (which causes E_INTERNAL in the IR generator).
                // `.copy()` on a value type is auto-generated ICopy and is resolved
                // by bind_function_call, so don't report it here.
                let is_value_copy: bool = expr.member_name == "copy" && this.model.some.classify_value_types_pass.base_type_has_icopy(base_type);
                if (base_type.type_definition.is_some() && !is_value_copy) {
                    let td: BoundDefinition = base_type.type_definition.some;
                    if (td is BoundDefinition.class_def || td is BoundDefinition.enum_def) {
                        let tname: mut string = "?";
                        if (td is BoundDefinition.class_def) { tname = td.class_def.name; }
                        if (td is BoundDefinition.enum_def) { tname = td.enum_def.name; }
                        this.model.some.report_error(new ErrorCode.E_RESOLVE_SYMBOL(),
                            "Type '" + base_type.display_name() + "' has no member '" + expr.member_name + "'",
                            new SourceLocation("", 0, 0));
                    }
                }
                let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(new BoundType(), bound_base, expr.member_name, new Option<BoundSymbol>.none());
                return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
            }
        }
        let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(new BoundType(), new Option<BoundExpression>.none(), expr.member_name, new Option<BoundSymbol>.none());
        return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
    }


    // The inference callee for a member call: the receiver's SPECIALIZED
    // class's method symbol when the receiver is a generic instance (the
    // member symbol itself resolved from the TEMPLATE scope — specializing
    // that def leaves `this` as the template type), else the fallback symbol.
    fun infer_member_callee_sym(mut this, base_opt: Option<BoundExpression>, method_name: string, fallback: BoundFunctionSymbol, scope: mut BoundScope) -> mut BoundFunctionSymbol {
        if (base_opt.is_none()) { return fallback; }
        let recv_bt: BoundType = base_opt.some.get_bound_type();
        if (cast<i64>(recv_bt.generic_args.size()) == 0 || recv_bt.type_definition.is_none()) { return fallback; }
        let spec_def2: Option<BoundDefinition> = this.ensure_receiver_class_spec(recv_bt, scope);
        if (spec_def2.is_some() && spec_def2.some is BoundDefinition.class_def) {
            let spec_cls2: BoundClassDefinition = spec_def2.some.class_def;
            let mi3: mut i64 = 0;
            while (mi3 < cast<i64>(spec_cls2.methods.size())) {
                let smd: BoundDefinition = spec_cls2.methods.at(cast<u64>(mi3)).some;
                if (smd is BoundDefinition.function_def) {
                    if (smd.function_def.name == method_name && smd.function_def.symbol.is_some()) {
                        return smd.function_def.symbol.some;
                    }
                }
                mi3 = mi3 + 1;
            }
        }
        return fallback;
    }

    // Ensure the specialized def of a template+args receiver type exists —
    // created on demand, resolved at the monomorphize pass index, signature-
    // caught-up, and registered for the dynamic pass-8 body loop (the
    // bind_new_expr on-demand protocol). Generic-method inference must
    // specialize methods UNDER the specialized class (this = the spec type),
    // never the template.
    fun ensure_receiver_class_spec(mut this, recv_bt: BoundType, scope: mut BoundScope) -> Option<BoundDefinition> {
        if (this.model.some.current_unit.is_none()) { return new Option<BoundDefinition>.none(); }
        let td: BoundDefinition = recv_bt.type_definition.some;
        let full_base: mut string = "";
        let tmpl_short: mut string = "";
        if (td is BoundDefinition.class_def) { full_base = td.class_def.full_name; tmpl_short = td.class_def.name; }
        if (td is BoundDefinition.enum_def) { full_base = td.enum_def.full_name; tmpl_short = td.enum_def.name; }
        if (string_length(full_base) == 0) { return new Option<BoundDefinition>.none(); }
        let mangled: string = MonomorphizePass.mangle_generic_name(full_base, recv_bt.generic_args);
        let existing: Option<BoundSymbol> = this.model.some.global_scope.lookup_type_in_scope(mangled);
        if (existing.is_some() && existing.some is BoundSymbol.type_sym) {
            if (existing.some.type_sym.bound_type.type_definition.is_some()) {
                return existing.some.type_sym.bound_type.type_definition;
            }
        }
        let spec: Option<BoundDefinition> = this.model.some.monomorphize_pass.ensure_specialized_def(recv_bt, this.model.some.global_scope);
        if (spec.is_none()) { return new Option<BoundDefinition>.none(); }
        let ast_spec: Option<Definition> = this.model.some.monomorphize_pass.find_ast_def_by_name(this.model.some.ast_definitions, tmpl_short);
        let m1: mut SemanticModel = this.model.some;
        let saved_idx: i64 = m1.current_pass_index;
        if (ast_spec.is_some()) {
            m1.current_pass_index = 3;
            let to_register: BoundDefinition = m1.resolve_types_pass.resolve_pair(ast_spec.some, spec.some, this.spec_resolve_scope(spec.some));
            m1.current_pass_index = saved_idx;
            m1.catch_up_def_before_bodies(to_register, m1.current_unit.some);
            m1.current_unit.some.definitions.push(to_register);
            return new Option<BoundDefinition>.some(to_register);
        }
        m1.catch_up_def_before_bodies(spec.some, m1.current_unit.some);
        m1.current_unit.some.definitions.push(spec.some);
        return new Option<BoundDefinition>.some(spec.some);
    }

    // Substitute a template CLASS's type params inside `bt` — the template
    // method's resolved return type (e.g. Option<U>) — with the receiver's
    // generic args (a MapIterator<i64,i64> receiver -> Option<i64>). Used by
    // the member-call return-type refresh when the specialized def doesn't
    // exist yet (see the refresh site); display-name param matching mirrors
    // substitute_generic_args.
    fun substitute_class_params_type(this, bt: BoundType, cls: BoundClassDefinition, args: _utils.List<BoundTypeArg>) -> mut BoundType {
        let dn: string = bt.display_name();
        let pi: mut i64 = 0;
        while (pi < cast<i64>(cls.generic_params.size()) && pi < cast<i64>(args.size())) {
            if (dn == cls.generic_params.at(cast<u64>(pi)).some) {
                return arg_as_bound_type(args.at(cast<u64>(pi)).some);
            }
            pi = pi + 1;
        }
        if (cast<i64>(bt.generic_args.size()) > 0) {
            let new_args: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
            let changed: mut bool = false;
            let gi: mut i64 = 0;
            while (gi < cast<i64>(bt.generic_args.size())) {
                let one_arg: BoundTypeArg = bt.generic_args.at(cast<u64>(gi)).some;
                if (!arg_is_value(one_arg)) {
                    let before_dn: string = arg_as_bound_type(one_arg).display_name();
                    let sub: BoundType = this.substitute_class_params_type(arg_as_bound_type(one_arg), cls, args);
                    if (sub.display_name() != before_dn) { changed = true; }
                    new_args.push(make_type_arg(sub));
                } else {
                    new_args.push(one_arg);
                }
                gi = gi + 1;
            }
            if (changed) {
                return bt.with_generic_args(new_args);
            }
        }
        return bt;
    }

    fun find_function_return_type(this, sym: mut BoundFunctionSymbol) -> BoundType {
        _utils.trace_enter("Enter find_function_return_type");
        if (sym.resolved_return_type.is_some()) {
            return sym.resolved_return_type.some;
        }
        if (this.model.some.current_unit.is_some()) {
            let found: BoundType = this.search_function_return_type_in_defs(sym.full_name, this.model.some.current_unit.some.definitions);
            if (found.kind is TypeKind.PrimitiveKind) {
                let pt: PrimitiveType = found.primitive;
                if (pt is PrimitiveType.VoidType) {
                    // The def search yielded void — either the function genuinely
                    // returns void, or (for builtin-registered externs whose
                    // declaration lives in a namespace, e.g. gc_info at
                    // <global>.gc_info vs its <global>.__builtin.gc_info
                    // def) no matching def was found. The symbol's own return_type is
                    // authoritative in both cases, so prefer it (returning `found`
                    // here would wrongly make every such call void-typed).
                    sym.resolved_return_type = new Option<BoundType>.some(sym.return_type);
                    return sym.return_type;
                } else {
                    sym.resolved_return_type = new Option<BoundType>.some(found);
                }
                return found;
            } else {
                sym.resolved_return_type = new Option<BoundType>.some(found);
                return found;
            }
        }
        return sym.return_type;
    }


    fun is_nonvoid_type(this, t: BoundType) -> bool {
        if (t.kind is TypeKind.PrimitiveKind) {
            return !(t.primitive is PrimitiveType.VoidType);
        }
        return true;
    }


    fun search_function_return_type_in_defs(this, target_full_name: string, defs: mut _utils.List<BoundDefinition>) -> BoundType {
        _utils.trace_enter("Enter search_function_return_type_in_defs");
        let i: mut i64 = 0;
        while (i < cast<i64>(defs.size())) {
            let def: BoundDefinition = defs.at(cast<u64>(i)).some;
            if (def is BoundDefinition.function_def) {
                if (def.function_def.full_name == target_full_name) {
                    return def.function_def.return_type;
                }
            }
            if (def is BoundDefinition.namespace_def) {
                let ns_result: BoundType = this.search_function_return_type_in_defs(target_full_name, def.namespace_def.children);
                if (this.is_nonvoid_type(ns_result)) {
                    return ns_result;
                }
            }
            if (def is BoundDefinition.class_def) {
                let cls_result: BoundType = this.search_function_return_type_in_defs(target_full_name, def.class_def.methods);
                if (this.is_nonvoid_type(cls_result)) {
                    return cls_result;
                }
                let ctor_result: BoundType = this.search_function_return_type_in_defs(target_full_name, def.class_def.constructors);
                if (this.is_nonvoid_type(ctor_result)) {
                    return ctor_result;
                }
                let cls_impl_result: BoundType = this.search_function_return_type_in_defs(target_full_name, def.class_def.interface_impls);
                if (this.is_nonvoid_type(cls_impl_result)) {
                    return cls_impl_result;
                }
            }
            // Impl methods (`impl I for ...` and primitive `impl I for i64`):
            // their symbols can be stale snapshots (e.g. the primitive_impl
            // registry captures the pre-pass-2 symbol whose return_type is still
            // void); the def-side return_type IS resolved by pass 2, so searching
            // the methods recovers the authoritative type regardless of object
            // identity/sharing between the registry and the definition.
            if (def is BoundDefinition.impl_for_def) {
                let impl_for_result: BoundType = this.search_function_return_type_in_defs(target_full_name, def.impl_for_def.methods);
                if (this.is_nonvoid_type(impl_for_result)) {
                    return impl_for_result;
                }
            }
            if (def is BoundDefinition.impl_def) {
                let impl_result: BoundType = this.search_function_return_type_in_defs(target_full_name, def.impl_def.methods);
                if (this.is_nonvoid_type(impl_result)) {
                    return impl_result;
                }
            }
            if (def is BoundDefinition.enum_def) {
                let enum_impl_result: BoundType = this.search_function_return_type_in_defs(target_full_name, def.enum_def.interface_impls);
                if (this.is_nonvoid_type(enum_impl_result)) {
                    return enum_impl_result;
                }
            }
            i = i + 1;
        }
        return this.model.some.type_registry.void_type;
    }


    // A function is a "method" (instance member) iff its first parameter is
    // `this`. Free functions / static helpers declared inside a class have no
    // `this` parameter. function_sym.parameters is populated for every function
    // in bind_function_symbols (and for externs at registration).
    fun function_is_method(this, sym: BoundFunctionSymbol) -> bool {
        _utils.trace_enter("Enter function_is_method");
        if (cast<i64>(sym.parameters.size()) > 0) {
            return sym.parameters.at(cast<u64>(0)).some.name == "this";
        }
        return false;
    }


    // Single-letter uppercase names are the generic template param convention
    // (T, K, E, V). Used to skip arg-type checks against unsubstituted template
    // params, which would otherwise produce cascading false positives.
    // True when `bt`'s type_definition is a template-param dummy — a
    // BoundClassDefinition created solely when a generic parameter is declared in
    // a scope (`#template(T: type)` registers T as a dummy class with no AST
    // source, fields, methods, or vtables). Real types always go through
    // bind_class_def / specialize_class_def, which set ast_source, so they never
    // match. This is strictly "is this the scope-registered template param",
    // not a name guess — a real type named `T` is not a template param.
    fun is_template_param_type(this, bt: BoundType) -> bool {
        if (bt.kind is TypeKind.ClassKind && bt.type_definition.is_some()) {
            let td: BoundDefinition = bt.type_definition.some;
            if (td is BoundDefinition.class_def) {
                let cls: BoundClassDefinition = td.class_def;
                if (cls.ast_source.is_none()
                    && cast<i64>(cls.fields.size()) == 0
                    && cast<i64>(cls.methods.size()) == 0
                    && cast<i64>(cls.vtables.size()) == 0) {
                    return true;
                }
            }
        }
        return false;
    }


    // True when a type (or a generic arg nested in it) is an unsubstituted
    // template param (e.g. `T` or `Option<T>`). Such params can't be checked
    // against call args until the callee is monomorphized.
    fun param_type_is_template(this, param_type: BoundType) -> bool {
        if (this.is_template_param_type(param_type)) {
            return true;
        }
        let gi: mut i64 = 0;
        while (gi < cast<i64>(param_type.generic_args.size())) {
            if (this.param_type_is_template(arg_as_bound_type(param_type.generic_args.at(cast<u64>(gi)).some))) {
                return true;
            }
            gi = gi + 1;
        }
        return false;
    }


    // Check each call argument against the callee's parameter type, reporting
    // E_CAST_INVALID on a non-implicitly-castable mismatch (BabyPenguin: convertParams).
    // Integer literals coerce to any integer param type; args whose bound type is
    // void/error (from a prior diagnostic) and generic template params (T unsubstituted)
    // are skipped to avoid cascading false positives.
    // Check call arguments against a fun VALUE's type (`fun<...>`: arg 0 is
    // the return type, the rest are the parameter types). Arity and implicit
    // castability per argument; reports E_CALL_ARITY / E_TYPE_MISMATCH.
    fun check_fun_value_args(mut this, ftype: BoundType, args: mut _utils.List<BoundExpression>, loc: SourceLocation) {
        let param_count: i64 = cast<i64>(ftype.generic_args.size()) - 1;
        let arg_count: i64 = cast<i64>(args.size());
        if (arg_count != param_count) {
            this.model.some.report_error(new ErrorCode.E_CALL_ARITY(),
                "Function value expects " + cast<string>(param_count)
                + " arguments but " + cast<string>(arg_count) + " were provided",
                loc);
            return;
        }
        let i: mut i64 = 0;
        while (i < arg_count) {
            let param_type: BoundType = arg_as_bound_type(ftype.generic_args.at(cast<u64>(i + 1)).some);
            let arg_expr: BoundExpression = args.at(cast<u64>(i)).some;
            let arg_type: BoundType = arg_expr.get_bound_type();
            if (this.model.some.type_registry.is_void(param_type) || this.model.some.type_registry.is_void(arg_type)
                || param_type.kind is TypeKind.ErrorKind || arg_type.kind is TypeKind.ErrorKind) {
                i = i + 1;
                continue;
            }
            // Integer literals coerce to any integer parameter type (the IR
            // layer re-types constants in the destination register type) —
            // same relaxation as check_argument_types.
            let is_int_lit: bool = if (arg_expr is BoundExpression.literal) {
                arg_expr.literal.literal_kind is LiteralKind.IntegerLiteral
            } else {
                false
            };
            if (!this.model.some.type_registry.can_implicitly_cast(arg_type, param_type)
                && !(is_int_lit && this.model.some.type_registry.is_integer(param_type))) {
                this.model.some.report_error(new ErrorCode.E_TYPE_MISMATCH(),
                    "Cannot convert argument " + cast<string>(i + 1) + " of type "
                    + arg_type.display_name() + " to parameter type " + param_type.display_name(),
                    loc);
            }
            i = i + 1;
        }
    }

    fun check_argument_types(mut this, sym: BoundFunctionSymbol, args: mut _utils.List<BoundExpression>) {
        _utils.trace_enter("Enter check_argument_types");
        let arg_i: mut i64 = 0;
        while (arg_i < cast<i64>(args.size())) {
            let param_idx: mut i64 = arg_i;
            if (this.function_is_method(sym)) {
                param_idx = arg_i + 1;
            }
            if (param_idx < cast<i64>(sym.parameters.size())) {
                let param_type: BoundType = sym.parameters.at(cast<u64>(param_idx)).some.bound_type;
                let arg_expr: BoundExpression = args.at(cast<u64>(arg_i)).some;
                let arg_type: BoundType = arg_expr.get_bound_type();
                if (this.model.some.type_registry.is_void(param_type) || this.model.some.type_registry.is_void(arg_type)
                    || param_type.kind is TypeKind.ErrorKind || arg_type.kind is TypeKind.ErrorKind) {
                    arg_i = arg_i + 1;
                    continue;
                }
                if (this.param_type_is_template(param_type)) {
                    arg_i = arg_i + 1;
                    continue;
                }
                // Implicit value-type -> interface argument conversion BOXES
                // (copies) — the callee's mut-this writes must not reach the
                // caller's storage (mirrors explicit cast<> and the VM).
                if (param_type.kind is TypeKind.InterfaceKind && arg_type.is_value_type()) {
                    let box_cast: BoundCastExpression = this.build_cast_bound(arg_expr, param_type);
                    args.set(cast<u64>(arg_i), new BoundExpression.cast_expr(box_cast));
                    arg_i = arg_i + 1;
                    continue;
                }
                let is_int_lit: bool = if (arg_expr is BoundExpression.literal) {
                    arg_expr.literal.literal_kind is LiteralKind.IntegerLiteral
                } else if (arg_expr is BoundExpression.unary) {
                    // Negative integer literal: `-1` binds as a unary negation of a
                    // literal, which should coerce to an integer param like `0` does.
                    arg_expr.unary.operator_value is UnaryOperator.Negate
                    && arg_expr.unary.operand.is_some()
                    && arg_expr.unary.operand.some is BoundExpression.literal
                    && arg_expr.unary.operand.some.literal.literal_kind is LiteralKind.IntegerLiteral
                } else {
                    false
                };
                let int_literal_coercion: bool = is_int_lit && this.model.some.type_registry.is_integer(param_type);
                if (!this.model.some.type_registry.can_implicitly_cast(arg_type, param_type) && !int_literal_coercion) {
                    this.model.some.report_error(new ErrorCode.E_CAST_INVALID(),
                        "Argument " + cast<string>(arg_i + 1) + " type mismatch in '" + sym.name + "': expected " + param_type.display_name() + " but got " + arg_type.display_name(),
                        sym.location);
                }
            }
            arg_i = arg_i + 1;
        }
    }


    // The fd park externs (`__builtin._fd_wait_read/_fd_wait_write`) suspend
    // the current coroutine at runtime — to the scheduler they ARE waits even
    // though they are plain extern calls syntactically. Mark the unit as
    // suspending (emit_main then runs initials on the coroutine scheduler)
    // and apply the same --enable-coroutine gate as the wait forms.
    fun mark_fd_park_suspension(mut this, sym: BoundFunctionSymbol) {
        if (sym.full_name == "<global>.__builtin._fd_wait_read" || sym.full_name == "<global>.__builtin._fd_wait_write") {
            let m: mut SemanticModel = this.model.some;
            if (m.require_coroutine("fd wait", sym.location)) {
                m.has_suspension = true;
            }
        }
    }

    fun bind_function_call(mut this, expr: FunctionCallExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_function_call");
        // mut-this core methods (bind_meta_call / resolve_type_name) need a
        // mutable SemanticModel: rebind the Option payload once here.
        let m: mut SemanticModel = this.model.some;
        // req3+4: a value-template call — the callee identifier carries
        // value_generic_args (fab<5>(), fab<N-1>()). At a host call site the callee
        // is a #fun (meta function), so splice as a meta call. Inside a #fun body
        // (compiled as unit B) the callee is an ordinary function, so the value args
        // become ordinary call arguments: fab<N-1>() -> fab(N-1).
        if (expr.callee.is_some()) {
            if (expr.callee.some is Expression.identifier) {
                let vid: IdentifierExpression = expr.callee.some.identifier;
                if (cast<i64>(vid.value_generic_args.size()) > 0) {
                    if (this.model.some.bind_meta_calls_pass.find_meta_function(vid.name).is_some()) {
                        let mc: mut MetaCallExpression = new MetaCallExpression();
                        mc.func_name = vid.name;
                        mc.location = new SourceLocation("", 0, 0);
                        let vi: mut i64 = 0;
                        while (vi < cast<i64>(vid.value_generic_args.size())) {
                            mc.arguments.push(vid.value_generic_args.at(cast<u64>(vi)).some);
                            vi = vi + 1;
                        }
                        return m.bind_meta_calls_pass.bind_meta_call(mc, scope);
                    }
                    // D6: a value-template function call (filled<3>()) — resolve the
                    // value args to value BoundTypeArgs, mangle to the specialized name
                    // (filled__3), and re-bind as a plain call to the specialized
                    // function (which monomorphize already created + registered).
                    let resolved_args: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
                    let vai: mut i64 = 0;
                    while (vai < cast<i64>(vid.value_generic_args.size())) {
                        let varg: Expression = vid.value_generic_args.at(cast<u64>(vai)).some;
                        resolved_args.push(this.model.some.meta_rewriter.value_expr_to_bound_type(varg));
                        vai = vai + 1;
                    }
                    // Full base from the function symbol (mangle encodes it).
                    let v_full: mut string = vid.name;
                    let vsym: Option<BoundSymbol> = scope.lookup_symbol(vid.name);
                    if (vsym.is_some() && vsym.some is BoundSymbol.function_sym) {
                        v_full = vsym.some.function_sym.full_name;
                    }
                    let mangled: string = MonomorphizePass.mangle_generic_name(v_full, resolved_args);
                    let rewritten: mut FunctionCallExpression = new FunctionCallExpression();
                    let clean_callee: mut IdentifierExpression = new IdentifierExpression(mangled);
                    rewritten.callee = new Option<Expression>.some(new Expression.identifier(clean_callee));
                    let oi: mut i64 = 0;
                    while (oi < cast<i64>(expr.arguments.items.size())) {
                        rewritten.arguments.push(expr.arguments.items.at(cast<u64>(oi)).some);
                        oi = oi + 1;
                    }
                    return this.bind_function_call(rewritten, scope);
                }
            }
        }
        let args: mut _utils.List<BoundExpression> = this.bind_arguments(expr.arguments.items, scope);
        let mut empty_generic_args = new _utils.List<BoundType>();
        if (expr.callee.is_some()) {
            let callee: Option<BoundExpression> = this.bind_expression(expr.callee.some, scope);
            if (callee.is_some()) {
                if (callee.some is BoundExpression.identifier) {
                    let id_expr: BoundIdentifierExpression = callee.some.identifier;
                    if (let sym := id_expr.symbol.some) {
                        if (sym is BoundSymbol.function_sym) {
                            // Converse mismatch: a method (has `this`) called bare
                            // (no receiver) would emit no `this` argument, so the
                            // callee's first parameter reads garbage. Require an
                            // explicit receiver: this.method(...) or obj.method(...).
                            if (this.function_is_method(sym.function_sym)) {
                                this.model.some.report_error(new ErrorCode.E_CALL_CONVENTION(), "Method '" + sym.function_sym.name + "' has a 'this' parameter and must be called with a receiver (e.g. this." + sym.function_sym.name + "(...)), not bare", sym.function_sym.location);
                            }
                            this.mark_fd_park_suspension(sym.function_sym);
                            // Resolve generic args from AST callee
                            let resolved_generic_args: mut _utils.List<BoundType> = new _utils.List<BoundType>();
                            let is_generic_call: mut bool = false;
                            if (let ast_callee := expr.callee.some) {
                                if (ast_callee is Expression.identifier) {
                                    if (cast<i64>(ast_callee.identifier.generic_args.size()) > 0) {
                                        is_generic_call = true;
                                        let gi: mut i64 = 0;
                                        while (gi < cast<i64>(ast_callee.identifier.generic_args.size())) {
                                            resolved_generic_args.push(this.model.some.resolve_type_specifier(ast_callee.identifier.generic_args.at(cast<u64>(gi)).some, scope));
                                            gi = gi + 1;
                                        }
                                    }
                                }
                            }
                            // For generic function calls, use specialized function's return type
                            if (is_generic_call) {
                                let type_arg_wrap: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
                                let wi: mut i64 = 0;
                                while (wi < cast<i64>(resolved_generic_args.size())) {
                                    let a: mut BoundType = resolved_generic_args.at(cast<u64>(wi)).some;
                                    type_arg_wrap.push(make_type_arg(a));
                                    wi = wi + 1;
                                }
                                let mangled: string = MonomorphizePass.mangle_generic_name(sym.function_sym.full_name, type_arg_wrap);
                                let spec_sym: Option<BoundSymbol> = scope.lookup_symbol(mangled);
                                if (spec_sym.is_some() && spec_sym.some is BoundSymbol.function_sym) {
                                    let spec_func_sym: mut BoundFunctionSymbol = spec_sym.some.function_sym;
                                    let bt: mut BoundType = this.find_function_return_type(spec_func_sym);
                                    let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(bt, callee, id_expr.symbol, args, false, resolved_generic_args, true);
                                    return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
                                }
                            }
                            // Inference fallback: a TEMPLATE callee called without explicit
                            // <...> args — solve the type parameters from the argument types
                            // (direct, fun-typed, same-base container matches) and dispatch to
                            // the (created-on-demand) specialization.
                            if (!is_generic_call) {
                                let inferred_types: mut _utils.List<BoundType> = new _utils.List<BoundType>();
                                let spec_sym_inf: Option<BoundFunctionSymbol> = this.try_infer_generic_call(sym.function_sym, args, false, scope, inferred_types);
                                if (spec_sym_inf.is_some()) {
                                    let inf_sym: mut BoundFunctionSymbol = spec_sym_inf.some;
                                    let inf_bt: mut BoundType = this.find_function_return_type(inf_sym);
                                    let inf_result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(inf_bt, callee, id_expr.symbol, args, false, inferred_types, true);
                                    return new Option<BoundExpression>.some(new BoundExpression.function_call(inf_result));
                                }
                            }
                            // Check argument count
                            let param_count: i64 = cast<i64>(sym.function_sym.parameters.size());
                            let arg_count: i64 = cast<i64>(args.size());
                            let expected_args: mut i64 = param_count;
                            if (this.function_is_method(sym.function_sym)) {
                                expected_args = param_count - 1;
                            }
                            if (arg_count != expected_args) {
                                this.model.some.report_error(new ErrorCode.E_CALL_ARITY(),
                                    "Function '" + sym.function_sym.name + "' expects " + cast<string>(expected_args)
                                    + " arguments but " + cast<string>(arg_count) + " were provided",
                                    sym.function_sym.location);
                            }
                            this.check_argument_types(sym.function_sym, args);
                            let bt: mut BoundType = this.find_function_return_type(sym.function_sym);
                            let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(bt, callee, id_expr.symbol, args, false, resolved_generic_args, false);
                            return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
                        }
                        if (sym is BoundSymbol.variable) {
                            // fun-typed VARIABLE call: `f(21)` where `f` is a
                            // local/param of type `fun<...>` — call through the
                            // function value (a callable object). Mirrors the
                            // fun-typed FIELD branch below: return type is
                            // generic_args[0], the rest are parameter types.
                            let ftype: BoundType = sym.variable.bound_type;
                            if (ftype.kind is TypeKind.FunctionKind) {
                                let ret: mut BoundType = this.model.some.type_registry.void_type;
                                if (cast<i64>(ftype.generic_args.size()) > 0) {
                                    ret = arg_as_bound_type(ftype.generic_args.at(cast<u64>(0)).some);
                                }
                                this.check_fun_value_args(ftype, args, sym.variable.location);
                                let empty_ga2: mut _utils.List<BoundType> = new _utils.List<BoundType>();
                                let fvc: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(ret, callee, id_expr.symbol, args, false, empty_ga2, false);
                                return new Option<BoundExpression>.some(new BoundExpression.function_call(fvc));
                            }
                        }
                    }
                }
                if (callee.some is BoundExpression.member_access) {
                    let ma_expr: BoundMemberAccessExpression = callee.some.member_access;
                    // `.copy()` on a value type (primitive with ICopy, value-class,
                    // or enum) is an auto-generated ICopy copy. Value types copy on
                    // assignment anyway, so lower the call to the base expression
                    // itself — no runtime function call is needed.
                    if (ma_expr.member_name == "copy" && ma_expr.base_expr.is_some()) {
                        let base_type: BoundType = ma_expr.base_expr.some.get_bound_type();
                        if (this.model.some.classify_value_types_pass.base_type_has_icopy(base_type)) {
                            return new Option<BoundExpression>.some(ma_expr.base_expr.some);
                        }
                    }
                    if (let sym := ma_expr.member_symbol.some) {
                        if (sym is BoundSymbol.variable) {
                            // fun-typed FIELD call: `h.cb(21)` where
                            // `cb: mut fun<i32, i32>` — the field holds a fat
                            // function pointer. Bind as a call whose callee is
                            // the field access, returning the fun type's
                            // return type (generic_args[0]; the rest are the
                            // parameter types).
                            let ftype: BoundType = sym.variable.bound_type;
                            if (ftype.kind is TypeKind.FunctionKind) {
                                let ret: mut BoundType = this.model.some.type_registry.void_type;
                                if (cast<i64>(ftype.generic_args.size()) > 0) {
                                    ret = arg_as_bound_type(ftype.generic_args.at(cast<u64>(0)).some);
                                }
                                let empty_ga: mut _utils.List<BoundType> = new _utils.List<BoundType>();
                                let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(ret, callee, ma_expr.member_symbol, args, false, empty_ga, false);
                                return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
                            }
                        }
                        if (sym is BoundSymbol.function_sym) {
                            this.mark_fd_park_suspension(sym.function_sym);
                            // A member function whose first parameter is not `this`
                            // may still be called via `receiver.foo(...)` -- the
                            // receiver is simply discarded at the call site (not
                            // passed). For interface-typed receivers the receiver is
                            // still used for vtable lookup (virtual dispatch), set in
                            // the dispatch-decision block below.
                            // Mutability check: calling `mut this` method on a receiver
                            // whose TYPE is immutable must fail (E_TYPE_MISMATCH), e.g.
                            // `let a : A = new A(); a.mutable()`. BabyPenguin compares
                            // the receiver's TYPE mutability against the `mut this` param
                            // ("Cant use !mut A as 'this' param of type mut A"), so an
                            // inferred `let mut a = new A()` (type is mutable) is allowed.
                            if (this.function_is_method(sym.function_sym) && ma_expr.base_expr.is_some()) {
                                let this_param: BoundFunctionParameter = sym.function_sym.parameters.at(cast<u64>(0)).some;
                                if (this_param.is_mutable) {
                                    let base_type: BoundType = ma_expr.base_expr.some.get_bound_type();
                                    if (base_type.mutability is Mutability.Immutable) {
                                        this.model.some.report_error(new ErrorCode.E_TYPE_MISMATCH(),
                                            "Cannot call method '" + sym.function_sym.name + "' with 'mut this' on an immutable binding",
                                            sym.function_sym.location);
                                    }
                                }
                            }
                            // Resolve generic args from AST callee (member access with <T>)
                            let resolved_generic_args: mut _utils.List<BoundType> = new _utils.List<BoundType>();
                            let is_generic_method_call: mut bool = false;
                            if (let ast_callee := expr.callee.some) {
                                if (ast_callee is Expression.member_access) {
                                    if (cast<i64>(ast_callee.member_access.generic_args.size()) > 0) {
                                        is_generic_method_call = true;
                                        let gi: mut i64 = 0;
                                        while (gi < cast<i64>(ast_callee.member_access.generic_args.size())) {
                                            resolved_generic_args.push(this.model.some.resolve_type_specifier(ast_callee.member_access.generic_args.at(cast<u64>(gi)).some, scope));
                                            gi = gi + 1;
                                        }
                                    }
                                }
                            }
                            // For generic method calls, look up specialized method
                            if (is_generic_method_call) {
                                let type_arg_wrap: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
                                let wi: mut i64 = 0;
                                while (wi < cast<i64>(resolved_generic_args.size())) {
                                    let a: mut BoundType = resolved_generic_args.at(cast<u64>(wi)).some;
                                    type_arg_wrap.push(make_type_arg(a));
                                    wi = wi + 1;
                                }
                                // Prefer the receiver's SPECIALIZED class method (a
                                // template+args receiver's member symbol is template-
                                // scoped; specializing it leaves `this` unresolved).
                                let gen_callee: mut BoundFunctionSymbol = this.infer_member_callee_sym(ma_expr.base_expr, sym.function_sym.name, sym.function_sym, scope);
                                let mangled: string = MonomorphizePass.mangle_generic_name(gen_callee.full_name, type_arg_wrap);
                                let spec_sym: Option<BoundSymbol> = scope.lookup_symbol(mangled);
                                if (spec_sym.is_some() && spec_sym.some is BoundSymbol.function_sym) {
                                    let spec_func_sym: mut BoundFunctionSymbol = spec_sym.some.function_sym;
                                    let bt: mut BoundType = this.find_function_return_type(spec_func_sym);
                                    // Spec symbol's name is already mangled — plain call
                                    // (is_generic_function_call would mangle it a second time).
                                    let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(bt, callee, spec_sym, args, false, new _utils.List<BoundType>(), false);
                                    return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
                                }
                                // Bind-time creation: explicit-arg method calls on
                                // bind-time-born receivers (the inferred map just
                                // returned a MapIterator whose spec class exists only
                                // since this expression) were never collected by the
                                // pass-3 fixpoint — create the specialization now.
                                let gen_tmpl_def: Option<BoundDefinition> = this.find_function_def_in_defs(gen_callee.full_name, this.model.some.current_unit.some.definitions);
                                if (gen_tmpl_def.is_some() && this.model.some.current_unit.is_some()) {
                                    let ensured2: Option<BoundFunctionSymbol> = this.model.some.monomorphize_pass.ensure_function_specialization_now(gen_tmpl_def.some, type_arg_wrap, this.model.some.current_unit.some);
                                    if (ensured2.is_some()) {
                                        let ens_bt: mut BoundType = this.find_function_return_type(ensured2.some);
                                        let ens_result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(ens_bt, callee, new Option<BoundSymbol>.some(new BoundSymbol.function_sym(ensured2.some)), args, false, new _utils.List<BoundType>(), false);
                                        return new Option<BoundExpression>.some(new BoundExpression.function_call(ens_result));
                                    }
                                }
                            }
                            // Inference fallback for generic METHODS called without explicit
                            // <...> args (map/filter/reduce on the concrete iterator classes).
                            if (!is_generic_method_call) {
                                // A receiver spelled template+args (MapIterator<i64,i64>)
                                // resolves its member symbol from the TEMPLATE scope;
                                // specializing THAT def attaches the method to the
                                // template class — `this` stays the template type and
                                // every this.x() call inside the specialized body
                                // mis-resolves. Prefer the receiver's SPECIALIZED
                                // class's own method def.
                                let infer_sym: mut BoundFunctionSymbol = this.infer_member_callee_sym(ma_expr.base_expr, sym.function_sym.name, sym.function_sym, scope);
                                let inferred_types2: mut _utils.List<BoundType> = new _utils.List<BoundType>();
                                let spec_sym_inf2: Option<BoundFunctionSymbol> = this.try_infer_generic_call(infer_sym, args, true, scope, inferred_types2);
                                if (spec_sym_inf2.is_some()) {
                                    let inf_sym2: mut BoundFunctionSymbol = spec_sym_inf2.some;
                                    let inf_bt2: mut BoundType = this.find_function_return_type(inf_sym2);
                                    // The callee symbol must be the SPECIALIZATION's symbol:
                                    // IR mangles the call from callee_symbol.full_name, and the
                                    // member symbol (template-scoped) would name a function
                                    // nobody emitted (undefined at link). The spec symbol's
                                    // name is ALREADY mangled — pass it as a plain (non-
                                    // generic) call so IRGen does not mangle it a second time.
                                    let inf_result2: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(inf_bt2, callee, new Option<BoundSymbol>.some(new BoundSymbol.function_sym(inf_sym2)), args, false, new _utils.List<BoundType>(), false);
                                    return new Option<BoundExpression>.some(new BoundExpression.function_call(inf_result2));
                                }
                            }
                            let bt: mut BoundType = this.find_function_return_type(sym.function_sym);
                            // Look up updated return type from class method definitions
                            if (ma_expr.base_expr.is_some()) {
                                let base_type: BoundType = ma_expr.base_expr.some.get_bound_type();
                                // For generic types, look up the specialized definition
                                if (cast<i64>(base_type.generic_args.size()) > 0 && base_type.type_definition.is_some()) {
                                    let orig_def: BoundDefinition = base_type.type_definition.some;
                                    // A GENERIC INTERFACE base (cast<ISource<i64>>(x).current())
                                    // carries the TEMPLATE def: its methods keep unresolved
                                    // returns. The specialized interface def holds the
                                    // resolved signatures.
                                    if (orig_def is BoundDefinition.interface_def) {
                                        let gen_iface: BoundInterfaceDefinition = orig_def.interface_def;
                                        let gsi_name: string = MonomorphizePass.mangle_generic_name(gen_iface.full_name, base_type.generic_args);
                                        let gsi_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(gsi_name);
                                        if (gsi_sym.is_some() && gsi_sym.some is BoundSymbol.type_sym) {
                                            let gsi_type: BoundType = gsi_sym.some.type_sym.bound_type;
                                            if (gsi_type.type_definition.is_some() && gsi_type.type_definition.some is BoundDefinition.interface_def) {
                                                let gsi_def: BoundInterfaceDefinition = gsi_type.type_definition.some.interface_def;
                                                let gsi: mut i64 = 0;
                                                while (gsi < cast<i64>(gsi_def.methods.size())) {
                                                    let gmd: BoundDefinition = gsi_def.methods.at(cast<u64>(gsi)).some;
                                                    if (gmd is BoundDefinition.function_def) {
                                                        if (gmd.function_def.name == sym.function_sym.name) {
                                                            bt = gmd.function_def.return_type;
                                                        }
                                                    }
                                                    gsi = gsi + 1;
                                                }
                                            }
                                        }
                                    }
                                    if (orig_def is BoundDefinition.enum_def) {
                                        let spec_name: string = MonomorphizePass.mangle_generic_name(orig_def.enum_def.full_name, base_type.generic_args);
                                        let spec_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(spec_name);
                                        if (spec_sym.is_some()) {
                                            if (spec_sym.some is BoundSymbol.type_sym) {
                                                let spec_type: BoundType = spec_sym.some.type_sym.bound_type;
                                                if (let spec_def := spec_type.type_definition.some) {
                                                    if (spec_def is BoundDefinition.enum_def) {
                                                        let spec_enum: BoundEnumDefinition = spec_def.enum_def;
                                                        let mi: mut i64 = 0;
                                                        while (mi < cast<i64>(spec_enum.methods.size())) {
                                                            let md: BoundDefinition = spec_enum.methods.at(cast<u64>(mi)).some;
                                                            if (md is BoundDefinition.function_def) {
                                                                if (md.function_def.name == sym.function_sym.name) {
                                                                    bt = md.function_def.return_type;
                                                                }
                                                            }
                                                            mi = mi + 1;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if (orig_def is BoundDefinition.class_def) {
                                        let spec_name: string = MonomorphizePass.mangle_generic_name(orig_def.class_def.full_name, base_type.generic_args);
                                        let spec_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(spec_name);
                                        if (spec_sym.is_none()) {
                                            // The specialized def does not exist YET: it is created
                                            // later, when the expression producing the receiver has
                                            // its body bound by the dynamic pass-8 loop (e.g.
                                            // d.next() where d = range(..).map(f) — the
                                            // MapIterator<i64,i64> spec is born from map's body,
                                            // bound after this whole initial block). Derive the
                                            // return type by SUBSTITUTING the class's type params
                                            // in the template method's return (Option<U> ->
                                            // Option<i64>) instead of leaving unresolved params.
                                            bt = this.substitute_class_params_type(bt, orig_def.class_def, base_type.generic_args);
                                        }
                                        if (spec_sym.is_some()) {
                                            if (spec_sym.some is BoundSymbol.type_sym) {
                                                let spec_type: BoundType = spec_sym.some.type_sym.bound_type;
                                                if (let spec_def := spec_type.type_definition.some) {
                                                    if (spec_def is BoundDefinition.class_def) {
                                                                        let spec_cls: BoundClassDefinition = spec_def.class_def;
                                                                        let mi: mut i64 = 0;
                                                                        while (mi < cast<i64>(spec_cls.methods.size())) {
                                                                            let md: BoundDefinition = spec_cls.methods.at(cast<u64>(mi)).some;
                                                                            if (md is BoundDefinition.function_def) {
                                                                                if (md.function_def.name == sym.function_sym.name) {
                                                                                    bt = md.function_def.return_type;
                                                                                }
                                                                            }
                                                                            mi = mi + 1;
                                                                        }
                                                                        // Impl-block methods (impl ISource<T> { fun current
                                                                        // ... }) live in interface_impls, NOT methods: the
                                                                        // member symbol resolved from the TEMPLATE class
                                                                        // carries the unresolved Option<T>-shaped return
                                                                        // type, so the specialized def is authoritative
                                                                        // here too.
                                                                        let ii2: mut i64 = 0;
                                                                        while (ii2 < cast<i64>(spec_cls.interface_impls.size())) {
                                                                            let idf: BoundDefinition = spec_cls.interface_impls.at(cast<u64>(ii2)).some;
                                                                            if (idf is BoundDefinition.impl_def) {
                                                                                let mi2: mut i64 = 0;
                                                                                while (mi2 < cast<i64>(idf.impl_def.methods.size())) {
                                                                                    let md: BoundDefinition = idf.impl_def.methods.at(cast<u64>(mi2)).some;
                                                                                    if (md is BoundDefinition.function_def) {
                                                                                        if (md.function_def.name == sym.function_sym.name) {
                                                                                            bt = md.function_def.return_type;
                                                                                        }
                                                                                    }
                                                                                    mi2 = mi2 + 1;
                                                                                }
                                                                            }
                                                                            ii2 = ii2 + 1;
                                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                } else if (base_type.type_definition.is_some()) {
                                    let td: BoundDefinition = base_type.type_definition.some;
                                    // Interface type: look up return type from interface definition
                                    if (td is BoundDefinition.interface_def) {
                                        let iface: BoundInterfaceDefinition = td.interface_def;
                                        // A GENERIC interface base (ISource<i64>) carries the
                                        // TEMPLATE def + args: its methods keep the unresolved
                                        // Option<T>-shaped returns. The SPECIALIZED def
                                        // (ISource$<mangle>) holds the resolved signatures —
                                        // prefer it when it exists.
                                        let spec_if: mut Option<BoundInterfaceDefinition> = new Option<BoundInterfaceDefinition>.none();
                                        if (cast<i64>(base_type.generic_args.size()) > 0) {
                                            let spec_iname: string = MonomorphizePass.mangle_generic_name(iface.full_name, base_type.generic_args);
                                            let spec_isym: Option<BoundSymbol> = scope.lookup_type_in_scope(spec_iname);
                                            if (spec_isym.is_some() && spec_isym.some is BoundSymbol.type_sym) {
                                                let spec_itype: BoundType = spec_isym.some.type_sym.bound_type;
                                                if (spec_itype.type_definition.is_some() && spec_itype.type_definition.some is BoundDefinition.interface_def) {
                                                    spec_if = new Option<BoundInterfaceDefinition>.some(spec_itype.type_definition.some.interface_def);
                                                }
                                            }
                                        }
                                        let method_src: BoundInterfaceDefinition = if (spec_if.is_some()) { spec_if.some } else { iface };
                                        let imi: mut i64 = 0;
                                        while (imi < cast<i64>(method_src.methods.size())) {
                                            let md: BoundDefinition = method_src.methods.at(cast<u64>(imi)).some;
                                            if (md is BoundDefinition.function_def) {
                                                if (md.function_def.name == sym.function_sym.name) {
                                                    bt = md.function_def.return_type;
                                                }
                                            }
                                            imi = imi + 1;
                                        }
                                    }
                                    if (td is BoundDefinition.class_def) {
                                        let cls: BoundClassDefinition = td.class_def;
                                        // Only apply the vtable default-method fallback below if the
                                        // class does not define the method itself (own methods or
                                        // interface_impls). Otherwise the interface's default return
                                        // type (e.g. IIterator<T>.iter -> IIterator<T>) wrongly
                                        // overrides the class's own method return type
                                        // (e.g. RangeIterator.iter -> mut RangeIterator).
                                        let cls_defines_method: mut bool = false;
                                        let mi: mut i64 = 0;
                                        while (mi < cast<i64>(cls.methods.size())) {
                                            let md: BoundDefinition = cls.methods.at(cast<u64>(mi)).some;
                                            if (md is BoundDefinition.function_def) {
                                                if (md.function_def.name == sym.function_sym.name) {
                                                    bt = md.function_def.return_type;
                                                    cls_defines_method = true;
                                                }
                                            }
                                            mi = mi + 1;
                                        }
                                        let ii: mut i64 = 0;
                                        while (ii < cast<i64>(cls.interface_impls.size())) {
                                            let impl_def: BoundDefinition = cls.interface_impls.at(cast<u64>(ii)).some;
                                            if (impl_def is BoundDefinition.impl_def) {
                                                let iface_impl: BoundInterfaceImplementation = impl_def.impl_def;
                                                let imi: mut i64 = 0;
                                                while (imi < cast<i64>(iface_impl.methods.size())) {
                                                    let md: BoundDefinition = iface_impl.methods.at(cast<u64>(imi)).some;
                                                    if (md is BoundDefinition.function_def) {
                                                        if (md.function_def.name == sym.function_sym.name) {
                                                            bt = md.function_def.return_type;
                                                            cls_defines_method = true;
                                                        }
                                                    }
                                                    imi = imi + 1;
                                                }
                                            }
                                            ii = ii + 1;
                                        }
                                        // Fallback: search interface definitions for default methods
                                        let vi: mut i64 = 0;
                                        while (vi < cast<i64>(cls.vtables.size())) {
                                            let vtable: BoundVTable = cls.vtables.at(cast<u64>(vi)).some;
                                            let iface_type: BoundType = vtable.interface_type;
                                            if (let iface_def := iface_type.type_definition.some) {
                                                if (iface_def is BoundDefinition.interface_def) {
                                                    let iface: BoundInterfaceDefinition = iface_def.interface_def;
                                                    let imi: mut i64 = 0;
                                                    while (imi < cast<i64>(iface.methods.size())) {
                                                        let md: BoundDefinition = iface.methods.at(cast<u64>(imi)).some;
                                                        if (md is BoundDefinition.function_def) {
                                                            if (md.function_def.name == sym.function_sym.name) {
                                                                if (!cls_defines_method) {
                                                                    bt = md.function_def.return_type;
                                                                }
                                                            }
                                                        }
                                                        imi = imi + 1;
                                                    }
                                                }
                                            }
                                            vi = vi + 1;
                                        }
                                    }
                                    if (td is BoundDefinition.enum_def) {
                                        let e: BoundEnumDefinition = td.enum_def;
                                        let mi: mut i64 = 0;
                                        while (mi < cast<i64>(e.methods.size())) {
                                            let md: BoundDefinition = e.methods.at(cast<u64>(mi)).some;
                                            if (md is BoundDefinition.function_def) {
                                                if (md.function_def.name == sym.function_sym.name) {
                                                    bt = md.function_def.return_type;
                                                }
                                            }
                                            mi = mi + 1;
                                        }
                                    }
                                    if (td is BoundDefinition.enum_def) {
                                        let enum_d: BoundEnumDefinition = td.enum_def;
                                        let impl_found: mut bool = false;
                                        let eii: mut i64 = 0;
                                        while (eii < cast<i64>(enum_d.interface_impls.size())) {
                                            let impl_def: BoundDefinition = enum_d.interface_impls.at(cast<u64>(eii)).some;
                                            if (impl_def is BoundDefinition.impl_def) {
                                                let iface_impl: BoundInterfaceImplementation = impl_def.impl_def;
                                                let eimi: mut i64 = 0;
                                                while (eimi < cast<i64>(iface_impl.methods.size())) {
                                                    let md: BoundDefinition = iface_impl.methods.at(cast<u64>(eimi)).some;
                                                    if (md is BoundDefinition.function_def) {
                                                        if (md.function_def.name == sym.function_sym.name) {
                                                            bt = md.function_def.return_type;
                                                            impl_found = true;
                                                        }
                                                    }
                                                    eimi = eimi + 1;
                                                }
                                            }
                                            eii = eii + 1;
                                        }
                                        // Only fall back to the interface's declared method type when
                                        // no injected impl method matched: an interface method's
                                        // return_type may be an UNSUBSTITUTED template param
                                        // (`mut T` on a generic interface), which would wrongly
                                        // override the concrete injected impl's return type.
                                        if (!impl_found) {
                                            let evi: mut i64 = 0;
                                            while (evi < cast<i64>(enum_d.vtables.size())) {
                                                let vtable: BoundVTable = enum_d.vtables.at(cast<u64>(evi)).some;
                                                let iface_type: BoundType = vtable.interface_type;
                                                if (let iface_def := iface_type.type_definition.some) {
                                                    if (iface_def is BoundDefinition.interface_def) {
                                                        let iface: BoundInterfaceDefinition = iface_def.interface_def;
                                                        let eimi: mut i64 = 0;
                                                        while (eimi < cast<i64>(iface.methods.size())) {
                                                            let md: BoundDefinition = iface.methods.at(cast<u64>(eimi)).some;
                                                            if (md is BoundDefinition.function_def) {
                                                                if (md.function_def.name == sym.function_sym.name) {
                                                                    bt = md.function_def.return_type;
                                                                }
                                                            }
                                                            eimi = eimi + 1;
                                                        }
                                                    }
                                                }
                                                evi = evi + 1;
                                            }
                                        }
                                    }
                                }
                            }
                            let is_virt: mut bool = false;
                            let direct_disp: mut bool = false;
                            let direct_sym: mut Option<BoundSymbol> = ma_expr.member_symbol;
                            if (ma_expr.base_expr.is_some()) {
                                let base_type: BoundType = ma_expr.base_expr.some.get_bound_type();
                                if (base_type.kind is TypeKind.InterfaceKind) {
                                    // Check if this is a temporary box that can be elided:
                                    // cast<Interface>(value).method() → call method directly
                                    if (ma_expr.base_expr.some is BoundExpression.cast_expr) {
                                        let cast_e: BoundCastExpression = ma_expr.base_expr.some.cast_expr;
                                        if (cast_e.needs_boxing) {
                                            direct_disp = true;
                                            // Resolve the concrete implementation method from the value type's vtable
                                            if (cast_e.inner.is_some() && ma_expr.member_symbol.is_some()) {
                                                let inner_type: BoundType = cast_e.inner.some.get_bound_type();
                                                let resolved: Option<BoundFunctionSymbol> = this.resolve_implementation_method(inner_type, base_type, ma_expr.member_symbol.some);
                                                if (resolved.is_some()) {
                                                    direct_sym = new Option<BoundSymbol>.some(new BoundSymbol.function_sym(resolved.some));
                                                }
                                            }
                                        } else {
                                            is_virt = true;
                                        }
                                    } else {
                                        // Distinguish a value receiver (`f.foo()`) from a type-name
                                        // call (`IFoo.foo()` / `ns.IFoo.foo()`). A value receiver uses
                                        // virtual dispatch so the override is selected at runtime --
                                        // including for no-`this` (default/static) methods, where the
                                        // receiver is used only for the vtable lookup and not passed
                                        // (see lower_function_call). A type-name call stays static.
                                        let base_is_value: mut bool = false;
                                        if (ma_expr.base_expr.some is BoundExpression.identifier) {
                                            let base_id: BoundIdentifierExpression = ma_expr.base_expr.some.identifier;
                                            if (base_id.symbol.is_some()) {
                                                if (base_id.symbol.some is BoundSymbol.variable) {
                                                    base_is_value = true;
                                                }
                                            }
                                        }
                                        if (ma_expr.base_expr.some is BoundExpression.member_access) {
                                            // A member_access base is a value unless it resolves to a
                                            // type/namespace (e.g. `ns.IFoo` in `ns.IFoo.foo()`).
                                            let inner_ma: BoundMemberAccessExpression = ma_expr.base_expr.some.member_access;
                                            let inner_is_type_or_ns: mut bool = false;
                                            if (inner_ma.member_symbol.is_some()) {
                                                if (inner_ma.member_symbol.some is BoundSymbol.type_sym) { inner_is_type_or_ns = true; }
                                                if (inner_ma.member_symbol.some is BoundSymbol.namespace_sym) { inner_is_type_or_ns = true; }
                                            }
                                            if (!inner_is_type_or_ns) {
                                                base_is_value = true;
                                            }
                                        }
                                        if (ma_expr.base_expr.some is BoundExpression.function_call) {
                                            base_is_value = true;
                                        }
                                        if (base_is_value) {
                                            is_virt = true;
                                        } else if (ma_expr.member_symbol.is_some()) {
                                            // Static interface methods (no 'this' parameter) called on
                                            // the interface type name directly: no object receiver, so
                                            // no virtual dispatch.
                                            let ms: BoundSymbol = ma_expr.member_symbol.some;
                                            if (ms is BoundSymbol.function_sym) {
                                                if (this.function_is_method(ms.function_sym)) {
                                                    is_virt = true;
                                                }
                                            } else {
                                                is_virt = true;
                                            }
                                        }
                                    }
                                }
                            }
                            this.check_argument_types(sym.function_sym, args);
                            let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(bt, callee, direct_sym, args, is_virt, empty_generic_args, false);
                            if (direct_disp) {
                                result.direct_dispatch = true;
                            }
                            return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
                        }
                    }
                    // Constructing an enum variant WITHOUT `new` (e.g.
                    // `Option<i64>.some(42)`) is a user error. The old silent
                    // fallback built a void-typed call with no callee symbol,
                    // poisoning every dependent expression (and eventually dying in
                    // the IR generator with E_INTERNAL: Function call has no callee
                    // symbol). Scoped to enum-member symbols only: calls of
                    // function-typed FIELDS (`h.cb(21)`) are handled earlier by the
                    // fun-typed-field branch, and fun-typed local variables fall
                    // through to the no-callee call (a tracked gap, not invalid
                    // syntax).
                    // (Must stay INSIDE the `if member_access` block: ma_expr is
                    // declared there, and EmperorPenguin's block scoping — unlike
                    // BabyPenguin's function-level leak — rejects outer use.)
                    if (ma_expr.member_symbol.is_some() && ma_expr.member_symbol.some is BoundSymbol.enum_member) {
                        // Spell the callee as the user wrote it (build_text keeps the
                        // generic args, e.g. `Option<i64>.some`; the bound type would
                        // render the specialization's mangled name instead).
                        let callable_name: mut string = ma_expr.member_name;
                        if (let ast_callee2 := expr.callee.some) {
                            callable_name = ast_callee2.build_text();
                        }
                        this.model.some.report_error(new ErrorCode.E_CALL_NOT_FUNCTION(),
                            "'" + callable_name + "' is not a valid function (enum variants are constructed with 'new')",
                            new SourceLocation("", 0, 0));
                    }
                }
                let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(new BoundType(), callee, new Option<BoundSymbol>.none(), args, false, empty_generic_args, false);
                return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
            }
        }
        this.model.some.trace("bind_function_call no candidate matched: " + (if (expr.callee.is_some()) { expr.callee.some.build_text() } else { "?" }) + " (" + cast<string>(args.size()) + " arg(s))");
        let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(new BoundType(), new Option<BoundExpression>.none(), new Option<BoundSymbol>.none(), args, false, empty_generic_args, false);
        return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
    }


    fun bind_arguments(mut this, args: _utils.List<Expression>, scope: mut BoundScope) -> mut _utils.List<BoundExpression> {
        _utils.trace_enter("Enter bind_arguments");
        let result: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
        let i: mut i64 = 0;
        while (i < cast<i64>(args.size())) {
            let bound_arg: Option<BoundExpression> = this.bind_expression(args.at(cast<u64>(i)).some, scope);
            if (bound_arg.is_some()) {
                result.push(bound_arg.some);
            }
            i = i + 1;
        }
        return result;
    }


    // Extract an i64 from a bound integer literal, or none if not a constant int.
    fun bound_literal_i64_value(this, bexpr: BoundExpression) -> Option<i64> {
        if (bexpr is BoundExpression.literal) {
            if (bexpr.literal.literal_kind is LiteralKind.IntegerLiteral) {
                return new Option<i64>.some(string_to_int(bexpr.literal.value));
            }
        }
        return new Option<i64>.none();
    }


    fun bind_if_expr(mut this, expr: IfExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_if_expr");
        if (expr.condition.is_some() && expr.condition.some is Expression.try_bind) {
            return this.bind_try_bind_if_expr(expr, scope);
        }
        // P2: bind the condition in a fresh condition-region so try-bind pattern
        // variables from `&&` chains are visible in the then-branch (definitely
        // assigned when the condition is true) but not in else or after.
        let cond_region: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<cond>", scope.full_name + ".<cond>", new Option<BoundScope>.some(scope));
        cond_region.is_region = true;
        cond_region.is_condition_region = true;
        let condition: Option<BoundExpression> = this.bind_optional_expr(expr.condition, cond_region);
        let then_block: Option<BoundExpression> = this.bind_optional_expr(expr.then_block, cond_region);
        let else_block: Option<BoundExpression> = this.bind_optional_expr(expr.else_block, scope);
        if (then_block.is_some()) {
            let bt: BoundType = then_block.some.get_bound_type();
            let result: mut BoundIfExpression = new BoundIfExpression(bt, condition, then_block, else_block);
            return new Option<BoundExpression>.some(new BoundExpression.if_expr(result));
        }
        let result: mut BoundIfExpression = new BoundIfExpression(new BoundType(), condition, then_block, else_block);
        return new Option<BoundExpression>.some(new BoundExpression.if_expr(result));
    }


    fun bind_while_expr(mut this, expr: WhileExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_while_expr");
        if (expr.condition.is_some() && expr.condition.some is Expression.try_bind) {
            return this.bind_try_bind_while_expr(expr, scope);
        }
        // P2: same condition-region promotion as bind_if_expr.
        let cond_region: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<cond>", scope.full_name + ".<cond>", new Option<BoundScope>.some(scope));
        cond_region.is_region = true;
        cond_region.is_condition_region = true;
        let condition: Option<BoundExpression> = this.bind_optional_expr(expr.condition, cond_region);
        let body: Option<BoundExpression> = this.bind_optional_expr(expr.body, cond_region);
        let result: mut BoundWhileExpression = new BoundWhileExpression(this.model.some.type_registry.void_type, condition, body);
        return new Option<BoundExpression>.some(new BoundExpression.while_expr(result));
    }


    // Prepend a `let a = EXT` statement into a bound code block (or wrap a
    // non-block expression) so the try-bind payload write executes before the
    // then/body statements. The variable is registered in `new_scope`.
    fun prepend_try_bind_let(mut this, block: Option<BoundExpression>, let_stmt: BoundLetDeclarationStatement, new_scope: BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter prepend_try_bind_let");
        if (block.is_none()) { return new Option<BoundExpression>.none(); }
        let stmts: mut _utils.List<BoundStatement> = new _utils.List<BoundStatement>();
        stmts.push(new BoundStatement.let_decl(let_stmt));
        if (block.some is BoundExpression.code_block) {
            let cb: BoundCodeBlockExpression = block.some.code_block;
            let si: mut i64 = 0;
            while (si < cast<i64>(cb.statements.size())) {
                stmts.push(cb.statements.at(cast<u64>(si)).some);
                si = si + 1;
            }
            let new_cb: mut BoundCodeBlockExpression = new BoundCodeBlockExpression(cb.bound_type, stmts, cb.trailing_expr, new Option<BoundScope>.some(new_scope));
            return new Option<BoundExpression>.some(new BoundExpression.code_block(new_cb));
        }
        let new_cb2: mut BoundCodeBlockExpression = new BoundCodeBlockExpression(block.some.get_bound_type(), stmts, block, new Option<BoundScope>.some(new_scope));
        return new Option<BoundExpression>.some(new BoundExpression.code_block(new_cb2));
    }


    // Expression-level `if (let a [: T] := b) then else` (code blocks parse `if`
    // as an expression) → `if (CHK) { let a = EXT; then } else`.
    fun bind_try_bind_if_expr(mut this, expr: IfExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_try_bind_if_expr");
        let tb: TryBindExpression = expr.condition.some.try_bind;
        let bound_rhs: Option<BoundExpression> = this.bind_expression(tb.rhs.some, scope);
        if (bound_rhs.is_none()) { return new Option<BoundExpression>.none(); }
        let analysis: Option<TryBindAnalysis> = this.analyze_try_bind(tb, bound_rhs.some, scope);
        if (analysis.is_none()) { return new Option<BoundExpression>.none(); }
        let then_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<try-bind>", scope.full_name + ".<try-bind>", new Option<BoundScope>.some(scope));
        then_scope.add_symbol(new BoundSymbol.variable(analysis.some.variable_symbol.some));
        let bound_then: Option<BoundExpression> = this.bind_optional_expr(expr.then_block, then_scope);
        let let_stmt: mut BoundLetDeclarationStatement = new BoundLetDeclarationStatement(
            analysis.some.variable_symbol, analysis.some.extract, analysis.some.bound_type,
            new Option<BoundScope>.some(then_scope));
        let_stmt.location = tb.location;
        let then_expr: Option<BoundExpression> = this.prepend_try_bind_let(bound_then, let_stmt, then_scope);
        let else_block: Option<BoundExpression> = this.bind_optional_expr(expr.else_block, scope);
        if (then_expr.is_some()) {
            let r1: mut BoundIfExpression = new BoundIfExpression(then_expr.some.get_bound_type(), analysis.some.check, then_expr, else_block);
            return new Option<BoundExpression>.some(new BoundExpression.if_expr(r1));
        }
        let r2: mut BoundIfExpression = new BoundIfExpression(this.model.some.type_registry.void_type, analysis.some.check, then_expr, else_block);
        return new Option<BoundExpression>.some(new BoundExpression.if_expr(r2));
    }


    // Expression-level `while (let a [: T] := b) body` → `while (CHK) { let a = EXT; body }`.
    fun bind_try_bind_while_expr(mut this, expr: WhileExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_try_bind_while_expr");
        let tb: TryBindExpression = expr.condition.some.try_bind;
        let bound_rhs: Option<BoundExpression> = this.bind_expression(tb.rhs.some, scope);
        if (bound_rhs.is_none()) { return new Option<BoundExpression>.none(); }
        let analysis: Option<TryBindAnalysis> = this.analyze_try_bind(tb, bound_rhs.some, scope);
        if (analysis.is_none()) { return new Option<BoundExpression>.none(); }
        let body_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<try-bind>", scope.full_name + ".<try-bind>", new Option<BoundScope>.some(scope));
        body_scope.add_symbol(new BoundSymbol.variable(analysis.some.variable_symbol.some));
        let bound_body: Option<BoundExpression> = this.bind_optional_expr(expr.body, body_scope);
        let let_stmt: mut BoundLetDeclarationStatement = new BoundLetDeclarationStatement(
            analysis.some.variable_symbol, analysis.some.extract, analysis.some.bound_type,
            new Option<BoundScope>.some(body_scope));
        let_stmt.location = tb.location;
        let body_expr: Option<BoundExpression> = this.prepend_try_bind_let(bound_body, let_stmt, body_scope);
        let result: mut BoundWhileExpression = new BoundWhileExpression(this.model.some.type_registry.void_type, analysis.some.check, body_expr);
        return new Option<BoundExpression>.some(new BoundExpression.while_expr(result));
    }


    fun bind_optional_expr(mut this, opt: Option<Expression>, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_optional_expr");
        if (opt.is_some()) {
            return this.bind_expression(opt.some, scope);
        }
        return new Option<BoundExpression>.none();
    }


    // Analyze a `let a [: T] := b` try-bind. Returns the bound variable, the
    // boolean check expression, and the guarded extract expression. v1 supports
    // enum variant member access (`let x := opt.some`); other shapes report an
    // error. The variable is NOT registered here — the caller registers it into
    // the true-branch scope so it is visible only where the check holds.
    fun analyze_try_bind(mut this, tb: TryBindExpression, bound_rhs: BoundExpression, scope: mut BoundScope) -> Option<TryBindAnalysis> {
        _utils.trace_enter("Enter analyze_try_bind");
        // Enum variant member access: `let x := opt.some`
        if (bound_rhs is BoundExpression.member_access) {
            let ma: BoundMemberAccessExpression = bound_rhs.member_access;
            if (ma.member_symbol.is_some() && ma.base_expr.is_some()) {
                let sym: BoundSymbol = ma.member_symbol.some;
                if (sym is BoundSymbol.enum_member) {
                    let enum_type: BoundType = ma.base_expr.some.get_bound_type();
                    let payload_type: mut BoundType = ma.bound_type;
                    // Tag-only variants store the enum type itself as payload
                    // (SemanticModel resolve_enum_types); a payload equal to the
                    // enum type has nothing to bind. (Recursive enum payloads are
                    // a documented limitation of this discriminator.)
                    if (payload_type.is_same_type(enum_type)) {
                        this.model.some.report_error(new ErrorCode.E_UNSUPPORTED(),
                            "enum variant '" + ma.member_name + "' has no payload to bind",
                            tb.location);
                        return new Option<TryBindAnalysis>.none();
                    }
                    let bind_type: mut BoundType = payload_type;
                    if (tb.type_spec.is_some()) {
                        let ann_type: mut BoundType = this.model.some.resolve_type_specifier(tb.type_spec.some, scope);
                        if (!ann_type.is_same_type(payload_type)) {
                            this.model.some.report_error(new ErrorCode.E_TYPE_MISMATCH(),
                                "try-bind type '" + ann_type.display_name() + "' does not match payload type '" + payload_type.display_name() + "'",
                                tb.location);
                            return new Option<TryBindAnalysis>.none();
                        }
                        bind_type = ann_type;
                    }
                    let var_sym: mut BoundVariableSymbol = new BoundVariableSymbol();
                    var_sym.name = tb.variable_name;
                    var_sym.full_name = scope.full_name + "." + tb.variable_name;
                    var_sym.is_mutable = false;
                    var_sym.bound_type = bind_type;
                    var_sym.location = tb.location;
                    // check = `base is EnumType.variant`, RHS is a BoundEnumVariant
                    // reference carrying the variant index (lowered to ISENUM).
                    let ev: mut BoundEnumVariantExpression = new BoundEnumVariantExpression(
                        enum_type, enum_type, ma.member_name, sym.enum_member.enum_value,
                        new Option<BoundEnumMemberSymbol>.some(sym.enum_member),
                        new Option<BoundExpression>.none());
                    let operands: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
                    operands.push(ma.base_expr.some);
                    operands.push(new BoundExpression.enum_variant(ev));
                    let operators: mut _utils.List<BinaryOperator> = new _utils.List<BinaryOperator>();
                    operators.push(new BinaryOperator.Is());
                    let check: mut BoundBinaryExpression = new BoundBinaryExpression(this.model.some.type_registry.bool_type, operators, operands);
                    let analysis: mut TryBindAnalysis = new TryBindAnalysis();
                    analysis.variable_symbol = new Option<BoundVariableSymbol>.some(var_sym);
                    analysis.check = new Option<BoundExpression>.some(new BoundExpression.binary(check));
                    analysis.extract = new Option<BoundExpression>.some(bound_rhs);
                    analysis.bound_type = bind_type;
                    return new Option<TryBindAnalysis>.some(analysis);
                }
            }
        }
        // Type-cast form: `let a : TO := from` — whether `cast<TO>(from)` is valid.
        // Compile-time foldable when the static types decide it; otherwise a
        // runtime ISINSTANCE check.
        if (tb.type_spec.is_some()) {
            let ann_type: mut BoundType = this.model.some.resolve_type_specifier(tb.type_spec.some, scope);
            let rhs_type: BoundType = bound_rhs.get_bound_type();
            // Same type: always a valid (identity) cast.
            if (rhs_type.is_same_type(ann_type)) {
                return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 1);
            }
            // Primitive (incl. string) conversion: compile-time fold.
            if (ann_type.kind is TypeKind.PrimitiveKind && rhs_type.kind is TypeKind.PrimitiveKind) {
                let fold: bool = this.model.some.type_registry.can_widen_primitive(rhs_type.primitive, ann_type.primitive);
                if (fold) { return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 1); }
                return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 0);
            }
            // Interface target: `let a : IFoo := bar`
            if (ann_type.kind is TypeKind.InterfaceKind) {
                if (rhs_type.kind is TypeKind.PrimitiveKind) {
                    this.model.some.report_error(new ErrorCode.E_TYPE_MISMATCH(),
                        "try-bind: cannot cast primitive '" + rhs_type.display_name() + "' to interface '" + ann_type.display_name() + "'",
                        tb.location);
                    return new Option<TryBindAnalysis>.none();
                }
                if (this.is_concrete_type(rhs_type)) {
                    if (this.model.some.type_registry.can_implicitly_cast(rhs_type, ann_type)) {
                        return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 1);
                    }
                    return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 0);
                }
                // interface / generic rhs → runtime ISINSTANCE
                return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, -1);
            }
            // Class target: `let a : Foo := bar` (no class inheritance, exact check)
            if (ann_type.kind is TypeKind.ClassKind) {
                if (rhs_type.kind is TypeKind.ClassKind) {
                    if (this.is_concrete_type(rhs_type)) {
                        return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 0);
                    }
                    return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, -1);
                }
                if (rhs_type.kind is TypeKind.InterfaceKind) {
                    return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, -1);
                }
                this.model.some.report_error(new ErrorCode.E_TYPE_MISMATCH(),
                    "try-bind: cannot cast '" + rhs_type.display_name() + "' to class '" + ann_type.display_name() + "'",
                    tb.location);
                return new Option<TryBindAnalysis>.none();
            }
            this.model.some.report_error(new ErrorCode.E_UNSUPPORTED(),
                "try-bind target '" + ann_type.display_name() + "' is not a supported matchable",
                tb.location);
            return new Option<TryBindAnalysis>.none();
        }
        this.model.some.report_error(new ErrorCode.E_UNSUPPORTED(),
            "try-bind RHS is not a supported matchable (add a ': TO' type annotation for cast checks)",
            tb.location);
        return new Option<TryBindAnalysis>.none();
    }


    // A "concrete" class/enum has an AST source; a generic-parameter placeholder
    // does not. When uncertain, callers fall back to a runtime ISINSTANCE check.
    fun is_concrete_type(this, bt: BoundType) -> bool {
        if (let td := bt.type_definition.some) {
            if (td is BoundDefinition.class_def) {
                return td.class_def.scope.is_some() && !td.class_def.is_generic_template;
            }
            if (td is BoundDefinition.enum_def) { return td.enum_def.scope.is_some(); }
        }
        return false;
    }


    // Build the cast expression for `cast<TO>(from)`, mirroring bind_cast's
    // boxing/unboxing decisions (value type → interface needs boxing).
    fun build_cast_bound(mut this, inner: BoundExpression, target_type: BoundType) -> BoundCastExpression {
        let result: mut BoundCastExpression = new BoundCastExpression(target_type, target_type, new Option<BoundExpression>.some(inner), false);
        let inner_type: BoundType = inner.get_bound_type();
        if (target_type.kind is TypeKind.InterfaceKind) {
            if (inner_type.is_value_type()) {
                result.needs_boxing = true;
                result.source_type_name = this.get_concrete_type_name(inner_type);
            }
        }
        if (inner_type.kind is TypeKind.InterfaceKind) {
            if (target_type.is_value_type()) {
                result.needs_unboxing = true;
                result.source_type_name = this.get_concrete_type_name(target_type);
            }
        }
        return result;
    }


    // Build a TryBindAnalysis for the cast form. fold: 1 = compile-time true,
    // 0 = compile-time false, -1 = runtime `from is TO` (ISINSTANCE).
    fun make_cast_try_bind_analysis(mut this, tb: TryBindExpression, bound_rhs: BoundExpression, ann_type: mut BoundType, scope: mut BoundScope, fold: i64) -> Option<TryBindAnalysis> {
        _utils.trace_enter("Enter make_cast_try_bind_analysis");
        let var_sym: mut BoundVariableSymbol = new BoundVariableSymbol();
        var_sym.name = tb.variable_name;
        var_sym.full_name = scope.full_name + "." + tb.variable_name;
        var_sym.is_mutable = false;
        var_sym.bound_type = ann_type;
        var_sym.location = tb.location;
        let cast_expr: BoundCastExpression = this.build_cast_bound(bound_rhs, ann_type);
        let extract: BoundExpression = new BoundExpression.cast_expr(cast_expr);
        let check: mut Option<BoundExpression> = new Option<BoundExpression>.none();
        if (fold == 1) {
            let true_lit: mut BoundLiteralExpression = new BoundLiteralExpression("true", this.model.some.type_registry.bool_type, new LiteralKind.BoolLiteral());
            check = new Option<BoundExpression>.some(new BoundExpression.literal(true_lit));
        } else if (fold == 0) {
            let false_lit: mut BoundLiteralExpression = new BoundLiteralExpression("false", this.model.some.type_registry.bool_type, new LiteralKind.BoolLiteral());
            check = new Option<BoundExpression>.some(new BoundExpression.literal(false_lit));
        } else {
            // Runtime: `from is TO` via a type-symbol identifier on the Is RHS.
            let type_sym: Option<BoundSymbol> = scope.lookup_symbol(tb.type_spec.some.name);
            if (type_sym.is_some() && type_sym.some is BoundSymbol.type_sym) {
                let id: mut BoundIdentifierExpression = new BoundIdentifierExpression(ann_type, type_sym);
                let operands: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
                operands.push(bound_rhs);
                operands.push(new BoundExpression.identifier(id));
                let operators: mut _utils.List<BinaryOperator> = new _utils.List<BinaryOperator>();
                operators.push(new BinaryOperator.Is());
                let chk: mut BoundBinaryExpression = new BoundBinaryExpression(this.model.some.type_registry.bool_type, operators, operands);
                check = new Option<BoundExpression>.some(new BoundExpression.binary(chk));
            } else {
                this.model.some.report_error(new ErrorCode.E_RESOLVE_TYPE(),
                    "try-bind type check: cannot resolve type symbol for '" + tb.type_spec.some.name + "'",
                    tb.location);
                return new Option<TryBindAnalysis>.none();
            }
        }
        let analysis: mut TryBindAnalysis = new TryBindAnalysis();
        analysis.variable_symbol = new Option<BoundVariableSymbol>.some(var_sym);
        analysis.check = check;
        analysis.extract = new Option<BoundExpression>.some(extract);
        analysis.bound_type = ann_type;
        return new Option<TryBindAnalysis>.some(analysis);
    }


    // P2 general try-bind expression: `let a [: T] := b` as a boolean value.
    // The RHS is bound first (so `a` is not visible to its own RHS), then the
    // pattern variable is registered into the CURRENT region scope (paren /
    // &&-chain / if-condition), making it visible to the enclosing boolean
    // expression's later operands and (for if-conditions) the then-branch.
    fun bind_try_bind(mut this, tb: TryBindExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_try_bind");
        let bound_rhs: Option<BoundExpression> = this.bind_expression(tb.rhs.some, scope);
        if (bound_rhs.is_none()) { return new Option<BoundExpression>.none(); }
        let analysis: Option<TryBindAnalysis> = this.analyze_try_bind(tb, bound_rhs.some, scope);
        if (analysis.is_none()) { return new Option<BoundExpression>.none(); }
        scope.add_symbol(new BoundSymbol.variable(analysis.some.variable_symbol.some));
        let result: mut BoundTryBindExpression = new BoundTryBindExpression(
            this.model.some.type_registry.bool_type, analysis.some.variable_symbol, analysis.some.check, analysis.some.extract);
        return new Option<BoundExpression>.some(new BoundExpression.try_bind(result));
    }


    // Desugar `if (let a [: T] := b) T else E` into
    //   `if (CHK) { let a = EXT; T } else E`
    // so `a` is an ordinary block-scoped let — visible in the then-branch only,

    fun bind_code_block(mut this, expr: CodeBlockExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_code_block");
        let block_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<block>", scope.full_name + ".<block>", new Option<BoundScope>.some(scope));
        let stmts: mut _utils.List<BoundStatement> = new _utils.List<BoundStatement>();
        let i: mut i64 = 0;
        while (i < cast<i64>(expr.statements.size())) {
            let stmt: Statement = expr.statements.at(cast<u64>(i)).some;
            let bound_stmt: Option<BoundStatement> = this.model.some.bind_bodies_pass.bind_statement(stmt, block_scope);
            if (bound_stmt.is_some()) {
                stmts.push(bound_stmt.some);
            }
            i = i + 1;
        }
        // Promote a trailing expression-statement that wraps a value-producing if-expression
        // to the block's trailing value. The parser wraps a trailing `if c {..} else {..}` in
        // a code block as a block_expr statement; when that if yields a non-void value it is
        // the block's value (trailing expression), not a value-less statement. This makes
        // `let x: T = { ...; if c { a } else { b } }` resolve to T instead of void (which
        // previously produced `ASSIGN void` and invalid `#dbg_value(ptr void, ...)`).
        // Void ifs (e.g. both branches `return`) are left as statements, so control-flow ifs
        // such as `fun f() -> T { if c { return a; } else { return b; } }` are unaffected.
        if (expr.trailing_expr.is_none()) {
            if (cast<i64>(stmts.size()) > 0) {
                let last_stmt: BoundStatement = stmts.at(stmts.size() - 1).some;
                if (last_stmt is BoundStatement.expression) {
                    let inner_opt: Option<BoundExpression> = last_stmt.expression.expression;
                    if (inner_opt.is_some()) {
                        if (inner_opt.some is BoundExpression.if_expr) {
                            let ift: BoundType = inner_opt.some.get_bound_type();
                            if (ift.display_name() != "void") {
                                let _discarded: __builtin.Option<BoundStatement> = stmts.pop();
                                let result: mut BoundCodeBlockExpression = new BoundCodeBlockExpression(ift, stmts, inner_opt, new Option<BoundScope>.some(block_scope));
                                return new Option<BoundExpression>.some(new BoundExpression.code_block(result));
                            }
                        }
                    }
                }
            }
        }
        if (expr.trailing_expr.is_some()) {
            let trailing: Option<BoundExpression> = this.bind_expression(expr.trailing_expr.some, block_scope);
            if (trailing.is_some()) {
                let bt: BoundType = trailing.some.get_bound_type();
                let result: mut BoundCodeBlockExpression = new BoundCodeBlockExpression(bt, stmts, trailing, new Option<BoundScope>.some(block_scope));
                return new Option<BoundExpression>.some(new BoundExpression.code_block(result));
            }
        }
        let result: mut BoundCodeBlockExpression = new BoundCodeBlockExpression(this.model.some.type_registry.void_type, stmts, new Option<BoundExpression>.none(), new Option<BoundScope>.some(block_scope));
        return new Option<BoundExpression>.some(new BoundExpression.code_block(result));
    }


    // Look up the concrete implementation method from a value type's vtable.
    // Given the inner (concrete) type, the interface type, and the interface method symbol,
    // find the corresponding implementation method in the class/enum definition's vtable.
    fun resolve_implementation_method(this, inner_type: BoundType, iface_type: BoundType, iface_method_sym: BoundSymbol) -> Option<BoundFunctionSymbol> {
        _utils.trace_enter("Enter resolve_implementation_method");
        if (iface_method_sym is BoundSymbol.function_sym) {
            let method_name: string = iface_method_sym.function_sym.name;
            if (let def := inner_type.type_definition.some) {
                // Class value type
                if (def is BoundDefinition.class_def) {
                    let class_def: BoundClassDefinition = def.class_def;
                    let vi: mut i64 = 0;
                    while (vi < cast<i64>(class_def.vtables.size())) {
                        let vtable: BoundVTable = class_def.vtables.at(cast<u64>(vi)).some;
                        if (vtable.interface_type.display_name() == iface_type.display_name()) {
                            let si: mut i64 = 0;
                            while (si < cast<i64>(vtable.slots.size())) {
                                let slot: BoundVTableSlot = vtable.slots.at(cast<u64>(si)).some;
                                if (slot.interface_method.is_some()) {
                                    if (slot.interface_method.some.name == method_name) {
                                        return slot.implementation_method;
                                    }
                                }
                                si = si + 1;
                            }
                        }
                        vi = vi + 1;
                    }
                }
                // Enum type
                if (def is BoundDefinition.enum_def) {
                    let enum_def: BoundEnumDefinition = def.enum_def;
                    let vi: mut i64 = 0;
                    while (vi < cast<i64>(enum_def.vtables.size())) {
                        let vtable: BoundVTable = enum_def.vtables.at(cast<u64>(vi)).some;
                        if (vtable.interface_type.display_name() == iface_type.display_name()) {
                            let si: mut i64 = 0;
                            while (si < cast<i64>(vtable.slots.size())) {
                                let slot: BoundVTableSlot = vtable.slots.at(cast<u64>(si)).some;
                                if (slot.interface_method.is_some()) {
                                    if (slot.interface_method.some.name == method_name) {
                                        return slot.implementation_method;
                                    }
                                }
                                si = si + 1;
                            }
                        }
                        vi = vi + 1;
                    }
                }
            }
        }
        return new Option<BoundFunctionSymbol>.none();
    }


    // A cast inner's binding: RAW (port sugar suppressed) when the cast
    // targets a class/interface type and the inner is a member access onto a
    // port field (a channel-object operation).
    fun bind_cast_inner(mut this, expr: CastExpression, target_type: BoundType, scope: mut BoundScope) -> Option<BoundExpression> {
        if (target_type.kind is TypeKind.InterfaceKind || target_type.kind is TypeKind.ClassKind) {
            if (expr.inner.is_some() && expr.inner.some is Expression.member_access) {
                if (this.resolve_port_access(expr.inner.some.member_access, scope).is_some()) {
                    return this.bind_expr_no_port_sugar(expr.inner.some, scope);
                }
            }
        }
        return this.bind_optional_expr(expr.inner, scope);
    }

    fun bind_cast(mut this, expr: CastExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_cast");
        // mut-this core methods (bind_meta_call / resolve_type_name) need a
        // mutable SemanticModel: rebind the Option payload once here.
        let m: mut SemanticModel = this.model.some;
        // Prefer the full TypeSpecifier (qualified_parts aware) when present;
        // the bare-name fallback only handles unqualified types.
        let target_type: mut BoundType = this.model.some.type_registry.make_error_type();
        if (expr.target_type.is_some()) {
            target_type = this.model.some.resolve_type_specifier(expr.target_type.some, scope);
        } else {
            target_type = m.resolve_type_name(expr.type_name, scope, expr.location);
        }
        // E5 channel-object cast rule: a cast to a class/interface type whose
        // inner is a member access onto a declared port field operates on the
        // port's CHANNEL OBJECT (`cast<mut ISink<T>>(this.y)`,
        // `cast<mut _Fanout<T>>(f.y)`) — bind the inner RAW, without the
        // bare-read payload conversion.
        let inner: Option<BoundExpression> = this.bind_cast_inner(expr, target_type, scope);
        let result: mut BoundCastExpression = new BoundCastExpression(target_type, target_type, inner, false);

        if (inner.is_some() && !expr.is_unsafe) {
            let inner_type: BoundType = inner.some.get_bound_type();
            // Boxing: value type (class or enum) → interface. SKIPPED for
            // unsafe_cast — a raw reinterpret (e.g. i64 object_ref → interface
            // via inttoptr, penguin_meta_get_object) must not box.
            if (target_type.kind is TypeKind.InterfaceKind) {
                if (inner_type.is_value_type()) {
                    result.needs_boxing = true;
                    result.source_type_name = this.get_concrete_type_name(inner_type);
                }
            }
            // Unboxing: interface → value type (class or enum)
            if (inner_type.kind is TypeKind.InterfaceKind) {
                if (target_type.is_value_type()) {
                    result.needs_unboxing = true;
                    result.source_type_name = this.get_concrete_type_name(target_type);
                }
            }
        }

        return new Option<BoundExpression>.some(new BoundExpression.cast_expr(result));
    }


    fun get_concrete_type_name(this, bt: BoundType) -> string {
        _utils.trace_enter("Enter get_concrete_type_name");
        if (bt.type_definition.is_some()) {
            // A template+args bound type (e.g. the annotation `let p : mut Pair<i32>`)
            // carries the TEMPLATE def — its bare name resolves no layout at the
            // emitter, so BOX/UNBOX of a specialized generic value class found
            // neither a class nor an enum layout and emitted NOTHING (undefined
            // result register). Resolve the SPECIALIZED def and use its mangled
            // name — the same key ensure_class_layout registers layouts under.
            if (cast<i64>(bt.generic_args.size()) > 0) {
                let td_gc: BoundDefinition = bt.type_definition.some;
                let full_base: mut string = "";
                if (td_gc is BoundDefinition.class_def) { full_base = td_gc.class_def.full_name; }
                else if (td_gc is BoundDefinition.enum_def) { full_base = td_gc.enum_def.full_name; }
                else if (td_gc is BoundDefinition.interface_def) { full_base = td_gc.interface_def.full_name; }
                if (string_length(full_base) > 0) {
                    let mangled_gc: string = MonomorphizePass.mangle_generic_name(full_base, bt.generic_args);
                    let spec_sym_gc: Option<BoundSymbol> = this.model.some.global_scope.lookup_type_in_scope(mangled_gc);
                    if (spec_sym_gc.is_some() && spec_sym_gc.some is BoundSymbol.type_sym) {
                        if (let spec_td_gc := spec_sym_gc.some.type_sym.bound_type.type_definition.some) {
                            return spec_td_gc.get_name();
                        }
                    }
                }
            }
            return bt.type_definition.some.get_name();
        }
        return bt.display_name();
    }


    fun resolve_new_generic_args(this, expr: NewExpression, scope: BoundScope, bt: BoundType) -> mut BoundType {
        _utils.trace_enter("Enter resolve_new_generic_args");
        if (cast<i64>(expr.generic_args.size()) > 0) {
            // M4: route VALUE-arg new-instantiations (`new A<5>()`) through the
            // `_template_X` meta path — this is where value template args usually
            // appear, so wiring the pass-8 new-binding is what makes M4 actually
            // fire for the common value case. Returns the specialized type; the
            // caller (bind_new_expr) applies Mutable. Falls through to template+args
            // when M4 declines (type-only, no _template_X, or no JIT).
            let m4: Option<BoundType> = this.model.some.bind_meta_calls_pass.try_resolve_template_instantiation(expr.type_name, expr.generic_args, scope);
            if (m4.is_some()) {
                return this.model.some.resolve_types_pass.apply_mutability(m4.some, false);
            }
            let args: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
            let k: mut i64 = 0;
            while (k < cast<i64>(expr.generic_args.size())) {
                args.push(this.model.some.resolve_types_pass.resolve_single_generic_arg(expr.generic_args.at(cast<u64>(k)).some, scope));
                k = k + 1;
            }
            return bt.with_generic_args(args);
        }
        return bt;
    }


    // For a generic interface base type (e.g. IFoo<u8>), return the scope of the
    // specialized def (IFoo__u8) so member lookup resolves concrete method types
    // (T -> u8) and symbols (ns.IFoo__u8.bar). Falls back to the template scope.
    fun specialized_interface_scope(this, iface: BoundInterfaceDefinition, base_type: BoundType, scope: BoundScope) -> Option<BoundScope> {
        _utils.trace_enter("Enter specialized_interface_scope");
        if (cast<i64>(base_type.generic_args.size()) > 0) {
            let mangled: string = MonomorphizePass.mangle_generic_name(iface.full_name, base_type.generic_args);
            let spec_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(mangled);
            if (spec_sym.is_some()) {
                if (spec_sym.some is BoundSymbol.type_sym) {
                    if (let spec_td := spec_sym.some.type_sym.bound_type.type_definition.some) {
                        if (spec_td is BoundDefinition.interface_def) {
                            return spec_td.interface_def.scope;
                        }
                    }
                }
            }
        }
        return iface.scope;
    }


    fun resolve_type_by_name(this, name: string, scope: mut BoundScope) -> Option<BoundSymbol> {
        _utils.trace_enter("Enter resolve_type_by_name");
        let dot_idx: i64 = string_find(name, ".");
        if (dot_idx < 0) {
            return scope.lookup_type_in_scope(name);
        }
        // Split dotted name into parts and use resolve_qualified which traverses parent scopes
        let parts: mut _utils.List<string> = new _utils.List<string>();
        let pos: mut i64 = 0;
        let len: i64 = string_length(name);
        while (pos < len) {
            let next_dot: i64 = string_find_from(name, ".", pos);
            if (next_dot < 0) {
                parts.push(string_substring(name, pos, len - pos));
                pos = len;
            } else {
                parts.push(string_substring(name, pos, next_dot - pos));
                pos = next_dot + 1;
            }
        }
        return scope.resolve_qualified(parts);
    }


    fun find_last_dot(this, s: string) -> i64 {
        _utils.trace_enter("Enter find_last_dot");
        let len: i64 = string_length(s);
        let last_dot: mut i64 = -1;
        let si: mut i64 = 0;
        while (si < len) {
            let ch: string = string_char_at(s, si);
            if (ch == ".") {
                last_dot = si;
            }
            si = si + 1;
        }
        return last_dot;
    }


    // Check if an impl for is orphaned (both interface and type are external).
    fun check_orphan_impl(this, iface_type: BoundType, for_type: BoundType, impl_scope: BoundScope) -> bool {
        _utils.trace_enter("Enter check_orphan_impl");
        let ns_prefix: string = impl_scope.full_name + ".";
        let iface_ns: mut string = "";
        if (let def := iface_type.type_definition.some) {
            if (def is BoundDefinition.interface_def) {
                iface_ns = def.interface_def.full_name;
            }
        }
        let for_ns: mut string = "";
        if (let def := for_type.type_definition.some) {
            if (def is BoundDefinition.class_def) { for_ns = def.class_def.full_name; }
            if (def is BoundDefinition.enum_def) { for_ns = def.enum_def.full_name; }
        }
        let iface_local: bool = string_length(iface_ns) > 0 && string_find(iface_ns, ns_prefix) == 0;
        let for_local: bool = string_length(for_ns) > 0 && string_find(for_ns, ns_prefix) == 0;
        return !iface_local && !for_local;
    }


    fun try_bind_enum_variant(mut this, expr: NewExpression, scope: mut BoundScope, last_dot: i64) -> Option<BoundExpression> {
        _utils.trace_enter("Enter try_bind_enum_variant");
        let len: i64 = string_length(expr.type_name);
        let enum_name: string = string_substring(expr.type_name, 0, last_dot);
        let variant_name: string = string_substring(expr.type_name, last_dot + 1, len - last_dot - 1);
        let enum_sym: Option<BoundSymbol> = this.resolve_type_by_name(enum_name, scope);
        if (enum_sym.is_some()) {
            if (enum_sym.some is BoundSymbol.type_sym) {
                let bt: mut BoundType = this.resolve_new_generic_args(expr, scope, enum_sym.some.type_sym.bound_type);
                if (bt.kind is TypeKind.EnumKind && bt.type_definition.is_some()) {
                    let def: BoundDefinition = bt.type_definition.some;
                    if (def is BoundDefinition.enum_def) {
                        let enum_def: BoundEnumDefinition = def.enum_def;
                        let i: mut i64 = 0;
                        while (i < cast<i64>(enum_def.members.size())) {
                            let member: BoundEnumMemberDefinition = enum_def.members.at(cast<u64>(i)).some;
                            if (member.name == variant_name) {
                                let payload: Option<BoundExpression> = new Option<BoundExpression>.none();
                                if (cast<i64>(expr.arguments.size()) > 0) {
                                    let arg: Option<BoundExpression> = this.bind_expression(expr.arguments.at(cast<u64>(0)).some, scope);
                                    if (arg.is_some()) {
                                        let result: mut BoundEnumVariantExpression = new BoundEnumVariantExpression(bt, bt, variant_name, i, member.member_symbol, arg);
                                        return new Option<BoundExpression>.some(new BoundExpression.enum_variant(result));
                                    }
                                }
                                let result: mut BoundEnumVariantExpression = new BoundEnumVariantExpression(bt, bt, variant_name, i, member.member_symbol, payload);
                                return new Option<BoundExpression>.some(new BoundExpression.enum_variant(result));
                            }
                            i = i + 1;
                        }
                    }
                }
            }
        }
        return new Option<BoundExpression>.none();
    }


    // The lookup scope for resolving a newly created specialization pair: the
    // def's own scope when it has one (class/enum/interface/function), else
    // the global scope.
    fun spec_resolve_scope(this, def: BoundDefinition) -> BoundScope {
        if (def is BoundDefinition.function_def && def.function_def.scope.is_some()) {
            return def.function_def.scope.some;
        }
        if (def is BoundDefinition.class_def && def.class_def.scope.is_some()) {
            return def.class_def.scope.some;
        }
        if (def is BoundDefinition.enum_def && def.enum_def.scope.is_some()) {
            return def.enum_def.scope.some;
        }
        if (def is BoundDefinition.interface_def && def.interface_def.scope.is_some()) {
            return def.interface_def.scope.some;
        }
        return this.model.some.global_scope;
    }

    fun bind_new_expr(mut this, expr: NewExpression, scope: mut BoundScope) -> Option<BoundExpression> {        _utils.trace_enter("Enter bind_new_expr");
        // First, try to resolve the full type_name as a class/struct type
        let type_sym: Option<BoundSymbol> = this.resolve_type_by_name(expr.type_name, scope);
        if (type_sym.is_some()) {
            if (type_sym.some is BoundSymbol.type_sym) {
                let bt: mut BoundType = this.resolve_new_generic_args(expr, scope, type_sym.some.type_sym.bound_type);
                // On-demand specialization: a generic `new Foo<args>()` whose
                // specialization def doesn't exist yet — e.g. a generic field
                // DEFAULT initializer inside a specialized class whose field TYPE
                // is an interface (resolve_field_specialization ensures the
                // interface spec, but nothing else references Foo<args>, so no
                // def/layout/ctor is ever emitted and the NEW lowers to garbage).
                // Mirrors ensure_specialized_type's late-creation branch but with
                // catch_up_def_BEFORE_BODIES: binding bodies re-entrantly inside
                // an expression bind corrupts resolution (see bind_spawn_async) —
                // the pushed def's bodies are bound later by the dynamic pass-8
                // loop. bt keeps the template+args shape so downstream lowering
                // is unchanged.
                // GUARD: refuse when any type arg is an unresolved template
                // param (a still-generic body's `new Foo<V>`): such specs are
                // garbage, and self-referential ones (V from THIS class's own
                // template methods) grow without bound (see
                // bound_type_is_template_param).
                let arg_has_tpl: mut bool = false;
                let gi: mut i64 = 0;
                while (gi < cast<i64>(bt.generic_args.size())) {
                    if (bound_type_is_template_param(arg_as_bound_type(bt.generic_args.at(cast<u64>(gi)).some))) { arg_has_tpl = true; }
                    gi = gi + 1;
                }
                if (!arg_has_tpl && cast<i64>(bt.generic_args.size()) > 0 && this.model.some.current_unit.is_some()) {
                    let full_base: mut string = expr.type_name;
                    let tmpl_short: mut string = expr.type_name;
                    if (bt.type_definition.is_some()) {
                        let td0: BoundDefinition = bt.type_definition.some;
                        if (td0 is BoundDefinition.class_def) { full_base = td0.class_def.full_name; tmpl_short = td0.class_def.name; }
                        if (td0 is BoundDefinition.enum_def) { full_base = td0.enum_def.full_name; tmpl_short = td0.enum_def.name; }
                        if (td0 is BoundDefinition.interface_def) { full_base = td0.interface_def.full_name; tmpl_short = td0.interface_def.name; }
                    }
                    let mangled_spec: string = MonomorphizePass.mangle_generic_name(full_base, bt.generic_args);
                    let spec_existing: Option<BoundSymbol> = this.model.some.global_scope.lookup_type_in_scope(mangled_spec);
                    if (spec_existing.is_none()) {
                        let inst_bt: BoundType = type_sym.some.type_sym.bound_type.with_generic_args(bt.generic_args);
                        let spec_new: Option<BoundDefinition> = this.model.some.monomorphize_pass.ensure_specialized_def(inst_bt, this.model.some.global_scope);
                        if (spec_new.is_some()) {
                            // Resolve the pair FIRST (fields/methods/impl-method
                            // signatures — without it the spec's methods have
                            // no parameters and `this` never resolves), then
                            // the signature-level catch-up, then register for
                            // the dynamic pass-8 body-binding loop. The
                            // resolve runs at pass index 3 (the monomorphize
                            // protocol): stamping the def at 8 here would make
                            // every catch-up sub-pass skip it (already
                            // processed) — no vtables, no value/ref
                            // classification (defaults to stack allocation).
                            let ast_spec: Option<Definition> = this.model.some.monomorphize_pass.find_ast_def_by_name(this.model.some.ast_definitions, tmpl_short);
                            let m0: mut SemanticModel = this.model.some;
                            let saved_idx0: i64 = m0.current_pass_index;
                            if (ast_spec.is_some()) {
                                m0.current_pass_index = 3;
                                let to_register: BoundDefinition = this.model.some.resolve_types_pass.resolve_pair(ast_spec.some, spec_new.some, this.spec_resolve_scope(spec_new.some));
                                m0.current_pass_index = saved_idx0;
                                m0.catch_up_def_before_bodies(to_register, this.model.some.current_unit.some);
                                this.model.some.current_unit.some.definitions.push(to_register);
                                // Method-signature instantiations of the new
                                // spec are invisible to the finished pass-3
                                // fixpoint — complete them recursively.
                                this.model.some.monomorphize_pass.late_ensure_def_signatures(to_register, this.model.some.global_scope);
                            } else {
                                m0.catch_up_def_before_bodies(spec_new.some, this.model.some.current_unit.some);
                                this.model.some.current_unit.some.definitions.push(spec_new.some);
                                this.model.some.monomorphize_pass.late_ensure_def_signatures(spec_new.some, this.model.some.global_scope);
                            }
                        }
                    }
                }
                // If this is an enum type, the full name was a type, not a variant — just instantiate
                let args: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
                let i: mut i64 = 0;
                while (i < cast<i64>(expr.arguments.size())) {
                    let bound_arg: Option<BoundExpression> = this.bind_expression(expr.arguments.at(cast<u64>(i)).some, scope);
                    if (bound_arg.is_some()) {
                        args.push(bound_arg.some);
                    }
                    i = i + 1;
                }
                // Constructor arity check: `new P(3,4)` on a class whose only
                // ctor is the synthesized default `new(mut this)` must fail
                // here — without it the extra arguments are silently dropped
                // and the object is constructed with zeroed fields. The ctor
                // def (template or specialized — the parameter COUNT is
                // identical either way) carries the call contract.
                if (bt.type_definition.is_some()) {
                    let td_check: BoundDefinition = bt.type_definition.some;
                    if (td_check is BoundDefinition.class_def) {
                        let cls_check: mut BoundClassDefinition = td_check.class_def;
                        if (cls_check.constructor.is_some()) {
                            let ctor_check: BoundFunctionDefinition = cls_check.constructor.some;
                            let param_count: i64 = cast<i64>(ctor_check.parameters.size());
                            let expected_args: mut i64 = param_count;
                            if (param_count > 0 && ctor_check.parameters.at(cast<u64>(0)).some.name == "this") {
                                expected_args = param_count - 1;
                            }
                            let provided_args: i64 = cast<i64>(expr.arguments.size());
                            if (provided_args != expected_args) {
                                this.model.some.report_error(new ErrorCode.E_CALL_ARITY(),
                                    "Constructor '" + cls_check.name + ".new' expects " + cast<string>(expected_args)
                                    + " arguments but " + cast<string>(provided_args) + " were provided",
                                    new SourceLocation("", 0, 0));
                            }
                        }
                    }
                }
                let result: mut BoundNewExpression = new BoundNewExpression(bt.with_mutability(new Mutability.Mutable()), new Option<BoundTypeSymbol>.some(type_sym.some.type_sym), new Option<BoundFunctionSymbol>.none(), args);
                return new Option<BoundExpression>.some(new BoundExpression.new_expr(result));
            }
        }

        // If not found as a type, try as an enum variant (e.g., "Option.some" → enum Option, variant some)
        let last_dot: i64 = this.find_last_dot(expr.type_name);
        if (last_dot >= 0) {
            let enum_result: Option<BoundExpression> = this.try_bind_enum_variant(expr, scope, last_dot);
            if (enum_result.is_some()) {
                return enum_result;
            }
        }

        // Fallback: create with unresolved type
        let args: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
        let i: mut i64 = 0;
        while (i < cast<i64>(expr.arguments.size())) {
            let bound_arg: Option<BoundExpression> = this.bind_expression(expr.arguments.at(cast<u64>(i)).some, scope);
            if (bound_arg.is_some()) {
                args.push(bound_arg.some);
            }
            i = i + 1;
        }
        let result: mut BoundNewExpression = new BoundNewExpression(new BoundType(), new Option<BoundTypeSymbol>.none(), new Option<BoundFunctionSymbol>.none(), args);
        return new Option<BoundExpression>.some(new BoundExpression.new_expr(result));
    }


}

// Capture classification for one identifier encountered in a lambda body.
enum LamCaptureKind {
    NotVariable;   // resolves inside __call anyway (global / function / type)
    Capturable;    // a local/param of the enclosing function scope chain
    ClassMember;   // lives in a class/enum/interface/impl scope (v1: error)
    ThisParam;     // the enclosing method's `this` (v1: error)
}

// Mutable analysis state threaded through the lambda-body traversal: shadow =
// names declared inside the lambda body that hide outer locals; names/types =
// captures in first-appearance order; last_found_type = the classified
// variable's type (valid only right after a Capturable result).
class LamAnalysis {
    shadow: mut _utils.List<string> = new _utils.List<string>();
    names: mut _utils.List<string> = new _utils.List<string>();
    types: mut _utils.List<BoundType> = new _utils.List<BoundType>();
    last_found_type: mut Option<BoundType> = new Option<BoundType>.none();
    error_count: mut i64 = 0;
}

}
