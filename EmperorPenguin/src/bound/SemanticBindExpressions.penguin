// Pass 8 (phase 2 of 3) of the SemanticModel pipeline, extracted from
// SemanticModel.penguin: EXPRESSION binding. This driver dispatches every
// expression to its bound form and hosts the shared expression builders
// (mk_*) plus verbatim forwarders for the externally-called methods that
// moved to the per-concern collaborator modules (batch 0.2 split of the
// former 6830-line file):
//   SemanticBindExprCoroutine/Ownership (spawn/wait/port + escape audit),
//   SemanticBindExprCall (call binding), SemanticBindExprMember,
//   SemanticBindExprCastNew (cast/new/try-bind), SemanticBindExprLiteral
//   (literals/operators/control-flow), SemanticBindExprLambda,
//   SemanticBindExprGenerator. Method bodies moved verbatim; the meta
// call family stays in SemanticBindExpressions's sibling
// SemanticBindMetaCalls.penguin.
namespace emperor {

class BindExpressionsPass {
    // 共享编译状态（M1 pass 类模式）：.none() 哑默认 + 构造函数 .some(model) 赋值，
    // 破除 SemanticModel <-> 本 pass 的类环。
    model: mut Option<SemanticModel> = new Option<SemanticModel>.none();

    // ---- Per-concern collaborator modules (batch 0.2 split) ----
    coroutine: mut BindExprCoroutine;
    // Class name historically avoided the "Ownership" substring (the old
    // substring-matching new-gate — see the note atop
    // SemanticBindExprOwnership.penguin; the gate is exact now).
    linear: mut BindExprLinear;
    call: mut BindExprCall;
    member: mut BindExprMember;
    castnew: mut BindExprCastNew;
    literal: mut BindExprLiteral;
    lambda: mut BindExprLambda;
    generator: mut BindExprGenerator;

    fun new(mut this, model: mut SemanticModel) {
        this.model = new Option<SemanticModel>.some(model);
        this.coroutine = new BindExprCoroutine(this);
        this.linear = new BindExprLinear(this);
        this.call = new BindExprCall(this);
        this.member = new BindExprMember(this);
        this.castnew = new BindExprCastNew(this);
        this.literal = new BindExprLiteral(this);
        this.lambda = new BindExprLambda(this);
        this.generator = new BindExprGenerator(this);
    }

    fun bind_expression(mut this, expr: Expression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_expression");
        // mut-this core methods (bind_meta_call / resolve_type_name) need a
        // mutable SemanticModel: rebind the Option payload once here.
        let m: mut SemanticModel = this.model.some;
        if (expr is Expression.constant) {
            return this.literal.bind_constant(expr.constant, scope);
        }
        if (expr is Expression.string_literal) {
            return this.literal.bind_string_literal(expr.string_literal, scope);
        }
        if (expr is Expression.bool_literal) {
            return this.literal.bind_bool_literal(expr.bool_literal, scope);
        }
        if (expr is Expression.void_literal) {
            return this.literal.bind_void_literal(scope);
        }
        if (expr is Expression.parenthesized) {
            if (expr.parenthesized.inner.is_some()) {
                if (scope.is_region) {
                    // Already inside a try-bind region: parens are transparent.
                    return this.bind_expression(expr.parenthesized.inner.some, scope);
                }
                // A parenthesized expression is a try-bind region boundary:
                // pattern variables bound inside die with the parens.
                let paren_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<paren>", scope.full_name + ".<paren>", new Option<BoundScope>.some(scope));
                paren_scope.is_region = true;
                return this.bind_expression(expr.parenthesized.inner.some, paren_scope);
            }
        }
        if (expr is Expression.identifier) {
            return this.literal.bind_identifier(expr.identifier, scope);
        }
        if (expr is Expression.binary) {
            return this.literal.bind_binary(expr.binary, scope);
        }
        if (expr is Expression.unary) {
            return this.literal.bind_unary(expr.unary, scope);
        }
        if (expr is Expression.member_access) {
            let ma_result: Option<BoundExpression> = this.member.bind_member_access(expr.member_access, scope);
            if (ma_result.is_some() && ma_result.some is BoundExpression.member_access) {
                return new Option<BoundExpression>.some(this.member.adjust_method_ref_type(ma_result.some.member_access));
            }
            return ma_result;
        }
        if (expr is Expression.function_call) {
            // Native-array magic methods: `a.at(i)` / `a.set(i,v)` / `a.size()`
            // / `a.iter()` / `a.iter_mut()` on an `array<T>` receiver rewrite to the
            // generic stdlib functions (specialized by argument inference).
            if (this.call.rewrite_array_member_call(expr.function_call, scope)) {
                return this.call.bind_function_call(expr.function_call, scope);
            }
            return this.call.bind_function_call(expr.function_call, scope);
        }
        if (expr is Expression.if_expr) {
            return this.literal.bind_if_expr(expr.if_expr, scope);
        }
        if (expr is Expression.while_expr) {
            return this.literal.bind_while_expr(expr.while_expr, scope);
        }
        if (expr is Expression.code_block) {
            return this.literal.bind_code_block(expr.code_block, scope);
        }
        if (expr is Expression.cast_expr) {
            return this.castnew.bind_cast(expr.cast_expr, scope);
        }
        if (expr is Expression.new_expr) {
            return this.castnew.bind_new_expr(expr.new_expr, scope);
        }
        if (expr is Expression.meta_call) {
            return m.bind_meta_calls_pass.bind_meta_call(expr.meta_call, scope);
        }
        if (expr is Expression.try_bind) {
            // P2: general try-bind expression — bind the RHS, register the
            // pattern variable into the current region scope, return a bool
            // expression that writes the payload when the check succeeds.
            return this.castnew.bind_try_bind(expr.try_bind, scope);
        }
        if (expr is Expression.wait_expr) {
            // wait is a scheduler suspension point — desugared per form into
            // extern calls / poll loops / do_wait member calls (see
            // bind_wait_expr), mirroring the BabyPenguin lowering.
            return this.coroutine.bind_wait_expr(expr.wait_expr, scope);
        }
        if (expr is Expression.spawn_async) {
            return this.coroutine.bind_spawn_async(expr.spawn_async, scope);
        }
        if (expr is Expression.lambda_expr) {
            return this.lambda.bind_lambda(expr.lambda_expr, scope);
        }
        return new Option<BoundExpression>.none();
    }

    // ---- wait / async lowering (coroutine scheduler) ----

    // Build `__builtin.<name>(args...)`.
    fun mk_block_expr(this, stmts: mut _utils.List<Statement>, trailing: mut Option<Expression>) -> Expression {
        let cb: CodeBlockExpression = new CodeBlockExpression();
        cb.statements = stmts;
        cb.trailing_expr = trailing;
        return new Expression.code_block(cb);
    }

    // ---- E5 port sugar (bare reads, permission matrix, raw channel reads) ----

    // Bind an expression with port sugar suppressed: bare port reads stay
    // RAW channel-object accesses. Used for member-access receivers (a
    // method call on `this.y` needs the channel, not the payload slot) and
    // for the connect desugaring's generated field writes.
    fun mk_ident_expr(this, name: string) -> Expression {
        return new Expression.identifier(new IdentifierExpression(name));
    }
    fun mk_this_member(this, member: string) -> Expression {
        let ma: MemberAccessExpression = new MemberAccessExpression();
        ma.base_expr = new Option<Expression>.some(this.mk_ident_expr("this"));
        ma.member_name = member;
        return new Expression.member_access(ma);
    }
    fun mk_assign_stmt(this, target: Expression, value: Expression) -> Statement {
        let a: mut AssignmentStatement = new AssignmentStatement();
        a.target = new Option<Expression>.some(target);
        a.operator_value = new AssignmentOperator.Assign();
        a.value = new Option<Expression>.some(value);
        a.location = new SourceLocation("", 0, 0);
        return new Statement.assignment(a);
    }

    // ---- lambda desugar (fun-value closures) ----
    // A lambda becomes a synthesized closure class `__lambda_<n>`:
    //   class __lambda_<n> {
    //     <cap>: <T>; ...                                  // by-value snapshot
    //     fun new(mut this, <cap>: <T>, ...) { this.<cap> = <cap>; ... }
    //     fun __call(mut this, <params>) -> <ret> { <body, captures -> this.<cap>> }
    //   }
    // The class is marked is_funval: its metadata carries a .__FunVal entry
    // (slot 0 = __call), so the closure OBJECT is the fun value — one
    // allocation, single indirection (no invoker wrapper).
    // Captured identifiers are rewritten to `this.<name>` member accesses in
    // place; a miss in this traversal is loud (E_UNDEFINED inside __call), so
    // unhandled expression kinds fail compilation instead of misbehaving.
    fun mk_member_call_expr(this, base: Expression, member: string, args: mut _utils.List<Expression>) -> Expression {
        let ma: MemberAccessExpression = new MemberAccessExpression();
        ma.base_expr = new Option<Expression>.some(base);
        ma.member_name = member;
        let fc: FunctionCallExpression = new FunctionCallExpression();
        fc.callee = new Option<Expression>.some(new Expression.member_access(ma));
        let i: mut i64 = 0;
        while (i < cast<i64>(args.size())) {
            fc.arguments.push(args.at(cast<u64>(i)).some);
            i = i + 1;
        }
        return new Expression.function_call(fc);
    }
    fun find_last_dot(this, s: string) -> i64 {
        _utils.trace_enter("Enter find_last_dot");
        let len: i64 = string_length(s);
        let last_dot: mut i64 = -1;
        let si: mut i64 = 0;
        while (si < len) {
            let ch: string = string_char_at(s, si);
            if (ch == ".") {
                last_dot = si;
            }
            si = si + 1;
        }
        return last_dot;
    }


    // Check if an impl for is orphaned (both interface and type are external).

    // ---- External-call-surface forwarders (batch 0.2 split): these
    // moved to their concern module; delegates kept verbatim so
    // SemanticModel / other passes call sites are unchanged. ----

    fun bind_expr_no_port_sugar(mut this, e: Expression, scope: mut BoundScope) -> Option<BoundExpression> {
        return this.coroutine.bind_expr_no_port_sugar(e, scope);
    }

    fun enclosing_routine_name(this, scope: mut BoundScope) -> string {
        return this.coroutine.enclosing_routine_name(scope);
    }

    fun in_construct_routine(this, scope: mut BoundScope) -> bool {
        return this.coroutine.in_construct_routine(scope);
    }

    fun top_level_pool_id(this, scope: mut BoundScope) -> string {
        return this.coroutine.top_level_pool_id(scope);
    }

    fun construct_pool_id(this, scope: mut BoundScope) -> string {
        return this.coroutine.construct_pool_id(scope);
    }

    fun resolve_port_access_for_base(mut this, e: Expression, scope: mut BoundScope) -> Option<PortAccessInfo> {
        return this.coroutine.resolve_port_access_for_base(e, scope);
    }

    fun resolve_port_access(mut this, expr: MemberAccessExpression, scope: mut BoundScope) -> Option<PortAccessInfo> {
        return this.coroutine.resolve_port_access(expr, scope);
    }

    fun register_body_driver(mut this, info: PortAccessInfo, scope: mut BoundScope) {
        this.coroutine.register_body_driver(info, scope);
    }

    fun find_event_class_type(this, bt: BoundType) -> Option<BoundType> {
        return this.coroutine.find_event_class_type(bt);
    }

    fun spawn_type_spec(mut this, bt: BoundType) -> TypeSpecifier {
        return this.coroutine.spawn_type_spec(bt);
    }

    fun is_generator_return_type(this, bt: BoundType) -> bool {
        return this.generator.is_generator_return_type(bt);
    }

    fun bind_generator_function(mut this, ast_func: FunctionDefinition, bound_func: BoundFunctionDefinition, elem_bt: BoundType, func_scope: mut BoundScope) -> Option<Expression> {
        return this.generator.bind_generator_function(ast_func, bound_func, elem_bt, func_scope);
    }

    fun bound_literal_i64_value(this, bexpr: BoundExpression) -> Option<i64> {
        return this.call.bound_literal_i64_value(bexpr);
    }

    fun bind_optional_expr(mut this, opt: Option<Expression>, scope: mut BoundScope) -> Option<BoundExpression> {
        return this.literal.bind_optional_expr(opt, scope);
    }

    fun analyze_try_bind(mut this, tb: TryBindExpression, bound_rhs: BoundExpression, scope: mut BoundScope) -> Option<TryBindAnalysis> {
        return this.castnew.analyze_try_bind(tb, bound_rhs, scope);
    }

    fun build_cast_bound(mut this, inner: BoundExpression, target_type: BoundType) -> BoundCastExpression {
        return this.castnew.build_cast_bound(inner, target_type);
    }

    fun resolve_type_by_name(this, name: string, scope: mut BoundScope) -> Option<BoundSymbol> {
        return this.castnew.resolve_type_by_name(name, scope);
    }

    fun check_orphan_impl(this, iface_type: BoundType, for_type: BoundType, impl_scope: BoundScope) -> bool {
        return this.castnew.check_orphan_impl(iface_type, for_type, impl_scope);
    }

    fun get_field_mutability_from_class(this, cls: BoundClassDefinition, field_name: string) -> Mutability {
        return this.member.get_field_mutability_from_class(cls, field_name);
    }

    fun resolve_container_vtables(this, base_type: BoundType, template_vtables: _utils.List<BoundVTable>, scope: BoundScope) -> _utils.List<BoundVTable> {
        return this.member.resolve_container_vtables(base_type, template_vtables, scope);
    }

    fun ensure_generic_iface_spec(mut this, iface_short: string, payload: BoundType, scope: mut BoundScope) {
        this.member.ensure_generic_iface_spec(iface_short, payload, scope);
    }
}

}
