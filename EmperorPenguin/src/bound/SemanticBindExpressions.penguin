                            let direct_disp: mut bool = false;
                            let direct_sym: mut Option<BoundSymbol> = ma_expr.member_symbol;
                            if (ma_expr.base_expr.is_some()) {
                                let base_type: BoundType = ma_expr.base_expr.some.get_bound_type();
                                if (base_type.kind is TypeKind.InterfaceKind) {
                                    // Check if this is a temporary box that can be elided:
                                    // cast<Interface>(value).method() → call method directly
                                    if (ma_expr.base_expr.some is BoundExpression.cast_expr) {
                                        let cast_e: BoundCastExpression = ma_expr.base_expr.some.cast_expr;
                                        if (cast_e.needs_boxing) {
                                            direct_disp = true;
                                            // Resolve the concrete implementation method from the value type's vtable
                                            if (cast_e.inner.is_some() && ma_expr.member_symbol.is_some()) {
                                                let inner_type: BoundType = cast_e.inner.some.get_bound_type();
                                                let resolved: Option<BoundFunctionSymbol> = this.resolve_implementation_method(inner_type, base_type, ma_expr.member_symbol.some);
                                                if (resolved.is_some()) {
                                                    direct_sym = new Option<BoundSymbol>.some(new BoundSymbol.function_sym(resolved.some));
                                                }
                                            }
                                        } else {
                                            is_virt = true;
                                        }
                                    } else {
                                        // Distinguish a value receiver (`f.foo()`) from a type-name
                                        // call (`IFoo.foo()` / `ns.IFoo.foo()`). A value receiver uses
                                        // virtual dispatch so the override is selected at runtime --
                                        // including for no-`this` (default/static) methods, where the
                                        // receiver is used only for the vtable lookup and not passed
                                        // (see lower_function_call). A type-name call stays static.
                                        let base_is_value: mut bool = false;
                                        if (ma_expr.base_expr.some is BoundExpression.identifier) {
                                            let base_id: BoundIdentifierExpression = ma_expr.base_expr.some.identifier;
                                            if (base_id.symbol.is_some()) {
                                                if (base_id.symbol.some is BoundSymbol.variable) {
                                                    base_is_value = true;
                                                }
                                            }
                                        }
                                        if (ma_expr.base_expr.some is BoundExpression.member_access) {
                                            // A member_access base is a value unless it resolves to a
                                            // type/namespace (e.g. `ns.IFoo` in `ns.IFoo.foo()`).
                                            let inner_ma: BoundMemberAccessExpression = ma_expr.base_expr.some.member_access;
                                            let inner_is_type_or_ns: mut bool = false;
                                            if (inner_ma.member_symbol.is_some()) {
                                                if (inner_ma.member_symbol.some is BoundSymbol.type_sym) { inner_is_type_or_ns = true; }
                                                if (inner_ma.member_symbol.some is BoundSymbol.namespace_sym) { inner_is_type_or_ns = true; }
                                            }
                                            if (!inner_is_type_or_ns) {
                                                base_is_value = true;
                                            }
                                        }
                                        if (ma_expr.base_expr.some is BoundExpression.function_call) {
                                            base_is_value = true;
                                        }
                                        if (base_is_value) {
                                            is_virt = true;
                                        } else if (ma_expr.member_symbol.is_some()) {
                                            // Static interface methods (no 'this' parameter) called on
                                            // the interface type name directly: no object receiver, so
                                            // no virtual dispatch.
                                            let ms: BoundSymbol = ma_expr.member_symbol.some;
                                            if (ms is BoundSymbol.function_sym) {
                                                if (this.function_is_method(ms.function_sym)) {
                                                    is_virt = true;
                                                }
                                            } else {
                                                is_virt = true;
                                            }
                                        }
                                    }
                                }
                            }
                            this.check_argument_types(sym.function_sym, args);
                            let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(bt, callee, direct_sym, args, is_virt, empty_generic_args, false);
                            if (direct_disp) {
                                result.direct_dispatch = true;
                            }
                            return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
                        }
                    }
                    // Constructing an enum variant WITHOUT `new` (e.g.
                    // `Option<i64>.some(42)`) is a user error. The old silent
                    // fallback built a void-typed call with no callee symbol,
                    // poisoning every dependent expression (and eventually dying in
                    // the IR generator with E_INTERNAL: Function call has no callee
                    // symbol). Scoped to enum-member symbols only: BabyPenguin also
                    // accepts calls of function-typed FIELDS (`h.cb(21)`), which
                    // EmperorPenguin does not support yet — that gap must keep its
                    // own (internal) failure, not be rejected as invalid syntax.
                    // (Must stay INSIDE the `if member_access` block: ma_expr is
                    // declared there, and EmperorPenguin's block scoping — unlike
                    // BabyPenguin's function-level leak — rejects outer use.)
                    if (ma_expr.member_symbol.is_some() && ma_expr.member_symbol.some is BoundSymbol.enum_member) {
                        // Spell the callee as the user wrote it (build_text keeps the
                        // generic args, e.g. `Option<i64>.some`; the bound type would
                        // render the specialization's mangled name instead).
                        let callable_name: mut string = ma_expr.member_name;
                        if (let ast_callee2 := expr.callee.some) {
                            callable_name = ast_callee2.build_text();
                        }
                        this.model.some.report_error(new ErrorCode.E_CALL_NOT_FUNCTION(),
                            "'" + callable_name + "' is not a valid function (enum variants are constructed with 'new')",
                            new SourceLocation("", 0, 0));
                    }
                }
                let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(new BoundType(), callee, new Option<BoundSymbol>.none(), args, false, empty_generic_args, false);
                return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
            }
        }
        this.model.some.trace("bind_function_call no candidate matched: " + (if (expr.callee.is_some()) { expr.callee.some.build_text() } else { "?" }) + " (" + cast<string>(args.size()) + " arg(s))");
        let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(new BoundType(), new Option<BoundExpression>.none(), new Option<BoundSymbol>.none(), args, false, empty_generic_args, false);
        return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
    }


    fun bind_arguments(mut this, args: _utils.List<Expression>, scope: mut BoundScope) -> mut _utils.List<BoundExpression> {
        _utils.trace_enter("Enter bind_arguments");
        let result: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
        let i: mut i64 = 0;
        while (i < cast<i64>(args.size())) {
            let bound_arg: Option<BoundExpression> = this.bind_expression(args.at(cast<u64>(i)).some, scope);
            if (bound_arg.is_some()) {
                result.push(bound_arg.some);
            }
            i = i + 1;
        }
        return result;
    }


    // Extract an i64 from a bound integer literal, or none if not a constant int.
    fun bound_literal_i64_value(this, bexpr: BoundExpression) -> Option<i64> {
        if (bexpr is BoundExpression.literal) {
            if (bexpr.literal.literal_kind is LiteralKind.IntegerLiteral) {
                return new Option<i64>.some(string_to_int(bexpr.literal.value));
            }
        }
        return new Option<i64>.none();
    }


    fun bind_if_expr(mut this, expr: IfExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_if_expr");
        if (expr.condition.is_some() && expr.condition.some is Expression.try_bind) {
            return this.bind_try_bind_if_expr(expr, scope);
        }
        // P2: bind the condition in a fresh condition-region so try-bind pattern
        // variables from `&&` chains are visible in the then-branch (definitely
        // assigned when the condition is true) but not in else or after.
        let cond_region: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<cond>", scope.full_name + ".<cond>", new Option<BoundScope>.some(scope));
        cond_region.is_region = true;
        cond_region.is_condition_region = true;
        let condition: Option<BoundExpression> = this.bind_optional_expr(expr.condition, cond_region);
        let then_block: Option<BoundExpression> = this.bind_optional_expr(expr.then_block, cond_region);
        let else_block: Option<BoundExpression> = this.bind_optional_expr(expr.else_block, scope);
        if (then_block.is_some()) {
            let bt: BoundType = then_block.some.get_bound_type();
            let result: mut BoundIfExpression = new BoundIfExpression(bt, condition, then_block, else_block);
            return new Option<BoundExpression>.some(new BoundExpression.if_expr(result));
        }
        let result: mut BoundIfExpression = new BoundIfExpression(new BoundType(), condition, then_block, else_block);
        return new Option<BoundExpression>.some(new BoundExpression.if_expr(result));
    }


    fun bind_while_expr(mut this, expr: WhileExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_while_expr");
        if (expr.condition.is_some() && expr.condition.some is Expression.try_bind) {
            return this.bind_try_bind_while_expr(expr, scope);
        }
        // P2: same condition-region promotion as bind_if_expr.
        let cond_region: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<cond>", scope.full_name + ".<cond>", new Option<BoundScope>.some(scope));
        cond_region.is_region = true;
        cond_region.is_condition_region = true;
        let condition: Option<BoundExpression> = this.bind_optional_expr(expr.condition, cond_region);
        let body: Option<BoundExpression> = this.bind_optional_expr(expr.body, cond_region);
        let result: mut BoundWhileExpression = new BoundWhileExpression(this.model.some.type_registry.void_type, condition, body);
        return new Option<BoundExpression>.some(new BoundExpression.while_expr(result));
    }


    // Prepend a `let a = EXT` statement into a bound code block (or wrap a
    // non-block expression) so the try-bind payload write executes before the
    // then/body statements. The variable is registered in `new_scope`.
    fun prepend_try_bind_let(mut this, block: Option<BoundExpression>, let_stmt: BoundLetDeclarationStatement, new_scope: BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter prepend_try_bind_let");
        if (block.is_none()) { return new Option<BoundExpression>.none(); }
        let stmts: mut _utils.List<BoundStatement> = new _utils.List<BoundStatement>();
        stmts.push(new BoundStatement.let_decl(let_stmt));
        if (block.some is BoundExpression.code_block) {
            let cb: BoundCodeBlockExpression = block.some.code_block;
            let si: mut i64 = 0;
            while (si < cast<i64>(cb.statements.size())) {
                stmts.push(cb.statements.at(cast<u64>(si)).some);
                si = si + 1;
            }
            let new_cb: mut BoundCodeBlockExpression = new BoundCodeBlockExpression(cb.bound_type, stmts, cb.trailing_expr, new Option<BoundScope>.some(new_scope));
            return new Option<BoundExpression>.some(new BoundExpression.code_block(new_cb));
        }
        let new_cb2: mut BoundCodeBlockExpression = new BoundCodeBlockExpression(block.some.get_bound_type(), stmts, block, new Option<BoundScope>.some(new_scope));
        return new Option<BoundExpression>.some(new BoundExpression.code_block(new_cb2));
    }


    // Expression-level `if (let a [: T] := b) then else` (code blocks parse `if`
    // as an expression) → `if (CHK) { let a = EXT; then } else`.
    fun bind_try_bind_if_expr(mut this, expr: IfExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_try_bind_if_expr");
        let tb: TryBindExpression = expr.condition.some.try_bind;
        let bound_rhs: Option<BoundExpression> = this.bind_expression(tb.rhs.some, scope);
        if (bound_rhs.is_none()) { return new Option<BoundExpression>.none(); }
        let analysis: Option<TryBindAnalysis> = this.analyze_try_bind(tb, bound_rhs.some, scope);
        if (analysis.is_none()) { return new Option<BoundExpression>.none(); }
        let then_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<try-bind>", scope.full_name + ".<try-bind>", new Option<BoundScope>.some(scope));
        then_scope.add_symbol(new BoundSymbol.variable(analysis.some.variable_symbol.some));
        let bound_then: Option<BoundExpression> = this.bind_optional_expr(expr.then_block, then_scope);
        let let_stmt: mut BoundLetDeclarationStatement = new BoundLetDeclarationStatement(
            analysis.some.variable_symbol, analysis.some.extract, analysis.some.bound_type,
            new Option<BoundScope>.some(then_scope));
        let_stmt.location = tb.location;
        let then_expr: Option<BoundExpression> = this.prepend_try_bind_let(bound_then, let_stmt, then_scope);
        let else_block: Option<BoundExpression> = this.bind_optional_expr(expr.else_block, scope);
        if (then_expr.is_some()) {
            let r1: mut BoundIfExpression = new BoundIfExpression(then_expr.some.get_bound_type(), analysis.some.check, then_expr, else_block);
            return new Option<BoundExpression>.some(new BoundExpression.if_expr(r1));
        }
        let r2: mut BoundIfExpression = new BoundIfExpression(this.model.some.type_registry.void_type, analysis.some.check, then_expr, else_block);
        return new Option<BoundExpression>.some(new BoundExpression.if_expr(r2));
    }


    // Expression-level `while (let a [: T] := b) body` → `while (CHK) { let a = EXT; body }`.
    fun bind_try_bind_while_expr(mut this, expr: WhileExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_try_bind_while_expr");
        let tb: TryBindExpression = expr.condition.some.try_bind;
        let bound_rhs: Option<BoundExpression> = this.bind_expression(tb.rhs.some, scope);
        if (bound_rhs.is_none()) { return new Option<BoundExpression>.none(); }
        let analysis: Option<TryBindAnalysis> = this.analyze_try_bind(tb, bound_rhs.some, scope);
        if (analysis.is_none()) { return new Option<BoundExpression>.none(); }
        let body_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<try-bind>", scope.full_name + ".<try-bind>", new Option<BoundScope>.some(scope));
        body_scope.add_symbol(new BoundSymbol.variable(analysis.some.variable_symbol.some));
        let bound_body: Option<BoundExpression> = this.bind_optional_expr(expr.body, body_scope);
        let let_stmt: mut BoundLetDeclarationStatement = new BoundLetDeclarationStatement(
            analysis.some.variable_symbol, analysis.some.extract, analysis.some.bound_type,
            new Option<BoundScope>.some(body_scope));
        let_stmt.location = tb.location;
        let body_expr: Option<BoundExpression> = this.prepend_try_bind_let(bound_body, let_stmt, body_scope);
        let result: mut BoundWhileExpression = new BoundWhileExpression(this.model.some.type_registry.void_type, analysis.some.check, body_expr);
        return new Option<BoundExpression>.some(new BoundExpression.while_expr(result));
    }


    fun bind_optional_expr(mut this, opt: Option<Expression>, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_optional_expr");
        if (opt.is_some()) {
            return this.bind_expression(opt.some, scope);
        }
        return new Option<BoundExpression>.none();
    }


    // Analyze a `let a [: T] := b` try-bind. Returns the bound variable, the
    // boolean check expression, and the guarded extract expression. v1 supports
    // enum variant member access (`let x := opt.some`); other shapes report an
    // error. The variable is NOT registered here — the caller registers it into
    // the true-branch scope so it is visible only where the check holds.
    fun analyze_try_bind(mut this, tb: TryBindExpression, bound_rhs: BoundExpression, scope: mut BoundScope) -> Option<TryBindAnalysis> {
        _utils.trace_enter("Enter analyze_try_bind");
        // Enum variant member access: `let x := opt.some`
        if (bound_rhs is BoundExpression.member_access) {
            let ma: BoundMemberAccessExpression = bound_rhs.member_access;
            if (ma.member_symbol.is_some() && ma.base_expr.is_some()) {
                let sym: BoundSymbol = ma.member_symbol.some;
                if (sym is BoundSymbol.enum_member) {
                    let enum_type: BoundType = ma.base_expr.some.get_bound_type();
                    let payload_type: mut BoundType = ma.bound_type;
                    // Tag-only variants store the enum type itself as payload
                    // (SemanticModel resolve_enum_types); a payload equal to the
                    // enum type has nothing to bind. (Recursive enum payloads are
                    // a documented limitation of this discriminator.)
                    if (payload_type.is_same_type(enum_type)) {
                        this.model.some.report_error(new ErrorCode.E_UNSUPPORTED(),
                            "enum variant '" + ma.member_name + "' has no payload to bind",
                            tb.location);
                        return new Option<TryBindAnalysis>.none();
                    }
                    let bind_type: mut BoundType = payload_type;
                    if (tb.type_spec.is_some()) {
                        let ann_type: mut BoundType = this.model.some.resolve_type_specifier(tb.type_spec.some, scope);
                        if (!ann_type.is_same_type(payload_type)) {
                            this.model.some.report_error(new ErrorCode.E_TYPE_MISMATCH(),
                                "try-bind type '" + ann_type.display_name() + "' does not match payload type '" + payload_type.display_name() + "'",
                                tb.location);
                            return new Option<TryBindAnalysis>.none();
                        }
                        bind_type = ann_type;
                    }
                    let var_sym: mut BoundVariableSymbol = new BoundVariableSymbol();
                    var_sym.name = tb.variable_name;
                    var_sym.full_name = scope.full_name + "." + tb.variable_name;
                    var_sym.is_mutable = false;
                    var_sym.bound_type = bind_type;
                    var_sym.location = tb.location;
                    // check = `base is EnumType.variant`, RHS is a BoundEnumVariant
                    // reference carrying the variant index (lowered to ISENUM).
                    let ev: mut BoundEnumVariantExpression = new BoundEnumVariantExpression(
                        enum_type, enum_type, ma.member_name, sym.enum_member.enum_value,
                        new Option<BoundEnumMemberSymbol>.some(sym.enum_member),
                        new Option<BoundExpression>.none());
                    let operands: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
                    operands.push(ma.base_expr.some);
                    operands.push(new BoundExpression.enum_variant(ev));
                    let operators: mut _utils.List<BinaryOperator> = new _utils.List<BinaryOperator>();
                    operators.push(new BinaryOperator.Is());
                    let check: mut BoundBinaryExpression = new BoundBinaryExpression(this.model.some.type_registry.bool_type, operators, operands);
                    let analysis: mut TryBindAnalysis = new TryBindAnalysis();
                    analysis.variable_symbol = new Option<BoundVariableSymbol>.some(var_sym);
                    analysis.check = new Option<BoundExpression>.some(new BoundExpression.binary(check));
                    analysis.extract = new Option<BoundExpression>.some(bound_rhs);
                    analysis.bound_type = bind_type;
                    return new Option<TryBindAnalysis>.some(analysis);
                }
            }
        }
        // Type-cast form: `let a : TO := from` — whether `cast<TO>(from)` is valid.
        // Compile-time foldable when the static types decide it; otherwise a
        // runtime ISINSTANCE check.
        if (tb.type_spec.is_some()) {
            let ann_type: mut BoundType = this.model.some.resolve_type_specifier(tb.type_spec.some, scope);
            let rhs_type: BoundType = bound_rhs.get_bound_type();
            // Same type: always a valid (identity) cast.
            if (rhs_type.is_same_type(ann_type)) {
                return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 1);
            }
            // Primitive (incl. string) conversion: compile-time fold.
            if (ann_type.kind is TypeKind.PrimitiveKind && rhs_type.kind is TypeKind.PrimitiveKind) {
                let fold: bool = this.model.some.type_registry.can_widen_primitive(rhs_type.primitive, ann_type.primitive);
                if (fold) { return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 1); }
                return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 0);
            }
            // Interface target: `let a : IFoo := bar`
            if (ann_type.kind is TypeKind.InterfaceKind) {
                if (rhs_type.kind is TypeKind.PrimitiveKind) {
                    this.model.some.report_error(new ErrorCode.E_TYPE_MISMATCH(),
                        "try-bind: cannot cast primitive '" + rhs_type.display_name() + "' to interface '" + ann_type.display_name() + "'",
                        tb.location);
                    return new Option<TryBindAnalysis>.none();
                }
                if (this.is_concrete_type(rhs_type)) {
                    if (this.model.some.type_registry.can_implicitly_cast(rhs_type, ann_type)) {
                        return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 1);
                    }
                    return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 0);
                }
                // interface / generic rhs → runtime ISINSTANCE
                return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, -1);
            }
            // Class target: `let a : Foo := bar` (no class inheritance, exact check)
            if (ann_type.kind is TypeKind.ClassKind) {
                if (rhs_type.kind is TypeKind.ClassKind) {
                    if (this.is_concrete_type(rhs_type)) {
                        return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 0);
                    }
                    return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, -1);
                }
                if (rhs_type.kind is TypeKind.InterfaceKind) {
                    return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, -1);
                }
                this.model.some.report_error(new ErrorCode.E_TYPE_MISMATCH(),
                    "try-bind: cannot cast '" + rhs_type.display_name() + "' to class '" + ann_type.display_name() + "'",
                    tb.location);
                return new Option<TryBindAnalysis>.none();
            }
            this.model.some.report_error(new ErrorCode.E_UNSUPPORTED(),
                "try-bind target '" + ann_type.display_name() + "' is not a supported matchable",
                tb.location);
            return new Option<TryBindAnalysis>.none();
        }
        this.model.some.report_error(new ErrorCode.E_UNSUPPORTED(),
            "try-bind RHS is not a supported matchable (add a ': TO' type annotation for cast checks)",
            tb.location);
        return new Option<TryBindAnalysis>.none();
    }


    // A "concrete" class/enum has an AST source; a generic-parameter placeholder
    // does not. When uncertain, callers fall back to a runtime ISINSTANCE check.
    fun is_concrete_type(this, bt: BoundType) -> bool {
        if (let td := bt.type_definition.some) {
            if (td is BoundDefinition.class_def) {
                return td.class_def.scope.is_some() && !td.class_def.is_generic_template;
            }
            if (td is BoundDefinition.enum_def) { return td.enum_def.scope.is_some(); }
        }
        return false;
    }


    // Build the cast expression for `cast<TO>(from)`, mirroring bind_cast's
    // boxing/unboxing decisions (value type → interface needs boxing).
    fun build_cast_bound(mut this, inner: BoundExpression, target_type: BoundType) -> BoundCastExpression {
        let result: mut BoundCastExpression = new BoundCastExpression(target_type, target_type, new Option<BoundExpression>.some(inner), false);
        let inner_type: BoundType = inner.get_bound_type();
        if (target_type.kind is TypeKind.InterfaceKind) {
            if (inner_type.is_value_type()) {
                result.needs_boxing = true;
                result.source_type_name = this.get_concrete_type_name(inner_type);
            }
        }
        if (inner_type.kind is TypeKind.InterfaceKind) {
            if (target_type.is_value_type()) {
                result.needs_unboxing = true;
                result.source_type_name = this.get_concrete_type_name(target_type);
            }
        }
        return result;
    }


    // Build a TryBindAnalysis for the cast form. fold: 1 = compile-time true,
    // 0 = compile-time false, -1 = runtime `from is TO` (ISINSTANCE).
    fun make_cast_try_bind_analysis(mut this, tb: TryBindExpression, bound_rhs: BoundExpression, ann_type: mut BoundType, scope: mut BoundScope, fold: i64) -> Option<TryBindAnalysis> {
        _utils.trace_enter("Enter make_cast_try_bind_analysis");
        let var_sym: mut BoundVariableSymbol = new BoundVariableSymbol();
        var_sym.name = tb.variable_name;
        var_sym.full_name = scope.full_name + "." + tb.variable_name;
        var_sym.is_mutable = false;
        var_sym.bound_type = ann_type;
        var_sym.location = tb.location;
        let cast_expr: BoundCastExpression = this.build_cast_bound(bound_rhs, ann_type);
        let extract: BoundExpression = new BoundExpression.cast_expr(cast_expr);
        let check: mut Option<BoundExpression> = new Option<BoundExpression>.none();
        if (fold == 1) {
            let true_lit: mut BoundLiteralExpression = new BoundLiteralExpression("true", this.model.some.type_registry.bool_type, new LiteralKind.BoolLiteral());
            check = new Option<BoundExpression>.some(new BoundExpression.literal(true_lit));
        } else if (fold == 0) {
            let false_lit: mut BoundLiteralExpression = new BoundLiteralExpression("false", this.model.some.type_registry.bool_type, new LiteralKind.BoolLiteral());
            check = new Option<BoundExpression>.some(new BoundExpression.literal(false_lit));
        } else {
            // Runtime: `from is TO` via a type-symbol identifier on the Is RHS.
            let type_sym: Option<BoundSymbol> = scope.lookup_symbol(tb.type_spec.some.name);
            if (type_sym.is_some() && type_sym.some is BoundSymbol.type_sym) {
                let id: mut BoundIdentifierExpression = new BoundIdentifierExpression(ann_type, type_sym);
                let operands: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
                operands.push(bound_rhs);
                operands.push(new BoundExpression.identifier(id));
                let operators: mut _utils.List<BinaryOperator> = new _utils.List<BinaryOperator>();
                operators.push(new BinaryOperator.Is());
                let chk: mut BoundBinaryExpression = new BoundBinaryExpression(this.model.some.type_registry.bool_type, operators, operands);
                check = new Option<BoundExpression>.some(new BoundExpression.binary(chk));
            } else {
                this.model.some.report_error(new ErrorCode.E_RESOLVE_TYPE(),
                    "try-bind type check: cannot resolve type symbol for '" + tb.type_spec.some.name + "'",
                    tb.location);
                return new Option<TryBindAnalysis>.none();
            }
        }
        let analysis: mut TryBindAnalysis = new TryBindAnalysis();
        analysis.variable_symbol = new Option<BoundVariableSymbol>.some(var_sym);
        analysis.check = check;
        analysis.extract = new Option<BoundExpression>.some(extract);
        analysis.bound_type = ann_type;
        return new Option<TryBindAnalysis>.some(analysis);
    }


    // P2 general try-bind expression: `let a [: T] := b` as a boolean value.
    // The RHS is bound first (so `a` is not visible to its own RHS), then the
    // pattern variable is registered into the CURRENT region scope (paren /
    // &&-chain / if-condition), making it visible to the enclosing boolean
    // expression's later operands and (for if-conditions) the then-branch.
    fun bind_try_bind(mut this, tb: TryBindExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_try_bind");
        let bound_rhs: Option<BoundExpression> = this.bind_expression(tb.rhs.some, scope);
        if (bound_rhs.is_none()) { return new Option<BoundExpression>.none(); }
        let analysis: Option<TryBindAnalysis> = this.analyze_try_bind(tb, bound_rhs.some, scope);
        if (analysis.is_none()) { return new Option<BoundExpression>.none(); }
        scope.add_symbol(new BoundSymbol.variable(analysis.some.variable_symbol.some));
        let result: mut BoundTryBindExpression = new BoundTryBindExpression(
            this.model.some.type_registry.bool_type, analysis.some.variable_symbol, analysis.some.check, analysis.some.extract);
        return new Option<BoundExpression>.some(new BoundExpression.try_bind(result));
    }


    // Desugar `if (let a [: T] := b) T else E` into
    //   `if (CHK) { let a = EXT; T } else E`
    // so `a` is an ordinary block-scoped let — visible in the then-branch only,

    fun bind_code_block(mut this, expr: CodeBlockExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_code_block");
        let block_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<block>", scope.full_name + ".<block>", new Option<BoundScope>.some(scope));
        let stmts: mut _utils.List<BoundStatement> = new _utils.List<BoundStatement>();
        let i: mut i64 = 0;
        while (i < cast<i64>(expr.statements.size())) {
            let stmt: Statement = expr.statements.at(cast<u64>(i)).some;
            let bound_stmt: Option<BoundStatement> = this.model.some.bind_bodies_pass.bind_statement(stmt, block_scope);
            if (bound_stmt.is_some()) {
                stmts.push(bound_stmt.some);
            }
            i = i + 1;
        }
        // Promote a trailing expression-statement that wraps a value-producing if-expression
        // to the block's trailing value. The parser wraps a trailing `if c {..} else {..}` in
        // a code block as a block_expr statement; when that if yields a non-void value it is
        // the block's value (trailing expression), not a value-less statement. This makes
        // `let x: T = { ...; if c { a } else { b } }` resolve to T instead of void (which
        // previously produced `ASSIGN void` and invalid `#dbg_value(ptr void, ...)`).
        // Void ifs (e.g. both branches `return`) are left as statements, so control-flow ifs
        // such as `fun f() -> T { if c { return a; } else { return b; } }` are unaffected.
        if (expr.trailing_expr.is_none()) {
            if (cast<i64>(stmts.size()) > 0) {
                let last_stmt: BoundStatement = stmts.at(stmts.size() - 1).some;
                if (last_stmt is BoundStatement.expression) {
                    let inner_opt: Option<BoundExpression> = last_stmt.expression.expression;
                    if (inner_opt.is_some()) {
                        if (inner_opt.some is BoundExpression.if_expr) {
                            let ift: BoundType = inner_opt.some.get_bound_type();
                            if (ift.display_name() != "void") {
                                let _discarded: __builtin.Option<BoundStatement> = stmts.pop();
                                let result: mut BoundCodeBlockExpression = new BoundCodeBlockExpression(ift, stmts, inner_opt, new Option<BoundScope>.some(block_scope));
                                return new Option<BoundExpression>.some(new BoundExpression.code_block(result));
                            }
                        }
                    }
                }
            }
        }
        if (expr.trailing_expr.is_some()) {
            let trailing: Option<BoundExpression> = this.bind_expression(expr.trailing_expr.some, block_scope);
            if (trailing.is_some()) {
                let bt: BoundType = trailing.some.get_bound_type();
                let result: mut BoundCodeBlockExpression = new BoundCodeBlockExpression(bt, stmts, trailing, new Option<BoundScope>.some(block_scope));
                return new Option<BoundExpression>.some(new BoundExpression.code_block(result));
            }
        }
        let result: mut BoundCodeBlockExpression = new BoundCodeBlockExpression(this.model.some.type_registry.void_type, stmts, new Option<BoundExpression>.none(), new Option<BoundScope>.some(block_scope));
        return new Option<BoundExpression>.some(new BoundExpression.code_block(result));
    }


    // Look up the concrete implementation method from a value type's vtable.
    // Given the inner (concrete) type, the interface type, and the interface method symbol,
    // find the corresponding implementation method in the class/enum definition's vtable.
    fun resolve_implementation_method(this, inner_type: BoundType, iface_type: BoundType, iface_method_sym: BoundSymbol) -> Option<BoundFunctionSymbol> {
        _utils.trace_enter("Enter resolve_implementation_method");
        if (iface_method_sym is BoundSymbol.function_sym) {
            let method_name: string = iface_method_sym.function_sym.name;
            if (let def := inner_type.type_definition.some) {
                // Class value type
                if (def is BoundDefinition.class_def) {
                    let class_def: BoundClassDefinition = def.class_def;
                    let vi: mut i64 = 0;
                    while (vi < cast<i64>(class_def.vtables.size())) {
                        let vtable: BoundVTable = class_def.vtables.at(cast<u64>(vi)).some;
                        if (vtable.interface_type.display_name() == iface_type.display_name()) {
                            let si: mut i64 = 0;
                            while (si < cast<i64>(vtable.slots.size())) {
                                let slot: BoundVTableSlot = vtable.slots.at(cast<u64>(si)).some;
                                if (slot.interface_method.is_some()) {
                                    if (slot.interface_method.some.name == method_name) {
                                        return slot.implementation_method;
                                    }
                                }
                                si = si + 1;
                            }
                        }
                        vi = vi + 1;
                    }
                }
                // Enum type
                if (def is BoundDefinition.enum_def) {
                    let enum_def: BoundEnumDefinition = def.enum_def;
                    let vi: mut i64 = 0;
                    while (vi < cast<i64>(enum_def.vtables.size())) {
                        let vtable: BoundVTable = enum_def.vtables.at(cast<u64>(vi)).some;
                        if (vtable.interface_type.display_name() == iface_type.display_name()) {
                            let si: mut i64 = 0;
                            while (si < cast<i64>(vtable.slots.size())) {
                                let slot: BoundVTableSlot = vtable.slots.at(cast<u64>(si)).some;
                                if (slot.interface_method.is_some()) {
                                    if (slot.interface_method.some.name == method_name) {
                                        return slot.implementation_method;
                                    }
                                }
                                si = si + 1;
                            }
                        }
                        vi = vi + 1;
                    }
                }
            }
        }
        return new Option<BoundFunctionSymbol>.none();
    }


    // A cast inner's binding: RAW (port sugar suppressed) when the cast
    // targets a class/interface type and the inner is a member access onto a
    // port field (a channel-object operation).
    fun bind_cast_inner(mut this, expr: CastExpression, target_type: BoundType, scope: mut BoundScope) -> Option<BoundExpression> {
        if (target_type.kind is TypeKind.InterfaceKind || target_type.kind is TypeKind.ClassKind) {
            if (expr.inner.is_some() && expr.inner.some is Expression.member_access) {
                if (this.resolve_port_access(expr.inner.some.member_access, scope).is_some()) {
                    return this.bind_expr_no_port_sugar(expr.inner.some, scope);
                }
            }
        }
        return this.bind_optional_expr(expr.inner, scope);
    }

    fun bind_cast(mut this, expr: CastExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_cast");
        // mut-this core methods (bind_meta_call / resolve_type_name) need a
        // mutable SemanticModel: rebind the Option payload once here.
        let m: mut SemanticModel = this.model.some;
        // Prefer the full TypeSpecifier (qualified_parts aware) when present;
        // the bare-name fallback only handles unqualified types.
        let target_type: mut BoundType = this.model.some.type_registry.make_error_type();
        if (expr.target_type.is_some()) {
            target_type = this.model.some.resolve_type_specifier(expr.target_type.some, scope);
        } else {
            target_type = m.resolve_type_name(expr.type_name, scope, expr.location);
        }
        // E5 channel-object cast rule: a cast to a class/interface type whose
        // inner is a member access onto a declared port field operates on the
        // port's CHANNEL OBJECT (`cast<mut ISink<T>>(this.y)`,
        // `cast<mut _Fanout<T>>(f.y)`) — bind the inner RAW, without the
        // bare-read payload conversion.
        let inner: Option<BoundExpression> = this.bind_cast_inner(expr, target_type, scope);
        let result: mut BoundCastExpression = new BoundCastExpression(target_type, target_type, inner, false);

        if (inner.is_some() && !expr.is_unsafe) {
            let inner_type: BoundType = inner.some.get_bound_type();
            // Boxing: value type (class or enum) → interface. SKIPPED for
            // unsafe_cast — a raw reinterpret (e.g. i64 object_ref → interface
            // via inttoptr, penguin_meta_get_object) must not box.
            if (target_type.kind is TypeKind.InterfaceKind) {
                if (inner_type.is_value_type()) {
                    result.needs_boxing = true;
                    result.source_type_name = this.get_concrete_type_name(inner_type);
                }
            }
            // Unboxing: interface → value type (class or enum)
            if (inner_type.kind is TypeKind.InterfaceKind) {
                if (target_type.is_value_type()) {
                    result.needs_unboxing = true;
                    result.source_type_name = this.get_concrete_type_name(target_type);
                }
            }
        }

        return new Option<BoundExpression>.some(new BoundExpression.cast_expr(result));
    }


    fun get_concrete_type_name(this, bt: BoundType) -> string {
        _utils.trace_enter("Enter get_concrete_type_name");
        if (bt.type_definition.is_some()) {
            return bt.type_definition.some.get_name();
        }
        return bt.display_name();
    }


    fun resolve_new_generic_args(this, expr: NewExpression, scope: BoundScope, bt: BoundType) -> mut BoundType {
        _utils.trace_enter("Enter resolve_new_generic_args");
        if (cast<i64>(expr.generic_args.size()) > 0) {
            // M4: route VALUE-arg new-instantiations (`new A<5>()`) through the
            // `_template_X` meta path — this is where value template args usually
            // appear, so wiring the pass-8 new-binding is what makes M4 actually
            // fire for the common value case. Returns the specialized type; the
            // caller (bind_new_expr) applies Mutable. Falls through to template+args
            // when M4 declines (type-only, no _template_X, or no JIT).
            let m4: Option<BoundType> = this.model.some.bind_meta_calls_pass.try_resolve_template_instantiation(expr.type_name, expr.generic_args, scope);
            if (m4.is_some()) {
                return this.model.some.resolve_types_pass.apply_mutability(m4.some, false);
            }
            let args: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
            let k: mut i64 = 0;
            while (k < cast<i64>(expr.generic_args.size())) {
                args.push(this.model.some.resolve_types_pass.resolve_single_generic_arg(expr.generic_args.at(cast<u64>(k)).some, scope));
                k = k + 1;
            }
            return bt.with_generic_args(args);
        }
        return bt;
    }


    // For a generic interface base type (e.g. IFoo<u8>), return the scope of the
    // specialized def (IFoo__u8) so member lookup resolves concrete method types
    // (T -> u8) and symbols (ns.IFoo__u8.bar). Falls back to the template scope.
    fun specialized_interface_scope(this, iface: BoundInterfaceDefinition, base_type: BoundType, scope: BoundScope) -> Option<BoundScope> {
        _utils.trace_enter("Enter specialized_interface_scope");
        if (cast<i64>(base_type.generic_args.size()) > 0) {
            let mangled: string = MonomorphizePass.mangle_generic_name(iface.full_name, base_type.generic_args);
            let spec_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(mangled);
            if (spec_sym.is_some()) {
                if (spec_sym.some is BoundSymbol.type_sym) {
                    if (let spec_td := spec_sym.some.type_sym.bound_type.type_definition.some) {
                        if (spec_td is BoundDefinition.interface_def) {
                            return spec_td.interface_def.scope;
                        }
                    }
                }
            }
        }
        return iface.scope;
    }


    fun resolve_type_by_name(this, name: string, scope: mut BoundScope) -> Option<BoundSymbol> {
        _utils.trace_enter("Enter resolve_type_by_name");
        let dot_idx: i64 = string_find(name, ".");
        if (dot_idx < 0) {
            return scope.lookup_type_in_scope(name);
        }
        // Split dotted name into parts and use resolve_qualified which traverses parent scopes
        let parts: mut _utils.List<string> = new _utils.List<string>();
        let pos: mut i64 = 0;
        let len: i64 = string_length(name);
        while (pos < len) {
            let next_dot: i64 = string_find_from(name, ".", pos);
            if (next_dot < 0) {
                parts.push(string_substring(name, pos, len - pos));
                pos = len;
            } else {
                parts.push(string_substring(name, pos, next_dot - pos));
                pos = next_dot + 1;
            }
        }
        return scope.resolve_qualified(parts);
    }


    fun find_last_dot(this, s: string) -> i64 {
        _utils.trace_enter("Enter find_last_dot");
        let len: i64 = string_length(s);
        let last_dot: mut i64 = -1;
        let si: mut i64 = 0;
        while (si < len) {
            let ch: string = string_char_at(s, si);
            if (ch == ".") {
                last_dot = si;
            }
            si = si + 1;
        }
        return last_dot;
    }


    // Check if an impl for is orphaned (both interface and type are external).
    fun check_orphan_impl(this, iface_type: BoundType, for_type: BoundType, impl_scope: BoundScope) -> bool {
        _utils.trace_enter("Enter check_orphan_impl");
        let ns_prefix: string = impl_scope.full_name + ".";
        let iface_ns: mut string = "";
        if (let def := iface_type.type_definition.some) {
            if (def is BoundDefinition.interface_def) {
                iface_ns = def.interface_def.full_name;
            }
        }
        let for_ns: mut string = "";
        if (let def := for_type.type_definition.some) {
            if (def is BoundDefinition.class_def) { for_ns = def.class_def.full_name; }
            if (def is BoundDefinition.enum_def) { for_ns = def.enum_def.full_name; }
        }
        let iface_local: bool = string_length(iface_ns) > 0 && string_find(iface_ns, ns_prefix) == 0;
        let for_local: bool = string_length(for_ns) > 0 && string_find(for_ns, ns_prefix) == 0;
        return !iface_local && !for_local;
    }


    fun try_bind_enum_variant(mut this, expr: NewExpression, scope: mut BoundScope, last_dot: i64) -> Option<BoundExpression> {
        _utils.trace_enter("Enter try_bind_enum_variant");
        let len: i64 = string_length(expr.type_name);
        let enum_name: string = string_substring(expr.type_name, 0, last_dot);
        let variant_name: string = string_substring(expr.type_name, last_dot + 1, len - last_dot - 1);
        let enum_sym: Option<BoundSymbol> = this.resolve_type_by_name(enum_name, scope);
        if (enum_sym.is_some()) {
            if (enum_sym.some is BoundSymbol.type_sym) {
                let bt: mut BoundType = this.resolve_new_generic_args(expr, scope, enum_sym.some.type_sym.bound_type);
                if (bt.kind is TypeKind.EnumKind && bt.type_definition.is_some()) {
                    let def: BoundDefinition = bt.type_definition.some;
                    if (def is BoundDefinition.enum_def) {
                        let enum_def: BoundEnumDefinition = def.enum_def;
                        let i: mut i64 = 0;
                        while (i < cast<i64>(enum_def.members.size())) {
                            let member: BoundEnumMemberDefinition = enum_def.members.at(cast<u64>(i)).some;
                            if (member.name == variant_name) {
                                let payload: Option<BoundExpression> = new Option<BoundExpression>.none();
                                if (cast<i64>(expr.arguments.size()) > 0) {
                                    let arg: Option<BoundExpression> = this.bind_expression(expr.arguments.at(cast<u64>(0)).some, scope);
                                    if (arg.is_some()) {
                                        let result: mut BoundEnumVariantExpression = new BoundEnumVariantExpression(bt, bt, variant_name, i, member.member_symbol, arg);
                                        return new Option<BoundExpression>.some(new BoundExpression.enum_variant(result));
                                    }
                                }
                                let result: mut BoundEnumVariantExpression = new BoundEnumVariantExpression(bt, bt, variant_name, i, member.member_symbol, payload);
                                return new Option<BoundExpression>.some(new BoundExpression.enum_variant(result));
                            }
                            i = i + 1;
                        }
                    }
                }
            }
        }
        return new Option<BoundExpression>.none();
    }


    // The lookup scope for resolving a newly created specialization pair: the
    // def's own scope when it has one (class/enum/interface/function), else
    // the global scope.
    fun spec_resolve_scope(this, def: BoundDefinition) -> BoundScope {
        if (def is BoundDefinition.function_def && def.function_def.scope.is_some()) {
            return def.function_def.scope.some;
        }
        if (def is BoundDefinition.class_def && def.class_def.scope.is_some()) {
            return def.class_def.scope.some;
        }
        if (def is BoundDefinition.enum_def && def.enum_def.scope.is_some()) {
            return def.enum_def.scope.some;
        }
        if (def is BoundDefinition.interface_def && def.interface_def.scope.is_some()) {
            return def.interface_def.scope.some;
        }
        return this.model.some.global_scope;
    }

    fun bind_new_expr(mut this, expr: NewExpression, scope: mut BoundScope) -> Option<BoundExpression> {        _utils.trace_enter("Enter bind_new_expr");
        // First, try to resolve the full type_name as a class/struct type
        let type_sym: Option<BoundSymbol> = this.resolve_type_by_name(expr.type_name, scope);
        if (type_sym.is_some()) {
            if (type_sym.some is BoundSymbol.type_sym) {
                let bt: mut BoundType = this.resolve_new_generic_args(expr, scope, type_sym.some.type_sym.bound_type);
                // On-demand specialization: a generic `new Foo<args>()` whose
                // specialization def doesn't exist yet — e.g. a generic field
                // DEFAULT initializer inside a specialized class whose field TYPE
                // is an interface (resolve_field_specialization ensures the
                // interface spec, but nothing else references Foo<args>, so no
                // def/layout/ctor is ever emitted and the NEW lowers to garbage).
                // Mirrors ensure_specialized_type's late-creation branch but with
                // catch_up_def_BEFORE_BODIES: binding bodies re-entrantly inside
                // an expression bind corrupts resolution (see bind_spawn_async) —
                // the pushed def's bodies are bound later by the dynamic pass-8
                // loop. bt keeps the template+args shape so downstream lowering
                // is unchanged.
                if (cast<i64>(bt.generic_args.size()) > 0 && this.model.some.current_unit.is_some()) {
                    let full_base: mut string = expr.type_name;
                    let tmpl_short: mut string = expr.type_name;
                    if (bt.type_definition.is_some()) {
                        let td0: BoundDefinition = bt.type_definition.some;
                        if (td0 is BoundDefinition.class_def) { full_base = td0.class_def.full_name; tmpl_short = td0.class_def.name; }
                        if (td0 is BoundDefinition.enum_def) { full_base = td0.enum_def.full_name; tmpl_short = td0.enum_def.name; }
                        if (td0 is BoundDefinition.interface_def) { full_base = td0.interface_def.full_name; tmpl_short = td0.interface_def.name; }
                    }
                    let mangled_spec: string = MonomorphizePass.mangle_generic_name(full_base, bt.generic_args);
                    let spec_existing: Option<BoundSymbol> = this.model.some.global_scope.lookup_type_in_scope(mangled_spec);
                    if (spec_existing.is_none()) {
                        let inst_bt: BoundType = type_sym.some.type_sym.bound_type.with_generic_args(bt.generic_args);
                        let spec_new: Option<BoundDefinition> = this.model.some.monomorphize_pass.ensure_specialized_def(inst_bt, this.model.some.global_scope);
                        if (spec_new.is_some()) {
                            // Resolve the pair FIRST (fields/methods/impl-method
                            // signatures — without it the spec's methods have
                            // no parameters and `this` never resolves), then
                            // the signature-level catch-up, then register for
                            // the dynamic pass-8 body-binding loop. The
                            // resolve runs at pass index 3 (the monomorphize
                            // protocol): stamping the def at 8 here would make
                            // every catch-up sub-pass skip it (already
                            // processed) — no vtables, no value/ref
                            // classification (defaults to stack allocation).
                            let ast_spec: Option<Definition> = this.model.some.monomorphize_pass.find_ast_def_by_name(this.model.some.ast_definitions, tmpl_short);
                            let m0: mut SemanticModel = this.model.some;
                            let saved_idx0: i64 = m0.current_pass_index;
                            if (ast_spec.is_some()) {
                                m0.current_pass_index = 3;
                                let to_register: BoundDefinition = this.model.some.resolve_types_pass.resolve_pair(ast_spec.some, spec_new.some, this.spec_resolve_scope(spec_new.some));
                                m0.current_pass_index = saved_idx0;
                                m0.catch_up_def_before_bodies(to_register, this.model.some.current_unit.some);
                                this.model.some.current_unit.some.definitions.push(to_register);
                            } else {
                                m0.catch_up_def_before_bodies(spec_new.some, this.model.some.current_unit.some);
                                this.model.some.current_unit.some.definitions.push(spec_new.some);
                            }
                        }
                    }
                }
                // If this is an enum type, the full name was a type, not a variant — just instantiate
                let args: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
                let i: mut i64 = 0;
                while (i < cast<i64>(expr.arguments.size())) {
                    let bound_arg: Option<BoundExpression> = this.bind_expression(expr.arguments.at(cast<u64>(i)).some, scope);
                    if (bound_arg.is_some()) {
                        args.push(bound_arg.some);
                    }
                    i = i + 1;
                }
                let result: mut BoundNewExpression = new BoundNewExpression(bt.with_mutability(new Mutability.Mutable()), new Option<BoundTypeSymbol>.some(type_sym.some.type_sym), new Option<BoundFunctionSymbol>.none(), args);
                return new Option<BoundExpression>.some(new BoundExpression.new_expr(result));
            }
        }

        // If not found as a type, try as an enum variant (e.g., "Option.some" → enum Option, variant some)
        let last_dot: i64 = this.find_last_dot(expr.type_name);
        if (last_dot >= 0) {
            let enum_result: Option<BoundExpression> = this.try_bind_enum_variant(expr, scope, last_dot);
            if (enum_result.is_some()) {
                return enum_result;
            }
        }

        // Fallback: create with unresolved type
        let args: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
        let i: mut i64 = 0;
        while (i < cast<i64>(expr.arguments.size())) {
            let bound_arg: Option<BoundExpression> = this.bind_expression(expr.arguments.at(cast<u64>(i)).some, scope);
            if (bound_arg.is_some()) {
                args.push(bound_arg.some);
            }
            i = i + 1;
        }
        let result: mut BoundNewExpression = new BoundNewExpression(new BoundType(), new Option<BoundTypeSymbol>.none(), new Option<BoundFunctionSymbol>.none(), args);
        return new Option<BoundExpression>.some(new BoundExpression.new_expr(result));
    }


}

}
