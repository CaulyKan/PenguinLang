namespace emperor {

class SemanticModel {
    type_registry: mut BoundTypeRegistry;
    errors: mut _utils.List<SemanticError> = new _utils.List<SemanticError>();
    global_scope: mut BoundScope;
    current_unit: mut Option<BoundCompilationUnit> = new Option<BoundCompilationUnit>.none();
    // Pass 9 collaborator (M1). Left uninitialized here (wired in the ctor):
    // a `new ValidateControlFlowPass(new SemanticModel())` dummy default would
    // create an infinite SemanticModel <-> ValidateControlFlowPass cycle in
    // BabyPenguin's eager runtime-object construction (the pass's `model`
    // back-reference is Option-wrapped to break it).
    validate_control_flow_pass: mut ValidateControlFlowPass;
    // Pass 4/5/7 collaborators (M2), same pattern as validate_control_flow_pass:
    // uninitialized fields wired in the ctor; the passes' `model` back-references
    // are Option-wrapped to break the class cycle.
    bind_symbols_pass: mut BindSymbolsPass;
    constructors_pass: mut ConstructorsPass;
    classify_value_types_pass: mut ClassifyValueTypesPass;
    // Pass 1 collaborator (M3), same pattern as the above.
    build_scopes_pass: mut BuildScopesPass;
    // Pass 2 collaborator (M4), same pattern as the above.
    resolve_types_pass: mut ResolveTypesPass;
    // Pass 6 collaborator (M5), same pattern as the above.
    interfaces_pass: mut InterfacesPass;
    // Meta pre-processing stage (M6) — runs before the 9 passes in bind().
    meta_rewriter: mut MetaRewriter;
    // Pass 3 collaborator (M7), same pattern as the above.
    monomorphize_pass: mut MonomorphizePass;
    // Pass 8 body/statement binder (M8a), same pattern as the above.
    bind_bodies_pass: mut BindBodiesPass;
    // Pass 8 expression binder (M8b), same pattern as the above.
    bind_expressions_pass: mut BindExpressionsPass;
    // Pass 8 meta-call binder (M8c), same pattern as the above.
    bind_meta_calls_pass: mut BindMetaCallsPass;
    // M1a: how far the currently-processing def has been advanced; updated in
    // bind() right before each pass runs (no guard/catch-up yet — tracking only).
    current_pass_index: mut i64 = 0;
    ast_definitions: mut _utils.List<Definition> = new _utils.List<Definition>();
    // Host-side compile-time option store for #define / #defined / #option used
    // outside #fun bodies (e.g. #if (#defined("DEBUG")) conditional compilation).
    // #fun bodies keep their own store in MetaEngine (unit B). Parallel-list map,
    // matching MetaEngine's option_keys/option_values shape.
    meta_option_keys: mut _utils.List<string> = new _utils.List<string>();
    meta_option_values: mut _utils.List<string> = new _utils.List<string>();
    // Phase 5b: registry of #fun meta functions (collected in pass_build_scopes)
    // and a lazily-used JIT engine for executing #fun calls at compile time and
    // splicing the result. The JIT path only runs in a native pass2+ binary
    // built with --enable-meta; in BabyPenguin-VM/dotnet-test builds it is never
    // reached (no user-code #fun calls), so libpenguin_jit need not be linked.
    meta_function_defs: mut _utils.List<BoundMetaFunctionDefinition> = new _utils.List<BoundMetaFunctionDefinition>();
    // M1 (#template -> #fun desugar): synthesized `_template_<name>` meta functions
    // for each #template class/enum/interface. Kept SEPARATE from meta_function_defs
    // (the #funs-that-call-each-other JIT set) because _template_X are HOST-invoked
    // (the M4 use-site routing calls them), never called from other #funs. If they
    // were in all_meta_function_defs, every #fun / #specializing unit-B build would
    // pull in their bodies (which call penguin_meta_specialize) and fail to JIT-link
    // until the M3 host responder exists. M3 merges these into the JIT set once the
    // responder is wired.
    template_meta_function_defs: mut _utils.List<BoundMetaFunctionDefinition> = new _utils.List<BoundMetaFunctionDefinition>();
    // Per-static-type STATIC unique-name trampolines (find_unique_name_trampoline):
    // one synthesized #fun (and one JIT symbol) per object-arg static type.
    unique_name_trampoline_defs: mut _utils.List<BoundMetaFunctionDefinition> = new _utils.List<BoundMetaFunctionDefinition>();
    // Phase 6 v2: `#class` definitions collected from unit A, fed into unit B so
    // #funs can use them as meta-only data structures (not emitted to runtime).
    meta_class_defs: mut _utils.List<ClassDefinition> = new _utils.List<ClassDefinition>();
    // #specializing: compiled blocks, keyed by target template simple name.
    // `bind_specializing_def` (pass 1) registers one entry per block; the
    // monomorphize loop runs matching callbacks per instantiation and injects the
    // activated impl fragments into the specialized class/enum.
    specializing_blocks: mut _utils.List<SpecializingBlockInfo> = new _utils.List<SpecializingBlockInfo>();
    // Primitive interface-method dispatch registry: `impl IHash for i64 { ... }`
    // methods are mangled to `<name>$$<primitive>` (e.g. hash$$i64) at bind time
    // and recorded here in four parallel lists (target primitive display name,
    // interface display name, original method name, mangled BoundFunctionSymbol).
    // bind_member_access resolves `k.hash()` on a primitive base to the mangled
    // symbol, which lowers to a direct call (no vtable). The symbol instances are
    // the scope-registered ones, so pass 2/4 populate return_type/parameters.
    primitive_impl_for_type: mut _utils.List<string> = new _utils.List<string>();
    primitive_impl_iface: mut _utils.List<string> = new _utils.List<string>();
    primitive_impl_method_name: mut _utils.List<string> = new _utils.List<string>();
    primitive_impl_method_sym: mut _utils.List<BoundFunctionSymbol> = new _utils.List<BoundFunctionSymbol>();
    meta_engine: mut MetaEngine = new MetaEngine();
    meta_engine_seeded: mut bool = false;
    verbose: mut i64 = 0;
    // Error-report suppression for speculative resolution: the pass-3 AST
    // collector resolves method-body type args in the CLASS scope, where the
    // method's own template params are invisible — those resolve failures are
    // EXPECTED (the instantiation is skipped, and pass 8 re-binds the body
    // with proper scopes, reporting any REAL errors there). Save/restore
    // around the speculative window only.
    suppress_report_errors: mut bool = false;
    // --enable-coroutine gate (default off): when false, the RTL-port /
    // concurrency syntax set (ports, construct, connect, wait forms,
    // try/catch, async expressions) reports a clear compile error instead of
    // binding. Plumbed from CompilerConfig via EmperorPenguinCompiler.
    enable_coroutine: bool = false;
    // Set during binding whenever a wait form or async spawn binds anywhere in
    // the unit (including instantiated stdlib channel code — their backpressure
    // loops contain `wait;`). Drives emit_main: only modules that actually
    // suspend run initials on the coroutine scheduler; wait-free programs emit
    // the plain sequential main either way, keeping bootstrap md5 convergence
    // flag-independent.
    has_suspension: mut bool = false;
    // Dyn-lib routing (see Dynlib.penguin). lib_def_start/count = the index
    // RANGE of top-level definitions contributed by merged lib sources (marked
    // by index, GC-safe, no filename string comparison). lib_instances = the
    // union of shipped mangled generic-instance names across loaded libs;
    // specialized defs whose full_name matches are declared too
    // (declare-not-define routing).
    lib_def_start: i64 = 0;
    lib_def_count: i64 = 0;
    lib_instances: mut _utils.List<string> = new _utils.List<string>();
    // Libmeta direct injection (--libmeta=direct): per-lib metadata JSON
    // documents + the def-index slots where each lib's prebuilt bound defs
    // are spliced after pass 1 (libmeta_direct_inject in Dynlib.penguin; the
    // DynlibStub build's version is a no-op).
    lib_meta_docs: mut _utils.List<string> = new _utils.List<string>();
    lib_meta_slots: mut _utils.List<i64> = new _utils.List<i64>();
    // Filled by libmeta_direct_inject after splicing: the [start, start+count)
    // ranges of injected defs in result.definitions (ascending). The ast-zip
    // passes (2/6/8) skip these positions and subtract the earlier injected
    // counts from their ast index so the prefix alignment is preserved.
    injected_starts: mut _utils.List<i64> = new _utils.List<i64>();
    injected_counts: mut _utils.List<i64> = new _utils.List<i64>();

    fun libmeta_total_injected(this) -> i64 {
        let out: mut i64 = 0;
        let k: mut i64 = 0;
        while (k < cast<i64>(this.injected_counts.size())) {
            out = out + this.injected_counts.at(cast<u64>(k)).some;
            k = k + 1;
        }
        return out;
    }

    fun libmeta_is_injected(this, i: i64) -> bool {
        let k: mut i64 = 0;
        while (k < cast<i64>(this.injected_starts.size())) {
            let st: i64 = this.injected_starts.at(cast<u64>(k)).some;
            if (i >= st && i < st + this.injected_counts.at(cast<u64>(k)).some) { return true; }
            k = k + 1;
        }
        return false;
    }

    // The unit.definitions index that pairs with result.definitions[i]
    // (valid only when libmeta_is_injected(i) is false).
    fun libmeta_ast_index(this, i: i64) -> i64 {
        let out: mut i64 = i;
        let k: mut i64 = 0;
        while (k < cast<i64>(this.injected_starts.size())) {
            let st: i64 = this.injected_starts.at(cast<u64>(k)).some;
            if (i >= st + this.injected_counts.at(cast<u64>(k)).some) {
                out = out - this.injected_counts.at(cast<u64>(k)).some;
            }
            k = k + 1;
        }
        return out;
    }
    // ===== E5 port wiring registries (parallel lists — GC-safe) =====
    // PortMeta: a class's declared ports. Key "<class full name>.<port name>"
    // (specialized classes register under their mangled full name when
    // bind_class_def replays for the specialization).
    port_keys: mut _utils.List<string> = new _utils.List<string>();
    port_is_input: mut _utils.List<bool> = new _utils.List<bool>();
    port_has_default: mut _utils.List<bool> = new _utils.List<bool>();
    // Variable nets: a `mut` variable used as a connect source gets a hidden
    // _Fanout hub; parallel lists map var full name -> hub full name.
    net_var_keys: mut _utils.List<string> = new _utils.List<string>();
    net_hub_names: mut _utils.List<string> = new _utils.List<string>();
    net_hub_created: mut _utils.List<bool> = new _utils.List<bool>();
    variable_net_counter: mut i64 = 0;
    // Passthrough wires: input ports whose field was rebound to a _LateSource
    // by connect(this.x, ...) inside the class's own construct.
    passthrough_keys: mut _utils.List<string> = new _utils.List<string>();
    // Output driver registry (topology check: wire XOR body, one body driver).
    driver_keys: mut _utils.List<string> = new _utils.List<string>();
    driver_wire_locs: mut _utils.List<string> = new _utils.List<string>();
    driver_body_fns: mut _utils.List<string> = new _utils.List<string>();
    driver_body_locs: mut _utils.List<string> = new _utils.List<string>();
    // Connected input sinks per construct pool (pool = the construct
    // function's full name): sink keys with locations (double-connect check).
    sink_pool_ids: mut _utils.List<string> = new _utils.List<string>();
    sink_keys: mut _utils.List<string> = new _utils.List<string>();
    sink_locs: mut _utils.List<string> = new _utils.List<string>();
    // Modules instantiated inside a construct pool (unconnected-input check):
    // (pool, class full name, var name, location).
    newed_pool_ids: mut _utils.List<string> = new _utils.List<string>();
    newed_class_names: mut _utils.List<string> = new _utils.List<string>();
    newed_var_names: mut _utils.List<string> = new _utils.List<string>();
    newed_locs: mut _utils.List<string> = new _utils.List<string>();
    // Hidden top-level construct counter (__construct_<n> naming).
    construct_counter: mut i64 = 0;
    // >0 while binding an expression/statement where port sugar (bare port
    // reads, output-assignment writes) must NOT apply — the receiver of a
    // port-channel method call, the inner of a channel-object cast, and the
    // field writes generated by the connect desugaring all need the RAW
    // channel object, not the payload slot.
    port_sugar_suppressed: mut i64 = 0;
    // Unique-name counters for connect-desugared locals (__conn_wire_<n>,
    // __conn_relay_<n>).
    connect_wire_counter: mut i64 = 0;
    connect_relay_counter: mut i64 = 0;
    // Variable-net registration captured at desugar time (var NAME -> hub
    // NAME; resolution goes through the scope at use time, verifying the
    // var symbol's full name against the hub's so shadowing locals can't
    // steal a net). Hubs created: per-hub-per-construct materialization
    // bookkeeping lives in net_hub_keys.
    pending_net_var: mut _utils.List<string> = new _utils.List<string>();
    pending_net_hub: mut _utils.List<string> = new _utils.List<string>();
    pending_net_is_field: mut _utils.List<bool> = new _utils.List<bool>();
    net_hub_keys: mut _utils.List<string> = new _utils.List<string>();
    // Global variables hoisted from top-level constructs ("<file>|<name>"):
    // their initializers bind through the global-var path, so the
    // newed-module topology registration lives there keyed on this list.
    construct_global_keys: mut _utils.List<string> = new _utils.List<string>();
    // AST-level port info captured by desugar_class_rtl (class NAME — full
    // name is only known when bind_class_def runs) drained into port_keys.
    pending_port_class: mut _utils.List<string> = new _utils.List<string>();
    pending_port_name: mut _utils.List<string> = new _utils.List<string>();
    pending_port_is_input: mut _utils.List<bool> = new _utils.List<bool>();
    pending_port_has_default: mut _utils.List<bool> = new _utils.List<bool>();
    // When true (unit B meta compilation), top-level defs bind directly into
    // the global scope instead of their per-file anonymous namespace. Unit B
    // is the compiler's own meta machinery: its base sources (bound/AST type
    // layers) call each other's top-level helpers by bare name (e.g.
    // arg_as_bound_type from json.penguin #funs), which file namespaces
    // would hide.
    top_level_in_global: bool = false;
    // Spawn-site counter: every `async f(args)` desugar synthesizes a ctx
    // class (__SpawnCtx_<n>) + site block; the counter gives each site a
    // unique class name within the compilation.
    spawn_site_counter: mut i64 = 0;
    // Lambda-site counter: every lambda expression desugars to a synthesized
    // closure class (__lambda_<n>); unique names across the compilation.
    lambda_site_counter: mut i64 = 0;
    // Generator-site counter: every `-> IGenerator<T>` function rewrites to a
    // synthesized coroutine ctx class (__GenCtx_<n>); unique names across the
    // compilation.
    generator_site_counter: mut i64 = 0;

    fun new(mut this) {

        this.type_registry = new BoundTypeRegistry();
        this.global_scope = new BoundScope(new ScopeKind.GlobalScope(), "<global>", "<global>", new Option<BoundScope>.none());
        this.register_builtin_interfaces();
        this.register_builtin_functions();
        this.validate_control_flow_pass = new ValidateControlFlowPass(this);
        this.bind_symbols_pass = new BindSymbolsPass(this);
        this.constructors_pass = new ConstructorsPass(this);
        this.classify_value_types_pass = new ClassifyValueTypesPass(this);
        this.build_scopes_pass = new BuildScopesPass(this);
        this.resolve_types_pass = new ResolveTypesPass(this);
        this.interfaces_pass = new InterfacesPass(this);
        this.meta_rewriter = new MetaRewriter(this);
        this.monomorphize_pass = new MonomorphizePass(this);
        this.bind_bodies_pass = new BindBodiesPass(this);
        this.bind_expressions_pass = new BindExpressionsPass(this);
        this.bind_meta_calls_pass = new BindMetaCallsPass(this);
    }

    // External host API (MetaHost.active_model.ensure_specialized_type, the M4
    // meta `_template_X` responder): delegate to the pass. The pass holds the
    // real implementation (moved out in M7); this forwarding method keeps the
    // MetaHost contract unchanged.
    fun ensure_specialized_type(mut this, template_name: string, type_args: _utils.List<BoundTypeArg>) -> BoundType {
        return this.monomorphize_pass.ensure_specialized_type(template_name, type_args);
    }

    fun register_builtin_interfaces(mut this) {
        _utils.trace_enter("Enter register_builtin_interfaces");
        this.register_builtin_interface("IValueType");
        this.register_builtin_interface("IReferenceType");
    }

    fun make_primitive_type(this, name: string) -> mut BoundType {
        _utils.trace_enter("Enter make_primitive_type");
        let t: mut BoundType = new BoundType();
        t.kind = new TypeKind.PrimitiveKind();
        if (name == "string") {
            t.primitive = new PrimitiveType.StringType();
        }
        if (name == "void") {
            t.primitive = new PrimitiveType.VoidType();
        }
        if (name == "i32") {
            t.primitive = new PrimitiveType.I32();
        }
        if (name == "i64") {
            t.primitive = new PrimitiveType.I64();
        }
        if (name == "bool") {
            t.primitive = new PrimitiveType.BoolType();
        }
        return t;
    }

    fun register_builtin_extern_fun(mut this, name: string, param_type_names: _utils.List<string>, ret_type_name: string) {
        _utils.trace_enter("Enter register_builtin_extern_fun");
        let full_name: string = "<global>." + name;
        let sym: mut BoundFunctionSymbol = new BoundFunctionSymbol(name, full_name);
        sym.return_type = this.make_primitive_type(ret_type_name);
        sym.is_extern = true;
        let pi: mut i64 = 0;
        while (pi < cast<i64>(param_type_names.size())) {
            let p_type_name: string = param_type_names.at(cast<u64>(pi)).some;
            let p: mut BoundFunctionParameter = new BoundFunctionParameter("p" + cast<string>(pi), pi, false, false);
            p.bound_type = this.make_primitive_type(p_type_name);
            sym.parameters.push(p);
            pi = pi + 1;
        }
        this.global_scope.add_symbol(new BoundSymbol.function_sym(sym));
    }

    fun register_builtin_functions(mut this) {
        _utils.trace_enter("Enter register_builtin_functions");
        let string_params: mut _utils.List<string> = new _utils.List<string>();
        string_params.push("string");
        this.register_builtin_extern_fun("print", string_params, "void");
        this.register_builtin_extern_fun("println", string_params, "void");
        let no_params: mut _utils.List<string> = new _utils.List<string>();
        this.register_builtin_extern_fun("gc_collect", no_params, "void");
        this.register_builtin_extern_fun("gc_info", no_params, "i64");
    }

    fun register_builtin_interface(mut this, name: string) {
        _utils.trace_enter("Enter register_builtin_interface");
        let full_name: string = "<global>." + name;
        let iface_scope: mut BoundScope = new BoundScope(new ScopeKind.InterfaceScope(), name, full_name, new Option<BoundScope>.some(this.global_scope));
        let type_sym: mut BoundTypeSymbol = new BoundTypeSymbol(name, full_name);
        let t: mut BoundType = new BoundType();
        t.kind = new TypeKind.InterfaceKind();
        let iface_def: mut BoundInterfaceDefinition = new BoundInterfaceDefinition(name, full_name);
        iface_def.scope = new Option<BoundScope>.some(iface_scope);
        t.type_definition = new Option<BoundDefinition>.some(new BoundDefinition.interface_def(iface_def));
        type_sym.bound_type = t;
        iface_def.type_symbol = new Option<BoundTypeSymbol>.some(type_sym);
        iface_def.bound_type = t;
        this.global_scope.add_symbol(new BoundSymbol.type_sym(type_sym));
    }

    fun bind(mut this, unit: CompilationUnit, location: SourceLocation) -> BoundCompilationUnit {
        _utils.trace_enter("Enter bind");
        let result: mut BoundCompilationUnit = new BoundCompilationUnit(location);
        result.type_registry = this.type_registry;
        result.global_scope = this.global_scope;
        this.ast_definitions = unit.definitions;
        this.meta_rewriter.run_prepass(unit);
        this.current_pass_index = 1;
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 1/9: Building scopes..."); }
        this.build_scopes_pass.run(unit, result);
        // Libmeta direct injection: splice prebuilt bound defs (skeleton +
        // signature backfill + prebuilt vtables) where each lib's decl text
        // would have parsed, before any type resolution sees the tree.
        if (cast<i64>(this.lib_meta_docs.size()) > 0) {
            libmeta_direct_inject(this, result);
        }
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 1/9 done: " + cast<string>(result.definitions.size()) + " definitions, " + cast<string>(this.errors.size()) + " errors"); }
        this.current_pass_index = 2;
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 2/9: Resolving types..."); }
        this.resolve_types_pass.run(unit, result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 2/9 done: " + cast<string>(result.definitions.size()) + " definitions, " + cast<string>(this.errors.size()) + " errors"); }
        this.current_pass_index = 3;
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 3/9: Monomorphizing generics..."); }
        this.monomorphize_pass.run(unit, result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 3/9 done: " + cast<string>(result.definitions.size()) + " definitions, " + cast<string>(this.errors.size()) + " errors"); }
        this.current_pass_index = 4;
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 4/9: Binding symbols..."); }
        this.bind_symbols_pass.run(result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 4/9 done: " + cast<string>(result.definitions.size()) + " definitions, " + cast<string>(this.errors.size()) + " errors"); }
        this.current_pass_index = 5;
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 5/9: Generating constructors..."); }
        this.constructors_pass.run(result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 5/9 done: " + cast<string>(result.definitions.size()) + " definitions, " + cast<string>(this.errors.size()) + " errors"); }
        this.current_pass_index = 6;
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 6/9: Building interface vtables..."); }
        this.interfaces_pass.run(unit, result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 6/9 done: " + cast<string>(result.definitions.size()) + " definitions, " + cast<string>(this.errors.size()) + " errors"); }
        this.current_pass_index = 7;
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 7/9: Classifying value types..."); }
        this.classify_value_types_pass.run(result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 7/9 done: " + cast<string>(result.definitions.size()) + " definitions, " + cast<string>(this.errors.size()) + " errors"); }
        this.current_pass_index = 7;
        this.classify_value_types_pass.validate_interface_usage(result);
        this.current_pass_index = 8;
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 8/9: Binding expressions..."); }
        this.bind_bodies_pass.run(unit, result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 8/9 done: " + cast<string>(result.definitions.size()) + " definitions, " + cast<string>(this.errors.size()) + " errors"); }
        this.current_pass_index = 9;
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 9/9: Validating control flow..."); }
        this.validate_control_flow_pass.run(result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 9/9 done: " + cast<string>(result.definitions.size()) + " definitions, " + cast<string>(this.errors.size()) + " errors"); }
        // E5: static connect-topology checks (output driver uniqueness,
        // input double-connect, unconnected module inputs).
        this.validate_port_topology();
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Done: " + cast<string>(result.definitions.size()) + " definitions, " + cast<string>(this.errors.size()) + " errors"); }
        result.errors = this.errors;
        result.has_suspension = this.has_suspension;
        return result;
    }

    fun report_error(this, code: ErrorCode, message: string, location: SourceLocation) {
        _utils.trace_enter("Enter report_error");
        if (this.suppress_report_errors) { return; }
        this.errors.push(new SemanticError(code, message, location));
    }

    // Coroutine-syntax gate: true = allowed to proceed; false = error already
    // reported. Every binder for the gated syntax set calls this first.
    fun require_coroutine(this, what: string, location: SourceLocation) -> bool {
        if (!this.enable_coroutine) {
            this.report_error(new ErrorCode.E_UNSUPPORTED(), what + " requires the --enable-coroutine option", location);
            return false;
        }
        return true;
    }

    // M10: -vvv decision-point diagnostics. Gated off by default (verbose=0);
    // pass objects call it as this.model.some.trace(...). Kept here (shared
    // core) so every pass can route through the model.
    fun trace(this, msg: string) {
        if (this.verbose >= 3) { __builtin.eprintln("[SemanticTrace] " + msg); }
    }

    fun report_warning(this, code: ErrorCode, message: string, location: SourceLocation) {
        let e: mut SemanticError = new SemanticError(code, message, location);
        e.severity = new ErrorSeverity.Warning();
        this.errors.push(e);
    }

    fun report_info(this, code: ErrorCode, message: string, location: SourceLocation) {
        let e: mut SemanticError = new SemanticError(code, message, location);
        e.severity = new ErrorSeverity.Info();
        this.errors.push(e);
    }

    // ===== E5 port wiring helpers =====

    // Index into the port registry for "<class full name>.<member>", or -1.
    fun find_port_index(this, class_full_name: string, member: string) -> i64 {
        let key: string = class_full_name + "." + member;
        let i: mut i64 = 0;
        while (i < cast<i64>(this.port_keys.size())) {
            if (this.port_keys.at(cast<u64>(i)).some == key) { return i; }
            i = i + 1;
        }
        return -1;
    }

    fun class_has_ports(this, class_full_name: string) -> bool {
        let prefix: string = class_full_name + ".";
        let i: mut i64 = 0;
        while (i < cast<i64>(this.port_keys.size())) {
            if (string_find(this.port_keys.at(cast<u64>(i)).some, prefix) == 0) { return true; }
            i = i + 1;
        }
        return false;
    }

    // True when the port registry key at index i belongs to the class and is
    // the port's bare name (the key is "<class full name>.<port name>"; class
    // full names may themselves contain dots, so match the prefix exactly).
    fun port_name_of_class(this, index: i64, class_full_name: string) -> Option<string> {
        let prefix: string = class_full_name + ".";
        let key: string = this.port_keys.at(cast<u64>(index)).some;
        if (string_find(key, prefix) == 0) {
            return new Option<string>.some(string_substring(key, cast<i64>(string_length(prefix)), cast<i64>(string_length(key)) - cast<i64>(string_length(prefix))));
        }
        return new Option<string>.none();
    }

    // The hidden _Fanout hub full name for a netted variable (a connect
    // source registered at desugar time), or "". Resolution goes through the
    // scope: the hub symbol must resolve from here AND its owner-qualified
    // full name must match the variable's own full name, so a shadowing local
    // with the same bare name cannot steal another scope's net.
    fun find_net_hub(this, var_sym: BoundVariableSymbol, scope: mut BoundScope) -> string {
        let i: mut i64 = 0;
        while (i < cast<i64>(this.pending_net_var.size())) {
            if (this.pending_net_var.at(cast<u64>(i)).some == var_sym.name) {
                let hub_sym: Option<BoundSymbol> = scope.lookup_symbol(this.pending_net_hub.at(cast<u64>(i)).some);
                if (hub_sym.is_some()) {
                    if (hub_sym.some is BoundSymbol.variable) {
                        let hub_full: string = hub_sym.some.variable.full_name;
                        let last_dot: mut i64 = -1;
                        let j: mut i64 = 0;
                        while (j < cast<i64>(string_length(hub_full))) {
                            if (string_char_at(hub_full, j) == ".") { last_dot = j; }
                            j = j + 1;
                        }
                        if (last_dot > 0) {
                            let prefix: string = string_substring(hub_full, 0, last_dot);
                            if (prefix + "." + var_sym.name == var_sym.full_name) {
                                return hub_full;
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        return "";
    }

    // The bare NAME of a hub registered for a variable (for building
    // identifier ASTs), or "" — mirrors find_net_hub but returns the symbol
    // name rather than the full name.
    fun find_net_hub_name(this, var_sym: BoundVariableSymbol, scope: mut BoundScope) -> string {
        let i: mut i64 = 0;
        while (i < cast<i64>(this.pending_net_var.size())) {
            if (this.pending_net_var.at(cast<u64>(i)).some == var_sym.name) {
                let hub_sym: Option<BoundSymbol> = scope.lookup_symbol(this.pending_net_hub.at(cast<u64>(i)).some);
                if (hub_sym.is_some()) {
                    if (hub_sym.some is BoundSymbol.variable) {
                        let hub_full: string = hub_sym.some.variable.full_name;
                        let last_dot: mut i64 = -1;
                        let j: mut i64 = 0;
                        while (j < cast<i64>(string_length(hub_full))) {
                            if (string_char_at(hub_full, j) == ".") { last_dot = j; }
                            j = j + 1;
                        }
                        if (last_dot > 0) {
                            let prefix: string = string_substring(hub_full, 0, last_dot);
                            if (prefix + "." + var_sym.name == var_sym.full_name) {
                                return hub_sym.some.variable.name;
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        return "";
    }

    fun loc_text(this, location: SourceLocation) -> string {
        return location.to_string();
    }

    fun join_strings(this, parts: mut _utils.List<string>, sep: string) -> string {
        let sb: mut StringBuilder = new StringBuilder();
        let i: mut i64 = 0;
        while (i < cast<i64>(parts.size())) {
            if (i > 0) { sb.append(sep); }
            sb.append(parts.at(cast<u64>(i)).some);
            i = i + 1;
        }
        return sb.to_string();
    }

    // Static connect-topology checks (design Q2/Q3/Q9), aligned with
    // BabyPenguin's PortTopologyValidator:
    // 1. an output port has exactly one driver — a construct passthrough
    //    wire XOR module body code, and at most one driving routine;
    // 2. an input port is connected exactly once per construct pool;
    // 3. every module instantiated in a construct pool has each input
    //    connected there or declared with a default.
    fun validate_port_topology(mut this) {
        let checked: mut _utils.List<string> = new _utils.List<string>();
        let di: mut i64 = 0;
        while (di < cast<i64>(this.driver_keys.size())) {
            let key: string = this.driver_keys.at(cast<u64>(di)).some;
            let seen_key: mut bool = false;
            let ci: mut i64 = 0;
            while (ci < cast<i64>(checked.size())) {
                if (checked.at(cast<u64>(ci)).some == key) { seen_key = true; }
                ci = ci + 1;
            }
            if (!seen_key) {
                checked.push(key);
                let wire_loc: mut string = "";
                let body_fns: mut _utils.List<string> = new _utils.List<string>();
                let body_locs: mut _utils.List<string> = new _utils.List<string>();
                let ej: mut i64 = 0;
                while (ej < cast<i64>(this.driver_keys.size())) {
                    if (this.driver_keys.at(cast<u64>(ej)).some == key) {
                        if (cast<i64>(string_length(this.driver_wire_locs.at(cast<u64>(ej)).some)) > 0) {
                            if (string_length(wire_loc) == 0) {
                                wire_loc = this.driver_wire_locs.at(cast<u64>(ej)).some;
                            }
                        } else {
                            let fn_name: string = this.driver_body_fns.at(cast<u64>(ej)).some;
                            let already_fn: mut bool = false;
                            let fi: mut i64 = 0;
                            while (fi < cast<i64>(body_fns.size())) {
                                if (body_fns.at(cast<u64>(fi)).some == fn_name) { already_fn = true; }
                                fi = fi + 1;
                            }
                            if (!already_fn) {
                                body_fns.push(fn_name);
                                body_locs.push(this.driver_body_locs.at(cast<u64>(ej)).some);
                            }
                        }
                    }
                    ej = ej + 1;
                }
                if (string_length(wire_loc) > 0 && cast<i64>(body_fns.size()) > 0) {
                    this.report_error(new ErrorCode.E_WIRING(),
                        "Output port '" + key + "' has two drivers: module body code (" + this.join_strings(body_locs, ", ") + ") and a construct wire (" + wire_loc + ") - drive it from exactly one (body XOR connect line); merge multiple streams through a channel",
                        new SourceLocation("", 0, 0));
                }
                // NOTE: several routines of the OWNING module writing their own
                // output is legal (design Q9 granularity: the module's body code
                // is one driver source, XOR the construct wire). The permission
                // matrix already forbids any other module's routine from writing
                // the port, so no per-routine count is needed here.
            }
            di = di + 1;
        }

        // Unique construct pools.
        let pools: mut _utils.List<string> = new _utils.List<string>();
        let pi: mut i64 = 0;
        while (pi < cast<i64>(this.sink_pool_ids.size())) {
            let p: string = this.sink_pool_ids.at(cast<u64>(pi)).some;
            let have: mut bool = false;
            let qi: mut i64 = 0;
            while (qi < cast<i64>(pools.size())) {
                if (pools.at(cast<u64>(qi)).some == p) { have = true; }
                qi = qi + 1;
            }
            if (!have) { pools.push(p); }
            pi = pi + 1;
        }
        let ni: mut i64 = 0;
        while (ni < cast<i64>(this.newed_pool_ids.size())) {
            let p2: string = this.newed_pool_ids.at(cast<u64>(ni)).some;
            let have2: mut bool = false;
            let qi2: mut i64 = 0;
            while (qi2 < cast<i64>(pools.size())) {
                if (pools.at(cast<u64>(qi2)).some == p2) { have2 = true; }
                qi2 = qi2 + 1;
            }
            if (!have2) { pools.push(p2); }
            ni = ni + 1;
        }

        let pl: mut i64 = 0;
        while (pl < cast<i64>(pools.size())) {
            let pool: string = pools.at(cast<u64>(pl)).some;
            // Double-connected inputs.
            let seen_sinks: mut _utils.List<string> = new _utils.List<string>();
            let si: mut i64 = 0;
            while (si < cast<i64>(this.sink_pool_ids.size())) {
                if (this.sink_pool_ids.at(cast<u64>(si)).some == pool) {
                    let sk: string = this.sink_keys.at(cast<u64>(si)).some;
                    let dup_idx: mut i64 = -1;
                    let xi: mut i64 = 0;
                    while (xi < cast<i64>(seen_sinks.size())) {
                        if (seen_sinks.at(cast<u64>(xi)).some == sk) { dup_idx = xi; }
                        xi = xi + 1;
                    }
                    if (dup_idx >= 0) {
                        this.report_error(new ErrorCode.E_WIRING(),
                            "Input port '" + sk + "' is connected twice (first at " + this.sink_locs.at(cast<u64>(dup_idx)).some + ", again at " + this.sink_locs.at(cast<u64>(si)).some + ") - an input has exactly one driver",
                            new SourceLocation("", 0, 0));
                    } else {
                        seen_sinks.push(sk);
                    }
                }
                si = si + 1;
            }
            // Unconnected module inputs.
            let mi: mut i64 = 0;
            while (mi < cast<i64>(this.newed_pool_ids.size())) {
                if (this.newed_pool_ids.at(cast<u64>(mi)).some == pool) {
                    let cls_full: string = this.newed_class_names.at(cast<u64>(mi)).some;
                    let var_name: string = this.newed_var_names.at(cast<u64>(mi)).some;
                    let ki: mut i64 = 0;
                    while (ki < cast<i64>(this.port_keys.size())) {
                        let port_opt: Option<string> = this.port_name_of_class(ki, cls_full);
                        if (port_opt.is_some()) {
                            let port_name: string = port_opt.some;
                            if (this.port_is_input.at(cast<u64>(ki)).some) {
                                if (!this.port_has_default.at(cast<u64>(ki)).some) {
                                    let want: string = var_name + "." + port_name;
                                    let connected: mut bool = false;
                                    let yi: mut i64 = 0;
                                    while (yi < cast<i64>(seen_sinks.size())) {
                                        if (seen_sinks.at(cast<u64>(yi)).some == want) { connected = true; }
                                        yi = yi + 1;
                                    }
                                    if (!connected) {
                                        this.report_error(new ErrorCode.E_WIRING(),
                                            "Input port '" + port_name + "' of module '" + var_name + "' (" + cls_full + ") is never connected - connect it in a construct block or declare a default ('input " + port_name + " = <default>')",
                                            new SourceLocation("", 0, 0));
                                    }
                                }
                            }
                        }
                        ki = ki + 1;
                    }
                }
                mi = mi + 1;
            }
            pl = pl + 1;
        }
    }

    // Best-effort source-location extractors for diagnostics. Return the symbol's
    // recorded location, or an empty location when the symbol is absent (avoids
    // emitting useless ":0:0" when a real source span is available).
    fun var_sym_loc(this, sym: Option<BoundVariableSymbol>) -> SourceLocation {
        if (let s := sym.some) { return s.location; }
        return new SourceLocation("", 0, 0);
    }
    fun type_sym_loc(this, sym: Option<BoundTypeSymbol>) -> SourceLocation {
        if (let s := sym.some) { return s.location; }
        return new SourceLocation("", 0, 0);
    }
    fun func_sym_loc(this, sym: Option<BoundFunctionSymbol>) -> SourceLocation {
        if (let s := sym.some) { return s.location; }
        return new SourceLocation("", 0, 0);
    }
    fun enum_member_sym_loc(this, sym: Option<BoundEnumMemberSymbol>) -> SourceLocation {
        if (let s := sym.some) { return s.location; }
        return new SourceLocation("", 0, 0);
    }

    fun substitute_generic_args(this, bt: mut BoundType, concrete_type: BoundType, generic_def: BoundDefinition) -> mut BoundType {
        _utils.trace_enter("Enter substitute_generic_args");
        if (cast<i64>(concrete_type.generic_args.size()) == 0) { return bt; }
        let bt_name: string = bt.display_name();
        // The enum and class branches share an identical matching loop over the
        // def's generic_params (both `_utils.List<string>`), so resolve the param
        // list once and run a single loop.
        let generic_params: _utils.List<string> = if (generic_def is BoundDefinition.enum_def) {
            generic_def.enum_def.generic_params
        } else if (generic_def is BoundDefinition.class_def) {
            generic_def.class_def.generic_params
        } else {
            new _utils.List<string>()
        };
        let pi: mut i64 = 0;
        while (pi < cast<i64>(generic_params.size()) && pi < cast<i64>(concrete_type.generic_args.size())) {
            if (bt_name == generic_params.at(cast<u64>(pi)).some) {
                let arg: mut BoundType = arg_as_bound_type(concrete_type.generic_args.at(cast<u64>(pi)).some);
                return arg;
            }
            pi = pi + 1;
        }
        return bt;
    }

    fun resolve_type_specifier(this, type_spec: TypeSpecifier, scope: BoundScope) -> mut BoundType {
        _utils.trace_enter("Enter resolve_type_specifier");
        let mt: Option<BoundType> = this.resolve_types_pass.try_resolve_meta_type_specifier(type_spec, scope);
        if (mt.is_some()) {
            return this.resolve_types_pass.apply_mutability(mt.some, type_spec.is_mutable);
        }
        if (type_spec.is_function_type || type_spec.is_async_function_type) {
            // BabyPenguin convention: the FIRST generic arg is the RETURN
            // type, the rest are parameters (`fun<i32, i32>` = i32(i32)).
            // An explicit `-> ret` overrides the first arg as the return and
            // keeps all generic args as parameters.
            let ret: mut BoundType = this.type_registry.void_type;
            let param_start: mut i64 = 0;
            if (type_spec.return_type.is_some()) {
                ret = this.resolve_type_specifier(type_spec.return_type.some, scope);
            } else if (cast<i64>(type_spec.function_params.size()) > 0) {
                ret = this.resolve_type_specifier(type_spec.function_params.at(cast<u64>(0)).some, scope);
                param_start = 1;
            }
            let param_types: mut _utils.List<BoundType> = new _utils.List<BoundType>();
            let i: mut i64 = param_start;
            while (i < cast<i64>(type_spec.function_params.size())) {
                param_types.push(this.resolve_type_specifier(
                    type_spec.function_params.at(cast<u64>(i)).some, scope));
                i = i + 1;
            }
            return this.type_registry.make_function_type(ret, param_types, type_spec.is_async_function_type);
        }
    // Handle iterable type (e.g., i64[] → __builtin.IIterator<i64>).
    // Desugar to the specialized (monomorphized) name so the resulting BoundType
    // has the correct type_definition (specialized interface) with concrete types.
    if (type_spec.is_iterable) {
        let elem_name: string = type_spec.name;
        // Find IIterator in __builtin to get its BoundType
        let parts3: mut _utils.List<string> = new _utils.List<string>();
        parts3.push("__builtin");
        parts3.push("IIterator");
        let iface_sym3: Option<BoundSymbol> = scope.resolve_qualified(parts3);
        if (iface_sym3.is_some() && iface_sym3.some is BoundSymbol.type_sym) {
            let iface_type: mut BoundType = iface_sym3.some.type_sym.bound_type;
            // Resolve the element type and add as generic arg
            let elem_ts3: TypeSpecifier = new TypeSpecifier();
            elem_ts3.name = elem_name;
            let eqi4: mut i64 = 0;
            while (eqi4 < cast<i64>(type_spec.qualified_parts.size())) {
                elem_ts3.qualified_parts.push(type_spec.qualified_parts.at(cast<u64>(eqi4)).some);
                eqi4 = eqi4 + 1;
            }
            let elem_type3: BoundType = this.resolve_type_specifier(elem_ts3, scope);
            let gen_args3: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
            gen_args3.push(make_type_arg(elem_type3.with_mutability(new Mutability.Immutable())));
            iface_type = iface_type.with_generic_args(gen_args3);
            // An iterable type (`i64[]`) is mutable by default so the resulting
            // IIterator's `next()` (mut this) can be called on the variable.
            let want_mut: bool = if (type_spec.is_not_mutable) { false } else { true };
            return this.resolve_types_pass.apply_mutability(iface_type, want_mut);
        }
        this.report_error(new ErrorCode.E_RESOLVE_TYPE(),
            "Can't resolve IIterator for iterable type '" + type_spec.build_text() + "'",
            type_spec.location);
        return this.type_registry.make_error_type();
    }
        // Check for Self keyword: resolves to the enclosing class/enum/interface type.
        if (type_spec.name == "Self") {
            let cur: mut Option<BoundScope> = new Option<BoundScope>.some(scope);
            while (cur.is_some()) {
                let s: BoundScope = cur.some;
                if (s.kind is ScopeKind.ClassScope || s.kind is ScopeKind.EnumScope || s.kind is ScopeKind.InterfaceScope) {
                    // Look up the type symbol in the parent scope by this scope's name.
                    if (s.parent.is_some()) {
                        let parent_sym: Option<BoundSymbol> = s.parent.some.lookup_type_in_scope(s.name);
                        if (parent_sym.is_some() && parent_sym.some is BoundSymbol.type_sym) {
                            return this.resolve_types_pass.apply_mutability(parent_sym.some.type_sym.bound_type, type_spec.is_mutable);
                        }
                    }
                }
                if (s.parent.is_some()) { cur = new Option<BoundScope>.some(s.parent.some); }
                else { cur = new Option<BoundScope>.none(); }
            }
            // If Self resolution fails, fall through to normal error handling.
        }
        let prim: Option<BoundType> = this.type_registry.resolve_type(type_spec.name);
        if (prim.is_some()) {
            return this.resolve_types_pass.apply_mutability(prim.some, type_spec.is_mutable);
        }
        let qual_result: Option<BoundType> = this.try_resolve_qualified_type(type_spec, scope);
        if (qual_result.is_some()) {
            return this.resolve_types_pass.apply_mutability(qual_result.some, type_spec.is_mutable);
        }
        let type_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(type_spec.name);
        if (type_sym.is_some()) {
            let result: mut BoundType = type_sym.some.type_sym.bound_type;
            if (cast<i64>(type_spec.generic_args.size()) > 0) {
                // M4: route VALUE-arg template instantiations through the `_template_X`
                // meta path (returns the specialized type); type-only instantiations
                // fall through to template+args + the fixpoint. try_resolve_template_instantiation
                // gates to value args (the fixpoint's gap) to avoid OOM.
                let m4: Option<BoundType> = this.bind_meta_calls_pass.try_resolve_template_instantiation(type_spec.name, type_spec.generic_args, scope);
                if (m4.is_some()) {
                    return this.resolve_types_pass.apply_mutability(m4.some, type_spec.is_mutable);
                }
                result = result.with_generic_args(this.resolve_types_pass.resolve_generic_args(type_spec, scope));
            }
            return this.resolve_types_pass.apply_mutability(result, type_spec.is_mutable);
        }
        this.report_error(new ErrorCode.E_RESOLVE_TYPE(),
            "Can't resolve type specifier '" + type_spec.build_text() + "'",
            type_spec.location);
        return this.type_registry.make_error_type();
    }

    // Resolve a type specifier WITHOUT handling is_iterable (to avoid recursion
    // when resolve_type_specifier delegates to this for the element type).
    fun resolve_type_specifier_no_iterable(this, type_spec: TypeSpecifier, scope: BoundScope) -> mut BoundType {
        _utils.trace_enter("Enter resolve_type_specifier_no_iterable");
        let mt: Option<BoundType> = this.resolve_types_pass.try_resolve_meta_type_specifier(type_spec, scope);
        if (mt.is_some()) {
            return this.resolve_types_pass.apply_mutability(mt.some, type_spec.is_mutable);
        }
        if (type_spec is TypeSpecifier) {
            // Skip: just a type guard — always true
        }
        if (type_spec.name == "Self") {
            let cur: mut Option<BoundScope> = new Option<BoundScope>.some(scope);
            while (cur.is_some()) {
                let s: BoundScope = cur.some;
                if (s.kind is ScopeKind.ClassScope || s.kind is ScopeKind.EnumScope || s.kind is ScopeKind.InterfaceScope) {
                    if (s.parent.is_some()) {
                        let parent_sym: Option<BoundSymbol> = s.parent.some.lookup_type_in_scope(s.name);
                        if (parent_sym.is_some() && parent_sym.some is BoundSymbol.type_sym) {
                            return this.resolve_types_pass.apply_mutability(parent_sym.some.type_sym.bound_type, type_spec.is_mutable);
                        }
                    }
                }
                if (s.parent.is_some()) { cur = new Option<BoundScope>.some(s.parent.some); }
                else { cur = new Option<BoundScope>.none(); }
            }
        }
        let prim: Option<BoundType> = this.type_registry.resolve_type(type_spec.name);
        if (prim.is_some()) {
            return this.resolve_types_pass.apply_mutability(prim.some, type_spec.is_mutable);
        }
        let qual_result: Option<BoundType> = this.try_resolve_qualified_type(type_spec, scope);
        if (qual_result.is_some()) {
            return this.resolve_types_pass.apply_mutability(qual_result.some, type_spec.is_mutable);
        }
        let type_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(type_spec.name);
        if (type_sym.is_some()) {
            let result: mut BoundType = type_sym.some.type_sym.bound_type;
            if (cast<i64>(type_spec.generic_args.size()) > 0) {
                // M4: route VALUE-arg template instantiations through the `_template_X`
                // meta path (returns the specialized type); type-only instantiations
                // fall through to template+args + the fixpoint. try_resolve_template_instantiation
                // gates to value args (the fixpoint's gap) to avoid OOM.
                let m4: Option<BoundType> = this.bind_meta_calls_pass.try_resolve_template_instantiation(type_spec.name, type_spec.generic_args, scope);
                if (m4.is_some()) {
                    return this.resolve_types_pass.apply_mutability(m4.some, type_spec.is_mutable);
                }
                result = result.with_generic_args(this.resolve_types_pass.resolve_generic_args(type_spec, scope));
            }
            return this.resolve_types_pass.apply_mutability(result, type_spec.is_mutable);
        }
        this.report_error(new ErrorCode.E_RESOLVE_TYPE(),
            "Can't resolve type specifier '" + type_spec.build_text() + "'",
            type_spec.location);
        return this.type_registry.make_error_type();
    }

    // Resolve an iterable type (e.g., i64[] → IIterator<i64>).
    fun resolve_iterable_type(this, element_type: BoundType, type_spec: TypeSpecifier, scope: BoundScope) -> mut BoundType {
        _utils.trace_enter("Enter resolve_iterable_type");
        // Try unqualified lookup first (works if __builtin is imported)
        let iface_sym: Option<BoundSymbol> = if (scope.lookup_type_in_scope("IIterator").is_some()) {
            scope.lookup_type_in_scope("IIterator")
        } else {
            let parts2: mut _utils.List<string> = new _utils.List<string>();
            parts2.push("__builtin");
            parts2.push("IIterator");
            scope.resolve_qualified(parts2)
        };
        if (iface_sym.is_some() && iface_sym.some is BoundSymbol.type_sym) {
            let iface_type: mut BoundType = iface_sym.some.type_sym.bound_type;
            let gen_args: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
            gen_args.push(make_type_arg(element_type.with_mutability(new Mutability.Immutable())));
            iface_type = iface_type.with_generic_args(gen_args);
            // An iterable type (`i64[]`) is mutable by default so the resulting
            // IIterator's `next()` (mut this) can be called on the variable.
            let want_mut: bool = if (type_spec.is_not_mutable) { false } else { true };
            return this.resolve_types_pass.apply_mutability(iface_type, want_mut);
        }
        // If IIterator not found, give a clear error
        this.report_error(new ErrorCode.E_RESOLVE_TYPE(),
            "Can't resolve IIterator for iterable type '" + type_spec.build_text() + "'",
            type_spec.location);
        return this.type_registry.make_error_type();
    }

    fun try_resolve_qualified_type(this, type_spec: TypeSpecifier, scope: BoundScope) -> Option<BoundType> {
        _utils.trace_enter("Enter try_resolve_qualified_type");
        if (cast<i64>(type_spec.qualified_parts.size()) == 0) {
            return new Option<BoundType>.none();
        }
        let full_parts: mut _utils.List<string> = new _utils.List<string>();
        let qi: mut i64 = 0;
        while (qi < cast<i64>(type_spec.qualified_parts.size())) {
            full_parts.push(type_spec.qualified_parts.at(cast<u64>(qi)).some);
            qi = qi + 1;
        }
        full_parts.push(type_spec.name);
        let found: Option<BoundSymbol> = scope.resolve_qualified(full_parts);
        if (found.is_none()) {
            return new Option<BoundType>.none();
        }
        if (found.some is BoundSymbol.type_sym) {
            // OK - continue to resolve
        } else {
            return new Option<BoundType>.none();
        }
        let resolved: mut BoundType = found.some.type_sym.bound_type;
        if (cast<i64>(type_spec.generic_args.size()) > 0) {
            resolved = resolved.with_generic_args(this.resolve_types_pass.resolve_generic_args(type_spec, scope));
        }
        return new Option<BoundType>.some(resolved);
    }

    // M3: run a specialized def through the per-def processors for passes
    // 4..current_pass_index (the passes that normally iterate result.definitions).
    // This lets a specialization created LATE — e.g. by the M4 meta path during
    // expression binding (pass 8) — still get symbols/constructors/vtables/
    // value-type classification/body binding it would otherwise miss (the B1 bug).
    //
    // pass_monomorphize (pass 3) calls this right after creating a def; there the
    // 4..3 range is empty so it is a no-op and the normal pass loop handles passes
    // 4-8 — keeping the fixpoint's behavior identical. Each processor's
    // `pass_index >= current_pass_index` guard makes this idempotent; we temporarily
    // lower current_pass_index to each processor's pass number so a def first seen
    // in a later pass is still run through the earlier processors (a single global
    // current_pass_index would otherwise skip them). Passes 2-3 are NOT replayed
    // here: pass_monomorphize's own resolve_pair + the specialize_* creation handle
    // those, and replaying resolve_pair would double-resolve.
    fun already_processed(this, def: BoundDefinition) -> bool {
        return BoundDefinition.get_pass_index(def) >= this.current_pass_index;
    }

    fun processed_beyond(this, def: BoundDefinition) -> bool {
        return BoundDefinition.get_pass_index(def) > this.current_pass_index;
    }

    fun catch_up_def(mut this, def: BoundDefinition, result: BoundCompilationUnit) {
        _utils.trace_enter("Enter catch_up_def");
        let saved: i64 = this.current_pass_index;
        this.trace("catch_up_def " + this.def_display_name(def) + " (saved pass index " + cast<string>(saved) + ")");
        let def_scope: mut BoundScope = def_lookup_scope(def, result.global_scope);
        // The returning processors (init_constructors_for_def, build_vtables_*,
        // classify_def, bind_body_*) mutate the def's inner object IN PLACE and only
        // re-wrap the same object, so ignoring their return is correct — the def
        // (the same object held in result.definitions) is updated.
        if (saved >= 4) { this.current_pass_index = 4; this.bind_symbols_pass.bind_symbols_for_def(def); }
        if (saved >= 5) { this.current_pass_index = 5; this.constructors_pass.init_constructors_for_def(def, def_scope); }
        if (saved >= 6) {
            this.current_pass_index = 6;
            this.interfaces_pass.build_vtables_for_specialized_def(def, def_scope);
            this.interfaces_pass.merge_inherited_vtables_for_def(def, def_scope);
        }
        if (saved >= 7) {
            this.current_pass_index = 7;
            this.classify_value_types_pass.classify_def(def, new _utils.List<string>());
            this.classify_value_types_pass.validate_interface_usage_def(def);
        }
        if (saved >= 8) { this.current_pass_index = 8; this.bind_bodies_pass.bind_body_for_specialized_def(def, result); }
        this.current_pass_index = saved;
    }

    // Same replay but WITHOUT the pass-8 body binding: used by bind-time def
    // synthesis (bind_spawn_async). Signature-level passes (symbols, ctors,
    // vtables, classification) are safe to run nested inside an expression
    // bind; body binding is not — the appended def's bodies are bound later
    // by the (dynamic) pass-8 run loop.
    fun catch_up_def_before_bodies(mut this, def: BoundDefinition, result: BoundCompilationUnit) {
        _utils.trace_enter("Enter catch_up_def_before_bodies");
        let saved: i64 = this.current_pass_index;
        let def_scope: mut BoundScope = def_lookup_scope(def, result.global_scope);
        if (saved >= 4) { this.current_pass_index = 4; this.bind_symbols_pass.bind_symbols_for_def(def); }
        if (saved >= 5) { this.current_pass_index = 5; this.constructors_pass.init_constructors_for_def(def, def_scope); }
        if (saved >= 6) {
            this.current_pass_index = 6;
            this.interfaces_pass.build_vtables_for_specialized_def(def, def_scope);
            this.interfaces_pass.merge_inherited_vtables_for_def(def, def_scope);
        }
        if (saved >= 7) {
            this.current_pass_index = 7;
            this.classify_value_types_pass.classify_def(def, new _utils.List<string>());
            this.classify_value_types_pass.validate_interface_usage_def(def);
        }
        this.current_pass_index = saved;
        // The def's body is still UNBOUND — that is the whole point of this
        // replay. But the sub-passes above stamp each processor's pass index
        // onto the def (classify reaches `saved` == 8 when called from pass
        // 8), which would make the dynamic pass-8 loop's already_processed
        // guard skip binding the body entirely (async-site spawn ctx classes
        // failed exactly this way: `this` never entered the method scope,
        // E_RESOLVE_SYMBOL six times per `async this.m()` site). Reset to 7:
        // "everything through classification is done, body pending".
        if (saved >= 8 && BoundDefinition.get_pass_index(def) >= 8) {
            BoundDefinition.set_pass_index(def, 7);
        }
    }

    // Pass-8-forced variant of catch_up_def_before_bodies for defs created
    // NESTED inside another def's late catch-up chain (e.g. resolve_field_
    // specialization creating a sibling field-type specialization while the
    // caller has temporarily lowered current_pass_index to 3 for resolve_pair).
    // current_pass_index=8 here means "the compilation's real position is the
    // pass-8 window (current_unit is set), no matter what index the enclosing
    // bind nested at" — so the fresh def gets symbols, constructors, vtables
    // AND classification; without this, a pass-8-window specialization that
    // only rides resolve_pair + push is never classified (pass 7's global run
    // is already over) and the emitter defaults it to a VALUE class
    // (E_SIZE_CYCLE on recursive shapes like _ChanNode.next: Option<_ChanNode>).
    fun catch_up_def_before_bodies_as_pass8(mut this, def: BoundDefinition, result: BoundCompilationUnit) {
        _utils.trace_enter("Enter catch_up_def_before_bodies_as_pass8");
        let saved: i64 = this.current_pass_index;
        this.current_pass_index = 8;
        this.catch_up_def_before_bodies(def, result);
        this.current_pass_index = saved;
    }

    // Resolve an impl block's interface/target type by its QUALIFIED NAME ONLY
    // (no generic args). Vtables key on the interface TEMPLATE (matching the
    // call side's extract_template_name), and in a template context the generic
    // args may reference template params (T) that are unresolvable outside the
    // class scope — resolving them here would fail and/or register a
    // specialized interface where master semantics keep the template.
    fun resolve_impl_base_type(mut this, ts: TypeSpecifier, scope: mut BoundScope, location: SourceLocation) -> mut BoundType {
        _utils.trace_enter("Enter resolve_impl_base_type");
        // Non-reporting resolution chain (resolve_type_specifier REPORTS an
        // error on failure, which would leak even when a later fallback hits):
        // 1) qualified name via try_resolve_qualified_type (no error),
        // 2) simple name via scope lookup,
        // 3) anywhere scan — an impl block may reference an interface from a
        //    DIFFERENT namespace than where it ends up being processed.
        //    #specializing injects `impl IHasValue` (defined in `namespace
        //    penguin`) into __builtin.Option, so resolution from the Option
        //    scope fails. Matches master's global child scan for impl targets
        //    only — user code isolation is unaffected.
        let base_ts: mut TypeSpecifier = new TypeSpecifier();
        base_ts.name = ts.name;
        let qi: mut i64 = 0;
        while (qi < cast<i64>(ts.qualified_parts.size())) {
            base_ts.qualified_parts.push(ts.qualified_parts.at(cast<u64>(qi)).some);
            qi = qi + 1;
        }
        let qual: Option<BoundType> = this.try_resolve_qualified_type(base_ts, scope);
        if (qual.is_some()) { return qual.some; }
        let sym: Option<BoundSymbol> = scope.lookup_type_in_scope(ts.name);
        if (sym.is_some() && sym.some is BoundSymbol.type_sym) { return sym.some.type_sym.bound_type; }
        let anywhere: Option<BoundSymbol> = this.global_scope.lookup_type_anywhere(ts.name);
        if (anywhere.is_some() && anywhere.some is BoundSymbol.type_sym) { return anywhere.some.type_sym.bound_type; }
        return this.type_registry.make_error_type();
    }

    fun resolve_type_name(mut this, name: string, scope: mut BoundScope, location: SourceLocation) -> mut BoundType {
        _utils.trace_enter("Enter resolve_type_name");
        let prim: Option<BoundType> = this.type_registry.resolve_type(name);
        if (prim.is_some()) {
            let result: mut BoundType = prim.some;
            return result;
        }
        let type_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(name);
        if (type_sym.is_some()) {
            let result: mut BoundType = type_sym.some.type_sym.bound_type;
            return result;
        }
        this.report_error(new ErrorCode.E_RESOLVE_TYPE(),
            "Can't resolve type specifier '" + name + "'",
            location);
        return this.type_registry.make_error_type();
    }

    // Resolve a possibly-dotted base type name ("<ns>.<ns>.<Type>" or a
    // primitive/registry name) from the given scope. resolve_type_name is the
    // simple-name path; dotted spellings need segment-by-segment resolution
    // (used by the libmeta injector, whose <T> base names are always fully
    // qualified).
    fun resolve_base_type_qualified(mut this, name: string, scope: mut BoundScope, location: SourceLocation) -> mut BoundType {
        let dot: i64 = string_find(name, ".");
        if (dot < 0) { return this.resolve_type_name(name, scope, location); }
        let parts: mut _utils.List<string> = new _utils.List<string>();
        let rest: mut string = name;
        let d: mut i64 = string_find(rest, ".");
        while (d >= 0) {
            parts.push(string_substring(rest, 0, d));
            rest = string_substring(rest, d + 1, string_length(rest) - d - 1);
            d = string_find(rest, ".");
        }
        parts.push(rest);
        let found: Option<BoundSymbol> = scope.resolve_qualified(parts);
        if (found.is_some()) {
            if (found.some is BoundSymbol.type_sym) {
                let bt: mut BoundType = found.some.type_sym.bound_type;
                return bt;
            }
        }
        this.report_error(new ErrorCode.E_RESOLVE_TYPE(),
            "Can't resolve type specifier '" + name + "'",
            location);
        return this.type_registry.make_error_type();
    }

    fun def_display_name(this, def: BoundDefinition) -> string {
        _utils.trace_enter("Enter def_display_name");
        if (def is BoundDefinition.function_def) { return "function " + def.function_def.full_name; }
        if (def is BoundDefinition.class_def) { return "class " + def.class_def.name; }
        if (def is BoundDefinition.enum_def) { return "enum " + def.enum_def.name; }
        if (def is BoundDefinition.interface_def) { return "interface " + def.interface_def.name; }
        if (def is BoundDefinition.namespace_def) { return "namespace " + def.namespace_def.name; }
        if (def is BoundDefinition.initial_routine) { return "initial"; }
        if (def is BoundDefinition.impl_def) { return "impl"; }
        if (def is BoundDefinition.impl_for_def) { return "impl for"; }
        if (def is BoundDefinition.type_ref_def) { return "type " + def.type_ref_def.name; }
        if (def is BoundDefinition.global_var_def) { return "global " + def.global_var_def.name; }
        if (def is BoundDefinition.class_field) { return "field " + def.class_field.name; }
        return "<unknown>";
    }

    // True when the bound type is a numeric primitive (signed/unsigned ints or
    // floats). bool / char / string / void are excluded: numeric casts only
    // apply between numeric types.
    fun is_numeric_primitive_type(this, t: BoundType) -> bool {
        if (t.kind is TypeKind.PrimitiveKind) {
            if (t.primitive is PrimitiveType.BoolType) { return false; }
            if (t.primitive is PrimitiveType.CharType) { return false; }
            if (t.primitive is PrimitiveType.StringType) { return false; }
            if (t.primitive is PrimitiveType.VoidType) { return false; }
            return true;
        }
        return false;
    }

    // Mirror of LLVMEmitter.cast_op's supported numeric conversions, in LLVM
    // type names (u* aliases the corresponding i*). cast_op falls back to
    // "bitcast" for anything not in its table, which would be invalid IR, so
    // callers must skip unsupported combinations (e.g. i8/i16 <-> float).
    fun numeric_cast_supported(this, from: PrimitiveType, to: PrimitiveType) -> bool {
        let f: string = this.numeric_primitive_llvm_type(from);
        let t: string = this.numeric_primitive_llvm_type(to);
        if (f == "void" || t == "void") { return false; }
        if (f == t) { return true; }
        let f_int: bool = this.is_int_llvm_type(f);
        let t_int: bool = this.is_int_llvm_type(t);
        if (f_int && t_int) { return true; }
        if (f_int && (t == "float" || t == "double")) { return f == "i32" || f == "i64"; }
        if ((f == "float" || f == "double") && t_int) { return t == "i32" || t == "i64"; }
        if ((f == "float" || f == "double") && (t == "float" || t == "double")) { return true; }
        return false;
    }

    fun numeric_primitive_llvm_type(this, p: PrimitiveType) -> string {
        if (p is PrimitiveType.I8) { return "i8"; }
        if (p is PrimitiveType.I16) { return "i16"; }
        if (p is PrimitiveType.I32) { return "i32"; }
        if (p is PrimitiveType.I64) { return "i64"; }
        if (p is PrimitiveType.U8) { return "i8"; }
        if (p is PrimitiveType.U16) { return "i16"; }
        if (p is PrimitiveType.U32) { return "i32"; }
        if (p is PrimitiveType.U64) { return "i64"; }
        if (p is PrimitiveType.F32) { return "float"; }
        if (p is PrimitiveType.F64) { return "double"; }
        return "void";
    }

    fun is_int_llvm_type(this, t: string) -> bool {
        if (t == "i8") { return true; }
        if (t == "i16") { return true; }
        if (t == "i32") { return true; }
        if (t == "i64") { return true; }
        return false;
    }
}

}
