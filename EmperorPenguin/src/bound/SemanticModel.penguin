namespace emperor {

class FunctionInstantiation {
    func_name: !mut string = "";
    generic_args: mut _utils.List<BoundType> = new _utils.List<BoundType>();

    fun new(mut this, func_name: string, generic_args: mut _utils.List<BoundType>) {

        this.func_name = func_name;
        this.generic_args = generic_args;
    }
}

class SemanticModel {
    type_registry: mut BoundTypeRegistry;
    errors: mut _utils.List<SemanticError> = new _utils.List<SemanticError>();
    global_scope: mut BoundScope;
    current_unit: mut Option<BoundCompilationUnit> = new Option<BoundCompilationUnit>.none();
    _current_validating_func: mut string = "";
    ast_definitions: mut _utils.List<Definition> = new _utils.List<Definition>();
    // Host-side compile-time option store for #define / #defined / #option used
    // outside #fun bodies (e.g. #if (#defined("DEBUG")) conditional compilation).
    // #fun bodies keep their own store in MetaEngine (unit B). Parallel-list map,
    // matching MetaEngine's option_keys/option_values shape.
    meta_option_keys: mut _utils.List<string> = new _utils.List<string>();
    meta_option_values: mut _utils.List<string> = new _utils.List<string>();
    // Phase 5b: registry of #fun meta functions (collected in pass_build_scopes)
    // and a lazily-used JIT engine for executing #fun calls at compile time and
    // splicing the result. The JIT path only runs in a native pass2+ binary
    // built with --enable-meta; in BabyPenguin-VM/dotnet-test builds it is never
    // reached (no user-code #fun calls), so libpenguin_jit need not be linked.
    meta_function_defs: mut _utils.List<BoundMetaFunctionDefinition> = new _utils.List<BoundMetaFunctionDefinition>();
    // Phase 6 v2: `#class` definitions collected from unit A, fed into unit B so
    // #funs can use them as meta-only data structures (not emitted to runtime).
    meta_class_defs: mut _utils.List<ClassDefinition> = new _utils.List<ClassDefinition>();
    meta_engine: mut MetaEngine = new MetaEngine();
    meta_engine_seeded: mut bool = false;
    verbose: mut i64 = 0;

    fun new(mut this) {

        this.type_registry = new BoundTypeRegistry();
        this.global_scope = new BoundScope(new ScopeKind.GlobalScope(), "<global>", "<global>", new Option<BoundScope>.none());
        this.register_builtin_interfaces();
        this.register_builtin_functions();
    }

    fun register_builtin_interfaces(mut this) {
        _utils.trace_enter("Enter register_builtin_interfaces");
        this.register_builtin_interface("IValueType");
        this.register_builtin_interface("IReferenceType");
    }

    fun make_primitive_type(this, name: string) -> mut BoundType {
        _utils.trace_enter("Enter make_primitive_type");
        let t: mut BoundType = new BoundType();
        t.kind = new TypeKind.PrimitiveKind();
        if (name == "string") {
            t.primitive = new PrimitiveType.StringType();
        }
        if (name == "void") {
            t.primitive = new PrimitiveType.VoidType();
        }
        if (name == "i32") {
            t.primitive = new PrimitiveType.I32();
        }
        if (name == "i64") {
            t.primitive = new PrimitiveType.I64();
        }
        if (name == "bool") {
            t.primitive = new PrimitiveType.BoolType();
        }
        return t;
    }

    fun register_builtin_extern_fun(mut this, name: string, param_type_names: _utils.List<string>, ret_type_name: string) {
        _utils.trace_enter("Enter register_builtin_extern_fun");
        let full_name: string = "<global>." + name;
        let sym: mut BoundFunctionSymbol = new BoundFunctionSymbol(name, full_name);
        sym.return_type = this.make_primitive_type(ret_type_name);
        sym.is_extern = true;
        let pi: mut i64 = 0;
        while (pi < cast<i64>(param_type_names.size())) {
            let p_type_name: string = param_type_names.at(cast<u64>(pi)).some;
            let p: mut BoundFunctionParameter = new BoundFunctionParameter("p" + cast<string>(pi), pi, false, false);
            p.bound_type = this.make_primitive_type(p_type_name);
            sym.parameters.push(p);
            pi = pi + 1;
        }
        this.global_scope.add_symbol(new BoundSymbol.function_sym(sym));
    }

    fun register_builtin_functions(mut this) {
        _utils.trace_enter("Enter register_builtin_functions");
        let string_params: mut _utils.List<string> = new _utils.List<string>();
        string_params.push("string");
        this.register_builtin_extern_fun("print", string_params, "void");
        this.register_builtin_extern_fun("println", string_params, "void");
        let no_params: mut _utils.List<string> = new _utils.List<string>();
        this.register_builtin_extern_fun("gc_collect", no_params, "void");
        this.register_builtin_extern_fun("gc_info", no_params, "i64");
    }

    fun register_builtin_interface(mut this, name: string) {
        _utils.trace_enter("Enter register_builtin_interface");
        let full_name: string = "<global>." + name;
        let iface_scope: mut BoundScope = new BoundScope(new ScopeKind.InterfaceScope(), name, full_name, new Option<BoundScope>.some(this.global_scope));
        let type_sym: mut BoundTypeSymbol = new BoundTypeSymbol(name, full_name);
        let t: mut BoundType = new BoundType();
        t.kind = new TypeKind.InterfaceKind();
        let iface_def: mut BoundInterfaceDefinition = new BoundInterfaceDefinition(name, full_name);
        iface_def.scope = new Option<BoundScope>.some(iface_scope);
        t.type_definition = new Option<BoundDefinition>.some(new BoundDefinition.interface_def(iface_def));
        type_sym.bound_type = t;
        iface_def.type_symbol = new Option<BoundTypeSymbol>.some(type_sym);
        iface_def.bound_type = t;
        this.global_scope.add_symbol(new BoundSymbol.type_sym(type_sym));
    }

    // ------------------------------------------------------------------
    // Compile-time meta rewrite (Phase 5a).
    //
    // Resolves top-level (and, via recursion, nested) meta constructs in a
    // definition list into plain definitions BEFORE the 9 parallel-indexed
    // passes run. This keeps unit.definitions[i] <-> result.definitions[i]
    // alignment intact, so all existing passes work unchanged.
    //
    // Currently resolves: #define("K","V") (records a compile-time option and
    //   drops the definition) and #if / #elif / #else (conditional inclusion
    //   of definitions; condition folded by eval_meta_bool). #for / #while and
    //   meta inside function/class/enum bodies pass through unchanged (later
    //   sub-phases 5a.2 / 5a.3 / 5a.4).
    // ------------------------------------------------------------------

    fun meta_has_option(this, key: string) -> bool {
        let i: mut i64 = 0;
        while (i < cast<i64>(this.meta_option_keys.size())) {
            if (this.meta_option_keys.at(cast<u64>(i)).some == key) { return true; }
            i = i + 1;
        }
        return false;
    }

    fun meta_get_option(this, key: string) -> Option<string> {
        let i: mut i64 = 0;
        while (i < cast<i64>(this.meta_option_keys.size())) {
            if (this.meta_option_keys.at(cast<u64>(i)).some == key) {
                return new Option<string>.some(this.meta_option_values.at(cast<u64>(i)).some);
            }
            i = i + 1;
        }
        return new Option<string>.none();
    }

    fun meta_set_option(mut this, key: string, value: string) {
        let i: mut i64 = 0;
        while (i < cast<i64>(this.meta_option_keys.size())) {
            if (this.meta_option_keys.at(cast<u64>(i)).some == key) {
                this.meta_option_values.set(cast<u64>(i), value);
                return;
            }
            i = i + 1;
        }
        this.meta_option_keys.push(key);
        this.meta_option_values.push(value);
    }

    fun meta_strip_quotes(this, quoted: string) -> string {
        if (string_length(quoted) >= 2) {
            return string_substring(quoted, 1, string_length(quoted) - 2);
        }
        return quoted;
    }

    // Fold a compile-time boolean condition for #if. Returns none when the
    // expression is not a constant we can evaluate (caller reports an error
    // and takes no branch). Supports bool literals, #defined("K"), !e,
    // parenthesization, and && / || / == / != of foldable sub-expressions.
    // Fold a compile-time string expression for #if conditions: string literals
    // and #option("K") (the value of a compile-time option). Returns none if the
    // option is undefined or the expression isn't a foldable string.
    fun eval_meta_string(this, expr: Expression) -> Option<string> {
        if (expr is Expression.string_literal) {
            return new Option<string>.some(this.meta_strip_quotes(expr.string_literal.value));
        }
        if (expr is Expression.meta_call) {
            let mc: MetaCallExpression = expr.meta_call;
            if (mc.func_name == "option") {
                if (cast<i64>(mc.arguments.size()) == 1) {
                    let arg: Expression = mc.arguments.at(cast<u64>(0)).some;
                    if (arg is Expression.string_literal) {
                        let key: string = this.meta_strip_quotes(arg.string_literal.value);
                        return this.meta_get_option(key);
                    }
                }
            }
            return new Option<string>.none();
        }
        if (expr is Expression.parenthesized) {
            if (expr.parenthesized.inner.is_some()) {
                return this.eval_meta_string(expr.parenthesized.inner.some);
            }
        }
        return new Option<string>.none();
    }

    fun eval_meta_bool(this, expr: Expression) -> Option<bool> {
        if (expr is Expression.bool_literal) {
            if (expr.bool_literal.value == "true") { return new Option<bool>.some(true); }
            if (expr.bool_literal.value == "false") { return new Option<bool>.some(false); }
            return new Option<bool>.none();
        }
        if (expr is Expression.meta_call) {
            let mc: MetaCallExpression = expr.meta_call;
            if (mc.func_name == "defined") {
                if (cast<i64>(mc.arguments.size()) == 1) {
                    let arg: Expression = mc.arguments.at(cast<u64>(0)).some;
                    if (arg is Expression.string_literal) {
                        let key: string = this.meta_strip_quotes(arg.string_literal.value);
                        return new Option<bool>.some(this.meta_has_option(key));
                    }
                }
            }
            return new Option<bool>.none();
        }
        if (expr is Expression.parenthesized) {
            if (expr.parenthesized.inner.is_some()) {
                return this.eval_meta_bool(expr.parenthesized.inner.some);
            }
            return new Option<bool>.none();
        }
        if (expr is Expression.unary) {
            let u: UnaryExpression = expr.unary;
            if (u.operator_value is UnaryOperator.Not) {
                if (u.operand.is_some()) {
                    let inner: Option<bool> = this.eval_meta_bool(u.operand.some);
                    if (inner.is_some()) {
                        if (inner.some) { return new Option<bool>.some(false); }
                        return new Option<bool>.some(true);
                    }
                }
            }
            return new Option<bool>.none();
        }
        if (expr is Expression.binary) {
            let b: BinaryExpression = expr.binary;
            if (cast<i64>(b.operands.size()) != 2) { return new Option<bool>.none(); }
            let op: BinaryOperator = b.operators.at(cast<u64>(0)).some;
            // String equality first: #option("K") == "literal" (and !=).
            if (op is BinaryOperator.Equal || op is BinaryOperator.NotEqual) {
                let ls: Option<string> = this.eval_meta_string(b.operands.at(cast<u64>(0)).some);
                let rs: Option<string> = this.eval_meta_string(b.operands.at(cast<u64>(1)).some);
                if (let l := ls.some) {
                    if (let r := rs.some) {
                        if (l == r) {
                            if (op is BinaryOperator.Equal) { return new Option<bool>.some(true); }
                            return new Option<bool>.some(false);
                        }
                        if (op is BinaryOperator.Equal) { return new Option<bool>.some(false); }
                        return new Option<bool>.some(true);
                    }
                    return new Option<bool>.none();
                }
            }
            let lhs_opt: Option<bool> = this.eval_meta_bool(b.operands.at(cast<u64>(0)).some);
            let rhs_opt: Option<bool> = this.eval_meta_bool(b.operands.at(cast<u64>(1)).some);
            if (let lhs := lhs_opt.some) {
                if (let rhs := rhs_opt.some) {
                    if (op is BinaryOperator.LogicalAnd) {
                        if (lhs) { if (rhs) { return new Option<bool>.some(true); } }
                        return new Option<bool>.some(false);
                    }
                    if (op is BinaryOperator.LogicalOr) {
                        if (lhs) { return new Option<bool>.some(true); }
                        if (rhs) { return new Option<bool>.some(true); }
                        return new Option<bool>.some(false);
                    }
                    if (op is BinaryOperator.Equal) {
                        if (lhs == rhs) { return new Option<bool>.some(true); }
                        return new Option<bool>.some(false);
                    }
                    if (op is BinaryOperator.NotEqual) {
                        if (lhs == rhs) { return new Option<bool>.some(false); }
                        return new Option<bool>.some(true);
                    }
                }
            }
            return new Option<bool>.none();
        }
        return new Option<bool>.none();
    }

    // If this top-level meta call is #define("K","V"), record the option and
    // return true (consume it). Otherwise return false (keep it as-is).
    fun try_consume_meta_define(mut this, d: MetaCallDefinition) -> bool {
        if (let call := d.call.some) {
            if (call is Expression.meta_call) {
                let mc: MetaCallExpression = call.meta_call;
                if (mc.func_name == "define") {
                    if (cast<i64>(mc.arguments.size()) == 2) {
                        let arg_k: Expression = mc.arguments.at(cast<u64>(0)).some;
                        let arg_v: Expression = mc.arguments.at(cast<u64>(1)).some;
                        if (arg_k is Expression.string_literal) {
                            if (arg_v is Expression.string_literal) {
                                let key: string = this.meta_strip_quotes(arg_k.string_literal.value);
                                let val: string = this.meta_strip_quotes(arg_v.string_literal.value);
                                this.meta_set_option(key, val);
                                return true;
                            }
                        }
                    }
                }
            }
        }
        return false;
    }

    // Resolve a #if definition: fold the condition, splice the taken branch's
    // definitions (recursively resolving nested meta) into `out`.
    fun splice_meta_if(mut this, d: MetaIfDefinition, out: mut _utils.List<Definition>) {
        let picked: mut _utils.List<Definition> = new _utils.List<Definition>();
        let decided: mut bool = false;
        if (let cond := d.condition.some) {
            let c: Option<bool> = this.eval_meta_bool(cond);
            if (let cv := c.some) {
                decided = true;
                if (cv) {
                    for (let def : Definition in d.then_definitions) {
                        picked.push(def);
                    }
                } else {
                    let elif_taken: mut bool = false;
                    for (let br : MetaElifBranch in d.elif_branches) {
                        if (let bc := br.condition.some) {
                            let ec: Option<bool> = this.eval_meta_bool(bc);
                            if (let ecv := ec.some) {
                                if (ecv) {
                                    for (let def : Definition in br.body_definitions) {
                                        picked.push(def);
                                    }
                                    elif_taken = true;
                                    break;
                                }
                            }
                        }
                    }
                    if (!elif_taken) {
                        for (let def : Definition in d.else_definitions) {
                            picked.push(def);
                        }
                    }
                }
            }
        }
        if (!decided) {
            this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta #if condition is not a compile-time constant", d.location);
        }
        this.collect_resolved_definitions(picked, out);
    }

    // Resolve a #while definition: repeatedly evaluate the condition and
    // splice body definitions until the condition becomes false.
    // A safety cap prevents infinite compile-time loops.
    fun splice_meta_while(mut this, d: MetaWhileDefinition, out: mut _utils.List<Definition>) {
        let max_iterations: i64 = 10000;
        let iteration: mut i64 = 0;
        while (iteration < max_iterations) {
            if (let cond := d.condition.some) {
                let c: Option<bool> = this.eval_meta_bool(cond);
                if (let cv := c.some) {
                    if (cv) {
                        // Emit body definitions (resolving nested meta recursively)
                        let body_copy: mut _utils.List<Definition> = new _utils.List<Definition>();
                        for (let def : Definition in d.body) {
                            body_copy.push(def);
                        }
                        this.collect_resolved_definitions(body_copy, out);
                        iteration = iteration + 1;
                    } else {
                        return; // condition false, exit loop
                    }
                } else {
                    this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta #while condition is not a compile-time constant", d.location);
                    return;
                }
            } else {
                return; // no condition
            }
        }
        if (iteration >= max_iterations) {
            this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta #while did not converge (exceeded " + cast<string>(max_iterations) + " iterations)", d.location);
        }
    }

    // Walk `src` definitions; resolve meta constructs, appending plain defs to `out`.
    fun collect_resolved_definitions(mut this, src: _utils.List<Definition>, out: mut _utils.List<Definition>) {
        for (let d : Definition in src) {
            if (d is Definition.meta_call_def) {
                if (!this.try_consume_meta_define(d.meta_call_def)) {
                    if (!this.try_splice_meta_fun_def(d.meta_call_def, out)) {
                        out.push(d);
                    }
                }
            } else if (d is Definition.meta_if_def) {
                this.splice_meta_if(d.meta_if_def, out);
            } else if (d is Definition.meta_while_def) {
                this.splice_meta_while(d.meta_while_def, out);
            } else {
                this.rewrite_meta_in_def_container(d);
                out.push(d);
            }
        }
    }

    // Recurse into container definitions (namespace/class/impl) so def-level
    // meta (#if/#define) nested inside them is resolved too.
    fun rewrite_meta_in_def_container(mut this, d: Definition) {
        if (d is Definition.namespace_def) {
            this.rewrite_meta_definitions(d.namespace_def.children);
        } else if (d is Definition.class_def) {
            this.rewrite_meta_definitions(d.class_def.members);
        } else if (d is Definition.impl_def) {
            this.rewrite_meta_definitions(d.impl_def.functions);
        }
    }

    // Top-level entry: resolve meta constructs in `defs` IN PLACE so downstream
    // parallel-indexed passes see a flattened, meta-free definition list.
    fun rewrite_meta_definitions(mut this, defs: mut _utils.List<Definition>) {
        let resolved: mut _utils.List<Definition> = new _utils.List<Definition>();
        this.collect_resolved_definitions(defs, resolved);
        while (cast<i64>(defs.size()) > 0) { defs.pop(); }
        let k: mut i64 = 0;
        while (k < cast<i64>(resolved.size())) {
            defs.push(resolved.at(cast<u64>(k)).some);
            k = k + 1;
        }
    }

    // Phase 5c: recursively register every #fun (MetaFunctionDefinition) into
    // meta_function_defs before the 5a meta rewrite, so definition-position
    // #fun calls can be JIT-spliced in collect_resolved_definitions. Builds a
    // BoundMetaFunctionDefinition carrying only what compile_meta_function needs
    // (name/parameters/return_type/body/location); pass_build_scopes registers
    // them again later (duplicates harmless — find_meta_function returns first,
    // JIT compile cached by name).
    fun collect_meta_function_defs(mut this, defs: _utils.List<Definition>) {
        for (let d : Definition in defs) {
            if (d is Definition.meta_function_def) {
                let mfd: MetaFunctionDefinition = d.meta_function_def;
                if (this.find_meta_function(mfd.name).is_none()) {
                    let bmf: mut BoundMetaFunctionDefinition = new BoundMetaFunctionDefinition(mfd.name, mfd.name);
                    for (let p : MetaParameter in mfd.parameters) {
                        bmf.parameters.push(p);
                    }
                    bmf.return_type = mfd.return_type;
                    bmf.body = mfd.body;
                    bmf.location = mfd.location;
                    this.meta_function_defs.push(bmf);
                }
            } else if (d is Definition.namespace_def) {
                this.collect_meta_function_defs(d.namespace_def.children);
            } else if (d is Definition.class_def) {
                this.collect_meta_function_defs(d.class_def.members);
            } else if (d is Definition.impl_def) {
                this.collect_meta_function_defs(d.impl_def.functions);
            }
        }
    }

    // Phase 6 v2: collect `#class` definitions (meta-only data structures) from
    // unit A so they can be fed into unit B as a <meta_classes> source input.
    // Recurses into namespace/class/impl exactly like collect_meta_function_defs.
    fun collect_meta_class_defs(mut this, defs: _utils.List<Definition>) {
        for (let d : Definition in defs) {
            if (d is Definition.meta_class_def) {
                this.meta_class_defs.push(d.meta_class_def);
            } else if (d is Definition.namespace_def) {
                this.collect_meta_class_defs(d.namespace_def.children);
            } else if (d is Definition.class_def) {
                this.collect_meta_class_defs(d.class_def.members);
            } else if (d is Definition.impl_def) {
                this.collect_meta_class_defs(d.impl_def.functions);
            }
        }
    }
    // After def-level meta is flattened (rewrite_meta_definitions), walk every
    // function/initial body and resolve statement-level meta: #if conditional
    // inclusion of statements and #define option sets. Recurses into namespaces
    // and into nested regular control-flow blocks (if/while/for/{...}) so meta
    // works anywhere inside a function body. Statement-level #for/#while
    // unrolling (needs loop-variable AST substitution) is a follow-up.
    // ------------------------------------------------------------------

    fun rewrite_meta_in_function_bodies(mut this, defs: _utils.List<Definition>) {
        for (let d : Definition in defs) {
            if (d is Definition.function_def) {
                this.rewrite_meta_in_body_expr(d.function_def.body);
            } else if (d is Definition.initial_routine) {
                this.rewrite_meta_in_body_expr(d.initial_routine.body);
            } else if (d is Definition.namespace_def) {
                this.rewrite_meta_in_function_bodies(d.namespace_def.children);
            } else if (d is Definition.class_def) {
                this.rewrite_meta_in_function_bodies(d.class_def.members);
            } else if (d is Definition.impl_def) {
                this.rewrite_meta_in_function_bodies(d.impl_def.functions);
            }
        }
    }

    fun rewrite_meta_in_body_expr(mut this, body: Option<Expression>) {
        if (let body_expr := body.some) {
            if (body_expr is Expression.code_block) {
                this.rewrite_meta_statements_inplace(body_expr.code_block.statements);
            }
        }
    }

    // Resolve meta constructs in a statement list, replacing its contents in
    // place (empties via pop, then repushes resolved).
    fun rewrite_meta_statements_inplace(mut this, stmts: mut _utils.List<Statement>) {
        let resolved: mut _utils.List<Statement> = new _utils.List<Statement>();
        this.collect_resolved_statements(stmts, resolved);
        while (cast<i64>(stmts.size()) > 0) { stmts.pop(); }
        let k: mut i64 = 0;
        while (k < cast<i64>(resolved.size())) {
            stmts.push(resolved.at(cast<u64>(k)).some);
            k = k + 1;
        }
    }

    fun collect_resolved_statements(mut this, src: _utils.List<Statement>, out: mut _utils.List<Statement>) {
        let i: mut i64 = 0;
        while (i < cast<i64>(src.size())) {
            let s: Statement = src.at(cast<u64>(i)).some;
            if (s is Statement.meta_if_stmt) {
                this.splice_meta_if_stmt(s.meta_if_stmt, out);
            } else if (s is Statement.meta_while_stmt) {
                this.splice_meta_while_stmt(s.meta_while_stmt, out);
            } else if (this.try_consume_meta_define_stmt(s)) {
                // consumed #define("K","V"); statement -> drop
            } else {
                out.push(this.rewrite_one_statement(s));
            }
            i = i + 1;
        }
    }

    // If this statement is #define("K","V"); (a meta-call-as-statement), record
    // the option and return true (consume). Otherwise return false.
    fun try_consume_meta_define_stmt(mut this, s: Statement) -> bool {
        if (s is Statement.expression) {
            if (let inner := s.expression.expression.some) {
                if (inner is Expression.meta_call) {
                    let mc: MetaCallExpression = inner.meta_call;
                    if (mc.func_name == "define") {
                        if (cast<i64>(mc.arguments.size()) == 2) {
                            let arg_k: Expression = mc.arguments.at(cast<u64>(0)).some;
                            let arg_v: Expression = mc.arguments.at(cast<u64>(1)).some;
                            if (arg_k is Expression.string_literal) {
                                if (arg_v is Expression.string_literal) {
                                    let key: string = this.meta_strip_quotes(arg_k.string_literal.value);
                                    let val: string = this.meta_strip_quotes(arg_v.string_literal.value);
                                    this.meta_set_option(key, val);
                                    return true;
                                }
                            }
                        }
                    }
                }
            }
        }
        return false;
    }

    // Resolve a #while statement: repeatedly evaluate the condition and
    // splice body statements until the condition becomes false.
    // A safety cap prevents infinite compile-time loops.
    fun splice_meta_while_stmt(mut this, s: MetaWhileStatement, out: mut _utils.List<Statement>) {
        let max_iterations: i64 = 10000;
        let iteration: mut i64 = 0;
        while (iteration < max_iterations) {
            if (let cond := s.condition.some) {
                let c: Option<bool> = this.eval_meta_bool(cond);
                if (let cv := c.some) {
                    if (cv) {
                        if (s.body.is_some()) {
                            this.flatten_statement_into(s.body.some, out);
                        }
                        iteration = iteration + 1;
                    } else {
                        return; // condition false, exit loop
                    }
                } else {
                    this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta #while condition is not a compile-time constant", s.location);
                    return;
                }
            } else {
                return; // no condition
            }
        }
        if (iteration >= max_iterations) {
            this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta #while did not converge (exceeded " + cast<string>(max_iterations) + " iterations)", s.location);
        }
    }

    // Resolve a #if statement: fold the condition, splice the taken branch's
    // statements (flattening a braced block; recursively resolving nested meta).
    fun splice_meta_if_stmt(mut this, s: MetaIfStatement, out: mut _utils.List<Statement>) {
        let picked: mut Option<Statement> = new Option<Statement>.none();
        let decided: mut bool = false;
        if (let cond := s.condition.some) {
            let c: Option<bool> = this.eval_meta_bool(cond);
            if (let cv := c.some) {
                decided = true;
                if (cv) {
                    picked = s.then_statement;
                } else {
                    let elif_taken: mut bool = false;
                    for (let br : MetaElifBranch in s.elif_branches) {
                        if (let bc := br.condition.some) {
                            let ec: Option<bool> = this.eval_meta_bool(bc);
                            if (let ecv := ec.some) {
                                if (ecv) {
                                    picked = br.body_statement;
                                    elif_taken = true;
                                    break;
                                }
                            }
                        }
                    }
                    if (!elif_taken) {
                        picked = s.else_statement;
                    }
                }
            }
        }
        if (!decided) {
            this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta #if condition is not a compile-time constant", s.location);
        }
        if (picked.is_some()) {
            this.flatten_statement_into(picked.some, out);
        }
    }

    // Append `stmt` to `out`. If it wraps a braced code block, flatten the
    // block's statements (recursively resolved); otherwise rewrite+push as one.
    fun flatten_statement_into(mut this, stmt: Statement, out: mut _utils.List<Statement>) {
        let blk_opt: Option<_utils.List<Statement>> = this.stmt_inner_code_block(stmt);
        if (blk_opt.is_some()) {
            this.collect_resolved_statements(blk_opt.some, out);
            return;
        }
        out.push(this.rewrite_one_statement(stmt));
    }

    // If `stmt` wraps a code_block (Statement.block_expr, or Statement.expression
    // wrapping an ExpressionStatement(code_block)), return its statements list.
    fun stmt_inner_code_block(this, stmt: Statement) -> Option<_utils.List<Statement>> {
        if (stmt is Statement.block_expr) {
            if (let inner := stmt.block_expr.expression.some) {
                if (inner is Expression.code_block) {
                    return new Option<_utils.List<Statement>>.some(inner.code_block.statements);
                }
            }
        }
        if (stmt is Statement.expression) {
            if (let inner := stmt.expression.expression.some) {
                if (inner is Expression.code_block) {
                    return new Option<_utils.List<Statement>>.some(inner.code_block.statements);
                }
            }
        }
        return new Option<_utils.List<Statement>>.none();
    }

    // Recurse into a kept (non-meta) statement's nested control-flow bodies so
    // meta inside regular if/while/for/{...} is resolved. Returns the same
    // statement object (sub-contents mutated in place).
    fun rewrite_one_statement(mut this, stmt: Statement) -> Statement {
        if (stmt is Statement.if_stmt) {
            if (let then := stmt.if_stmt.then_statement.some) {
                this.rewrite_meta_in_substatement(then);
            }
            if (let el := stmt.if_stmt.else_statement.some) {
                this.rewrite_meta_in_substatement(el);
            }
            return stmt;
        }
        if (stmt is Statement.while_stmt) {
            if (let body := stmt.while_stmt.body.some) {
                this.rewrite_meta_in_substatement(body);
            }
            return stmt;
        }
        if (stmt is Statement.for_stmt) {
            if (let body := stmt.for_stmt.body.some) {
                this.rewrite_meta_in_substatement(body);
            }
            return stmt;
        }
        let blk_opt: Option<_utils.List<Statement>> = this.stmt_inner_code_block(stmt);
        if (let blk := blk_opt.some) {
            this.rewrite_meta_statements_inplace(blk);
        }
        return stmt;
    }

    // Rewrite meta inside a single sub-statement (the body/then/else of regular
    // control flow): if it wraps a code block, resolve that block in place.
    fun rewrite_meta_in_substatement(mut this, stmt: Statement) {
        let blk_opt: Option<_utils.List<Statement>> = this.stmt_inner_code_block(stmt);
        if (let blk := blk_opt.some) {
            this.rewrite_meta_statements_inplace(blk);
        }
    }

    fun bind(mut this, unit: CompilationUnit, location: SourceLocation) -> BoundCompilationUnit {
        _utils.trace_enter("Enter bind");
        let result: mut BoundCompilationUnit = new BoundCompilationUnit(location);
        result.type_registry = this.type_registry;
        result.global_scope = this.global_scope;
        this.ast_definitions = unit.definitions;
        // Phase 5c: pre-register all #fun meta functions (recursively) and seed
        // the JIT engine BEFORE the 5a meta rewrite, so that definition-position
        // #fun calls can be JIT-spliced during rewrite_meta_definitions. (JIT is
        // only actually reached in native pass2+; pass_build_scopes re-registers
        // #funs later — duplicates are harmless, JIT compile is cached by name.)
        this.collect_meta_function_defs(unit.definitions);
        this.collect_meta_class_defs(unit.definitions);
        this.seed_meta_engine();
        // Phase 5a: flatten compile-time meta (#define / #if / ...) into plain
        // definitions before any pass runs. Done in place on unit.definitions so
        // every downstream parallel-indexed pass stays aligned.
        this.rewrite_meta_definitions(unit.definitions);
        // Phase 5a.3: resolve statement-level meta inside function/initial bodies.
        this.rewrite_meta_in_function_bodies(unit.definitions);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 1/9: Building scopes..."); }
        this.pass_build_scopes(unit, result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 2/9: Resolving types..."); }
        this.pass_resolve_types(unit, result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 3/9: Monomorphizing generics..."); }
        this.pass_monomorphize(unit, result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 4/9: Binding symbols..."); }
        this.pass_bind_symbols(result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 5/9: Generating constructors..."); }
        this.pass_constructors(result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 6/9: Building interface vtables..."); }
        this.pass_interface_implementation(unit, result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 7/9: Classifying value types..."); }
        this.pass_classify_value_types(result);
        this.pass_validate_interface_usage(result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 8/9: Binding expressions..."); }
        this.pass_bind_expressions(unit, result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Pass 9/9: Validating control flow..."); }
        this.pass_validate_control_flow(result);
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Semantic] Done: " + cast<string>(result.definitions.size()) + " definitions, " + cast<string>(this.errors.size()) + " errors"); }
        result.errors = this.errors;
        return result;
    }

    fun pass_build_scopes(mut this, unit: CompilationUnit, result: BoundCompilationUnit) {
        _utils.trace_enter("Enter pass_build_scopes");
        for (let def : Definition in unit.definitions) {
            let bound: Option<BoundDefinition> = this.bind_definition(def, result.global_scope);
            if (let b := bound.some) {
                result.definitions.push(b);
            }
        }
    }

    fun bind_definition(mut this, def: Definition, scope: mut BoundScope) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter bind_definition");
        if (def is Definition.function_def) {
            return this.bind_function_def(def.function_def, scope);
        }
        if (def is Definition.class_def) {
            return this.bind_class_def(def.class_def, scope);
        }
        if (def is Definition.enum_def) {
            return this.bind_enum_def(def.enum_def, scope);
        }
        if (def is Definition.interface_def) {
            return this.bind_interface_def(def.interface_def, scope);
        }
        if (def is Definition.namespace_def) {
            return this.bind_namespace_def(def.namespace_def, scope);
        }
        if (def is Definition.initial_routine) {
            return this.bind_initial_routine(def.initial_routine, scope);
        }
        if (def is Definition.impl_def) {
            return this.bind_impl_def(def.impl_def, scope);
        }
        if (def is Definition.impl_for_def) {
            return this.bind_impl_for_def(def.impl_for_def, scope);
        }
        if (def is Definition.type_ref_def) {
            return this.bind_type_ref_def(def.type_ref_def, scope);
        }
        if (def is Definition.global_var) {
            return this.bind_global_var_def(def.global_var, scope);
        }
        if (def is Definition.meta_function_def) {
            return this.bind_meta_function_def(def.meta_function_def, scope);
        }
        if (def is Definition.meta_class_def) {
            // Phase 6 v2: `#class` is meta-only — collected into unit B by
            // collect_meta_class_defs (so #funs can use it); not emitted to runtime.
            // Bind a placeholder slot (reusing the meta_function_def bound variant,
            // which IRGenerator/LLVMEmitter skip) so pass_bind_expressions's parallel
            // unit.definitions[i] <-> result.definitions[i] iteration stays aligned.
            let placeholder: mut BoundMetaFunctionDefinition = new BoundMetaFunctionDefinition(def.meta_class_def.name, def.meta_class_def.name);
            return new Option<BoundDefinition>.some(new BoundDefinition.meta_function_def(placeholder));
        }
        if (def is Definition.meta_if_def) {
            let r: mut BoundMetaIfDefinition = new BoundMetaIfDefinition(new Option<Definition>.some(new Definition.meta_if_def(def.meta_if_def)), def.meta_if_def.location);
            return new Option<BoundDefinition>.some(new BoundDefinition.meta_if_def(r));
        }
        if (def is Definition.meta_for_def) {
            let r: mut BoundMetaForDefinition = new BoundMetaForDefinition(new Option<Definition>.some(new Definition.meta_for_def(def.meta_for_def)), def.meta_for_def.location);
            return new Option<BoundDefinition>.some(new BoundDefinition.meta_for_def(r));
        }
        if (def is Definition.meta_while_def) {
            let r: mut BoundMetaWhileDefinition = new BoundMetaWhileDefinition(new Option<Definition>.some(new Definition.meta_while_def(def.meta_while_def)), def.meta_while_def.location);
            return new Option<BoundDefinition>.some(new BoundDefinition.meta_while_def(r));
        }
        if (def is Definition.meta_call_def) {
            if (def.meta_call_def.call.is_some()) {
                let r: mut BoundMetaCallDefinition = new BoundMetaCallDefinition(this.bind_expression(def.meta_call_def.call.some, scope), def.meta_call_def.location);
                return new Option<BoundDefinition>.some(new BoundDefinition.meta_call_def(r));
            }
            let r: mut BoundMetaCallDefinition = new BoundMetaCallDefinition(new Option<BoundExpression>.none(), def.meta_call_def.location);
            return new Option<BoundDefinition>.some(new BoundDefinition.meta_call_def(r));
        }
        return new Option<BoundDefinition>.none();
    }

    fun extract_template_params(this, template_decl: Option<TemplateDeclaration>, generic_params: mut _utils.List<string>) {
        _utils.trace_enter("Enter extract_template_params");
        if (let td := template_decl.some) {
            let j: mut i64 = 0;
            while (j < cast<i64>(td.parameters.size())) {
                let param: TemplateParameter = td.parameters.at(cast<u64>(j)).some;
                generic_params.push(param.name);
                j = j + 1;
            }
        }
    }

    // req5: collect the names of non-type (value) template params (e.g. N in
    // #template<N:i32> class A) so specialization can substitute them -> constants.
    fun extract_value_param_names(this, template_decl: Option<TemplateDeclaration>, names: mut _utils.List<string>) {
        if (let td := template_decl.some) {
            let j: mut i64 = 0;
            while (j < cast<i64>(td.parameters.size())) {
                let param: TemplateParameter = td.parameters.at(cast<u64>(j)).some;
                if (param.is_value_param) {
                    names.push(param.name);
                }
                j = j + 1;
            }
        }
    }

    fun bind_function_def(mut this, def: FunctionDefinition, scope: mut BoundScope) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter bind_function_def");
        let full_name: string = scope.full_name + "." + def.name;
        let result: mut BoundFunctionDefinition = new BoundFunctionDefinition(def.name, full_name, def.is_extern, def.is_pure, def.is_new, def.is_extern);
        this.extract_template_params(def.template_decl, result.generic_params);
        if (!def.is_extern && def.body.is_some()) {
            let func_scope: mut BoundScope = new BoundScope(new ScopeKind.FunctionScope(), def.name, full_name + ".<body>", new Option<BoundScope>.some(scope));
            result.scope = new Option<BoundScope>.some(func_scope);
            // Register generic type params in function scope so parameter/return types
            // can resolve them (mirrors bind_class_def). Without this, resolving a
            // type like `T` inside `#template(T: type) fun identity(x: T) -> T` fails.
            if (cast<i64>(result.generic_params.size()) > 0) {
                let gi: mut i64 = 0;
                while (gi < cast<i64>(result.generic_params.size())) {
                    let param_name: string = result.generic_params.at(cast<u64>(gi)).some;
                    let param_sym: mut BoundTypeSymbol = new BoundTypeSymbol(param_name, full_name + "." + param_name);
                    let pt: mut BoundType = new BoundType();
                    pt.kind = new TypeKind.ClassKind();
                    let dummy_def: mut BoundClassDefinition = new BoundClassDefinition(param_name, full_name + "." + param_name);
                    pt.type_definition = new Option<BoundDefinition>.some(new BoundDefinition.class_def(dummy_def));
                    param_sym.bound_type = pt;
                    func_scope.add_symbol(new BoundSymbol.type_sym(param_sym));
                    gi = gi + 1;
                }
            }
        }
        let sym: mut BoundFunctionSymbol = new BoundFunctionSymbol(def.name, full_name);
        sym.is_extern = def.is_extern;
        sym.is_static = result.is_static;
        sym.is_pure = def.is_pure;
        sym.is_new = def.is_new;
        sym.location = def.location;
        result.symbol = new Option<BoundFunctionSymbol>.some(sym);
        if (cast<i64>(result.generic_params.size()) > 0) {
            result.is_generic_template = true;
        }
        scope.add_symbol(new BoundSymbol.function_sym(sym));
        return new Option<BoundDefinition>.some(new BoundDefinition.function_def(result));
    }

    fun bind_meta_function_def(mut this, def: MetaFunctionDefinition, scope: mut BoundScope) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter bind_meta_function_def");
        let full_name: string = scope.full_name + "." + def.name;
        let result: mut BoundMetaFunctionDefinition = new BoundMetaFunctionDefinition(def.name, full_name);
        let pi: mut i64 = 0;
        while (pi < cast<i64>(def.parameters.size())) {
            result.parameters.push(def.parameters.at(cast<u64>(pi)).some);
            pi = pi + 1;
        }
        result.return_type = def.return_type;
        result.body = def.body;
        result.location = def.location;
        let sym: mut BoundFunctionSymbol = new BoundFunctionSymbol(def.name, full_name);
        sym.is_meta = true;
        sym.location = def.location;
        result.symbol = new Option<BoundFunctionSymbol>.some(sym);
        scope.add_symbol(new BoundSymbol.function_sym(sym));
        this.meta_function_defs.push(result);
        return new Option<BoundDefinition>.some(new BoundDefinition.meta_function_def(result));
    }

    fun bind_class_def(mut this, def: ClassDefinition, scope: mut BoundScope) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter bind_class_def");
        let full_name: string = scope.full_name + "." + def.name;
        let result: mut BoundClassDefinition = new BoundClassDefinition(def.name, full_name);
        this.extract_template_params(def.template_decl, result.generic_params);
        // req5: record value (non-type) template param names for specialization substitution.
        this.extract_value_param_names(def.template_decl, result.value_param_names);
        if (cast<i64>(result.generic_params.size()) > 0) {
            result.is_generic_template = true;
        }
        let class_scope: mut BoundScope = new BoundScope(new ScopeKind.ClassScope(), def.name, full_name, new Option<BoundScope>.some(scope));
        result.scope = new Option<BoundScope>.some(class_scope);
        let type_sym: mut BoundTypeSymbol = new BoundTypeSymbol(def.name, full_name);
        this.extract_template_params(def.template_decl, type_sym.generic_params);
        type_sym.location = def.location;
        let t: mut BoundType = new BoundType();
        t.kind = new TypeKind.ClassKind();
        t.type_definition = new Option<BoundDefinition>.some(new BoundDefinition.class_def(result));
        type_sym.bound_type = t;
        result.type_symbol = new Option<BoundTypeSymbol>.some(type_sym);
        result.bound_type = t;
        scope.add_symbol(new BoundSymbol.type_sym(type_sym));
        // Register generic type params in class scope so field/method types
        // can resolve them (mirrors bind_enum_def). Without this, resolving a
        // field like `Option<T>` inside `#template(T: type) class List` fails
        // to find `T`, producing spurious E_RESOLVE_TYPE errors.
        if (cast<i64>(result.generic_params.size()) > 0) {
            let gi: mut i64 = 0;
            while (gi < cast<i64>(result.generic_params.size())) {
                let param_name: string = result.generic_params.at(cast<u64>(gi)).some;
                let param_sym: mut BoundTypeSymbol = new BoundTypeSymbol(param_name, full_name + "." + param_name);
                let pt: mut BoundType = new BoundType();
                pt.kind = new TypeKind.ClassKind();
                let dummy_def: mut BoundClassDefinition = new BoundClassDefinition(param_name, full_name + "." + param_name);
                pt.type_definition = new Option<BoundDefinition>.some(new BoundDefinition.class_def(dummy_def));
                param_sym.bound_type = pt;
                class_scope.add_symbol(new BoundSymbol.type_sym(param_sym));
                gi = gi + 1;
            }
        }
        for (let member : Definition in def.members) {
            if (member is Definition.class_field) {
                let ast_field: ClassFieldDefinition = member.class_field;
                let field: mut BoundClassFieldDefinition = new BoundClassFieldDefinition(ast_field.name);
                let field_full_name: string = full_name + "." + ast_field.name;
                let fsym: mut BoundVariableSymbol = new BoundVariableSymbol();
                fsym.name = ast_field.name;
                fsym.full_name = field_full_name;
                fsym.variable_kind = new VariableSymbolKind.Field();
                fsym.location = ast_field.location;
                // Read mutability from AST type_spec
                if (let ts := ast_field.type_spec.some) {
                    if (ts.is_not_mutable) {
                        fsym.is_mutable = false;
                        field.mutability = new Mutability.Immutable();
                    } else if (ts.is_mutable) {
                        // Explicit 'mut': field is always mutable
                        fsym.is_mutable = true;
                        field.mutability = new Mutability.Mutable();
                    } else if (ts.is_auto_mutability) {
                        fsym.is_mutable = true;
                        field.mutability = new Mutability.Auto();
                    } else {
                        // Default: aligns with container (Auto)
                        fsym.is_mutable = true;
                        field.mutability = new Mutability.Auto();
                    }
                } else {
                    // No type spec: default aligns with container
                    fsym.is_mutable = true;
                    field.mutability = new Mutability.Auto();
                }
                fsym.enclosing_scope = new Option<BoundScope>.some(class_scope);
                field.field_symbol = new Option<BoundVariableSymbol>.some(fsym);
                class_scope.add_symbol(new BoundSymbol.variable(fsym));
                result.fields.push(new BoundDefinition.class_field(field));
            }
            if (member is Definition.function_def) {
                let bound_member: Option<BoundDefinition> = this.bind_function_def(member.function_def, class_scope);
                if (let bm := bound_member.some) {
                    result.methods.push(bm);
                }
            }
            if (member is Definition.impl_def) {
                let bound_impl: Option<BoundDefinition> = this.bind_impl_def(member.impl_def, class_scope);
                if (let bi := bound_impl.some) {
                    result.interface_impls.push(bi);
                }
            }
        }
        result.ast_source = new Option<Definition>.some(new Definition.class_def(def));
        return new Option<BoundDefinition>.some(new BoundDefinition.class_def(result));
    }

    fun bind_enum_def(mut this, def: EnumDefinition, scope: mut BoundScope) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter bind_enum_def");
        let full_name: string = scope.full_name + "." + def.name;
        let result: mut BoundEnumDefinition = new BoundEnumDefinition(def.name, full_name);
        this.extract_template_params(def.template_decl, result.generic_params);
        let enum_scope: mut BoundScope = new BoundScope(new ScopeKind.EnumScope(), def.name, full_name, new Option<BoundScope>.some(scope));
        result.scope = new Option<BoundScope>.some(enum_scope);
        let type_sym: mut BoundTypeSymbol = new BoundTypeSymbol(def.name, full_name);
        this.extract_template_params(def.template_decl, type_sym.generic_params);
        type_sym.location = def.location;
        let t: mut BoundType = new BoundType();
        t.kind = new TypeKind.EnumKind();
        t.type_definition = new Option<BoundDefinition>.some(new BoundDefinition.enum_def(result));
        type_sym.bound_type = t;
        result.type_symbol = new Option<BoundTypeSymbol>.some(type_sym);
        result.bound_type = t;
        scope.add_symbol(new BoundSymbol.type_sym(type_sym));
        // Register generic type params in enum scope so payload types can resolve them
        if (cast<i64>(result.generic_params.size()) > 0) {
            let gi: mut i64 = 0;
            while (gi < cast<i64>(result.generic_params.size())) {
                let param_name: string = result.generic_params.at(cast<u64>(gi)).some;
                let param_sym: mut BoundTypeSymbol = new BoundTypeSymbol(param_name, full_name + "." + param_name);
                let pt: mut BoundType = new BoundType();
                pt.kind = new TypeKind.ClassKind();
                let dummy_def: mut BoundClassDefinition = new BoundClassDefinition(param_name, full_name + "." + param_name);
                pt.type_definition = new Option<BoundDefinition>.some(new BoundDefinition.class_def(dummy_def));
                param_sym.bound_type = pt;
                enum_scope.add_symbol(new BoundSymbol.type_sym(param_sym));
                gi = gi + 1;
            }
        }
        let member_idx: mut i64 = 0;
        for (let member : Definition in def.members) {
            if (member is Definition.enum_member) {
                // Defer payload type resolution to pass 2 (resolve_enum_types)
                // so that forward-referenced types (e.g. class A defined after
                // enum B { a: A }) are available in scope.
                let payload_type: mut BoundType = this.type_registry.void_type;
                let m: mut BoundEnumMemberDefinition = new BoundEnumMemberDefinition(member.enum_member.name, member_idx, payload_type);
                let msym: mut BoundEnumMemberSymbol = new BoundEnumMemberSymbol(member.enum_member.name, full_name + "." + member.enum_member.name, t, member_idx, payload_type);
                m.member_symbol = new Option<BoundEnumMemberSymbol>.some(msym);
                enum_scope.add_symbol(new BoundSymbol.enum_member(msym));
                result.members.push(m);
                member_idx = member_idx + 1;
            }
            if (member is Definition.impl_def) {
                let bound_impl: Option<BoundDefinition> = this.bind_impl_def(member.impl_def, enum_scope);
                if (bound_impl.is_some()) {
                    result.interface_impls.push(bound_impl.some);
                }
            }
            if (member is Definition.function_def) {
                let bound_method: Option<BoundDefinition> = this.bind_function_def(member.function_def, enum_scope);
                if (let bm := bound_method.some) {
                    result.methods.push(bm);
                }
            }
        }
        result.ast_source = new Option<Definition>.some(new Definition.enum_def(def));
        return new Option<BoundDefinition>.some(new BoundDefinition.enum_def(result));
    }

    fun bind_interface_def(mut this, def: InterfaceDefinition, scope: mut BoundScope) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter bind_interface_def");
        let full_name: string = scope.full_name + "." + def.name;
        let result: mut BoundInterfaceDefinition = new BoundInterfaceDefinition(def.name, full_name);
        this.extract_template_params(def.template_decl, result.generic_params);
        let iface_scope: mut BoundScope = new BoundScope(new ScopeKind.InterfaceScope(), def.name, full_name, new Option<BoundScope>.some(scope));
        result.scope = new Option<BoundScope>.some(iface_scope);
        let type_sym: mut BoundTypeSymbol = new BoundTypeSymbol(def.name, full_name);
        this.extract_template_params(def.template_decl, type_sym.generic_params);
        type_sym.location = def.location;
        let t: mut BoundType = new BoundType();
        t.kind = new TypeKind.InterfaceKind();
        t.type_definition = new Option<BoundDefinition>.some(new BoundDefinition.interface_def(result));
        type_sym.bound_type = t;
        result.type_symbol = new Option<BoundTypeSymbol>.some(type_sym);
        result.bound_type = t;
        scope.add_symbol(new BoundSymbol.type_sym(type_sym));
        // Register generic type params in interface scope so method signatures
        // can resolve them (mirrors bind_class_def / bind_enum_def). Without
        // this, `extern fun copy(this: T) -> T` inside `ICopy<T>` fails to
        // resolve `T`, producing spurious E_RESOLVE_TYPE errors.
        if (cast<i64>(result.generic_params.size()) > 0) {
            let gi: mut i64 = 0;
            while (gi < cast<i64>(result.generic_params.size())) {
                let param_name: string = result.generic_params.at(cast<u64>(gi)).some;
                let param_sym: mut BoundTypeSymbol = new BoundTypeSymbol(param_name, full_name + "." + param_name);
                let pt: mut BoundType = new BoundType();
                pt.kind = new TypeKind.ClassKind();
                let dummy_def: mut BoundClassDefinition = new BoundClassDefinition(param_name, full_name + "." + param_name);
                pt.type_definition = new Option<BoundDefinition>.some(new BoundDefinition.class_def(dummy_def));
                param_sym.bound_type = pt;
                iface_scope.add_symbol(new BoundSymbol.type_sym(param_sym));
                gi = gi + 1;
            }
        }
        for (let member : Definition in def.members) {
            if (member is Definition.function_def) {
                let bound_member: Option<BoundDefinition> = this.bind_function_def(member.function_def, iface_scope);
                if (let bm := bound_member.some) {
                    result.methods.push(bm);
                }
            }
            if (member is Definition.impl_def) {
                // Nested `impl IOther<T> { ... }` (interface inheritance): bind the
                // impl's methods in this interface's scope so they can be emitted and
                // referenced by the interface's own vtables.
                let bound_impl: Option<BoundDefinition> = this.bind_impl_def(member.impl_def, iface_scope);
                if (let bi := bound_impl.some) {
                    result.interface_impls.push(bi);
                }
            }
        }
        result.ast_source = new Option<Definition>.some(new Definition.interface_def(def));
        return new Option<BoundDefinition>.some(new BoundDefinition.interface_def(result));
    }

    fun bind_namespace_def(mut this, def: NamespaceDefinition, scope: mut BoundScope) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter bind_namespace_def");
        let ns_scope: mut BoundScope = scope.add_or_merge_namespace(def.name);
        let result: mut BoundNamespaceDefinition = new BoundNamespaceDefinition(def.name, ns_scope.full_name);
        result.scope = new Option<BoundScope>.some(ns_scope);
        if (!ns_scope.lookup_symbol_local(def.name).is_some()) {
            let ns_sym: BoundNamespaceSymbol = new BoundNamespaceSymbol(def.name, ns_scope.full_name, new Option<BoundScope>.some(ns_scope));
            scope.add_symbol(new BoundSymbol.namespace_sym(ns_sym));
        }
        let i: mut i64 = 0;
        while (i < cast<i64>(def.children.size())) {
            let child: Definition = def.children.at(cast<u64>(i)).some;
            let bound: Option<BoundDefinition> = this.bind_definition(child, ns_scope);
            if (bound.is_some()) {
                result.children.push(bound.some);
            }
            i = i + 1;
        }
        return new Option<BoundDefinition>.some(new BoundDefinition.namespace_def(result));
    }

    fun bind_initial_routine(mut this, def: InitialRoutineDefinition, scope: mut BoundScope) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter bind_initial_routine");
        let count: i64 = scope.init_routine_count;
        scope.init_routine_count = count + 1;
        let full_name: string = scope.full_name + ".<initial>" + cast<string>(count);
        let result: mut BoundInitialRoutineDefinition = new BoundInitialRoutineDefinition(full_name);
        let init_scope: mut BoundScope = new BoundScope(new ScopeKind.InitialRoutineScope(), "<initial>", full_name + ".<body>", new Option<BoundScope>.some(scope));
        result.scope = new Option<BoundScope>.some(init_scope);
        let sym: mut BoundFunctionSymbol = new BoundFunctionSymbol("<initial>", full_name);
        sym.location = def.location;
        result.symbol = new Option<BoundFunctionSymbol>.some(sym);
        scope.add_symbol(new BoundSymbol.function_sym(sym));
        return new Option<BoundDefinition>.some(new BoundDefinition.initial_routine(result));
    }

    fun bind_impl_def(mut this, def: InterfaceImplementation, scope: mut BoundScope) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter bind_impl_def");
        let result: mut BoundInterfaceImplementation = new BoundInterfaceImplementation();
        // Resolve the implemented interface type (with generic args, e.g.
        // IFoo<u8>) so downstream passes (monomorphization collection, etc.)
        // can see which generic interfaces a class instantiates.
        if (def.type_spec.is_some()) {
            result.interface_type = this.resolve_type_specifier(def.type_spec.some, scope);
        }
        let i: mut i64 = 0;
        while (i < cast<i64>(def.functions.size())) {
            let func: Definition = def.functions.at(cast<u64>(i)).some;
            if (func is Definition.function_def) {
                let bound: Option<BoundDefinition> = this.bind_function_def(func.function_def, scope);
                if (bound.is_some()) {
                    result.methods.push(bound.some);
                }
            }
            i = i + 1;
        }
        return new Option<BoundDefinition>.some(new BoundDefinition.impl_def(result));
    }

    fun bind_impl_for_def(mut this, def: InterfaceForImplementation, scope: mut BoundScope) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter bind_impl_for_def");
        let result: mut BoundInterfaceForImplementation = new BoundInterfaceForImplementation();
        let i: mut i64 = 0;
        while (i < cast<i64>(def.functions.size())) {
            let func: Definition = def.functions.at(cast<u64>(i)).some;
            if (func is Definition.function_def) {
                let bound: Option<BoundDefinition> = this.bind_function_def(func.function_def, scope);
                if (bound.is_some()) {
                    result.methods.push(bound.some);
                }
            }
            i = i + 1;
        }
        return new Option<BoundDefinition>.some(new BoundDefinition.impl_for_def(result));
    }

    fun bind_type_ref_def(mut this, def: TypeReferenceDefinition, scope: mut BoundScope) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter bind_type_ref_def");
        let result: mut BoundTypeReferenceDefinition = new BoundTypeReferenceDefinition(def.name);
        let type_sym: mut BoundTypeSymbol = new BoundTypeSymbol(def.name, scope.full_name + "." + def.name);
        result.type_symbol = new Option<BoundTypeSymbol>.some(type_sym);
        scope.add_symbol(new BoundSymbol.type_sym(type_sym));
        return new Option<BoundDefinition>.some(new BoundDefinition.type_ref_def(result));
    }

    fun bind_global_var_def(mut this, def: GlobalVariableDefinition, scope: mut BoundScope) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter bind_global_var_def");
        let full_name: string = scope.full_name + "." + def.name;
        let result: mut BoundGlobalVariableDefinition = new BoundGlobalVariableDefinition();
        result.name = def.name;
        result.full_name = full_name;
        result.is_mutable = def.is_mutable;
        result.scope = new Option<BoundScope>.some(scope);
        result.ast_source = new Option<Definition>.some(new Definition.global_var(def));
        let var_sym: mut BoundVariableSymbol = new BoundVariableSymbol();
        var_sym.name = def.name;
        var_sym.full_name = full_name;
        var_sym.variable_kind = new VariableSymbolKind.Global();
        var_sym.is_mutable = def.is_mutable;
        if (def.type_spec.is_some()) {
            if (def.type_spec.some.is_mutable) {
                var_sym.is_mutable = true;
            }
        }
        var_sym.enclosing_scope = new Option<BoundScope>.some(scope);
        result.variable_symbol = new Option<BoundVariableSymbol>.some(var_sym);
        scope.add_symbol(new BoundSymbol.variable(var_sym));
        return new Option<BoundDefinition>.some(new BoundDefinition.global_var_def(result));
    }

    fun report_error(this, code: ErrorCode, message: string, location: SourceLocation) {
        _utils.trace_enter("Enter report_error");
        this.errors.push(new SemanticError(code, message, location));
    }

    fun report_warning(this, code: ErrorCode, message: string, location: SourceLocation) {
        let e: mut SemanticError = new SemanticError(code, message, location);
        e.severity = new ErrorSeverity.Warning();
        this.errors.push(e);
    }

    fun report_info(this, code: ErrorCode, message: string, location: SourceLocation) {
        let e: mut SemanticError = new SemanticError(code, message, location);
        e.severity = new ErrorSeverity.Info();
        this.errors.push(e);
    }

    // Best-effort source-location extractors for diagnostics. Return the symbol's
    // recorded location, or an empty location when the symbol is absent (avoids
    // emitting useless ":0:0" when a real source span is available).
    fun var_sym_loc(this, sym: Option<BoundVariableSymbol>) -> SourceLocation {
        if (let s := sym.some) { return s.location; }
        return new SourceLocation("", 0, 0);
    }
    fun type_sym_loc(this, sym: Option<BoundTypeSymbol>) -> SourceLocation {
        if (let s := sym.some) { return s.location; }
        return new SourceLocation("", 0, 0);
    }
    fun func_sym_loc(this, sym: Option<BoundFunctionSymbol>) -> SourceLocation {
        if (let s := sym.some) { return s.location; }
        return new SourceLocation("", 0, 0);
    }
    fun enum_member_sym_loc(this, sym: Option<BoundEnumMemberSymbol>) -> SourceLocation {
        if (let s := sym.some) { return s.location; }
        return new SourceLocation("", 0, 0);
    }

    fun substitute_generic_args(this, bt: mut BoundType, concrete_type: BoundType, generic_def: BoundDefinition) -> mut BoundType {
        _utils.trace_enter("Enter substitute_generic_args");
        if (cast<i64>(concrete_type.generic_args.size()) == 0) { return bt; }
        let bt_name: string = bt.display_name();
        if (generic_def is BoundDefinition.enum_def) {
            let e: BoundEnumDefinition = generic_def.enum_def;
            let pi: mut i64 = 0;
            while (pi < cast<i64>(e.generic_params.size()) && pi < cast<i64>(concrete_type.generic_args.size())) {
                if (bt_name == e.generic_params.at(cast<u64>(pi)).some) {
                    let arg: mut BoundType = concrete_type.generic_args.at(cast<u64>(pi)).some;
                    return arg;
                }
                pi = pi + 1;
            }
        }
        if (generic_def is BoundDefinition.class_def) {
            let c: BoundClassDefinition = generic_def.class_def;
            let pi: mut i64 = 0;
            while (pi < cast<i64>(c.generic_params.size()) && pi < cast<i64>(concrete_type.generic_args.size())) {
                if (bt_name == c.generic_params.at(cast<u64>(pi)).some) {
                    let arg: mut BoundType = concrete_type.generic_args.at(cast<u64>(pi)).some;
                    return arg;
                }
                pi = pi + 1;
            }
        }
        return bt;
    }

    fun pass_bind_symbols(mut this, result: BoundCompilationUnit) {
        _utils.trace_enter("Enter pass_bind_symbols");
        let i: mut i64 = 0;
        while (i < cast<i64>(result.definitions.size())) {
            let def: BoundDefinition = result.definitions.at(cast<u64>(i)).some;
            this.bind_symbols_for_def(def);
            i = i + 1;
        }
    }

    fun bind_symbols_for_def(mut this, def: BoundDefinition) {
        _utils.trace_enter("Enter bind_symbols_for_def");
        if (def is BoundDefinition.function_def) {
            this.bind_function_symbols(def.function_def);
        }
        if (def is BoundDefinition.class_def) {
            this.bind_class_symbols(def.class_def);
        }
        if (def is BoundDefinition.enum_def) {
            let e: BoundEnumDefinition = def.enum_def;
            let i: mut i64 = 0;
            while (i < cast<i64>(e.members.size())) {
                let member: BoundEnumMemberDefinition = e.members.at(cast<u64>(i)).some;
                if (member.member_symbol.is_some()) {
                    let sym: mut BoundEnumMemberSymbol = member.member_symbol.some;
                    sym.bound_type = e.bound_type;
                }
                i = i + 1;
            }
            // Bind symbols for direct enum methods
            i = 0;
            while (i < cast<i64>(e.methods.size())) {
                let md: BoundDefinition = e.methods.at(cast<u64>(i)).some;
                this.bind_symbols_for_def(md);
                i = i + 1;
            }
            i = 0;
            while (i < cast<i64>(e.interface_impls.size())) {
                let impl_def: BoundDefinition = e.interface_impls.at(cast<u64>(i)).some;
                if (impl_def is BoundDefinition.impl_def) {
                    let iface_impl: BoundInterfaceImplementation = impl_def.impl_def;
                    let j: mut i64 = 0;
                    while (j < cast<i64>(iface_impl.methods.size())) {
                        let md: BoundDefinition = iface_impl.methods.at(cast<u64>(j)).some;
                        this.bind_symbols_for_def(md);
                        j = j + 1;
                    }
                }
                i = i + 1;
            }
        }
        if (def is BoundDefinition.interface_def) {
            let iface: BoundInterfaceDefinition = def.interface_def;
            let i: mut i64 = 0;
            while (i < cast<i64>(iface.methods.size())) {
                let md: BoundDefinition = iface.methods.at(cast<u64>(i)).some;
                this.bind_symbols_for_def(md);
                i = i + 1;
            }
        }
        if (def is BoundDefinition.namespace_def) {
            let ns: BoundNamespaceDefinition = def.namespace_def;
            let i: mut i64 = 0;
            while (i < cast<i64>(ns.children.size())) {
                let child: BoundDefinition = ns.children.at(cast<u64>(i)).some;
                this.bind_symbols_for_def(child);
                i = i + 1;
            }
        }
        if (def is BoundDefinition.initial_routine) {
            this.bind_function_symbols_for_init(def.initial_routine);
        }
    }

    fun bind_function_symbols(mut this, func: BoundFunctionDefinition) {
        _utils.trace_enter("Enter bind_function_symbols");
        // Mirror the resolved parameters onto the function symbol so callers
        // (e.g. bind_function_call's method-vs-free check, IRGenerator) can tell
        // whether this is a true method (first param `this`) without a separate
        // lookup. The symbol's `parameters` field is otherwise only populated
        // for externs.
        if (func.symbol.is_some()) {
            let sym: mut BoundFunctionSymbol = func.symbol.some;
            for (let param : BoundFunctionParameter in func.parameters) {
                sym.parameters.push(param);
            }
        }
        if (func.scope.is_none()) { return; }
        let func_scope: mut BoundScope = func.scope.some;
        let i: mut i64 = 0;
        while (i < cast<i64>(func.parameters.size())) {
            let param: BoundFunctionParameter = func.parameters.at(cast<u64>(i)).some;
            let param_sym: mut BoundVariableSymbol = new BoundVariableSymbol();
            param_sym.name = param.name;
            param_sym.full_name = func.full_name + "." + param.name;
            param_sym.bound_type = param.bound_type;
            param_sym.variable_kind = new VariableSymbolKind.Param();
            param_sym.is_mutable = param.is_mutable;
            param_sym.parameter_index = param.index;
            param_sym.enclosing_scope = new Option<BoundScope>.some(func_scope);
            func_scope.add_symbol(new BoundSymbol.variable(param_sym));
            i = i + 1;
        }
    }

    fun bind_function_symbols_for_init(mut this, init: BoundInitialRoutineDefinition) {
        _utils.trace_enter("Enter bind_function_symbols_for_init");
        if (init.scope.is_none()) { return; }
    }

    fun bind_class_symbols(mut this, cls: BoundClassDefinition) {
        _utils.trace_enter("Enter bind_class_symbols");
        if (cls.scope.is_none()) { return; }
        let i: mut i64 = 0;
        while (i < cast<i64>(cls.methods.size())) {
            let md: BoundDefinition = cls.methods.at(cast<u64>(i)).some;
            this.bind_symbols_for_def(md);
            i = i + 1;
        }
        i = 0;
        while (i < cast<i64>(cls.constructors.size())) {
            let cd: BoundDefinition = cls.constructors.at(cast<u64>(i)).some;
            this.bind_symbols_for_def(cd);
            i = i + 1;
        }
        i = 0;
        while (i < cast<i64>(cls.interface_impls.size())) {
            let impl_def: BoundDefinition = cls.interface_impls.at(cast<u64>(i)).some;
            if (impl_def is BoundDefinition.impl_def) {
                let iface_impl: BoundInterfaceImplementation = impl_def.impl_def;
                let j: mut i64 = 0;
                while (j < cast<i64>(iface_impl.methods.size())) {
                    let md: BoundDefinition = iface_impl.methods.at(cast<u64>(j)).some;
                    this.bind_symbols_for_def(md);
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }

    fun pass_resolve_types(mut this, unit: CompilationUnit, result: BoundCompilationUnit) {
        _utils.trace_enter("Enter pass_resolve_types");
        let i: mut i64 = 0;
        while (i < cast<i64>(result.definitions.size())) {
            let ast_def: Definition = unit.definitions.at(cast<u64>(i)).some;
            let bound_def: BoundDefinition = result.definitions.at(cast<u64>(i)).some;
            if (this.verbose >= 2) { __builtin.eprintln("[EmperorPenguin Semantic]   Resolving " + this.def_display_name(bound_def)); }
            let updated: BoundDefinition = this.resolve_pair(ast_def, bound_def, result.global_scope);
            result.definitions.set(cast<u64>(i), updated);
            i = i + 1;
        }
    }

    fun resolve_pair(mut this, ast_def: Definition, bound_def: BoundDefinition, scope: BoundScope) -> BoundDefinition {
        _utils.trace_enter("Enter resolve_pair");
        if (bound_def is BoundDefinition.function_def && ast_def is Definition.function_def) {
            let bf: mut BoundFunctionDefinition = bound_def.function_def;
            this.resolve_function_pair(ast_def.function_def, bf, scope);
            return new BoundDefinition.function_def(bf);
        }
        if (bound_def is BoundDefinition.class_def && ast_def is Definition.class_def) {
            let bc: mut BoundClassDefinition = bound_def.class_def;
            this.resolve_class_pair(ast_def.class_def, bc, scope);
            return new BoundDefinition.class_def(bc);
        }
        if (bound_def is BoundDefinition.enum_def && ast_def is Definition.enum_def) {
            let be: mut BoundEnumDefinition = bound_def.enum_def;
            this.resolve_enum_types(be, scope, ast_def.enum_def);
            return new BoundDefinition.enum_def(be);
        }
        if (bound_def is BoundDefinition.interface_def && ast_def is Definition.interface_def) {
            let bi: mut BoundInterfaceDefinition = bound_def.interface_def;
            this.resolve_interface_pair(ast_def.interface_def, bi, scope);
            return new BoundDefinition.interface_def(bi);
        }
        if (bound_def is BoundDefinition.namespace_def && ast_def is Definition.namespace_def) {
            let bn: mut BoundNamespaceDefinition = bound_def.namespace_def;
            this.resolve_namespace_pair(ast_def.namespace_def, bn, scope);
            return new BoundDefinition.namespace_def(bn);
        }
        if (bound_def is BoundDefinition.initial_routine) {
            let init: mut BoundInitialRoutineDefinition = bound_def.initial_routine;
            if (init.scope.is_some() && init.symbol.is_some()) {
                let sym: mut BoundFunctionSymbol = init.symbol.some;
                sym.bound_type = this.type_registry.make_function_type(
                    this.type_registry.void_type, new _utils.List<BoundType>(), false);
                init.symbol = new Option<BoundFunctionSymbol>.some(sym);
            }
            return new BoundDefinition.initial_routine(init);
        }
        if (bound_def is BoundDefinition.global_var_def && ast_def is Definition.global_var) {
            let gv: mut BoundGlobalVariableDefinition = bound_def.global_var_def;
            if (let ts := ast_def.global_var.type_spec.some) {
                gv.bound_type = this.resolve_type_specifier(ts, scope);
                if (gv.variable_symbol.is_some()) {
                    let sym: mut BoundVariableSymbol = gv.variable_symbol.some;
                    sym.bound_type = gv.bound_type;
                    gv.variable_symbol = new Option<BoundVariableSymbol>.some(sym);
                }
            }
            return new BoundDefinition.global_var_def(gv);
        }
        if (bound_def is BoundDefinition.type_ref_def && ast_def is Definition.type_ref_def) {
            let tr: mut BoundTypeReferenceDefinition = bound_def.type_ref_def;
            if (tr.type_symbol.is_some() && ast_def.type_ref_def.type_spec.is_some()) {
                let tsym: mut BoundTypeSymbol = tr.type_symbol.some;
                let alias_t: mut BoundType = new BoundType();
                alias_t.kind = new TypeKind.TypeReferenceKind();
                alias_t.generic_args.push(
                    this.resolve_type_specifier(ast_def.type_ref_def.type_spec.some, scope));
                tsym.bound_type = alias_t;
                tr.type_symbol = new Option<BoundTypeSymbol>.some(tsym);
            }
            return new BoundDefinition.type_ref_def(tr);
        }
        return bound_def;
    }

    fun resolve_function_pair(mut this, ast_func: FunctionDefinition, bound_func: mut BoundFunctionDefinition, scope: BoundScope) {
        _utils.trace_enter("Enter resolve_function_pair");
        let sym: mut BoundFunctionSymbol = bound_func.symbol.some;
        let ret: mut BoundType = this.type_registry.void_type;
        // For generic functions, use the function's own scope (has template params registered)
        let resolve_scope: BoundScope = if (bound_func.is_generic_template && bound_func.scope.is_some()) {
            bound_func.scope.some
        } else {
            scope
        };
        if (let rt := ast_func.return_type.some) {
            ret = this.resolve_type_specifier(rt, resolve_scope);
        }
        sym.return_type = ret;
        bound_func.return_type = ret;
        let func_type_params: mut _utils.List<BoundType> = new _utils.List<BoundType>();
        let pi: mut i64 = 0;
        while (pi < cast<i64>(ast_func.parameters.size())) {
            let p: Parameter = ast_func.parameters.at(cast<u64>(pi)).some;
            let bp: mut BoundFunctionParameter = new BoundFunctionParameter(p.name, pi, p.is_mutable, p.is_this);
            if (let ts := p.type_spec.some) {
                bp.bound_type = this.resolve_type_specifier(ts, resolve_scope);
                if (bp.bound_type.mutability is Mutability.Mutable) {
                    bp.is_mutable = true;
                }
            }
            bound_func.parameters.push(bp);
            func_type_params.push(bp.bound_type);
            pi = pi + 1;
        }
        let is_async: bool = ast_func.is_async;
        sym.bound_type = this.type_registry.make_function_type(ret, func_type_params, is_async);
        sym.is_async = is_async;
        bound_func.symbol = new Option<BoundFunctionSymbol>.some(sym);
    }

    fun resolve_class_method_pair(mut this, ast_func: FunctionDefinition, bound_func: mut BoundFunctionDefinition, scope: BoundScope, cls: mut BoundClassDefinition) {
        _utils.trace_enter("Enter resolve_class_method_pair");
        let sym: mut BoundFunctionSymbol = bound_func.symbol.some;
        let ret: mut BoundType = this.type_registry.void_type;
        // For generic methods, use the method's own scope (has its own template params registered)
        let resolve_scope: BoundScope = if (bound_func.is_generic_template && bound_func.scope.is_some()) {
            bound_func.scope.some
        } else {
            scope
        };
        if (ast_func.return_type.is_some()) {
            ret = this.resolve_type_specifier(ast_func.return_type.some, resolve_scope);
        }
        sym.return_type = ret;
        bound_func.return_type = ret;
        let func_type_params: mut _utils.List<BoundType> = new _utils.List<BoundType>();
        let pi: mut i64 = 0;
        while (pi < cast<i64>(ast_func.parameters.size())) {
            let p: Parameter = ast_func.parameters.at(cast<u64>(pi)).some;
            let bp: mut BoundFunctionParameter = new BoundFunctionParameter(p.name, pi, p.is_mutable, p.is_this);
            if (p.type_spec.is_some()) {
                bp.bound_type = this.resolve_type_specifier(p.type_spec.some, resolve_scope);
                // Propagate type-level mutability to parameter-level (BabyPenguin conflates them)
                if (bp.bound_type.mutability is Mutability.Mutable) {
                    bp.is_mutable = true;
                }
            } else if (p.is_this) {
                if (bound_func.is_new || p.is_mutable) {
                    bp.bound_type = cls.bound_type.with_mutability(new Mutability.Mutable());
                } else {
                    bp.bound_type = cls.bound_type;
                }
            }
            bound_func.parameters.push(bp);
            func_type_params.push(bp.bound_type);
            pi = pi + 1;
        }
        let is_async: bool = ast_func.is_async;
        sym.bound_type = this.type_registry.make_function_type(ret, func_type_params, is_async);
        sym.is_async = is_async;

        // Note: p.is_this check was removed because p is scoped inside the while loop.
        // The fix-up for generic methods happens via fix_this_param_type below.
        bound_func.symbol = new Option<BoundFunctionSymbol>.some(sym);
    }

    fun resolve_class_pair(mut this, ast_cls: ClassDefinition, bound_cls: mut BoundClassDefinition, scope: BoundScope) {
        _utils.trace_enter("Enter resolve_class_pair");
        let class_scope: BoundScope = bound_cls.scope.some;
        let i: mut i64 = 0;
        while (i < cast<i64>(ast_cls.members.size())) {
            let ast_member: Definition = ast_cls.members.at(cast<u64>(i)).some;
            if (ast_member is Definition.class_field) {
                let field_idx: mut i64 = 0;
                while (field_idx < cast<i64>(bound_cls.fields.size())) {
                    let bd: BoundDefinition = bound_cls.fields.at(cast<u64>(field_idx)).some;
                    if (bd is BoundDefinition.class_field && bd.class_field.name == ast_member.class_field.name) {
                        let field: mut BoundClassFieldDefinition = bd.class_field;
                        if (ast_member.class_field.type_spec.is_some()) {
                            field.bound_type = this.resolve_type_specifier(ast_member.class_field.type_spec.some, class_scope);
                        }
                        if (field.field_symbol.is_some()) {
                            let fsym: mut BoundVariableSymbol = field.field_symbol.some;
                            fsym.bound_type = field.bound_type;
                            field.field_symbol = new Option<BoundVariableSymbol>.some(fsym);
                        }
                        bound_cls.fields.set(cast<u64>(field_idx), new BoundDefinition.class_field(field));
                    }
                    field_idx = field_idx + 1;
                }
            }
            if (ast_member is Definition.function_def) {
                let j: mut i64 = 0;
                while (j < cast<i64>(bound_cls.methods.size())) {
                    let md: BoundDefinition = bound_cls.methods.at(cast<u64>(j)).some;
                    if (md is BoundDefinition.function_def && md.function_def.name == ast_member.function_def.name) {
                        let mf: mut BoundFunctionDefinition = md.function_def;
                        this.resolve_class_method_pair(ast_member.function_def, mf, class_scope, bound_cls);
                        bound_cls.methods.set(cast<u64>(j), new BoundDefinition.function_def(mf));
                    }
                    j = j + 1;
                }
            }
            if (ast_member is Definition.impl_def) {
                let ast_impl: InterfaceImplementation = ast_member.impl_def;
                let k: mut i64 = 0;
                while (k < cast<i64>(bound_cls.interface_impls.size())) {
                    let bd_impl: BoundDefinition = bound_cls.interface_impls.at(cast<u64>(k)).some;
                    if (bd_impl is BoundDefinition.impl_def) {
                        let bound_iface_impl: mut BoundInterfaceImplementation = bd_impl.impl_def;
                        let fi: mut i64 = 0;
                        while (fi < cast<i64>(ast_impl.functions.size())) {
                            let ast_func_def: Definition = ast_impl.functions.at(cast<u64>(fi)).some;
                            if (ast_func_def is Definition.function_def) {
                                let mi: mut i64 = 0;
                                while (mi < cast<i64>(bound_iface_impl.methods.size())) {
                                    let bound_method: BoundDefinition = bound_iface_impl.methods.at(cast<u64>(mi)).some;
                                    if (bound_method is BoundDefinition.function_def && bound_method.function_def.name == ast_func_def.function_def.name) {
                                        let bm: mut BoundFunctionDefinition = bound_method.function_def;
                                        this.resolve_class_method_pair(ast_func_def.function_def, bm, class_scope, bound_cls);
                                        bound_iface_impl.methods.set(cast<u64>(mi), new BoundDefinition.function_def(bm));
                                    }
                                    mi = mi + 1;
                                }
                            }
                            fi = fi + 1;
                        }
                        bound_cls.interface_impls.set(cast<u64>(k), new BoundDefinition.impl_def(bound_iface_impl));
                    }
                    k = k + 1;
                }
            }
            i = i + 1;
        }
    }

    fun resolve_enum_types(mut this, e: mut BoundEnumDefinition, scope: BoundScope, ast_enum: EnumDefinition) {
        _utils.trace_enter("Enter resolve_enum_types");
        let enum_scope: BoundScope = e.scope.some;
        // Resolve enum member payload types (deferred from pass 1 to allow
        // forward references: e.g. enum B { a: A } where class A follows B).
        let mi: mut i64 = 0;
        let ai: mut i64 = 0;
        while (ai < cast<i64>(ast_enum.members.size())) {
            let ast_member: Definition = ast_enum.members.at(cast<u64>(ai)).some;
            if (ast_member is Definition.enum_member) {
                let member: mut BoundEnumMemberDefinition = e.members.at(cast<u64>(mi)).some;
                if (ast_member.enum_member.type_spec.is_some()) {
                    let resolved: mut BoundType = this.resolve_type_specifier(ast_member.enum_member.type_spec.some, enum_scope);
                    member.member_type = resolved;
                    if (member.member_symbol.is_some()) {
                        let msym: mut BoundEnumMemberSymbol = member.member_symbol.some;
                        msym.member_type = resolved;
                        member.member_symbol = new Option<BoundEnumMemberSymbol>.some(msym);
                    }
                } else {
                    // No type spec: this is a tag-only variant (like `none`)
                    member.member_type = e.bound_type;
                    if (member.member_symbol.is_some()) {
                        let msym: mut BoundEnumMemberSymbol = member.member_symbol.some;
                        msym.member_type = e.bound_type;
                        member.member_symbol = new Option<BoundEnumMemberSymbol>.some(msym);
                    }
                }
                e.members.set(cast<u64>(mi), member);
                mi = mi + 1;
            }
            ai = ai + 1;
        }
        // Resolve interface implementation method types
        let ai: mut i64 = 0;
        while (ai < cast<i64>(ast_enum.members.size())) {
            let ast_member: Definition = ast_enum.members.at(cast<u64>(ai)).some;
            if (ast_member is Definition.impl_def) {
                let ast_impl: InterfaceImplementation = ast_member.impl_def;
                let k: mut i64 = 0;
                while (k < cast<i64>(e.interface_impls.size())) {
                    let bd_impl: BoundDefinition = e.interface_impls.at(cast<u64>(k)).some;
                    if (bd_impl is BoundDefinition.impl_def) {
                        let bound_iface_impl: mut BoundInterfaceImplementation = bd_impl.impl_def;
                        let fi: mut i64 = 0;
                        while (fi < cast<i64>(ast_impl.functions.size())) {
                            let ast_func_def: Definition = ast_impl.functions.at(cast<u64>(fi)).some;
                            if (ast_func_def is Definition.function_def) {
                                let mi: mut i64 = 0;
                                while (mi < cast<i64>(bound_iface_impl.methods.size())) {
                                    let bound_method: BoundDefinition = bound_iface_impl.methods.at(cast<u64>(mi)).some;
                                    if (bound_method is BoundDefinition.function_def && bound_method.function_def.name == ast_func_def.function_def.name) {
                                        let bm: mut BoundFunctionDefinition = bound_method.function_def;
                                        this.resolve_enum_method_pair(ast_func_def.function_def, bm, enum_scope, e);
                                        bound_iface_impl.methods.set(cast<u64>(mi), new BoundDefinition.function_def(bm));
                                    }
                                    mi = mi + 1;
                                }
                            }
                            fi = fi + 1;
                        }
                        e.interface_impls.set(cast<u64>(k), new BoundDefinition.impl_def(bound_iface_impl));
                    }
                    k = k + 1;
                }
            }
            ai = ai + 1;
        }
        // Resolve direct enum method types
        let di: mut i64 = 0;
        while (di < cast<i64>(e.methods.size())) {
            let md: BoundDefinition = e.methods.at(cast<u64>(di)).some;
            if (md is BoundDefinition.function_def) {
                let mi: mut i64 = 0;
                while (mi < cast<i64>(ast_enum.members.size())) {
                    let ast_member: Definition = ast_enum.members.at(cast<u64>(mi)).some;
                    if (ast_member is Definition.function_def) {
                        if (ast_member.function_def.name == md.function_def.name) {
                            let bm: mut BoundFunctionDefinition = md.function_def;
                            this.resolve_enum_method_pair(ast_member.function_def, bm, enum_scope, e);
                            e.methods.set(cast<u64>(di), new BoundDefinition.function_def(bm));
                        }
                    }
                    mi = mi + 1;
                }
            }
            di = di + 1;
        }
    }

    fun resolve_enum_method_pair(mut this, ast_func: FunctionDefinition, bound_func: mut BoundFunctionDefinition, scope: BoundScope, e: mut BoundEnumDefinition) {
        _utils.trace_enter("Enter resolve_enum_method_pair");
        let sym: mut BoundFunctionSymbol = bound_func.symbol.some;
        let ret: mut BoundType = this.type_registry.void_type;
        if (ast_func.return_type.is_some()) {
            ret = this.resolve_type_specifier(ast_func.return_type.some, scope);
        }
        sym.return_type = ret;
        bound_func.return_type = ret;
        let func_type_params: mut _utils.List<BoundType> = new _utils.List<BoundType>();
        // Skip parameter resolution if already done (e.g. during specialize_enum_def)
        if (cast<i64>(bound_func.parameters.size()) == 0) {
            let pi: mut i64 = 0;
            while (pi < cast<i64>(ast_func.parameters.size())) {
                let p: Parameter = ast_func.parameters.at(cast<u64>(pi)).some;
                let bp: mut BoundFunctionParameter = new BoundFunctionParameter(p.name, pi, p.is_mutable, p.is_this);
                if (p.type_spec.is_some()) {
                    bp.bound_type = this.resolve_type_specifier(p.type_spec.some, scope);
                } else if (p.is_this) {
                    bp.bound_type = e.bound_type;
                }
                bound_func.parameters.push(bp);
                func_type_params.push(bp.bound_type);
                pi = pi + 1;
            }
        } else {
            let pi: mut i64 = 0;
            while (pi < cast<i64>(bound_func.parameters.size())) {
                func_type_params.push(bound_func.parameters.at(cast<u64>(pi)).some.bound_type);
                pi = pi + 1;
            }
        }
        let is_async: bool = ast_func.is_async;
        sym.bound_type = this.type_registry.make_function_type(ret, func_type_params, is_async);
        sym.is_async = is_async;
        bound_func.symbol = new Option<BoundFunctionSymbol>.some(sym);
    }

    fun resolve_interface_pair(mut this, ast_iface: InterfaceDefinition, bound_iface: mut BoundInterfaceDefinition, scope: BoundScope) {
        _utils.trace_enter("Enter resolve_interface_pair");
        let iface_scope: BoundScope = bound_iface.scope.some;
        let i: mut i64 = 0;
        while (i < cast<i64>(ast_iface.members.size())) {
            let ast_member: Definition = ast_iface.members.at(cast<u64>(i)).some;
            if (ast_member is Definition.function_def) {
                let j: mut i64 = 0;
                while (j < cast<i64>(bound_iface.methods.size())) {
                    let md: BoundDefinition = bound_iface.methods.at(cast<u64>(j)).some;
                    if (md is BoundDefinition.function_def && md.function_def.name == ast_member.function_def.name) {
                        let mf: mut BoundFunctionDefinition = md.function_def;
                        this.resolve_interface_method_pair(ast_member.function_def, mf, iface_scope, bound_iface);
                        bound_iface.methods.set(cast<u64>(j), new BoundDefinition.function_def(mf));
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }

    fun resolve_interface_method_pair(mut this, ast_func: FunctionDefinition, bound_func: mut BoundFunctionDefinition, scope: BoundScope, iface: mut BoundInterfaceDefinition) {
        _utils.trace_enter("Enter resolve_interface_method_pair");
        let sym: mut BoundFunctionSymbol = bound_func.symbol.some;
        let ret: mut BoundType = this.type_registry.void_type;
        if (ast_func.return_type.is_some()) {
            ret = this.resolve_type_specifier(ast_func.return_type.some, scope);
        }
        sym.return_type = ret;
        bound_func.return_type = ret;
        let func_type_params: mut _utils.List<BoundType> = new _utils.List<BoundType>();
        let pi: mut i64 = 0;
        while (pi < cast<i64>(ast_func.parameters.size())) {
            let p: Parameter = ast_func.parameters.at(cast<u64>(pi)).some;
            let bp: mut BoundFunctionParameter = new BoundFunctionParameter(p.name, pi, p.is_mutable, p.is_this);
            if (p.type_spec.is_some()) {
                bp.bound_type = this.resolve_type_specifier(p.type_spec.some, scope);
            } else if (p.is_this) {
                bp.bound_type = iface.bound_type;
            }
            bound_func.parameters.push(bp);
            func_type_params.push(bp.bound_type);
            pi = pi + 1;
        }
        let is_async: bool = ast_func.is_async;
        sym.bound_type = this.type_registry.make_function_type(ret, func_type_params, is_async);
        sym.is_async = is_async;
        bound_func.symbol = new Option<BoundFunctionSymbol>.some(sym);
    }

    fun resolve_namespace_pair(mut this, ast_ns: NamespaceDefinition, bound_ns: mut BoundNamespaceDefinition, scope: BoundScope) {
        _utils.trace_enter("Enter resolve_namespace_pair");
        let ns_scope: BoundScope = bound_ns.scope.some;
        let i: mut i64 = 0;
        while (i < cast<i64>(ast_ns.children.size())) {
            let ast_child: Definition = ast_ns.children.at(cast<u64>(i)).some;
            let j: mut i64 = 0;
            while (j < cast<i64>(bound_ns.children.size())) {
                let bound_child: BoundDefinition = bound_ns.children.at(cast<u64>(j)).some;
                if (ast_child is Definition.function_def && bound_child is BoundDefinition.function_def) {
                    if (ast_child.function_def.name == bound_child.function_def.name) {
                        bound_ns.children.set(cast<u64>(j), this.resolve_pair(ast_child, bound_child, ns_scope));
                    }
                }
                if (ast_child is Definition.class_def && bound_child is BoundDefinition.class_def) {
                    if (ast_child.class_def.name == bound_child.class_def.name) {
                        bound_ns.children.set(cast<u64>(j), this.resolve_pair(ast_child, bound_child, ns_scope));
                    }
                }
                if (ast_child is Definition.enum_def && bound_child is BoundDefinition.enum_def) {
                    if (ast_child.enum_def.name == bound_child.enum_def.name) {
                        bound_ns.children.set(cast<u64>(j), this.resolve_pair(ast_child, bound_child, ns_scope));
                    }
                }
                if (ast_child is Definition.interface_def && bound_child is BoundDefinition.interface_def) {
                    if (ast_child.interface_def.name == bound_child.interface_def.name) {
                        bound_ns.children.set(cast<u64>(j), this.resolve_pair(ast_child, bound_child, ns_scope));
                    }
                }
                if (ast_child is Definition.namespace_def && bound_child is BoundDefinition.namespace_def) {
                    if (ast_child.namespace_def.name == bound_child.namespace_def.name) {
                        bound_ns.children.set(cast<u64>(j), this.resolve_pair(ast_child, bound_child, ns_scope));
                    }
                }
                if (ast_child is Definition.global_var && bound_child is BoundDefinition.global_var_def) {
                    if (ast_child.global_var.name == bound_child.global_var_def.name) {
                        bound_ns.children.set(cast<u64>(j), this.resolve_pair(ast_child, bound_child, ns_scope));
                    }
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }

    fun resolve_generic_args(this, type_spec: TypeSpecifier, scope: BoundScope) -> mut _utils.List<BoundType> {
        _utils.trace_enter("Enter resolve_generic_args");
        let args: mut _utils.List<BoundType> = new _utils.List<BoundType>();
        let k: mut i64 = 0;
        while (k < cast<i64>(type_spec.generic_args.size())) {
            let arg_ts: TypeSpecifier = type_spec.generic_args.at(cast<u64>(k)).some;
            // req5: a value generic arg (A<5>) -> synthetic BoundType riding generic_args.
            if (arg_ts.is_value_arg) {
                let vbt: mut BoundType = new BoundType();
                vbt.is_template_value_arg = true;
                vbt.template_value = string_to_int(arg_ts.value_arg_text);
                args.push(vbt);
            } else {
                args.push(this.resolve_type_specifier(arg_ts, scope));
            }
            k = k + 1;
        }
        return args;
    }

    fun apply_mutability(this, bt: BoundType, is_mutable: bool) -> mut BoundType {
        _utils.trace_enter("Enter apply_mutability");
        if (is_mutable) {
            return bt.with_mutability(new Mutability.Mutable());
        }
        return bt;
    }

    // req5: substitute non-type (value) template params (N) with their concrete
    // constant values (5) inside an expression. Used when binding the members of
    // a specialized value-template class so `foo: i32 = N` becomes `= 5`. Returns
    // a new expression; the original (shared template) AST is not mutated.
    fun substitute_value_params(mut this, expr: Expression, names: _utils.List<string>, values: _utils.List<i64>) -> Expression {
        if (cast<i64>(names.size()) == 0) { return expr; }
        if (expr is Expression.identifier) {
            let id: IdentifierExpression = expr.identifier;
            let i: mut i64 = 0;
            while (i < cast<i64>(names.size())) {
                if (names.at(cast<u64>(i)).some == id.name) {
                    let ce: mut ConstantExpression = new ConstantExpression(cast<string>(values.at(cast<u64>(i)).some));
                    return new Expression.constant(ce);
                }
                i = i + 1;
            }
            return expr;
        }
        if (expr is Expression.binary) {
            let b: BinaryExpression = expr.binary;
            let r: mut BinaryExpression = new BinaryExpression();
            let oi: mut i64 = 0;
            while (oi < cast<i64>(b.operators.size())) { r.operators.push(b.operators.at(cast<u64>(oi)).some); oi = oi + 1; }
            let ai: mut i64 = 0;
            while (ai < cast<i64>(b.operands.size())) { r.operands.push(this.substitute_value_params(b.operands.at(cast<u64>(ai)).some, names, values)); ai = ai + 1; }
            return new Expression.binary(r);
        }
        if (expr is Expression.unary) {
            let u: UnaryExpression = expr.unary;
            let r: mut UnaryExpression = new UnaryExpression();
            r.operator_value = u.operator_value;
            if (u.operand.is_some()) { r.operand = new Option<Expression>.some(this.substitute_value_params(u.operand.some, names, values)); }
            return new Expression.unary(r);
        }
        if (expr is Expression.parenthesized) {
            let e: ParenthesizedExpression = expr.parenthesized;
            let r: mut ParenthesizedExpression = new ParenthesizedExpression();
            if (e.inner.is_some()) { r.inner = new Option<Expression>.some(this.substitute_value_params(e.inner.some, names, values)); }
            return new Expression.parenthesized(r);
        }
        if (expr is Expression.function_call) {
            let f: FunctionCallExpression = expr.function_call;
            let r: mut FunctionCallExpression = new FunctionCallExpression();
            if (f.callee.is_some()) { r.callee = new Option<Expression>.some(this.substitute_value_params(f.callee.some, names, values)); }
            let ai: mut i64 = 0;
            while (ai < cast<i64>(f.arguments.size())) { r.arguments.push(this.substitute_value_params(f.arguments.at(cast<u64>(ai)).some, names, values)); ai = ai + 1; }
            return new Expression.function_call(r);
        }
        if (expr is Expression.member_access) {
            let m: MemberAccessExpression = expr.member_access;
            let r: mut MemberAccessExpression = new MemberAccessExpression();
            if (m.base_expr.is_some()) { r.base_expr = new Option<Expression>.some(this.substitute_value_params(m.base_expr.some, names, values)); }
            r.member_name = m.member_name;
            return new Expression.member_access(r);
        }
        return expr;
    }

    // Phase 5c (type-return splice): if `type_spec` is a #fun() meta call in a
    // type-specifier position (e.g. `let x: #int_by_bits(32) = 5;`), JIT-execute
    // the #fun (it returns a type token as i64) and resolve the token to a
    // BoundType via MetaEngine. Returns none when type_spec is not a meta-call
    // type so the caller falls through to normal resolution.
    fun try_resolve_meta_type_specifier(this, type_spec: TypeSpecifier, scope: BoundScope) -> Option<BoundType> {
        if (type_spec.meta_call.is_none()) {
            return new Option<BoundType>.none();
        }
        let mc: MetaCallExpression = type_spec.meta_call.some;
        let bmf_opt: Option<BoundMetaFunctionDefinition> = this.find_meta_function(mc.func_name);
        if (bmf_opt.is_none()) {
            this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta type call '#" + mc.func_name + "' is not a #fun", mc.location);
            return new Option<BoundType>.none();
        }
        let bmf: BoundMetaFunctionDefinition = bmf_opt.some;
        // meta_engine is a `mut` field seeded once in bind(); its JIT methods
        // mutate the engine, not the (immutable) SemanticModel `this`. Args are
        // evaluated directly (literal/type/ast) instead of via the mut-this
        // bind_expression path, so this stays callable from immutable type resolution.
        let args_opt: Option<_utils.List<i64>> = this.eval_meta_type_call_args(mc, bmf, scope);
        if (args_opt.is_none()) {
            return new Option<BoundType>.none();
        }
        let args: _utils.List<i64> = args_opt.some;
        // Phase 5: `#fun -> type` returns a real BoundType; the caller-stub stored
        // it into the host global active_type_result (returning i64 0 to the
        // arity-0 trampoline). Read it back here. (The host can't recover a non-i64
        // reference from the trampoline return, hence the global return channel.)
        let _ignored: i64 = this.meta_engine.call_meta_function_stub(bmf, args);
        let bt: BoundType = penguin_meta_get_type_result();
        if (bt.type_definition.is_none() && (bt.kind is TypeKind.PrimitiveKind) && (bt.primitive is PrimitiveType.VoidType)) {
            this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta '#" + mc.func_name + "' did not return a known type", mc.location);
            return new Option<BoundType>.none();
        }
        return new Option<BoundType>.some(bt);
    }

    // Immutable-`this` argument evaluation for a type-position meta call (see
    // try_resolve_meta_type_specifier). Handles type/ast/integer-literal args.
    fun eval_meta_type_call_args(this, mc: MetaCallExpression, bmf: BoundMetaFunctionDefinition, scope: BoundScope) -> Option<_utils.List<i64>> {
        let result: mut _utils.List<i64> = new _utils.List<i64>();
        let nparams: i64 = cast<i64>(bmf.parameters.size());
        let nargs: i64 = cast<i64>(mc.arguments.size());
        let pi: mut i64 = 0;
        while (pi < nargs) {
            if (pi >= nparams) {
                this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta #" + bmf.name + " has too many arguments", mc.location);
                return new Option<_utils.List<i64>>.none();
            }
            let kind: string = bmf.parameters.at(cast<u64>(pi)).some.kind;
            let arg: Expression = mc.arguments.at(cast<u64>(pi)).some;
            let v: Option<i64> = this.eval_meta_arg_i64(arg, kind, mc.location);
            if (v.is_none()) {
                return new Option<_utils.List<i64>>.none();
            }
            result.push(v.some);
            pi = pi + 1;
        }
        return new Option<_utils.List<i64>>.some(result);
    }

    fun eval_meta_arg_i64(this, arg: Expression, kind: string, loc: SourceLocation) -> Option<i64> {
        if (kind == "type") {
            if (arg is Expression.identifier) {
                let type_name: string = arg.identifier.name;
                let bt_opt: Option<BoundType> = this.type_registry.resolve_type(type_name);
                if (bt_opt.is_some()) {
                    let token: u64 = this.meta_engine.get_or_assign_type_token(type_name);
                    return new Option<i64>.some(cast<i64>(token));
                }
                this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta type argument '" + type_name + "' is not a known type", loc);
                return new Option<i64>.none();
            }
            this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta type argument must be a type name", loc);
            return new Option<i64>.none();
        }
        if (kind == "ast") {
            let token: u64 = this.meta_engine.register_ast_expression(arg);
            return new Option<i64>.some(cast<i64>(token));
        }
        // integer literal arg (ConstantExpression holds the raw token text).
        if (arg is Expression.constant) {
            return new Option<i64>.some(string_to_int(arg.constant.value));
        }
        this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta type-call argument must be a compile-time integer literal, type, or ast", loc);
        return new Option<i64>.none();
    }

    fun resolve_type_specifier(this, type_spec: TypeSpecifier, scope: BoundScope) -> mut BoundType {
        _utils.trace_enter("Enter resolve_type_specifier");
        let mt: Option<BoundType> = this.try_resolve_meta_type_specifier(type_spec, scope);
        if (mt.is_some()) {
            return this.apply_mutability(mt.some, type_spec.is_mutable);
        }
        if (type_spec.is_function_type || type_spec.is_async_function_type) {
            let param_types: mut _utils.List<BoundType> = new _utils.List<BoundType>();
            let i: mut i64 = 0;
            while (i < cast<i64>(type_spec.function_params.size())) {
                param_types.push(this.resolve_type_specifier(
                    type_spec.function_params.at(cast<u64>(i)).some, scope));
                i = i + 1;
            }
            let ret: mut BoundType = this.type_registry.void_type;
            if (type_spec.return_type.is_some()) {
                ret = this.resolve_type_specifier(type_spec.return_type.some, scope);
            }
            return this.type_registry.make_function_type(ret, param_types, type_spec.is_async_function_type);
        }
    // Handle iterable type (e.g., i64[] → __builtin.IIterator<i64>).
    // Desugar to the specialized (monomorphized) name so the resulting BoundType
    // has the correct type_definition (specialized interface) with concrete types.
    if (type_spec.is_iterable) {
        let elem_name: string = type_spec.name;
        // Find IIterator in __builtin to get its BoundType
        let parts3: mut _utils.List<string> = new _utils.List<string>();
        parts3.push("__builtin");
        parts3.push("IIterator");
        let iface_sym3: Option<BoundSymbol> = scope.resolve_qualified(parts3);
        if (iface_sym3.is_some() && iface_sym3.some is BoundSymbol.type_sym) {
            let iface_type: mut BoundType = iface_sym3.some.type_sym.bound_type;
            // Resolve the element type and add as generic arg
            let elem_ts3: TypeSpecifier = new TypeSpecifier();
            elem_ts3.name = elem_name;
            let eqi4: mut i64 = 0;
            while (eqi4 < cast<i64>(type_spec.qualified_parts.size())) {
                elem_ts3.qualified_parts.push(type_spec.qualified_parts.at(cast<u64>(eqi4)).some);
                eqi4 = eqi4 + 1;
            }
            let elem_type3: BoundType = this.resolve_type_specifier(elem_ts3, scope);
            let gen_args3: mut _utils.List<BoundType> = new _utils.List<BoundType>();
            gen_args3.push(elem_type3.with_mutability(new Mutability.Immutable()));
            iface_type = iface_type.with_generic_args(gen_args3);
            // An iterable type (`i64[]`) is mutable by default so the resulting
            // IIterator's `next()` (mut this) can be called on the variable.
            let want_mut: bool = if (type_spec.is_not_mutable) { false } else { true };
            return this.apply_mutability(iface_type, want_mut);
        }
        this.report_error(new ErrorCode.E_RESOLVE_TYPE(),
            "Can't resolve IIterator for iterable type '" + type_spec.build_text() + "'",
            type_spec.location);
        return this.type_registry.make_error_type();
    }
        // Check for Self keyword: resolves to the enclosing class/enum/interface type.
        if (type_spec.name == "Self") {
            let cur: mut Option<BoundScope> = new Option<BoundScope>.some(scope);
            while (cur.is_some()) {
                let s: BoundScope = cur.some;
                if (s.kind is ScopeKind.ClassScope || s.kind is ScopeKind.EnumScope || s.kind is ScopeKind.InterfaceScope) {
                    // Look up the type symbol in the parent scope by this scope's name.
                    if (s.parent.is_some()) {
                        let parent_sym: Option<BoundSymbol> = s.parent.some.lookup_type_in_scope(s.name);
                        if (parent_sym.is_some() && parent_sym.some is BoundSymbol.type_sym) {
                            return this.apply_mutability(parent_sym.some.type_sym.bound_type, type_spec.is_mutable);
                        }
                    }
                }
                if (s.parent.is_some()) { cur = new Option<BoundScope>.some(s.parent.some); }
                else { cur = new Option<BoundScope>.none(); }
            }
            // If Self resolution fails, fall through to normal error handling.
        }
        let prim: Option<BoundType> = this.type_registry.resolve_type(type_spec.name);
        if (prim.is_some()) {
            return this.apply_mutability(prim.some, type_spec.is_mutable);
        }
        let qual_result: Option<BoundType> = this.try_resolve_qualified_type(type_spec, scope);
        if (qual_result.is_some()) {
            return this.apply_mutability(qual_result.some, type_spec.is_mutable);
        }
        let type_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(type_spec.name);
        if (type_sym.is_some()) {
            let result: mut BoundType = type_sym.some.type_sym.bound_type;
            if (cast<i64>(type_spec.generic_args.size()) > 0) {
                result = result.with_generic_args(this.resolve_generic_args(type_spec, scope));
            }
            return this.apply_mutability(result, type_spec.is_mutable);
        }
        this.report_error(new ErrorCode.E_RESOLVE_TYPE(),
            "Can't resolve type specifier '" + type_spec.build_text() + "'",
            type_spec.location);
        return this.type_registry.make_error_type();
    }

    // Resolve a type specifier WITHOUT handling is_iterable (to avoid recursion
    // when resolve_type_specifier delegates to this for the element type).
    fun resolve_type_specifier_no_iterable(this, type_spec: TypeSpecifier, scope: BoundScope) -> mut BoundType {
        _utils.trace_enter("Enter resolve_type_specifier_no_iterable");
        let mt: Option<BoundType> = this.try_resolve_meta_type_specifier(type_spec, scope);
        if (mt.is_some()) {
            return this.apply_mutability(mt.some, type_spec.is_mutable);
        }
        if (type_spec is TypeSpecifier) {
            // Skip: just a type guard — always true
        }
        if (type_spec.name == "Self") {
            let cur: mut Option<BoundScope> = new Option<BoundScope>.some(scope);
            while (cur.is_some()) {
                let s: BoundScope = cur.some;
                if (s.kind is ScopeKind.ClassScope || s.kind is ScopeKind.EnumScope || s.kind is ScopeKind.InterfaceScope) {
                    if (s.parent.is_some()) {
                        let parent_sym: Option<BoundSymbol> = s.parent.some.lookup_type_in_scope(s.name);
                        if (parent_sym.is_some() && parent_sym.some is BoundSymbol.type_sym) {
                            return this.apply_mutability(parent_sym.some.type_sym.bound_type, type_spec.is_mutable);
                        }
                    }
                }
                if (s.parent.is_some()) { cur = new Option<BoundScope>.some(s.parent.some); }
                else { cur = new Option<BoundScope>.none(); }
            }
        }
        let prim: Option<BoundType> = this.type_registry.resolve_type(type_spec.name);
        if (prim.is_some()) {
            return this.apply_mutability(prim.some, type_spec.is_mutable);
        }
        let qual_result: Option<BoundType> = this.try_resolve_qualified_type(type_spec, scope);
        if (qual_result.is_some()) {
            return this.apply_mutability(qual_result.some, type_spec.is_mutable);
        }
        let type_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(type_spec.name);
        if (type_sym.is_some()) {
            let result: mut BoundType = type_sym.some.type_sym.bound_type;
            if (cast<i64>(type_spec.generic_args.size()) > 0) {
                result = result.with_generic_args(this.resolve_generic_args(type_spec, scope));
            }
            return this.apply_mutability(result, type_spec.is_mutable);
        }
        this.report_error(new ErrorCode.E_RESOLVE_TYPE(),
            "Can't resolve type specifier '" + type_spec.build_text() + "'",
            type_spec.location);
        return this.type_registry.make_error_type();
    }

    // Resolve an iterable type (e.g., i64[] → IIterator<i64>).
    fun resolve_iterable_type(this, element_type: BoundType, type_spec: TypeSpecifier, scope: BoundScope) -> mut BoundType {
        _utils.trace_enter("Enter resolve_iterable_type");
        // Try unqualified lookup first (works if __builtin is imported)
        let iface_sym: Option<BoundSymbol> = if (scope.lookup_type_in_scope("IIterator").is_some()) {
            scope.lookup_type_in_scope("IIterator")
        } else {
            let parts2: mut _utils.List<string> = new _utils.List<string>();
            parts2.push("__builtin");
            parts2.push("IIterator");
            scope.resolve_qualified(parts2)
        };
        if (iface_sym.is_some() && iface_sym.some is BoundSymbol.type_sym) {
            let iface_type: mut BoundType = iface_sym.some.type_sym.bound_type;
            let gen_args: mut _utils.List<BoundType> = new _utils.List<BoundType>();
            gen_args.push(element_type.with_mutability(new Mutability.Immutable()));
            iface_type = iface_type.with_generic_args(gen_args);
            // An iterable type (`i64[]`) is mutable by default so the resulting
            // IIterator's `next()` (mut this) can be called on the variable.
            let want_mut: bool = if (type_spec.is_not_mutable) { false } else { true };
            return this.apply_mutability(iface_type, want_mut);
        }
        // If IIterator not found, give a clear error
        this.report_error(new ErrorCode.E_RESOLVE_TYPE(),
            "Can't resolve IIterator for iterable type '" + type_spec.build_text() + "'",
            type_spec.location);
        return this.type_registry.make_error_type();
    }

    fun try_resolve_qualified_type(this, type_spec: TypeSpecifier, scope: BoundScope) -> Option<BoundType> {
        _utils.trace_enter("Enter try_resolve_qualified_type");
        if (cast<i64>(type_spec.qualified_parts.size()) == 0) {
            return new Option<BoundType>.none();
        }
        let full_parts: mut _utils.List<string> = new _utils.List<string>();
        let qi: mut i64 = 0;
        while (qi < cast<i64>(type_spec.qualified_parts.size())) {
            full_parts.push(type_spec.qualified_parts.at(cast<u64>(qi)).some);
            qi = qi + 1;
        }
        full_parts.push(type_spec.name);
        let found: Option<BoundSymbol> = scope.resolve_qualified(full_parts);
        if (found.is_none()) {
            return new Option<BoundType>.none();
        }
        if (found.some is BoundSymbol.type_sym) {
            // OK - continue to resolve
        } else {
            return new Option<BoundType>.none();
        }
        let resolved: mut BoundType = found.some.type_sym.bound_type;
        if (cast<i64>(type_spec.generic_args.size()) > 0) {
            resolved = resolved.with_generic_args(this.resolve_generic_args(type_spec, scope));
        }
        return new Option<BoundType>.some(resolved);
    }

    fun mangle_generic_name(base_name: string, generic_args: _utils.List<BoundType>) -> string {
        _utils.trace_enter("Enter mangle_generic_name");
        let sb: mut StringBuilder = new StringBuilder();
        sb.append(base_name);
        let i: mut i64 = 0;
        while (i < cast<i64>(generic_args.size())) {
            sb.append("__");
            let arg_name: string = generic_args.at(cast<u64>(i)).some.display_name();
            let sanitized: mut StringBuilder = new StringBuilder();
            let j: mut i64 = 0;
            while (j < string_length(arg_name)) {
                let ch: string = string_char_at(arg_name, j);
                if (ch == " " || ch == "<" || ch == ">" || ch == ",") {
                    sanitized.append("_");
                } else {
                    sanitized.append(ch);
                }
                j = j + 1;
            }
            sb.append(sanitized.to_string());
            i = i + 1;
        }
        return sb.to_string();
    }

    fun is_instantiation_already_exists(this, mangled_name: string, scope: BoundScope) -> bool {
        _utils.trace_enter("Enter is_instantiation_already_exists");
        let found: Option<BoundSymbol> = scope.lookup_type_in_scope(mangled_name);
        if (found.is_some()) { return true; }
        return false;
    }

    fun pass_monomorphize(mut this, unit: CompilationUnit, result: mut BoundCompilationUnit) {
        _utils.trace_enter("Enter pass_monomorphize");
        // Iterative monomorphization: specialize, resolve, then re-collect from
        // the newly resolved definitions for transitive instantiations.
        let total_specialized: mut i64 = 0;
        let max_iterations: mut i64 = 10;
        let iteration: mut i64 = 0;
        while (iteration < max_iterations) {
            let instantiations: mut _utils.List<BoundType> = new _utils.List<BoundType>();
            this.collect_generic_instantiations(result.definitions, instantiations);
            this.collect_generic_instantiations_from_ast(unit.definitions, result.definitions, result.global_scope, instantiations);

            let specialized_defs: mut _utils.List<BoundDefinition> = new _utils.List<BoundDefinition>();
            let specialized_asts: mut _utils.List<Definition> = new _utils.List<Definition>();
            let i: mut i64 = 0;
            while (i < cast<i64>(instantiations.size())) {
                let inst: BoundType = instantiations.at(cast<u64>(i)).some;
                if (let template_def := inst.type_definition.some) {
                    if (template_def is BoundDefinition.class_def) {
                        let cls: BoundClassDefinition = template_def.class_def;
                        if (cast<i64>(cls.generic_params.size()) > 0) {
                            let mangled: string = mangle_generic_name(cls.name, inst.generic_args);
                            if (!this.is_instantiation_already_exists(mangled, result.global_scope)) {
                                let ast_def: Option<Definition> = this.find_ast_def_by_name(unit.definitions, cls.name);
                                if (ast_def.is_some()) {
                                    let spec_result: Option<BoundDefinition> = this.specialize_class_def(
                                        cls, inst.generic_args, mangled, result.global_scope);
                                    if (spec_result.is_some()) {
                                        if (this.verbose >= 2) { __builtin.eprintln("[EmperorPenguin Monomorphize]   Specialized class " + mangled); }
                                        specialized_defs.push(spec_result.some);
                                        specialized_asts.push(ast_def.some);
                                    }
                                }
                            }
                        }
                    }
                    if (template_def is BoundDefinition.enum_def) {
                        let e: BoundEnumDefinition = template_def.enum_def;
                        if (cast<i64>(e.generic_params.size()) > 0) {
                            let mangled: string = mangle_generic_name(e.name, inst.generic_args);
                            if (!this.is_instantiation_already_exists(mangled, result.global_scope)) {
                                let ast_def: Option<Definition> = this.find_ast_def_by_name(unit.definitions, e.name);
                                if (ast_def.is_some()) {
                                    let spec_result: Option<BoundDefinition> = this.specialize_enum_def(
                                        e, inst.generic_args, mangled, result.global_scope);
                                    if (spec_result.is_some()) {
                                        if (this.verbose >= 2) { __builtin.eprintln("[EmperorPenguin Monomorphize]   Specialized enum " + mangled); }
                                        specialized_defs.push(spec_result.some);
                                        specialized_asts.push(ast_def.some);
                                    }
                                }
                            }
                        }
                    }
                    if (template_def is BoundDefinition.interface_def) {
                        let iface: BoundInterfaceDefinition = template_def.interface_def;
                        if (cast<i64>(iface.generic_params.size()) > 0) {
                            let mangled: string = mangle_generic_name(iface.name, inst.generic_args);
                            if (!this.is_instantiation_already_exists(mangled, result.global_scope)) {
                                let ast_def: Option<Definition> = this.find_ast_def_by_name(unit.definitions, iface.name);
                                if (ast_def.is_some()) {
                                    let spec_result: Option<BoundDefinition> = this.specialize_interface_def(
                                        iface, inst.generic_args, mangled, result.global_scope);
                                    if (spec_result.is_some()) {
                                        if (this.verbose >= 2) { __builtin.eprintln("[EmperorPenguin Monomorphize]   Specialized interface " + mangled); }
                                        specialized_defs.push(spec_result.some);
                                        specialized_asts.push(ast_def.some);
                                    }
                                }
                            }
                        }
                    }
                }
                i = i + 1;
            }

            // Collect function instantiations from AST
            let func_instantiations: mut _utils.List<FunctionInstantiation> = new _utils.List<FunctionInstantiation>();
            this.collect_function_instantiations_from_ast(unit.definitions, result.global_scope, func_instantiations);

            let fi: mut i64 = 0;
            while (fi < cast<i64>(func_instantiations.size())) {
                let inst: FunctionInstantiation = func_instantiations.at(cast<u64>(fi)).some;
                let mangled: string = mangle_generic_name(inst.func_name, inst.generic_args);
                let already_exists: mut bool = false;
                let check_i: mut i64 = 0;
                while (check_i < cast<i64>(specialized_defs.size())) {
                    let sd: BoundDefinition = specialized_defs.at(cast<u64>(check_i)).some;
                    if (sd is BoundDefinition.function_def) {
                        if (sd.function_def.name == mangled) {
                            already_exists = true;
                        }
                    }
                    check_i = check_i + 1;
                }
                // Also check result.definitions for specializations from previous iterations
                if (!already_exists) {
                    let check_j: mut i64 = 0;
                    while (check_j < cast<i64>(result.definitions.size())) {
                        let sd: BoundDefinition = result.definitions.at(cast<u64>(check_j)).some;
                        if (sd is BoundDefinition.function_def) {
                            if (sd.function_def.name == mangled) {
                                already_exists = true;
                            }
                        }
                        check_j = check_j + 1;
                    }
                }
                if (!already_exists) {
                    let tmpl_def: Option<BoundDefinition> = this.find_bound_function_def(result.definitions, inst.func_name);
                    if (tmpl_def.is_some() && tmpl_def.some is BoundDefinition.function_def) {
                        let tmpl_func: BoundFunctionDefinition = tmpl_def.some.function_def;
                        if (cast<i64>(tmpl_func.generic_params.size()) > 0) {
                            let ast_def: Option<Definition> = this.find_ast_def_by_name(unit.definitions, inst.func_name);
                            if (ast_def.is_some()) {
                                // Find the specialized class scope if this is a method in a specialized generic class
                                let method_class_scope: Option<BoundScope> = this.find_method_class_scope(result.definitions, specialized_defs, inst.func_name);
                                let spec_result: Option<BoundDefinition> = this.specialize_function_def(
                                    tmpl_func, inst.generic_args, mangled, result.global_scope, method_class_scope);
                                if (spec_result.is_some()) {
                                    if (this.verbose >= 2) { __builtin.eprintln("[EmperorPenguin Monomorphize]   Specialized function " + mangled); }
                                    specialized_defs.push(spec_result.some);
                                    specialized_asts.push(ast_def.some);
                                }
                            }
                        }
                    }
                }
                fi = fi + 1;
            }

            if (cast<i64>(specialized_defs.size()) == 0) {
                // No new specializations found, we're done
                if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Monomorphize] Completed in " + cast<string>(iteration) + " iterations, " + cast<string>(total_specialized) + " total specializations"); }
                return;
            }

            // Resolve types BEFORE pushing so mut reference updates persist
            let k: mut i64 = 0;
            while (k < cast<i64>(specialized_defs.size())) {
                let spec_def: BoundDefinition = specialized_defs.at(cast<u64>(k)).some;
                let ast_def: Definition = specialized_asts.at(cast<u64>(k)).some;
                if (spec_def is BoundDefinition.function_def) {
                    if (spec_def.function_def.scope.is_some()) {
                        specialized_defs.set(cast<u64>(k), this.resolve_pair(ast_def, spec_def, spec_def.function_def.scope.some));
                    } else {
                        specialized_defs.set(cast<u64>(k), this.resolve_pair(ast_def, spec_def, result.global_scope));
                    }
                    // Fix up 'this' parameter type for class method specializations
                    let updated_def: BoundDefinition = specialized_defs.at(cast<u64>(k)).some;
                    let parent_cls: Option<BoundClassDefinition> = this.find_parent_class_for_method(result.definitions, specialized_defs, updated_def.function_def.full_name);
                    if (parent_cls.is_some()) {
                        this.fix_this_param_type(updated_def.function_def, parent_cls.some);
                        specialized_defs.set(cast<u64>(k), updated_def);
                    }
                } else {
                    specialized_defs.set(cast<u64>(k), this.resolve_pair(ast_def, spec_def, result.global_scope));
                }
                k = k + 1;
            }

            let j: mut i64 = 0;
            while (j < cast<i64>(specialized_defs.size())) {
                result.definitions.push(specialized_defs.at(cast<u64>(j)).some);
                j = j + 1;
            }
            total_specialized = total_specialized + cast<i64>(specialized_defs.size());
            if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Monomorphize] Iteration " + cast<string>(iteration) + ": " + cast<string>(specialized_defs.size()) + " new specializations (total: " + cast<string>(total_specialized) + ")"); }
            iteration = iteration + 1;
        }
    }

    fun find_ast_def_by_name(this, defs: _utils.List<Definition>, name: string) -> Option<Definition> {
        _utils.trace_enter("Enter find_ast_def_by_name");
        // Search in reverse order so user-defined types override stdlib types
        let i: mut i64 = cast<i64>(defs.size()) - 1;
        while (i >= 0) {
            let def: Definition = defs.at(cast<u64>(i)).some;
            if (def is Definition.function_def) {
                if (def.function_def.name == name) {
                    return new Option<Definition>.some(def);
                }
            }
            if (def is Definition.class_def) {
                if (def.class_def.name == name) {
                    return new Option<Definition>.some(def);
                }
                // Also search class methods for generic method instantiation
                let members: _utils.List<Definition> = def.class_def.members;
                let mi: mut i64 = cast<i64>(members.size()) - 1;
                while (mi >= 0) {
                    let member: Definition = members.at(cast<u64>(mi)).some;
                    if (member is Definition.function_def) {
                        if (member.function_def.name == name) {
                            return new Option<Definition>.some(member);
                        }
                    }
                    mi = mi - 1;
                }
            }
            if (def is Definition.enum_def) {
                if (def.enum_def.name == name) {
                    return new Option<Definition>.some(def);
                }
            }
            if (def is Definition.interface_def) {
                if (def.interface_def.name == name) {
                    return new Option<Definition>.some(def);
                }
            }
            if (def is Definition.namespace_def) {
                let found: Option<Definition> = this.find_ast_def_by_name(def.namespace_def.children, name);
                if (found.is_some()) { return found; }
            }
            i = i - 1;
        }
        return new Option<Definition>.none();
    }

    fun find_ast_def_by_name_from_scope(this, name: string, scope: BoundScope) -> Option<Definition> {
        _utils.trace_enter("Enter find_ast_def_by_name_from_scope");
        return this.find_ast_def_by_name(this.ast_definitions, name);
    }

    fun mangle_generic_name_for_ir(base_name: string, generic_args: _utils.List<BoundType>) -> string {
        _utils.trace_enter("Enter mangle_generic_name_for_ir");
        return mangle_generic_name(base_name, generic_args);
    }

    fun replace_name_in_full_name(this, full_name: string, old_name: string, new_name: string) -> string {
        _utils.trace_enter("Enter replace_name_in_full_name");
        let dot_pos: i64 = string_find(full_name, "." + old_name);
        if (dot_pos >= 0) {
            let before: string = string_substring(full_name, 0, dot_pos);
            return before + "." + new_name;
        }
        return new_name;
    }

    fun collect_generic_instantiations(this, defs: _utils.List<BoundDefinition>, instantiations: mut _utils.List<BoundType>) {
        _utils.trace_enter("Enter collect_generic_instantiations");
        let i: mut i64 = 0;
        while (i < cast<i64>(defs.size())) {
            let def: BoundDefinition = defs.at(cast<u64>(i)).some;
            this.collect_instantiations_from_def(def, instantiations);
            i = i + 1;
        }
    }

    fun collect_instantiations_from_def(this, def: BoundDefinition, instantiations: mut _utils.List<BoundType>) {
        _utils.trace_enter("Enter collect_instantiations_from_def");
        if (def is BoundDefinition.class_def) {
            let cls: BoundClassDefinition = def.class_def;
            // Skip template classes - their type params produce error types
            if (cls.is_generic_template) { return; }
            let fi: mut i64 = 0;
            while (fi < cast<i64>(cls.fields.size())) {
                let fd: BoundDefinition = cls.fields.at(cast<u64>(fi)).some;
                if (fd is BoundDefinition.class_field) {
                    this.try_add_instantiation(fd.class_field.bound_type, instantiations);
                }
                fi = fi + 1;
            }
            let mi: mut i64 = 0;
            while (mi < cast<i64>(cls.methods.size())) {
                let md: BoundDefinition = cls.methods.at(cast<u64>(mi)).some;
                if (md is BoundDefinition.function_def) {
                    this.try_add_instantiation(md.function_def.return_type, instantiations);
                    let pi: mut i64 = 0;
                    while (pi < cast<i64>(md.function_def.parameters.size())) {
                        this.try_add_instantiation(md.function_def.parameters.at(cast<u64>(pi)).some.bound_type, instantiations);
                        pi = pi + 1;
                    }
                }
                mi = mi + 1;
            }
            // Collect generic interface instantiations from `impl IFoo<u8>` blocks
            // so the interface (and its default methods) get specialized.
            let ii: mut i64 = 0;
            while (ii < cast<i64>(cls.interface_impls.size())) {
                let id: BoundDefinition = cls.interface_impls.at(cast<u64>(ii)).some;
                if (id is BoundDefinition.impl_def) {
                    this.try_add_instantiation(id.impl_def.interface_type, instantiations);
                }
                ii = ii + 1;
            }
        }
        if (def is BoundDefinition.function_def) {
            let func: BoundFunctionDefinition = def.function_def;
            this.try_add_instantiation(func.return_type, instantiations);
            let pi: mut i64 = 0;
            while (pi < cast<i64>(func.parameters.size())) {
                this.try_add_instantiation(func.parameters.at(cast<u64>(pi)).some.bound_type, instantiations);
                pi = pi + 1;
            }
        }
        if (def is BoundDefinition.initial_routine) {
            let init: BoundInitialRoutineDefinition = def.initial_routine;
            if (init.scope.is_some()) {
                this.collect_instantiations_from_scope(init.scope.some, instantiations);
            }
        }
        if (def is BoundDefinition.namespace_def) {
            let ns: BoundNamespaceDefinition = def.namespace_def;
            let ci: mut i64 = 0;
            while (ci < cast<i64>(ns.children.size())) {
                this.collect_instantiations_from_def(ns.children.at(cast<u64>(ci)).some, instantiations);
                ci = ci + 1;
            }
        }
    }

    fun collect_instantiations_from_scope(this, scope: BoundScope, instantiations: mut _utils.List<BoundType>) {
        _utils.trace_enter("Enter collect_instantiations_from_scope");
        let si: mut i64 = 0;
        while (si < cast<i64>(scope.symbols.size())) {
            let sym: BoundSymbol = scope.symbols.at(cast<u64>(si)).some;
            if (sym is BoundSymbol.variable) {
                this.try_add_instantiation(sym.variable.bound_type, instantiations);
            }
            si = si + 1;
        }
        let ci: mut i64 = 0;
        while (ci < cast<i64>(scope.children.size())) {
            this.collect_instantiations_from_scope(scope.children.at(cast<u64>(ci)).some, instantiations);
            ci = ci + 1;
        }
    }

    fun try_add_instantiation(this, bt: BoundType, instantiations: mut _utils.List<BoundType>) {
        _utils.trace_enter("Enter try_add_instantiation");
        if (cast<i64>(bt.generic_args.size()) > 0 && bt.type_definition.is_some()) {
            let already: mut bool = false;
            let j: mut i64 = 0;
            while (j < cast<i64>(instantiations.size())) {
                if (bt.is_same_type(instantiations.at(cast<u64>(j)).some)) {
                    already = true;
                }
                j = j + 1;
            }
            if (!already) {
                instantiations.push(bt);
            }
        }
        let i: mut i64 = 0;
        while (i < cast<i64>(bt.generic_args.size())) {
            this.try_add_instantiation(bt.generic_args.at(cast<u64>(i)).some, instantiations);
            i = i + 1;
        }
    }

    fun collect_generic_instantiations_from_ast(this, defs: _utils.List<Definition>, bound_defs: _utils.List<BoundDefinition>, scope: BoundScope, instantiations: mut _utils.List<BoundType>) {
        _utils.trace_enter("Enter collect_generic_instantiations_from_ast");
        let i: mut i64 = 0;
        while (i < cast<i64>(defs.size())) {
            let def: Definition = defs.at(cast<u64>(i)).some;
            if (def is Definition.initial_routine) {
                if (def.initial_routine.body.is_some()) {
                    this.collect_from_ast_expr_safe(def.initial_routine.body.some, scope, instantiations);
                }
            }
            if (def is Definition.class_def) {
                // Skip template class bodies - their type params aren't resolvable here
                if (def.class_def.template_decl.is_none()) {
                    let members: _utils.List<Definition> = def.class_def.members;
                    let mi: mut i64 = 0;
                    while (mi < cast<i64>(members.size())) {
                        let member: Definition = members.at(cast<u64>(mi)).some;
                        if (member is Definition.function_def) {
                            if (member.function_def.body.is_some()) {
                                this.collect_from_ast_expr_safe(member.function_def.body.some, scope, instantiations);
                            }
                        }
                        mi = mi + 1;
                    }
                }
            }
            if (def is Definition.namespace_def) {
                // Find matching bound namespace to get its scope
        let ns_scope: BoundScope = if (i < cast<i64>(bound_defs.size())) {
            let bd: BoundDefinition = bound_defs.at(cast<u64>(i)).some;
            if (bd is BoundDefinition.namespace_def && bd.namespace_def.scope.is_some()) {
                bd.namespace_def.scope.some
            } else {
                scope
            }
        } else {
            scope
        };
        let ns_bound_children: _utils.List<BoundDefinition> = if (i < cast<i64>(bound_defs.size())) {
            let bd: BoundDefinition = bound_defs.at(cast<u64>(i)).some;
            if (bd is BoundDefinition.namespace_def && bd.namespace_def.scope.is_some()) {
                bd.namespace_def.children
            } else {
                new _utils.List<BoundDefinition>()
            }
        } else {
            new _utils.List<BoundDefinition>()
        };
                this.collect_generic_instantiations_from_ast(def.namespace_def.children, ns_bound_children, ns_scope, instantiations);
            }
            i = i + 1;
        }
    }

    fun collect_from_ast_expr_safe(this, expr: Expression, scope: BoundScope, instantiations: mut _utils.List<BoundType>) {
        _utils.trace_enter("Enter collect_from_ast_expr_safe");
        if (expr is Expression.new_expr) {
            let ne: NewExpression = expr.new_expr;
            if (cast<i64>(ne.generic_args.size()) > 0) {
                let resolved: Option<BoundType> = this.resolve_new_generic_args_from_ast(ne.type_name, ne.generic_args, scope);
                if (resolved.is_some()) {
                    this.try_add_instantiation(resolved.some, instantiations);
                }
            }
        }
        // Recurse into sub-expressions safely
        if (expr is Expression.function_call) {
            let fc: FunctionCallExpression = expr.function_call;
            if (fc.callee.is_some()) {
                this.collect_from_ast_expr_safe(fc.callee.some, scope, instantiations);
            }
            let ai: mut i64 = 0;
            while (ai < cast<i64>(fc.arguments.size())) {
                this.collect_from_ast_expr_safe(fc.arguments.at(cast<u64>(ai)).some, scope, instantiations);
                ai = ai + 1;
            }
        }
        if (expr is Expression.code_block) {
            let blk: CodeBlockExpression = expr.code_block;
            let si: mut i64 = 0;
            while (si < cast<i64>(blk.statements.size())) {
                let stmt: Statement = blk.statements.at(cast<u64>(si)).some;
                if (stmt is Statement.let_decl) {
                    if (stmt.let_decl.initializer.is_some()) {
                        this.collect_from_ast_expr_safe(stmt.let_decl.initializer.some, scope, instantiations);
                    }
                }
                if (stmt is Statement.expression) {
                    if (stmt.expression.expression.is_some()) {
                        this.collect_from_ast_expr_safe(stmt.expression.expression.some, scope, instantiations);
                    }
                }
                si = si + 1;
            }
        }
        if (expr is Expression.cast_expr) {
            let ce: CastExpression = expr.cast_expr;
            // A cast to a generic interface (e.g. cast<IFoo<u8>>(x)) must register
            // the instantiation so its default methods get monomorphized with the
            // concrete type args (otherwise their T-typed returns stay unresolved).
            if (let ts := ce.target_type.some) {
                if (cast<i64>(ts.generic_args.size()) > 0) {
                    let base_name: mut string = ts.name;
                    if (cast<i64>(ts.qualified_parts.size()) > 0) {
                        let sb2: mut StringBuilder = new StringBuilder();
                        let qi: mut i64 = 0;
                        while (qi < cast<i64>(ts.qualified_parts.size())) {
                            sb2.append(ts.qualified_parts.at(cast<u64>(qi)).some);
                            sb2.append(".");
                            qi = qi + 1;
                        }
                        sb2.append(ts.name);
                        base_name = sb2.to_string();
                    }
                    let resolved: Option<BoundType> = this.resolve_new_generic_args_from_ast(base_name, ts.generic_args, scope);
                    if (resolved.is_some()) {
                        this.try_add_instantiation(resolved.some, instantiations);
                    }
                }
            }
            if (ce.inner.is_some()) {
                this.collect_from_ast_expr_safe(ce.inner.some, scope, instantiations);
            }
        }
        if (expr is Expression.member_access) {
            let ma: MemberAccessExpression = expr.member_access;
            if (ma.base_expr.is_some()) {
                this.collect_from_ast_expr_safe(ma.base_expr.some, scope, instantiations);
            }
        }
    }

    fun resolve_new_generic_args_from_ast(this, type_name: string, generic_args: _utils.List<TypeSpecifier>, scope: BoundScope) -> Option<BoundType> {
        _utils.trace_enter("Enter resolve_new_generic_args_from_ast");
        // Resolve the base type, then apply the generic args. See
        // resolve_new_base_type_from_ast for why the trailing variant segment of an
        // enum new-expression ("Enum.variant") must be stripped.
        let base_type: Option<BoundType> = this.resolve_new_base_type_from_ast(type_name, scope);
        if (base_type.is_none()) { return new Option<BoundType>.none(); }

        let args: mut _utils.List<BoundType> = new _utils.List<BoundType>();
        let k: mut i64 = 0;
        while (k < cast<i64>(generic_args.size())) {
            let arg_ts: TypeSpecifier = generic_args.at(cast<u64>(k)).some;
            // req5: a value generic arg (A<5>) -> synthetic BoundType.
            if (arg_ts.is_value_arg) {
                let vbt: mut BoundType = new BoundType();
                vbt.is_template_value_arg = true;
                vbt.template_value = string_to_int(arg_ts.value_arg_text);
                args.push(vbt);
            } else {
                args.push(this.resolve_type_specifier(arg_ts, scope));
            }
            k = k + 1;
        }
        return new Option<BoundType>.some(base_type.some.with_generic_args(args));
    }

    // Resolve the base type named by a new-expression's type_name for the AST-driven
    // monomorphization collector. type_name may be qualified ("_utils.List"). For an
    // enum variant new the parser flattens `new Enum<T>.variant()` into type_name =
    // "Enum.variant" (the variant is appended after the generic args); "Enum.variant"
    // resolves to the enum *member*, not a type. Without stripping the trailing variant
    // segment, a generic enum used only as a local in an initial block (which the
    // bound-tree collector never sees) is never monomorphized — no LLVM type is emitted
    // and payload access falls back to i64. Try the full name, then strip one segment.
    fun resolve_new_base_type_from_ast(this, type_name: string, scope: BoundScope) -> Option<BoundType> {
        _utils.trace_enter("Enter resolve_new_base_type_from_ast");
        let found: Option<BoundSymbol> = this.resolve_type_by_name(type_name, scope);
        if (found.is_some()) {
            if (found.some is BoundSymbol.type_sym) {
                if (found.some.type_sym.bound_type.type_definition.is_some()) {
                    return new Option<BoundType>.some(found.some.type_sym.bound_type);
                }
            }
        }
        let dot: i64 = this.find_last_dot(type_name);
        if (dot > 0) {
            let base_name: string = string_substring(type_name, 0, dot);
            let found2: Option<BoundSymbol> = this.resolve_type_by_name(base_name, scope);
            if (found2.is_some()) {
                if (found2.some is BoundSymbol.type_sym) {
                    if (found2.some.type_sym.bound_type.type_definition.is_some()) {
                        return new Option<BoundType>.some(found2.some.type_sym.bound_type);
                    }
                }
            }
        }
        return new Option<BoundType>.none();
    }

    fun specialize_class_def(mut this, tmpl: BoundClassDefinition, type_args: _utils.List<BoundType>, mangled_name: string, global_scope: mut BoundScope) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter specialize_class_def");
        let ast_def: Option<Definition> = this.find_ast_def_by_name_from_scope(tmpl.name, global_scope);
        if (ast_def.is_none()) { return new Option<BoundDefinition>.none(); }
        if (!(ast_def.some is Definition.class_def)) { return new Option<BoundDefinition>.none(); }

        let ast_class: ClassDefinition = ast_def.some.class_def;
        // Use the original template's scope parent (namespace scope) so that
        // type resolution within the specialized class can find sibling types
        let scope_parent: mut Option<BoundScope> = new Option<BoundScope>.some(global_scope);
        if (tmpl.scope.is_some()) {
            scope_parent = tmpl.scope.some.parent;
        }
        let parent_full_name: mut string = global_scope.full_name;
        if (scope_parent.is_some()) {
            parent_full_name = scope_parent.some.full_name;
        }
        let full_name: string = parent_full_name + "." + mangled_name;
        let result: mut BoundClassDefinition = new BoundClassDefinition(mangled_name, full_name);
        let class_scope: mut BoundScope = new BoundScope(new ScopeKind.ClassScope(), mangled_name, full_name, scope_parent);

        let pi: mut i64 = 0;
        while (pi < cast<i64>(tmpl.generic_params.size()) && pi < cast<i64>(type_args.size())) {
            let param_name: string = tmpl.generic_params.at(cast<u64>(pi)).some;
            let arg_type: BoundType = type_args.at(cast<u64>(pi)).some;
            let param_sym: mut BoundTypeSymbol = new BoundTypeSymbol(param_name, full_name + "." + param_name);
            param_sym.bound_type = arg_type.with_mutability(arg_type.mutability);
            class_scope.add_symbol(new BoundSymbol.type_sym(param_sym));
            pi = pi + 1;
        }

        // req5: copy value-param names and bind their concrete values (the synthetic
        // value BoundTypes ride type_args) so member binding can substitute N -> constant.
        let vni: mut i64 = 0;
        while (vni < cast<i64>(tmpl.value_param_names.size())) {
            let vpname: string = tmpl.value_param_names.at(cast<u64>(vni)).some;
            result.value_param_names.push(vpname);
            let idx: mut i64 = -1;
            let gpi: mut i64 = 0;
            while (gpi < cast<i64>(tmpl.generic_params.size())) {
                if (tmpl.generic_params.at(cast<u64>(gpi)).some == vpname) { idx = gpi; }
                gpi = gpi + 1;
            }
            if (idx >= 0 && idx < cast<i64>(type_args.size())) {
                result.value_param_values.push(type_args.at(cast<u64>(idx)).some.template_value);
            } else {
                result.value_param_values.push(0);
            }
            vni = vni + 1;
        }

        result.scope = new Option<BoundScope>.some(class_scope);
        let type_sym: mut BoundTypeSymbol = new BoundTypeSymbol(mangled_name, full_name);
        let t: mut BoundType = new BoundType();
        t.kind = new TypeKind.ClassKind();
        t.type_definition = new Option<BoundDefinition>.some(new BoundDefinition.class_def(result));
        type_sym.bound_type = t;
        result.type_symbol = new Option<BoundTypeSymbol>.some(type_sym);
        result.bound_type = t;
        global_scope.add_symbol(new BoundSymbol.type_sym(type_sym));

        let i: mut i64 = 0;
        while (i < cast<i64>(ast_class.members.size())) {
            let member: Definition = ast_class.members.at(cast<u64>(i)).some;
            if (member is Definition.class_field) {
                let ast_field: ClassFieldDefinition = member.class_field;
                let field: mut BoundClassFieldDefinition = new BoundClassFieldDefinition(ast_field.name);
                let field_full_name: string = full_name + "." + ast_field.name;
                let fsym: mut BoundVariableSymbol = new BoundVariableSymbol();
                fsym.name = ast_field.name;
                fsym.full_name = field_full_name;
                fsym.variable_kind = new VariableSymbolKind.Field();
                // Read mutability from AST type_spec
                if (let ts := ast_field.type_spec.some) {
                    if (ts.is_not_mutable) {
                        fsym.is_mutable = false;
                        field.mutability = new Mutability.Immutable();
                    } else if (ts.is_auto_mutability) {
                        fsym.is_mutable = true;
                        field.mutability = new Mutability.Auto();
                    } else {
                        fsym.is_mutable = true;
                        field.mutability = new Mutability.Mutable();
                    }
                    field.bound_type = this.resolve_type_specifier(ast_field.type_spec.some, class_scope);
                } else {
                    fsym.is_mutable = true;
                    field.mutability = new Mutability.Mutable();
                }
                fsym.bound_type = field.bound_type;
                field.field_symbol = new Option<BoundVariableSymbol>.some(fsym);
                class_scope.add_symbol(new BoundSymbol.variable(fsym));
                result.fields.push(new BoundDefinition.class_field(field));
            }
            if (member is Definition.function_def) {
                let bound_member: Option<BoundDefinition> = this.bind_function_def(member.function_def, class_scope);
                if (bound_member.is_some()) {
                    if (bound_member.some is BoundDefinition.function_def) {
                        result.methods.push(new BoundDefinition.function_def(bound_member.some.function_def));
                    } else {
                        result.methods.push(bound_member.some);
                    }
                }
            }
            if (member is Definition.impl_def) {
                let bound_impl: Option<BoundDefinition> = this.bind_impl_def(member.impl_def, class_scope);
                if (bound_impl.is_some()) {
                    result.interface_impls.push(bound_impl.some);
                }
            }
            i = i + 1;
        }

        // Preserve the template's generic params + AST source so member access can
        // distinguish a generic-param field (`a: T`, implicitly immutable) from a
        // concrete field (`b: i32`, Auto → follows container mutability).
        let gpi: mut i64 = 0;
        while (gpi < cast<i64>(tmpl.generic_params.size())) {
            result.generic_params.push(tmpl.generic_params.at(cast<u64>(gpi)).some);
            gpi = gpi + 1;
        }
        result.ast_source = new Option<Definition>.some(new Definition.class_def(ast_class));

        return new Option<BoundDefinition>.some(new BoundDefinition.class_def(result));
    }

    fun specialize_enum_def(mut this, tmpl: BoundEnumDefinition, type_args: _utils.List<BoundType>, mangled_name: string, global_scope: mut BoundScope) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter specialize_enum_def");
        let ast_def: Option<Definition> = this.find_ast_def_by_name_from_scope(tmpl.name, global_scope);
        if (ast_def.is_none()) { return new Option<BoundDefinition>.none(); }
        if (!(ast_def.some is Definition.enum_def)) { return new Option<BoundDefinition>.none(); }

        let ast_enum: EnumDefinition = ast_def.some.enum_def;
        let scope_parent: mut Option<BoundScope> = new Option<BoundScope>.some(global_scope);
        if (tmpl.scope.is_some()) {
            scope_parent = tmpl.scope.some.parent;
        }
        let parent_full_name: mut string = global_scope.full_name;
        if (scope_parent.is_some()) {
            parent_full_name = scope_parent.some.full_name;
        }
        let full_name: string = parent_full_name + "." + mangled_name;
        let result: mut BoundEnumDefinition = new BoundEnumDefinition(mangled_name, full_name);
        let enum_scope: mut BoundScope = new BoundScope(new ScopeKind.EnumScope(), mangled_name, full_name, scope_parent);

        let pi: mut i64 = 0;
        while (pi < cast<i64>(tmpl.generic_params.size()) && pi < cast<i64>(type_args.size())) {
            let param_name: string = tmpl.generic_params.at(cast<u64>(pi)).some;
            let arg_type: BoundType = type_args.at(cast<u64>(pi)).some;
            let param_sym: mut BoundTypeSymbol = new BoundTypeSymbol(param_name, full_name + "." + param_name);
            param_sym.bound_type = arg_type.with_mutability(arg_type.mutability);
            enum_scope.add_symbol(new BoundSymbol.type_sym(param_sym));
            pi = pi + 1;
        }

        result.scope = new Option<BoundScope>.some(enum_scope);
        let type_sym: mut BoundTypeSymbol = new BoundTypeSymbol(mangled_name, full_name);
        let t: mut BoundType = new BoundType();
        t.kind = new TypeKind.EnumKind();
        t.type_definition = new Option<BoundDefinition>.some(new BoundDefinition.enum_def(result));
        type_sym.bound_type = t;
        result.type_symbol = new Option<BoundTypeSymbol>.some(type_sym);
        result.bound_type = t;
        global_scope.add_symbol(new BoundSymbol.type_sym(type_sym));

        let member_idx: mut i64 = 0;
        let i: mut i64 = 0;
        while (i < cast<i64>(ast_enum.members.size())) {
            let member: Definition = ast_enum.members.at(cast<u64>(i)).some;
            if (member is Definition.enum_member) {
                let payload_type: mut BoundType = this.type_registry.void_type;
                if (member.enum_member.type_spec.is_some()) {
                    payload_type = this.resolve_type_specifier(member.enum_member.type_spec.some, enum_scope);
                }
                let m: mut BoundEnumMemberDefinition = new BoundEnumMemberDefinition(member.enum_member.name, member_idx, payload_type);
                let msym: mut BoundEnumMemberSymbol = new BoundEnumMemberSymbol(member.enum_member.name, full_name + "." + member.enum_member.name, t, member_idx, payload_type);
                m.member_symbol = new Option<BoundEnumMemberSymbol>.some(msym);
                enum_scope.add_symbol(new BoundSymbol.enum_member(msym));
                result.members.push(m);
                member_idx = member_idx + 1;
            }
            if (member is Definition.impl_def) {
                let bound_impl: Option<BoundDefinition> = this.bind_impl_def(member.impl_def, enum_scope);
                if (bound_impl.is_some()) {
                    result.interface_impls.push(bound_impl.some);
                }
            }
            if (member is Definition.function_def) {
                let bound_method: Option<BoundDefinition> = this.bind_function_def(member.function_def, enum_scope);
                if (bound_method.is_some()) {
                    let bm: mut BoundDefinition = bound_method.some;
                    if (bm is BoundDefinition.function_def) {
                        this.resolve_enum_method_pair(member.function_def, bm.function_def, enum_scope, result);
                        bm = new BoundDefinition.function_def(bm.function_def);
                    }
                    result.methods.push(bm);
                }
            }
            i = i + 1;
        }

        return new Option<BoundDefinition>.some(new BoundDefinition.enum_def(result));
    }

    // Specialize a generic interface for concrete type args (e.g. IFoo<T> -> IFoo__u8).
    // Re-binds each default method in a scope where the type params map to the args,
    // so a default method `fun bar(this: IFoo<T>) -> T` specializes its signature and
    // body (T -> u8). Without this, lower_interface_def emits the unspecialized
    // template default method with an unresolved T-typed return.
    fun specialize_interface_def(mut this, tmpl: BoundInterfaceDefinition, type_args: _utils.List<BoundType>, mangled_name: string, global_scope: mut BoundScope) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter specialize_interface_def");
        let ast_def: Option<Definition> = this.find_ast_def_by_name_from_scope(tmpl.name, global_scope);
        if (ast_def.is_none()) { return new Option<BoundDefinition>.none(); }
        if (!(ast_def.some is Definition.interface_def)) { return new Option<BoundDefinition>.none(); }

        let ast_iface: InterfaceDefinition = ast_def.some.interface_def;
        let scope_parent: mut Option<BoundScope> = new Option<BoundScope>.some(global_scope);
        if (tmpl.scope.is_some()) {
            scope_parent = tmpl.scope.some.parent;
        }
        let parent_full_name: mut string = global_scope.full_name;
        if (scope_parent.is_some()) {
            parent_full_name = scope_parent.some.full_name;
        }
        let full_name: string = parent_full_name + "." + mangled_name;
        let result: mut BoundInterfaceDefinition = new BoundInterfaceDefinition(mangled_name, full_name);
        let iface_scope: mut BoundScope = new BoundScope(new ScopeKind.InterfaceScope(), mangled_name, full_name, scope_parent);

        // Register generic type params in the specialized scope so method
        // signatures and bodies resolve T -> the concrete type arg.
        let pi: mut i64 = 0;
        while (pi < cast<i64>(tmpl.generic_params.size()) && pi < cast<i64>(type_args.size())) {
            let param_name: string = tmpl.generic_params.at(cast<u64>(pi)).some;
            let arg_type: BoundType = type_args.at(cast<u64>(pi)).some;
            let param_sym: mut BoundTypeSymbol = new BoundTypeSymbol(param_name, full_name + "." + param_name);
            param_sym.bound_type = arg_type.with_mutability(arg_type.mutability);
            iface_scope.add_symbol(new BoundSymbol.type_sym(param_sym));
            pi = pi + 1;
        }

        result.scope = new Option<BoundScope>.some(iface_scope);
        let type_sym: mut BoundTypeSymbol = new BoundTypeSymbol(mangled_name, full_name);
        let t: mut BoundType = new BoundType();
        t.kind = new TypeKind.InterfaceKind();
        t.type_definition = new Option<BoundDefinition>.some(new BoundDefinition.interface_def(result));
        type_sym.bound_type = t;
        result.type_symbol = new Option<BoundTypeSymbol>.some(type_sym);
        result.bound_type = t;
        global_scope.add_symbol(new BoundSymbol.type_sym(type_sym));

        let i: mut i64 = 0;
        while (i < cast<i64>(ast_iface.members.size())) {
            let member: Definition = ast_iface.members.at(cast<u64>(i)).some;
            if (member is Definition.function_def) {
                let bound_member: Option<BoundDefinition> = this.bind_function_def(member.function_def, iface_scope);
                if (bound_member.is_some()) {
                    result.methods.push(bound_member.some);
                }
            }
            if (member is Definition.impl_def) {
                // Nested interface impl (interface inheritance): re-bind in the
                // specialized scope so the impl's `impl IFoo<T>` resolves T -> arg.
                let bound_impl: Option<BoundDefinition> = this.bind_impl_def(member.impl_def, iface_scope);
                if (bound_impl.is_some()) {
                    result.interface_impls.push(bound_impl.some);
                }
            }
            i = i + 1;
        }
        result.ast_source = new Option<Definition>.some(new Definition.interface_def(ast_iface));
        return new Option<BoundDefinition>.some(new BoundDefinition.interface_def(result));
    }

    fun pass_constructors(mut this, result: BoundCompilationUnit) {
        _utils.trace_enter("Enter pass_constructors");
        let i: mut i64 = 0;
        while (i < cast<i64>(result.definitions.size())) {
            let updated: BoundDefinition = this.init_constructors_for_def(result.definitions.at(cast<u64>(i)).some, result.global_scope);
            result.definitions.set(cast<u64>(i), updated);
            i = i + 1;
        }
        let j: mut i64 = 0;
        while (j < cast<i64>(result.definitions.size())) {
            let updated: BoundDefinition = this.process_constructors_for_def(result.definitions.at(cast<u64>(j)).some);
            result.definitions.set(cast<u64>(j), updated);
            j = j + 1;
        }
    }

    fun init_constructors_for_def(mut this, def: BoundDefinition, global_scope: mut BoundScope) -> BoundDefinition {
        _utils.trace_enter("Enter init_constructors_for_def");
        if (def is BoundDefinition.class_def) {
            let cls: mut BoundClassDefinition = def.class_def;
            this.init_class_constructor(cls, global_scope);
            return new BoundDefinition.class_def(cls);
        }
        if (def is BoundDefinition.interface_def) {
            let iface: mut BoundInterfaceDefinition = def.interface_def;
            this.init_interface_constructor(iface, global_scope);
            return new BoundDefinition.interface_def(iface);
        }
        if (def is BoundDefinition.namespace_def) {
            let ns: mut BoundNamespaceDefinition = def.namespace_def;
            let k: mut i64 = 0;
            while (k < cast<i64>(ns.children.size())) {
                let updated: BoundDefinition = this.init_constructors_for_def(ns.children.at(cast<u64>(k)).some, global_scope);
                ns.children.set(cast<u64>(k), updated);
                k = k + 1;
            }
            return new BoundDefinition.namespace_def(ns);
        }
        return def;
    }

    fun process_constructors_for_def(mut this, def: BoundDefinition) -> BoundDefinition {
        _utils.trace_enter("Enter process_constructors_for_def");
        if (def is BoundDefinition.namespace_def) {
            let ns: mut BoundNamespaceDefinition = def.namespace_def;
            let k: mut i64 = 0;
            while (k < cast<i64>(ns.children.size())) {
                let updated: BoundDefinition = this.process_constructors_for_def(ns.children.at(cast<u64>(k)).some);
                ns.children.set(cast<u64>(k), updated);
                k = k + 1;
            }
            return new BoundDefinition.namespace_def(ns);
        }
        return def;
    }

    fun init_class_constructor(mut this, cls: mut BoundClassDefinition, global_scope: mut BoundScope) {
        _utils.trace_enter("Enter init_class_constructor");
        let found_idx: mut i64 = -1;
        let i: mut i64 = 0;
        while (i < cast<i64>(cls.methods.size())) {
            let md: BoundDefinition = cls.methods.at(cast<u64>(i)).some;
            if (md is BoundDefinition.function_def) {
                if (md.function_def.is_new) {
                    found_idx = i;
                }
            }
            i = i + 1;
        }
        if (found_idx >= 0) {
            let ctor_def: BoundDefinition = cls.methods.at(cast<u64>(found_idx)).some;
            let ctor: mut BoundFunctionDefinition = ctor_def.function_def;
            cls.constructor = new Option<BoundFunctionDefinition>.some(ctor);
            cls.constructors.push(ctor_def);
        } else {
            let ctor_full_name: string = cls.full_name + ".new";
            let ctor: mut BoundFunctionDefinition = new BoundFunctionDefinition("new", ctor_full_name, false, false, true, false);
            let this_param: mut BoundFunctionParameter = new BoundFunctionParameter("this", 0, true, true);
            this_param.bound_type = cls.bound_type.with_mutability(new Mutability.Mutable());
            ctor.parameters.push(this_param);
            ctor.return_type = this.type_registry.void_type;
            let ctor_scope: mut BoundScope = new BoundScope(new ScopeKind.FunctionScope(), "new", ctor_full_name + ".<body>", cls.scope);
            ctor.scope = new Option<BoundScope>.some(ctor_scope);
            let sym: mut BoundFunctionSymbol = new BoundFunctionSymbol("new", ctor_full_name);
            sym.is_new = true;
            let param_types: mut _utils.List<BoundType> = new _utils.List<BoundType>();
            param_types.push(this_param.bound_type);
            sym.bound_type = this.type_registry.make_function_type(this.type_registry.void_type, param_types, false);
            sym.return_type = this.type_registry.void_type;
            ctor.symbol = new Option<BoundFunctionSymbol>.some(sym);
            if (cls.scope.is_some()) {
                let class_scope: mut BoundScope = cls.scope.some;
                class_scope.add_symbol(new BoundSymbol.function_sym(sym));
            }
            cls.constructor = new Option<BoundFunctionDefinition>.some(ctor);
            cls.constructors.push(new BoundDefinition.function_def(ctor));
        }
    }

    fun init_interface_constructor(mut this, iface: mut BoundInterfaceDefinition, global_scope: mut BoundScope) {
        _utils.trace_enter("Enter init_interface_constructor");
        let found_idx: mut i64 = -1;
        let i: mut i64 = 0;
        while (i < cast<i64>(iface.methods.size())) {
            let md: BoundDefinition = iface.methods.at(cast<u64>(i)).some;
            if (md is BoundDefinition.function_def) {
                if (md.function_def.is_new) {
                    found_idx = i;
                }
            }
            i = i + 1;
        }
        if (found_idx >= 0) {
            let ctor_def: BoundDefinition = iface.methods.at(cast<u64>(found_idx)).some;
            let ctor: BoundFunctionDefinition = ctor_def.function_def;
        } else {
            let ctor_full_name: string = iface.full_name + ".new";
            let ctor: mut BoundFunctionDefinition = new BoundFunctionDefinition("new", ctor_full_name, false, false, true, false);
            let this_param: mut BoundFunctionParameter = new BoundFunctionParameter("this", 0, true, true);
            this_param.bound_type = iface.bound_type.with_mutability(new Mutability.Mutable());
            ctor.parameters.push(this_param);
            ctor.return_type = this.type_registry.void_type;
            let sym: mut BoundFunctionSymbol = new BoundFunctionSymbol("new", ctor_full_name);
            sym.is_new = true;
            let param_types: mut _utils.List<BoundType> = new _utils.List<BoundType>();
            param_types.push(this_param.bound_type);
            sym.bound_type = this.type_registry.make_function_type(this.type_registry.void_type, param_types, false);
            sym.return_type = this.type_registry.void_type;
            ctor.symbol = new Option<BoundFunctionSymbol>.some(sym);
            if (iface.scope.is_some()) {
                let iface_scope: mut BoundScope = iface.scope.some;
                iface_scope.add_symbol(new BoundSymbol.function_sym(sym));
            }
        }
    }

    fun pass_interface_implementation(mut this, unit: CompilationUnit, result: BoundCompilationUnit) {
        _utils.trace_enter("Enter pass_interface_implementation");
        let ast_count: i64 = cast<i64>(unit.definitions.size());
        let i: mut i64 = 0;
        while (i < cast<i64>(result.definitions.size())) {
            if (i < ast_count) {
                let ast_def: Definition = unit.definitions.at(cast<u64>(i)).some;
                let bound_def: BoundDefinition = result.definitions.at(cast<u64>(i)).some;
                result.definitions.set(cast<u64>(i), this.build_vtables_for_def(ast_def, bound_def, result.global_scope));
            } else {
                let bound_def: BoundDefinition = result.definitions.at(cast<u64>(i)).some;
                result.definitions.set(cast<u64>(i), this.build_vtables_for_specialized_def(bound_def, result.global_scope));
            }
            i = i + 1;
        }
        // Phase 2: merge inherited interface vtables (transitive interface
        // inheritance). A class implementing IBar<u8> (which itself implements
        // IFoo<u8> via a nested impl) must also carry an IFoo<u8> vtable. Done
        // after Phase 1 so specialized interfaces' own vtables exist first.
        // Walks the bound tree recursively (classes may be nested in namespaces).
        let m: mut i64 = 0;
        while (m < cast<i64>(result.definitions.size())) {
            this.merge_inherited_vtables_for_def(result.definitions.at(cast<u64>(m)).some, result.global_scope);
            m = m + 1;
        }
    }

    fun merge_inherited_vtables_for_def(mut this, def: BoundDefinition, global_scope: BoundScope) {
        _utils.trace_enter("Enter merge_inherited_vtables_for_def");
        if (def is BoundDefinition.class_def) {
            this.merge_container_vtables(def.class_def.vtables, def.class_def.interface_impls, global_scope);
        }
        if (def is BoundDefinition.enum_def) {
            this.merge_container_vtables(def.enum_def.vtables, def.enum_def.interface_impls, global_scope);
        }
        if (def is BoundDefinition.namespace_def) {
            let ns: BoundNamespaceDefinition = def.namespace_def;
            let ci: mut i64 = 0;
            while (ci < cast<i64>(ns.children.size())) {
                this.merge_inherited_vtables_for_def(ns.children.at(cast<u64>(ci)).some, global_scope);
                ci = ci + 1;
            }
        }
    }

    // Transitive interface-inheritance merge. A worklist is seeded from the
    // container's own impls (their interface_types carry generic args, e.g.
    // IBar<u8>), then each is resolved to its specialized def and its nested-impl
    // vtables copied into the container; copied vtables' interface types are
    // added back to the worklist so multi-level chains (IBaz -> IBar -> IFoo) are
    // flattened to any depth.
    fun merge_container_vtables(mut this, container_vtables: mut _utils.List<BoundVTable>, seed_impls: _utils.List<BoundDefinition>, global_scope: BoundScope) {
        _utils.trace_enter("Enter merge_container_vtables");
        let worklist: mut _utils.List<BoundType> = new _utils.List<BoundType>();
        let si: mut i64 = 0;
        while (si < cast<i64>(seed_impls.size())) {
            let sd: BoundDefinition = seed_impls.at(cast<u64>(si)).some;
            if (sd is BoundDefinition.impl_def) {
                worklist.push(sd.impl_def.interface_type);
            }
            si = si + 1;
        }
        let processed: mut _utils.List<string> = new _utils.List<string>();
        let wi: mut i64 = 0;
        while (wi < cast<i64>(worklist.size())) {
            let iface_type: BoundType = worklist.at(cast<u64>(wi)).some;
            wi = wi + 1;
            let iface_name: string = iface_type.display_name();
            let already_processed: mut bool = false;
            let pi: mut i64 = 0;
            while (pi < cast<i64>(processed.size())) {
                if (processed.at(cast<u64>(pi)).some == iface_name) { already_processed = true; }
                pi = pi + 1;
            }
            if (already_processed) { continue; }
            processed.push(iface_name);
            let src_opt: Option<BoundInterfaceDefinition> = this.specialized_interface_for_type(iface_type, global_scope);
            if (src_opt.is_none()) { continue; }
            let src: BoundInterfaceDefinition = src_opt.some;
            let j: mut i64 = 0;
            while (j < cast<i64>(src.vtables.size())) {
                let svt: BoundVTable = src.vtables.at(cast<u64>(j)).some;
                if (!this.has_vtable_for_interface(container_vtables, svt.interface_type)) {
                    let new_vt: mut BoundVTable = new BoundVTable();
                    new_vt.interface_type = svt.interface_type;
                    let k: mut i64 = 0;
                    while (k < cast<i64>(svt.slots.size())) {
                        let slot: BoundVTableSlot = svt.slots.at(cast<u64>(k)).some;
                        let ns: mut BoundVTableSlot = new BoundVTableSlot();
                        ns.interface_method = slot.interface_method;
                        ns.implementation_method = slot.implementation_method;
                        new_vt.slots.push(ns);
                        k = k + 1;
                    }
                    container_vtables.push(new_vt);
                    worklist.push(svt.interface_type);
                }
                j = j + 1;
            }
        }
    }

    // Resolve the (possibly specialized) interface def for a BoundType that
    // references an interface (e.g. IBar<u8>). Returns the template for
    // non-generic types, or none if not an interface.
    fun specialized_interface_for_type(this, iface_type: BoundType, global_scope: BoundScope) -> Option<BoundInterfaceDefinition> {
        _utils.trace_enter("Enter specialized_interface_for_type");
        if (iface_type.type_definition.is_none()) { return new Option<BoundInterfaceDefinition>.none(); }
        let td: BoundDefinition = iface_type.type_definition.some;
        if (!(td is BoundDefinition.interface_def)) { return new Option<BoundInterfaceDefinition>.none(); }
        let tmpl: BoundInterfaceDefinition = td.interface_def;
        if (cast<i64>(iface_type.generic_args.size()) > 0) {
            let mangled: string = mangle_generic_name(tmpl.name, iface_type.generic_args);
            let spec_sym: Option<BoundSymbol> = global_scope.lookup_type_in_scope(mangled);
            if (spec_sym.is_some()) {
                if (spec_sym.some is BoundSymbol.type_sym) {
                    if (let spec_td := spec_sym.some.type_sym.bound_type.type_definition.some) {
                        if (spec_td is BoundDefinition.interface_def) {
                            return new Option<BoundInterfaceDefinition>.some(spec_td.interface_def);
                        }
                    }
                }
            }
        }
        return new Option<BoundInterfaceDefinition>.some(tmpl);
    }

    fun build_vtables_for_specialized_def(mut this, bound_def: BoundDefinition, global_scope: mut BoundScope) -> BoundDefinition {
        _utils.trace_enter("Enter build_vtables_for_specialized_def");
        if (bound_def is BoundDefinition.class_def) {
            let cls: mut BoundClassDefinition = bound_def.class_def;
            let ast_def: Option<Definition> = this.find_ast_def_by_name(this.ast_definitions, this.extract_template_name(cls.name));
            if (ast_def.is_some() && ast_def.some is Definition.class_def) {
                this.build_class_vtables(ast_def.some.class_def, cls, global_scope);
            }
            return new BoundDefinition.class_def(cls);
        }
        if (bound_def is BoundDefinition.enum_def) {
            let e: mut BoundEnumDefinition = bound_def.enum_def;
            let ast_def: Option<Definition> = this.find_ast_def_by_name(this.ast_definitions, this.extract_template_name(e.name));
            if (ast_def.is_some() && ast_def.some is Definition.enum_def) {
                this.build_enum_vtables(ast_def.some.enum_def, e, global_scope);
            }
            return new BoundDefinition.enum_def(e);
        }
        if (bound_def is BoundDefinition.interface_def) {
            let iface: mut BoundInterfaceDefinition = bound_def.interface_def;
            let ast_def: Option<Definition> = this.find_ast_def_by_name(this.ast_definitions, this.extract_template_name(iface.name));
            if (ast_def.is_some()) {
                if (ast_def.some is Definition.interface_def) {
                    this.build_interface_vtables(ast_def.some.interface_def, iface, global_scope);
                }
            }
            return new BoundDefinition.interface_def(iface);
        }
        return bound_def;
    }

    fun extract_template_name(this, mangled_name: string) -> string {
        _utils.trace_enter("Enter extract_template_name");
        let pos: i64 = string_find(mangled_name, "__");
        if (pos >= 0) {
            return string_substring(mangled_name, 0, pos);
        }
        return mangled_name;
    }

    fun build_vtables_for_def(mut this, ast_def: Definition, bound_def: BoundDefinition, global_scope: mut BoundScope) -> BoundDefinition {
        _utils.trace_enter("Enter build_vtables_for_def");
        if (bound_def is BoundDefinition.class_def && ast_def is Definition.class_def) {
            let cls: mut BoundClassDefinition = bound_def.class_def;
            this.build_class_vtables(ast_def.class_def, cls, global_scope);
            return new BoundDefinition.class_def(cls);
        }
        if (bound_def is BoundDefinition.interface_def && ast_def is Definition.interface_def) {
            let iface: mut BoundInterfaceDefinition = bound_def.interface_def;
            this.build_interface_vtables(ast_def.interface_def, iface, global_scope);
            return new BoundDefinition.interface_def(iface);
        }
        if (bound_def is BoundDefinition.enum_def && ast_def is Definition.enum_def) {
            let e: mut BoundEnumDefinition = bound_def.enum_def;
            this.build_enum_vtables(ast_def.enum_def, e, global_scope);
            return new BoundDefinition.enum_def(e);
        }
        if (bound_def is BoundDefinition.impl_for_def && ast_def is Definition.impl_for_def) {
            let impl_for: mut BoundInterfaceForImplementation = bound_def.impl_for_def;
            this.process_impl_for(ast_def.impl_for_def, impl_for, global_scope, global_scope);
            return new BoundDefinition.impl_for_def(impl_for);
        }
        if (bound_def is BoundDefinition.namespace_def && ast_def is Definition.namespace_def) {
            let ns: mut BoundNamespaceDefinition = bound_def.namespace_def;
            let ns_scope: mut BoundScope = ns.scope.some;
            let k: mut i64 = 0;
            while (k < cast<i64>(ns.children.size())) {
                let bound_child: BoundDefinition = ns.children.at(cast<u64>(k)).some;
                let ast_child: Option<Definition> = this.find_matching_ast_child(ast_def.namespace_def, bound_child);
                if (ast_child.is_some()) {
                    ns.children.set(cast<u64>(k), this.build_vtables_for_def(ast_child.some, bound_child, ns_scope));
                }
                k = k + 1;
            }
            return new BoundDefinition.namespace_def(ns);
        }
        return bound_def;
    }

    fun find_matching_ast_child(this, ast_ns: NamespaceDefinition, bound_child: BoundDefinition) -> Option<Definition> {
        _utils.trace_enter("Enter find_matching_ast_child");
        let i: mut i64 = 0;
        while (i < cast<i64>(ast_ns.children.size())) {
            let ast_child: Definition = ast_ns.children.at(cast<u64>(i)).some;
            if (ast_child is Definition.function_def && bound_child is BoundDefinition.function_def) {
                if (ast_child.function_def.name == bound_child.function_def.name) {
                    return new Option<Definition>.some(ast_child);
                }
            }
            if (ast_child is Definition.class_def && bound_child is BoundDefinition.class_def) {
                if (ast_child.class_def.name == bound_child.class_def.name) {
                    return new Option<Definition>.some(ast_child);
                }
            }
            if (ast_child is Definition.interface_def && bound_child is BoundDefinition.interface_def) {
                if (ast_child.interface_def.name == bound_child.interface_def.name) {
                    return new Option<Definition>.some(ast_child);
                }
            }
            if (ast_child is Definition.enum_def && bound_child is BoundDefinition.enum_def) {
                if (ast_child.enum_def.name == bound_child.enum_def.name) {
                    return new Option<Definition>.some(ast_child);
                }
            }
            if (ast_child is Definition.impl_for_def && bound_child is BoundDefinition.impl_for_def) {
                return new Option<Definition>.some(ast_child);
            }
            if (ast_child is Definition.initial_routine && bound_child is BoundDefinition.initial_routine) {
                return new Option<Definition>.some(ast_child);
            }
            if (ast_child is Definition.global_var && bound_child is BoundDefinition.global_var_def) {
                if (ast_child.global_var.name == bound_child.global_var_def.name) {
                    return new Option<Definition>.some(ast_child);
                }
            }
            i = i + 1;
        }
        return new Option<Definition>.none();
    }

    fun build_class_vtables(mut this, ast_cls: ClassDefinition, bound_cls: mut BoundClassDefinition, global_scope: mut BoundScope) {
        _utils.trace_enter("Enter build_class_vtables");
        let class_scope: mut BoundScope = bound_cls.scope.some;
        let i: mut i64 = 0;
        while (i < cast<i64>(ast_cls.members.size())) {
            let member: Definition = ast_cls.members.at(cast<u64>(i)).some;
            if (member is Definition.impl_def) {
                let impl_entry: InterfaceImplementation = member.impl_def;
                let iface_type: mut BoundType = this.resolve_type_name(impl_entry.type_name, global_scope, impl_entry.location);
                // A class may have several `impl IFoo<u8>` blocks; build only one
                // vtable per interface (build_vtable_slots scans the whole class
                // scope for overrides, so one pass covers all blocks).
                if (!this.has_vtable_for_interface(bound_cls.vtables, iface_type)) {
                    let vtable: mut BoundVTable = new BoundVTable();
                    vtable.interface_type = iface_type;
                    this.build_vtable_slots(impl_entry, vtable, global_scope, class_scope);
                    bound_cls.vtables.push(vtable);
                }
            }
            i = i + 1;
        }
    }

    fun has_vtable_for_interface(this, vtables: _utils.List<BoundVTable>, iface_type: BoundType) -> bool {
        _utils.trace_enter("Enter has_vtable_for_interface");
        let i: mut i64 = 0;
        while (i < cast<i64>(vtables.size())) {
            if (vtables.at(cast<u64>(i)).some.interface_type.display_name() == iface_type.display_name()) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    fun build_enum_vtables(mut this, ast_enum: EnumDefinition, bound_enum: mut BoundEnumDefinition, global_scope: mut BoundScope) {
        _utils.trace_enter("Enter build_enum_vtables");
        let enum_scope: mut BoundScope = bound_enum.scope.some;
        let i: mut i64 = 0;
        while (i < cast<i64>(ast_enum.members.size())) {
            let member: Definition = ast_enum.members.at(cast<u64>(i)).some;
            if (member is Definition.impl_def) {
                let impl_entry: InterfaceImplementation = member.impl_def;
                let iface_type: mut BoundType = this.resolve_type_name(impl_entry.type_name, global_scope, impl_entry.location);
                if (!this.has_vtable_for_interface(bound_enum.vtables, iface_type)) {
                    let vtable: mut BoundVTable = new BoundVTable();
                    vtable.interface_type = iface_type;
                    this.build_vtable_slots(impl_entry, vtable, global_scope, enum_scope);
                    bound_enum.vtables.push(vtable);
                }
            }
            i = i + 1;
        }
    }

    fun build_interface_vtables(mut this, ast_iface: InterfaceDefinition, bound_iface: mut BoundInterfaceDefinition, global_scope: mut BoundScope) {
        _utils.trace_enter("Enter build_interface_vtables");
        // Generic interface templates are not processed here: their nested
        // `impl IFoo<T>` blocks reference the unresolved type param T. They are
        // specialized per instantiation (IBar<u8> -> IBar__u8) and the
        // specialized defs build the concrete nested-impl vtables.
        if (cast<i64>(bound_iface.generic_params.size()) > 0) {
            return;
        }
        let iface_scope: mut BoundScope = bound_iface.scope.some;
        let i: mut i64 = 0;
        while (i < cast<i64>(ast_iface.members.size())) {
            let member: Definition = ast_iface.members.at(cast<u64>(i)).some;
            if (member is Definition.impl_def) {
                let impl_entry: InterfaceImplementation = member.impl_def;
                let iface_type: mut BoundType = this.resolve_type_name(impl_entry.type_name, global_scope, impl_entry.location);
                let vtable: mut BoundVTable = new BoundVTable();
                vtable.interface_type = iface_type;
                this.build_vtable_slots(impl_entry, vtable, global_scope, iface_scope);
                bound_iface.vtables.push(vtable);
            }
            i = i + 1;
        }
    }

    // For a generic interface impl (impl IFoo<u8>), resolve the specialized
    // interface def (IFoo__u8) so default-method slots point to the specialized
    // (emitted) default rather than the unemitted template. Returns the template
    // for non-generic impls or if the specialization can't be found.
    // Type args are resolved in `arg_scope` (the impl's enclosing scope) so a
    // nested interface impl like IBar<T> { impl IFoo<T> {...} } resolves T from
    // IBar's scope; the specialized def is looked up in global_scope.
    fun resolve_specialized_interface(this, tmpl_iface: BoundInterfaceDefinition, impl_entry: InterfaceImplementation, arg_scope: BoundScope, global_scope: BoundScope) -> BoundInterfaceDefinition {
        _utils.trace_enter("Enter resolve_specialized_interface");
        if (impl_entry.type_spec.is_some()) {
            if (cast<i64>(impl_entry.type_spec.some.generic_args.size()) > 0) {
                let args: mut _utils.List<BoundType> = new _utils.List<BoundType>();
                let gi: mut i64 = 0;
                while (gi < cast<i64>(impl_entry.type_spec.some.generic_args.size())) {
                    args.push(this.resolve_type_specifier(impl_entry.type_spec.some.generic_args.at(cast<u64>(gi)).some, arg_scope));
                    gi = gi + 1;
                }
                let mangled: string = mangle_generic_name(tmpl_iface.name, args);
                let spec_sym: Option<BoundSymbol> = global_scope.lookup_type_in_scope(mangled);
                if (spec_sym.is_some()) {
                    if (spec_sym.some is BoundSymbol.type_sym) {
                        if (let spec_td := spec_sym.some.type_sym.bound_type.type_definition.some) {
                            if (spec_td is BoundDefinition.interface_def) {
                                return spec_td.interface_def;
                            }
                        }
                    }
                }
            }
        }
        return tmpl_iface;
    }

    fun build_vtable_slots(mut this, impl_entry: InterfaceImplementation, vtable: mut BoundVTable, global_scope: mut BoundScope, impl_scope: mut BoundScope) {
        _utils.trace_enter("Enter build_vtable_slots");
        // Build one vtable slot per non-constructor interface method, in interface
        // declaration order (matches resolve_vtable_slot's index computation). Each
        // slot points to the class's override if it provides one, otherwise to the
        // interface's default method — for a generic interface, the specialized
        // default (ns_IFoo__u8_bar) so the slot references an emitted function.
        // Use the already-resolved vtable.interface_type rather than a name lookup
        // (the interface may be nested in a namespace the bare lookup can't reach).
        if (vtable.interface_type.type_definition.is_none()) { return; }
        let tmpl_td: BoundDefinition = vtable.interface_type.type_definition.some;
        if (!(tmpl_td is BoundDefinition.interface_def)) { return; }
        let tmpl_iface: BoundInterfaceDefinition = tmpl_td.interface_def;
        let spec_iface: BoundInterfaceDefinition = this.resolve_specialized_interface(tmpl_iface, impl_entry, impl_scope, global_scope);
        let i: mut i64 = 0;
        while (i < cast<i64>(tmpl_iface.methods.size())) {
            let md: BoundDefinition = tmpl_iface.methods.at(cast<u64>(i)).some;
            if (md is BoundDefinition.function_def) {
                if (md.function_def.name != "new") {
                    let slot: mut BoundVTableSlot = new BoundVTableSlot();
                    if (md.function_def.symbol.is_some()) {
                        slot.interface_method = new Option<BoundFunctionSymbol>.some(md.function_def.symbol.some);
                    }
                    let mname: string = md.function_def.name;
                    let override_sym: Option<BoundSymbol> = impl_scope.lookup_symbol(mname);
                    if (override_sym.is_some()) {
                        if (override_sym.some is BoundSymbol.function_sym) {
                            slot.implementation_method = new Option<BoundFunctionSymbol>.some(override_sym.some.function_sym);
                        }
                    } else if (spec_iface.scope.is_some()) {
                        let def_sym: Option<BoundSymbol> = spec_iface.scope.some.lookup_symbol(mname);
                        if (def_sym.is_some()) {
                            if (def_sym.some is BoundSymbol.function_sym) {
                                // Skip extern interface methods with no user override
                                // (e.g. ICopy.copy) — the LLVM backend handles these
                                // natively (e.g. value-type struct copy) and the extern
                                // function body is never generated, so the vtable entry
                                // would reference an undefined symbol.
                                if (!def_sym.some.function_sym.is_extern) {
                                    slot.implementation_method = new Option<BoundFunctionSymbol>.some(def_sym.some.function_sym);
                                }
                            }
                        }
                    }
                    vtable.slots.push(slot);
                }
            }
            i = i + 1;
        }
    }

    fun process_impl_for(mut this, ast_impl: InterfaceForImplementation, bound_impl: mut BoundInterfaceForImplementation, global_scope: mut BoundScope, impl_scope: mut BoundScope) {
        _utils.trace_enter("Enter process_impl_for");
        let iface_type: mut BoundType = this.resolve_type_name(ast_impl.type_name, impl_scope, ast_impl.location);
        let for_type: mut BoundType = this.resolve_type_name(ast_impl.for_type_name, impl_scope, ast_impl.location);
        bound_impl.interface_type = iface_type;
        bound_impl.for_type = for_type;
        // Orphan principle: at least one of (interface, target type) must be in
        // the same namespace as the impl block.
        if (this.check_orphan_impl(iface_type, for_type, impl_scope)) {
            this.report_error(new ErrorCode.E_ORPHAN_IMPL(),
                "impl " + ast_impl.type_name + " for " + ast_impl.for_type_name
                + " is orphaned - neither the interface nor the target type is "
                + "defined in the current namespace. At least one must be local.",
                ast_impl.location);
        }
        let vtable: mut BoundVTable = new BoundVTable();
        vtable.interface_type = iface_type;
        let i: mut i64 = 0;
        while (i < cast<i64>(ast_impl.functions.size())) {
            let func: Definition = ast_impl.functions.at(cast<u64>(i)).some;
            if (func is Definition.function_def) {
                let slot: mut BoundVTableSlot = new BoundVTableSlot();
                let iface_sym: Option<BoundSymbol> = impl_scope.lookup_type_in_scope(ast_impl.type_name);
                if (iface_sym.is_some()) {
                    if (iface_sym.some is BoundSymbol.type_sym) {
                        let iface_def: BoundDefinition = iface_sym.some.type_sym.bound_type.type_definition.some;
                        if (iface_def is BoundDefinition.interface_def) {
                            let iface: BoundInterfaceDefinition = iface_def.interface_def;
                            let j: mut i64 = 0;
                            while (j < cast<i64>(iface.methods.size())) {
                                let md: BoundDefinition = iface.methods.at(cast<u64>(j)).some;
                                if (md is BoundDefinition.function_def) {
                                    if (md.function_def.name == func.function_def.name) {
                                        if (md.function_def.symbol.is_some()) {
                                            slot.interface_method = new Option<BoundFunctionSymbol>.some(md.function_def.symbol.some);
                                        }
                                    }
                                }
                                j = j + 1;
                            }
                        }
                    }
                }
                if (func.function_def.name != "") {
                    let impl_sym: Option<BoundSymbol> = impl_scope.lookup_symbol(func.function_def.name);
                    if (impl_sym.is_some()) {
                        if (impl_sym.some is BoundSymbol.function_sym) {
                            slot.implementation_method = new Option<BoundFunctionSymbol>.some(impl_sym.some.function_sym);
                        }
                    }
                }
                vtable.slots.push(slot);
            }
            i = i + 1;
        }
        bound_impl.vtable = new Option<BoundVTable>.some(vtable);
    }

    fun pass_classify_value_types(mut this, result: BoundCompilationUnit) {
        _utils.trace_enter("Enter pass_classify_value_types");
        let i: mut i64 = 0;
        while (i < cast<i64>(result.definitions.size())) {
            let updated: BoundDefinition = this.classify_def(result.definitions.at(cast<u64>(i)).some, new _utils.List<string>());
            result.definitions.set(cast<u64>(i), updated);
            i = i + 1;
        }
    }

    // Requirement 2 (no implicit boxing): a non-IRef interface has unknown size at the
    // language level, so it cannot be stored in a class/enum field or returned from a
    // function — it may only live as a local variable or parameter (a pointer), or behind
    // an explicit Box<T>. This pass walks every definition and reports violations. Runs
    // after classification (types resolved + monomorphized + vtables built).
    fun pass_validate_interface_usage(mut this, result: BoundCompilationUnit) {
        _utils.trace_enter("Enter pass_validate_interface_usage");
        let i: mut i64 = 0;
        while (i < cast<i64>(result.definitions.size())) {
            this.validate_interface_usage_def(result.definitions.at(cast<u64>(i)).some);
            i = i + 1;
        }
    }

    fun validate_interface_usage_def(mut this, def: BoundDefinition) {
        if (def is BoundDefinition.namespace_def) {
            let ns: BoundNamespaceDefinition = def.namespace_def;
            let i: mut i64 = 0;
            while (i < cast<i64>(ns.children.size())) {
                this.validate_interface_usage_def(ns.children.at(cast<u64>(i)).some);
                i = i + 1;
            }
            return;
        }
        if (def is BoundDefinition.class_def) {
            let cls: BoundClassDefinition = def.class_def;
            let fi: mut i64 = 0;
            while (fi < cast<i64>(cls.fields.size())) {
                let field_def: BoundDefinition = cls.fields.at(cast<u64>(fi)).some;
                if (field_def is BoundDefinition.class_field) {
                    let ft: BoundType = field_def.class_field.bound_type;
                    if (this.is_unsized_interface(ft)) {
                        this.report_error(new ErrorCode.E_UNSIZED_INTERFACE(),
                            "Field of class '" + cls.full_name + "' has non-IRef interface type '"
                            + ft.display_name() + "'. Interfaces without IReferenceType have unknown "
                            + "size and cannot be fields. Use Box<" + ft.display_name()
                            + "> or add 'impl IReferenceType' to the interface.",
                            this.var_sym_loc(field_def.class_field.field_symbol));
                    }
                }
                fi = fi + 1;
            }
            let mi: mut i64 = 0;
            while (mi < cast<i64>(cls.methods.size())) {
                this.validate_interface_usage_def(cls.methods.at(cast<u64>(mi)).some);
                mi = mi + 1;
            }
            let ci: mut i64 = 0;
            while (ci < cast<i64>(cls.constructors.size())) {
                this.validate_interface_usage_def(cls.constructors.at(cast<u64>(ci)).some);
                ci = ci + 1;
            }
            return;
        }
        if (def is BoundDefinition.enum_def) {
            let enm: BoundEnumDefinition = def.enum_def;
            let mi: mut i64 = 0;
            while (mi < cast<i64>(enm.members.size())) {
                let member: BoundEnumMemberDefinition = enm.members.at(cast<u64>(mi)).some;
                let mt: BoundType = member.member_type;
                if (this.is_unsized_interface(mt)) {
                    this.report_error(new ErrorCode.E_UNSIZED_INTERFACE(),
                        "Enum variant of '" + enm.full_name + "' has non-IRef interface payload type '"
                        + mt.display_name() + "'. Interfaces without IReferenceType have unknown "
                        + "size and cannot be enum payloads. Use Box<" + mt.display_name()
                        + "> or add 'impl IReferenceType' to the interface.",
                        this.enum_member_sym_loc(member.member_symbol));
                }
                mi = mi + 1;
            }
            let mmi: mut i64 = 0;
            while (mmi < cast<i64>(enm.methods.size())) {
                this.validate_interface_usage_def(enm.methods.at(cast<u64>(mmi)).some);
                mmi = mmi + 1;
            }
            return;
        }
        if (def is BoundDefinition.function_def) {
            let func: BoundFunctionDefinition = def.function_def;
            if (this.is_unsized_interface(func.return_type)) {
                this.report_error(new ErrorCode.E_UNSIZED_INTERFACE(),
                    "Function '" + func.full_name + "' returns non-IRef interface type '"
                    + func.return_type.display_name() + "'. Interfaces without IReferenceType have "
                    + "unknown size and cannot be returned. Use Box<...> or add 'impl IReferenceType' "
                    + "to the interface.",
                    this.func_sym_loc(func.symbol));
            }
            return;
        }
    }

    // An interface is "unsized" (unknown size at the language level) unless it transitively
    // implements __builtin.IReferenceType. Currently no EmperorPenguin interface implements
    // IReferenceType, so every interface type is unsized. When an interface opts into being a
    // sized reference interface (via `impl IReferenceType`), extend this to walk the interface's
    // implemented-interface closure so such interfaces are permitted as fields/returns.
    fun is_unsized_interface(this, bt: BoundType) -> bool {
        if (bt.kind is TypeKind.InterfaceKind) {
            return true;
        }
        return false;
    }

    fun classify_def(mut this, def: BoundDefinition, visiting: mut _utils.List<string>) -> BoundDefinition {
        _utils.trace_enter("Enter classify_def");
        if (def is BoundDefinition.class_def) {
            let cls: mut BoundClassDefinition = def.class_def;
            this.classify_class(cls, visiting);
            return new BoundDefinition.class_def(cls);
        }
        if (def is BoundDefinition.namespace_def) {
            let ns: mut BoundNamespaceDefinition = def.namespace_def;
            let k: mut i64 = 0;
            while (k < cast<i64>(ns.children.size())) {
                let updated: BoundDefinition = this.classify_def(ns.children.at(cast<u64>(k)).some, visiting);
                ns.children.set(cast<u64>(k), updated);
                k = k + 1;
            }
            return new BoundDefinition.namespace_def(ns);
        }
        return def;
    }

    fun classify_class(mut this, cls: mut BoundClassDefinition, visiting: mut _utils.List<string>) -> bool {
        _utils.trace_enter("Enter classify_class");
        if (cls.is_value_class.is_some()) {
            return cls.is_value_class.some;
        }

        if (this.is_in_visiting(cls.full_name, visiting)) {
            cls.is_value_class = new Option<bool>.some(false);
            return false;
        }

        if (this.class_has_ivalue_type(cls)) {
            if (this.class_has_ireference_type(cls)) {
                this.report_error(new ErrorCode.E_VALUE_TYPE_CONFLICT(), "Class '" + cls.name + "' cannot implement both IValueType and IReferenceType", this.type_sym_loc(cls.type_symbol));
                cls.is_value_class = new Option<bool>.some(false);
                return false;
            }
            cls.is_value_class = new Option<bool>.some(true);
            return true;
        }

        if (this.class_has_ireference_type(cls)) {
            cls.is_value_class = new Option<bool>.some(false);
            return false;
        }

        visiting.push(cls.full_name);
        let all_value: bool = this.all_fields_value_type(cls, visiting);
        visiting.pop();

        cls.is_value_class = new Option<bool>.some(all_value);
        return all_value;
    }

    fun class_has_user_interfaces(this, cls: BoundClassDefinition) -> bool {
        _utils.trace_enter("Enter class_has_user_interfaces");
        let vi: mut i64 = 0;
        while (vi < cast<i64>(cls.vtables.size())) {
            let vtable: BoundVTable = cls.vtables.at(cast<u64>(vi)).some;
            let name: string = vtable.interface_type.display_name();
            if (name != "IValueType" && name != "IReferenceType" && name != "ICopy") {
                return true;
            }
            vi = vi + 1;
        }
        return false;
    }

    fun class_has_ivalue_type(this, cls: BoundClassDefinition) -> bool {
        _utils.trace_enter("Enter class_has_ivalue_type");
        let vi: mut i64 = 0;
        while (vi < cast<i64>(cls.vtables.size())) {
            let vtable: BoundVTable = cls.vtables.at(cast<u64>(vi)).some;
            if (vtable.interface_type.display_name() == "IValueType") {
                return true;
            }
            vi = vi + 1;
        }
        return false;
    }

    fun is_iref_type(this, bt: BoundType) -> bool {
        _utils.trace_enter("Enter is_iref_type");
        if (bt.kind is TypeKind.ClassKind && bt.type_definition.is_some()) {
            let td: BoundDefinition = bt.type_definition.some;
            if (td is BoundDefinition.class_def) {
                return this.class_has_ireference_type(td.class_def);
            }
        }
        return false;
    }

    fun class_has_ireference_type(this, cls: BoundClassDefinition) -> bool {
        _utils.trace_enter("Enter class_has_ireference_type");
        let vi: mut i64 = 0;
        while (vi < cast<i64>(cls.vtables.size())) {
            let vtable: BoundVTable = cls.vtables.at(cast<u64>(vi)).some;
            if (vtable.interface_type.display_name() == "IReferenceType") {
                return true;
            }
            vi = vi + 1;
        }
        return false;
    }

    // A type is an iterator if it names IIterator<?>, implements it (a vtable for
    // IIterator<...> on the class/interface definition), or declares a structural
    // `next` method (EmperorPenguin iterators such as _ListIterator are concrete
    // classes exposing `next(mut this)`). for-loop desugaring uses this to decide
    // whether to consume an `in` expression as-is or to call iter()/iter_mut().
    fun is_iterator_type(this, bt: BoundType) -> bool {
        _utils.trace_enter("Enter is_iterator_type");
        if (string_find(bt.display_name(), "IIterator<") >= 0) { return true; }
        if (let td := bt.type_definition.some) {
            if (td is BoundDefinition.class_def) {
                let cls: BoundClassDefinition = td.class_def;
                let vi: mut i64 = 0;
                while (vi < cast<i64>(cls.vtables.size())) {
                    let vtable: BoundVTable = cls.vtables.at(cast<u64>(vi)).some;
                    if (string_find(vtable.interface_type.display_name(), "IIterator<") >= 0) { return true; }
                    vi = vi + 1;
                }
                let mi: mut i64 = 0;
                while (mi < cast<i64>(cls.methods.size())) {
                    let m: BoundDefinition = cls.methods.at(cast<u64>(mi)).some;
                    if (m is BoundDefinition.function_def && m.function_def.name == "next") { return true; }
                    mi = mi + 1;
                }
            }
            if (td is BoundDefinition.interface_def) {
                let iface: BoundInterfaceDefinition = td.interface_def;
                let vi: mut i64 = 0;
                while (vi < cast<i64>(iface.vtables.size())) {
                    let vtable: BoundVTable = iface.vtables.at(cast<u64>(vi)).some;
                    if (string_find(vtable.interface_type.display_name(), "IIterator<") >= 0) { return true; }
                    vi = vi + 1;
                }
            }
        }
        return false;
    }

    fun class_has_icopy(this, cls: BoundClassDefinition) -> bool {
        _utils.trace_enter("Enter class_has_icopy");
        let vi: mut i64 = 0;
        while (vi < cast<i64>(cls.vtables.size())) {
            let vtable: BoundVTable = cls.vtables.at(cast<u64>(vi)).some;
            if (vtable.interface_type.display_name() == "ICopy") {
                return true;
            }
            vi = vi + 1;
        }
        return false;
    }

    // True when a type's `.copy()` should lower to the base expression itself
    // (value semantics — the value copies on assignment anyway): primitives
    // (all implement ICopy<self>) and auto-classified value classes / enums.
    // Classes with an EXPLICIT `impl ICopy<Self>` are excluded: their `.copy()`
    // resolves through the existing interface path (emitting _emperor_ICopy_copy,
    // a real heap clone), which identity-lowering would wrongly turn into aliasing.
    fun base_type_has_icopy(this, bt: BoundType) -> bool {
        _utils.trace_enter("Enter base_type_has_icopy");
        if (bt.kind is TypeKind.PrimitiveKind) {
            return true;
        }
        if (bt.kind is TypeKind.ClassKind && bt.type_definition.is_some()) {
            let td: BoundDefinition = bt.type_definition.some;
            if (td is BoundDefinition.class_def) {
                if (this.class_has_icopy(td.class_def)) { return false; }
                if (td.class_def.is_value_class.is_some() && td.class_def.is_value_class.some) { return true; }
            }
        }
        if (bt.kind is TypeKind.EnumKind && bt.type_definition.is_some()) {
            return true;
        }
        return false;
    }

    fun is_in_visiting(this, full_name: string, visiting: _utils.List<string>) -> bool {
        _utils.trace_enter("Enter is_in_visiting");
        let ci: mut i64 = 0;
        while (ci < cast<i64>(visiting.size())) {
            if (visiting.at(cast<u64>(ci)).some == full_name) {
                return true;
            }
            ci = ci + 1;
        }
        return false;
    }

    fun all_fields_value_type(mut this, cls: BoundClassDefinition, visiting: mut _utils.List<string>) -> bool {
        _utils.trace_enter("Enter all_fields_value_type");
        let fi: mut i64 = 0;
        while (fi < cast<i64>(cls.fields.size())) {
            let field_def: BoundDefinition = cls.fields.at(cast<u64>(fi)).some;
            if (field_def is BoundDefinition.class_field) {
                let field_type: BoundType = field_def.class_field.bound_type;
                if (!this.is_type_value_like(field_type, visiting)) {
                    return false;
                }
            }
            fi = fi + 1;
        }
        return true;
    }

    fun is_type_value_like(mut this, bt: BoundType, visiting: mut _utils.List<string>) -> bool {
        _utils.trace_enter("Enter is_type_value_like");
        if (bt.kind is TypeKind.PrimitiveKind) {
            return true; // All primitives (including string) are value types
        }
        if (bt.kind is TypeKind.EnumKind) {
            // An enum (e.g. Option<T>) is value-like only if every payload
            // (generic argument) type is itself value-like. This is what lets the
            // `visiting` cycle check below detect recursive classes such as
            //   class Node { next: Option<Node>; }
            // When classifying Node, its `next` field has enum kind; recursing into
            // the Node payload finds Node already in `visiting`, which forces Node
            // (and therefore the field) to be non-value-like — i.e. a reference
            // type. Without this recursion an enum short-circuits to "value-like",
            // recursive classes get misclassified as value types, their instances
            // are stack-allocated, and any address that escapes into the enum
            // payload (a linked-list node stored in head/tail/next) is left
            // dangling once the allocating function returns.
            let ei: mut i64 = 0;
            while (ei < cast<i64>(bt.generic_args.size())) {
                let payload: BoundType = bt.generic_args.at(cast<u64>(ei)).some;
                if (!this.is_type_value_like(payload, visiting)) {
                    return false;
                }
                ei = ei + 1;
            }
            return true;
        }
        if (bt.kind is TypeKind.ClassKind) {
            if (let def := bt.type_definition.some) {
                if (def is BoundDefinition.class_def) {
                    return this.classify_class(def.class_def, visiting);
                }
            }
            return false;
        }
        return false;
    }

    fun resolve_type_name(mut this, name: string, scope: mut BoundScope, location: SourceLocation) -> mut BoundType {
        _utils.trace_enter("Enter resolve_type_name");
        let prim: Option<BoundType> = this.type_registry.resolve_type(name);
        if (prim.is_some()) {
            let result: mut BoundType = prim.some;
            return result;
        }
        let type_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(name);
        if (type_sym.is_some()) {
            let result: mut BoundType = type_sym.some.type_sym.bound_type;
            return result;
        }
        this.report_error(new ErrorCode.E_RESOLVE_TYPE(),
            "Can't resolve type specifier '" + name + "'",
            location);
        return this.type_registry.make_error_type();
    }

    fun def_display_name(this, def: BoundDefinition) -> string {
        _utils.trace_enter("Enter def_display_name");
        if (def is BoundDefinition.function_def) { return "function " + def.function_def.full_name; }
        if (def is BoundDefinition.class_def) { return "class " + def.class_def.name; }
        if (def is BoundDefinition.enum_def) { return "enum " + def.enum_def.name; }
        if (def is BoundDefinition.interface_def) { return "interface " + def.interface_def.name; }
        if (def is BoundDefinition.namespace_def) { return "namespace " + def.namespace_def.name; }
        if (def is BoundDefinition.initial_routine) { return "initial"; }
        if (def is BoundDefinition.impl_def) { return "impl"; }
        if (def is BoundDefinition.impl_for_def) { return "impl for"; }
        if (def is BoundDefinition.type_ref_def) { return "type " + def.type_ref_def.name; }
        if (def is BoundDefinition.global_var_def) { return "global " + def.global_var_def.name; }
        if (def is BoundDefinition.class_field) { return "field " + def.class_field.name; }
        return "<unknown>";
    }

    fun pass_bind_expressions(mut this, unit: CompilationUnit, result: BoundCompilationUnit) {
        _utils.trace_enter("Enter pass_bind_expressions");
        this.current_unit = new Option<BoundCompilationUnit>.some(result);
        let ast_count: i64 = cast<i64>(unit.definitions.size());
        let total: i64 = cast<i64>(result.definitions.size());
        let i: mut i64 = 0;
        while (i < total) {
            if (i < ast_count) {
                let ast_def: Definition = unit.definitions.at(cast<u64>(i)).some;
                let bound_def: BoundDefinition = result.definitions.at(cast<u64>(i)).some;
                if (this.verbose >= 2) { __builtin.eprintln("[EmperorPenguin Semantic]   Binding " + this.def_display_name(bound_def)); }
                result.definitions.set(cast<u64>(i), this.bind_body_for_def(ast_def, bound_def, result));
            } else {
                let bound_def: BoundDefinition = result.definitions.at(cast<u64>(i)).some;
                if (this.verbose >= 2) { __builtin.eprintln("[EmperorPenguin Semantic]   Binding (specialized) " + this.def_display_name(bound_def)); }
                result.definitions.set(cast<u64>(i), this.bind_body_for_specialized_def(bound_def, result));
            }
            i = i + 1;
        }
        this.current_unit = new Option<BoundCompilationUnit>.none();
    }

    fun bind_body_for_specialized_def(mut this, bound_def: BoundDefinition, result: BoundCompilationUnit) -> BoundDefinition {
        _utils.trace_enter("Enter bind_body_for_specialized_def");
        if (bound_def is BoundDefinition.class_def) {
            let bound_cls: BoundClassDefinition = bound_def.class_def;
            let template_name: string = this.extract_template_name(bound_cls.name);
            let ast_def: Option<Definition> = this.find_ast_def_by_name(this.ast_definitions, template_name);
            if (ast_def.is_some() && ast_def.some is Definition.class_def) {
                return this.bind_body_for_def(ast_def.some, bound_def, result);
            }
            return bound_def;
        }
        if (bound_def is BoundDefinition.enum_def) {
            let bound_enum: BoundEnumDefinition = bound_def.enum_def;
            let template_name: string = this.extract_template_name(bound_enum.name);
            let ast_def: Option<Definition> = this.find_ast_def_by_name(this.ast_definitions, template_name);
            if (ast_def.is_some() && ast_def.some is Definition.enum_def) {
                return this.bind_body_for_def(ast_def.some, bound_def, result);
            }
            return bound_def;
        }
        if (bound_def is BoundDefinition.function_def) {
            let bound_func: BoundFunctionDefinition = bound_def.function_def;
            let template_name: string = this.extract_template_name(bound_func.name);
            let ast_def: Option<Definition> = this.find_ast_def_by_name(this.ast_definitions, template_name);
            if (ast_def.is_some() && ast_def.some is Definition.function_def) {
                return this.bind_body_for_def(ast_def.some, bound_def, result);
            }
            return bound_def;
        }
        if (bound_def is BoundDefinition.interface_def) {
            let bound_iface: BoundInterfaceDefinition = bound_def.interface_def;
            let template_name: string = this.extract_template_name(bound_iface.name);
            let ast_def: Option<Definition> = this.find_ast_def_by_name(this.ast_definitions, template_name);
            if (ast_def.is_some()) {
                if (ast_def.some is Definition.interface_def) {
                    return this.bind_body_for_def(ast_def.some, bound_def, result);
                }
            }
            return bound_def;
        }
        return bound_def;
    }

    fun ensure_params_in_scope(mut this, func: mut BoundFunctionDefinition) {
        _utils.trace_enter("Enter ensure_params_in_scope");
        if (func.scope.is_none()) { return; }
        let func_scope: mut BoundScope = func.scope.some;
        let pi: mut i64 = 0;
        while (pi < cast<i64>(func.parameters.size())) {
            let param: BoundFunctionParameter = func.parameters.at(cast<u64>(pi)).some;
            let existing: Option<BoundSymbol> = func_scope.lookup_symbol_local(param.name);
            if (existing.is_none()) {
                let param_sym: mut BoundVariableSymbol = new BoundVariableSymbol();
                param_sym.name = param.name;
                param_sym.full_name = func.full_name + "." + param.name;
                param_sym.bound_type = param.bound_type;
                param_sym.variable_kind = new VariableSymbolKind.Param();
                param_sym.is_mutable = param.is_mutable;
                param_sym.parameter_index = param.index;
                param_sym.enclosing_scope = new Option<BoundScope>.some(func_scope);
                func_scope.add_symbol(new BoundSymbol.variable(param_sym));
            }
            pi = pi + 1;
        }
    }

    fun bind_body_for_def(mut this, ast_def: Definition, bound_def: BoundDefinition, result: BoundCompilationUnit) -> BoundDefinition {
        _utils.trace_enter("Enter bind_body_for_def");
        if (bound_def is BoundDefinition.function_def && ast_def is Definition.function_def) {
            let bound_func: mut BoundFunctionDefinition = bound_def.function_def;
            let ast_func: FunctionDefinition = ast_def.function_def;
            if (this.verbose >= 2) { __builtin.eprintln("[EmperorPenguin Semantic]   Binding function " + bound_func.full_name); }
            if (bound_func.scope.is_some() && ast_func.body.is_some()) {
                let func_scope: mut BoundScope = bound_func.scope.some;
                this.ensure_params_in_scope(bound_func);
                let bound_body: mut Option<BoundExpression> = this.bind_expression(ast_func.body.some, func_scope);
                bound_func.body = bound_body;
            }
            return new BoundDefinition.function_def(bound_func);
        }
        if (bound_def is BoundDefinition.initial_routine && ast_def is Definition.initial_routine) {
            let bound_init: mut BoundInitialRoutineDefinition = bound_def.initial_routine;
            let ast_init: InitialRoutineDefinition = ast_def.initial_routine;
            if (this.verbose >= 2) { __builtin.eprintln("[EmperorPenguin Semantic]   Binding initial routine"); }
            if (bound_init.scope.is_some() && ast_init.body.is_some()) {
                let init_scope: mut BoundScope = bound_init.scope.some;
                let bound_init_body: mut Option<BoundExpression> = this.bind_expression(ast_init.body.some, init_scope);
                bound_init.body = bound_init_body;
            }
            return new BoundDefinition.initial_routine(bound_init);
        }
        if (bound_def is BoundDefinition.class_def && ast_def is Definition.class_def) {
            let bound_cls: BoundClassDefinition = bound_def.class_def;
            if (bound_cls.is_generic_template) { return bound_def; }
            let ast_cls: ClassDefinition = ast_def.class_def;
            let bound_cls: mut BoundClassDefinition = bound_def.class_def;
            let i: mut i64 = 0;
            while (i < cast<i64>(ast_cls.members.size())) {
                let ast_member: Definition = ast_cls.members.at(cast<u64>(i)).some;
                if (ast_member is Definition.function_def) {
                    let j: mut i64 = 0;
                    while (j < cast<i64>(bound_cls.methods.size())) {
                        let bound_md: BoundDefinition = bound_cls.methods.at(cast<u64>(j)).some;
                        if (bound_md is BoundDefinition.function_def && bound_md.function_def.name == ast_member.function_def.name) {
                            bound_cls.methods.set(cast<u64>(j), this.bind_body_for_def(ast_member, bound_md, result));
                        }
                        j = j + 1;
                    }
                }
                if (ast_member is Definition.impl_def) {
                    let ast_impl_member: InterfaceImplementation = ast_member.impl_def;
                    let j: mut i64 = 0;
                    while (j < cast<i64>(bound_cls.interface_impls.size())) {
                        let bound_impl_def: BoundDefinition = bound_cls.interface_impls.at(cast<u64>(j)).some;
                        if (bound_impl_def is BoundDefinition.impl_def) {
                            let bound_iface_impl: mut BoundInterfaceImplementation = bound_impl_def.impl_def;
                            let fi: mut i64 = 0;
                            while (fi < cast<i64>(ast_impl_member.functions.size())) {
                                let ast_func_def: Definition = ast_impl_member.functions.at(cast<u64>(fi)).some;
                                if (ast_func_def is Definition.function_def) {
                                    let mi: mut i64 = 0;
                                    while (mi < cast<i64>(bound_iface_impl.methods.size())) {
                                        let bound_method: BoundDefinition = bound_iface_impl.methods.at(cast<u64>(mi)).some;
                                        if (bound_method is BoundDefinition.function_def && bound_method.function_def.name == ast_func_def.function_def.name) {
                                            bound_iface_impl.methods.set(cast<u64>(mi), this.bind_body_for_def(ast_func_def, bound_method, result));
                                        }
                                        mi = mi + 1;
                                    }
                                }
                                fi = fi + 1;
                            }
                            bound_cls.interface_impls.set(cast<u64>(j), new BoundDefinition.impl_def(bound_iface_impl));
                        }
                        j = j + 1;
                    }
                }
                i = i + 1;
            }
            // Bind field default initializers (e.g. `errors: List<T> = new List<T>()`)
            // in the constructor's scope and store them on the bound field. The IR
            // generator emits them as `this.field = <init>` at the start of the
            // constructor. Without this, field defaults are silently dropped and
            // the field is left at its memset-zero state (null for reference-typed
            // fields, empty for value-typed) — which crashes as soon as a method
            // dereferences it.
            if (let ctor := bound_cls.constructor.some) {
                if (ctor.scope.is_some()) {
                    let ctor_scope: mut BoundScope = ctor.scope.some;
                    let fi: mut i64 = 0;
                    while (fi < cast<i64>(bound_cls.fields.size())) {
                        let field_def: BoundDefinition = bound_cls.fields.at(cast<u64>(fi)).some;
                        if (field_def is BoundDefinition.class_field) {
                            let bound_field: mut BoundClassFieldDefinition = field_def.class_field;
                            let ast_init: mut Option<Expression> = new Option<Expression>.none();
                            let ai: mut i64 = 0;
                            while (ai < cast<i64>(ast_cls.members.size())) {
                                let am: Definition = ast_cls.members.at(cast<u64>(ai)).some;
                                if (am is Definition.class_field) {
                                    if (am.class_field.name == bound_field.name) {
                                        if (am.class_field.initializer.is_some()) {
                                            // req5: substitute value-template params (N) -> their concrete
                                            // constants before binding the field default initializer.
                                            ast_init = new Option<Expression>.some(this.substitute_value_params(am.class_field.initializer.some, bound_cls.value_param_names, bound_cls.value_param_values));
                                        }
                                    }
                                }
                                ai = ai + 1;
                            }
                            if (ast_init.is_some()) {
                                let bound_init: mut Option<BoundExpression> = this.bind_expression(ast_init.some, ctor_scope);
                                bound_field.initializer = bound_init;
                                bound_cls.fields.set(cast<u64>(fi), new BoundDefinition.class_field(bound_field));
                            }
                        }
                        fi = fi + 1;
                    }
                }
            }
            return new BoundDefinition.class_def(bound_cls);
        }
        if (bound_def is BoundDefinition.enum_def && ast_def is Definition.enum_def) {
            let bound_enum: mut BoundEnumDefinition = bound_def.enum_def;
            let ast_enum: EnumDefinition = ast_def.enum_def;
            let i: mut i64 = 0;
            while (i < cast<i64>(ast_enum.members.size())) {
                let ast_member: Definition = ast_enum.members.at(cast<u64>(i)).some;
                if (ast_member is Definition.function_def) {
                    let j: mut i64 = 0;
                    while (j < cast<i64>(bound_enum.methods.size())) {
                        let bound_md: BoundDefinition = bound_enum.methods.at(cast<u64>(j)).some;
                        if (bound_md is BoundDefinition.function_def && bound_md.function_def.name == ast_member.function_def.name) {
                            bound_enum.methods.set(cast<u64>(j), this.bind_body_for_def(ast_member, bound_md, result));
                        }
                        j = j + 1;
                    }
                }
                // Also bind interface impl methods for enums
                if (ast_member is Definition.impl_def) {
                    let ast_impl: InterfaceImplementation = ast_member.impl_def;
                    let ii: mut i64 = 0;
                    while (ii < cast<i64>(bound_enum.interface_impls.size())) {
                        let bound_impl_def: BoundDefinition = bound_enum.interface_impls.at(cast<u64>(ii)).some;
                        if (bound_impl_def is BoundDefinition.impl_def) {
                            let bound_iface_impl: mut BoundInterfaceImplementation = bound_impl_def.impl_def;
                            let fi: mut i64 = 0;
                            while (fi < cast<i64>(ast_impl.functions.size())) {
                                let ast_func_def: Definition = ast_impl.functions.at(cast<u64>(fi)).some;
                                if (ast_func_def is Definition.function_def) {
                                    let mi: mut i64 = 0;
                                    while (mi < cast<i64>(bound_iface_impl.methods.size())) {
                                        let bound_method: BoundDefinition = bound_iface_impl.methods.at(cast<u64>(mi)).some;
                                        if (bound_method is BoundDefinition.function_def && bound_method.function_def.name == ast_func_def.function_def.name) {
                                            bound_iface_impl.methods.set(cast<u64>(mi), this.bind_body_for_def(ast_func_def, bound_method, result));
                                        }
                                        mi = mi + 1;
                                    }
                                }
                                fi = fi + 1;
                            }
                            bound_enum.interface_impls.set(cast<u64>(ii), new BoundDefinition.impl_def(bound_iface_impl));
                        }
                        ii = ii + 1;
                    }
                }
                i = i + 1;
            }
            return new BoundDefinition.enum_def(bound_enum);
        }
        if (bound_def is BoundDefinition.namespace_def && ast_def is Definition.namespace_def) {
            let ast_ns: NamespaceDefinition = ast_def.namespace_def;
            let bound_ns: mut BoundNamespaceDefinition = bound_def.namespace_def;
            let k: mut i64 = 0;
            while (k < cast<i64>(ast_ns.children.size())) {
                let ast_child: Definition = ast_ns.children.at(cast<u64>(k)).some;
                let m: mut i64 = 0;
                while (m < cast<i64>(bound_ns.children.size())) {
                    let bound_child: BoundDefinition = bound_ns.children.at(cast<u64>(m)).some;
                    if (ast_child is Definition.function_def && bound_child is BoundDefinition.function_def) {
                        if (ast_child.function_def.name == bound_child.function_def.name) {
                            bound_ns.children.set(cast<u64>(m), this.bind_body_for_def(ast_child, bound_child, result));
                        }
                    }
                    if (ast_child is Definition.class_def && bound_child is BoundDefinition.class_def) {
                        if (ast_child.class_def.name == bound_child.class_def.name) {
                            bound_ns.children.set(cast<u64>(m), this.bind_body_for_def(ast_child, bound_child, result));
                        }
                    }
                    if (ast_child is Definition.interface_def && bound_child is BoundDefinition.interface_def) {
                        if (ast_child.interface_def.name == bound_child.interface_def.name) {
                            bound_ns.children.set(cast<u64>(m), this.bind_body_for_def(ast_child, bound_child, result));
                        }
                    }
                    if (ast_child is Definition.initial_routine && bound_child is BoundDefinition.initial_routine) {
                        bound_ns.children.set(cast<u64>(m), this.bind_body_for_def(ast_child, bound_child, result));
                    }
                    if (ast_child is Definition.enum_def && bound_child is BoundDefinition.enum_def) {
                        if (ast_child.enum_def.name == bound_child.enum_def.name) {
                            bound_ns.children.set(cast<u64>(m), this.bind_body_for_def(ast_child, bound_child, result));
                        }
                    }
                    if (ast_child is Definition.namespace_def && bound_child is BoundDefinition.namespace_def) {
                        if (ast_child.namespace_def.name == bound_child.namespace_def.name) {
                            bound_ns.children.set(cast<u64>(m), this.bind_body_for_def(ast_child, bound_child, result));
                        }
                    }
                    if (ast_child is Definition.global_var && bound_child is BoundDefinition.global_var_def) {
                        if (ast_child.global_var.name == bound_child.global_var_def.name) {
                            bound_ns.children.set(cast<u64>(m), this.bind_body_for_def(ast_child, bound_child, result));
                        }
                    }
                    m = m + 1;
                }
                k = k + 1;
            }
            return new BoundDefinition.namespace_def(bound_ns);
        }
        if (bound_def is BoundDefinition.interface_def && ast_def is Definition.interface_def) {
            let ast_iface: InterfaceDefinition = ast_def.interface_def;
            let bound_iface: mut BoundInterfaceDefinition = bound_def.interface_def;
            let i: mut i64 = 0;
            while (i < cast<i64>(ast_iface.members.size())) {
                let ast_member: Definition = ast_iface.members.at(cast<u64>(i)).some;
                if (ast_member is Definition.function_def) {
                    let j: mut i64 = 0;
                    while (j < cast<i64>(bound_iface.methods.size())) {
                        let bound_md: BoundDefinition = bound_iface.methods.at(cast<u64>(j)).some;
                        if (bound_md is BoundDefinition.function_def && bound_md.function_def.name == ast_member.function_def.name) {
                            bound_iface.methods.set(cast<u64>(j), this.bind_body_for_def(ast_member, bound_md, result));
                        }
                        j = j + 1;
                    }
                }
                if (ast_member is Definition.impl_def) {
                    // Bind bodies of nested-impl methods (interface inheritance).
                    let ast_impl_member: InterfaceImplementation = ast_member.impl_def;
                    let bi: mut i64 = 0;
                    while (bi < cast<i64>(bound_iface.interface_impls.size())) {
                        let bound_impl_def: BoundDefinition = bound_iface.interface_impls.at(cast<u64>(bi)).some;
                        if (bound_impl_def is BoundDefinition.impl_def) {
                            let bound_iface_impl: mut BoundInterfaceImplementation = bound_impl_def.impl_def;
                            let fi: mut i64 = 0;
                            while (fi < cast<i64>(ast_impl_member.functions.size())) {
                                let ast_func_def: Definition = ast_impl_member.functions.at(cast<u64>(fi)).some;
                                if (ast_func_def is Definition.function_def) {
                                    let mi: mut i64 = 0;
                                    while (mi < cast<i64>(bound_iface_impl.methods.size())) {
                                        let bound_method: BoundDefinition = bound_iface_impl.methods.at(cast<u64>(mi)).some;
                                        if (bound_method is BoundDefinition.function_def && bound_method.function_def.name == ast_func_def.function_def.name) {
                                            let bmd: mut BoundFunctionDefinition = bound_method.function_def;
                                            // Nested-impl methods are missed by the normal
                                            // function-pair resolution pass, so resolve their
                                            // signature (params, return type) here. The scope
                                            // has T -> concrete arg for specialized interfaces.
                                            if (cast<i64>(bmd.parameters.size()) == 0) {
                                                if (bound_iface.scope.is_some()) {
                                                    this.resolve_function_pair(ast_func_def.function_def, bmd, bound_iface.scope.some);
                                                }
                                            }
                                            bound_iface_impl.methods.set(cast<u64>(mi), this.bind_body_for_def(ast_func_def, bound_method, result));
                                        }
                                        mi = mi + 1;
                                    }
                                }
                                fi = fi + 1;
                            }
                            bound_iface.interface_impls.set(cast<u64>(bi), new BoundDefinition.impl_def(bound_iface_impl));
                        }
                        bi = bi + 1;
                    }
                }
                i = i + 1;
            }
            return new BoundDefinition.interface_def(bound_iface);
        }
        if (bound_def is BoundDefinition.enum_def && ast_def is Definition.enum_def) {
            let ast_enum: EnumDefinition = ast_def.enum_def;
            let bound_enum: mut BoundEnumDefinition = bound_def.enum_def;
            let i: mut i64 = 0;
            while (i < cast<i64>(ast_enum.members.size())) {
                let ast_member: Definition = ast_enum.members.at(cast<u64>(i)).some;
                if (ast_member is Definition.impl_def) {
                    let ast_impl_member: InterfaceImplementation = ast_member.impl_def;
                    let j: mut i64 = 0;
                    while (j < cast<i64>(bound_enum.interface_impls.size())) {
                        let bound_impl_def: BoundDefinition = bound_enum.interface_impls.at(cast<u64>(j)).some;
                        if (bound_impl_def is BoundDefinition.impl_def) {
                            let bound_iface_impl: mut BoundInterfaceImplementation = bound_impl_def.impl_def;
                            let fi: mut i64 = 0;
                            while (fi < cast<i64>(ast_impl_member.functions.size())) {
                                let ast_func_def: Definition = ast_impl_member.functions.at(cast<u64>(fi)).some;
                                if (ast_func_def is Definition.function_def) {
                                    let mi: mut i64 = 0;
                                    while (mi < cast<i64>(bound_iface_impl.methods.size())) {
                                        let bound_method: BoundDefinition = bound_iface_impl.methods.at(cast<u64>(mi)).some;
                                        if (bound_method is BoundDefinition.function_def && bound_method.function_def.name == ast_func_def.function_def.name) {
                                            bound_iface_impl.methods.set(cast<u64>(mi), this.bind_body_for_def(ast_func_def, bound_method, result));
                                        }
                                        mi = mi + 1;
                                    }
                                }
                                fi = fi + 1;
                            }
                            bound_enum.interface_impls.set(cast<u64>(j), new BoundDefinition.impl_def(bound_iface_impl));
                        }
                        j = j + 1;
                    }
                }
                i = i + 1;
            }
            return new BoundDefinition.enum_def(bound_enum);
        }
        if (bound_def is BoundDefinition.global_var_def && ast_def is Definition.global_var) {
            let gv: mut BoundGlobalVariableDefinition = bound_def.global_var_def;
            if (gv.scope.is_some() && ast_def.global_var.initializer.is_some()) {
                let gv_scope: mut BoundScope = gv.scope.some;
                let bound_init: mut Option<BoundExpression> = this.bind_expression(ast_def.global_var.initializer.some, gv_scope);
                gv.initializer = bound_init;
                if (bound_init.is_some()) {
                    let init_type: mut BoundType = bound_init.some.get_bound_type();
                    if (gv.bound_type.kind is TypeKind.PrimitiveKind && gv.bound_type.primitive is PrimitiveType.VoidType) {
                        gv.bound_type = init_type;
                        if (gv.variable_symbol.is_some()) {
                            let sym: mut BoundVariableSymbol = gv.variable_symbol.some;
                            sym.bound_type = init_type;
                            gv.variable_symbol = new Option<BoundVariableSymbol>.some(sym);
                        }
                    }
                }
            }
            return new BoundDefinition.global_var_def(gv);
        }
        return bound_def;
    }

    fun bind_expression(mut this, expr: Expression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_expression");
        if (expr is Expression.constant) {
            return this.bind_constant(expr.constant, scope);
        }
        if (expr is Expression.string_literal) {
            return this.bind_string_literal(expr.string_literal, scope);
        }
        if (expr is Expression.bool_literal) {
            return this.bind_bool_literal(expr.bool_literal, scope);
        }
        if (expr is Expression.void_literal) {
            return this.bind_void_literal(scope);
        }
        if (expr is Expression.parenthesized) {
            if (expr.parenthesized.inner.is_some()) {
                if (scope.is_region) {
                    // Already inside a try-bind region: parens are transparent.
                    return this.bind_expression(expr.parenthesized.inner.some, scope);
                }
                // A parenthesized expression is a try-bind region boundary:
                // pattern variables bound inside die with the parens.
                let paren_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<paren>", scope.full_name + ".<paren>", new Option<BoundScope>.some(scope));
                paren_scope.is_region = true;
                return this.bind_expression(expr.parenthesized.inner.some, paren_scope);
            }
        }
        if (expr is Expression.identifier) {
            return this.bind_identifier(expr.identifier, scope);
        }
        if (expr is Expression.binary) {
            return this.bind_binary(expr.binary, scope);
        }
        if (expr is Expression.unary) {
            return this.bind_unary(expr.unary, scope);
        }
        if (expr is Expression.member_access) {
            return this.bind_member_access(expr.member_access, scope);
        }
        if (expr is Expression.function_call) {
            return this.bind_function_call(expr.function_call, scope);
        }
        if (expr is Expression.if_expr) {
            return this.bind_if_expr(expr.if_expr, scope);
        }
        if (expr is Expression.while_expr) {
            return this.bind_while_expr(expr.while_expr, scope);
        }
        if (expr is Expression.code_block) {
            return this.bind_code_block(expr.code_block, scope);
        }
        if (expr is Expression.cast_expr) {
            return this.bind_cast(expr.cast_expr, scope);
        }
        if (expr is Expression.new_expr) {
            return this.bind_new_expr(expr.new_expr, scope);
        }
        if (expr is Expression.meta_call) {
            return this.bind_meta_call(expr.meta_call, scope);
        }
        if (expr is Expression.try_bind) {
            // P2: general try-bind expression — bind the RHS, register the
            // pattern variable into the current region scope, return a bool
            // expression that writes the payload when the check succeeds.
            return this.bind_try_bind(expr.try_bind, scope);
        }
        return new Option<BoundExpression>.none();
    }

    fun bind_constant(mut this, expr: ConstantExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_constant");
        let bt: BoundType = this.type_registry.resolve_type("i64").some;
        let result: mut BoundLiteralExpression = new BoundLiteralExpression(expr.value, bt, new LiteralKind.IntegerLiteral());
        return new Option<BoundExpression>.some(new BoundExpression.literal(result));
    }

    fun bind_string_literal(mut this, expr: StringLiteralExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_string_literal");
        let bt: BoundType = this.type_registry.resolve_type("string").some;
        let result: mut BoundLiteralExpression = new BoundLiteralExpression(expr.value, bt, new LiteralKind.StringLiteral());
        return new Option<BoundExpression>.some(new BoundExpression.literal(result));
    }

    fun bind_bool_literal(mut this, expr: BoolLiteralExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_bool_literal");
        let bt: BoundType = this.type_registry.resolve_type("bool").some;
        let result: mut BoundLiteralExpression = new BoundLiteralExpression(expr.value, bt, new LiteralKind.BoolLiteral());
        return new Option<BoundExpression>.some(new BoundExpression.literal(result));
    }

    fun bind_void_literal(mut this, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_void_literal");
        let result: mut BoundLiteralExpression = new BoundLiteralExpression("void", this.type_registry.void_type, new LiteralKind.VoidLiteral());
        return new Option<BoundExpression>.some(new BoundExpression.literal(result));
    }

    fun bind_identifier(mut this, expr: IdentifierExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_identifier");
        let sym: Option<BoundSymbol> = scope.lookup_symbol(expr.name);
        if (sym.is_some()) {
            // Reject class field access from methods without `this` parameter.
            // For example, `fun foo() { a = 1; }` inside a class where `a` is a
            // field but `foo` has no `this` — the identifier `a` resolves to the
            // field, but IR generation later crashes when it can't find a register
            // for the field. Catch it early with a proper E_RESOLVE_SYMBOL error.
            if (sym.some is BoundSymbol.variable) {
                if (sym.some.variable.variable_kind is VariableSymbolKind.Field) {
                    let this_sym: Option<BoundSymbol> = scope.lookup_symbol("this");
                    if (this_sym.is_none()) {
                        this.report_error(new ErrorCode.E_RESOLVE_SYMBOL(),
                            "Cannot access field '" + expr.name + "' without a 'this' reference; add 'this.' prefix or add a 'this' parameter to the function",
                            new SourceLocation("", 0, 0));
                        let result: mut BoundIdentifierExpression = new BoundIdentifierExpression(new BoundType(), new Option<BoundSymbol>.none());
                        return new Option<BoundExpression>.some(new BoundExpression.identifier(result));
                    }
                }
            }
            let bt: BoundType = this.resolve_symbol_type(sym.some);
            let result: mut BoundIdentifierExpression = new BoundIdentifierExpression(bt, sym);
            return new Option<BoundExpression>.some(new BoundExpression.identifier(result));
        }
        let result: mut BoundIdentifierExpression = new BoundIdentifierExpression(new BoundType(), sym);
        // Report E_RESOLVE_SYMBOL for undefined identifiers instead of
        // letting them silently produce E_INTERNAL in the IR generator.
        this.report_error(new ErrorCode.E_RESOLVE_SYMBOL(),
            "Cannot resolve symbol '" + expr.name + "'",
            new SourceLocation("", 0, 0));
        return new Option<BoundExpression>.some(new BoundExpression.identifier(result));
    }

    fun resolve_symbol_type(this, sym: BoundSymbol) -> BoundType {
        _utils.trace_enter("Enter resolve_symbol_type");
        if (sym is BoundSymbol.variable) {
            return sym.variable.bound_type;
        }
        if (sym is BoundSymbol.function_sym) {
            return sym.function_sym.bound_type;
        }
        if (sym is BoundSymbol.type_sym) {
            return sym.type_sym.bound_type;
        }
        if (sym is BoundSymbol.enum_member) {
            return sym.enum_member.bound_type;
        }
        return new BoundType();
    }

    fun expr_contains_try_bind(mut this, expr: Expression) -> bool {
        if (expr is Expression.try_bind) { return true; }
        if (expr is Expression.parenthesized) {
            if (expr.parenthesized.inner.is_some()) {
                return this.expr_contains_try_bind(expr.parenthesized.inner.some);
            }
        }
        if (expr is Expression.binary) {
            let i: mut i64 = 0;
            while (i < cast<i64>(expr.binary.operands.size())) {
                if (this.expr_contains_try_bind(expr.binary.operands.at(cast<u64>(i)).some)) { return true; }
                i = i + 1;
            }
        }
        return false;
    }

    // P2: bind a logical chain (&& or ||) that contains try-binds with region
    // scoping. `&&` operands share one region (left-to-right: an earlier
    // try-bind's variable is visible to later operands, and — inside an
    // if/while condition region — promotes into the then-branch). `||` operands
    // are isolated: a variable bound in one operand is invisible to the others.
    fun bind_logical_chain(mut this, expr: BinaryExpression, scope: mut BoundScope, is_and: bool) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_logical_chain");
        let operators: mut _utils.List<BinaryOperator> = new _utils.List<BinaryOperator>();
        let j: mut i64 = 0;
        while (j < cast<i64>(expr.operators.size())) {
            operators.push(expr.operators.at(cast<u64>(j)).some);
            j = j + 1;
        }
        let operands: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
        if (is_and) {
            if (scope.is_condition_region) {
                // Whole if/while condition is the region: bind operands directly
                // so bindings promote into the then-branch.
                let i: mut i64 = 0;
                while (i < cast<i64>(expr.operands.size())) {
                    let bound_op: Option<BoundExpression> = this.bind_expression(expr.operands.at(cast<u64>(i)).some, scope);
                    if (bound_op.is_some()) { operands.push(bound_op.some); }
                    i = i + 1;
                }
            } else {
                let chain_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<logical-and>", scope.full_name + ".<logical-and>", new Option<BoundScope>.some(scope));
                chain_scope.is_region = true;
                let i: mut i64 = 0;
                while (i < cast<i64>(expr.operands.size())) {
                    let bound_op: Option<BoundExpression> = this.bind_expression(expr.operands.at(cast<u64>(i)).some, chain_scope);
                    if (bound_op.is_some()) { operands.push(bound_op.some); }
                    i = i + 1;
                }
            }
        } else {
            let chain_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<logical-or>", scope.full_name + ".<logical-or>", new Option<BoundScope>.some(scope));
            chain_scope.is_region = true;
            let i: mut i64 = 0;
            while (i < cast<i64>(expr.operands.size())) {
                let op_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<logical-or-operand>", scope.full_name + ".<logical-or-operand>", new Option<BoundScope>.some(chain_scope));
                op_scope.is_region = true;
                let bound_op: Option<BoundExpression> = this.bind_expression(expr.operands.at(cast<u64>(i)).some, op_scope);
                if (bound_op.is_some()) { operands.push(bound_op.some); }
                i = i + 1;
            }
        }
        let result: mut BoundBinaryExpression = new BoundBinaryExpression(this.type_registry.bool_type, operators, operands);
        return new Option<BoundExpression>.some(new BoundExpression.binary(result));
    }

    fun bind_binary(mut this, expr: BinaryExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_binary");
        // P2: a logical chain containing try-binds needs region scoping.
        if (cast<i64>(expr.operators.size()) > 0 && this.expr_contains_try_bind(new Expression.binary(expr))) {
            let all_and: mut bool = true;
            let all_or: mut bool = true;
            let oi: mut i64 = 0;
            while (oi < cast<i64>(expr.operators.size())) {
                let op: BinaryOperator = expr.operators.at(cast<u64>(oi)).some;
                if (!(op is BinaryOperator.LogicalAnd)) { all_and = false; }
                if (!(op is BinaryOperator.LogicalOr)) { all_or = false; }
                oi = oi + 1;
            }
            if (all_and) { return this.bind_logical_chain(expr, scope, true); }
            if (all_or) { return this.bind_logical_chain(expr, scope, false); }
            this.report_error(new ErrorCode.E_UNSUPPORTED(),
                "try-bind in a mixed && / || chain is not supported yet",
                new SourceLocation("", 0, 0));
            return new Option<BoundExpression>.none();
        }
        let operands: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
        let i: mut i64 = 0;
        while (i < cast<i64>(expr.operands.size())) {
            let bound_op: Option<BoundExpression> = this.bind_expression(expr.operands.at(cast<u64>(i)).some, scope);
            if (bound_op.is_some()) {
                operands.push(bound_op.some);
            }
            i = i + 1;
        }
        let operators: mut _utils.List<BinaryOperator> = new _utils.List<BinaryOperator>();
        let j: mut i64 = 0;
        while (j < cast<i64>(expr.operators.size())) {
            operators.push(expr.operators.at(cast<u64>(j)).some);
            j = j + 1;
        }
        if (cast<i64>(operands.size()) > 0) {
            let bt: BoundType = operands.at(cast<u64>(0)).some.get_bound_type();
            // Comparison and `is` operators produce bool result
            if (cast<i64>(operators.size()) > 0) {
                let first_op: BinaryOperator = operators.at(cast<u64>(0)).some;
                if (first_op is BinaryOperator.Is
                    || first_op is BinaryOperator.Equal
                    || first_op is BinaryOperator.NotEqual
                    || first_op is BinaryOperator.LessThan
                    || first_op is BinaryOperator.GreaterThan
                    || first_op is BinaryOperator.LessThanOrEqual
                    || first_op is BinaryOperator.GreaterThanOrEqual) {
                    let bool_type: BoundType = this.type_registry.resolve_type("bool").some;
                    let result: mut BoundBinaryExpression = new BoundBinaryExpression(bool_type, operators, operands);
                    return new Option<BoundExpression>.some(new BoundExpression.binary(result));
                }
            }
            let result: mut BoundBinaryExpression = new BoundBinaryExpression(bt, operators, operands);
            return new Option<BoundExpression>.some(new BoundExpression.binary(result));
        }
        let result: mut BoundBinaryExpression = new BoundBinaryExpression(new BoundType(), operators, operands);
        return new Option<BoundExpression>.some(new BoundExpression.binary(result));
    }

    fun bind_unary(mut this, expr: UnaryExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_unary");
        if (expr.operand.is_some()) {
            let bound_inner: Option<BoundExpression> = this.bind_expression(expr.operand.some, scope);
            if (bound_inner.is_some()) {
                let bt: BoundType = bound_inner.some.get_bound_type();
                let result: mut BoundUnaryExpression = new BoundUnaryExpression(bt, expr.operator_value, bound_inner);
                return new Option<BoundExpression>.some(new BoundExpression.unary(result));
            }
        }
        let result: mut BoundUnaryExpression = new BoundUnaryExpression(new BoundType(), expr.operator_value, new Option<BoundExpression>.none());
        return new Option<BoundExpression>.some(new BoundExpression.unary(result));
    }

    fun get_field_mutability_from_class(this, cls: BoundClassDefinition, field_name: string) -> Mutability {
        _utils.trace_enter("Enter get_field_mutability_from_class");
        let fi: mut i64 = 0;
        while (fi < cast<i64>(cls.fields.size())) {
            let fd: BoundDefinition = cls.fields.at(cast<u64>(fi)).some;
            if (fd is BoundDefinition.class_field) {
                if (fd.class_field.name == field_name) {
                    return fd.class_field.mutability;
                }
            }
            fi = fi + 1;
        }
        return new Mutability.Mutable();
    }

    // True when a field's declared type is one of the class's generic params
    // (e.g. `a: T` in `#template(T: type) class A`). Such fields are implicitly
    // immutable — you can't know whether T is a value or reference type, so
    // BabyPenguin treats the substituted arg as immutable (`A<!mut i32>.a`).
    fun field_is_generic_param(this, cls: BoundClassDefinition, field_name: string) -> bool {
        _utils.trace_enter("Enter field_is_generic_param");
        if (let ast_def := cls.ast_source.some) {
            if (ast_def is Definition.class_def) {
                let ast_cls: ClassDefinition = ast_def.class_def;
                let mi: mut i64 = 0;
                while (mi < cast<i64>(ast_cls.members.size())) {
                    let member: Definition = ast_cls.members.at(cast<u64>(mi)).some;
                    if (member is Definition.class_field) {
                        if (member.class_field.name == field_name) {
                            if (let ts := member.class_field.type_spec.some) {
                                // `auto T` explicitly follows container mutability,
                                // so it is not implicitly immutable.
                                if (ts.is_auto_mutability) { return false; }
                                let ts_name: string = ts.name;
                                let gi: mut i64 = 0;
                                while (gi < cast<i64>(cls.generic_params.size())) {
                                    if (cls.generic_params.at(cast<u64>(gi)).some == ts_name) {
                                        return true;
                                    }
                                    gi = gi + 1;
                                }
                            }
                        }
                    }
                    mi = mi + 1;
                }
            }
        }
        return false;
    }

    fun resolve_field_type_from_class(this, base_type: BoundType, cls: BoundClassDefinition, field_name: string, scope: BoundScope) -> mut BoundType {
        _utils.trace_enter("Enter resolve_field_type_from_class");
        // If base type has generic args, look up the field in the specialized class
        if (cast<i64>(base_type.generic_args.size()) > 0) {
            let mangled: string = mangle_generic_name(cls.name, base_type.generic_args);
            let spec_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(mangled);
            if (spec_sym.is_some() && spec_sym.some is BoundSymbol.type_sym) {
                let spec_bt: BoundType = spec_sym.some.type_sym.bound_type;
                if (let spec_td := spec_bt.type_definition.some) {
                    if (spec_td is BoundDefinition.class_def) {
                        let spec_cls: BoundClassDefinition = spec_td.class_def;
                        let fi: mut i64 = 0;
                        while (fi < cast<i64>(spec_cls.fields.size())) {
                            let fd: BoundDefinition = spec_cls.fields.at(cast<u64>(fi)).some;
                            if (fd is BoundDefinition.class_field) {
                                if (fd.class_field.name == field_name) {
                                    return fd.class_field.bound_type;
                                }
                            }
                            fi = fi + 1;
                        }
                    }
                }
            }
        }
        // Fallback: search in generic class fields
        let fi: mut i64 = 0;
        while (fi < cast<i64>(cls.fields.size())) {
            let fd: BoundDefinition = cls.fields.at(cast<u64>(fi)).some;
            if (fd is BoundDefinition.class_field) {
                if (fd.class_field.name == field_name) {
                    return fd.class_field.bound_type;
                }
            }
            fi = fi + 1;
        }
        return new BoundType();
    }

    fun bind_member_access(mut this, expr: MemberAccessExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_member_access");
        if (expr.base_expr.is_some()) {
            let bound_base: Option<BoundExpression> = this.bind_expression(expr.base_expr.some, scope);
            if (bound_base.is_some()) {
                let base_type: BoundType = bound_base.some.get_bound_type();
                if (let td := base_type.type_definition.some) {
                    if (td is BoundDefinition.class_def) {
                        let cls: BoundClassDefinition = td.class_def;
                        if (cls.scope.is_some()) {
                            let found: Option<BoundSymbol> = cls.scope.some.lookup_symbol(expr.member_name);
                            if (found.is_some()) {
                                let bt: mut BoundType = this.resolve_symbol_type(found.some);
                                // For fields, look up the field definition for accurate type
                                if (found.some is BoundSymbol.variable) {
                                    if (found.some.variable.variable_kind is VariableSymbolKind.Field) {
                                        bt = this.resolve_field_type_from_class(base_type, cls, expr.member_name, scope);
                                        // Adjust field type mutability based on field's declared
                                        // mutability (Auto/Mutable/Immutable) and container mutability.
                                        let field_mut: Mutability = this.get_field_mutability_from_class(cls, expr.member_name);
                                        if (field_mut is Mutability.Auto) {
                                            // For Auto fields, use container's mutability
                                            // UNLESS the field type already has explicit Mutable
                                            // (from generic specialization like A<mut i32>), or the
                                            // field's type is a generic param (implicitly immutable).
                                            // A generic-param field is only immutable when the
                                            // substituted arg is NOT explicitly mutable (A<mut i32>
                                            // stays mutable — the field's own type carries it).
                                            if (this.field_is_generic_param(cls, expr.member_name)) {
                                                if (!(bt.mutability is Mutability.Mutable)) {
                                                    bt = bt.with_mutability(new Mutability.Immutable());
                                                }
                                            } else if (!(bt.mutability is Mutability.Mutable)) {
                                                bt = bt.with_mutability(base_type.mutability);
                                            }
                                        } else if (field_mut is Mutability.Mutable) {
                                            bt = bt.with_mutability(new Mutability.Mutable());
                                        } else if (field_mut is Mutability.Immutable) {
                                            bt = bt.with_mutability(new Mutability.Immutable());
                                        }
                                    }
                                }
                                let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, found);
                                return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                            }
                            // Fallback: search implemented interface scopes for default methods.
                            // Detect ambiguity: if two or more implemented interfaces each
                            // provide a member with this name, the access is ambiguous
                            // (e.g. Foo.foo() where Foo implements both IB and IC, each
                            // defining foo). Collect every matching interface first so we
                            // never silently pick the first.
                            let vi: mut i64 = 0;
                            let match_iface_names: mut _utils.List<string> = new _utils.List<string>();
                            while (vi < cast<i64>(cls.vtables.size())) {
                                let vtable: BoundVTable = cls.vtables.at(cast<u64>(vi)).some;
                                let iface_type: BoundType = vtable.interface_type;
                                if (let iface_def := iface_type.type_definition.some) {
                                    if (iface_def is BoundDefinition.interface_def) {
                                        let iface: BoundInterfaceDefinition = iface_def.interface_def;
                                        if (iface.scope.is_some()) {
                                            let iface_found: Option<BoundSymbol> = iface.scope.some.lookup_symbol(expr.member_name);
                                            if (iface_found.is_some()) {
                                                match_iface_names.push(iface.name);
                                            }
                                        }
                                    }
                                }
                                vi = vi + 1;
                            }
                            if (cast<i64>(match_iface_names.size()) > 1) {
                                this.report_error(new ErrorCode.E_INTERNAL(),
                                    "Ambiguous member '" + expr.member_name + "' on type '" + cls.name +
                                    "': provided by multiple implemented interfaces ('" +
                                    match_iface_names.at(cast<u64>(0)).some + "', '" +
                                    match_iface_names.at(cast<u64>(1)).some + "')",
                                    new SourceLocation("", 0, 0));
                                let ambig_result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(this.type_registry.make_error_type(), bound_base, expr.member_name, new Option<BoundSymbol>.none());
                                return new Option<BoundExpression>.some(new BoundExpression.member_access(ambig_result));
                            }
                            if (cast<i64>(match_iface_names.size()) == 1) {
                                // Exactly one interface provides the member — resolve it.
                                let vi2: mut i64 = 0;
                                while (vi2 < cast<i64>(cls.vtables.size())) {
                                    let vtable: BoundVTable = cls.vtables.at(cast<u64>(vi2)).some;
                                    let iface_type: BoundType = vtable.interface_type;
                                    if (let iface_def := iface_type.type_definition.some) {
                                        if (iface_def is BoundDefinition.interface_def) {
                                            let iface: BoundInterfaceDefinition = iface_def.interface_def;
                                            if (iface.scope.is_some()) {
                                                let iface_found: Option<BoundSymbol> = iface.scope.some.lookup_symbol(expr.member_name);
                                                if (iface_found.is_some()) {
                                                    let bt: BoundType = this.resolve_symbol_type(iface_found.some);
                                                    let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, iface_found);
                                                    return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                                                }
                                            }
                                        }
                                    }
                                    vi2 = vi2 + 1;
                                }
                            }
                        }
                    }
                    if (td is BoundDefinition.enum_def) {
                        let e: BoundEnumDefinition = td.enum_def;
                        if (e.scope.is_some()) {
                            let found: Option<BoundSymbol> = e.scope.some.lookup_symbol(expr.member_name);
                            if (let sym := found.some) {
                                let bt: mut BoundType = this.resolve_symbol_type(sym);
                                if (sym is BoundSymbol.enum_member) {
                                    // Prefer the enum definition's member_type, which
                                    // resolve_enum_types updates (pass 2). The scope
                                    // symbol's member_type can be stale (void) on the
                                    // BabyPenguin VM (pass1) because the value-copy
                                    // there does not propagate the mutation.
                                    bt = sym.enum_member.member_type;
                                    let midx: i64 = sym.enum_member.enum_value;
                                    if (midx >= 0 && midx < cast<i64>(e.members.size())) {
                                        bt = e.members.at(cast<u64>(midx)).some.member_type;
                                    }
                                    bt = this.substitute_generic_args(bt, base_type, new BoundDefinition.enum_def(e));
                                }
                                let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, found);
                                return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                            }
                        }
                        // Fallback: search implemented interface scopes for methods
                        let vi: mut i64 = 0;
                        while (vi < cast<i64>(e.vtables.size())) {
                            let vtable: BoundVTable = e.vtables.at(cast<u64>(vi)).some;
                            let iface_type: BoundType = vtable.interface_type;
                            if (let iface_def := iface_type.type_definition.some) {
                                if (iface_def is BoundDefinition.interface_def) {
                                    let iface: BoundInterfaceDefinition = iface_def.interface_def;
                                    if (iface.scope.is_some()) {
                                        let iface_found: Option<BoundSymbol> = iface.scope.some.lookup_symbol(expr.member_name);
                                        if (iface_found.is_some()) {
                                            let bt: BoundType = this.resolve_symbol_type(iface_found.some);
                                            let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, iface_found);
                                            return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                                        }
                                    }
                                }
                            }
                            vi = vi + 1;
                        }
                    }
                    if (td is BoundDefinition.interface_def) {
                        let iface: BoundInterfaceDefinition = td.interface_def;
                        // For a generic interface base (e.g. f.bar() where f: IFoo<u8>),
                        // resolve through the specialized def (IFoo__u8) so method
                        // signatures use concrete types (T -> u8) and the symbol points
                        // to the specialized method (ns.IFoo__u8.bar). Falls back to
                        // the template scope for non-generic interfaces.
                        let search_scope: Option<BoundScope> = this.specialized_interface_scope(iface, base_type, scope);
                        if (search_scope.is_some()) {
                            let found: Option<BoundSymbol> = search_scope.some.lookup_symbol(expr.member_name);
                            if (found.is_some()) {
                                let bt: BoundType = this.resolve_symbol_type(found.some);
                                let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, found);
                                return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                            }
                        }
                    }
                }
                // Handle namespace-qualified access (e.g., Foo.msg where Foo is a namespace)
                if (bound_base.some is BoundExpression.identifier) {
                    let base_id: BoundIdentifierExpression = bound_base.some.identifier;
                    if (let base_sym := base_id.symbol.some) {
                        if (base_sym is BoundSymbol.namespace_sym) {
                            let ns_scope: Option<BoundScope> = base_sym.namespace_sym.namespace_scope;
                            if (ns_scope.is_some()) {
                                let found: Option<BoundSymbol> = ns_scope.some.lookup_symbol(expr.member_name);
                                if (found.is_some()) {
                                    let bt: BoundType = this.resolve_symbol_type(found.some);
                                    let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(bt, bound_base, expr.member_name, found);
                                    return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
                                }
                            }
                        }
                    }
                }
                // Member not found: if base is a concrete type (class, enum),
                // report E_RESOLVE_SYMBOL instead of silently creating an empty
                // member access (which causes E_INTERNAL in the IR generator).
                // `.copy()` on a value type is auto-generated ICopy and is resolved
                // by bind_function_call, so don't report it here.
                let is_value_copy: bool = expr.member_name == "copy" && this.base_type_has_icopy(base_type);
                if (base_type.type_definition.is_some() && !is_value_copy) {
                    let td: BoundDefinition = base_type.type_definition.some;
                    if (td is BoundDefinition.class_def || td is BoundDefinition.enum_def) {
                        this.report_error(new ErrorCode.E_RESOLVE_SYMBOL(),
                            "Type '" + base_type.display_name() + "' has no member '" + expr.member_name + "'",
                            new SourceLocation("", 0, 0));
                    }
                }
                let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(new BoundType(), bound_base, expr.member_name, new Option<BoundSymbol>.none());
                return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
            }
        }
        let result: mut BoundMemberAccessExpression = new BoundMemberAccessExpression(new BoundType(), new Option<BoundExpression>.none(), expr.member_name, new Option<BoundSymbol>.none());
        return new Option<BoundExpression>.some(new BoundExpression.member_access(result));
    }

    fun find_function_return_type(this, sym: mut BoundFunctionSymbol) -> BoundType {
        _utils.trace_enter("Enter find_function_return_type");
        if (sym.resolved_return_type.is_some()) {
            return sym.resolved_return_type.some;
        }
        if (this.current_unit.is_some()) {
            let found: BoundType = this.search_function_return_type_in_defs(sym.full_name, this.current_unit.some.definitions);
            if (found.kind is TypeKind.PrimitiveKind) {
                let pt: PrimitiveType = found.primitive;
                if (pt is PrimitiveType.VoidType) {
                    // The def search yielded void — either the function genuinely
                    // returns void, or (for builtin-registered externs whose
                    // declaration lives in a namespace, e.g. gc_info at
                    // <global>.gc_info vs its <global>.__builtin.gc_info
                    // def) no matching def was found. The symbol's own return_type is
                    // authoritative in both cases, so prefer it (returning `found`
                    // here would wrongly make every such call void-typed).
                    sym.resolved_return_type = new Option<BoundType>.some(sym.return_type);
                    return sym.return_type;
                } else {
                    sym.resolved_return_type = new Option<BoundType>.some(found);
                }
                return found;
            } else {
                sym.resolved_return_type = new Option<BoundType>.some(found);
                return found;
            }
        }
        return sym.return_type;
    }

    fun is_nonvoid_type(this, t: BoundType) -> bool {
        if (t.kind is TypeKind.PrimitiveKind) {
            return !(t.primitive is PrimitiveType.VoidType);
        }
        return true;
    }

    fun search_function_return_type_in_defs(this, target_full_name: string, defs: mut _utils.List<BoundDefinition>) -> BoundType {
        _utils.trace_enter("Enter search_function_return_type_in_defs");
        let i: mut i64 = 0;
        while (i < cast<i64>(defs.size())) {
            let def: BoundDefinition = defs.at(cast<u64>(i)).some;
            if (def is BoundDefinition.function_def) {
                if (def.function_def.full_name == target_full_name) {
                    return def.function_def.return_type;
                }
            }
            if (def is BoundDefinition.namespace_def) {
                let ns_result: BoundType = this.search_function_return_type_in_defs(target_full_name, def.namespace_def.children);
                if (this.is_nonvoid_type(ns_result)) {
                    return ns_result;
                }
            }
            if (def is BoundDefinition.class_def) {
                let cls_result: BoundType = this.search_function_return_type_in_defs(target_full_name, def.class_def.methods);
                if (this.is_nonvoid_type(cls_result)) {
                    return cls_result;
                }
                let ctor_result: BoundType = this.search_function_return_type_in_defs(target_full_name, def.class_def.constructors);
                if (this.is_nonvoid_type(ctor_result)) {
                    return ctor_result;
                }
            }
            i = i + 1;
        }
        return this.type_registry.void_type;
    }

    // A function is a "method" (instance member) iff its first parameter is
    // `this`. Free functions / static helpers declared inside a class have no
    // `this` parameter. function_sym.parameters is populated for every function
    // in bind_function_symbols (and for externs at registration).
    fun function_is_method(this, sym: BoundFunctionSymbol) -> bool {
        _utils.trace_enter("Enter function_is_method");
        if (cast<i64>(sym.parameters.size()) > 0) {
            return sym.parameters.at(cast<u64>(0)).some.name == "this";
        }
        return false;
    }

    // Single-letter uppercase names are the generic template param convention
    // (T, K, E, V). Used to skip arg-type checks against unsubstituted template
    // params, which would otherwise produce cascading false positives.
    // True when `bt`'s type_definition is a template-param dummy — a
    // BoundClassDefinition created solely when a generic parameter is declared in
    // a scope (`#template(T: type)` registers T as a dummy class with no AST
    // source, fields, methods, or vtables). Real types always go through
    // bind_class_def / specialize_class_def, which set ast_source, so they never
    // match. This is strictly "is this the scope-registered template param",
    // not a name guess — a real type named `T` is not a template param.
    fun is_template_param_type(this, bt: BoundType) -> bool {
        if (bt.kind is TypeKind.ClassKind && bt.type_definition.is_some()) {
            let td: BoundDefinition = bt.type_definition.some;
            if (td is BoundDefinition.class_def) {
                let cls: BoundClassDefinition = td.class_def;
                if (cls.ast_source.is_none()
                    && cast<i64>(cls.fields.size()) == 0
                    && cast<i64>(cls.methods.size()) == 0
                    && cast<i64>(cls.vtables.size()) == 0) {
                    return true;
                }
            }
        }
        return false;
    }

    // True when a type (or a generic arg nested in it) is an unsubstituted
    // template param (e.g. `T` or `Option<T>`). Such params can't be checked
    // against call args until the callee is monomorphized.
    fun param_type_is_template(this, param_type: BoundType) -> bool {
        if (this.is_template_param_type(param_type)) {
            return true;
        }
        let gi: mut i64 = 0;
        while (gi < cast<i64>(param_type.generic_args.size())) {
            if (this.param_type_is_template(param_type.generic_args.at(cast<u64>(gi)).some)) {
                return true;
            }
            gi = gi + 1;
        }
        return false;
    }

    // Check each call argument against the callee's parameter type, reporting
    // E_CAST_INVALID on a non-implicitly-castable mismatch (BabyPenguin: convertParams).
    // Integer literals coerce to any integer param type; args whose bound type is
    // void/error (from a prior diagnostic) and generic template params (T unsubstituted)
    // are skipped to avoid cascading false positives.
    fun check_argument_types(mut this, sym: BoundFunctionSymbol, args: mut _utils.List<BoundExpression>) {
        _utils.trace_enter("Enter check_argument_types");
        let arg_i: mut i64 = 0;
        while (arg_i < cast<i64>(args.size())) {
            let param_idx: mut i64 = arg_i;
            if (this.function_is_method(sym)) {
                param_idx = arg_i + 1;
            }
            if (param_idx < cast<i64>(sym.parameters.size())) {
                let param_type: BoundType = sym.parameters.at(cast<u64>(param_idx)).some.bound_type;
                let arg_expr: BoundExpression = args.at(cast<u64>(arg_i)).some;
                let arg_type: BoundType = arg_expr.get_bound_type();
                if (this.type_registry.is_void(param_type) || this.type_registry.is_void(arg_type)
                    || param_type.kind is TypeKind.ErrorKind || arg_type.kind is TypeKind.ErrorKind) {
                    arg_i = arg_i + 1;
                    continue;
                }
                if (this.param_type_is_template(param_type)) {
                    arg_i = arg_i + 1;
                    continue;
                }
                let is_int_lit: bool = if (arg_expr is BoundExpression.literal) {
                    arg_expr.literal.literal_kind is LiteralKind.IntegerLiteral
                } else if (arg_expr is BoundExpression.unary) {
                    // Negative integer literal: `-1` binds as a unary negation of a
                    // literal, which should coerce to an integer param like `0` does.
                    arg_expr.unary.operator_value is UnaryOperator.Negate
                    && arg_expr.unary.operand.is_some()
                    && arg_expr.unary.operand.some is BoundExpression.literal
                    && arg_expr.unary.operand.some.literal.literal_kind is LiteralKind.IntegerLiteral
                } else {
                    false
                };
                let int_literal_coercion: bool = is_int_lit && this.type_registry.is_integer(param_type);
                if (!this.type_registry.can_implicitly_cast(arg_type, param_type) && !int_literal_coercion) {
                    this.report_error(new ErrorCode.E_CAST_INVALID(),
                        "Argument " + cast<string>(arg_i + 1) + " type mismatch in '" + sym.name + "': expected " + param_type.display_name() + " but got " + arg_type.display_name(),
                        sym.location);
                }
            }
            arg_i = arg_i + 1;
        }
    }

    fun bind_function_call(mut this, expr: FunctionCallExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_function_call");
        // req3+4: a value-template call — the callee identifier carries
        // value_generic_args (fab<5>(), fab<N-1>()). At a host call site the callee
        // is a #fun (meta function), so splice as a meta call. Inside a #fun body
        // (compiled as unit B) the callee is an ordinary function, so the value args
        // become ordinary call arguments: fab<N-1>() -> fab(N-1).
        if (expr.callee.is_some()) {
            if (expr.callee.some is Expression.identifier) {
                let vid: IdentifierExpression = expr.callee.some.identifier;
                if (cast<i64>(vid.value_generic_args.size()) > 0) {
                    if (this.find_meta_function(vid.name).is_some()) {
                        let mc: mut MetaCallExpression = new MetaCallExpression();
                        mc.func_name = vid.name;
                        mc.location = new SourceLocation("", 0, 0);
                        let vi: mut i64 = 0;
                        while (vi < cast<i64>(vid.value_generic_args.size())) {
                            mc.arguments.push(vid.value_generic_args.at(cast<u64>(vi)).some);
                            vi = vi + 1;
                        }
                        return this.bind_meta_call(mc, scope);
                    }
                    let rewritten: mut FunctionCallExpression = new FunctionCallExpression();
                    let clean_callee: mut IdentifierExpression = new IdentifierExpression(vid.name);
                    rewritten.callee = new Option<Expression>.some(new Expression.identifier(clean_callee));
                    let vi2: mut i64 = 0;
                    while (vi2 < cast<i64>(vid.value_generic_args.size())) {
                        rewritten.arguments.push(vid.value_generic_args.at(cast<u64>(vi2)).some);
                        vi2 = vi2 + 1;
                    }
                    let oi: mut i64 = 0;
                    while (oi < cast<i64>(expr.arguments.items.size())) {
                        rewritten.arguments.push(expr.arguments.items.at(cast<u64>(oi)).some);
                        oi = oi + 1;
                    }
                    return this.bind_function_call(rewritten, scope);
                }
            }
        }
        let args: mut _utils.List<BoundExpression> = this.bind_arguments(expr.arguments.items, scope);
        let mut empty_generic_args = new _utils.List<BoundType>();
        if (expr.callee.is_some()) {
            let callee: Option<BoundExpression> = this.bind_expression(expr.callee.some, scope);
            if (callee.is_some()) {
                if (callee.some is BoundExpression.identifier) {
                    let id_expr: BoundIdentifierExpression = callee.some.identifier;
                    if (let sym := id_expr.symbol.some) {
                        if (sym is BoundSymbol.function_sym) {
                            // Converse mismatch: a method (has `this`) called bare
                            // (no receiver) would emit no `this` argument, so the
                            // callee's first parameter reads garbage. Require an
                            // explicit receiver: this.method(...) or obj.method(...).
                            if (this.function_is_method(sym.function_sym)) {
                                this.report_error(new ErrorCode.E_CALL_CONVENTION(), "Method '" + sym.function_sym.name + "' has a 'this' parameter and must be called with a receiver (e.g. this." + sym.function_sym.name + "(...)), not bare", sym.function_sym.location);
                            }
                            // Resolve generic args from AST callee
                            let resolved_generic_args: mut _utils.List<BoundType> = new _utils.List<BoundType>();
                            let is_generic_call: mut bool = false;
                            if (let ast_callee := expr.callee.some) {
                                if (ast_callee is Expression.identifier) {
                                    if (cast<i64>(ast_callee.identifier.generic_args.size()) > 0) {
                                        is_generic_call = true;
                                        let gi: mut i64 = 0;
                                        while (gi < cast<i64>(ast_callee.identifier.generic_args.size())) {
                                            resolved_generic_args.push(this.resolve_type_specifier(ast_callee.identifier.generic_args.at(cast<u64>(gi)).some, scope));
                                            gi = gi + 1;
                                        }
                                    }
                                }
                            }
                            // For generic function calls, use specialized function's return type
                            if (is_generic_call) {
                                let mangled: string = mangle_generic_name(sym.function_sym.name, resolved_generic_args);
                                let spec_sym: Option<BoundSymbol> = scope.lookup_symbol(mangled);
                                if (spec_sym.is_some() && spec_sym.some is BoundSymbol.function_sym) {
                                    let spec_func_sym: mut BoundFunctionSymbol = spec_sym.some.function_sym;
                                    let bt: mut BoundType = this.find_function_return_type(spec_func_sym);
                                    let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(bt, callee, id_expr.symbol, args, false, resolved_generic_args, true);
                                    return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
                                }
                            }
                            // Check argument count
                            let param_count: i64 = cast<i64>(sym.function_sym.parameters.size());
                            let arg_count: i64 = cast<i64>(args.size());
                            let expected_args: mut i64 = param_count;
                            if (this.function_is_method(sym.function_sym)) {
                                expected_args = param_count - 1;
                            }
                            if (arg_count != expected_args) {
                                this.report_error(new ErrorCode.E_CALL_ARITY(),
                                    "Function '" + sym.function_sym.name + "' expects " + cast<string>(expected_args)
                                    + " arguments but " + cast<string>(arg_count) + " were provided",
                                    sym.function_sym.location);
                            }
                            this.check_argument_types(sym.function_sym, args);
                            let bt: mut BoundType = this.find_function_return_type(sym.function_sym);
                            let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(bt, callee, id_expr.symbol, args, false, resolved_generic_args, false);
                            return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
                        }
                    }
                }
                if (callee.some is BoundExpression.member_access) {
                    let ma_expr: BoundMemberAccessExpression = callee.some.member_access;
                    // `.copy()` on a value type (primitive with ICopy, value-class,
                    // or enum) is an auto-generated ICopy copy. Value types copy on
                    // assignment anyway, so lower the call to the base expression
                    // itself — no runtime function call is needed.
                    if (ma_expr.member_name == "copy" && ma_expr.base_expr.is_some()) {
                        let base_type: BoundType = ma_expr.base_expr.some.get_bound_type();
                        if (this.base_type_has_icopy(base_type)) {
                            return new Option<BoundExpression>.some(ma_expr.base_expr.some);
                        }
                    }
                    if (let sym := ma_expr.member_symbol.some) {
                        if (sym is BoundSymbol.function_sym) {
                            // A member function whose first parameter is not `this`
                            // may still be called via `receiver.foo(...)` -- the
                            // receiver is simply discarded at the call site (not
                            // passed). For interface-typed receivers the receiver is
                            // still used for vtable lookup (virtual dispatch), set in
                            // the dispatch-decision block below.
                            // Mutability check: calling `mut this` method on a receiver
                            // whose TYPE is immutable must fail (E_TYPE_MISMATCH), e.g.
                            // `let a : A = new A(); a.mutable()`. BabyPenguin compares
                            // the receiver's TYPE mutability against the `mut this` param
                            // ("Cant use !mut A as 'this' param of type mut A"), so an
                            // inferred `let a = new A()` (type is mutable) is allowed.
                            if (this.function_is_method(sym.function_sym) && ma_expr.base_expr.is_some()) {
                                let this_param: BoundFunctionParameter = sym.function_sym.parameters.at(cast<u64>(0)).some;
                                if (this_param.is_mutable) {
                                    let base_type: BoundType = ma_expr.base_expr.some.get_bound_type();
                                    if (base_type.mutability is Mutability.Immutable) {
                                        this.report_error(new ErrorCode.E_TYPE_MISMATCH(),
                                            "Cannot call method '" + sym.function_sym.name + "' with 'mut this' on an immutable binding",
                                            new SourceLocation("", 0, 0));
                                    }
                                }
                            }
                            // Resolve generic args from AST callee (member access with <T>)
                            let resolved_generic_args: mut _utils.List<BoundType> = new _utils.List<BoundType>();
                            let is_generic_method_call: mut bool = false;
                            if (let ast_callee := expr.callee.some) {
                                if (ast_callee is Expression.member_access) {
                                    if (cast<i64>(ast_callee.member_access.generic_args.size()) > 0) {
                                        is_generic_method_call = true;
                                        let gi: mut i64 = 0;
                                        while (gi < cast<i64>(ast_callee.member_access.generic_args.size())) {
                                            resolved_generic_args.push(this.resolve_type_specifier(ast_callee.member_access.generic_args.at(cast<u64>(gi)).some, scope));
                                            gi = gi + 1;
                                        }
                                    }
                                }
                            }
                            // For generic method calls, look up specialized method
                            if (is_generic_method_call) {
                                let mangled: string = mangle_generic_name(sym.function_sym.name, resolved_generic_args);
                                let spec_sym: Option<BoundSymbol> = scope.lookup_symbol(mangled);
                                if (spec_sym.is_some() && spec_sym.some is BoundSymbol.function_sym) {
                                    let spec_func_sym: mut BoundFunctionSymbol = spec_sym.some.function_sym;
                                    let bt: mut BoundType = this.find_function_return_type(spec_func_sym);
                                    let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(bt, callee, ma_expr.member_symbol, args, false, resolved_generic_args, true);
                                    return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
                                }
                            }
                            let bt: mut BoundType = this.find_function_return_type(sym.function_sym);
                            // Look up updated return type from class method definitions
                            if (ma_expr.base_expr.is_some()) {
                                let base_type: BoundType = ma_expr.base_expr.some.get_bound_type();
                                // For generic types, look up the specialized definition
                                if (cast<i64>(base_type.generic_args.size()) > 0 && base_type.type_definition.is_some()) {
                                    let orig_def: BoundDefinition = base_type.type_definition.some;
                                    if (orig_def is BoundDefinition.enum_def) {
                                        let spec_name: string = mangle_generic_name(orig_def.enum_def.name, base_type.generic_args);
                                        let spec_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(spec_name);
                                        if (spec_sym.is_some()) {
                                            if (spec_sym.some is BoundSymbol.type_sym) {
                                                let spec_type: BoundType = spec_sym.some.type_sym.bound_type;
                                                if (let spec_def := spec_type.type_definition.some) {
                                                    if (spec_def is BoundDefinition.enum_def) {
                                                        let spec_enum: BoundEnumDefinition = spec_def.enum_def;
                                                        let mi: mut i64 = 0;
                                                        while (mi < cast<i64>(spec_enum.methods.size())) {
                                                            let md: BoundDefinition = spec_enum.methods.at(cast<u64>(mi)).some;
                                                            if (md is BoundDefinition.function_def) {
                                                                if (md.function_def.name == sym.function_sym.name) {
                                                                    bt = md.function_def.return_type;
                                                                }
                                                            }
                                                            mi = mi + 1;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if (orig_def is BoundDefinition.class_def) {
                                        let spec_name: string = mangle_generic_name(orig_def.class_def.name, base_type.generic_args);
                                        let spec_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(spec_name);
                                        if (spec_sym.is_some()) {
                                            if (spec_sym.some is BoundSymbol.type_sym) {
                                                let spec_type: BoundType = spec_sym.some.type_sym.bound_type;
                                                if (let spec_def := spec_type.type_definition.some) {
                                                    if (spec_def is BoundDefinition.class_def) {
                                                        let spec_cls: BoundClassDefinition = spec_def.class_def;
                                                        let mi: mut i64 = 0;
                                                        while (mi < cast<i64>(spec_cls.methods.size())) {
                                                            let md: BoundDefinition = spec_cls.methods.at(cast<u64>(mi)).some;
                                                            if (md is BoundDefinition.function_def) {
                                                                if (md.function_def.name == sym.function_sym.name) {
                                                                    bt = md.function_def.return_type;
                                                                }
                                                            }
                                                            mi = mi + 1;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                } else if (base_type.type_definition.is_some()) {
                                    let td: BoundDefinition = base_type.type_definition.some;
                                    // Interface type: look up return type from interface definition
                                    if (td is BoundDefinition.interface_def) {
                                        let iface: BoundInterfaceDefinition = td.interface_def;
                                        let imi: mut i64 = 0;
                                        while (imi < cast<i64>(iface.methods.size())) {
                                            let md: BoundDefinition = iface.methods.at(cast<u64>(imi)).some;
                                            if (md is BoundDefinition.function_def) {
                                                if (md.function_def.name == sym.function_sym.name) {
                                                    bt = md.function_def.return_type;
                                                }
                                            }
                                            imi = imi + 1;
                                        }
                                    }
                                    if (td is BoundDefinition.class_def) {
                                        let cls: BoundClassDefinition = td.class_def;
                                        // Only apply the vtable default-method fallback below if the
                                        // class does not define the method itself (own methods or
                                        // interface_impls). Otherwise the interface's default return
                                        // type (e.g. IIterator<T>.iter -> IIterator<T>) wrongly
                                        // overrides the class's own method return type
                                        // (e.g. RangeIterator.iter -> mut RangeIterator).
                                        let cls_defines_method: mut bool = false;
                                        let mi: mut i64 = 0;
                                        while (mi < cast<i64>(cls.methods.size())) {
                                            let md: BoundDefinition = cls.methods.at(cast<u64>(mi)).some;
                                            if (md is BoundDefinition.function_def) {
                                                if (md.function_def.name == sym.function_sym.name) {
                                                    bt = md.function_def.return_type;
                                                    cls_defines_method = true;
                                                }
                                            }
                                            mi = mi + 1;
                                        }
                                        let ii: mut i64 = 0;
                                        while (ii < cast<i64>(cls.interface_impls.size())) {
                                            let impl_def: BoundDefinition = cls.interface_impls.at(cast<u64>(ii)).some;
                                            if (impl_def is BoundDefinition.impl_def) {
                                                let iface_impl: BoundInterfaceImplementation = impl_def.impl_def;
                                                let imi: mut i64 = 0;
                                                while (imi < cast<i64>(iface_impl.methods.size())) {
                                                    let md: BoundDefinition = iface_impl.methods.at(cast<u64>(imi)).some;
                                                    if (md is BoundDefinition.function_def) {
                                                        if (md.function_def.name == sym.function_sym.name) {
                                                            bt = md.function_def.return_type;
                                                            cls_defines_method = true;
                                                        }
                                                    }
                                                    imi = imi + 1;
                                                }
                                            }
                                            ii = ii + 1;
                                        }
                                        // Fallback: search interface definitions for default methods
                                        let vi: mut i64 = 0;
                                        while (vi < cast<i64>(cls.vtables.size())) {
                                            let vtable: BoundVTable = cls.vtables.at(cast<u64>(vi)).some;
                                            let iface_type: BoundType = vtable.interface_type;
                                            if (let iface_def := iface_type.type_definition.some) {
                                                if (iface_def is BoundDefinition.interface_def) {
                                                    let iface: BoundInterfaceDefinition = iface_def.interface_def;
                                                    let imi: mut i64 = 0;
                                                    while (imi < cast<i64>(iface.methods.size())) {
                                                        let md: BoundDefinition = iface.methods.at(cast<u64>(imi)).some;
                                                        if (md is BoundDefinition.function_def) {
                                                            if (md.function_def.name == sym.function_sym.name) {
                                                                if (!cls_defines_method) {
                                                                    bt = md.function_def.return_type;
                                                                }
                                                            }
                                                        }
                                                        imi = imi + 1;
                                                    }
                                                }
                                            }
                                            vi = vi + 1;
                                        }
                                    }
                                    if (td is BoundDefinition.enum_def) {
                                        let e: BoundEnumDefinition = td.enum_def;
                                        let mi: mut i64 = 0;
                                        while (mi < cast<i64>(e.methods.size())) {
                                            let md: BoundDefinition = e.methods.at(cast<u64>(mi)).some;
                                            if (md is BoundDefinition.function_def) {
                                                if (md.function_def.name == sym.function_sym.name) {
                                                    bt = md.function_def.return_type;
                                                }
                                            }
                                            mi = mi + 1;
                                        }
                                    }
                                    if (td is BoundDefinition.enum_def) {
                                        let enum_d: BoundEnumDefinition = td.enum_def;
                                        let eii: mut i64 = 0;
                                        while (eii < cast<i64>(enum_d.interface_impls.size())) {
                                            let impl_def: BoundDefinition = enum_d.interface_impls.at(cast<u64>(eii)).some;
                                            if (impl_def is BoundDefinition.impl_def) {
                                                let iface_impl: BoundInterfaceImplementation = impl_def.impl_def;
                                                let eimi: mut i64 = 0;
                                                while (eimi < cast<i64>(iface_impl.methods.size())) {
                                                    let md: BoundDefinition = iface_impl.methods.at(cast<u64>(eimi)).some;
                                                    if (md is BoundDefinition.function_def) {
                                                        if (md.function_def.name == sym.function_sym.name) {
                                                            bt = md.function_def.return_type;
                                                        }
                                                    }
                                                    eimi = eimi + 1;
                                                }
                                            }
                                            eii = eii + 1;
                                        }
                                        let evi: mut i64 = 0;
                                        while (evi < cast<i64>(enum_d.vtables.size())) {
                                            let vtable: BoundVTable = enum_d.vtables.at(cast<u64>(evi)).some;
                                            let iface_type: BoundType = vtable.interface_type;
                                            if (let iface_def := iface_type.type_definition.some) {
                                                if (iface_def is BoundDefinition.interface_def) {
                                                    let iface: BoundInterfaceDefinition = iface_def.interface_def;
                                                    let eimi: mut i64 = 0;
                                                    while (eimi < cast<i64>(iface.methods.size())) {
                                                        let md: BoundDefinition = iface.methods.at(cast<u64>(eimi)).some;
                                                        if (md is BoundDefinition.function_def) {
                                                            if (md.function_def.name == sym.function_sym.name) {
                                                                bt = md.function_def.return_type;
                                                            }
                                                        }
                                                        eimi = eimi + 1;
                                                    }
                                                }
                                            }
                                            evi = evi + 1;
                                        }
                                    }
                                }
                            }
                            let is_virt: mut bool = false;
                            let direct_disp: mut bool = false;
                            let direct_sym: mut Option<BoundSymbol> = ma_expr.member_symbol;
                            if (ma_expr.base_expr.is_some()) {
                                let base_type: BoundType = ma_expr.base_expr.some.get_bound_type();
                                if (base_type.kind is TypeKind.InterfaceKind) {
                                    // Check if this is a temporary box that can be elided:
                                    // cast<Interface>(value).method() → call method directly
                                    if (ma_expr.base_expr.some is BoundExpression.cast_expr) {
                                        let cast_e: BoundCastExpression = ma_expr.base_expr.some.cast_expr;
                                        if (cast_e.needs_boxing) {
                                            direct_disp = true;
                                            // Resolve the concrete implementation method from the value type's vtable
                                            if (cast_e.inner.is_some() && ma_expr.member_symbol.is_some()) {
                                                let inner_type: BoundType = cast_e.inner.some.get_bound_type();
                                                let resolved: Option<BoundFunctionSymbol> = this.resolve_implementation_method(inner_type, base_type, ma_expr.member_symbol.some);
                                                if (resolved.is_some()) {
                                                    direct_sym = new Option<BoundSymbol>.some(new BoundSymbol.function_sym(resolved.some));
                                                }
                                            }
                                        } else {
                                            is_virt = true;
                                        }
                                    } else {
                                        // Distinguish a value receiver (`f.foo()`) from a type-name
                                        // call (`IFoo.foo()` / `ns.IFoo.foo()`). A value receiver uses
                                        // virtual dispatch so the override is selected at runtime --
                                        // including for no-`this` (default/static) methods, where the
                                        // receiver is used only for the vtable lookup and not passed
                                        // (see lower_function_call). A type-name call stays static.
                                        let base_is_value: mut bool = false;
                                        if (ma_expr.base_expr.some is BoundExpression.identifier) {
                                            let base_id: BoundIdentifierExpression = ma_expr.base_expr.some.identifier;
                                            if (base_id.symbol.is_some()) {
                                                if (base_id.symbol.some is BoundSymbol.variable) {
                                                    base_is_value = true;
                                                }
                                            }
                                        }
                                        if (ma_expr.base_expr.some is BoundExpression.member_access) {
                                            // A member_access base is a value unless it resolves to a
                                            // type/namespace (e.g. `ns.IFoo` in `ns.IFoo.foo()`).
                                            let inner_ma: BoundMemberAccessExpression = ma_expr.base_expr.some.member_access;
                                            let inner_is_type_or_ns: mut bool = false;
                                            if (inner_ma.member_symbol.is_some()) {
                                                if (inner_ma.member_symbol.some is BoundSymbol.type_sym) { inner_is_type_or_ns = true; }
                                                if (inner_ma.member_symbol.some is BoundSymbol.namespace_sym) { inner_is_type_or_ns = true; }
                                            }
                                            if (!inner_is_type_or_ns) {
                                                base_is_value = true;
                                            }
                                        }
                                        if (ma_expr.base_expr.some is BoundExpression.function_call) {
                                            base_is_value = true;
                                        }
                                        if (base_is_value) {
                                            is_virt = true;
                                        } else if (ma_expr.member_symbol.is_some()) {
                                            // Static interface methods (no 'this' parameter) called on
                                            // the interface type name directly: no object receiver, so
                                            // no virtual dispatch.
                                            let ms: BoundSymbol = ma_expr.member_symbol.some;
                                            if (ms is BoundSymbol.function_sym) {
                                                if (this.function_is_method(ms.function_sym)) {
                                                    is_virt = true;
                                                }
                                            } else {
                                                is_virt = true;
                                            }
                                        }
                                    }
                                }
                            }
                            this.check_argument_types(sym.function_sym, args);
                            let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(bt, callee, direct_sym, args, is_virt, empty_generic_args, false);
                            if (direct_disp) {
                                result.direct_dispatch = true;
                            }
                            return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
                        }
                    }
                }
                let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(new BoundType(), callee, new Option<BoundSymbol>.none(), args, false, empty_generic_args, false);
                return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
            }
        }
        let result: mut BoundFunctionCallExpression = new BoundFunctionCallExpression(new BoundType(), new Option<BoundExpression>.none(), new Option<BoundSymbol>.none(), args, false, empty_generic_args, false);
        return new Option<BoundExpression>.some(new BoundExpression.function_call(result));
    }

    fun bind_arguments(mut this, args: _utils.List<Expression>, scope: mut BoundScope) -> mut _utils.List<BoundExpression> {
        _utils.trace_enter("Enter bind_arguments");
        let result: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
        let i: mut i64 = 0;
        while (i < cast<i64>(args.size())) {
            let bound_arg: Option<BoundExpression> = this.bind_expression(args.at(cast<u64>(i)).some, scope);
            if (bound_arg.is_some()) {
                result.push(bound_arg.some);
            }
            i = i + 1;
        }
        return result;
    }

    fun bind_meta_call(mut this, expr: MetaCallExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_meta_call");
        // Phase 5c: if this is a call to a registered #fun, JIT-execute it at
        // compile time and splice the result (integer literal, or a returned ast
        // re-bound at the call site). Only the JIT is reached in native pass2+
        // (--enable-meta); #funs are registered in collect_meta_function_defs
        // (pre-rewrite) and pass_build_scopes. If func_name is not a #fun, fall
        // through to a plain BoundMetaCallExpression (e.g. unknown #attribute, or
        // built-in meta like #defined/#option which are resolved elsewhere).
        let bmf_opt: Option<BoundMetaFunctionDefinition> = this.find_meta_function(expr.func_name);
        if (bmf_opt.is_some()) {
            let bmf: BoundMetaFunctionDefinition = bmf_opt.some;
            // req1: if a type-typed argument is a template type parameter that is not
            // yet specialized (it resolves in scope to its dummy placeholder), the call
            // cannot be JIT-evaluated in this — still generic — body. Defer it: emit a
            // zero placeholder so the (never-mononmorphized) generic body binds without
            // error. The specialized body, where T is concrete, re-binds and splices the
            // real result.
            if (this.meta_call_has_deferred_type_arg(expr, bmf, scope)) {
                return this.deferred_meta_call_placeholder(bmf);
            }
            let spliced: Option<BoundExpression> = this.try_splice_meta_fun_call(bmf, expr, scope);
            if (spliced.is_some()) {
                return spliced;
            }
            return new Option<BoundExpression>.none();
        }
        let bound_args: mut _utils.List<BoundExpression> = this.bind_arguments(expr.arguments, scope);
        // ast params take their argument positionally now — trailing blocks are
        // only supported for an `unstructured_ast` last param (raw text, bound in
        // bind_meta_args), so the parsed trailing-block slot is always empty.
        let result: mut BoundMetaCallExpression = new BoundMetaCallExpression(expr.func_name, bound_args, new Option<Expression>.none(), expr.trailing_definition, expr.location);
        return new Option<BoundExpression>.some(new BoundExpression.meta_call(result));
    }

    // Phase 5c: JIT-execute a #fun meta call (expression/statement position) and
    // return the spliced result. Arity 0..3 via the i64 trampolines. By return
    // kind: ast -> resolve token -> rebind the AST Expression at the call site;
    // i64/bool -> integer literal; type -> not yet supported (error). `expr` is
    // the original MetaCallExpression (carries args + trailing_block_raw + location).
    fun try_splice_meta_fun_call(mut this, bmf: BoundMetaFunctionDefinition, expr: MetaCallExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        this.seed_meta_engine();
        let args_opt: Option<_utils.List<i64>> = this.bind_meta_args(expr, bmf, scope);
        if (args_opt.is_none()) {
            return new Option<BoundExpression>.none();
        }
        let args: _utils.List<i64> = args_opt.some;
        let result_i64: mut i64 = this.meta_engine.call_meta_function_stub(bmf, args);
        let ret_kind: mut string = "";
        if (bmf.return_type.is_some()) {
            ret_kind = bmf.return_type.some.name;
        }
        if (ret_kind == "ast") {
            let node_opt: Option<Expression> = this.meta_engine.get_ast_expression(cast<u64>(result_i64));
            if (node_opt.is_some()) {
                return this.bind_expression(node_opt.some, scope);
            }
            this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta #" + bmf.name + " did not return an expression ast in expression position", expr.location);
            return new Option<BoundExpression>.none();
        }
        if (ret_kind == "string") {
            // Phase 5: the caller-stub stored the #fun's returned string into the
            // host global active_string_result (returning i64 0). Splice it as a
            // string literal. (Simple strings only — no quote/escape handling.)
            let s: string = penguin_meta_get_string_result();
            let bt: BoundType = this.type_registry.resolve_type("string").some;
            let lit: BoundLiteralExpression = new BoundLiteralExpression("\"" + s + "\"", bt, new LiteralKind.StringLiteral());
            return new Option<BoundExpression>.some(new BoundExpression.literal(lit));
        }
        if (ret_kind == "type") {
            this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta #" + bmf.name + " type-return splice is not supported in expression position (use a type-specifier position)", expr.location);
            return new Option<BoundExpression>.none();
        }
        let ret_type: BoundType = this.resolve_meta_return_type(bmf);
        let lit: BoundLiteralExpression = new BoundLiteralExpression(cast<string>(result_i64), ret_type, new LiteralKind.IntegerLiteral());
        return new Option<BoundExpression>.some(new BoundExpression.literal(lit));
    }

    // Phase 5c: JIT-execute a definition-position #fun call (a top-level/member
    // `#gen()` whose MetaCallDefinition wraps a #fun returning ast) and inject
    // the returned Definition into `out` so it flows through the normal passes as
    // if originally in source. Returns true if handled (caller skips the default
    // push); false to fall through and push the raw def.
    fun try_splice_meta_fun_def(mut this, d: MetaCallDefinition, out: mut _utils.List<Definition>) -> bool {
        if (let call := d.call.some) {
            if (call is Expression.meta_call) {
                let mc: MetaCallExpression = call.meta_call;
                let bmf_opt: Option<BoundMetaFunctionDefinition> = this.find_meta_function(mc.func_name);
                if (let bmf := bmf_opt.some) {
                    this.seed_meta_engine();
                    let args_opt: Option<_utils.List<i64>> = this.bind_meta_args(mc, bmf, this.global_scope);
                    if (args_opt.is_none()) {
                        return true;
                    }
                    let args: _utils.List<i64> = args_opt.some;
                    let result_i64: mut i64 = this.meta_engine.call_meta_function_stub(bmf, args);
                    let def_opt: Option<Definition> = this.meta_engine.get_ast_definition(cast<u64>(result_i64));
                    if (def_opt.is_some()) {
                        let single: mut _utils.List<Definition> = new _utils.List<Definition>();
                        single.push(def_opt.some);
                        this.collect_resolved_definitions(single, out);
                        return true;
                    }
                    this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta #" + bmf.name + " did not return a definition ast in definition position", mc.location);
                    return true;
                }
            }
        }
        return false;
    }

    // Phase 5c: build the i64 argument list for a #fun JIT call, binding each
    // argument per its parameter kind. type/ast args become opaque tokens (small
    // i64); integer args must be compile-time integer constants. A trailing code
    // block supplies the last ast-typed parameter when not given positionally.
    // Returns none (error reported) if an argument cannot be converted.
    fun bind_meta_args(mut this, expr: MetaCallExpression, bmf: BoundMetaFunctionDefinition, scope: mut BoundScope) -> Option<_utils.List<i64>> {
        this.seed_meta_engine();
        let result: mut _utils.List<i64> = new _utils.List<i64>();
        let nparams: i64 = cast<i64>(bmf.parameters.size());
        let nargs: i64 = cast<i64>(expr.arguments.size());
        let pi: mut i64 = 0;
        while (pi < nargs) {
            if (pi >= nparams) {
                this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta #" + bmf.name + " has too many arguments", expr.location);
                return new Option<_utils.List<i64>>.none();
            }
            let kind: string = bmf.parameters.at(cast<u64>(pi)).some.kind;
            let arg: Expression = expr.arguments.at(cast<u64>(pi)).some;
            let v: Option<i64> = this.bind_meta_arg_value(arg, kind, expr.location, scope);
            if (v.is_none()) {
                return new Option<_utils.List<i64>>.none();
            }
            result.push(v.some);
            pi = pi + 1;
        }
        // Trailing `{ ... }` blocks are supported ONLY for an `unstructured_ast`
        // last parameter — the block is captured as raw text and delivered as a
        // string. `ast` parameters take their argument positionally instead.
        if (expr.trailing_block_raw.is_some()) {
            if (nparams >= 1 && nargs < nparams) {
                let last_kind: string = bmf.parameters.at(cast<u64>(nparams - 1)).some.kind;
                if (last_kind == "unstructured_ast") {
                    let raw: string = expr.trailing_block_raw.some;
                    let token: u64 = this.meta_engine.register_string_value(raw);
                    result.push(cast<i64>(token));
                } else {
                    this.report_error(new ErrorCode.E_META(), "a trailing '{ ... }' block is only supported for an 'unstructured_ast' last parameter of #" + bmf.name + " (last param kind: '" + last_kind + "')", expr.location);
                    return new Option<_utils.List<i64>>.none();
                }
            }
        }
        return new Option<_utils.List<i64>>.some(result);
    }

    // Convert one meta argument to its i64 token/value according to param kind.
    fun bind_meta_arg_value(mut this, arg: Expression, kind: string, loc: SourceLocation, scope: mut BoundScope) -> Option<i64> {
        if (kind == "type") {
            // Accept either a bare type name (Point) or #typeof(Point). Resolve via
            // the MetaEngine (which consults the global scope for user types, not
            // just the primitive-only type_registry).
            let type_name: string = this.meta_type_arg_name(arg);
            if (type_name != "") {
                // req1: if type_name is a template type parameter specialized to a
                // concrete type (visible in the local scope chain), resolve it to that
                // concrete type's name so the assigned token is identical to
                // #typeof(ConcreteType). Falls back to the bare name for ordinary
                // (global) types.
                let resolve_name: mut string = type_name;
                let concrete_opt: Option<string> = this.meta_type_arg_concrete_name(type_name, scope);
                if (concrete_opt.is_some()) {
                    resolve_name = concrete_opt.some;
                }
                let bt_opt: Option<BoundType> = this.meta_engine.resolve_type_by_name(resolve_name);
                if (bt_opt.is_some()) {
                    let token: u64 = this.meta_engine.get_or_assign_type_token(resolve_name);
                    return new Option<i64>.some(cast<i64>(token));
                }
                this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta type argument '" + type_name + "' is not a known type", loc);
                return new Option<i64>.none();
            }
            this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta type argument must be a type name", loc);
            return new Option<i64>.none();
        }
        if (kind == "ast") {
            let token: u64 = this.meta_engine.register_ast_expression(arg);
            return new Option<i64>.some(cast<i64>(token));
        }
        if (kind == "string") {
            if (arg is Expression.string_literal) {
                let val: string = this.meta_strip_quotes(arg.string_literal.value);
                let token: u64 = this.meta_engine.register_string_value(val);
                return new Option<i64>.some(cast<i64>(token));
            }
            this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta string argument must be a string literal", loc);
            return new Option<i64>.none();
        }
        if (kind == "bool") {
            if (arg is Expression.bool_literal) {
                if (arg.bool_literal.value == "true") { return new Option<i64>.some(1); }
                return new Option<i64>.some(0);
            }
            this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta bool argument must be a bool literal (true/false)", loc);
            return new Option<i64>.none();
        }
        let bound_opt: Option<BoundExpression> = this.bind_expression(arg, scope);
        if (bound_opt.is_some()) {
            let iv: Option<i64> = this.bound_literal_i64_value(bound_opt.some);
            if (iv.is_some()) {
                return iv;
            }
        }
        this.report_error(new ErrorCode.E_UNSUPPORTED(), "meta argument of kind '" + kind + "' must be a compile-time constant (integer, bool, string, type, or ast)", loc);
        return new Option<i64>.none();
    }

    // req1: extract the type name carried by a meta type-argument expression —
    // either a bare identifier (Point) or #typeof(Point).
    fun meta_type_arg_name(this, arg: Expression) -> string {
        if (arg is Expression.identifier) {
            return arg.identifier.name;
        }
        if (arg is Expression.meta_call) {
            if (arg.meta_call.func_name == "typeof") {
                if (cast<i64>(arg.meta_call.arguments.size()) >= 1) {
                    let inner: Expression = arg.meta_call.arguments.at(cast<u64>(0)).some;
                    if (inner is Expression.identifier) {
                        return inner.identifier.name;
                    }
                }
            }
        }
        return "";
    }

    // req1: resolve a meta type-argument name through the scope chain. If `name`
    // is a template type parameter that has been specialized to a concrete type
    // (its scope symbol's bound_type is a real primitive or a user type whose own
    // name differs from `name`), return that concrete type's display name so the
    // assigned token is identical to #typeof(ConcreteType). Returns none when
    // `name` is not a scope-visible template param bound to a concrete type (the
    // caller then falls back to ordinary global resolution).
    fun meta_type_arg_concrete_name(this, name: string, scope: BoundScope) -> Option<string> {
        let sym_opt: Option<BoundSymbol> = this.resolve_type_by_name(name, scope);
        if (sym_opt.is_none()) { return new Option<string>.none(); }
        if (sym_opt.some is BoundSymbol.type_sym) {
            let bt: BoundType = sym_opt.some.type_sym.bound_type;
            if (bt.kind is TypeKind.PrimitiveKind && !(bt.primitive is PrimitiveType.VoidType)) {
                return new Option<string>.some(primitive_type_to_string(bt.primitive));
            }
            if (bt.type_definition.is_some()) {
                let td_name: string = bt.type_definition.some.get_name();
                // If the resolved type's own name equals the queried name, this is the
                // unspecialized dummy placeholder (T -> dummy "T"), not a concrete type.
                if (td_name != name) {
                    return new Option<string>.some(td_name);
                }
            }
        }
        return new Option<string>.none();
    }

    // req1: true if a type-typed meta argument is a template type parameter still
    // in its unspecialized (dummy) form — visible in the local scope but not yet
    // bound to a concrete type. Such a call cannot be JIT-evaluated yet and must be
    // deferred until specialization re-binds the body.
    fun meta_type_arg_is_deferred(this, name: string, scope: BoundScope) -> bool {
        let sym_opt: Option<BoundSymbol> = this.resolve_type_by_name(name, scope);
        if (sym_opt.is_none()) { return false; }
        if (sym_opt.some is BoundSymbol.type_sym) {
            let bt: BoundType = sym_opt.some.type_sym.bound_type;
            if (bt.kind is TypeKind.PrimitiveKind && !(bt.primitive is PrimitiveType.VoidType)) {
                return false;
            }
            if (bt.type_definition.is_some() && bt.type_definition.some.get_name() == name) {
                // `name` resolves locally to a type whose own name equals `name`. This
                // is either a real global type (e.g. Point) or an unspecialized
                // template-param placeholder (T). The placeholder is NOT present in the
                // global scope — only the real type is — so that distinguishes them.
                let g: Option<BoundSymbol> = this.global_scope.lookup_type_in_scope(name);
                if (g.is_some()) {
                    return false;
                }
                return true;
            }
        }
        return false;
    }

    // req1: does this meta call have any type-typed argument that is an
    // unspecialized template type parameter? Used to defer splicing in generic
    // template bodies (where T is still the dummy placeholder).
    fun meta_call_has_deferred_type_arg(this, expr: MetaCallExpression, bmf: BoundMetaFunctionDefinition, scope: BoundScope) -> bool {
        let nparams: i64 = cast<i64>(bmf.parameters.size());
        let nargs: i64 = cast<i64>(expr.arguments.size());
        let pi: mut i64 = 0;
        while (pi < nargs && pi < nparams) {
            let kind: string = bmf.parameters.at(cast<u64>(pi)).some.kind;
            if (kind == "type") {
                let arg: Expression = expr.arguments.at(cast<u64>(pi)).some;
                let name: string = this.meta_type_arg_name(arg);
                if (name != "") {
                    if (this.meta_type_arg_is_deferred(name, scope)) {
                        return true;
                    }
                }
            }
            pi = pi + 1;
        }
        return false;
    }

    // req1: a zero/empty placeholder for a meta call whose type arguments are not
    // yet specialized. The generic template body is never monomorphized, so this
    // value is never executed — it only lets the body bind without error. Typed to
    // match the #fun's declared return type where possible.
    fun deferred_meta_call_placeholder(this, bmf: BoundMetaFunctionDefinition) -> Option<BoundExpression> {
        let rt: BoundType = this.resolve_meta_return_type(bmf);
        if (rt.kind is TypeKind.PrimitiveKind) {
            if (rt.primitive is PrimitiveType.StringType) {
                let lit: BoundLiteralExpression = new BoundLiteralExpression("\"\"", rt, new LiteralKind.StringLiteral());
                return new Option<BoundExpression>.some(new BoundExpression.literal(lit));
            }
            let ilit: BoundLiteralExpression = new BoundLiteralExpression("0", rt, new LiteralKind.IntegerLiteral());
            return new Option<BoundExpression>.some(new BoundExpression.literal(ilit));
        }
        let i64t: BoundType = this.type_registry.i64_type;
        let ilit2: BoundLiteralExpression = new BoundLiteralExpression("0", i64t, new LiteralKind.IntegerLiteral());
        return new Option<BoundExpression>.some(new BoundExpression.literal(ilit2));
    }

    // Resolve a #fun's declared return type to a BoundType for the spliced
    // literal; falls back to an empty BoundType if it can't be resolved.
    fun resolve_meta_return_type(this, bmf: BoundMetaFunctionDefinition) -> BoundType {
        if (bmf.return_type.is_some()) {
            let rt_name: string = bmf.return_type.some.name;
            let rt_opt: Option<BoundType> = this.type_registry.resolve_type(rt_name);
            if (rt_opt.is_some()) {
                return rt_opt.some;
            }
        }
        return new BoundType();
    }

    fun find_meta_function(this, name: string) -> Option<BoundMetaFunctionDefinition> {
        let i: mut i64 = 0;
        while (i < cast<i64>(this.meta_function_defs.size())) {
            if (this.meta_function_defs.at(cast<u64>(i)).some.name == name) {
                return new Option<BoundMetaFunctionDefinition>.some(this.meta_function_defs.at(cast<u64>(i)).some);
            }
            i = i + 1;
        }
        return new Option<BoundMetaFunctionDefinition>.none();
    }

    // Extract an i64 from a bound integer literal, or none if not a constant int.
    fun bound_literal_i64_value(this, bexpr: BoundExpression) -> Option<i64> {
        if (bexpr is BoundExpression.literal) {
            if (bexpr.literal.literal_kind is LiteralKind.IntegerLiteral) {
                return new Option<i64>.some(string_to_int(bexpr.literal.value));
            }
        }
        return new Option<i64>.none();
    }

    fun seed_meta_engine(mut this) {
        if (!this.meta_engine_seeded) {
            this.meta_engine_seeded = true;
            this.meta_engine.verbose = this.verbose;
            this.meta_engine.host_type_registry = this.type_registry;
            // Phase 6: give MetaEngine access to the global scope so it can resolve
            // user-defined types (BoundTypeRegistry only knows primitives). It's a
            // reference, populated by pass_build_scopes before reflection runs.
            this.meta_engine.global_scope = new Option<BoundScope>.some(this.global_scope);
            // R3b: AST definitions fallback — for reflection at def-splice time
            // (before types are bound in global_scope).
            this.meta_engine.ast_definitions = new Option<_utils.List<Definition>>.some(this.ast_definitions);
            // req3+4: give the MetaEngine the full #fun set so a JIT-compiled #fun
            // can synthesize the other #funs it calls into its unit B.
            let mfi: mut i64 = 0;
            while (mfi < cast<i64>(this.meta_function_defs.size())) {
                this.meta_engine.all_meta_function_defs.push(this.meta_function_defs.at(cast<u64>(mfi)).some);
                mfi = mfi + 1;
            }
            // Phase 6 v2: feed collected `#class` definitions (build_text) into unit B
            // as the <meta_classes> source input, so #funs can use them.
            let class_src: mut StringBuilder = new StringBuilder();
            let ci: mut i64 = 0;
            while (ci < cast<i64>(this.meta_class_defs.size())) {
                class_src.append(this.meta_class_defs.at(cast<u64>(ci)).some.build_text());
                class_src.append("\n");
                ci = ci + 1;
            }
            this.meta_engine.meta_class_source = class_src.to_string();
            // Phase 6: register MetaEngine in the module-global active_meta slot so
            // JIT'd #fun code can call back into the host via penguin_meta_* functions.
            penguin_meta_set_active(this.meta_engine);
            // R1: also set the owner_model back-ref + active_model so #error/#warn/#info
            // host callbacks can reach this SemanticModel's report_error/warning/info.
            this.meta_engine.owner_model = new Option<SemanticModel>.some(this);
            penguin_meta_set_active_model(this);
        }
    }

    fun bind_if_expr(mut this, expr: IfExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_if_expr");
        if (expr.condition.is_some() && expr.condition.some is Expression.try_bind) {
            return this.bind_try_bind_if_expr(expr, scope);
        }
        // P2: bind the condition in a fresh condition-region so try-bind pattern
        // variables from `&&` chains are visible in the then-branch (definitely
        // assigned when the condition is true) but not in else or after.
        let cond_region: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<cond>", scope.full_name + ".<cond>", new Option<BoundScope>.some(scope));
        cond_region.is_region = true;
        cond_region.is_condition_region = true;
        let condition: Option<BoundExpression> = this.bind_optional_expr(expr.condition, cond_region);
        let then_block: Option<BoundExpression> = this.bind_optional_expr(expr.then_block, cond_region);
        let else_block: Option<BoundExpression> = this.bind_optional_expr(expr.else_block, scope);
        if (then_block.is_some()) {
            let bt: BoundType = then_block.some.get_bound_type();
            let result: mut BoundIfExpression = new BoundIfExpression(bt, condition, then_block, else_block);
            return new Option<BoundExpression>.some(new BoundExpression.if_expr(result));
        }
        let result: mut BoundIfExpression = new BoundIfExpression(new BoundType(), condition, then_block, else_block);
        return new Option<BoundExpression>.some(new BoundExpression.if_expr(result));
    }

    fun bind_while_expr(mut this, expr: WhileExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_while_expr");
        if (expr.condition.is_some() && expr.condition.some is Expression.try_bind) {
            return this.bind_try_bind_while_expr(expr, scope);
        }
        // P2: same condition-region promotion as bind_if_expr.
        let cond_region: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<cond>", scope.full_name + ".<cond>", new Option<BoundScope>.some(scope));
        cond_region.is_region = true;
        cond_region.is_condition_region = true;
        let condition: Option<BoundExpression> = this.bind_optional_expr(expr.condition, cond_region);
        let body: Option<BoundExpression> = this.bind_optional_expr(expr.body, cond_region);
        let result: mut BoundWhileExpression = new BoundWhileExpression(this.type_registry.void_type, condition, body);
        return new Option<BoundExpression>.some(new BoundExpression.while_expr(result));
    }

    // Prepend a `let a = EXT` statement into a bound code block (or wrap a
    // non-block expression) so the try-bind payload write executes before the
    // then/body statements. The variable is registered in `new_scope`.
    fun prepend_try_bind_let(mut this, block: Option<BoundExpression>, let_stmt: BoundLetDeclarationStatement, new_scope: BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter prepend_try_bind_let");
        if (block.is_none()) { return new Option<BoundExpression>.none(); }
        let stmts: mut _utils.List<BoundStatement> = new _utils.List<BoundStatement>();
        stmts.push(new BoundStatement.let_decl(let_stmt));
        if (block.some is BoundExpression.code_block) {
            let cb: BoundCodeBlockExpression = block.some.code_block;
            let si: mut i64 = 0;
            while (si < cast<i64>(cb.statements.size())) {
                stmts.push(cb.statements.at(cast<u64>(si)).some);
                si = si + 1;
            }
            let new_cb: mut BoundCodeBlockExpression = new BoundCodeBlockExpression(cb.bound_type, stmts, cb.trailing_expr, new Option<BoundScope>.some(new_scope));
            return new Option<BoundExpression>.some(new BoundExpression.code_block(new_cb));
        }
        let new_cb2: mut BoundCodeBlockExpression = new BoundCodeBlockExpression(block.some.get_bound_type(), stmts, block, new Option<BoundScope>.some(new_scope));
        return new Option<BoundExpression>.some(new BoundExpression.code_block(new_cb2));
    }

    // Expression-level `if (let a [: T] := b) then else` (code blocks parse `if`
    // as an expression) → `if (CHK) { let a = EXT; then } else`.
    fun bind_try_bind_if_expr(mut this, expr: IfExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_try_bind_if_expr");
        let tb: TryBindExpression = expr.condition.some.try_bind;
        let bound_rhs: Option<BoundExpression> = this.bind_expression(tb.rhs.some, scope);
        if (bound_rhs.is_none()) { return new Option<BoundExpression>.none(); }
        let analysis: Option<TryBindAnalysis> = this.analyze_try_bind(tb, bound_rhs.some, scope);
        if (analysis.is_none()) { return new Option<BoundExpression>.none(); }
        let then_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<try-bind>", scope.full_name + ".<try-bind>", new Option<BoundScope>.some(scope));
        then_scope.add_symbol(new BoundSymbol.variable(analysis.some.variable_symbol.some));
        let bound_then: Option<BoundExpression> = this.bind_optional_expr(expr.then_block, then_scope);
        let let_stmt: mut BoundLetDeclarationStatement = new BoundLetDeclarationStatement(
            analysis.some.variable_symbol, analysis.some.extract, analysis.some.bound_type,
            new Option<BoundScope>.some(then_scope));
        let_stmt.location = tb.location;
        let then_expr: Option<BoundExpression> = this.prepend_try_bind_let(bound_then, let_stmt, then_scope);
        let else_block: Option<BoundExpression> = this.bind_optional_expr(expr.else_block, scope);
        if (then_expr.is_some()) {
            let r1: mut BoundIfExpression = new BoundIfExpression(then_expr.some.get_bound_type(), analysis.some.check, then_expr, else_block);
            return new Option<BoundExpression>.some(new BoundExpression.if_expr(r1));
        }
        let r2: mut BoundIfExpression = new BoundIfExpression(this.type_registry.void_type, analysis.some.check, then_expr, else_block);
        return new Option<BoundExpression>.some(new BoundExpression.if_expr(r2));
    }

    // Expression-level `while (let a [: T] := b) body` → `while (CHK) { let a = EXT; body }`.
    fun bind_try_bind_while_expr(mut this, expr: WhileExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_try_bind_while_expr");
        let tb: TryBindExpression = expr.condition.some.try_bind;
        let bound_rhs: Option<BoundExpression> = this.bind_expression(tb.rhs.some, scope);
        if (bound_rhs.is_none()) { return new Option<BoundExpression>.none(); }
        let analysis: Option<TryBindAnalysis> = this.analyze_try_bind(tb, bound_rhs.some, scope);
        if (analysis.is_none()) { return new Option<BoundExpression>.none(); }
        let body_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<try-bind>", scope.full_name + ".<try-bind>", new Option<BoundScope>.some(scope));
        body_scope.add_symbol(new BoundSymbol.variable(analysis.some.variable_symbol.some));
        let bound_body: Option<BoundExpression> = this.bind_optional_expr(expr.body, body_scope);
        let let_stmt: mut BoundLetDeclarationStatement = new BoundLetDeclarationStatement(
            analysis.some.variable_symbol, analysis.some.extract, analysis.some.bound_type,
            new Option<BoundScope>.some(body_scope));
        let_stmt.location = tb.location;
        let body_expr: Option<BoundExpression> = this.prepend_try_bind_let(bound_body, let_stmt, body_scope);
        let result: mut BoundWhileExpression = new BoundWhileExpression(this.type_registry.void_type, analysis.some.check, body_expr);
        return new Option<BoundExpression>.some(new BoundExpression.while_expr(result));
    }

    fun bind_optional_expr(mut this, opt: Option<Expression>, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_optional_expr");
        if (opt.is_some()) {
            return this.bind_expression(opt.some, scope);
        }
        return new Option<BoundExpression>.none();
    }

    fun bind_optional_stmt(mut this, opt: Option<Statement>, scope: mut BoundScope) -> Option<BoundStatement> {
        _utils.trace_enter("Enter bind_optional_stmt");
        if (opt.is_some()) {
            return this.bind_statement(opt.some, scope);
        }
        return new Option<BoundStatement>.none();
    }

    // Analyze a `let a [: T] := b` try-bind. Returns the bound variable, the
    // boolean check expression, and the guarded extract expression. v1 supports
    // enum variant member access (`let x := opt.some`); other shapes report an
    // error. The variable is NOT registered here — the caller registers it into
    // the true-branch scope so it is visible only where the check holds.
    fun analyze_try_bind(mut this, tb: TryBindExpression, bound_rhs: BoundExpression, scope: mut BoundScope) -> Option<TryBindAnalysis> {
        _utils.trace_enter("Enter analyze_try_bind");
        // Enum variant member access: `let x := opt.some`
        if (bound_rhs is BoundExpression.member_access) {
            let ma: BoundMemberAccessExpression = bound_rhs.member_access;
            if (ma.member_symbol.is_some() && ma.base_expr.is_some()) {
                let sym: BoundSymbol = ma.member_symbol.some;
                if (sym is BoundSymbol.enum_member) {
                    let enum_type: BoundType = ma.base_expr.some.get_bound_type();
                    let payload_type: mut BoundType = ma.bound_type;
                    // Tag-only variants store the enum type itself as payload
                    // (SemanticModel resolve_enum_types); a payload equal to the
                    // enum type has nothing to bind. (Recursive enum payloads are
                    // a documented limitation of this discriminator.)
                    if (payload_type.is_same_type(enum_type)) {
                        this.report_error(new ErrorCode.E_UNSUPPORTED(),
                            "enum variant '" + ma.member_name + "' has no payload to bind",
                            tb.location);
                        return new Option<TryBindAnalysis>.none();
                    }
                    let bind_type: mut BoundType = payload_type;
                    if (tb.type_spec.is_some()) {
                        let ann_type: mut BoundType = this.resolve_type_specifier(tb.type_spec.some, scope);
                        if (!ann_type.is_same_type(payload_type)) {
                            this.report_error(new ErrorCode.E_TYPE_MISMATCH(),
                                "try-bind type '" + ann_type.display_name() + "' does not match payload type '" + payload_type.display_name() + "'",
                                tb.location);
                            return new Option<TryBindAnalysis>.none();
                        }
                        bind_type = ann_type;
                    }
                    let var_sym: mut BoundVariableSymbol = new BoundVariableSymbol();
                    var_sym.name = tb.variable_name;
                    var_sym.full_name = scope.full_name + "." + tb.variable_name;
                    var_sym.is_mutable = false;
                    var_sym.bound_type = bind_type;
                    var_sym.location = tb.location;
                    // check = `base is EnumType.variant`, RHS is a BoundEnumVariant
                    // reference carrying the variant index (lowered to ISENUM).
                    let ev: mut BoundEnumVariantExpression = new BoundEnumVariantExpression(
                        enum_type, enum_type, ma.member_name, sym.enum_member.enum_value,
                        new Option<BoundEnumMemberSymbol>.some(sym.enum_member),
                        new Option<BoundExpression>.none());
                    let operands: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
                    operands.push(ma.base_expr.some);
                    operands.push(new BoundExpression.enum_variant(ev));
                    let operators: mut _utils.List<BinaryOperator> = new _utils.List<BinaryOperator>();
                    operators.push(new BinaryOperator.Is());
                    let check: mut BoundBinaryExpression = new BoundBinaryExpression(this.type_registry.bool_type, operators, operands);
                    let analysis: mut TryBindAnalysis = new TryBindAnalysis();
                    analysis.variable_symbol = new Option<BoundVariableSymbol>.some(var_sym);
                    analysis.check = new Option<BoundExpression>.some(new BoundExpression.binary(check));
                    analysis.extract = new Option<BoundExpression>.some(bound_rhs);
                    analysis.bound_type = bind_type;
                    return new Option<TryBindAnalysis>.some(analysis);
                }
            }
        }
        // Type-cast form: `let a : TO := from` — whether `cast<TO>(from)` is valid.
        // Compile-time foldable when the static types decide it; otherwise a
        // runtime ISINSTANCE check.
        if (tb.type_spec.is_some()) {
            let ann_type: mut BoundType = this.resolve_type_specifier(tb.type_spec.some, scope);
            let rhs_type: BoundType = bound_rhs.get_bound_type();
            // Same type: always a valid (identity) cast.
            if (rhs_type.is_same_type(ann_type)) {
                return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 1);
            }
            // Primitive (incl. string) conversion: compile-time fold.
            if (ann_type.kind is TypeKind.PrimitiveKind && rhs_type.kind is TypeKind.PrimitiveKind) {
                let fold: bool = this.type_registry.can_widen_primitive(rhs_type.primitive, ann_type.primitive);
                if (fold) { return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 1); }
                return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 0);
            }
            // Interface target: `let a : IFoo := bar`
            if (ann_type.kind is TypeKind.InterfaceKind) {
                if (rhs_type.kind is TypeKind.PrimitiveKind) {
                    this.report_error(new ErrorCode.E_TYPE_MISMATCH(),
                        "try-bind: cannot cast primitive '" + rhs_type.display_name() + "' to interface '" + ann_type.display_name() + "'",
                        tb.location);
                    return new Option<TryBindAnalysis>.none();
                }
                if (this.is_concrete_type(rhs_type)) {
                    if (this.type_registry.can_implicitly_cast(rhs_type, ann_type)) {
                        return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 1);
                    }
                    return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 0);
                }
                // interface / generic rhs → runtime ISINSTANCE
                return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, -1);
            }
            // Class target: `let a : Foo := bar` (no class inheritance, exact check)
            if (ann_type.kind is TypeKind.ClassKind) {
                if (rhs_type.kind is TypeKind.ClassKind) {
                    if (this.is_concrete_type(rhs_type)) {
                        return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, 0);
                    }
                    return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, -1);
                }
                if (rhs_type.kind is TypeKind.InterfaceKind) {
                    return this.make_cast_try_bind_analysis(tb, bound_rhs, ann_type, scope, -1);
                }
                this.report_error(new ErrorCode.E_TYPE_MISMATCH(),
                    "try-bind: cannot cast '" + rhs_type.display_name() + "' to class '" + ann_type.display_name() + "'",
                    tb.location);
                return new Option<TryBindAnalysis>.none();
            }
            this.report_error(new ErrorCode.E_UNSUPPORTED(),
                "try-bind target '" + ann_type.display_name() + "' is not a supported matchable",
                tb.location);
            return new Option<TryBindAnalysis>.none();
        }
        this.report_error(new ErrorCode.E_UNSUPPORTED(),
            "try-bind RHS is not a supported matchable (add a ': TO' type annotation for cast checks)",
            tb.location);
        return new Option<TryBindAnalysis>.none();
    }

    // A "concrete" class/enum has an AST source; a generic-parameter placeholder
    // does not. When uncertain, callers fall back to a runtime ISINSTANCE check.
    fun is_concrete_type(this, bt: BoundType) -> bool {
        if (let td := bt.type_definition.some) {
            if (td is BoundDefinition.class_def) {
                return td.class_def.scope.is_some() && !td.class_def.is_generic_template;
            }
            if (td is BoundDefinition.enum_def) { return td.enum_def.scope.is_some(); }
        }
        return false;
    }

    // Build the cast expression for `cast<TO>(from)`, mirroring bind_cast's
    // boxing/unboxing decisions (value type → interface needs boxing).
    fun build_cast_bound(mut this, inner: BoundExpression, target_type: BoundType) -> BoundCastExpression {
        let result: mut BoundCastExpression = new BoundCastExpression(target_type, target_type, new Option<BoundExpression>.some(inner), false);
        let inner_type: BoundType = inner.get_bound_type();
        if (target_type.kind is TypeKind.InterfaceKind) {
            if (inner_type.is_value_type()) {
                result.needs_boxing = true;
                result.source_type_name = this.get_concrete_type_name(inner_type);
            }
        }
        if (inner_type.kind is TypeKind.InterfaceKind) {
            if (target_type.is_value_type()) {
                result.needs_unboxing = true;
                result.source_type_name = this.get_concrete_type_name(target_type);
            }
        }
        return result;
    }

    // Build a TryBindAnalysis for the cast form. fold: 1 = compile-time true,
    // 0 = compile-time false, -1 = runtime `from is TO` (ISINSTANCE).
    fun make_cast_try_bind_analysis(mut this, tb: TryBindExpression, bound_rhs: BoundExpression, ann_type: mut BoundType, scope: mut BoundScope, fold: i64) -> Option<TryBindAnalysis> {
        _utils.trace_enter("Enter make_cast_try_bind_analysis");
        let var_sym: mut BoundVariableSymbol = new BoundVariableSymbol();
        var_sym.name = tb.variable_name;
        var_sym.full_name = scope.full_name + "." + tb.variable_name;
        var_sym.is_mutable = false;
        var_sym.bound_type = ann_type;
        var_sym.location = tb.location;
        let cast_expr: BoundCastExpression = this.build_cast_bound(bound_rhs, ann_type);
        let extract: BoundExpression = new BoundExpression.cast_expr(cast_expr);
        let check: mut Option<BoundExpression> = new Option<BoundExpression>.none();
        if (fold == 1) {
            let true_lit: mut BoundLiteralExpression = new BoundLiteralExpression("true", this.type_registry.bool_type, new LiteralKind.BoolLiteral());
            check = new Option<BoundExpression>.some(new BoundExpression.literal(true_lit));
        } else if (fold == 0) {
            let false_lit: mut BoundLiteralExpression = new BoundLiteralExpression("false", this.type_registry.bool_type, new LiteralKind.BoolLiteral());
            check = new Option<BoundExpression>.some(new BoundExpression.literal(false_lit));
        } else {
            // Runtime: `from is TO` via a type-symbol identifier on the Is RHS.
            let type_sym: Option<BoundSymbol> = scope.lookup_symbol(tb.type_spec.some.name);
            if (type_sym.is_some() && type_sym.some is BoundSymbol.type_sym) {
                let id: mut BoundIdentifierExpression = new BoundIdentifierExpression(ann_type, type_sym);
                let operands: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
                operands.push(bound_rhs);
                operands.push(new BoundExpression.identifier(id));
                let operators: mut _utils.List<BinaryOperator> = new _utils.List<BinaryOperator>();
                operators.push(new BinaryOperator.Is());
                let chk: mut BoundBinaryExpression = new BoundBinaryExpression(this.type_registry.bool_type, operators, operands);
                check = new Option<BoundExpression>.some(new BoundExpression.binary(chk));
            } else {
                this.report_error(new ErrorCode.E_RESOLVE_TYPE(),
                    "try-bind type check: cannot resolve type symbol for '" + tb.type_spec.some.name + "'",
                    tb.location);
                return new Option<TryBindAnalysis>.none();
            }
        }
        let analysis: mut TryBindAnalysis = new TryBindAnalysis();
        analysis.variable_symbol = new Option<BoundVariableSymbol>.some(var_sym);
        analysis.check = check;
        analysis.extract = new Option<BoundExpression>.some(extract);
        analysis.bound_type = ann_type;
        return new Option<TryBindAnalysis>.some(analysis);
    }

    // P2 general try-bind expression: `let a [: T] := b` as a boolean value.
    // The RHS is bound first (so `a` is not visible to its own RHS), then the
    // pattern variable is registered into the CURRENT region scope (paren /
    // &&-chain / if-condition), making it visible to the enclosing boolean
    // expression's later operands and (for if-conditions) the then-branch.
    fun bind_try_bind(mut this, tb: TryBindExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_try_bind");
        let bound_rhs: Option<BoundExpression> = this.bind_expression(tb.rhs.some, scope);
        if (bound_rhs.is_none()) { return new Option<BoundExpression>.none(); }
        let analysis: Option<TryBindAnalysis> = this.analyze_try_bind(tb, bound_rhs.some, scope);
        if (analysis.is_none()) { return new Option<BoundExpression>.none(); }
        scope.add_symbol(new BoundSymbol.variable(analysis.some.variable_symbol.some));
        let result: mut BoundTryBindExpression = new BoundTryBindExpression(
            this.type_registry.bool_type, analysis.some.variable_symbol, analysis.some.check, analysis.some.extract);
        return new Option<BoundExpression>.some(new BoundExpression.try_bind(result));
    }

    // Desugar `if (let a [: T] := b) T else E` into
    //   `if (CHK) { let a = EXT; T } else E`
    // so `a` is an ordinary block-scoped let — visible in the then-branch only,
    // re-bound per `while` iteration, never read when the check failed.
    fun bind_try_bind_if_stmt(mut this, if_stmt: IfStatement, scope: mut BoundScope) -> Option<BoundStatement> {
        _utils.trace_enter("Enter bind_try_bind_if_stmt");
        let tb: TryBindExpression = if_stmt.condition.some.try_bind;
        let bound_rhs: Option<BoundExpression> = this.bind_expression(tb.rhs.some, scope);
        if (bound_rhs.is_none()) { return new Option<BoundStatement>.none(); }
        let analysis: Option<TryBindAnalysis> = this.analyze_try_bind(tb, bound_rhs.some, scope);
        if (analysis.is_none()) { return new Option<BoundStatement>.none(); }
        let then_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<try-bind>", scope.full_name + ".<try-bind>", new Option<BoundScope>.some(scope));
        then_scope.add_symbol(new BoundSymbol.variable(analysis.some.variable_symbol.some));
        let bound_then: Option<BoundStatement> = this.bind_optional_stmt(if_stmt.then_statement, then_scope);
        let let_stmt: mut BoundLetDeclarationStatement = new BoundLetDeclarationStatement(
            analysis.some.variable_symbol, analysis.some.extract, analysis.some.bound_type,
            new Option<BoundScope>.some(then_scope));
        let_stmt.location = tb.location;
        let stmts: mut _utils.List<BoundStatement> = new _utils.List<BoundStatement>();
        stmts.push(new BoundStatement.let_decl(let_stmt));
        if (bound_then.is_some()) { stmts.push(bound_then.some); }
        let block: mut BoundBlockStatement = new BoundBlockStatement(stmts, new Option<BoundScope>.some(then_scope));
        block.location = if_stmt.location;
        let else_stmt: Option<BoundStatement> = this.bind_optional_stmt(if_stmt.else_statement, scope);
        let result: mut BoundIfStatement = new BoundIfStatement(analysis.some.check, new Option<BoundStatement>.some(new BoundStatement.block(block)), else_stmt);
        result.location = if_stmt.location;
        return new Option<BoundStatement>.some(new BoundStatement.if_stmt(result));
    }

    // Desugar `while (let a [: T] := b) body` into
    //   `while (CHK) { let a = EXT; body }`
    fun bind_try_bind_while_stmt(mut this, while_stmt: WhileStatement, scope: mut BoundScope) -> Option<BoundStatement> {
        _utils.trace_enter("Enter bind_try_bind_while_stmt");
        let tb: TryBindExpression = while_stmt.condition.some.try_bind;
        let bound_rhs: Option<BoundExpression> = this.bind_expression(tb.rhs.some, scope);
        if (bound_rhs.is_none()) { return new Option<BoundStatement>.none(); }
        let analysis: Option<TryBindAnalysis> = this.analyze_try_bind(tb, bound_rhs.some, scope);
        if (analysis.is_none()) { return new Option<BoundStatement>.none(); }
        let body_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<try-bind>", scope.full_name + ".<try-bind>", new Option<BoundScope>.some(scope));
        body_scope.add_symbol(new BoundSymbol.variable(analysis.some.variable_symbol.some));
        let bound_body: Option<BoundStatement> = this.bind_optional_stmt(while_stmt.body, body_scope);
        let let_stmt: mut BoundLetDeclarationStatement = new BoundLetDeclarationStatement(
            analysis.some.variable_symbol, analysis.some.extract, analysis.some.bound_type,
            new Option<BoundScope>.some(body_scope));
        let_stmt.location = tb.location;
        let stmts: mut _utils.List<BoundStatement> = new _utils.List<BoundStatement>();
        stmts.push(new BoundStatement.let_decl(let_stmt));
        if (bound_body.is_some()) { stmts.push(bound_body.some); }
        let block: mut BoundBlockStatement = new BoundBlockStatement(stmts, new Option<BoundScope>.some(body_scope));
        block.location = while_stmt.location;
        let result: mut BoundWhileStatement = new BoundWhileStatement(analysis.some.check, new Option<BoundStatement>.some(new BoundStatement.block(block)));
        result.location = while_stmt.location;
        return new Option<BoundStatement>.some(new BoundStatement.while_stmt(result));
    }

    fun bind_code_block(mut this, expr: CodeBlockExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_code_block");
        let block_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<block>", scope.full_name + ".<block>", new Option<BoundScope>.some(scope));
        let stmts: mut _utils.List<BoundStatement> = new _utils.List<BoundStatement>();
        let i: mut i64 = 0;
        while (i < cast<i64>(expr.statements.size())) {
            let stmt: Statement = expr.statements.at(cast<u64>(i)).some;
            let bound_stmt: Option<BoundStatement> = this.bind_statement(stmt, block_scope);
            if (bound_stmt.is_some()) {
                stmts.push(bound_stmt.some);
            }
            i = i + 1;
        }
        // Promote a trailing expression-statement that wraps a value-producing if-expression
        // to the block's trailing value. The parser wraps a trailing `if c {..} else {..}` in
        // a code block as a block_expr statement; when that if yields a non-void value it is
        // the block's value (trailing expression), not a value-less statement. This makes
        // `let x: T = { ...; if c { a } else { b } }` resolve to T instead of void (which
        // previously produced `ASSIGN void` and invalid `#dbg_value(ptr void, ...)`).
        // Void ifs (e.g. both branches `return`) are left as statements, so control-flow ifs
        // such as `fun f() -> T { if c { return a; } else { return b; } }` are unaffected.
        if (expr.trailing_expr.is_none()) {
            if (cast<i64>(stmts.size()) > 0) {
                let last_stmt: BoundStatement = stmts.at(stmts.size() - 1).some;
                if (last_stmt is BoundStatement.expression) {
                    let inner_opt: Option<BoundExpression> = last_stmt.expression.expression;
                    if (inner_opt.is_some()) {
                        if (inner_opt.some is BoundExpression.if_expr) {
                            let ift: BoundType = inner_opt.some.get_bound_type();
                            if (ift.display_name() != "void") {
                                let _discarded: __builtin.Option<BoundStatement> = stmts.pop();
                                let result: mut BoundCodeBlockExpression = new BoundCodeBlockExpression(ift, stmts, inner_opt, new Option<BoundScope>.some(block_scope));
                                return new Option<BoundExpression>.some(new BoundExpression.code_block(result));
                            }
                        }
                    }
                }
            }
        }
        if (expr.trailing_expr.is_some()) {
            let trailing: Option<BoundExpression> = this.bind_expression(expr.trailing_expr.some, block_scope);
            if (trailing.is_some()) {
                let bt: BoundType = trailing.some.get_bound_type();
                let result: mut BoundCodeBlockExpression = new BoundCodeBlockExpression(bt, stmts, trailing, new Option<BoundScope>.some(block_scope));
                return new Option<BoundExpression>.some(new BoundExpression.code_block(result));
            }
        }
        let result: mut BoundCodeBlockExpression = new BoundCodeBlockExpression(this.type_registry.void_type, stmts, new Option<BoundExpression>.none(), new Option<BoundScope>.some(block_scope));
        return new Option<BoundExpression>.some(new BoundExpression.code_block(result));
    }

    // Look up the concrete implementation method from a value type's vtable.
    // Given the inner (concrete) type, the interface type, and the interface method symbol,
    // find the corresponding implementation method in the class/enum definition's vtable.
    fun resolve_implementation_method(this, inner_type: BoundType, iface_type: BoundType, iface_method_sym: BoundSymbol) -> Option<BoundFunctionSymbol> {
        _utils.trace_enter("Enter resolve_implementation_method");
        if (iface_method_sym is BoundSymbol.function_sym) {
            let method_name: string = iface_method_sym.function_sym.name;
            if (let def := inner_type.type_definition.some) {
                // Class value type
                if (def is BoundDefinition.class_def) {
                    let class_def: BoundClassDefinition = def.class_def;
                    let vi: mut i64 = 0;
                    while (vi < cast<i64>(class_def.vtables.size())) {
                        let vtable: BoundVTable = class_def.vtables.at(cast<u64>(vi)).some;
                        if (vtable.interface_type.display_name() == iface_type.display_name()) {
                            let si: mut i64 = 0;
                            while (si < cast<i64>(vtable.slots.size())) {
                                let slot: BoundVTableSlot = vtable.slots.at(cast<u64>(si)).some;
                                if (slot.interface_method.is_some()) {
                                    if (slot.interface_method.some.name == method_name) {
                                        return slot.implementation_method;
                                    }
                                }
                                si = si + 1;
                            }
                        }
                        vi = vi + 1;
                    }
                }
                // Enum type
                if (def is BoundDefinition.enum_def) {
                    let enum_def: BoundEnumDefinition = def.enum_def;
                    let vi: mut i64 = 0;
                    while (vi < cast<i64>(enum_def.vtables.size())) {
                        let vtable: BoundVTable = enum_def.vtables.at(cast<u64>(vi)).some;
                        if (vtable.interface_type.display_name() == iface_type.display_name()) {
                            let si: mut i64 = 0;
                            while (si < cast<i64>(vtable.slots.size())) {
                                let slot: BoundVTableSlot = vtable.slots.at(cast<u64>(si)).some;
                                if (slot.interface_method.is_some()) {
                                    if (slot.interface_method.some.name == method_name) {
                                        return slot.implementation_method;
                                    }
                                }
                                si = si + 1;
                            }
                        }
                        vi = vi + 1;
                    }
                }
            }
        }
        return new Option<BoundFunctionSymbol>.none();
    }

    fun bind_cast(mut this, expr: CastExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_cast");
        let target_type: mut BoundType = this.resolve_type_name(expr.type_name, scope, expr.location);
        if (expr.target_type.is_some()) {
            target_type = this.resolve_type_specifier(expr.target_type.some, scope);
        }
        let inner: Option<BoundExpression> = this.bind_optional_expr(expr.inner, scope);
        let result: mut BoundCastExpression = new BoundCastExpression(target_type, target_type, inner, false);

        if (inner.is_some()) {
            let inner_type: BoundType = inner.some.get_bound_type();
            // Boxing: value type (class or enum) → interface
            if (target_type.kind is TypeKind.InterfaceKind) {
                if (inner_type.is_value_type()) {
                    result.needs_boxing = true;
                    result.source_type_name = this.get_concrete_type_name(inner_type);
                }
            }
            // Unboxing: interface → value type (class or enum)
            if (inner_type.kind is TypeKind.InterfaceKind) {
                if (target_type.is_value_type()) {
                    result.needs_unboxing = true;
                    result.source_type_name = this.get_concrete_type_name(target_type);
                }
            }
        }

        return new Option<BoundExpression>.some(new BoundExpression.cast_expr(result));
    }

    fun get_concrete_type_name(this, bt: BoundType) -> string {
        _utils.trace_enter("Enter get_concrete_type_name");
        if (bt.type_definition.is_some()) {
            return bt.type_definition.some.get_name();
        }
        return bt.display_name();
    }

    fun resolve_new_generic_args(this, expr: NewExpression, scope: BoundScope, bt: BoundType) -> mut BoundType {
        _utils.trace_enter("Enter resolve_new_generic_args");
        if (cast<i64>(expr.generic_args.size()) > 0) {
            let args: mut _utils.List<BoundType> = new _utils.List<BoundType>();
            let k: mut i64 = 0;
            while (k < cast<i64>(expr.generic_args.size())) {
                let arg_ts: TypeSpecifier = expr.generic_args.at(cast<u64>(k)).some;
                // req5: a value generic arg (A<5>) -> synthetic BoundType.
                if (arg_ts.is_value_arg) {
                    let vbt: mut BoundType = new BoundType();
                    vbt.is_template_value_arg = true;
                    vbt.template_value = string_to_int(arg_ts.value_arg_text);
                    args.push(vbt);
                } else {
                    args.push(this.resolve_type_specifier(arg_ts, scope));
                }
                k = k + 1;
            }
            return bt.with_generic_args(args);
        }
        return bt;
    }

    // For a generic interface base type (e.g. IFoo<u8>), return the scope of the
    // specialized def (IFoo__u8) so member lookup resolves concrete method types
    // (T -> u8) and symbols (ns.IFoo__u8.bar). Falls back to the template scope.
    fun specialized_interface_scope(this, iface: BoundInterfaceDefinition, base_type: BoundType, scope: BoundScope) -> Option<BoundScope> {
        _utils.trace_enter("Enter specialized_interface_scope");
        if (cast<i64>(base_type.generic_args.size()) > 0) {
            let mangled: string = mangle_generic_name(iface.name, base_type.generic_args);
            let spec_sym: Option<BoundSymbol> = scope.lookup_type_in_scope(mangled);
            if (spec_sym.is_some()) {
                if (spec_sym.some is BoundSymbol.type_sym) {
                    if (let spec_td := spec_sym.some.type_sym.bound_type.type_definition.some) {
                        if (spec_td is BoundDefinition.interface_def) {
                            return spec_td.interface_def.scope;
                        }
                    }
                }
            }
        }
        return iface.scope;
    }

    fun resolve_type_by_name(this, name: string, scope: mut BoundScope) -> Option<BoundSymbol> {
        _utils.trace_enter("Enter resolve_type_by_name");
        let dot_idx: i64 = string_find(name, ".");
        if (dot_idx < 0) {
            return scope.lookup_type_in_scope(name);
        }
        // Split dotted name into parts and use resolve_qualified which traverses parent scopes
        let parts: mut _utils.List<string> = new _utils.List<string>();
        let pos: mut i64 = 0;
        let len: i64 = string_length(name);
        while (pos < len) {
            let next_dot: i64 = string_find_from(name, ".", pos);
            if (next_dot < 0) {
                parts.push(string_substring(name, pos, len - pos));
                pos = len;
            } else {
                parts.push(string_substring(name, pos, next_dot - pos));
                pos = next_dot + 1;
            }
        }
        return scope.resolve_qualified(parts);
    }

    fun find_last_dot(this, s: string) -> i64 {
        _utils.trace_enter("Enter find_last_dot");
        let len: i64 = string_length(s);
        let last_dot: mut i64 = -1;
        let si: mut i64 = 0;
        while (si < len) {
            let ch: string = string_char_at(s, si);
            if (ch == ".") {
                last_dot = si;
            }
            si = si + 1;
        }
        return last_dot;
    }

    // Check if an impl for is orphaned (both interface and type are external).
    fun check_orphan_impl(this, iface_type: BoundType, for_type: BoundType, impl_scope: BoundScope) -> bool {
        _utils.trace_enter("Enter check_orphan_impl");
        let ns_prefix: string = impl_scope.full_name + ".";
        let iface_ns: mut string = "";
        if (let def := iface_type.type_definition.some) {
            if (def is BoundDefinition.interface_def) {
                iface_ns = def.interface_def.full_name;
            }
        }
        let for_ns: mut string = "";
        if (let def := for_type.type_definition.some) {
            if (def is BoundDefinition.class_def) { for_ns = def.class_def.full_name; }
            if (def is BoundDefinition.enum_def) { for_ns = def.enum_def.full_name; }
        }
        let iface_local: bool = string_length(iface_ns) > 0 && string_find(iface_ns, ns_prefix) == 0;
        let for_local: bool = string_length(for_ns) > 0 && string_find(for_ns, ns_prefix) == 0;
        return !iface_local && !for_local;
    }

    fun try_bind_enum_variant(mut this, expr: NewExpression, scope: mut BoundScope, last_dot: i64) -> Option<BoundExpression> {
        _utils.trace_enter("Enter try_bind_enum_variant");
        let len: i64 = string_length(expr.type_name);
        let enum_name: string = string_substring(expr.type_name, 0, last_dot);
        let variant_name: string = string_substring(expr.type_name, last_dot + 1, len - last_dot - 1);
        let enum_sym: Option<BoundSymbol> = this.resolve_type_by_name(enum_name, scope);
        if (enum_sym.is_some()) {
            if (enum_sym.some is BoundSymbol.type_sym) {
                let bt: mut BoundType = this.resolve_new_generic_args(expr, scope, enum_sym.some.type_sym.bound_type);
                if (bt.kind is TypeKind.EnumKind && bt.type_definition.is_some()) {
                    let def: BoundDefinition = bt.type_definition.some;
                    if (def is BoundDefinition.enum_def) {
                        let enum_def: BoundEnumDefinition = def.enum_def;
                        let i: mut i64 = 0;
                        while (i < cast<i64>(enum_def.members.size())) {
                            let member: BoundEnumMemberDefinition = enum_def.members.at(cast<u64>(i)).some;
                            if (member.name == variant_name) {
                                let payload: Option<BoundExpression> = new Option<BoundExpression>.none();
                                if (cast<i64>(expr.arguments.size()) > 0) {
                                    let arg: Option<BoundExpression> = this.bind_expression(expr.arguments.at(cast<u64>(0)).some, scope);
                                    if (arg.is_some()) {
                                        let result: mut BoundEnumVariantExpression = new BoundEnumVariantExpression(bt, bt, variant_name, i, member.member_symbol, arg);
                                        return new Option<BoundExpression>.some(new BoundExpression.enum_variant(result));
                                    }
                                }
                                let result: mut BoundEnumVariantExpression = new BoundEnumVariantExpression(bt, bt, variant_name, i, member.member_symbol, payload);
                                return new Option<BoundExpression>.some(new BoundExpression.enum_variant(result));
                            }
                            i = i + 1;
                        }
                    }
                }
            }
        }
        return new Option<BoundExpression>.none();
    }

    fun bind_new_expr(mut this, expr: NewExpression, scope: mut BoundScope) -> Option<BoundExpression> {
        _utils.trace_enter("Enter bind_new_expr");
        // First, try to resolve the full type_name as a class/struct type
        let type_sym: Option<BoundSymbol> = this.resolve_type_by_name(expr.type_name, scope);
        if (type_sym.is_some()) {
            if (type_sym.some is BoundSymbol.type_sym) {
                let bt: mut BoundType = this.resolve_new_generic_args(expr, scope, type_sym.some.type_sym.bound_type);
                // If this is an enum type, the full name was a type, not a variant — just instantiate
                let args: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
                let i: mut i64 = 0;
                while (i < cast<i64>(expr.arguments.size())) {
                    let bound_arg: Option<BoundExpression> = this.bind_expression(expr.arguments.at(cast<u64>(i)).some, scope);
                    if (bound_arg.is_some()) {
                        args.push(bound_arg.some);
                    }
                    i = i + 1;
                }
                let result: mut BoundNewExpression = new BoundNewExpression(bt.with_mutability(new Mutability.Mutable()), new Option<BoundTypeSymbol>.some(type_sym.some.type_sym), new Option<BoundFunctionSymbol>.none(), args);
                return new Option<BoundExpression>.some(new BoundExpression.new_expr(result));
            }
        }

        // If not found as a type, try as an enum variant (e.g., "Option.some" → enum Option, variant some)
        let last_dot: i64 = this.find_last_dot(expr.type_name);
        if (last_dot >= 0) {
            let enum_result: Option<BoundExpression> = this.try_bind_enum_variant(expr, scope, last_dot);
            if (enum_result.is_some()) {
                return enum_result;
            }
        }

        // Fallback: create with unresolved type
        let args: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
        let i: mut i64 = 0;
        while (i < cast<i64>(expr.arguments.size())) {
            let bound_arg: Option<BoundExpression> = this.bind_expression(expr.arguments.at(cast<u64>(i)).some, scope);
            if (bound_arg.is_some()) {
                args.push(bound_arg.some);
            }
            i = i + 1;
        }
        let result: mut BoundNewExpression = new BoundNewExpression(new BoundType(), new Option<BoundTypeSymbol>.none(), new Option<BoundFunctionSymbol>.none(), args);
        return new Option<BoundExpression>.some(new BoundExpression.new_expr(result));
    }

    fun bind_statement(mut this, stmt: Statement, scope: mut BoundScope) -> Option<BoundStatement> {
        _utils.trace_enter("Enter bind_statement");
        if (stmt is Statement.expression) {
            if (stmt.expression.expression.is_some()) {
                let bound_expr: Option<BoundExpression> = this.bind_expression(stmt.expression.expression.some, scope);
                let result: mut BoundExpressionStatement = new BoundExpressionStatement(bound_expr);
                result.location = stmt.expression.location;
                return new Option<BoundStatement>.some(new BoundStatement.expression(result));
            }
            let result: mut BoundExpressionStatement = new BoundExpressionStatement(new Option<BoundExpression>.none());
            result.location = stmt.expression.location;
            return new Option<BoundStatement>.some(new BoundStatement.expression(result));
        }
        if (stmt is Statement.block_expr) {
            if (stmt.block_expr.expression.is_some()) {
                let bound_expr: Option<BoundExpression> = this.bind_expression(stmt.block_expr.expression.some, scope);
                if (bound_expr.is_some()) {
                    if (bound_expr.some is BoundExpression.code_block) {
                        let cb: BoundCodeBlockExpression = bound_expr.some.code_block;
                        let block_stmts: mut _utils.List<BoundStatement> = new _utils.List<BoundStatement>();
                        let i: mut i64 = 0;
                        while (i < cast<i64>(cb.statements.size())) {
                            block_stmts.push(cb.statements.at(cast<u64>(i)).some);
                            i = i + 1;
                        }
                        let result: mut BoundBlockStatement = new BoundBlockStatement(block_stmts, cb.scope);
                        return new Option<BoundStatement>.some(new BoundStatement.block(result));
                    }
                    let result: mut BoundExpressionStatement = new BoundExpressionStatement(bound_expr);
                    return new Option<BoundStatement>.some(new BoundStatement.expression(result));
                }
            }
        }
        if (stmt is Statement.assignment) {
            if (stmt.assignment.target.is_some()) {
                let target: Option<BoundExpression> = this.bind_expression(stmt.assignment.target.some, scope);
                if (stmt.assignment.value.is_some()) {
                    let value: mut Option<BoundExpression> = this.bind_expression(stmt.assignment.value.some, scope);
                    let effective_op: mut AssignmentOperator = stmt.assignment.operator_value;
                    // Desugar a compound assignment (target op= value) into a plain
                    // assignment whose RHS reads the target: target = target op value.
                    // Without this, op= was emitted as plain =, so e.g. i += 1 stored
                    // the literal RHS and never read i, producing an infinite loop.
                    let compound_binop: Option<BinaryOperator> = compound_assignment_to_binary_operator(stmt.assignment.operator_value);
                    if (compound_binop.is_some()) {
                        let operands: mut _utils.List<BoundExpression> = new _utils.List<BoundExpression>();
                        operands.push(target.some);
                        operands.push(value.some);
                        let operators: mut _utils.List<BinaryOperator> = new _utils.List<BinaryOperator>();
                        operators.push(compound_binop.some);
                        let bin_type: BoundType = target.some.get_bound_type();
                        let desugared: mut BoundBinaryExpression = new BoundBinaryExpression(bin_type, operators, operands);
                        value = new Option<BoundExpression>.some(new BoundExpression.binary(desugared));
                        effective_op = new AssignmentOperator.Assign();
                    }
                    let value_type: BoundType = target.some.get_bound_type();
                    // Binding mutability check: cannot reassign an immutable variable.
                    // For `let x: i32`, `x = ...` is rejected (binding is immutable).
                    // `let x: mut i32` makes the binding mutable (BabyPenguin conflates
                    // binding and type mutability), so reassignment is allowed.
                    if (target.some is BoundExpression.identifier) {
                        let id_expr: BoundIdentifierExpression = target.some.identifier;
                        if (let sym := id_expr.symbol.some) {
                            if (sym is BoundSymbol.variable) {
                                if (!sym.variable.is_mutable) {
                                    this.report_error(new ErrorCode.E_MUTABILITY(),
                                        "Cannot assign to immutable variable '" + sym.variable.name + "'",
                                        new SourceLocation("", 0, 0));
                                }
                            }
                        }
                    }
                    // Member access target mutability: for a.a = 1, check field's
                    // effective mutability. Skip for `this` (constructor/method init).
                    if (target.some is BoundExpression.member_access) {
                        let ma: BoundMemberAccessExpression = target.some.member_access;
                        if (ma.base_expr.is_some() && ma.member_symbol.is_some()) {
                            let ms: BoundSymbol = ma.member_symbol.some;
                            if (ms is BoundSymbol.variable && ms.variable.variable_kind is VariableSymbolKind.Field) {
                                // Skip check for `this.xxx` assignments (constructor/method init)
                                let is_this_assign: mut bool = false;
                                if (ma.base_expr.some is BoundExpression.identifier) {
                                    let base_id: BoundIdentifierExpression = ma.base_expr.some.identifier;
                                    if (base_id.symbol.is_some()) {
                                        if (base_id.symbol.some is BoundSymbol.variable) {
                                            if (base_id.symbol.some.variable.name == "this") {
                                                is_this_assign = true;
                                            }
                                        }
                                    }
                                }
                                if (!is_this_assign) {
                                    // Compute effective field mutability based on
                                    // the field's bound type mutability (which already
                                    // reflects container mutability for Auto fields).
                                    if (value_type.mutability is Mutability.Immutable) {
                                        this.report_error(new ErrorCode.E_MUTABILITY(),
                                            "Cannot assign to field '" + ms.variable.name + "' (field is immutable)",
                                            new SourceLocation("", 0, 0));
                                    }
                                }
                            }
                        }
                    }
                    if (target.some is BoundExpression.identifier) {
                        if (target.some.identifier.symbol.is_some()) {
                            // Reference type mutability compatibility: for explicit
                            // IReferenceType types, the value's mutability must match
                            // the target's binding mutability. When the value is a
                            // variable reference, its BINDING mutability is
                            // authoritative (BabyPenguin: `let a = new Ref(1)` is an
                            // immutable binding even though the new-expression's type
                            // is mutable), so an immutable binding assigned to a
                            // mutable target fails E_MUTABILITY.
                            if (value.is_some() && this.is_iref_type(value_type)) {
                                let val_type: BoundType = value.some.get_bound_type();
                                let target_mut: Mutability = value_type.mutability;
                                let val_mut: mut Mutability = val_type.mutability;
                                if (value.some is BoundExpression.identifier) {
                                    let v_id: BoundIdentifierExpression = value.some.identifier;
                                    if (v_id.symbol.is_some()) {
                                        if (v_id.symbol.some is BoundSymbol.variable) {
                                            if (!v_id.symbol.some.variable.is_mutable) {
                                                val_mut = new Mutability.Immutable();
                                            }
                                        }
                                    }
                                }
                                if (target_mut is Mutability.Mutable && val_mut is Mutability.Immutable) {
                                    this.report_error(new ErrorCode.E_MUTABILITY(),
                                        "Cannot assign immutable value to mutable variable",
                                        new SourceLocation("", 0, 0));
                                }
                            }
                            let result: mut BoundAssignmentStatement = new BoundAssignmentStatement(target, target.some.identifier.symbol, effective_op, value, value_type);
                            result.location = stmt.assignment.location;
                            return new Option<BoundStatement>.some(new BoundStatement.assignment(result));
                        }
                    }
                    let result: mut BoundAssignmentStatement = new BoundAssignmentStatement(target, new Option<BoundSymbol>.none(), effective_op, value, value_type);
                    result.location = stmt.assignment.location;
                    return new Option<BoundStatement>.some(new BoundStatement.assignment(result));
                }
                let value_type: BoundType = target.some.get_bound_type();
                let result: mut BoundAssignmentStatement = new BoundAssignmentStatement(target, new Option<BoundSymbol>.none(), stmt.assignment.operator_value, new Option<BoundExpression>.none(), value_type);
                result.location = stmt.assignment.location;
                return new Option<BoundStatement>.some(new BoundStatement.assignment(result));
            }
            if (stmt.assignment.value.is_some()) {
                let value: Option<BoundExpression> = this.bind_expression(stmt.assignment.value.some, scope);
                let result: mut BoundAssignmentStatement = new BoundAssignmentStatement(new Option<BoundExpression>.none(), new Option<BoundSymbol>.none(), stmt.assignment.operator_value, value, new BoundType());
                result.location = stmt.assignment.location;
                return new Option<BoundStatement>.some(new BoundStatement.assignment(result));
            }
            let result: mut BoundAssignmentStatement = new BoundAssignmentStatement(new Option<BoundExpression>.none(), new Option<BoundSymbol>.none(), stmt.assignment.operator_value, new Option<BoundExpression>.none(), new BoundType());
            result.location = stmt.assignment.location;
            return new Option<BoundStatement>.some(new BoundStatement.assignment(result));
        }
        if (stmt is Statement.if_stmt) {
            if (stmt.if_stmt.condition.is_some() && stmt.if_stmt.condition.some is Expression.try_bind) {
                return this.bind_try_bind_if_stmt(stmt.if_stmt, scope);
            }
            // P2 condition-region: pattern variables from `&&` chains in the
            // condition are visible in the then-branch only.
            let cond_region: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<cond>", scope.full_name + ".<cond>", new Option<BoundScope>.some(scope));
            cond_region.is_region = true;
            cond_region.is_condition_region = true;
            let condition: Option<BoundExpression> = this.bind_optional_expr(stmt.if_stmt.condition, cond_region);
            let then_stmt: Option<BoundStatement> = this.bind_optional_stmt(stmt.if_stmt.then_statement, cond_region);
            let else_stmt: Option<BoundStatement> = this.bind_optional_stmt(stmt.if_stmt.else_statement, scope);
            let result: mut BoundIfStatement = new BoundIfStatement(condition, then_stmt, else_stmt);
            result.location = stmt.if_stmt.location;
            return new Option<BoundStatement>.some(new BoundStatement.if_stmt(result));
        }
        if (stmt is Statement.while_stmt) {
            if (stmt.while_stmt.condition.is_some() && stmt.while_stmt.condition.some is Expression.try_bind) {
                return this.bind_try_bind_while_stmt(stmt.while_stmt, scope);
            }
            let cond_region: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<cond>", scope.full_name + ".<cond>", new Option<BoundScope>.some(scope));
            cond_region.is_region = true;
            cond_region.is_condition_region = true;
            let condition: Option<BoundExpression> = this.bind_optional_expr(stmt.while_stmt.condition, cond_region);
            let body: Option<BoundStatement> = this.bind_optional_stmt(stmt.while_stmt.body, cond_region);
            let result: mut BoundWhileStatement = new BoundWhileStatement(condition, body);
            result.location = stmt.while_stmt.location;
            return new Option<BoundStatement>.some(new BoundStatement.while_stmt(result));
        }
        if (stmt is Statement.return_stmt) {
            if (stmt.return_stmt.value.is_some()) {
                let value: Option<BoundExpression> = this.bind_expression(stmt.return_stmt.value.some, scope);
                if (value.is_some()) {
                    let ret_type: BoundType = value.some.get_bound_type();
                    let result: mut BoundReturnStatement = new BoundReturnStatement(value, ret_type);
                    result.location = stmt.return_stmt.location;
                    return new Option<BoundStatement>.some(new BoundStatement.return_stmt(result));
                }
            }
            let result: mut BoundReturnStatement = new BoundReturnStatement(new Option<BoundExpression>.none(), new BoundType());
            result.location = stmt.return_stmt.location;
            return new Option<BoundStatement>.some(new BoundStatement.return_stmt(result));
        }
        if (stmt is Statement.break_stmt) {
            if (stmt.break_stmt.value.is_some()) {
                let value: Option<BoundExpression> = this.bind_expression(stmt.break_stmt.value.some, scope);
                let result: mut BoundBreakStatement = new BoundBreakStatement(value);
                result.location = stmt.break_stmt.location;
                return new Option<BoundStatement>.some(new BoundStatement.break_stmt(result));
            }
            let result: mut BoundBreakStatement = new BoundBreakStatement(new Option<BoundExpression>.none());
            result.location = stmt.break_stmt.location;
            return new Option<BoundStatement>.some(new BoundStatement.break_stmt(result));
        }
        if (stmt is Statement.continue_stmt) {
            let result: mut BoundContinueStatement = new BoundContinueStatement();
            result.location = stmt.continue_stmt.location;
            return new Option<BoundStatement>.some(new BoundStatement.continue_stmt(result));
        }
        if (stmt is Statement.let_decl) {
            let var_sym: mut BoundVariableSymbol = new BoundVariableSymbol();
            var_sym.name = stmt.let_decl.variable_name;
            var_sym.full_name = scope.full_name + "." + stmt.let_decl.variable_name;
            var_sym.is_mutable = stmt.let_decl.is_mutable;
            // BabyPenguin conflates binding mutability with type mutability:
            // `let x: mut T` makes both the binding and the value mutable.
            if (stmt.let_decl.type_spec.is_some()) {
                if (stmt.let_decl.type_spec.some.is_mutable) {
                    var_sym.is_mutable = true;
                }
            }
            var_sym.location = stmt.let_decl.location;
            if (stmt.let_decl.initializer.is_some()) {
                let initializer: Option<BoundExpression> = this.bind_expression(stmt.let_decl.initializer.some, scope);
                if (initializer.is_some()) {
                    let init_type: BoundType = initializer.some.get_bound_type();
                    // When type is inferred (no type_spec), propagate mutability
                    // from the initializer's type to the binding (BabyPenguin
                    // conflates binding and type mutability). Reference types
                    // (IReferenceType) are exempt: BabyPenguin keeps `let a = new Ref(1)`
                    // an immutable binding even though the new-expression's type is
                    // mutable, so assigning it to a `mut` binding must fail E_MUTABILITY.
                    if (stmt.let_decl.type_spec.is_none()) {
                        if (init_type.mutability is Mutability.Mutable && !this.is_iref_type(init_type)) {
                            var_sym.is_mutable = true;
                        }
                    }
                    let decl_type: mut BoundType = initializer.some.get_bound_type();
                    if (stmt.let_decl.type_spec.is_some()) {
                        let resolved: mut BoundType = this.resolve_type_specifier(stmt.let_decl.type_spec.some, scope);
                        decl_type = resolved;
                    }
                    // Reference type mutability compatibility: `let b: mut Ref = a`
                    // where `a` is an immutable binding must fail E_MUTABILITY (an
                    // IReferenceType value aliases, so imm→mut would allow mutating
                    // shared state). A fresh mutable expression (`new Ref(...)`) is
                    // allowed, and value types (ICopy) copy so they are exempt.
                    if (this.is_iref_type(decl_type)) {
                        let target_mut: Mutability = decl_type.mutability;
                        let val_mut: mut Mutability = init_type.mutability;
                        if (initializer.some is BoundExpression.identifier) {
                            let v_id: BoundIdentifierExpression = initializer.some.identifier;
                            if (v_id.symbol.is_some()) {
                                if (v_id.symbol.some is BoundSymbol.variable) {
                                    if (!v_id.symbol.some.variable.is_mutable) {
                                        val_mut = new Mutability.Immutable();
                                    }
                                }
                            }
                        }
                        if (target_mut is Mutability.Mutable && val_mut is Mutability.Immutable) {
                            this.report_error(new ErrorCode.E_MUTABILITY(),
                                "Cannot assign immutable value to mutable variable",
                                new SourceLocation("", 0, 0));
                        }
                    }
                    var_sym.bound_type = decl_type;
                    let result: mut BoundLetDeclarationStatement = new BoundLetDeclarationStatement(
                        new Option<BoundVariableSymbol>.some(var_sym),
                        initializer, decl_type, new Option<BoundScope>.some(scope));
                    result.location = stmt.let_decl.location;
                    scope.add_symbol(new BoundSymbol.variable(var_sym));
                    return new Option<BoundStatement>.some(new BoundStatement.let_decl(result));
                }
            }
            // No initializer: resolve type from type_specifier if available
            let decl_type: mut BoundType = new BoundType();
            if (stmt.let_decl.type_spec.is_some()) {
                decl_type = this.resolve_type_specifier(stmt.let_decl.type_spec.some, scope);
            }
            var_sym.bound_type = decl_type;
            let result: mut BoundLetDeclarationStatement = new BoundLetDeclarationStatement(
                new Option<BoundVariableSymbol>.some(var_sym),
                new Option<BoundExpression>.none(), decl_type, new Option<BoundScope>.some(scope));
            result.location = stmt.let_decl.location;
            scope.add_symbol(new BoundSymbol.variable(var_sym));
            return new Option<BoundStatement>.some(new BoundStatement.let_decl(result));
        }
        if (stmt is Statement.for_stmt) {
            let fs: ForStatement = stmt.for_stmt;
            let loc: SourceLocation = fs.location;

            // Create for scope
            let for_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<for>", scope.full_name + ".<for>", new Option<BoundScope>.some(scope));

            // The iteration method is chosen from the loop variable's mutability:
            //   let x         -> iter()      (read-only path)
            //   let x : mut T -> iter_mut()  (mutable path)
            //   let mut x     -> iter_mut()
            let loop_mutable: bool = fs.is_mutable || (fs.type_spec.is_some() && fs.type_spec.some.is_mutable);

            // 1. Bind the iterable expression to learn its type.
            let bound_iterable: mut Option<BoundExpression> = this.bind_expression(fs.iterable.some, for_scope);
            if (bound_iterable.is_none()) {
                return new Option<BoundStatement>.none();
            }
            let iterable_type: mut BoundType = bound_iterable.some.get_bound_type();

            let bound_iter_call: mut Option<BoundExpression> = new Option<BoundExpression>.none();
            let iter_type: mut BoundType = this.type_registry.make_error_type();
            if (this.is_iterator_type(iterable_type)) {
                // Already an iterator — use it directly (no extra .iter() wrap).
                bound_iter_call = bound_iterable;
                iter_type = iterable_type;
            } else {
                // A genuine iterable: desugar to iter()/iter_mut(). The iterable must
                // provide the chosen method, otherwise the type is not iterable.
                let method_name: string = if (loop_mutable) { "iter_mut" } else { "iter" };
                let ast_iter_ma: Expression = new Expression.member_access(new MemberAccessExpression());
                ast_iter_ma.member_access.base_expr = fs.iterable;
                ast_iter_ma.member_access.member_name = method_name;
                let ast_iter_call: Expression = new Expression.function_call(new FunctionCallExpression());
                ast_iter_call.function_call.callee = new Option<Expression>.some(ast_iter_ma);
                let b: mut Option<BoundExpression> = this.bind_expression(ast_iter_call, for_scope);
                if (b.is_none()) {
                    this.report_error(new ErrorCode.E_ITERATOR_INVALID(),
                        "Type '" + iterable_type.display_name() + "' is not iterable (missing '" + method_name + "' method)",
                        loc);
                    return new Option<BoundStatement>.none();
                }
                bound_iter_call = b;
                let it_tmp: mut BoundType = bound_iter_call.some.get_bound_type();
                iter_type = it_tmp;
            }

            // 2. Declare __iter. The iterator is ALWAYS held by a mutable binding so
            // that next(mut this) is callable even when iter() returns a non-mut-typed
            // IIterator (the read-only path).
            let iter_sym: mut BoundVariableSymbol = new BoundVariableSymbol();
            iter_sym.name = "__iter";
            iter_sym.full_name = for_scope.full_name + ".__iter";
            iter_sym.bound_type = iter_type.with_mutability(new Mutability.Mutable());
            iter_sym.is_mutable = true;
            iter_sym.variable_kind = new VariableSymbolKind.Local();
            iter_sym.location = loc;
            for_scope.add_symbol(new BoundSymbol.variable(iter_sym));

            // 3. Build __iter.next() call
            let ast_iter_ident: Expression = new Expression.identifier(new IdentifierExpression("__iter"));
            let ast_next_ma: Expression = new Expression.member_access(new MemberAccessExpression());
            ast_next_ma.member_access.base_expr = new Option<Expression>.some(ast_iter_ident);
            ast_next_ma.member_access.member_name = "next";
            let ast_next_call: Expression = new Expression.function_call(new FunctionCallExpression());
            ast_next_call.function_call.callee = new Option<Expression>.some(ast_next_ma);
            let bound_next_call: Option<BoundExpression> = this.bind_expression(ast_next_call, for_scope);

            if (bound_next_call.is_none()) {
                return new Option<BoundStatement>.none();
            }
            let opt_type: mut BoundType = bound_next_call.some.get_bound_type();

            // 4. Declare __opt
            let opt_sym: mut BoundVariableSymbol = new BoundVariableSymbol();
            opt_sym.name = "__opt";
            opt_sym.full_name = for_scope.full_name + ".__opt";
            opt_sym.bound_type = opt_type;
            opt_sym.is_mutable = true;
            opt_sym.variable_kind = new VariableSymbolKind.Local();
            opt_sym.location = loc;
            for_scope.add_symbol(new BoundSymbol.variable(opt_sym));

            // 5. Build __opt.is_none() call (for break condition)
            let ast_opt_ident: Expression = new Expression.identifier(new IdentifierExpression("__opt"));
            let ast_isnone_ma: Expression = new Expression.member_access(new MemberAccessExpression());
            ast_isnone_ma.member_access.base_expr = new Option<Expression>.some(ast_opt_ident);
            ast_isnone_ma.member_access.member_name = "is_none";
            let ast_isnone_call: Expression = new Expression.function_call(new FunctionCallExpression());
            ast_isnone_call.function_call.callee = new Option<Expression>.some(ast_isnone_ma);
            let bound_isnone_call: Option<BoundExpression> = this.bind_expression(ast_isnone_call, for_scope);

            // 6. Build __opt.some (for loop variable initialization)
            let ast_opt_some_ma: Expression = new Expression.member_access(new MemberAccessExpression());
            ast_opt_some_ma.member_access.base_expr = new Option<Expression>.some(ast_opt_ident);
            ast_opt_some_ma.member_access.member_name = "some";
            let bound_opt_some: Option<BoundExpression> = this.bind_expression(ast_opt_some_ma, for_scope);

            // 7. Determine element type
            let elem_type: mut BoundType;
            if (bound_opt_some.is_some()) {
                let tmp_elem: mut BoundType = bound_opt_some.some.get_bound_type();
                elem_type = tmp_elem;
            } else {
                elem_type = new BoundType();
            }

            // 8. Create body scope for loop variable
            let body_scope: mut BoundScope = new BoundScope(new ScopeKind.BlockScope(), "<for_body>", for_scope.full_name + ".<for_body>", new Option<BoundScope>.some(for_scope));

            // 9. Create loop variable. The declared type (if any) is authoritative for
            // the binding — including its mutability (`let x : mut Foo`); otherwise the
            // iterator's element type is inferred. `let mut x` makes the binding
            // reassignable.
            let loop_var_type: mut BoundType = elem_type;
            if (fs.type_spec.is_some()) {
                loop_var_type = this.resolve_type_specifier(fs.type_spec.some, body_scope);
            }
            let loop_sym: mut BoundVariableSymbol = new BoundVariableSymbol();
            loop_sym.name = fs.variable_name;
            loop_sym.full_name = body_scope.full_name + "." + fs.variable_name;
            loop_sym.bound_type = loop_var_type;
            loop_sym.is_mutable = fs.is_mutable;
            loop_sym.variable_kind = new VariableSymbolKind.Local();
            loop_sym.location = loc;
            body_scope.add_symbol(new BoundSymbol.variable(loop_sym));

            // 10. Bind original body
            let bound_body: Option<BoundStatement> = this.bind_optional_stmt(fs.body, body_scope);

            // 11. Build advance assignment: __opt = __iter.next()
            let ast_iter_ident2: Expression = new Expression.identifier(new IdentifierExpression("__iter"));
            let ast_next_ma2: Expression = new Expression.member_access(new MemberAccessExpression());
            ast_next_ma2.member_access.base_expr = new Option<Expression>.some(ast_iter_ident2);
            ast_next_ma2.member_access.member_name = "next";
            let ast_next_call2: Expression = new Expression.function_call(new FunctionCallExpression());
            ast_next_call2.function_call.callee = new Option<Expression>.some(ast_next_ma2);
            let ast_assign: Statement = new Statement.assignment(new AssignmentStatement());
            ast_assign.assignment.target = new Option<Expression>.some(new Expression.identifier(new IdentifierExpression("__opt")));
            ast_assign.assignment.operator_value = new AssignmentOperator.Assign();
            ast_assign.assignment.value = new Option<Expression>.some(ast_next_call2);
            ast_assign.assignment.location = loc;
            let bound_advance: Option<BoundStatement> = this.bind_statement(ast_assign, for_scope);

            // 12. Build inner body block
            let inner_stmts: mut _utils.List<BoundStatement> = new _utils.List<BoundStatement>();
            // let x = __opt.some
            let loop_let_stmt: mut BoundLetDeclarationStatement = new BoundLetDeclarationStatement(
                new Option<BoundVariableSymbol>.some(loop_sym),
                bound_opt_some,
                loop_var_type,
                new Option<BoundScope>.some(body_scope));
            loop_let_stmt.location = loc;
            inner_stmts.push(new BoundStatement.let_decl(loop_let_stmt));
            // original body
            if (bound_body.is_some()) {
                inner_stmts.push(bound_body.some);
            }
            let inner_block: Option<BoundStatement> = new Option<BoundStatement>.some(
                new BoundStatement.block(new BoundBlockStatement(inner_stmts, new Option<BoundScope>.some(body_scope))));

            // 13. Build if-break: if (__opt.is_none()) break;
            let break_stmt: mut BoundBreakStatement = new BoundBreakStatement(new Option<BoundExpression>.none());
            break_stmt.location = loc;
            let if_check: mut BoundIfStatement = new BoundIfStatement(
                bound_isnone_call,
                new Option<BoundStatement>.some(new BoundStatement.break_stmt(break_stmt)),
                new Option<BoundStatement>.none());
            if_check.location = loc;

            // 14. Build while body block
            let wb_stmts: mut _utils.List<BoundStatement> = new _utils.List<BoundStatement>();
            if (bound_advance.is_some()) { wb_stmts.push(bound_advance.some); }
            wb_stmts.push(new BoundStatement.if_stmt(if_check));
            if (inner_block.is_some()) { wb_stmts.push(inner_block.some); }
            let while_body_block: mut BoundBlockStatement = new BoundBlockStatement(wb_stmts, new Option<BoundScope>.some(for_scope));

            // 15. Build while(true) loop
            let true_literal: BoundLiteralExpression = new BoundLiteralExpression("true", this.type_registry.bool_type, new LiteralKind.BoolLiteral());
            let true_bound: Option<BoundExpression> = new Option<BoundExpression>.some(new BoundExpression.literal(true_literal));
            let while_stmt: mut BoundWhileStatement = new BoundWhileStatement(true_bound, new Option<BoundStatement>.some(new BoundStatement.block(while_body_block)));
            while_stmt.location = loc;

            // 16. Build final block
            let final_stmts: mut _utils.List<BoundStatement> = new _utils.List<BoundStatement>();
            // let mut __iter = iterable.iter()
            let iter_decl: mut BoundLetDeclarationStatement = new BoundLetDeclarationStatement(
                new Option<BoundVariableSymbol>.some(iter_sym),
                bound_iter_call,
                iter_sym.bound_type,
                new Option<BoundScope>.some(for_scope));
            iter_decl.location = loc;
            final_stmts.push(new BoundStatement.let_decl(iter_decl));
            // let mut __opt: Option<T> (no initializer)
            let opt_decl: mut BoundLetDeclarationStatement = new BoundLetDeclarationStatement(
                new Option<BoundVariableSymbol>.some(opt_sym),
                new Option<BoundExpression>.none(),
                opt_type,
                new Option<BoundScope>.some(for_scope));
            opt_decl.location = loc;
            final_stmts.push(new BoundStatement.let_decl(opt_decl));
            // while (true) { ... }
            final_stmts.push(new BoundStatement.while_stmt(while_stmt));

            let result: mut BoundBlockStatement = new BoundBlockStatement(final_stmts, new Option<BoundScope>.some(for_scope));
            result.location = loc;
            return new Option<BoundStatement>.some(new BoundStatement.block(result));
        }
        if (stmt is Statement.meta_if_stmt) {
            let r: mut BoundMetaIfStatement = new BoundMetaIfStatement(new Option<Statement>.some(new Statement.meta_if_stmt(stmt.meta_if_stmt)));
            r.location = stmt.meta_if_stmt.location;
            return new Option<BoundStatement>.some(new BoundStatement.meta_if_stmt(r));
        }
        if (stmt is Statement.meta_while_stmt) {
            let r: mut BoundMetaWhileStatement = new BoundMetaWhileStatement(new Option<Statement>.some(new Statement.meta_while_stmt(stmt.meta_while_stmt)));
            r.location = stmt.meta_while_stmt.location;
            return new Option<BoundStatement>.some(new BoundStatement.meta_while_stmt(r));
        }
        if (stmt is Statement.meta_for_stmt) {
            let r: mut BoundMetaForStatement = new BoundMetaForStatement(new Option<Statement>.some(new Statement.meta_for_stmt(stmt.meta_for_stmt)));
            r.location = stmt.meta_for_stmt.location;
            return new Option<BoundStatement>.some(new BoundStatement.meta_for_stmt(r));
        }
        if (stmt is Statement.meta_break_stmt) {
            return new Option<BoundStatement>.some(new BoundStatement.meta_break_stmt(new BoundMetaBreakStatement(stmt.meta_break_stmt.location)));
        }
        if (stmt is Statement.meta_continue_stmt) {
            return new Option<BoundStatement>.some(new BoundStatement.meta_continue_stmt(new BoundMetaContinueStatement(stmt.meta_continue_stmt.location)));
        }
        return new Option<BoundStatement>.none();
    }

    // --- Pass 7: Validate Control Flow ---

    fun pass_validate_control_flow(mut this, result: BoundCompilationUnit) {
        _utils.trace_enter("Enter pass_validate_control_flow");
        let i: mut i64 = 0;
        while (i < cast<i64>(result.definitions.size())) {
            let def: BoundDefinition = result.definitions.at(cast<u64>(i)).some;
            this.validate_control_flow_for_def(def);
            i = i + 1;
        }
    }

    fun validate_control_flow_for_def(mut this, def: BoundDefinition) {
        _utils.trace_enter("Enter validate_control_flow_for_def");
        if (def is BoundDefinition.function_def) {
            let func: BoundFunctionDefinition = def.function_def;
            if (func.body.is_some() && func.symbol.is_some()) {
                let sym: BoundFunctionSymbol = func.symbol.some;
                this._current_validating_func = func.name;
                this.validate_expr_control_flow(func.body.some, sym.return_type, 0);
                if (!this.type_registry.is_void(sym.return_type)) {
                    if (!this.expr_always_returns(func.body.some)) {
                        this.report_error(new ErrorCode.E_RETURN_MISSING(), "Non-void function '" + func.name + "' must return a value on all paths", sym.location);
                    }
                }
            }
        }
        if (def is BoundDefinition.initial_routine) {
            let init: BoundInitialRoutineDefinition = def.initial_routine;
            if (init.body.is_some()) {
                this.validate_expr_control_flow(init.body.some, this.type_registry.void_type, 0);
            }
        }
        if (def is BoundDefinition.class_def) {
            let cls: BoundClassDefinition = def.class_def;
            let j: mut i64 = 0;
            while (j < cast<i64>(cls.methods.size())) {
                let md: BoundDefinition = cls.methods.at(cast<u64>(j)).some;
                this.validate_control_flow_for_def(md);
                j = j + 1;
            }
        }
        if (def is BoundDefinition.namespace_def) {
            let ns: BoundNamespaceDefinition = def.namespace_def;
            let j: mut i64 = 0;
            while (j < cast<i64>(ns.children.size())) {
                let child: BoundDefinition = ns.children.at(cast<u64>(j)).some;
                this.validate_control_flow_for_def(child);
                j = j + 1;
            }
        }
    }

    fun validate_expr_control_flow(mut this, expr: BoundExpression, ret_type: BoundType, loop_depth: i64) {
        _utils.trace_enter("Enter validate_expr_control_flow");
        if (expr is BoundExpression.code_block) {
            let cb: BoundCodeBlockExpression = expr.code_block;
            let i: mut i64 = 0;
            while (i < cast<i64>(cb.statements.size())) {
                this.validate_stmt_control_flow(cb.statements.at(cast<u64>(i)).some, ret_type, loop_depth);
                i = i + 1;
            }
        }
        if (expr is BoundExpression.if_expr) {
            let if_e: BoundIfExpression = expr.if_expr;
            if (if_e.condition.is_some()) { this.validate_expr_control_flow(if_e.condition.some, ret_type, loop_depth); }
            if (if_e.then_block.is_some()) { this.validate_expr_control_flow(if_e.then_block.some, ret_type, loop_depth); }
            if (if_e.else_block.is_some()) { this.validate_expr_control_flow(if_e.else_block.some, ret_type, loop_depth); }
        }
        if (expr is BoundExpression.while_expr) {
            let w: BoundWhileExpression = expr.while_expr;
            if (w.condition.is_some()) { this.validate_expr_control_flow(w.condition.some, ret_type, loop_depth); }
            if (w.body.is_some()) { this.validate_expr_control_flow(w.body.some, ret_type, loop_depth + 1); }
        }
        if (expr is BoundExpression.binary) {
            let bin: BoundBinaryExpression = expr.binary;
            let i: mut i64 = 0;
            while (i < cast<i64>(bin.operands.size())) {
                this.validate_expr_control_flow(bin.operands.at(cast<u64>(i)).some, ret_type, loop_depth);
                i = i + 1;
            }
        }
        if (expr is BoundExpression.unary) {
            let un: BoundUnaryExpression = expr.unary;
            if (un.operand.is_some()) { this.validate_expr_control_flow(un.operand.some, ret_type, loop_depth); }
        }
        if (expr is BoundExpression.function_call) {
            let fc: BoundFunctionCallExpression = expr.function_call;
            if (fc.callee.is_some()) { this.validate_expr_control_flow(fc.callee.some, ret_type, loop_depth); }
            let i: mut i64 = 0;
            while (i < cast<i64>(fc.arguments.size())) {
                this.validate_expr_control_flow(fc.arguments.at(cast<u64>(i)).some, ret_type, loop_depth);
                i = i + 1;
            }
        }
        if (expr is BoundExpression.member_access) {
            let ma: BoundMemberAccessExpression = expr.member_access;
            if (ma.base_expr.is_some()) { this.validate_expr_control_flow(ma.base_expr.some, ret_type, loop_depth); }
        }
        if (expr is BoundExpression.cast_expr) {
            let c: BoundCastExpression = expr.cast_expr;
            if (c.inner.is_some()) { this.validate_expr_control_flow(c.inner.some, ret_type, loop_depth); }
        }
        if (expr is BoundExpression.new_expr) {
            let ne: BoundNewExpression = expr.new_expr;
            let i: mut i64 = 0;
            while (i < cast<i64>(ne.arguments.size())) {
                this.validate_expr_control_flow(ne.arguments.at(cast<u64>(i)).some, ret_type, loop_depth);
                i = i + 1;
            }
        }
        if (expr is BoundExpression.enum_variant) {
            let ev: BoundEnumVariantExpression = expr.enum_variant;
            if (ev.payload.is_some()) {
                this.validate_expr_control_flow(ev.payload.some, ret_type, loop_depth);
            }
        }
    }

    fun validate_stmt_control_flow(mut this, stmt: BoundStatement, ret_type: BoundType, loop_depth: i64) {
        _utils.trace_enter("Enter validate_stmt_control_flow");
        if (stmt is BoundStatement.return_stmt) {
            let ret: BoundReturnStatement = stmt.return_stmt;
            if (ret.value.is_some()) {
                this.validate_expr_control_flow(ret.value.some, ret_type, loop_depth);
                let value_type: BoundType = ret.value.some.get_bound_type();
                // Integer literals coerce to any integer return type (BabyPenguin
                // allows `return 5` for a u8 function; the literal defaults to i64).
                // Guard the `.literal` access via an if-expression: `&&` does not
                // short-circuit in PenguinLang, so a bare `is && .literal` would
                // cast non-literal returns and crash.
                let is_int_lit: bool = if (ret.value.some is BoundExpression.literal) {
                    ret.value.some.literal.literal_kind is LiteralKind.IntegerLiteral
                } else {
                    false
                };
                let int_literal_coercion: bool = is_int_lit && this.type_registry.is_integer(ret_type);
                if (!this.type_registry.is_void(ret_type) && !this.type_registry.can_implicitly_cast(value_type, ret_type) && !int_literal_coercion) {
                    this.report_error(new ErrorCode.E_RETURN_TYPE_MISMATCH(), "Return type mismatch: expected " + ret_type.display_name() + " but got " + value_type.display_name() + " in " + this._current_validating_func, ret.location);
                }
            }
        }
        if (stmt is BoundStatement.expression) {
            if (stmt.expression.expression.is_some()) {
                this.validate_expr_control_flow(stmt.expression.expression.some, ret_type, loop_depth);
            }
        }
        if (stmt is BoundStatement.block) {
            let block: BoundBlockStatement = stmt.block;
            let i: mut i64 = 0;
            while (i < cast<i64>(block.statements.size())) {
                this.validate_stmt_control_flow(block.statements.at(cast<u64>(i)).some, ret_type, loop_depth);
                i = i + 1;
            }
        }
        if (stmt is BoundStatement.if_stmt) {
            let if_s: BoundIfStatement = stmt.if_stmt;
            if (if_s.condition.is_some()) { this.validate_expr_control_flow(if_s.condition.some, ret_type, loop_depth); }
            if (if_s.then_statement.is_some()) { this.validate_stmt_control_flow(if_s.then_statement.some, ret_type, loop_depth); }
            if (if_s.else_statement.is_some()) { this.validate_stmt_control_flow(if_s.else_statement.some, ret_type, loop_depth); }
        }
        if (stmt is BoundStatement.while_stmt) {
            let ws: BoundWhileStatement = stmt.while_stmt;
            if (ws.condition.is_some()) { this.validate_expr_control_flow(ws.condition.some, ret_type, loop_depth); }
            if (ws.body.is_some()) { this.validate_stmt_control_flow(ws.body.some, ret_type, loop_depth + 1); }
        }
        if (stmt is BoundStatement.for_stmt) {
            let fs: BoundForStatement = stmt.for_stmt;
            if (fs.iterable.is_some()) { this.validate_expr_control_flow(fs.iterable.some, ret_type, loop_depth); }
            if (fs.body.is_some()) { this.validate_stmt_control_flow(fs.body.some, ret_type, loop_depth + 1); }
        }
        if (stmt is BoundStatement.break_stmt) {
            if (loop_depth == 0) {
                this.report_error(new ErrorCode.E_LOOP_CONTEXT(), "break statement not inside a loop", stmt.break_stmt.location);
            }
        }
        if (stmt is BoundStatement.continue_stmt) {
            if (loop_depth == 0) {
                this.report_error(new ErrorCode.E_LOOP_CONTEXT(), "continue statement not inside a loop", stmt.continue_stmt.location);
            }
        }
        if (stmt is BoundStatement.assignment) {
            let assign: BoundAssignmentStatement = stmt.assignment;
            if (assign.target.is_some()) { this.validate_expr_control_flow(assign.target.some, ret_type, loop_depth); }
            if (assign.value.is_some()) { this.validate_expr_control_flow(assign.value.some, ret_type, loop_depth); }
        }
        if (stmt is BoundStatement.let_decl) {
            let let_s: BoundLetDeclarationStatement = stmt.let_decl;
            if (let_s.initializer.is_some()) { this.validate_expr_control_flow(let_s.initializer.some, ret_type, loop_depth); }
        }
    }

    fun expr_always_returns(this, expr: BoundExpression) -> bool {
        _utils.trace_enter("Enter expr_always_returns");
        if (expr is BoundExpression.code_block) {
            let cb: BoundCodeBlockExpression = expr.code_block;
            if (cast<i64>(cb.statements.size()) == 0) { return false; }
            let last_idx: i64 = cast<i64>(cb.statements.size()) - 1;
            let last: BoundStatement = cb.statements.at(cast<u64>(last_idx)).some;
            return this.stmt_always_returns(last);
        }
        // Handle if/else if/else chains where else_block is itself an if_expr
        if (expr is BoundExpression.if_expr) {
            let if_e: BoundIfExpression = expr.if_expr;
            if (if_e.then_block.is_some() && if_e.else_block.is_some()) {
                return this.expr_always_returns(if_e.then_block.some) && this.expr_always_returns(if_e.else_block.some);
            }
        }
        return false;
    }

    fun stmt_always_returns(this, stmt: BoundStatement) -> bool {
        _utils.trace_enter("Enter stmt_always_returns");
        if (stmt is BoundStatement.return_stmt) { return true; }
        if (stmt is BoundStatement.expression) {
            if (let expr := stmt.expression.expression.some) {
                if (expr is BoundExpression.if_expr) {
                    let if_e: BoundIfExpression = expr.if_expr;
                    if (if_e.then_block.is_some() && if_e.else_block.is_some()) {
                        return this.expr_always_returns(if_e.then_block.some) && this.expr_always_returns(if_e.else_block.some);
                    }
                }
                if (expr is BoundExpression.while_expr) {
                    let w: BoundWhileExpression = expr.while_expr;
                    if (this.is_literal_true(w.condition) && w.body.is_some()) {
                        return this.expr_always_returns(w.body.some);
                    }
                }
            }
        }
        if (stmt is BoundStatement.if_stmt) {
            let if_s: BoundIfStatement = stmt.if_stmt;
            if (if_s.then_statement.is_some() && if_s.else_statement.is_some()) {
                return this.stmt_always_returns(if_s.then_statement.some) && this.stmt_always_returns(if_s.else_statement.some);
            }
        }
        if (stmt is BoundStatement.while_stmt) {
            let ws: BoundWhileStatement = stmt.while_stmt;
            if (this.is_stmt_condition_literal_true(ws.condition) && ws.body.is_some()) {
                return this.stmt_always_returns(ws.body.some);
            }
        }
        if (stmt is BoundStatement.block) {
            let block: BoundBlockStatement = stmt.block;
            if (cast<i64>(block.statements.size()) == 0) { return false; }
            let last_idx: i64 = cast<i64>(block.statements.size()) - 1;
            return this.stmt_always_returns(block.statements.at(cast<u64>(last_idx)).some);
        }
        return false;
    }

    fun get_field_mutability(this, ma: BoundMemberAccessExpression) -> Mutability {
        _utils.trace_enter("Enter get_field_mutability");
        if (ma.base_expr.is_some() && ma.member_symbol.is_some()) {
            let ms: BoundSymbol = ma.member_symbol.some;
            if (ms is BoundSymbol.variable && ms.variable.variable_kind is VariableSymbolKind.Field) {
                let base_type: BoundType = ma.base_expr.some.get_bound_type();
                if (let td := base_type.type_definition.some) {
                    if (td is BoundDefinition.class_def) {
                        let cls: BoundClassDefinition = td.class_def;
                        let fi: mut i64 = 0;
                        while (fi < cast<i64>(cls.fields.size())) {
                            let fd: BoundDefinition = cls.fields.at(cast<u64>(fi)).some;
                            if (fd is BoundDefinition.class_field) {
                                if (fd.class_field.name == ms.variable.name) {
                                    return fd.class_field.mutability;
                                }
                            }
                            fi = fi + 1;
                        }
                    }
                }
            }
        }
        return new Mutability.Mutable();
    }

    fun is_literal_true(this, opt: Option<BoundExpression>) -> bool {
        _utils.trace_enter("Enter is_literal_true");
        if (opt.is_none()) { return false; }
        let expr: BoundExpression = opt.some;
        if (expr is BoundExpression.literal) {
            if (expr.literal.literal_kind is LiteralKind.BoolLiteral && expr.literal.value == "true") {
                return true;
            }
        }
        return false;
    }

    fun is_stmt_condition_literal_true(this, opt: Option<BoundExpression>) -> bool {
        _utils.trace_enter("Enter is_stmt_condition_literal_true");
        return this.is_literal_true(opt);
    }

    fun collect_function_instantiations_from_ast(this, defs: _utils.List<Definition>, scope: BoundScope, func_instantiations: mut _utils.List<FunctionInstantiation>) {
        _utils.trace_enter("Enter collect_function_instantiations_from_ast");
        let i: mut i64 = 0;
        while (i < cast<i64>(defs.size())) {
            let def: Definition = defs.at(cast<u64>(i)).some;
            if (def is Definition.initial_routine) {
                if (def.initial_routine.body.is_some()) {
                    this.collect_func_inst_from_expr(def.initial_routine.body.some, scope, func_instantiations);
                }
            }
            if (def is Definition.function_def) {
                if (def.function_def.body.is_some()) {
                    this.collect_func_inst_from_expr(def.function_def.body.some, scope, func_instantiations);
                }
            }
            if (def is Definition.namespace_def) {
                this.collect_function_instantiations_from_ast(def.namespace_def.children, scope, func_instantiations);
            }
            if (def is Definition.class_def) {
                if (def.class_def.template_decl.is_none()) {
                    let members: _utils.List<Definition> = def.class_def.members;
                    let mi: mut i64 = 0;
                    while (mi < cast<i64>(members.size())) {
                        let member: Definition = members.at(cast<u64>(mi)).some;
                        if (member is Definition.function_def) {
                            if (member.function_def.body.is_some()) {
                                this.collect_func_inst_from_expr(member.function_def.body.some, scope, func_instantiations);
                            }
                        }
                        mi = mi + 1;
                    }
                }
            }
            i = i + 1;
        }
    }

    fun collect_func_inst_from_expr(this, expr: Expression, scope: BoundScope, func_instantiations: mut _utils.List<FunctionInstantiation>) {
        _utils.trace_enter("Enter collect_func_inst_from_expr");
        if (expr is Expression.function_call) {
            let fc: FunctionCallExpression = expr.function_call;
            if (let ast_callee := fc.callee.some) {
                if (ast_callee is Expression.identifier) {
                    if (cast<i64>(ast_callee.identifier.generic_args.size()) > 0) {
                        let func_name: string = ast_callee.identifier.name;
                        let resolved_args: mut _utils.List<BoundType> = new _utils.List<BoundType>();
                        let gi: mut i64 = 0;
                        while (gi < cast<i64>(ast_callee.identifier.generic_args.size())) {
                            resolved_args.push(this.resolve_type_specifier(ast_callee.identifier.generic_args.at(cast<u64>(gi)).some, scope));
                            gi = gi + 1;
                        }
                        func_instantiations.push(new FunctionInstantiation(func_name, resolved_args));
                    }
                }
                // Generic method calls: obj.method<T>(args)
                if (ast_callee is Expression.member_access) {
                    if (cast<i64>(ast_callee.member_access.generic_args.size()) > 0) {
                        let func_name: string = ast_callee.member_access.member_name;
                        let resolved_args: mut _utils.List<BoundType> = new _utils.List<BoundType>();
                        let gi: mut i64 = 0;
                        while (gi < cast<i64>(ast_callee.member_access.generic_args.size())) {
                            resolved_args.push(this.resolve_type_specifier(ast_callee.member_access.generic_args.at(cast<u64>(gi)).some, scope));
                            gi = gi + 1;
                        }
                        func_instantiations.push(new FunctionInstantiation(func_name, resolved_args));
                    }
                }
                this.collect_func_inst_from_expr(fc.callee.some, scope, func_instantiations);
            }
            let ai: mut i64 = 0;
            while (ai < cast<i64>(fc.arguments.size())) {
                this.collect_func_inst_from_expr(fc.arguments.at(cast<u64>(ai)).some, scope, func_instantiations);
                ai = ai + 1;
            }
        }
        if (expr is Expression.code_block) {
            let blk: CodeBlockExpression = expr.code_block;
            let si: mut i64 = 0;
            while (si < cast<i64>(blk.statements.size())) {
                let stmt: Statement = blk.statements.at(cast<u64>(si)).some;
                if (stmt is Statement.let_decl) {
                    if (stmt.let_decl.initializer.is_some()) {
                        this.collect_func_inst_from_expr(stmt.let_decl.initializer.some, scope, func_instantiations);
                    }
                }
                if (stmt is Statement.expression) {
                    if (stmt.expression.expression.is_some()) {
                        this.collect_func_inst_from_expr(stmt.expression.expression.some, scope, func_instantiations);
                    }
                }
                si = si + 1;
            }
        }
        if (expr is Expression.cast_expr) {
            if (expr.cast_expr.inner.is_some()) {
                this.collect_func_inst_from_expr(expr.cast_expr.inner.some, scope, func_instantiations);
            }
        }
        if (expr is Expression.member_access) {
            if (expr.member_access.base_expr.is_some()) {
                this.collect_func_inst_from_expr(expr.member_access.base_expr.some, scope, func_instantiations);
            }
        }
        if (expr is Expression.if_expr) {
            if (expr.if_expr.condition.is_some()) {
                this.collect_func_inst_from_expr(expr.if_expr.condition.some, scope, func_instantiations);
            }
            if (expr.if_expr.then_block.is_some()) {
                this.collect_func_inst_from_expr(expr.if_expr.then_block.some, scope, func_instantiations);
            }
            if (expr.if_expr.else_block.is_some()) {
                this.collect_func_inst_from_expr(expr.if_expr.else_block.some, scope, func_instantiations);
            }
        }
        if (expr is Expression.binary) {
            let bin: BinaryExpression = expr.binary;
            let oi: mut i64 = 0;
            while (oi < cast<i64>(bin.operands.size())) {
                this.collect_func_inst_from_expr(bin.operands.at(cast<u64>(oi)).some, scope, func_instantiations);
                oi = oi + 1;
            }
        }
        if (expr is Expression.unary) {
            if (expr.unary.operand.is_some()) {
                this.collect_func_inst_from_expr(expr.unary.operand.some, scope, func_instantiations);
            }
        }
        if (expr is Expression.new_expr) {
            let ne: NewExpression = expr.new_expr;
            let ai: mut i64 = 0;
            while (ai < cast<i64>(ne.arguments.size())) {
                this.collect_func_inst_from_expr(ne.arguments.at(cast<u64>(ai)).some, scope, func_instantiations);
                ai = ai + 1;
            }
        }
    }

    fun find_bound_function_def(this, defs: _utils.List<BoundDefinition>, name: string) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter find_bound_function_def");
        let i: mut i64 = 0;
        while (i < cast<i64>(defs.size())) {
            let def: BoundDefinition = defs.at(cast<u64>(i)).some;
            if (def is BoundDefinition.function_def) {
                if (def.function_def.name == name) {
                    return new Option<BoundDefinition>.some(def);
                }
            }
            if (def is BoundDefinition.namespace_def) {
                let found: Option<BoundDefinition> = this.find_bound_function_def(def.namespace_def.children, name);
                if (found.is_some()) { return found; }
            }
            if (def is BoundDefinition.class_def) {
                let found: Option<BoundDefinition> = this.find_bound_function_def(def.class_def.methods, name);
                if (found.is_some()) { return found; }
            }
            i = i + 1;
        }
        return new Option<BoundDefinition>.none();
    }

    fun specialize_function_def(mut this, tmpl: BoundFunctionDefinition, type_args: _utils.List<BoundType>, mangled_name: string, parent_scope: mut BoundScope, class_scope: Option<BoundScope>) -> Option<BoundDefinition> {
        _utils.trace_enter("Enter specialize_function_def");
        let ast_def: Option<Definition> = this.find_ast_def_by_name(this.ast_definitions, tmpl.name);
        if (ast_def.is_none()) { return new Option<BoundDefinition>.none(); }
        if (!(ast_def.some is Definition.function_def)) { return new Option<BoundDefinition>.none(); }

        let ast_func: FunctionDefinition = ast_def.some.function_def;
        // Build the full_name:
        // - For methods in specialized generic classes, use the class_scope's full_name
        //   e.g. <global>.Foo__i32.foo__i64 (not <global>.Foo.foo__i64)
        // - For other methods, use the template's full_name with name replaced
        //   e.g. <global>.Foo.identity -> <global>.Foo.identity__string
        let full_name: string = this.build_specialized_full_name(tmpl, mangled_name, class_scope);
        let result: mut BoundFunctionDefinition = new BoundFunctionDefinition(mangled_name, full_name, ast_func.is_extern, ast_func.is_pure, ast_func.is_new, ast_func.is_extern);

        if (!ast_func.is_extern && ast_func.body.is_some()) {
            // Use class_scope as parent if available (for methods in specialized generic classes)
            // so that class type params (e.g., T=i32) are visible in the method body
            if (class_scope.is_some()) {
                let func_scope: mut BoundScope = new BoundScope(new ScopeKind.FunctionScope(), mangled_name, full_name + ".<body>", new Option<BoundScope>.some(class_scope.some));
                let pi: mut i64 = 0;
                while (pi < cast<i64>(tmpl.generic_params.size()) && pi < cast<i64>(type_args.size())) {
                    let param_name: string = tmpl.generic_params.at(cast<u64>(pi)).some;
                    let arg_type: BoundType = type_args.at(cast<u64>(pi)).some;
                    let param_sym: mut BoundTypeSymbol = new BoundTypeSymbol(param_name, full_name + "." + param_name);
                    param_sym.bound_type = arg_type.with_mutability(arg_type.mutability);
                    func_scope.add_symbol(new BoundSymbol.type_sym(param_sym));
                    pi = pi + 1;
                }
                result.scope = new Option<BoundScope>.some(func_scope);
            } else {
                let func_scope: mut BoundScope = new BoundScope(new ScopeKind.FunctionScope(), mangled_name, full_name + ".<body>", new Option<BoundScope>.some(parent_scope));
                let pi: mut i64 = 0;
                while (pi < cast<i64>(tmpl.generic_params.size()) && pi < cast<i64>(type_args.size())) {
                    let param_name: string = tmpl.generic_params.at(cast<u64>(pi)).some;
                    let arg_type: BoundType = type_args.at(cast<u64>(pi)).some;
                    let param_sym: mut BoundTypeSymbol = new BoundTypeSymbol(param_name, full_name + "." + param_name);
                    param_sym.bound_type = arg_type.with_mutability(arg_type.mutability);
                    func_scope.add_symbol(new BoundSymbol.type_sym(param_sym));
                    pi = pi + 1;
                }
                result.scope = new Option<BoundScope>.some(func_scope);
            }
        }

        let sym: mut BoundFunctionSymbol = new BoundFunctionSymbol(mangled_name, full_name);
        sym.is_extern = ast_func.is_extern;
        sym.is_static = result.is_static;
        sym.is_pure = ast_func.is_pure;
        sym.is_new = ast_func.is_new;
        result.symbol = new Option<BoundFunctionSymbol>.some(sym);
        // add_symbol would overwrite full_name, so we set enclosing_scope manually
        // and push directly to preserve the correct full_name
        sym.enclosing_scope = new Option<BoundScope>.some(parent_scope);
        parent_scope.symbols.push(new BoundSymbol.function_sym(sym));

        return new Option<BoundDefinition>.some(new BoundDefinition.function_def(result));
    }

    // Find the specialized class scope for a method, if its parent class has been specialized.
    // This is needed so that class type params (e.g., T=i32) are visible in method specializations.
    fun find_specialized_class_scope(this, defs: _utils.List<BoundDefinition>, method_name: string) -> Option<BoundScope> {
        _utils.trace_enter("Enter find_specialized_class_scope");
        let orig_name: string = this.extract_template_name(method_name);
        // Find the template class that owns this method
        let i: mut i64 = 0;
        while (i < cast<i64>(defs.size())) {
            let def: BoundDefinition = defs.at(cast<u64>(i)).some;
            if (def is BoundDefinition.class_def) {
                let cls: BoundClassDefinition = def.class_def;
                let mi: mut i64 = 0;
                while (mi < cast<i64>(cls.methods.size())) {
                    let md: BoundDefinition = cls.methods.at(cast<u64>(mi)).some;
                    if (md is BoundDefinition.function_def) {
                        if (md.function_def.name == orig_name) {
                            if (cls.is_generic_template) {
                                let spec_scope: Option<BoundScope> = this.find_class_specialization_scope(defs, cls.name);
                                if (spec_scope.is_some()) {
                                    return spec_scope;
                                }
                            }
                        }
                    }
                    mi = mi + 1;
                }
            }
            i = i + 1;
        }
        return new Option<BoundScope>.none();
    }

    fun find_class_specialization_scope(this, defs: _utils.List<BoundDefinition>, template_name: string) -> Option<BoundScope> {
        _utils.trace_enter("Enter find_class_specialization_scope");
        let i: mut i64 = 0;
        while (i < cast<i64>(defs.size())) {
            let def: BoundDefinition = defs.at(cast<u64>(i)).some;
            if (def is BoundDefinition.class_def) {
                let cls: BoundClassDefinition = def.class_def;
                if (!cls.is_generic_template && cls.scope.is_some()) {
                    // Check if this class name starts with template_name + "__"
                    if (string_find(cls.name, template_name + "__") == 0) {
                        return cls.scope;
                    }
                }
            }
            i = i + 1;
        }
        return new Option<BoundScope>.none();
    }

    fun find_method_class_scope(this, existing_defs: _utils.List<BoundDefinition>, new_defs: _utils.List<BoundDefinition>, method_name: string) -> Option<BoundScope> {
        _utils.trace_enter("Enter find_method_class_scope");
        let orig_name: string = this.extract_template_name(method_name);
        // Search existing defs
        let result: Option<BoundScope> = this.find_specialized_class_scope(existing_defs, method_name);
        if (result.is_some()) {
            return result;
        }
        // Search new (current batch) defs
        let mi: mut i64 = 0;
        while (mi < cast<i64>(new_defs.size())) {
            let sd: BoundDefinition = new_defs.at(cast<u64>(mi)).some;
            if (sd is BoundDefinition.class_def) {
                let sd_cls: BoundClassDefinition = sd.class_def;
                if (sd_cls.scope.is_some()) {
                    let sdi: mut i64 = 0;
                    while (sdi < cast<i64>(sd_cls.methods.size())) {
                        let smd: BoundDefinition = sd_cls.methods.at(cast<u64>(sdi)).some;
                        if (smd is BoundDefinition.function_def) {
                            if (smd.function_def.name == orig_name) {
                                return sd_cls.scope;
                            }
                        }
                        sdi = sdi + 1;
                    }
                }
            }
            mi = mi + 1;
        }
        return new Option<BoundScope>.none();
    }

    fun build_specialized_full_name(this, tmpl: BoundFunctionDefinition, mangled_name: string, class_scope: Option<BoundScope>) -> string {
        _utils.trace_enter("Enter build_specialized_full_name");
        if (class_scope.is_some()) {
            return class_scope.some.full_name + "." + mangled_name;
        }
        return this.replace_name_in_full_name(tmpl.full_name, tmpl.name, mangled_name);
    }

    // Find the parent class for a method by extracting the class name from the function's full_name
    // e.g. full_name="<global>.Foo__i32.foo__i64" -> parent class is "Foo__i32"
    fun find_parent_class_for_method(this, defs: _utils.List<BoundDefinition>, new_defs: _utils.List<BoundDefinition>, func_full_name: string) -> Option<BoundClassDefinition> {
        _utils.trace_enter("Enter find_parent_class_for_method");
        // Extract class name from full_name: strip <global>. prefix and last .method part
        let prefix: string = "<global>.";
        let prefix_len: i64 = string_length(prefix);
        let full_len: i64 = string_length(func_full_name);
        let after_prefix: mut string = func_full_name;
        if (full_len > prefix_len) {
            let matches: mut bool = true;
            let ci: mut i64 = 0;
            while (ci < prefix_len) {
                if (string_char_at(func_full_name, ci) != string_char_at(prefix, ci)) {
                    matches = false;
                }
                ci = ci + 1;
            }
            if (matches) {
                after_prefix = string_substring(func_full_name, prefix_len, full_len - prefix_len);
            }
        }
        // Find the last dot to separate class name from method name
        let last_dot: mut i64 = -1;
        let search_pos: mut i64 = 0;
        let after_len: i64 = string_length(after_prefix);
        while (search_pos < after_len) {
            let found: i64 = string_find_from(after_prefix, ".", search_pos);
            if (found < 0) {
                search_pos = after_len;
            } else {
                last_dot = found;
                search_pos = found + 1;
            }
        }
        if (last_dot >= 0) {
            let class_name: string = string_substring(after_prefix, 0, last_dot);
            // Search in existing defs
            let i: mut i64 = 0;
            while (i < cast<i64>(defs.size())) {
                let def: BoundDefinition = defs.at(cast<u64>(i)).some;
                if (def is BoundDefinition.class_def) {
                    if (def.class_def.name == class_name) {
                        return new Option<BoundClassDefinition>.some(def.class_def);
                    }
                }
                i = i + 1;
            }
            // Also search in new_defs (current batch)
            let j: mut i64 = 0;
            while (j < cast<i64>(new_defs.size())) {
                let def: BoundDefinition = new_defs.at(cast<u64>(j)).some;
                if (def is BoundDefinition.class_def) {
                    if (def.class_def.name == class_name) {
                        return new Option<BoundClassDefinition>.some(def.class_def);
                    }
                }
                j = j + 1;
            }
        }
        return new Option<BoundClassDefinition>.none();
    }

    // Fix the 'this' parameter type for a specialized class method
    fun fix_this_param_type(this, func: mut BoundFunctionDefinition, cls: BoundClassDefinition) {
        _utils.trace_enter("Enter fix_this_param_type");
        let pi: mut i64 = 0;
        while (pi < cast<i64>(func.parameters.size())) {
            let bp: mut BoundFunctionParameter = func.parameters.at(cast<u64>(pi)).some;
            if (bp.is_this) {
                if (func.is_new) {
                    bp.bound_type = cls.bound_type.with_mutability(new Mutability.Mutable());
                } else {
                    bp.bound_type = cls.bound_type;
                }
                // Also update the function type on the symbol
                if (func.symbol.is_some()) {
                    let sym: mut BoundFunctionSymbol = func.symbol.some;
                    let param_types: mut _utils.List<BoundType> = new _utils.List<BoundType>();
                    let pj: mut i64 = 0;
                    while (pj < cast<i64>(func.parameters.size())) {
                        param_types.push(func.parameters.at(cast<u64>(pj)).some.bound_type);
                        pj = pj + 1;
                    }
                    sym.bound_type = this.type_registry.make_function_type(func.return_type, param_types, false);
                    func.symbol = new Option<BoundFunctionSymbol>.some(sym);
                }
                return;
            }
            pi = pi + 1;
        }
    }
}

}
