namespace emperor {

enum ScopeKind { GlobalScope; NamespaceScope; ClassScope; EnumScope; InterfaceScope; FunctionScope; BlockScope; InitialRoutineScope; ImplScope; }

class BoundScope {
    kind: ScopeKind = new ScopeKind.GlobalScope();
    name: string = "";
    full_name: string = "";
    parent: Option<BoundScope> = new Option<BoundScope>.none();
    children: mut _utils.List<BoundScope> = new _utils.List<BoundScope>();
    symbols: mut _utils.List<BoundSymbol> = new _utils.List<BoundSymbol>();
    imported_namespaces: mut _utils.List<string> = new _utils.List<string>();
    init_routine_count: mut i64 = 0;
    // P2 try-bind scoping: a "region" bounds pattern variables to the nearest
    // paren / &&-chain. is_condition_region additionally makes a whole if/while
    // condition the region so &&-chain bindings promote into the then-branch.
    is_region: mut bool = false;
    is_condition_region: mut bool = false;

    fun new(mut this, kind: mut ScopeKind, name: string, full_name: string, parent: mut Option<BoundScope>) {

        this.kind = kind;
        this.name = name;
        this.full_name = full_name;
        this.parent = parent;
    }

    fun lookup_symbol_local(this, name: string) -> Option<BoundSymbol> {
        _utils.trace_enter("Enter lookup_symbol_local");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.symbols.size())) {
            if (this.symbols.at(cast<u64>(i)).some.get_name() == name) {
                return new Option<BoundSymbol>.some(this.symbols.at(cast<u64>(i)).some);
            }
            i = i + 1;
        }
        return new Option<BoundSymbol>.none();
    }

    fun lookup_symbol(this, name: string) -> Option<BoundSymbol> {
        _utils.trace_enter("Enter lookup_symbol");
        let local: Option<BoundSymbol> = this.lookup_symbol_local(name);
        if (local.is_some()) {
            return local;
        }
        // BabyPenguin lookup order: own scope -> full parent chain (symbols
        // only) -> imports (own, then ancestors') -> __builtin (default using).
        if (this.parent.is_some()) {
            let chained: Option<BoundSymbol> = this.parent.some.lookup_symbol_chain(name);
            if (chained.is_some()) {
                return chained;
            }
        }
        return this.lookup_imported_symbol(name);
    }

    // Parent-chain symbol lookup without imports (the recursive half of
    // lookup_symbol).
    fun lookup_symbol_chain(this, name: string) -> Option<BoundSymbol> {
        _utils.trace_enter("Enter lookup_symbol_chain");
        let local: Option<BoundSymbol> = this.lookup_symbol_local(name);
        if (local.is_some()) {
            return local;
        }
        if (this.parent.is_some()) {
            return this.parent.some.lookup_symbol_chain(name);
        }
        return new Option<BoundSymbol>.none();
    }

    fun lookup_type_in_scope_local(this, name: string) -> Option<BoundSymbol> {
        _utils.trace_enter("Enter lookup_type_in_scope_local");
        let i: mut u64 = 0;
        while (i < this.symbols.size()) {
            let sym: BoundSymbol = this.symbols.at(cast<u64>(i)).some;
            if (sym is BoundSymbol.type_sym && sym.get_name() == name) {
                return new Option<BoundSymbol>.some(sym);
            }
            i = i + 1;
        }
        return new Option<BoundSymbol>.none();
    }

    fun lookup_type_in_scope(this, name: string) -> Option<BoundSymbol> {
        _utils.trace_enter("Enter lookup_type_in_scope");
        let i: mut u64 = 0;
        while (i < this.symbols.size()) {
            let sym: BoundSymbol = this.symbols.at(cast<u64>(i)).some;
            if (sym is BoundSymbol.type_sym && sym.get_name() == name) {
                return new Option<BoundSymbol>.some(sym);
            }
            i = i + 1;
        }
        if (this.parent.is_some()) {
            let chained: Option<BoundSymbol> = this.parent.some.lookup_type_in_scope_chain(name);
            if (chained.is_some()) {
                return chained;
            }
        }
        return this.lookup_imported_type(name);
    }

    // Parent-chain type lookup without imports (the recursive half of
    // lookup_type_in_scope).
    fun lookup_type_in_scope_chain(this, name: string) -> Option<BoundSymbol> {
        _utils.trace_enter("Enter lookup_type_in_scope_chain");
        let i: mut u64 = 0;
        while (i < this.symbols.size()) {
            let sym: BoundSymbol = this.symbols.at(cast<u64>(i)).some;
            if (sym is BoundSymbol.type_sym && sym.get_name() == name) {
                return new Option<BoundSymbol>.some(sym);
            }
            i = i + 1;
        }
        if (this.parent.is_some()) {
            return this.parent.some.lookup_type_in_scope_chain(name);
        }
        return new Option<BoundSymbol>.none();
    }

    fun lookup_namespace(this, name: string) -> Option<BoundScope> {
        _utils.trace_enter("Enter lookup_namespace");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.children.size())) {
            let child: BoundScope = this.children.at(cast<u64>(i)).some;
            if (child.name == name && child.kind is ScopeKind.NamespaceScope) {
                return new Option<BoundScope>.some(child);
            }
            i = i + 1;
        }
        return new Option<BoundScope>.none();
    }

    fun resolve_qualified(this, parts: _utils.List<string>) -> Option<BoundSymbol> {
        _utils.trace_enter("Enter resolve_qualified");
        if (cast<i64>(parts.size()) == 0) { return new Option<BoundSymbol>.none(); }
        if (cast<i64>(parts.size()) == 1) {
            return this.lookup_symbol(parts.at(cast<u64>(0)).some);
        }
        let first: string = parts.at(cast<u64>(0)).some;
        let ns: Option<BoundScope> = this.lookup_namespace(first);
        if (ns.is_some()) {
            let rest: mut _utils.List<string> = new _utils.List<string>();
            let i: mut i64 = 1;
            while (i < cast<i64>(parts.size())) {
                rest.push(parts.at(cast<u64>(i)).some);
                i = i + 1;
            }
            return ns.some.resolve_qualified(rest);
        }
        let type_sym: Option<BoundSymbol> = this.lookup_type_in_scope(first);
        if (type_sym.is_some() && cast<i64>(parts.size()) == 1) {
            return type_sym;
        }
        if (this.parent.is_some()) {
            return this.parent.some.resolve_qualified(parts);
        }
        return new Option<BoundSymbol>.none();
    }

    // Imports step of lookup (mirrors BabyPenguin GetImportedNamespaces): walk
    // from this scope up through the ancestors, consulting each scope's
    // imported_namespaces (own imports first, then ancestors'), then always
    // try __builtin (the default using). Imports are NOT transitive — only the
    // direct symbols of an imported namespace are visible.
    fun lookup_imported_symbol(this, name: string) -> Option<BoundSymbol> {
        _utils.trace_enter("Enter lookup_imported_symbol");
        let s: mut Option<BoundScope> = new Option<BoundScope>.some(this);
        while (s.is_some()) {
            let sc: BoundScope = s.some;
            let i: mut i64 = 0;
            while (i < cast<i64>(sc.imported_namespaces.size())) {
                let ns_name: string = sc.imported_namespaces.at(cast<u64>(i)).some;
                let ns_scope: Option<BoundScope> = this.resolve_imported_namespace(ns_name);
                if (ns_scope.is_some()) {
                    let found: Option<BoundSymbol> = ns_scope.some.lookup_symbol_local(name);
                    if (found.is_some()) { return found; }
                }
                i = i + 1;
            }
            s = sc.parent;
        }
        let builtin: Option<BoundScope> = this.resolve_imported_namespace("__builtin");
        if (builtin.is_some()) {
            return builtin.some.lookup_symbol_local(name);
        }
        return new Option<BoundSymbol>.none();
    }

    // Type variant of lookup_imported_symbol (for unqualified type names).
    fun lookup_imported_type(this, name: string) -> Option<BoundSymbol> {
        _utils.trace_enter("Enter lookup_imported_type");
        let s: mut Option<BoundScope> = new Option<BoundScope>.some(this);
        while (s.is_some()) {
            let sc: BoundScope = s.some;
            let i: mut i64 = 0;
            while (i < cast<i64>(sc.imported_namespaces.size())) {
                let ns_name: string = sc.imported_namespaces.at(cast<u64>(i)).some;
                let ns_scope: Option<BoundScope> = this.resolve_imported_namespace(ns_name);
                if (ns_scope.is_some()) {
                    let found: Option<BoundSymbol> = ns_scope.some.lookup_type_in_scope_local(name);
                    if (found.is_some()) { return found; }
                }
                i = i + 1;
            }
            s = sc.parent;
        }
        let builtin: Option<BoundScope> = this.resolve_imported_namespace("__builtin");
        if (builtin.is_some()) {
            return builtin.some.lookup_type_in_scope_local(name);
        }
        return new Option<BoundSymbol>.none();
    }

    // Resolve an imported namespace NAME to its scope: walk up from this scope
    // looking for a direct child namespace with that name. Unresolvable names
    // are skipped silently.
    fun resolve_imported_namespace(this, ns_name: string) -> Option<BoundScope> {
        _utils.trace_enter("Enter resolve_imported_namespace");
        let s: mut Option<BoundScope> = new Option<BoundScope>.some(this);
        while (s.is_some()) {
            let sc: BoundScope = s.some;
            let found: Option<BoundScope> = sc.lookup_namespace(ns_name);
            if (found.is_some()) { return found; }
            s = sc.parent;
        }
        return new Option<BoundScope>.none();
    }

    // Old global-root child-namespace scan, kept for internal SemanticModel
    // sites that need "does this name exist as a real symbol/type anywhere"
    // semantics (meta placeholder detection, meta template lookup). NOT for
    // user-code resolution — it defeats file-namespace isolation.
    fun lookup_symbol_anywhere(this, name: string) -> Option<BoundSymbol> {
        _utils.trace_enter("Enter lookup_symbol_anywhere");
        let local: Option<BoundSymbol> = this.lookup_symbol_local(name);
        if (local.is_some()) {
            return local;
        }
        if (this.parent.is_some()) {
            return this.parent.some.lookup_symbol_anywhere(name);
        }
        let ci: mut i64 = 0;
        while (ci < cast<i64>(this.children.size())) {
            let child: BoundScope = this.children.at(cast<u64>(ci)).some;
            let result: Option<BoundSymbol> = child.lookup_symbol_local(name);
            if (result.is_some()) {
                return result;
            }
            ci = ci + 1;
        }
        return new Option<BoundSymbol>.none();
    }

    fun lookup_type_anywhere(this, name: string) -> Option<BoundSymbol> {
        _utils.trace_enter("Enter lookup_type_anywhere");
        let i: mut u64 = 0;
        while (i < this.symbols.size()) {
            let sym: BoundSymbol = this.symbols.at(cast<u64>(i)).some;
            if (sym is BoundSymbol.type_sym && sym.get_name() == name) {
                return new Option<BoundSymbol>.some(sym);
            }
            i = i + 1;
        }
        if (this.parent.is_some()) {
            return this.parent.some.lookup_type_anywhere(name);
        }
        let ci: mut i64 = 0;
        while (ci < cast<i64>(this.children.size())) {
            let child: BoundScope = this.children.at(cast<u64>(ci)).some;
            let result: Option<BoundSymbol> = child.lookup_type_in_scope_local(name);
            if (result.is_some()) {
                return result;
            }
            ci = ci + 1;
        }
        return new Option<BoundSymbol>.none();
    }

    fun add_or_merge_namespace(mut this, name: string) -> BoundScope {
        _utils.trace_enter("Enter add_or_merge_namespace");
        let existing: Option<BoundScope> = this.lookup_namespace(name);
        if (existing.is_some()) { return existing.some; }
        let ns: BoundScope = new BoundScope(new ScopeKind.NamespaceScope(), name, this.full_name + "." + name, new Option<BoundScope>.some(this));
        this.children.push(ns);
        return this.children.at(cast<u64>(cast<i64>(this.children.size()) - 1)).some;
    }

    fun add_symbol(mut this, symbol: BoundSymbol) {
        _utils.trace_enter("Enter add_symbol");
        if (symbol is BoundSymbol.variable) {
            symbol.variable.enclosing_scope = new Option<BoundScope>.some(this);
            symbol.variable.full_name = this.full_name + "." + symbol.variable.name;
        }
        if (symbol is BoundSymbol.function_sym) {
            symbol.function_sym.enclosing_scope = new Option<BoundScope>.some(this);
            symbol.function_sym.full_name = this.full_name + "." + symbol.function_sym.name;
        }
        if (symbol is BoundSymbol.type_sym) {
            symbol.type_sym.enclosing_scope = new Option<BoundScope>.some(this);
            symbol.type_sym.full_name = this.full_name + "." + symbol.type_sym.name;
        }
        if (symbol is BoundSymbol.enum_member) {
            symbol.enum_member.enclosing_scope = new Option<BoundScope>.some(this);
            symbol.enum_member.full_name = this.full_name + "." + symbol.enum_member.name;
        }
        if (symbol is BoundSymbol.namespace_sym) {
            symbol.namespace_sym.enclosing_scope = new Option<BoundScope>.some(this);
            symbol.namespace_sym.full_name = this.full_name + "." + symbol.namespace_sym.name;
        }
        this.symbols.push(symbol);
    }

    fun add_child(mut this, child: mut BoundScope) {
        _utils.trace_enter("Enter add_child");
        child.parent = new Option<BoundScope>.some(this);
        child.full_name = this.full_name + "." + child.name;
        this.children.push(child);
    }

    fun find_child_by_name(this, name: string) -> Option<BoundScope> {
        _utils.trace_enter("Enter find_child_by_name");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.children.size())) {
            if (this.children.at(cast<u64>(i)).some.name == name) {
                return new Option<BoundScope>.some(this.children.at(cast<u64>(i)).some);
            }
            i = i + 1;
        }
        return new Option<BoundScope>.none();
    }
}

}
