// Pass 9 of the SemanticModel pipeline, extracted from SemanticModel.penguin.
// Responsibilities: control-flow validation — non-void functions must return on
// all paths (return-path completeness), break/continue only inside loops, and
// return-value type checking against the declared return type.
namespace emperor {

class ValidateControlFlowPass {
    // 本 pass 专属状态（原 SemanticModel._current_validating_func 迁入）
    _current_validating_func: mut string = "";
    // 共享编译状态。Back-reference to the owning SemanticModel, wrapped in Option
    // to break the class-type cycle (SemanticModel -> ValidateControlFlowPass ->
    // SemanticModel) that otherwise overflows BabyPenguin's eager runtime-object
    // construction (MetaEngine.owner_model precedent). Set by the ctor; the dummy
    // `.none()` default only satisfies field-init rules (cannot reference `this`).
    model: mut Option<SemanticModel> = new Option<SemanticModel>.none();

    fun new(mut this, model: mut SemanticModel) {
        this.model = new Option<SemanticModel>.some(model);
    }

    // --- Pass 7: Validate Control Flow ---

    // 唯一入口：原 pass_validate_control_flow
    fun run(mut this, result: BoundCompilationUnit) {
        _utils.trace_enter("Enter pass_validate_control_flow");
        for (let def in result.definitions) {
            this.validate_control_flow_for_def(def);
        }
    }

    fun validate_control_flow_for_def(mut this, def: BoundDefinition) {
        _utils.trace_enter("Enter validate_control_flow_for_def");
        if (this.model.some.already_processed(def)) { return; }
        if (def is BoundDefinition.function_def) {
            let func: BoundFunctionDefinition = def.function_def;
            if (func.body.is_some() && func.symbol.is_some()) {
                let sym: BoundFunctionSymbol = func.symbol.some;
                this._current_validating_func = func.name;
                this.validate_expr_control_flow(func.body.some, sym.return_type, 0);
                if (!this.model.some.type_registry.is_void(sym.return_type)) {
                    if (!this.expr_always_returns(func.body.some)) {
                        this.model.some.report_error(new ErrorCode.E_RETURN_MISSING(), "Non-void function '" + func.name + "' must return a value on all paths", sym.location);
                    }
                }
            }
        }
        if (def is BoundDefinition.initial_routine) {
            let init: BoundInitialRoutineDefinition = def.initial_routine;
            if (let ib := init.body.some) {
                this.validate_expr_control_flow(ib, this.model.some.type_registry.void_type, 0);
            }
        }
        if (def is BoundDefinition.class_def) {
            let cls: BoundClassDefinition = def.class_def;
            for (let md in cls.methods) {
                this.validate_control_flow_for_def(md);
            }
        }
        if (def is BoundDefinition.namespace_def) {
            let ns: BoundNamespaceDefinition = def.namespace_def;
            for (let child in ns.children) {
                this.validate_control_flow_for_def(child);
            }
        }
        BoundDefinition.set_pass_index(def, this.model.some.current_pass_index);
    }

    fun validate_expr_control_flow(mut this, expr: BoundExpression, ret_type: BoundType, loop_depth: i64) {
        _utils.trace_enter("Enter validate_expr_control_flow");
        if (expr is BoundExpression.code_block) {
            let cb: BoundCodeBlockExpression = expr.code_block;
            for (let stmt in cb.statements) {
                this.validate_stmt_control_flow(stmt, ret_type, loop_depth);
            }
        }
        if (expr is BoundExpression.if_expr) {
            let if_e: BoundIfExpression = expr.if_expr;
            if (let cnd := if_e.condition.some) { this.validate_expr_control_flow(cnd, ret_type, loop_depth); }
            if (let tb := if_e.then_block.some) { this.validate_expr_control_flow(tb, ret_type, loop_depth); }
            if (let eb := if_e.else_block.some) { this.validate_expr_control_flow(eb, ret_type, loop_depth); }
        }
        if (expr is BoundExpression.while_expr) {
            let w: BoundWhileExpression = expr.while_expr;
            if (let wc := w.condition.some) { this.validate_expr_control_flow(wc, ret_type, loop_depth); }
            if (let wb := w.body.some) { this.validate_expr_control_flow(wb, ret_type, loop_depth + 1); }
        }
        if (expr is BoundExpression.binary) {
            let bin: BoundBinaryExpression = expr.binary;
            for (let op in bin.operands) {
                this.validate_expr_control_flow(op, ret_type, loop_depth);
            }
        }
        if (expr is BoundExpression.unary) {
            let un: BoundUnaryExpression = expr.unary;
            if (let uo := un.operand.some) { this.validate_expr_control_flow(uo, ret_type, loop_depth); }
        }
        if (expr is BoundExpression.function_call) {
            let fc: BoundFunctionCallExpression = expr.function_call;
            if (let cal := fc.callee.some) { this.validate_expr_control_flow(cal, ret_type, loop_depth); }
            for (let arg in fc.arguments) {
                this.validate_expr_control_flow(arg, ret_type, loop_depth);
            }
        }
        if (expr is BoundExpression.member_access) {
            let ma: BoundMemberAccessExpression = expr.member_access;
            if (let be := ma.base_expr.some) { this.validate_expr_control_flow(be, ret_type, loop_depth); }
        }
        if (expr is BoundExpression.cast_expr) {
            let c: BoundCastExpression = expr.cast_expr;
            if (let inner := c.inner.some) { this.validate_expr_control_flow(inner, ret_type, loop_depth); }
        }
        if (expr is BoundExpression.new_expr) {
            let ne: BoundNewExpression = expr.new_expr;
            for (let narg in ne.arguments) {
                this.validate_expr_control_flow(narg, ret_type, loop_depth);
            }
        }
        if (expr is BoundExpression.enum_variant) {
            let ev: BoundEnumVariantExpression = expr.enum_variant;
            if (let pl := ev.payload.some) {
                this.validate_expr_control_flow(pl, ret_type, loop_depth);
            }
        }
    }

    fun validate_stmt_control_flow(mut this, stmt: BoundStatement, ret_type: BoundType, loop_depth: i64) {
        _utils.trace_enter("Enter validate_stmt_control_flow");
        if (stmt is BoundStatement.return_stmt) {
            let ret: BoundReturnStatement = stmt.return_stmt;
            if (let rv := ret.value.some) {
                this.validate_expr_control_flow(rv, ret_type, loop_depth);
                let value_type: BoundType = rv.get_bound_type();
                // Integer literals coerce to any integer return type (BabyPenguin
                // allows `return 5` for a u8 function; the literal defaults to i64).
                // Guard the `.literal` access via an if-expression: `&&` does not
                // short-circuit in PenguinLang, so a bare `is && .literal` would
                // cast non-literal returns and crash.
                let is_int_lit: bool = if (rv is BoundExpression.literal) {
                    rv.literal.literal_kind is LiteralKind.IntegerLiteral
                } else {
                    false
                };
                let int_literal_coercion: bool = is_int_lit && this.model.some.type_registry.is_integer(ret_type);
                if (!this.model.some.type_registry.is_void(ret_type) && !this.model.some.type_registry.can_implicitly_cast(value_type, ret_type) && !int_literal_coercion) {
                    this.model.some.report_error(new ErrorCode.E_RETURN_TYPE_MISMATCH(), "Return type mismatch: expected " + ret_type.display_name() + " but got " + value_type.display_name() + " in " + this._current_validating_func, ret.location);
                }
            }
        }
        if (stmt is BoundStatement.expression) {
            if (let es := stmt.expression.expression.some) {
                this.validate_expr_control_flow(es, ret_type, loop_depth);
            }
        }
        if (stmt is BoundStatement.block) {
            let block: BoundBlockStatement = stmt.block;
            for (let s in block.statements) {
                this.validate_stmt_control_flow(s, ret_type, loop_depth);
            }
        }
        if (stmt is BoundStatement.if_stmt) {
            let if_s: BoundIfStatement = stmt.if_stmt;
            if (let sc := if_s.condition.some) { this.validate_expr_control_flow(sc, ret_type, loop_depth); }
            if (let ts := if_s.then_statement.some) { this.validate_stmt_control_flow(ts, ret_type, loop_depth); }
            if (let els := if_s.else_statement.some) { this.validate_stmt_control_flow(els, ret_type, loop_depth); }
        }
        if (stmt is BoundStatement.while_stmt) {
            let ws: BoundWhileStatement = stmt.while_stmt;
            if (let wsc := ws.condition.some) { this.validate_expr_control_flow(wsc, ret_type, loop_depth); }
            if (let wsb := ws.body.some) { this.validate_stmt_control_flow(wsb, ret_type, loop_depth + 1); }
        }
        if (stmt is BoundStatement.for_stmt) {
            let fs: BoundForStatement = stmt.for_stmt;
            if (let fiter := fs.iterable.some) { this.validate_expr_control_flow(fiter, ret_type, loop_depth); }
            if (let fbody := fs.body.some) { this.validate_stmt_control_flow(fbody, ret_type, loop_depth + 1); }
        }
        if (stmt is BoundStatement.break_stmt) {
            if (loop_depth == 0) {
                this.model.some.report_error(new ErrorCode.E_LOOP_CONTEXT(), "break statement not inside a loop", stmt.break_stmt.location);
            }
        }
        if (stmt is BoundStatement.continue_stmt) {
            if (loop_depth == 0) {
                this.model.some.report_error(new ErrorCode.E_LOOP_CONTEXT(), "continue statement not inside a loop", stmt.continue_stmt.location);
            }
        }
        if (stmt is BoundStatement.assignment) {
            let assign: BoundAssignmentStatement = stmt.assignment;
            if (let tg := assign.target.some) { this.validate_expr_control_flow(tg, ret_type, loop_depth); }
            if (let av := assign.value.some) { this.validate_expr_control_flow(av, ret_type, loop_depth); }
        }
        if (stmt is BoundStatement.let_decl) {
            let let_s: BoundLetDeclarationStatement = stmt.let_decl;
            if (let init := let_s.initializer.some) { this.validate_expr_control_flow(init, ret_type, loop_depth); }
        }
    }

    fun expr_always_returns(this, expr: BoundExpression) -> bool {
        _utils.trace_enter("Enter expr_always_returns");
        if (expr is BoundExpression.code_block) {
            let cb: BoundCodeBlockExpression = expr.code_block;
            if (cast<i64>(cb.statements.size()) == 0) { return false; }
            let last_idx: i64 = cast<i64>(cb.statements.size()) - 1;
            let last: BoundStatement = cb.statements.at(cast<u64>(last_idx)).some;
            return this.stmt_always_returns(last);
        }
        // Handle if/else if/else chains where else_block is itself an if_expr
        if (expr is BoundExpression.if_expr) {
            let if_e: BoundIfExpression = expr.if_expr;
            if (if_e.then_block.is_some() && if_e.else_block.is_some()) {
                return this.expr_always_returns(if_e.then_block.some) && this.expr_always_returns(if_e.else_block.some);
            }
        }
        return false;
    }

    fun stmt_always_returns(this, stmt: BoundStatement) -> bool {
        _utils.trace_enter("Enter stmt_always_returns");
        if (stmt is BoundStatement.return_stmt) { return true; }
        if (stmt is BoundStatement.expression) {
            if (let expr := stmt.expression.expression.some) {
                if (expr is BoundExpression.if_expr) {
                    let if_e: BoundIfExpression = expr.if_expr;
                    if (if_e.then_block.is_some() && if_e.else_block.is_some()) {
                        return this.expr_always_returns(if_e.then_block.some) && this.expr_always_returns(if_e.else_block.some);
                    }
                }
                if (expr is BoundExpression.while_expr) {
                    let w: BoundWhileExpression = expr.while_expr;
                    if (this.is_literal_true(w.condition) && w.body.is_some()) {
                        return this.expr_always_returns(w.body.some);
                    }
                }
            }
        }
        if (stmt is BoundStatement.if_stmt) {
            let if_s: BoundIfStatement = stmt.if_stmt;
            if (if_s.then_statement.is_some() && if_s.else_statement.is_some()) {
                return this.stmt_always_returns(if_s.then_statement.some) && this.stmt_always_returns(if_s.else_statement.some);
            }
        }
        if (stmt is BoundStatement.while_stmt) {
            let ws: BoundWhileStatement = stmt.while_stmt;
            if (this.is_literal_true(ws.condition) && ws.body.is_some()) {
                return this.stmt_always_returns(ws.body.some);
            }
        }
        if (stmt is BoundStatement.block) {
            let block: BoundBlockStatement = stmt.block;
            if (cast<i64>(block.statements.size()) == 0) { return false; }
            let last_idx: i64 = cast<i64>(block.statements.size()) - 1;
            return this.stmt_always_returns(block.statements.at(cast<u64>(last_idx)).some);
        }
        return false;
    }

    fun get_field_mutability(this, ma: BoundMemberAccessExpression) -> Mutability {
        _utils.trace_enter("Enter get_field_mutability");
        if (ma.base_expr.is_some() && ma.member_symbol.is_some()) {
            let ms: BoundSymbol = ma.member_symbol.some;
            if (ms is BoundSymbol.variable && ms.variable.variable_kind is VariableSymbolKind.Field) {
                let base_type: BoundType = ma.base_expr.some.get_bound_type();
                if (let td := base_type.type_definition.some) {
                    if (td is BoundDefinition.class_def) {
                        let cls: BoundClassDefinition = td.class_def;
                        // Delegate the field scan to the shared helper (M9 merge):
                        // the field-lookup loop is identical to
                        // BindExpressionsPass.get_field_mutability_from_class.
                        return this.model.some.bind_expressions_pass.get_field_mutability_from_class(cls, ms.variable.name);
                    }
                }
            }
        }
        return new Mutability.Mutable();
    }

    fun is_literal_true(this, opt: Option<BoundExpression>) -> bool {
        _utils.trace_enter("Enter is_literal_true");
        if (opt.is_none()) { return false; }
        let expr: BoundExpression = opt.some;
        if (expr is BoundExpression.literal) {
            if (expr.literal.literal_kind is LiteralKind.BoolLiteral && expr.literal.value == "true") {
                return true;
            }
        }
        return false;
    }

}

}
