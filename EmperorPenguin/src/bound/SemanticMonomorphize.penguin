// Pass 3 of the SemanticModel pipeline, extracted from SemanticModel.penguin
// (including the physically-split tail block: function specialization). This is
// the generic monomorphization pass — an iterative fixpoint that collects
// class/enum/interface/function instantiation requests from both the bound tree
// and the AST, specializes generic templates (mangled as Foo__i32), runs each
// new def through the catch-up processors, executes #specializing blocks and
// injects their impl fragments. Batch 0.3 split: this file keeps the fixpoint
// driver (run), the shared mangle entry and the verbatim external-call-surface
// forwarders; the machinery moved to the per-concern collaborator modules
// SemanticMonomorphizeSpecialize.penguin (specialization construction),
// SemanticMonomorphizeCollect.penguin (instantiation collection) and
// SemanticMonomorphizeSpecializing.penguin (#specializing injection + mangle
// helpers). Method bodies moved verbatim (zero semantic change).
namespace emperor {

class MonomorphizePass {
    // 共享编译状态（M1 pass 类模式）：.none() 哑默认 + 构造函数 .some(model) 赋值，
    // 破解 SemanticModel <-> 本 pass 的类环。
    model: mut Option<SemanticModel> = new Option<SemanticModel>.none();

    // The compilation unit pass 3's run() is currently fixpointing. On-demand
    // specializations (resolve_field_specialization) must be APPENDED to it so
    // passes 4-9 process them (symbol binding, constructors, vtables, bodies).
    // model.current_unit is only set during pass 8, so it cannot be used here.
    active_result: mut Option<BoundCompilationUnit> = new Option<BoundCompilationUnit>.none();

    // ---- Per-concern collaborator modules (batch 0.3 split) ----
    specialize: mut MonoSpecialize;
    collect: mut MonoCollect;
    specializing: mut MonoSpecializing;
    // Batch 3.2: the B1 adjudication half (type/function request adjudication
    // + the round finalize). See SemanticMonomorphizeAdjudicate.penguin.
    adjudicate: mut MonoAdjudicate;

    // ---- Batch 3.2: the B1 adjudication record ----
    // Every specialized def created through the creation funnels
    // (ensure_specialized_def for class/enum/interface instantiations;
    // ensure_function_specialization_now + the fixpoint's own function
    // adjudication for functions) is recorded here: key = the instance's
    // full mangled name, value = "kind|site" (kind: class|enum|interface|fun;
    // site = which request path adjudicated it — the A4 request-site). This
    // is PURE BOOKKEEPING: no decision consults it — the scope/dedup checks
    // stay authoritative — so compilation behavior is unchanged. The 3.1
    // GlobalIndex instances table joins on it (the reserved request-site
    // column). The record is per-compilation (SemanticModel is created fresh
    // per compile_sources), first-wins like the dedup itself.
    b1_adjudicated: mut _utils.StrMap<string> = new _utils.StrMap<string>();
    // The ambient request-site tag. Every entry path that can trigger a
    // specialization sets this right before its funnel call; the funnels
    // CAPTURE it at entry (innermost entry wins — a cascade records its own
    // reason, not the outer caller's, even when the cascade fires mid-
    // construction and overwrites the ambient). "" = untagged (libmeta
    // pre-specialized instances render an empty site).
    b1_site: mut string = "";

    // ---- P0 (incremental stage timing): fixpoint round statistics. ----
    // Populated ONLY when model.timing_enabled (the session's
    // EMPEROR_INCREMENTAL_TIMING probe); stat_reset() runs at the top of
    // run() then. PURE BOOKKEEPING — no decision reads these; the values
    // only ever surface on a [SessionTiming] stderr line.
    //   stat_round_ms     wall-clock ms of each fixpoint round (incl. the
    //                     final converging round that creates nothing)
    //   stat_round_new    new specializations each round created
    //   stat_collect_ms   cumulative A4 collection time (type + fun sweeps)
    //   stat_adjudicate_ms cumulative B1 adjudication time
    stat_rounds: mut i64 = 0;
    stat_round_ms: mut _utils.List<i64> = new _utils.List<i64>();
    stat_round_new: mut _utils.List<i64> = new _utils.List<i64>();
    stat_collect_ms: mut i64 = 0;
    stat_adjudicate_ms: mut i64 = 0;
    // O1: how many defs the A4 sweeps actually scanned this run (full mode
    // scans every top-level def; incremental mode only the dirty ranges +
    // the uncovered append zone). Surfaced on the [SessionTiming] line so a
    // perf run can see the incremental path engaged.
    stat_inc_scanned: mut i64 = 0;

    // ---- O1 (roadmap: per-file A4 collector / fixpoint incrementality) ----
    // INCREMENTAL COLLECTION MODE. Configured by IncrementalSession.
    // recompute_fast right before run() and reset right after; the default
    // (inc_active = false) is the historical full-sweep behavior — the plain
    // CLI compile, the slow lane and every other run() caller are untouched.
    //
    //   Semantics (the equivalence argument, see optimize3-progress.md):
    //   a clean file's direct request set cannot change across a fast-lane
    //   round (the AST-signature fingerprint gate froze the symbolic surface
    //   and its expressions), and an already-scanned append-zone def
    //   (specialization / synthesized class) has its request face frozen at
    //   creation (ast_source + scope never mutate afterwards). Re-scanning
    //   either is a dedup no-op in B1, so the incremental sweeps skip them
    //   and scan only:
    //     round 0:   the session-captured dirty bound segments (exact
    //                top-level def pairing from the fast lane's AST swap)
    //                + the dirty files' AST defs + every append-zone def
    //                not yet scanned (the previous transaction's pass-8
    //                on-demand creations);
    //     round >0:  the uncovered append zone only (= the previous round's
    //                new specializations — the cascade entry).
    //   Namespace defs are gated at the TOP LEVEL only: every bound
    //   namespace def belongs to exactly one file (bind_namespace_def
    //   creates one per file's AST namespace block, children all from that
    //   file), so an ungated namespace's subtree is entirely clean.
    inc_active: mut bool = false;
    // dirty file names (the AST-side gate: ast_def_filename ∈ inc_files)
    inc_files: mut _utils.List<string> = new _utils.List<string>();
    // dirty bound segments as [lo, hi) index pairs into result.definitions
    // (captured during the fast lane's AST swap — see recompute_fast)
    inc_lo: mut _utils.List<i64> = new _utils.List<i64>();
    inc_hi: mut _utils.List<i64> = new _utils.List<i64>();

    fun inc_range_contains(this, i: i64) -> bool {
        let k: mut i64 = 0;
        while (k < cast<i64>(this.inc_lo.size())) {
            if (i >= this.inc_lo.at(cast<u64>(k)).some && i < this.inc_hi.at(cast<u64>(k)).some) {
                return true;
            }
            k = k + 1;
        }
        return false;
    }

    fun inc_file_contains(this, file: string) -> bool {
        let k: mut i64 = 0;
        while (k < cast<i64>(this.inc_files.size())) {
            if (this.inc_files.at(cast<u64>(k)).some == file) {
                return true;
            }
            k = k + 1;
        }
        return false;
    }

    fun inc_configure(mut this, files: _utils.List<string>, lo: _utils.List<i64>, hi: _utils.List<i64>) {
        this.inc_files = new _utils.List<string>();
        this.inc_lo = new _utils.List<i64>();
        this.inc_hi = new _utils.List<i64>();
        let a: mut i64 = 0;
        while (a < cast<i64>(files.size())) {
            this.inc_files.push(files.at(cast<u64>(a)).some);
            a = a + 1;
        }
        let b: mut i64 = 0;
        while (b < cast<i64>(lo.size())) {
            this.inc_lo.push(lo.at(cast<u64>(b)).some);
            this.inc_hi.push(hi.at(cast<u64>(b)).some);
            b = b + 1;
        }
        this.inc_active = true;
    }

    fun inc_reset(mut this) {
        this.inc_active = false;
        this.inc_files = new _utils.List<string>();
        this.inc_lo = new _utils.List<i64>();
        this.inc_hi = new _utils.List<i64>();
    }

    // ---- O1: the append-zone scan ledger ----
    // Full names of append-zone defs (specializations + synthesized classes;
    // everything at index >= unit.definitions.size() + libmeta injections)
    // that some fixpoint sweep has already scanned. "Scanned" means the
    // def's request face was collected at least once and is believed
    // satisfied — the incremental sweeps skip covered defs. Evictions (the
    // O2 reconciliation's dead specializations, the fast lane's synthesized
    // class eviction) UNCOVER the name so a recreated def is re-scanned
    // (recreations land in the append zone uncovered — see scan_uncover).
    scan_covered: mut _utils.StrMap<string> = new _utils.StrMap<string>();

    fun scan_is_covered(this, name: string) -> bool {
        if (string_length(name) == 0) { return false; }
        return this.scan_covered.get(name, "") == "1";
    }

    fun scan_uncover(mut this, name: string) {
        if (string_length(name) == 0) { return; }
        this.scan_covered.set(name, "");
    }

    // Mark every current append-zone def scanned. Called at the end of every
    // run(): a full-mode run has swept the whole tree (everything is
    // covered); an incremental run has swept the previously-uncovered
    // remainder (everything is covered now).
    fun scan_mark_append_covered(mut this, unit: CompilationUnit, result: BoundCompilationUnit) {
        let append_from: i64 = cast<i64>(unit.definitions.size()) + this.model.some.libmeta_total_injected();
        let i: mut i64 = append_from;
        while (i < cast<i64>(result.definitions.size())) {
            let n: string = bound_def_full_name(result.definitions.at(cast<u64>(i)).some);
            if (string_length(n) > 0) {
                this.scan_covered.set(n, "1");
            }
            i = i + 1;
        }
    }

    // ---- O1: request-attribution recording ----
    // When attrib_on, the A4 sweeps record every request OCCURRENCE as a
    // (file, key) pair: the file = the scanned def's source file (empty for
    // attribution-less shapes — not recorded), the key = the canonical
    // request identity (the would-be specialization mangle). Occurrences are
    // recorded even when the sweep-level dedup skips the push: attribution
    // is per-def occurrence data, not "first collector wins" (a request
    // occurring in two files belongs to both files' buckets). The session
    // harvests the pairs after run() to maintain the per-file request cache
    // (fast-lane rounds) or rebuild/verify it (full compiles, verify rounds).
    attrib_on: mut bool = false;
    // the def whose contributions are being scanned right now ("" = none)
    attrib_file: mut string = "";
    attrib_files: mut _utils.List<string> = new _utils.List<string>();
    attrib_keys: mut _utils.List<string> = new _utils.List<string>();

    fun attrib_reset(mut this) {
        this.attrib_files = new _utils.List<string>();
        this.attrib_keys = new _utils.List<string>();
    }

    fun attrib_note(mut this, key: string) {
        if (!this.attrib_on) { return; }
        if (string_length(this.attrib_file) == 0) { return; }
        this.attrib_files.push(this.attrib_file);
        this.attrib_keys.push(key);
    }

    // The canonical key of one TYPE instantiation request (the name B1's
    // funnel would give the specialized def).
    fun attrib_type_key(this, bt: BoundType) -> string {
        return MonomorphizePass.mangle_generic_name(bound_def_full_name(bt.type_definition.some), bt.generic_args);
    }

    fun stat_reset(mut this) {
        this.stat_rounds = 0;
        this.stat_round_ms = new _utils.List<i64>();
        this.stat_round_new = new _utils.List<i64>();
        this.stat_collect_ms = 0;
        this.stat_adjudicate_ms = 0;
    }

    // Record one finished fixpoint round (timing mode only).
    fun stat_push_round(mut this, round_ms: i64, new_defs: i64) {
        this.stat_rounds = this.stat_rounds + 1;
        this.stat_round_ms.push(round_ms);
        this.stat_round_new.push(new_defs);
    }

    // Record one adjudication (first-wins; empty names dropped).
    fun b1_record(mut this, mangled_full: string, kind: string, site: string) {
        if (string_length(mangled_full) == 0) { return; }
        if (this.b1_adjudicated.get_opt(mangled_full).is_none()) {
            this.b1_adjudicated.set(mangled_full, kind + "|" + site);
        }
    }

    fun new(mut this, model: mut SemanticModel) {
        this.model = new Option<SemanticModel>.some(model);
        this.specialize = new MonoSpecialize(this);
        this.collect = new MonoCollect(this);
        this.specializing = new MonoSpecializing(this);
        this.adjudicate = new MonoAdjudicate(this);
    }

    fun mangle_generic_name(base_name: string, generic_args: _utils.List<BoundTypeArg>) -> string {
        _utils.trace_enter("Enter mangle_generic_name");
        // THE unified mangle (see BoundType.penguin): fully-qualified
        // serialization → fixed-width base62 groups, joined with `$`. The `$`
        // can never appear in a user identifier, and the encoding is injective
        // (two different specializations always differ). This is the single
        // implementation every layer must use.
        return mangle_specialization(base_name, generic_args);
    }

    // 唯一入口：原 pass_monomorphize
    fun run(mut this, unit: CompilationUnit, result: mut BoundCompilationUnit) {
        _utils.trace_enter("Enter pass_monomorphize");
        let m: mut SemanticModel = this.model.some;
        let timing: bool = m.timing_enabled;
        if (timing) { this.stat_reset(); }
        this.stat_inc_scanned = 0;
        if (this.attrib_on) { this.attrib_reset(); }
        this.active_result = new Option<BoundCompilationUnit>.some(result);
        // O3-lite fix (first exposed by the byte-level dump reconciliation):
        // the fixpoint window resolves type specifiers (A4 collection +
        // specialization projection), and those RESOLUTION HITS reach
        // index_note_user — which attributes them to index_current_file.
        // That field is a PASS-8 concept (the file of the def whose body is
        // being bound); inside pass 3 it holds whatever the LAST body bind
        // left there — "" on a fresh full compile (the notes are dropped,
        // correct) but a STALE file on the fast lane's retained model (the
        // notes leak into users_pending attributed to an unrelated file).
        // Clear it for the window and restore afterwards: no fixpoint-time
        // resolution is a body-bind reference, so dropping them is the
        // correct attribution on every path.
        let saved_index_current_file: string = m.index_current_file;
        m.index_current_file = "";
        // Iterative monomorphization (batch 3.2 A4/B1 split): each round is
        // the A4 collection half (MonoCollect — pure request accumulation,
        // no def construction) followed by the B1 adjudication half
        // (MonoAdjudicate — the single point that decides each request:
        // guards, construction, B1 record, resolve/fix/mark, push). The next
        // round re-collects from the newly resolved definitions for
        // transitive instantiations.
        let total_specialized: mut i64 = 0;
        let max_iterations: mut i64 = 10;
        let iteration: mut i64 = 0;
        while (iteration < max_iterations) {
            // P0 timing anchors (0 = timing off; every now_ms call below is
            // guarded so the plain path makes zero clock reads). Anchors:
            //   t0 round start → t1 before B1-type → t2 before A4-fun →
            //   t3 before B1-fun → t4 after B1-fun
            //   A4 = (t1-t0) + (t3-t2);  B1 = (t2-t1) + (t4-t3)
            let t0: mut i64 = 0;
            let t1: mut i64 = 0;
            let t2: mut i64 = 0;
            let t3: mut i64 = 0;
            let t4: mut i64 = 0;
            if (timing) { t0 = __builtin.now_ms(); }
            // ---- A4: collect this round's TYPE instantiation requests ----
            let instantiations: mut _utils.List<BoundType> = new _utils.List<BoundType>();
            // Speculative window W1 (batch 3.4 semantics fixed — see
            // SemanticModel.suppress_report_errors): collection resolves
            // method-body type args with the def's CLASS/file scope, where
            // the method's own template params are invisible — those resolve
            // failures are EXPECTED (the instantiation is skipped; pass 8
            // re-binds bodies with proper function scopes and reports the
            // REAL errors there).
            let saved_suppress: bool = m.speculative_window_begin();
            if (this.inc_active) {
                // O1 incremental sweep: round 0 = dirty bound segments +
                // uncovered append zone + dirty files' AST; later rounds =
                // uncovered append zone only (the cascade).
                // (The round-0 flag goes through a let: a comparison passed
                // DIRECTLY as a bool call argument lowers to raw i1 under
                // an i8 annotation — invalid IR, see the
                // ComparisonAsBoolCallArg sentinel.)
                let round0: bool = iteration == 0;
                this.collect.collect_incremental_types(unit, result, instantiations, round0);
            } else {
                this.collect.collect_generic_instantiations(result.definitions, instantiations);
                this.collect.collect_generic_instantiations_from_ast(unit.definitions, result.global_scope, instantiations);
            }
            m.speculative_window_end(saved_suppress);
            this.model.some.trace("monomorphize iteration " + cast<string>(iteration) + " start: " + cast<string>(instantiations.size()) + " instantiation(s) collected");

            let specialized_defs: mut _utils.List<BoundDefinition> = new _utils.List<BoundDefinition>();
            let specialized_asts: mut _utils.List<Definition> = new _utils.List<Definition>();
            // ---- B1: adjudicate the type requests (single point) ----
            if (timing) { t1 = __builtin.now_ms(); }
            this.adjudicate.adjudicate_type_requests(instantiations, result, unit, specialized_defs, specialized_asts);

            // ---- A4: collect this round's FUNCTION instantiation requests ----
            // Speculative window W2 — same rationale as W1 above.
            if (timing) { t2 = __builtin.now_ms(); }
            let func_instantiations: mut _utils.List<FunctionInstantiation> = new _utils.List<FunctionInstantiation>();
            let saved_suppress2: bool = m.speculative_window_begin();
            if (this.inc_active) {
                // O1: the fun sweep is AST-source-only in the full mode
                // (specialized bodies never produce fixpoint fun requests),
                // so the incremental form is just the dirty-file AST gate.
                this.collect.collect_incremental_funs(unit, result, func_instantiations);
            } else {
                this.collect.collect_function_instantiations_from_ast(unit.definitions, result.global_scope, func_instantiations);
            }
            m.speculative_window_end(saved_suppress2);

            // ---- B1: adjudicate the function requests (single point) ----
            if (timing) { t3 = __builtin.now_ms(); }
            this.adjudicate.adjudicate_function_requests(func_instantiations, result, unit, specialized_defs, specialized_asts);
            if (timing) {
                t4 = __builtin.now_ms();
                this.stat_collect_ms = this.stat_collect_ms + (t1 - t0) + (t3 - t2);
                this.stat_adjudicate_ms = this.stat_adjudicate_ms + (t2 - t1) + (t4 - t3);
            }

            if (cast<i64>(specialized_defs.size()) == 0) {
                // No new specializations found, we're done
                if (timing) {
                    this.stat_push_round(__builtin.now_ms() - t0, 0);
                }
                this.scan_mark_append_covered(unit, result);
                m.index_current_file = saved_index_current_file;
                if (this.model.some.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Monomorphize] Completed in " + cast<string>(iteration) + " iterations, " + cast<string>(total_specialized) + " total specializations"); }
                return;
            }

            // ---- B1 finalize: resolve + fix + mark + push the round's batch ----
            total_specialized = total_specialized + this.adjudicate.finalize_round(result, specialized_defs, specialized_asts);
            if (this.model.some.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Monomorphize] Iteration " + cast<string>(iteration) + ": " + cast<string>(specialized_defs.size()) + " new specializations (total: " + cast<string>(total_specialized) + ")"); }
            if (timing) {
                this.stat_push_round(__builtin.now_ms() - t0, cast<i64>(specialized_defs.size()));
            }
            iteration = iteration + 1;
        }
        // Iteration-limit exit (batch 3.2: the silent stop gained a verbose-
        // gated diagnostic — behavior identical, still stops silently at the
        // default verbosity; requests discovered after the limit fall to the
        // on-demand paths exactly as before).
        this.scan_mark_append_covered(unit, result);
        m.index_current_file = saved_index_current_file;
        if (this.model.some.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Monomorphize] Iteration limit (" + cast<string>(max_iterations) + ") reached after " + cast<string>(total_specialized) + " specializations — stopping; later instantiations defer to the on-demand paths"); }
    }

    // ---- External-call-surface forwarders (batch 0.3 split): these moved
    // to their concern module; delegates kept verbatim so SemanticModel /
    // other passes' call sites are unchanged. ----

    fun ensure_specialized_def(mut this, inst: BoundType, global_scope: mut BoundScope) -> Option<BoundDefinition> {
        return this.specialize.ensure_specialized_def(inst, global_scope);
    }

    fun ensure_specialized_type(mut this, template_name: string, type_args: _utils.List<BoundTypeArg>) -> BoundType {
        return this.specialize.ensure_specialized_type(template_name, type_args);
    }

    fun find_ast_def_by_name(this, defs: _utils.List<Definition>, name: string) -> Option<Definition> {
        return this.specialize.find_ast_def_by_name(defs, name);
    }

    fun ensure_function_specialization_now(mut this, tmpl_def: BoundDefinition, type_args: _utils.List<BoundTypeArg>, result: mut BoundCompilationUnit) -> Option<BoundFunctionSymbol> {
        return this.specialize.ensure_function_specialization_now(tmpl_def, type_args, result);
    }

    fun late_ensure_def_signatures(mut this, def: BoundDefinition, global_scope: mut BoundScope) {
        this.specialize.late_ensure_def_signatures(def, global_scope);
    }

    fun resolve_field_specialization(mut this, bt: BoundType, global_scope: mut BoundScope) -> mut BoundType {
        return this.specialize.resolve_field_specialization(bt, global_scope);
    }

    fun native_umangleable_type(this, bt: BoundType) -> bool {
        return this.specializing.native_umangleable_type(bt);
    }

    fun bound_type_meta_name(this, bt: BoundType) -> string {
        return this.specializing.bound_type_meta_name(bt);
    }
}

}
