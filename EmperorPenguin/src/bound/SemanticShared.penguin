namespace emperor {

class FunctionInstantiation {
    func_name: !mut string = "";
    generic_args: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();

    fun new(mut this, func_name: string, generic_args: mut _utils.List<BoundTypeArg>) {

        this.func_name = func_name;
        this.generic_args = generic_args;
    }
}

// A member access that lands on a declared RTL port field (`X.p` where p is
// an input/output of X's class): the port's field symbol (typed
// IChannel<payload>), direction metadata and owning class, plus whether the
// access goes through a bare `this` base (the permission matrix's "own
// module" test).
class PortAccessInfo {
    field_sym: mut BoundVariableSymbol = new BoundVariableSymbol();
    is_input: bool = false;
    has_default: bool = false;
    payload: mut BoundType = new BoundType();
    class_full_name: string = "";
    base_is_this: bool = false;
}

// A compiled `#specializing Bar<T> { ... }` block. The block body becomes a
// meta (#fun) callback `bmf` (params mirror Bar's template params; each `impl`
// statement becomes emperor.penguin_meta_activate_impl(<slot>)), and the impl
// fragments (in slot order) are what the monomorphize hook injects when a slot
// is activated. Keyed by the TARGET template's simple name ("Bar").
class SpecializingBlockInfo {
    target_name: mut string = "";
    bmf: mut BoundMetaFunctionDefinition = new BoundMetaFunctionDefinition("", "");
    impl_fragments: mut _utils.List<Definition> = new _utils.List<Definition>();
    location: mut SourceLocation = new SourceLocation("", 0, 0);
}

// ---------------------------------------------------------------------------
// Per-file anonymous namespaces (C++ static semantics, BabyPenguin parity).
// Top-level definitions that are not inside an explicit `namespace` block are
// file-local: they bind into a per-file namespace `_ns_<stem>_<hash16>`
// (stem = basename without extension, hash over the full path) instead of
// `<global>`, so same-named top-level defs in different files never collide
// and cross-file unqualified access does not see them. Explicit namespaces
// still merge by name across files (add_or_merge_namespace), and a file that
// declares only named namespaces never materializes its file namespace
// (it is created lazily on first use).
// ---------------------------------------------------------------------------

// djb2 restricted to 16 bits — the uniquifier half of BabyPenguin's
// `_ns_<name>_<hash(fullPath) % 0xFFFF>` file-namespace naming.
fun _file_ns_hash(s: string) -> i64 {
    let h: mut i64 = 5381;
    let i: mut i64 = 0;
    while (i < string_length(s)) {
        h = (h * 33 + string_char_code(string_char_at(s, i))) % 65536;
        i = i + 1;
    }
    return h;
}

fun file_ns_name(filename: string) -> string {
    let last_slash: mut i64 = -1;
    let pos: mut i64 = string_find(filename, "/");
    while (pos >= 0) {
        last_slash = pos;
        pos = string_find_from(filename, "/", pos + 1);
    }
    let base: string = string_substring(filename, last_slash + 1, string_length(filename) - last_slash - 1);
    let ext: i64 = string_find(base, ".penguin");
    let stem: mut string = base;
    if (ext >= 0) {
        stem = string_substring(base, 0, ext);
    }
    return "_ns_" + stem + "_" + cast<string>(_file_ns_hash(filename));
}

// ── Batch 3.4: file-qualified synthetic names (invalidation class ⑤) ──
//
// The synthetic-name counters (__lambda_ / __SpawnCtx_ / __SpawnFut_ /
// __GenCtx_ / __construct_ / __net_ / __conn_wire_ / __conn_relay_) number
// synthesized definitions PER FILE and embed the owning file's namespace tag
// IN THE NAME (__lambda__ns_<stem>_<hash>_<n>). Two properties follow:
//   * no cross-file collision even in SHARED scopes — synthesized ctx/lambda
//     classes bind into the site's nearest namespace-or-global scope, which
//     explicit namespaces merge ACROSS files (the batch-1.3 per-file-counter
//     regression: same-numbered __SpawnCtx_1 classes in one shared namespace
//     scope, the loser silently dropped); the embedded tag makes every name
//     globally unique regardless of the registration scope;
//   * incremental safety (the actual goal, roadmap 4.3): editing file B never
//     re-numbers file A's synthetic names — the counters are keyed by the
//     file tag, and the tag is a pure function of the file's path.
// The COUNTER key and the NAME tag are the same string, so a bucket's n-th
// name is stable. Callers pick the owning file from a reliable context: the
// body-binding file for pass-8 synthesis (index_current_file), the PARENT
// def's source file for pass-1 desugar synthesis (desugared defs carry no
// source_file of their own — the batch-1.3 defect A).
fun synth_name_file_tag(file: string) -> string {
    let raw: mut string = file_ns_name(file);
    if (string_length(file) == 0) { raw = "_ns__anon"; }
    // Sanitize to the identifier alphabet [A-Za-z0-9_]: the tag lands inside
    // EMITTED symbol names, and some virtual filenames are not
    // identifier-safe — the MetaEngine compiles its unit-B sources under
    // "<unit_b>" / "<meta_externs>" spellings, whose angle brackets would
    // corrupt the LLVM global names (parseIR rejects them) the moment a
    // lambda/spawn is synthesized inside a #fun body.
    let sb: mut StringBuilder = new StringBuilder();
    let i: mut i64 = 0;
    while (i < string_length(raw)) {
        let c: i64 = string_char_code(string_char_at(raw, i));
        let ok: bool = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;
        if (ok) {
            sb.append(string_char_at(raw, i));
        } else {
            sb.append("_");
        }
        i = i + 1;
    }
    return sb.to_string();
}

// Per-file synthetic counter step: returns this file's next number.
fun next_synth_counter(counters: mut _utils.StrMap<i64>, file: string) -> i64 {
    let key: string = synth_name_file_tag(file);
    let n: i64 = counters.get(key, 0);
    counters.set(key, n + 1);
    return n;
}

// The source filename a top-level ast def came from (each parse sets location
// from token locations, which carry the lexer's filename). Unknown shapes
// fall back to "" which maps to one stable anonymous namespace.
// Stamp the owning source file onto a meta-spliced def (see
// try_splice_meta_fun_def): compiler-generated definitions from
// #create_definition / #make_*() parse with a synthetic "<meta_...>" filename,
// but semantically they belong to the file that called the #fun — they must
// bind into THAT file's anonymous namespace so user types (e.g. Point) stay
// visible to them and vice versa.
fun set_def_source_file(def: Definition, fname: string) {
    if (def is Definition.function_def) { def.function_def.source_file = fname; }
    else if (def is Definition.class_def) { def.class_def.source_file = fname; }
    else if (def is Definition.enum_def) { def.enum_def.source_file = fname; }
    else if (def is Definition.namespace_def) { def.namespace_def.source_file = fname; }
    else if (def is Definition.using_def) { def.using_def.source_file = fname; }
    else if (def is Definition.initial_routine) { def.initial_routine.source_file = fname; }
    else if (def is Definition.interface_def) { def.interface_def.source_file = fname; }
    else if (def is Definition.impl_def) { def.impl_def.source_file = fname; }
    else if (def is Definition.impl_for_def) { def.impl_for_def.source_file = fname; }
    else if (def is Definition.type_ref_def) { def.type_ref_def.source_file = fname; }
    else if (def is Definition.global_var) { def.global_var.source_file = fname; }
    else if (def is Definition.port_def) { def.port_def.source_file = fname; }
    else if (def is Definition.construct_def) { def.construct_def.source_file = fname; }
    else if (def is Definition.meta_function_def) { def.meta_function_def.source_file = fname; }
    else if (def is Definition.meta_class_def) { def.meta_class_def.source_file = fname; }
    else if (def is Definition.meta_if_def) { def.meta_if_def.source_file = fname; }
    else if (def is Definition.meta_for_def) { def.meta_for_def.source_file = fname; }
    else if (def is Definition.meta_while_def) { def.meta_while_def.source_file = fname; }
    else if (def is Definition.meta_call_def) { def.meta_call_def.source_file = fname; }
    else if (def is Definition.specializing_def) { def.specializing_def.source_file = fname; }
}

// Keep in sync: adding a Definition variant requires updating BOTH dispatch chains (and BabyPenguin parity).

fun ast_def_filename(def: Definition) -> string {
    // The per-def source file is carried in `source_file` (set by the parser
    // from the token's location). NOT def.location.filename: location fields
    // are `mut` references whose assignment goes through ICopy (a C#-backend
    // codegen path that corrupts the value), while plain string fields are
    // safe — see the file-namespace bootstrap fix.
    if (def is Definition.function_def) { return def.function_def.source_file; }
    if (def is Definition.class_def) { return def.class_def.source_file; }
    if (def is Definition.enum_def) { return def.enum_def.source_file; }
    if (def is Definition.namespace_def) { return def.namespace_def.source_file; }
    if (def is Definition.using_def) { return def.using_def.source_file; }
    if (def is Definition.initial_routine) { return def.initial_routine.source_file; }
    if (def is Definition.interface_def) { return def.interface_def.source_file; }
    if (def is Definition.impl_def) { return def.impl_def.source_file; }
    if (def is Definition.impl_for_def) { return def.impl_for_def.source_file; }
    if (def is Definition.type_ref_def) { return def.type_ref_def.source_file; }
    if (def is Definition.global_var) { return def.global_var.source_file; }
    if (def is Definition.port_def) { return def.port_def.source_file; }
    if (def is Definition.construct_def) { return def.construct_def.source_file; }
    if (def is Definition.meta_function_def) { return def.meta_function_def.source_file; }
    if (def is Definition.meta_class_def) { return def.meta_class_def.source_file; }
    if (def is Definition.meta_if_def) { return def.meta_if_def.source_file; }
    if (def is Definition.meta_for_def) { return def.meta_for_def.source_file; }
    if (def is Definition.meta_while_def) { return def.meta_while_def.source_file; }
    if (def is Definition.meta_call_def) { return def.meta_call_def.source_file; }
    if (def is Definition.specializing_def) { return def.specializing_def.source_file; }
    return "";
}

// The scope a TOP-LEVEL ast def binds into: explicit `namespace` blocks
// against the global scope (they merge by name across files); everything else
// against this file's anonymous namespace.
fun top_level_def_scope(def: Definition, global_scope: mut BoundScope) -> mut BoundScope {
    if (def is Definition.namespace_def) { return global_scope; }
    // An extern DECLARATION is exempt from the file namespace: it references
    // a C symbol, which is global by nature, and the universal extern->C rule
    // maps a bare top-level extern to its own name (@abs -> real libc abs).
    // File isolation would wrap it as _ns_<file>_<hash>_abs — an unstable
    // symbol no C side can implement — making user externs unusable.
    if (def is Definition.function_def) {
        if (def.function_def.is_extern) { return global_scope; }
    }
    // Defs with no source file or a SYNTHETIC source name (meta-spliced
    // definitions from #create_definition / #make_*() — the parser names them
    // "<meta_create_definition>" etc.) bind into the global scope: they are
    // compiler-generated, belong to no user file, and must stay reachable
    // from any user file (master semantics).
    let fname: string = ast_def_filename(def);
    if (string_length(fname) == 0) { return global_scope; }
    if (string_char_at(fname, 0) == "<") { return global_scope; }
    return global_scope.add_or_merge_namespace(file_ns_name(fname));
}

// Batch 3.3a: the source FILE a bound def belongs to, via its carried
// ast_source (set by BuildScopes for AST defs and by the specialize_* creators
// for specialized defs — a specialization belongs to its TEMPLATE's file).
// Container/synthetic shapes without an ast_source return "" — callers that
// group defs into file segments treat "" as "inherit the current segment"
// (same-file defs are contiguous in result.definitions, so an ast_source-less
// def never sits at a real file boundary except when it opens the walk).
fun bound_def_source_file(def: BoundDefinition) -> string {
    if (def is BoundDefinition.function_def) {
        if (def.function_def.ast_source.is_some()) { return ast_def_filename(def.function_def.ast_source.some); }
    }
    if (def is BoundDefinition.class_def) {
        if (def.class_def.ast_source.is_some()) { return ast_def_filename(def.class_def.ast_source.some); }
    }
    if (def is BoundDefinition.enum_def) {
        if (def.enum_def.ast_source.is_some()) { return ast_def_filename(def.enum_def.ast_source.some); }
    }
    if (def is BoundDefinition.interface_def) {
        if (def.interface_def.ast_source.is_some()) { return ast_def_filename(def.interface_def.ast_source.some); }
    }
    if (def is BoundDefinition.global_var_def) {
        if (def.global_var_def.ast_source.is_some()) { return ast_def_filename(def.global_var_def.ast_source.some); }
    }
    return "";
}

// The ENCLOSING scope of a bound def (the scope its name is registered in):
// the def's own scope's parent for class/enum/interface/function/initial
// defs, the namespace's own scope for namespaces, the variable symbol's
// enclosing scope for globals; fallback is the global scope. Used where a
// pass iterates bound defs and needs the def's lookup context.
fun def_lookup_scope(def: BoundDefinition, global_scope: mut BoundScope) -> mut BoundScope {    if (def is BoundDefinition.class_def) {        if (def.class_def.scope.is_some() && def.class_def.scope.some.parent.is_some()) {
            return def.class_def.scope.some.parent.some;
        }
    }
    if (def is BoundDefinition.enum_def) {
        if (def.enum_def.scope.is_some() && def.enum_def.scope.some.parent.is_some()) {
            return def.enum_def.scope.some.parent.some;
        }
    }
    if (def is BoundDefinition.interface_def) {
        if (def.interface_def.scope.is_some() && def.interface_def.scope.some.parent.is_some()) {
            return def.interface_def.scope.some.parent.some;
        }
    }
    if (def is BoundDefinition.function_def) {
        if (def.function_def.scope.is_some() && def.function_def.scope.some.parent.is_some()) {
            return def.function_def.scope.some.parent.some;
        }
    }
    if (def is BoundDefinition.initial_routine) {
        if (def.initial_routine.scope.is_some() && def.initial_routine.scope.some.parent.is_some()) {
            return def.initial_routine.scope.some.parent.some;
        }
    }
    if (def is BoundDefinition.namespace_def) {
        if (def.namespace_def.scope.is_some()) {
            return def.namespace_def.scope.some;
        }
    }
    if (def is BoundDefinition.global_var_def) {
        if (def.global_var_def.variable_symbol.is_some() && def.global_var_def.variable_symbol.some.enclosing_scope.is_some()) {
            return def.global_var_def.variable_symbol.some.enclosing_scope.some;
        }
    }
    return global_scope;
}

// Replay-pass AST lookup: the unit's definitions first (normal defs); when
// the def is a bind-time synthesized one (async-spawn ctx classes — see
// BindExpressionsPass.bind_spawn_async) it is not in the unit, and its AST
// rides on ast_source.
fun replay_find_ast_def(model: SemanticModel, template_name: string, ast_source: Option<Definition>) -> Option<Definition> {
    // The carried AST source is the UNAMBIGUOUS match — check it FIRST: the
    // bare-name search returns the LAST same-named def, so same-named methods
    // of different classes (map/filter/... on every iterator class) replay
    // against the WRONG body.
    if (ast_source.is_some()) { return ast_source; }
    let found: Option<Definition> = model.monomorphize_pass.find_ast_def_by_name(model.ast_definitions, template_name);
    if (found.is_some()) { return found; }
    return new Option<Definition>.none();
}

// True when bt IS (or CONTAINS) an unspecializable type argument: an
// unresolved template-param reference OR an unresolved/error type (the `?`
// serialization — e.g. pass-3's AST collector resolves a method-body type arg
// in the CLASS scope, where the method's own template params are invisible,
// yielding error types). BuildScopes registers every generic param
// (class/enum/interface/function scope) as a type symbol whose bound_type
// points at a DUMMY class def — constructed as (param_name,
// enclosing_full_name + "." + param_name), with type_symbol/scope none and
// every member list empty. Specializing over any of these is meaningless, and
// worse, self-referential: the arg's mangle embeds its ENCLOSING def's
// (specialized, ever-growing) name, so a bind-time specialization driven from
// a still-generic body creates a spec whose own template methods spawn
// longer-named specs forever — unbounded memory growth. Every specialization
// path (pass-3 fixpoint, new-expression on-demand specs, generic-call
// inference) must refuse such args via this predicate.
fun bound_type_is_template_param(bt: BoundType) -> bool {
    // Error/unresolved types (`?`): ErrorKind, or a non-primitive non-function
    // type with no type definition. Function types carry no def and are fine —
    // their ARGS are checked by the recursion below. Native array types
    // (ArrayKind) also carry no type_definition by construction — their
    // element types live in generic_args and are checked by the recursion.
    if (bt.kind is TypeKind.ErrorKind) { return true; }
    if (!(bt.kind is TypeKind.PrimitiveKind) && !(bt.kind is TypeKind.FunctionKind) && !(bt.kind is TypeKind.ArrayKind) && bt.type_definition.is_none()) { return true; }
    if (bt.type_definition.is_some()) {
        let td: BoundDefinition = bt.type_definition.some;
        if (td is BoundDefinition.class_def) {
            let cd: BoundClassDefinition = td.class_def;
            if (cd.type_symbol.is_none() && cd.scope.is_none()
                && cast<i64>(cd.methods.size()) == 0 && cast<i64>(cd.fields.size()) == 0
                && cast<i64>(cd.constructors.size()) == 0 && cast<i64>(cd.interface_impls.size()) == 0
                && cast<i64>(cd.generic_params.size()) == 0) {
                return true;
            }
        }
    }
    if (cast<i64>(bt.generic_args.size()) > 0) {
        let i: mut i64 = 0;
        while (i < cast<i64>(bt.generic_args.size())) {
            if (bound_type_is_template_param(arg_as_bound_type(bt.generic_args.at(cast<u64>(i)).some))) { return true; }
            i = i + 1;
        }
    }
    return false;
}

// True when a `new` expression's dotted type_name denotes the builtin
// linear wrapper `__builtin.Ownership` — i.e. its LAST dotted segment is
// EXACTLY "Ownership" (the parser stores only the dotted base name in
// type_name; generic args are parsed separately and never appear there, so
// `<...>` stripping is unnecessary). A substring test
// (string_find(t, "Ownership") >= 0) used to false-positive on ANY user
// class whose name merely contains the substring (OwnershipRegistry,
// BindExprOwnership — MtOwnershipSubstringClassNameFalsePositive): their
// single-argument constructors were wrongly gated by the §9.2 freshness
// rule (and, in the use audit, wrongly recognized as the wrap itself).
fun new_type_is_builtin_ownership(type_name: string) -> bool {
    if (type_name == "Ownership") {
        return true;
    }
    // <ns...>.Ownership — segment-boundary match: the type name must END
    // with ".Ownership" (a longer last segment, e.g. "OwnershipRegistry"
    // or "MyOwnership", does not match).
    let suffix: string = ".Ownership";
    let n: i64 = string_length(type_name);
    let m: i64 = string_length(suffix);
    if (n <= m) { return false; }
    return string_substring(type_name, n - m, m) == suffix;
}

}
