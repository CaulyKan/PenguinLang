namespace emperor {

enum ErrorSeverity {
    Error;
    Warning;
    Info;
}

class SemanticError {
    code: ErrorCode = new ErrorCode.E_INTERNAL();
    message: string = "";
    location: !mut SourceLocation = new SourceLocation("", 0, 0);
    severity: mut ErrorSeverity = new ErrorSeverity.Error();

    fun new(mut this, code: ErrorCode, message: string, location: SourceLocation) {
        this.code = code;
        this.message = message;
        this.location = location;
    }
}

class BoundCompilationUnit {
    definitions: mut _utils.List<BoundDefinition> = new _utils.List<BoundDefinition>();
    global_scope: BoundScope = new BoundScope(new ScopeKind.GlobalScope(), "", "", new Option<BoundScope>.none());
    type_registry: BoundTypeRegistry = new BoundTypeRegistry();
    errors: mut _utils.List<SemanticError> = new _utils.List<SemanticError>();
    location: !mut SourceLocation = new SourceLocation("", 0, 0);
    // True when any wait form or async spawn bound anywhere in this unit
    // (instantiated stdlib channel code included). emit_main runs initials on
    // the coroutine scheduler only when this is set — wait-free programs emit
    // the plain sequential main regardless of --enable-coroutine, keeping
    // bootstrap md5 convergence flag-independent.
    has_suspension: mut bool = false;

    fun new(mut this, location: SourceLocation) {
        this.location = location;
    }

    fun add_error(mut this, code: ErrorCode, message: string, location: SourceLocation) {
        this.errors.push(new SemanticError(code, message, location));
    }

    fun has_errors(this) -> bool {
        let i: mut i64 = 0;
        while (i < cast<i64>(this.errors.size())) {
            if (this.errors.at(cast<u64>(i)).some.severity is ErrorSeverity.Error) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
}

}
