namespace emperor {

enum ErrorSeverity {
    Error;
    Warning;
    Info;
}

export class SemanticError {
    code: ErrorCode = new ErrorCode.E_INTERNAL();
    message: string = "";
    location: !mut SourceLocation = new SourceLocation("", 0, 0);
    severity: mut ErrorSeverity = new ErrorSeverity.Error();
    // Batch 4.2 (incremental session, fast lane): the pipeline stage this
    // error was reported at (model.current_pass_index at report time; 0 for
    // pre-pipeline construction). Pure metadata — never printed, never
    // consulted by the full path; the session's error replay sorts the
    // merged (replayed clean + fresh changed-file) error list by
    // (pass_idx, file segment order, intra-file order) to reproduce the
    // full-compile ordering byte-exactly.
    pass_idx: mut i64 = 0;
    // O2 (reconciliation split): the full name of the TOP-LEVEL def whose
    // per-def processing reported this error ("" for global-stage /
    // pass-1/2 / location-less reports). Pure metadata on the full path;
    // the session's error replay uses it to DROP the stale errors of a
    // specialization the reconciliation just evicted (a dead instance's
    // snapshot-carried error would otherwise survive as a phantom
    // diagnostic — repro: O2c scenario, Tests/IncrementalTest/
    // IncrementalDeadSpecializationStaleError.md).
    owner_def: mut string = "";

    fun new(mut this, code: ErrorCode, message: string, location: SourceLocation) {
        this.code = code;
        this.message = message;
        this.location = location;
    }
}

export class BoundCompilationUnit {
    definitions: mut _utils.List<BoundDefinition> = new _utils.List<BoundDefinition>();
    global_scope: BoundScope = new BoundScope(new ScopeKind.GlobalScope(), "", "", new Option<BoundScope>.none());
    type_registry: BoundTypeRegistry = new BoundTypeRegistry();
    errors: mut _utils.List<SemanticError> = new _utils.List<SemanticError>();
    location: !mut SourceLocation = new SourceLocation("", 0, 0);
    // True when any wait form or async spawn bound anywhere in this unit
    // (instantiated stdlib channel code included). emit_main runs initials on
    // the coroutine scheduler only when this is set — wait-free programs emit
    // the plain sequential main regardless of --enable-coroutine, keeping
    // bootstrap md5 convergence flag-independent.
    has_suspension: mut bool = false;
    // Lazy full_name -> flat-index hash maps for the two hot def lookups in
    // BindExpressionsPass (try_infer_generic_call / find_function_return_type).
    // The old recursive linear walks cost O(all defs) per lookup and dominated
    // the pass-8 profile. TWO maps because the two walks cover different
    // scopes: the find-family walk skips enum interface_impls, the
    // return-type walk includes them — sharing one map would change which def
    // a lookup resolves. Each map is built lazily on first use over the whole
    // definition tree (preorder, first-wins — same winner as the linear walk)
    // and extended incrementally as monomorphize/A5-late-binding append new
    // TOP-LEVEL defs (nested trees never change after pass 1), so a miss is
    // definitive.
    func_def_index: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    func_defs_flat: mut _utils.List<BoundDefinition> = new _utils.List<BoundDefinition>();
    func_defs_indexed_upto: mut i64 = 0;
    func_ret_index: mut _utils.StrMap<i64> = new _utils.StrMap<i64>();
    func_ret_flat: mut _utils.List<BoundDefinition> = new _utils.List<BoundDefinition>();
    func_ret_indexed_upto: mut i64 = 0;

    fun new(mut this, location: SourceLocation) {
        this.location = location;
    }

    fun add_error(mut this, code: ErrorCode, message: string, location: SourceLocation) {
        this.errors.push(new SemanticError(code, message, location));
    }

    fun has_errors(this) -> bool {
        let i: mut i64 = 0;
        while (i < cast<i64>(this.errors.size())) {
            if (this.errors.at(cast<u64>(i)).some.severity is ErrorSeverity.Error) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
}

}
