namespace emperor {

class SourceInput {
    filename: string = "";
    source: string = "";
    // Dyn-lib: true when this input is the verbatim source embedded in a loaded
    // .penguin-lib. Its defs are lib-export (declared, linked to the lib) rather
    // than re-compiled into the consumer.
    is_lib: bool = false;

    fun new(mut this, filename: string, source: string) {

        this.filename = filename;
        this.source = source;
    }
}

class EmperorPenguinCompiler {
    errors: mut _utils.List<SemanticError> = new _utils.List<SemanticError>();
    verbose: mut i64 = 0;
    // Command-line --define A=B seed (Phase 5a): pre-seeds the SemanticModel's
    // compile-time option store before binding. Code-level #define has higher
    // priority (it runs during bind and overwrites these via meta_set_option).
    cli_define_keys: mut _utils.List<string> = new _utils.List<string>();
    cli_define_values: mut _utils.List<string> = new _utils.List<string>();
    // Dyn-lib routing data: the index RANGE [lib_def_start, lib_def_start +
    // lib_def_count) of top-level definitions contributed by loaded lib sources
    // (computed here from SourceInput.is_lib) + the shipped instance names,
    // forwarded to the SemanticModel (see Dynlib.penguin). Index-based marking
    // is GC-safe — the SemanticModel compares no filename strings.
    lib_def_start: mut i64 = 0;
    lib_def_count: mut i64 = 0;
    lib_instances: mut _utils.List<string> = new _utils.List<string>();
    // Unit B (meta) compilation: top-level defs bind into the global scope
    // (no per-file anonymous namespaces) so the compiler's own cross-file
    // top-level helpers stay visible. Set by the MetaEngine.
    top_level_in_global: bool = false;

    fun compile(mut this, source: string) -> BoundCompilationUnit {
        _utils.trace_enter("Enter compile");
        let inputs: mut _utils.List<SourceInput> = new _utils.List<SourceInput>();
        inputs.push(new SourceInput("", source));
        return this.compile_sources(inputs);
    }

    fun compile_sources(mut this, inputs: _utils.List<SourceInput>) -> BoundCompilationUnit {
        _utils.trace_enter("Enter compile_sources");
        let combined_defs: mut _utils.List<Definition> = new _utils.List<Definition>();
        let total_defs: mut i64 = 0;
        let parser_errors: mut _utils.List<string> = new _utils.List<string>();
        this.lib_def_start = 0;
        this.lib_def_count = 0;
        let found_first_lib: mut bool = false;
        for (let input in inputs) {
            if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Parse] Lexing & parsing: " + input.filename); }
            let lexer = new Lexer(input.source, input.filename);
            let tokens = lexer.tokenize();
            let p = new Parser(tokens);
            let unit: CompilationUnit = p.parse_compilationUnit();
            // Collect parser errors
            if (p.has_errors()) {
                let ei: mut i64 = 0;
                while (ei < cast<i64>(p.errors.size())) {
                    parser_errors.push(p.errors.at(cast<u64>(ei)).some);
                    ei = ei + 1;
                }
            }
            let j: mut i64 = 0;
            while (j < cast<i64>(unit.definitions.size())) {
                combined_defs.push(unit.definitions.at(cast<u64>(j)).some);
                j = j + 1;
            }
            // Lib sources are pushed after core_builtin (driver order); record the
            // index range of their defs so the SemanticModel can mark them
            // lib-export by index (GC-safe, no filename string comparison).
            if (input.is_lib) {
                if (!found_first_lib) {
                    this.lib_def_start = total_defs;
                    found_first_lib = true;
                }
                this.lib_def_count = this.lib_def_count + cast<i64>(unit.definitions.size());
            }
            total_defs = total_defs + cast<i64>(unit.definitions.size());
        }
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin Parse] Total: " + cast<string>(total_defs) + " definitions from " + cast<string>(inputs.size()) + " files"); }
        let combined_unit: CompilationUnit = new CompilationUnit();
        combined_unit.definitions = combined_defs;
        let main_filename: string = inputs.at(cast<u64>(inputs.size() - 1)).some.filename;
        let mut model = new SemanticModel();
        model.verbose = this.verbose;
        model.top_level_in_global = this.top_level_in_global;
        // Dyn-lib routing data (index-based lib-source boundary + shipped names).
        model.lib_def_start = this.lib_def_start;
        model.lib_def_count = this.lib_def_count;
        let lii: mut i64 = 0;
        while (lii < cast<i64>(this.lib_instances.size())) {
            model.lib_instances.push(this.lib_instances.at(cast<u64>(lii)).some);
            lii = lii + 1;
        }
        // Seed command-line --define options before binding. Code-level #define
        // (processed during bind) overwrites these, so code has higher priority.
        let cdi: mut i64 = 0;
        while (cdi < cast<i64>(this.cli_define_keys.size())) {
            model.meta_option_keys.push(this.cli_define_keys.at(cast<u64>(cdi)).some);
            model.meta_option_values.push(this.cli_define_values.at(cast<u64>(cdi)).some);
            cdi = cdi + 1;
        }
        // Propagate parser errors into model errors
        let pei: mut i64 = 0;
        while (pei < cast<i64>(parser_errors.size())) {
            let pe: string = parser_errors.at(cast<u64>(pei)).some;
            model.report_error(new ErrorCode.E_PARSE(), pe, new SourceLocation(main_filename, 0, 0));
            pei = pei + 1;
        }
        let result = model.bind(combined_unit, new SourceLocation(main_filename, 0, 0));
        this.errors = model.errors;
        return result;
    }
}

}
