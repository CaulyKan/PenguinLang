// Generic template SPECIALIZATION (batch 0.3 mechanical split of
// SemanticMonomorphize.penguin — method bodies moved verbatim, see the
// driver class there): ensure_specialized_def / specialize_class_def /
// specialize_enum_def / specialize_interface_def / specialize_function_def,
// the pass-8 late-specialization completion family, and the scope/name
// lookup helpers the specializers lean on.
namespace emperor {

class MonoSpecialize {
    // Back-reference to the owning pass (the src/bound pass-class
    // `model: mut Option<SemanticModel>` pattern, mirroring the batch 0.1/0.2
    // splits): all shared monomorphize state stays on MonomorphizePass
    // (whose own model field is reached via owner).
    owner: mut Option<MonomorphizePass> = new Option<MonomorphizePass>.none();

    fun new(mut this, owner: mut MonomorphizePass) {
        this.owner = new Option<MonomorphizePass>.some(owner);
    }

    fun is_instantiation_already_exists(this, mangled_name: string, scope: BoundScope) -> bool {
        _utils.trace_enter("Enter is_instantiation_already_exists");
        let found: Option<BoundSymbol> = scope.lookup_type_in_scope(mangled_name);
        if (found.is_some()) { return true; }
        return false;
    }

    // M3 (#template -> #fun desugar): the on-demand specialization entry point.
    // Given an instantiation `inst` (a template + its generic_args), specialize it
    // if not already present, run it through any passes it missed (catch_up_def),
    // and return the NEWLY-created specialized BoundDefinition (or none if the
    // instantiation already existed / the template was unknown). Idempotent via
    // is_instantiation_already_exists. This is the single creation path used by
    // pass_monomorphize (and, in M4, by the meta `_template_X` responder), so the
    // meta path and the fixpoint share one specialization routine.
    //
    // R2 (type-ref consistency): the matching type lookup is the caller's job
    // (lookup_type_in_scope(mangled)); this returns the def. The M4 responder wraps
    // this and returns spec.bound_type (type_def = specialized def, NO generic_args).
    fun ensure_specialized_def(mut this, inst: BoundType, global_scope: mut BoundScope) -> Option<BoundDefinition> {
        let owner: mut MonomorphizePass = this.owner.some;
        _utils.trace_enter("Enter ensure_specialized_def");
        // Batch 3.2: capture the ambient request-site at entry (the innermost
        // entry wins — a cascade firing mid-construction overwrites the
        // ambient but this spec still records the reason IT was requested).
        let b1_site: string = owner.b1_site;
        if (inst.type_definition.is_none()) { return new Option<BoundDefinition>.none(); }
        // Never specialize over unresolved template params (still-generic
        // bodies): such instantiations are garbage, and self-referential ones
        // (the arg is a dummy from THIS template's own scope) grow without
        // bound — the pass-3 fixpoint re-collects each garbage spec's template
        // method bodies, doubling specializations per iteration (the
        // iterator-combinator OOM). See bound_type_is_template_param.
        let gi: mut i64 = 0;
        while (gi < cast<i64>(inst.generic_args.size())) {
            if (bound_type_is_template_param(arg_as_bound_type(inst.generic_args.at(cast<u64>(gi)).some))) {
                return new Option<BoundDefinition>.none();
            }
            gi = gi + 1;
        }
        let template_def: BoundDefinition = inst.type_definition.some;
        // class
        if (template_def is BoundDefinition.class_def) {
            let cls: BoundClassDefinition = template_def.class_def;
            if (cast<i64>(cls.generic_params.size()) == 0) { return new Option<BoundDefinition>.none(); }
            let mangled: string = MonomorphizePass.mangle_generic_name(cls.full_name, inst.generic_args);
            if (this.is_instantiation_already_exists(mangled, global_scope)) { return new Option<BoundDefinition>.none(); }
            let spec_result: Option<BoundDefinition> = this.specialize_class_def(cls, inst.generic_args, mangled, global_scope);
            if (spec_result.is_none()) { return new Option<BoundDefinition>.none(); }
            let injected: BoundDefinition = owner.specializing.run_specializing_for_spec(cls.full_name, inst, spec_result.some, global_scope);
            // Box interface forwarding (primitive interfaces round): AFTER the
            // source #specializing blocks (so forwarded impls never duplicate a
            // block-injected one — the has-impl check below skips those) and
            // BEFORE the caller's catch_up_def (so the forwarding method bodies
            // bind like any injected fragment).
            owner.specializing.try_inject_box_forwarding(cls.full_name, inst, injected, global_scope);
            owner.b1_record(this.spec_full_name(injected), "class", b1_site);
            owner.model.some.trace("monomorphize created specialization " + mangled);
            return new Option<BoundDefinition>.some(injected);
        }
        // enum
        if (template_def is BoundDefinition.enum_def) {
            let e: BoundEnumDefinition = template_def.enum_def;
            if (cast<i64>(e.generic_params.size()) == 0) { return new Option<BoundDefinition>.none(); }
            let mangled: string = MonomorphizePass.mangle_generic_name(e.full_name, inst.generic_args);
            if (this.is_instantiation_already_exists(mangled, global_scope)) { return new Option<BoundDefinition>.none(); }
            let spec_result: Option<BoundDefinition> = this.specialize_enum_def(e, inst.generic_args, mangled, global_scope);
            if (spec_result.is_none()) { return new Option<BoundDefinition>.none(); }
            let injected: BoundDefinition = owner.specializing.run_specializing_for_spec(e.full_name, inst, spec_result.some, global_scope);
            owner.b1_record(this.spec_full_name(injected), "enum", b1_site);
            owner.model.some.trace("monomorphize created specialization " + mangled);
            return new Option<BoundDefinition>.some(injected);
        }
        // interface
        if (template_def is BoundDefinition.interface_def) {
            let iface: BoundInterfaceDefinition = template_def.interface_def;
            if (cast<i64>(iface.generic_params.size()) == 0) { return new Option<BoundDefinition>.none(); }
            let mangled: string = MonomorphizePass.mangle_generic_name(iface.full_name, inst.generic_args);
            if (this.is_instantiation_already_exists(mangled, global_scope)) { return new Option<BoundDefinition>.none(); }
            let spec_result: Option<BoundDefinition> = this.specialize_interface_def(iface, inst.generic_args, mangled, global_scope);
            if (spec_result.is_none()) { return new Option<BoundDefinition>.none(); }
            let injected: BoundDefinition = owner.specializing.run_specializing_for_spec(iface.full_name, inst, spec_result.some, global_scope);
            owner.b1_record(this.spec_full_name(injected), "interface", b1_site);
            owner.model.some.trace("monomorphize created specialization " + mangled);
            return new Option<BoundDefinition>.some(injected);
        }
        return new Option<BoundDefinition>.none();
    }

    // M3: type-returning wrapper around ensure_specialized_def — the form the
    // penguin_meta_specialize responder (and M4 use-site routing) uses. Given
    // a template name + its generic args, return the specialized type (R2: type_def
    // = the specialized def, NO generic_args), creating + catch_up-ing the def if
    // it doesn't yet exist. Idempotent.
    fun ensure_specialized_type(mut this, template_name: string, type_args: _utils.List<BoundTypeArg>) -> BoundType {
        let owner: mut MonomorphizePass = this.owner.some;
        _utils.trace_enter("Enter ensure_specialized_type");
        // Batch 3.2 request-site tag: the M3/M4 meta `_template_X` responder
        // (JIT reentry through MetaHost.active_model, SemanticModel's host
        // API, and the pass-4+ use-site routing in try_resolve_template_instantiation).
        owner.b1_site = "meta-type";
        // catch_up_def takes `mut this`: rebind the (immutably-typed)
        // Option payload to a mutable binding first.
        let m: mut SemanticModel = owner.model.some;
        // The template name comes from meta code as a plain name — use the
        // anywhere-scan so namespaced / file-local templates still resolve
        // (user-code lookups never go through this path).
        let tmpl_sym: Option<BoundSymbol> = owner.model.some.global_scope.lookup_type_anywhere(template_name);
        if (tmpl_sym.is_none() || !(tmpl_sym.some is BoundSymbol.type_sym)) {
            return owner.model.some.type_registry.make_error_type();
        }
        // Full base name from the template def (the mangle encodes it, so
        // same-named templates in different namespaces never collide).
        let tmpl_bt: BoundType = tmpl_sym.some.type_sym.bound_type;
        let full_base: mut string = template_name;
        if (tmpl_bt.type_definition.is_some()) {
            let td: BoundDefinition = tmpl_bt.type_definition.some;
            if (td is BoundDefinition.class_def) { full_base = td.class_def.full_name; }
            if (td is BoundDefinition.enum_def) { full_base = td.enum_def.full_name; }
            if (td is BoundDefinition.interface_def) { full_base = td.interface_def.full_name; }
        }
        let mangled: string = MonomorphizePass.mangle_generic_name(full_base, type_args);
        let existing: Option<BoundSymbol> = owner.model.some.global_scope.lookup_type_in_scope(mangled);
        if (existing.is_some() && existing.some is BoundSymbol.type_sym) {
            return existing.some.type_sym.bound_type;
        }
        let inst: mut BoundType = tmpl_sym.some.type_sym.bound_type.with_generic_args(type_args);
        let spec: Option<BoundDefinition> = this.ensure_specialized_def(inst, owner.model.some.global_scope);
        if (spec.is_some()) {
            owner.model.some.trace("monomorphize ensured type " + mangled);
            // Late-created (M4 meta path): run it through the passes it missed and
            // register it in the compilation unit so it's emitted. (When this is
            // reached during pass_monomorphize the unit's normal loop already does
            // both, so this branch is for the on-demand / M4 caller.)
            if (owner.model.some.current_unit.is_some()) {
                m.a5_pass.bind_def_complete(spec.some, owner.model.some.current_unit.some);
                owner.model.some.current_unit.some.definitions.push(spec.some);
            }
        }
        let now: Option<BoundSymbol> = owner.model.some.global_scope.lookup_type_in_scope(mangled);
        if (now.is_some() && now.some is BoundSymbol.type_sym) {
            return now.some.type_sym.bound_type;
        }
        return owner.model.some.type_registry.make_error_type();
    }

    // Full name of a (possibly specialized) def, "" for shapes without one.
    fun spec_full_name(this, d: BoundDefinition) -> string {
        if (d is BoundDefinition.function_def) { return d.function_def.full_name; }
        if (d is BoundDefinition.class_def) { return d.class_def.full_name; }
        if (d is BoundDefinition.enum_def) { return d.enum_def.full_name; }
        if (d is BoundDefinition.interface_def) { return d.interface_def.full_name; }
        return "";
    }

    // The shipped-instance guard: the specialization's mangled full name is
    // <template full name>$<base62>. The template def must be lib-sourced
    // (its file shipped verbatim in a loaded lib's metadata). EXEMPT:
    // `__builtin.*` templates — core_builtin is compiled into EVERY binary,
    // so a consumer-local __builtin.Option<T> specialization mangling onto a
    // shipped instance name is the normal, ABI-identical case. Names without
    // '$' (old-style `__` mangling) cannot locate the template reliably —
    // accept them (pre-existing behavior).
    fun specialization_template_is_lib_sourced(mut this, d: BoundDefinition, result: BoundCompilationUnit) -> bool {
        let full: string = this.spec_full_name(d);
        let dollar: i64 = string_find(full, "$");
        if (dollar < 0) { return true; }
        let tmpl_full: string = string_substring(full, 0, dollar);
        if (string_starts_with(tmpl_full, "<global>.__builtin.")) { return true; }
        let found: Option<BoundDefinition> = this.find_def_by_full_name(result.definitions, tmpl_full);
        if (found.is_none()) { return true; }
        let td: BoundDefinition = found.some;
        if (td is BoundDefinition.class_def) { return td.class_def.is_lib_source; }
        if (td is BoundDefinition.enum_def) { return td.enum_def.is_lib_source; }
        if (td is BoundDefinition.interface_def) { return td.interface_def.is_lib_source; }
        if (td is BoundDefinition.function_def) { return td.function_def.is_lib_source; }
        return true;
    }

    fun find_def_by_full_name(mut this, defs: _utils.List<BoundDefinition>, full: string) -> Option<BoundDefinition> {
        let i: mut i64 = 0;
        while (i < cast<i64>(defs.size())) {
            let d: BoundDefinition = defs.at(cast<u64>(i)).some;
            if (this.spec_full_name(d) == full) {
                return new Option<BoundDefinition>.some(d);
            }
            if (d is BoundDefinition.namespace_def) {
                let nested: Option<BoundDefinition> = this.find_def_by_full_name(d.namespace_def.children, full);
                if (nested.is_some()) { return nested; }
            }
            i = i + 1;
        }
        return new Option<BoundDefinition>.none();
    }

    fun find_ast_def_by_name(this, defs: _utils.List<Definition>, name: string) -> Option<Definition> {
        _utils.trace_enter("Enter find_ast_def_by_name");
        // Search in reverse order so user-defined types override stdlib types
        let i: mut i64 = cast<i64>(defs.size()) - 1;
        while (i >= 0) {
            let def: Definition = defs.at(cast<u64>(i)).some;
            if (def is Definition.function_def) {
                if (def.function_def.name == name) {
                    return new Option<Definition>.some(def);
                }
            }
            if (def is Definition.class_def) {
                if (def.class_def.name == name) {
                    return new Option<Definition>.some(def);
                }
                // Also search class methods for generic method instantiation
                let members: _utils.List<Definition> = def.class_def.members;
                let mi: mut i64 = cast<i64>(members.size()) - 1;
                while (mi >= 0) {
                    let member: Definition = members.at(cast<u64>(mi)).some;
                    if (member is Definition.function_def) {
                        if (member.function_def.name == name) {
                            return new Option<Definition>.some(member);
                        }
                    }
                    mi = mi - 1;
                }
            }
            if (def is Definition.enum_def) {
                if (def.enum_def.name == name) {
                    return new Option<Definition>.some(def);
                }
            }
            if (def is Definition.interface_def) {
                if (def.interface_def.name == name) {
                    return new Option<Definition>.some(def);
                }
            }
            if (def is Definition.namespace_def) {
                let found: Option<Definition> = this.find_ast_def_by_name(def.namespace_def.children, name);
                if (found.is_some()) { return found; }
            }
            i = i - 1;
        }
        return new Option<Definition>.none();
    }

    // Rewrite a generic field type ("template def + generic_args") to its
    // SPECIALIZED sibling type, creating the specialization on demand. The
    // specialized BoundType (R2) carries the substituted definition and no
    // generic_args, so classification/byte_size/emitter all walk the same
    // substituted graph. Non-generic or already-specialized types pass through.
    fun resolve_field_specialization(mut this, bt: BoundType, global_scope: mut BoundScope) -> mut BoundType {
        let owner: mut MonomorphizePass = this.owner.some;
        // Batch 3.2 request-site tag: the field/payload cascade (pass-2/3
        // resolve_pair on specialized defs + the in-construction field walks).
        owner.b1_site = "resolve-cascade";
        if (bt.kind is TypeKind.EnumKind || bt.kind is TypeKind.ClassKind || bt.kind is TypeKind.InterfaceKind) {
            if (bt.type_definition.is_some() && cast<i64>(bt.generic_args.size()) > 0) {
                let td: BoundDefinition = bt.type_definition.some;
                let def_full: mut string = "";
                let is_generic_def: mut bool = false;
                if (td is BoundDefinition.class_def) {
                    def_full = td.class_def.full_name;
                    is_generic_def = cast<i64>(td.class_def.generic_params.size()) > 0;
                }
                if (td is BoundDefinition.enum_def) {
                    def_full = td.enum_def.full_name;
                    is_generic_def = cast<i64>(td.enum_def.generic_params.size()) > 0;
                }
                if (td is BoundDefinition.interface_def) {
                    def_full = td.interface_def.full_name;
                    is_generic_def = cast<i64>(td.interface_def.generic_params.size()) > 0;
                }
                if (is_generic_def && def_full != "") {
                    let mangled: string = MonomorphizePass.mangle_generic_name(def_full, bt.generic_args);
                    let found: Option<BoundSymbol> = global_scope.lookup_type_in_scope(mangled);
                    if (found.is_none()) {
                        // Create the sibling specialization now so the field type
                        // is never left stale (the fixpoint does not re-process
                        // already-created defs). ensure_specialized_def is
                        // idempotent and skips catch-up reentrancy.
                        let inst: BoundType = bt;
                        let spec: Option<BoundDefinition> = this.ensure_specialized_def(inst, global_scope);
                        if (spec.is_some()) {
                            // Complete the specialization exactly like the
                            // fixpoint loop does for its own: align AST/bound
                            // member types via resolve_pair (the copied methods
                            // keep unresolved template signatures — `v: T` —
                            // and pass 8 fails with "Cannot resolve symbol"
                            // without it), then register the def so passes 4-9
                            // process it (symbol binding, constructors,
                            // vtables, bodies, classification). During pass 3
                            // the unit to append to is THIS pass's result
                            // (model.current_unit is unset until pass 8); the
                            // pass-8 meta path uses current_unit. Without the
                            // push the def exists in the scope (call sites
                            // resolve, IR calls its _new) but never gets a
                            // constructor — undefined symbol at link time.
                            //
                            // NO eager classify here — defense line 2 of the
                            // late-classification protocol (batch 3.4 wording;
                            // see SemanticBindA5's header for the three lines).
                            // This is a DATA property, not a pass-numbering
                            // property: at this point the referencing
                            // field/payload has NOT yet been assigned the spec
                            // type, so a cycle walk still sees the TEMPLATE
                            // graph (which deliberately skips the
                            // variant-payload cycle check for generic_params
                            // > 0) and can settle a recursive spec as a VALUE
                            // class prematurely. Classification may only run
                            // on a fully substituted type graph — whoever owns
                            // that final pass at any point in the pipeline's
                            // evolution (the global classification run today,
                            // A5's per-def replay for late defs) is the
                            // authority; nothing between creation and then
                            // may classify.
                            let tmpl_short: mut string = "";
                            if (td is BoundDefinition.class_def) { tmpl_short = td.class_def.name; }
                            if (td is BoundDefinition.enum_def) { tmpl_short = td.enum_def.name; }
                            if (td is BoundDefinition.interface_def) { tmpl_short = td.interface_def.name; }
                            if (owner.model.some.current_unit.is_some()) {
                                // Pass-8 window: current_unit is set ONLY during
                                // pass 8 (active_result stays set from pass 3, so
                                // checking it first would misroute) — the global
                                // classify run (pass 7) is already over, so "push
                                // and the later passes process it" does NOT hold:
                                // only the dynamic pass-8 body loop remains. The
                                // shared tail force-completes the def (resolve at
                                // the monomorphize index, signature-level catch-up
                                // incl. classification, method-signature
                                // instantiation walk); without it the emitter
                                // defaults the class to a VALUE layout and
                                // recursive shapes die as E_SIZE_CYCLE
                                // (PortPayloadEnumChannelCycle), and signature
                                // instantiations lack layouts (bare-i64 ABI).
                                this.finish_late_spec_def(spec.some, tmpl_short, global_scope);
                            } else {
                                // Pre-pass-8 window (pass 2/3 resolution): the
                                // original protocol — resolve_pair at the
                                // ambient index and let the later global passes
                                // (4-9, incl. classify) process the pushed def.
                                let ast_def2: Option<Definition> = this.find_ast_def_by_name(owner.model.some.ast_definitions, tmpl_short);
                                if (ast_def2.is_some()) {
                                    owner.model.some.resolve_types_pass.resolve_pair(ast_def2.some, spec.some, global_scope);
                                }
                                if (owner.active_result.is_some()) {
                                    owner.active_result.some.definitions.push(spec.some);
                                }
                            }
                        }
                    }
                    let resolved: Option<BoundSymbol> = global_scope.lookup_type_in_scope(mangled);
                    if (resolved.is_some() && resolved.some is BoundSymbol.type_sym) {
                        let spec_bt: BoundType = resolved.some.type_sym.bound_type;
                        if (spec_bt.type_definition.is_some()) {
                            // Preserve the ORIGINAL field type's mutability: a
                            // `mut IIterator<T>` field (an iterator wrapper's src)
                            // must stay mut after the rewrite, or every
                            // `this.src.next()` (mut this) mis-binds as an
                            // immutable receiver.
                            return spec_bt.with_mutability(bt.mutability);
                        }
                    }
                }
            }
        }
        return bt;
    }

    fun specialize_class_def(mut this, tmpl: BoundClassDefinition, type_args: _utils.List<BoundTypeArg>, mangled_name: string, global_scope: mut BoundScope) -> Option<BoundDefinition> {        _utils.trace_enter("Enter specialize_class_def");
        let owner: mut MonomorphizePass = this.owner.some;
        let ast_def: Option<Definition> = this.find_ast_def_by_name(owner.model.some.ast_definitions, tmpl.name);
        if (ast_def.is_none()) { return new Option<BoundDefinition>.none(); }
        if (!(ast_def.some is Definition.class_def)) { return new Option<BoundDefinition>.none(); }

        let ast_class: ClassDefinition = ast_def.some.class_def;
        // Use the original template's scope parent (namespace scope) so that
        // type resolution within the specialized class can find sibling types
        let scope_parent: mut Option<BoundScope> = new Option<BoundScope>.some(global_scope);
        if (tmpl.scope.is_some()) {
            scope_parent = tmpl.scope.some.parent;
        }
        let parent_full_name: mut string = global_scope.full_name;
        if (scope_parent.is_some()) {
            parent_full_name = scope_parent.some.full_name;
        }
        let full_name: string = parent_full_name + "." + mangled_name;
        let result: mut BoundClassDefinition = new BoundClassDefinition(mangled_name, full_name);
        result.is_specialized = true;
        let class_scope: mut BoundScope = new BoundScope(new ScopeKind.ClassScope(), mangled_name, full_name, scope_parent);

        let pi: mut i64 = 0;
        while (pi < cast<i64>(tmpl.generic_params.size()) && pi < cast<i64>(type_args.size())) {
            let param_name: string = tmpl.generic_params.at(cast<u64>(pi)).some;
            let arg: BoundTypeArg = type_args.at(cast<u64>(pi)).some;
            let arg_type: BoundType = arg_as_bound_type(arg);
            let param_sym: mut BoundTypeSymbol = new BoundTypeSymbol(param_name, full_name + "." + param_name);
            param_sym.bound_type = arg_type.with_mutability(arg_type.mutability);
            class_scope.add_symbol(new BoundSymbol.type_sym(param_sym));
            pi = pi + 1;
        }

        // req5: copy value-param names and bind their concrete values (the synthetic
        // value BoundTypes ride type_args) so member binding can substitute N -> constant.
        let vni: mut i64 = 0;
        while (vni < cast<i64>(tmpl.value_param_names.size())) {
            let vpname: string = tmpl.value_param_names.at(cast<u64>(vni)).some;
            result.value_param_names.push(vpname);
            // D6: parallel text/kind lists (class value params are i64-only —
            // empty text, "i64" kind), so substitute_value_params can build
            // the typed literal for field initializers.
            result.value_param_texts.push("");
            result.value_param_kinds.push("i64");
            let idx: mut i64 = -1;
            let gpi: mut i64 = 0;
            while (gpi < cast<i64>(tmpl.generic_params.size())) {
                if (tmpl.generic_params.at(cast<u64>(gpi)).some == vpname) { idx = gpi; }
                gpi = gpi + 1;
            }
            if (idx >= 0 && idx < cast<i64>(type_args.size())) {
                let varg: BoundTypeArg = type_args.at(cast<u64>(idx)).some;
                if (varg is BoundTypeArg.value_arg) {
                    result.value_param_values.push(varg.value_arg.as_i64());
                } else {
                    result.value_param_values.push(0);
                }
            } else {
                result.value_param_values.push(0);
            }
            vni = vni + 1;
        }

        result.scope = new Option<BoundScope>.some(class_scope);
        let type_sym: mut BoundTypeSymbol = new BoundTypeSymbol(mangled_name, full_name);
        let t: mut BoundType = new BoundType();
        t.kind = new TypeKind.ClassKind();
        t.type_definition = new Option<BoundDefinition>.some(new BoundDefinition.class_def(result));
        type_sym.bound_type = t;
        result.type_symbol = new Option<BoundTypeSymbol>.some(type_sym);
        result.bound_type = t;
        global_scope.add_symbol(new BoundSymbol.type_sym(type_sym));

        let i: mut i64 = 0;
        while (i < cast<i64>(ast_class.members.size())) {
            let member: Definition = ast_class.members.at(cast<u64>(i)).some;
            if (member is Definition.class_field) {
                let ast_field: ClassFieldDefinition = member.class_field;
                let field: mut BoundClassFieldDefinition = new BoundClassFieldDefinition(ast_field.name);
                let field_full_name: string = full_name + "." + ast_field.name;
                let fsym: mut BoundVariableSymbol = new BoundVariableSymbol();
                fsym.name = ast_field.name;
                fsym.full_name = field_full_name;
                fsym.variable_kind = new VariableSymbolKind.Field();
                // Read mutability from AST type_spec
                if (let ts := ast_field.type_spec.some) {
                    if (ts.is_not_mutable) {
                        fsym.is_mutable = false;
                        field.mutability = new Mutability.Immutable();
                    } else if (ts.is_auto_mutability) {
                        fsym.is_mutable = true;
                        field.mutability = new Mutability.Auto();
                    } else {
                        fsym.is_mutable = true;
                        field.mutability = new Mutability.Mutable();
                    }
                    // resolve_type_specifier resolves a generic field type (e.g.
                    // `link: LinkedListLink<T>`) to the TEMPLATE definition with
                    // generic_args attached. Left as-is, the specialized class
                    // carries a stale template-shaped field type: classification
                    // skips the variant-payload cycle check for templates
                    // (generic_params > 0), byte_size() sizes the template graph
                    // while the emitter lays out the specialized one — divergent
                    // List slot strides (buffer overflow) and false E_SIZE_CYCLE
                    // on recursive structures. Rewrite the field to the SPECIALIZED
                    // sibling type, creating it on demand (idempotent, no
                    // catch_up reentrancy).
                    field.bound_type = this.resolve_field_specialization(
                        owner.model.some.resolve_type_specifier(ast_field.type_spec.some, class_scope),
                        global_scope);
                } else {
                    fsym.is_mutable = true;
                    field.mutability = new Mutability.Mutable();
                }
                fsym.bound_type = field.bound_type;
                field.field_symbol = new Option<BoundVariableSymbol>.some(fsym);
                class_scope.add_symbol(new BoundSymbol.variable(fsym));
                result.fields.push(new BoundDefinition.class_field(field));
            }
            if (member is Definition.function_def) {
                let bound_member: Option<BoundDefinition> = owner.model.some.build_scopes_pass.bind_function_def(member.function_def, class_scope);
                if (bound_member.is_some()) {
                    if (bound_member.some is BoundDefinition.function_def) {
                        result.methods.push(new BoundDefinition.function_def(bound_member.some.function_def));
                    } else {
                        result.methods.push(bound_member.some);
                    }
                }
            }
            if (member is Definition.impl_def) {
                let bound_impl: Option<BoundDefinition> = owner.model.some.build_scopes_pass.bind_impl_def(member.impl_def, class_scope);
                if (bound_impl.is_some()) {
                    result.interface_impls.push(bound_impl.some);
                }
            }
            i = i + 1;
        }

        // Preserve the template's generic params + AST source so member access can
        // distinguish a generic-param field (`a: T`, implicitly immutable) from a
        // concrete field (`b: i32`, Auto → follows container mutability).
        let gpi: mut i64 = 0;
        while (gpi < cast<i64>(tmpl.generic_params.size())) {
            result.generic_params.push(tmpl.generic_params.at(cast<u64>(gpi)).some);
            gpi = gpi + 1;
        }
        result.ast_source = new Option<Definition>.some(new Definition.class_def(ast_class));

        return new Option<BoundDefinition>.some(new BoundDefinition.class_def(result));
    }

    // D6/req5: extract value-template params (is_template_value_arg args) into
    // the destination lists (names/values/texts/kinds), positional via
    // tmpl.generic_params (which holds ALL params, type + value, in template order).
    // Shared by specialize_class/enum/interface/function_def. The `tmpl` is any
    // def exposing value_param_names + generic_params; the caller passes its four
    // output lists.
    fun extract_specialized_value_params(mut this, tmpl_generic_params: _utils.List<string>, tmpl_value_param_names: _utils.List<string>, type_args: _utils.List<BoundTypeArg>, out_names: mut _utils.List<string>, out_values: mut _utils.List<i64>, out_texts: mut _utils.List<string>, out_kinds: mut _utils.List<string>) {
        let vni: mut i64 = 0;
        while (vni < cast<i64>(tmpl_value_param_names.size())) {
            let vpname: string = tmpl_value_param_names.at(cast<u64>(vni)).some;
            out_names.push(vpname);
            let idx: mut i64 = -1;
            let gi: mut i64 = 0;
            while (gi < cast<i64>(tmpl_generic_params.size())) {
                if (tmpl_generic_params.at(cast<u64>(gi)).some == vpname) { idx = gi; }
                gi = gi + 1;
            }
            if (idx >= 0 && idx < cast<i64>(type_args.size())) {
                let arg: BoundTypeArg = type_args.at(cast<u64>(idx)).some;
                if (arg is BoundTypeArg.value_arg) {
                    out_values.push(arg.value_arg.as_i64());
                    out_texts.push(arg.value_arg.as_text());
                    out_kinds.push(arg.value_arg.kind_str());
                } else {
                    out_values.push(0);
                    out_texts.push("");
                    out_kinds.push("i64");
                }
            } else {
                out_values.push(0);
                out_texts.push("");
                out_kinds.push("i64");
            }
            vni = vni + 1;
        }
    }

    fun specialize_enum_def(mut this, tmpl: BoundEnumDefinition, type_args: _utils.List<BoundTypeArg>, mangled_name: string, global_scope: mut BoundScope) -> Option<BoundDefinition> {
        let owner: mut MonomorphizePass = this.owner.some;
        _utils.trace_enter("Enter specialize_enum_def");
        let ast_def: Option<Definition> = this.find_ast_def_by_name(owner.model.some.ast_definitions, tmpl.name);
        if (ast_def.is_none()) { return new Option<BoundDefinition>.none(); }
        if (!(ast_def.some is Definition.enum_def)) { return new Option<BoundDefinition>.none(); }

        let ast_enum: EnumDefinition = ast_def.some.enum_def;
        let scope_parent: mut Option<BoundScope> = new Option<BoundScope>.some(global_scope);
        if (tmpl.scope.is_some()) {
            scope_parent = tmpl.scope.some.parent;
        }
        let parent_full_name: mut string = global_scope.full_name;
        if (scope_parent.is_some()) {
            parent_full_name = scope_parent.some.full_name;
        }
        let full_name: string = parent_full_name + "." + mangled_name;
        let result: mut BoundEnumDefinition = new BoundEnumDefinition(mangled_name, full_name);
        result.is_specialized = true;
        let enum_scope: mut BoundScope = new BoundScope(new ScopeKind.EnumScope(), mangled_name, full_name, scope_parent);

        let pi: mut i64 = 0;
        while (pi < cast<i64>(tmpl.generic_params.size()) && pi < cast<i64>(type_args.size())) {
            let param_name: string = tmpl.generic_params.at(cast<u64>(pi)).some;
            let arg: BoundTypeArg = type_args.at(cast<u64>(pi)).some;
            // D6/req5: a value-template arg is a VALUE, not a type — skip binding it
            // as a type symbol (method bodies substitute it).
            if (!arg_is_value(arg)) {
                let arg_type: BoundType = arg_as_bound_type(arg);
                let param_sym: mut BoundTypeSymbol = new BoundTypeSymbol(param_name, full_name + "." + param_name);
                param_sym.bound_type = arg_type.with_mutability(arg_type.mutability);
                enum_scope.add_symbol(new BoundSymbol.type_sym(param_sym));
            }
            pi = pi + 1;
        }

        // D6/req5: extract value params for method-body substitution.
        this.extract_specialized_value_params(tmpl.generic_params, tmpl.value_param_names, type_args, result.value_param_names, result.value_param_values, result.value_param_texts, result.value_param_kinds);

        result.scope = new Option<BoundScope>.some(enum_scope);
        let type_sym: mut BoundTypeSymbol = new BoundTypeSymbol(mangled_name, full_name);
        let t: mut BoundType = new BoundType();
        t.kind = new TypeKind.EnumKind();
        t.type_definition = new Option<BoundDefinition>.some(new BoundDefinition.enum_def(result));
        type_sym.bound_type = t;
        result.type_symbol = new Option<BoundTypeSymbol>.some(type_sym);
        result.bound_type = t;
        global_scope.add_symbol(new BoundSymbol.type_sym(type_sym));

        let member_idx: mut i64 = 0;
        let i: mut i64 = 0;
        while (i < cast<i64>(ast_enum.members.size())) {
            let member: Definition = ast_enum.members.at(cast<u64>(i)).some;
            if (member is Definition.enum_member) {
                let payload_type: mut BoundType = owner.model.some.type_registry.void_type;
                if (member.enum_member.type_spec.is_some()) {
                    // Same as specialized class fields: resolve a generic payload
                    // (e.g. `next: LinkedListNode<T>`) past the template-with-args
                    // form to the specialized sibling type, creating it on demand.
                    // The specialized payload graph is what classification's
                    // cycle check and byte_size() must walk.
                    payload_type = this.resolve_field_specialization(
                        owner.model.some.resolve_type_specifier(member.enum_member.type_spec.some, enum_scope),
                        global_scope);
                }
                let m: mut BoundEnumMemberDefinition = new BoundEnumMemberDefinition(member.enum_member.name, member_idx, payload_type);
                let msym: mut BoundEnumMemberSymbol = new BoundEnumMemberSymbol(member.enum_member.name, full_name + "." + member.enum_member.name, t, member_idx, payload_type);
                m.member_symbol = new Option<BoundEnumMemberSymbol>.some(msym);
                enum_scope.add_symbol(new BoundSymbol.enum_member(msym));
                result.members.push(m);
                member_idx = member_idx + 1;
            }
            if (member is Definition.impl_def) {
                let bound_impl: Option<BoundDefinition> = owner.model.some.build_scopes_pass.bind_impl_def(member.impl_def, enum_scope);
                if (bound_impl.is_some()) {
                    result.interface_impls.push(bound_impl.some);
                }
            }
            if (member is Definition.function_def) {
                let bound_method: Option<BoundDefinition> = owner.model.some.build_scopes_pass.bind_function_def(member.function_def, enum_scope);
                if (bound_method.is_some()) {
                    let bm: mut BoundDefinition = bound_method.some;
                    if (bm is BoundDefinition.function_def) {
                        owner.model.some.resolve_types_pass.resolve_enum_method_pair(member.function_def, bm.function_def, enum_scope, result);
                        bm = new BoundDefinition.function_def(bm.function_def);
                    }
                    result.methods.push(bm);
                }
            }
            i = i + 1;
        }

        return new Option<BoundDefinition>.some(new BoundDefinition.enum_def(result));
    }

    // Specialize a generic interface for concrete type args (e.g. IFoo<T> -> IFoo__u8).
    // Re-binds each default method in a scope where the type params map to the args,
    // so a default method `fun bar(this: IFoo<T>) -> T` specializes its signature and
    // body (T -> u8). Without this, lower_interface_def emits the unspecialized
    // template default method with an unresolved T-typed return.
    fun specialize_interface_def(mut this, tmpl: BoundInterfaceDefinition, type_args: _utils.List<BoundTypeArg>, mangled_name: string, global_scope: mut BoundScope) -> Option<BoundDefinition> {
        let owner: mut MonomorphizePass = this.owner.some;
        _utils.trace_enter("Enter specialize_interface_def");
        let ast_def: Option<Definition> = this.find_ast_def_by_name(owner.model.some.ast_definitions, tmpl.name);
        if (ast_def.is_none()) { return new Option<BoundDefinition>.none(); }
        if (!(ast_def.some is Definition.interface_def)) { return new Option<BoundDefinition>.none(); }

        let ast_iface: InterfaceDefinition = ast_def.some.interface_def;
        let scope_parent: mut Option<BoundScope> = new Option<BoundScope>.some(global_scope);
        if (tmpl.scope.is_some()) {
            scope_parent = tmpl.scope.some.parent;
        }
        let parent_full_name: mut string = global_scope.full_name;
        if (scope_parent.is_some()) {
            parent_full_name = scope_parent.some.full_name;
        }
        let full_name: string = parent_full_name + "." + mangled_name;
        let result: mut BoundInterfaceDefinition = new BoundInterfaceDefinition(mangled_name, full_name);
        result.is_specialized = true;
        let iface_scope: mut BoundScope = new BoundScope(new ScopeKind.InterfaceScope(), mangled_name, full_name, scope_parent);

        // Register generic type params in the specialized scope so method
        // signatures and bodies resolve T -> the concrete type arg.
        let pi: mut i64 = 0;
        while (pi < cast<i64>(tmpl.generic_params.size()) && pi < cast<i64>(type_args.size())) {
            let param_name: string = tmpl.generic_params.at(cast<u64>(pi)).some;
            let arg: BoundTypeArg = type_args.at(cast<u64>(pi)).some;
            // D6/req5: a value-template arg is a VALUE, not a type — skip binding it
            // as a type symbol (default-method bodies substitute it).
            if (!arg_is_value(arg)) {
                let arg_type: BoundType = arg_as_bound_type(arg);
                let param_sym: mut BoundTypeSymbol = new BoundTypeSymbol(param_name, full_name + "." + param_name);
                param_sym.bound_type = arg_type.with_mutability(arg_type.mutability);
                iface_scope.add_symbol(new BoundSymbol.type_sym(param_sym));
            }
            pi = pi + 1;
        }

        // D6/req5: extract value params for default-method body substitution.
        this.extract_specialized_value_params(tmpl.generic_params, tmpl.value_param_names, type_args, result.value_param_names, result.value_param_values, result.value_param_texts, result.value_param_kinds);

        result.scope = new Option<BoundScope>.some(iface_scope);
        let type_sym: mut BoundTypeSymbol = new BoundTypeSymbol(mangled_name, full_name);
        let t: mut BoundType = new BoundType();
        t.kind = new TypeKind.InterfaceKind();
        t.type_definition = new Option<BoundDefinition>.some(new BoundDefinition.interface_def(result));
        type_sym.bound_type = t;
        result.type_symbol = new Option<BoundTypeSymbol>.some(type_sym);
        result.bound_type = t;
        global_scope.add_symbol(new BoundSymbol.type_sym(type_sym));

        let i: mut i64 = 0;
        while (i < cast<i64>(ast_iface.members.size())) {
            let member: Definition = ast_iface.members.at(cast<u64>(i)).some;
            if (member is Definition.function_def) {
                let bound_member: Option<BoundDefinition> = owner.model.some.build_scopes_pass.bind_function_def(member.function_def, iface_scope);
                if (bound_member.is_some()) {
                    // Resolve the default method's signature types (return/params) in
                    // the specialized scope (T -> arg) — bind_function_def only builds
                    // the symbol; without this the specialized interface's default
                    // method keeps a void return type and emits invalid LLVM.
                    let bm: mut BoundDefinition = bound_member.some;
                    if (bm is BoundDefinition.function_def) {
                        owner.model.some.resolve_types_pass.resolve_interface_method_pair(member.function_def, bm.function_def, iface_scope, result);
                        bm = new BoundDefinition.function_def(bm.function_def);
                    }
                    result.methods.push(bm);
                }
            }
            if (member is Definition.impl_def) {
                // Nested interface impl (interface inheritance): re-bind in the
                // specialized scope so the impl's `impl IFoo<T>` resolves T -> arg.
                let bound_impl: Option<BoundDefinition> = owner.model.some.build_scopes_pass.bind_impl_def(member.impl_def, iface_scope);
                if (bound_impl.is_some()) {
                    result.interface_impls.push(bound_impl.some);
                }
            }
            i = i + 1;
        }
        // Nested generic instantiations referenced by the resolved signatures
        // (e.g. IFuture<R>'s `poll -> FutureState<R>`) must be specialized too.
        // The pass-3 fixpoint cannot see them for specializations created on
        // demand at pass 8 (spawn/wait synthesis: the template AST only spells
        // FutureState<T>): without this the default method's body binds against
        // a template+args type with no emitted layout, which lowers to a bare
        // i64. Only the pass-8 path registers here — during pass 3 the
        // implementing class's own AST already supplies the nested
        // instantiation, and pre-registering it would make the fixpoint's
        // is_instantiation_already_exists check skip emitting it.
        if (owner.model.some.current_unit.is_some()) {
            let ni: mut i64 = 0;
            while (ni < cast<i64>(result.methods.size())) {
                let md: BoundDefinition = result.methods.at(cast<u64>(ni)).some;
                if (md is BoundDefinition.function_def) {
                    this.ensure_nested_specialization(md.function_def.return_type, global_scope);
                    let npi: mut i64 = 0;
                    while (npi < cast<i64>(md.function_def.parameters.size())) {
                        this.ensure_nested_specialization(md.function_def.parameters.at(cast<u64>(npi)).some.bound_type, global_scope);
                        npi = npi + 1;
                    }
                }
                ni = ni + 1;
            }
        }
        result.ast_source = new Option<Definition>.some(new Definition.interface_def(ast_iface));
        return new Option<BoundDefinition>.some(new BoundDefinition.interface_def(result));
    }

    // Ensure the generic instantiation carried by `bt` (template def + concrete
    // args) exists as a specialized def AND is registered in the current
    // compilation unit, so it is replayed through the remaining passes and its
    // layout is emitted. Recurses into the generic args (IFuture<List<i32>>
    // also needs List<i32>). Self-referential shapes terminate: the def's type
    // symbol is registered in the global scope before its members resolve, so
    // the re-entrant ensure hits the already-exists check.
    // ---- Pass-8 late-specialization completion ----
    // A specialization created during the pass-8 window (after the pass-3
    // fixpoint and the pass-7 classify run have both finished) must be fully
    // completed on demand or the emitter sees a half-built def: created
    // (ensure_specialized_def resolves FIELD types, cascading further creates)
    // -> resolve_pair at the monomorphize-protocol index 3 (method signatures;
    // stamping 8 would make every catch-up sub-pass skip — no vtables, no
    // classification, emitter defaults the class to a VALUE layout,
    // E_SIZE_CYCLE on recursive shapes) -> registered in the unit ->
    // catch_up_signature_passes (symbols/ctors/vtables/classify;
    // bodies stay with the dynamic pass-8 loop) -> RECURSE into the resolved
    // method SIGNATURES, whose generic instantiations (e.g. _ChanList.at ->
    // Option<T>) are invisible to both the finished fixpoint and the
    // field-type cascade (resolve_field_specialization only walks fields) —
    // without the walk they never get layouts and lower to bare i64
    // ("%t defined with type 'i64' but expected 'ptr'").
    fun complete_late_specialization(mut this, bt: BoundType, global_scope: mut BoundScope) {
        let owner: mut MonomorphizePass = this.owner.some;
        // Batch 3.2 request-site tag: the pass-8 late-completion cascade.
        owner.b1_site = "late-complete";
        if (bt.type_definition.is_none()) { return; }
        let td: BoundDefinition = bt.type_definition.some;
        let gp: mut i64 = 0;
        let full_base: mut string = "";
        let tmpl_short: mut string = "";
        if (td is BoundDefinition.class_def) {
            gp = cast<i64>(td.class_def.generic_params.size());
            full_base = td.class_def.full_name;
            tmpl_short = td.class_def.name;
        }
        if (td is BoundDefinition.enum_def) {
            gp = cast<i64>(td.enum_def.generic_params.size());
            full_base = td.enum_def.full_name;
            tmpl_short = td.enum_def.name;
        }
        if (td is BoundDefinition.interface_def) {
            gp = cast<i64>(td.interface_def.generic_params.size());
            full_base = td.interface_def.full_name;
            tmpl_short = td.interface_def.name;
        }
        if (gp > 0 && cast<i64>(bt.generic_args.size()) > 0 && full_base != "") {
            let mangled: string = MonomorphizePass.mangle_generic_name(full_base, bt.generic_args);
            if (global_scope.lookup_type_in_scope(mangled).is_none()
                && owner.model.some.current_unit.is_some()) {
                let spec: Option<BoundDefinition> = this.ensure_specialized_def(bt, global_scope);
                if (spec.is_some()) {
                    this.finish_late_spec_def(spec.some, tmpl_short, global_scope);
                }
            }
        }
        let ai: mut i64 = 0;
        while (ai < cast<i64>(bt.generic_args.size())) {
            let arg: BoundTypeArg = bt.generic_args.at(cast<u64>(ai)).some;
            if (!arg_is_value(arg)) {
                this.complete_late_specialization(arg_as_bound_type(arg), global_scope);
            }
            ai = ai + 1;
        }
    }

    // The resolve/register/catch-up/signature-recurse tail shared by the
    // pass-8 creation paths (resolve_field_specialization's nested cascade,
    // complete_late_specialization).
    fun finish_late_spec_def(mut this, spec: BoundDefinition, tmpl_short: string, global_scope: mut BoundScope) {
        let owner: mut MonomorphizePass = this.owner.some;
        let m: mut SemanticModel = owner.model.some;
        if (m.current_unit.is_none()) { return; }
        let unit8: mut BoundCompilationUnit = m.current_unit.some;
        let ast_def2: Option<Definition> = this.find_ast_def_by_name(m.ast_definitions, tmpl_short);
        if (ast_def2.is_some()) {
            // Batch 3.3a: resolve_pair stamps the monomorphize-protocol index
            // 3 by itself — no pass-pointer lowering. The signature catch-up
            // below then runs its per-processor guards in order (classify
            // included), never mistaking the def for a finished one.
            m.resolve_types_pass.resolve_pair(ast_def2.some, spec, global_scope);
        }
        // The pass-3 fixpoint collects `impl IFoo<u8>` interface
        // instantiations from every specialized class ("so the interface
        // and its default methods get specialized", see run()'s impl walk).
        // Close the same closure for the late pass-8 path BEFORE the
        // catch-up: build_vtable_slots resolves a default-method slot
        // against the SPECIALIZED interface def and falls back to the
        // unemitted template method when it is missing — an undefined
        // symbol at link time (e.g. a LatestChannel<W> wire spec created by
        // connect desugaring whose IFuture vtable slot referenced
        // __builtin_IFuture_do_wait instead of the IFuture<W> lift).
        this.late_ensure_def_interface_impls(spec, global_scope);
        unit8.definitions.push(spec);
        m.a5_pass.bind_def_signature(spec, unit8);
        this.late_ensure_def_signatures(spec, global_scope);
    }

    // Ensure every `impl X for <this def>` edge's INTERFACE specialization
    // exists (created + completed through the late protocol), so vtable
    // default-method slots can resolve to specialized defaults.
    fun late_ensure_def_interface_impls(mut this, def: BoundDefinition, global_scope: mut BoundScope) {
        if (def is BoundDefinition.class_def) {
            let k: mut i64 = 0;
            while (k < cast<i64>(def.class_def.interface_impls.size())) {
                let impl_d: BoundDefinition = def.class_def.interface_impls.at(cast<u64>(k)).some;
                if (impl_d is BoundDefinition.impl_def) {
                    this.complete_late_specialization(impl_d.impl_def.interface_type, global_scope);
                }
                k = k + 1;
            }
        }
        if (def is BoundDefinition.enum_def) {
            let k2: mut i64 = 0;
            while (k2 < cast<i64>(def.enum_def.interface_impls.size())) {
                let impl_e: BoundDefinition = def.enum_def.interface_impls.at(cast<u64>(k2)).some;
                if (impl_e is BoundDefinition.impl_def) {
                    this.complete_late_specialization(impl_e.impl_def.interface_type, global_scope);
                }
                k2 = k2 + 1;
            }
        }
    }

    // Walk a def's method signatures (class methods/constructors/impl blocks,
    // enum methods, interface methods) ensuring every generic instantiation
    // they mention exists as a completed specialization.
    fun late_ensure_def_signatures(mut this, def: BoundDefinition, global_scope: mut BoundScope) {
        if (def is BoundDefinition.class_def) {
            let cls: BoundClassDefinition = def.class_def;
            let i: mut i64 = 0;
            while (i < cast<i64>(cls.methods.size())) {
                this.late_ensure_fn_signature(cls.methods.at(cast<u64>(i)).some, global_scope);
                i = i + 1;
            }
            let j: mut i64 = 0;
            while (j < cast<i64>(cls.constructors.size())) {
                this.late_ensure_fn_signature(cls.constructors.at(cast<u64>(j)).some, global_scope);
                j = j + 1;
            }
            let k: mut i64 = 0;
            while (k < cast<i64>(cls.interface_impls.size())) {
                this.late_ensure_impl_signature(cls.interface_impls.at(cast<u64>(k)).some, global_scope);
                k = k + 1;
            }
            return;
        }
        if (def is BoundDefinition.enum_def) {
            let enm: BoundEnumDefinition = def.enum_def;
            let i: mut i64 = 0;
            while (i < cast<i64>(enm.methods.size())) {
                this.late_ensure_fn_signature(enm.methods.at(cast<u64>(i)).some, global_scope);
                i = i + 1;
            }
            let k: mut i64 = 0;
            while (k < cast<i64>(enm.interface_impls.size())) {
                this.late_ensure_impl_signature(enm.interface_impls.at(cast<u64>(k)).some, global_scope);
                k = k + 1;
            }
            return;
        }
        if (def is BoundDefinition.interface_def) {
            let iface: BoundInterfaceDefinition = def.interface_def;
            let i: mut i64 = 0;
            while (i < cast<i64>(iface.methods.size())) {
                this.late_ensure_fn_signature(iface.methods.at(cast<u64>(i)).some, global_scope);
                i = i + 1;
            }
            let k: mut i64 = 0;
            while (k < cast<i64>(iface.interface_impls.size())) {
                this.late_ensure_impl_signature(iface.interface_impls.at(cast<u64>(k)).some, global_scope);
                k = k + 1;
            }
            return;
        }
    }

    fun late_ensure_impl_signature(mut this, def: BoundDefinition, global_scope: mut BoundScope) {
        if (def is BoundDefinition.impl_def) {
            let i: mut i64 = 0;
            let mtds: _utils.List<BoundDefinition> = def.impl_def.methods;
            while (i < cast<i64>(mtds.size())) {
                this.late_ensure_fn_signature(mtds.at(cast<u64>(i)).some, global_scope);
                i = i + 1;
            }
        }
    }

    fun late_ensure_fn_signature(mut this, def: BoundDefinition, global_scope: mut BoundScope) {
        if (def is BoundDefinition.function_def) {
            let f: BoundFunctionDefinition = def.function_def;
            this.complete_late_specialization(f.return_type, global_scope);
            let i: mut i64 = 0;
            while (i < cast<i64>(f.parameters.size())) {
                this.complete_late_specialization(f.parameters.at(cast<u64>(i)).some.bound_type, global_scope);
                i = i + 1;
            }
        }
    }

    fun ensure_nested_specialization(mut this, bt: BoundType, global_scope: mut BoundScope) {
        let owner: mut MonomorphizePass = this.owner.some;
        // Batch 3.2 request-site tag: signature-nested instantiation cascade
        // (pass-8 specialized-interface default methods).
        owner.b1_site = "nested-sig";
        if (bt.type_definition.is_none()) { return; }
        let td: BoundDefinition = bt.type_definition.some;
        let is_generic: mut bool = false;
        if (td is BoundDefinition.class_def) { is_generic = cast<i64>(td.class_def.generic_params.size()) > 0; }
        if (td is BoundDefinition.enum_def) { is_generic = cast<i64>(td.enum_def.generic_params.size()) > 0; }
        if (td is BoundDefinition.interface_def) { is_generic = cast<i64>(td.interface_def.generic_params.size()) > 0; }
        if (is_generic && cast<i64>(bt.generic_args.size()) > 0) {
            let spec: Option<BoundDefinition> = this.ensure_specialized_def(bt, global_scope);
            let m: mut SemanticModel = owner.model.some;
            if (spec.is_some() && m.current_unit.is_some()) {
                let unit: mut BoundCompilationUnit = m.current_unit.some;
                unit.definitions.push(spec.some);
                m.a5_pass.bind_def_signature_before_bodies(spec.some, unit);
            }
        }
        let i: mut i64 = 0;
        while (i < cast<i64>(bt.generic_args.size())) {
            let arg: BoundTypeArg = bt.generic_args.at(cast<u64>(i)).some;
            if (!arg_is_value(arg)) {
                this.ensure_nested_specialization(arg_as_bound_type(arg), global_scope);
            }
            i = i + 1;
        }
    }

    fun specialize_function_def(mut this, tmpl: BoundFunctionDefinition, type_args: _utils.List<BoundTypeArg>, mangled_name: string, parent_scope: mut BoundScope, class_scope: Option<BoundScope>) -> Option<BoundDefinition> {
        let owner: mut MonomorphizePass = this.owner.some;
        _utils.trace_enter("Enter specialize_function_def");
        // Prefer the template's OWN AST def (unambiguous); the bare-name search
        // returns the LAST same-named def — e.g. FilterIterator.map for ANY
        // method named "map" — poisoning the specialization with another
        // class's params/body.
        let ast_def: Option<Definition> = if (tmpl.ast_source.is_some()) {
            tmpl.ast_source
        } else {
            this.find_ast_def_by_name(owner.model.some.ast_definitions, tmpl.name)
        };
        if (ast_def.is_none()) { return new Option<BoundDefinition>.none(); }
        if (!(ast_def.some is Definition.function_def)) { return new Option<BoundDefinition>.none(); }

        let ast_func: FunctionDefinition = ast_def.some.function_def;
        // Build the full_name:
        // - For methods in specialized generic classes, use the class_scope's full_name
        //   e.g. <global>.Foo__i32.foo__i64 (not <global>.Foo.foo__i64)
        // - For other methods, use the template's full_name with name replaced
        //   e.g. <global>.Foo.identity -> <global>.Foo.identity__string
        let full_name: string = this.build_specialized_full_name(tmpl, mangled_name, class_scope);
        let result: mut BoundFunctionDefinition = new BoundFunctionDefinition(mangled_name, full_name, ast_func.is_extern, ast_func.is_pure, ast_func.is_new, ast_func.is_extern);
        result.is_specialized = true;
        // Native-array intrinsics stay intrinsic through specialization (the
        // specialized body is still lowered by IRGenerator, not bound from AST).
        result.array_intrinsic = tmpl.array_intrinsic;
        // Carry the template's AST for body replay (bind_body_for_specialized_def
        // prefers ast_source over the ambiguous bare-name search). Re-wrap the
        // payload: the template binding is immutable, and its field read cannot
        // feed a mutable slot directly.
        result.ast_source = new Option<Definition>.some(ast_def.some);

        // D6: extract value-template params (is_template_value_arg args) into
        // result.value_param_names/values/texts so bind_body_for_def substitutes
        // them into the body. Positional via generic_params (which holds ALL params,
        // type + value, in template order).
        let vni: mut i64 = 0;
        while (vni < cast<i64>(tmpl.value_param_names.size())) {
            let vpname: string = tmpl.value_param_names.at(cast<u64>(vni)).some;
            result.value_param_names.push(vpname);
            let idx: mut i64 = -1;
            let gi: mut i64 = 0;
            while (gi < cast<i64>(tmpl.generic_params.size())) {
                if (tmpl.generic_params.at(cast<u64>(gi)).some == vpname) { idx = gi; }
                gi = gi + 1;
            }
            if (idx >= 0 && idx < cast<i64>(type_args.size())) {
                let arg: BoundTypeArg = type_args.at(cast<u64>(idx)).some;
                if (arg is BoundTypeArg.value_arg) {
                    result.value_param_values.push(arg.value_arg.as_i64());
                    result.value_param_texts.push(arg.value_arg.as_text());
                    result.value_param_kinds.push(arg.value_arg.kind_str());
                } else {
                    result.value_param_values.push(0);
                    result.value_param_texts.push("");
                    result.value_param_kinds.push("i64");
                }
            } else {
                result.value_param_values.push(0);
                result.value_param_texts.push("");
                result.value_param_kinds.push("i64");
            }
            vni = vni + 1;
        }

        // Declaration-only generics (the compiler-known __array_* intrinsics)
        // still need the specialization scope so the SIGNATURE resolves with
        // the type args bound (resolve_spec_pair falls back to the global
        // scope otherwise, where T is unbound).
        if (!ast_func.is_extern) {
            // Use class_scope as parent if available (for methods in specialized generic classes)
            // so that class type params (e.g., T=i32) are visible in the method body
            if (class_scope.is_some()) {
                let func_scope: mut BoundScope = new BoundScope(new ScopeKind.FunctionScope(), mangled_name, full_name + ".<body>", new Option<BoundScope>.some(class_scope.some));
                let pi: mut i64 = 0;
                while (pi < cast<i64>(tmpl.generic_params.size()) && pi < cast<i64>(type_args.size())) {
                    let param_name: string = tmpl.generic_params.at(cast<u64>(pi)).some;
                    let arg: BoundTypeArg = type_args.at(cast<u64>(pi)).some;
                    // D6: a value-template arg is a VALUE, not a type — skip binding it
                    // as a type symbol (the body substitutes it via
                    // value_param_names/values in bind_body_for_def).
                    if (!arg_is_value(arg)) {
                        let arg_type: BoundType = arg_as_bound_type(arg);
                        let param_sym: mut BoundTypeSymbol = new BoundTypeSymbol(param_name, full_name + "." + param_name);
                        param_sym.bound_type = arg_type.with_mutability(arg_type.mutability);
                        func_scope.add_symbol(new BoundSymbol.type_sym(param_sym));
                    }
                    pi = pi + 1;
                }
                result.scope = new Option<BoundScope>.some(func_scope);
            } else {
                let func_scope: mut BoundScope = new BoundScope(new ScopeKind.FunctionScope(), mangled_name, full_name + ".<body>", new Option<BoundScope>.some(parent_scope));
                let pi: mut i64 = 0;
                while (pi < cast<i64>(tmpl.generic_params.size()) && pi < cast<i64>(type_args.size())) {
                    let param_name: string = tmpl.generic_params.at(cast<u64>(pi)).some;
                    let arg: BoundTypeArg = type_args.at(cast<u64>(pi)).some;
                    // D6: a value-template arg is a VALUE, not a type — skip binding it
                    // as a type symbol (the body substitutes it via
                    // value_param_names/values in bind_body_for_def).
                    if (!arg_is_value(arg)) {
                        let arg_type: BoundType = arg_as_bound_type(arg);
                        let param_sym: mut BoundTypeSymbol = new BoundTypeSymbol(param_name, full_name + "." + param_name);
                        param_sym.bound_type = arg_type.with_mutability(arg_type.mutability);
                        func_scope.add_symbol(new BoundSymbol.type_sym(param_sym));
                    }
                    pi = pi + 1;
                }
                result.scope = new Option<BoundScope>.some(func_scope);
            }
        }

        let sym: mut BoundFunctionSymbol = new BoundFunctionSymbol(mangled_name, full_name);
        sym.is_extern = ast_func.is_extern;
        sym.is_static = result.is_static;
        sym.is_pure = ast_func.is_pure;
        sym.is_new = ast_func.is_new;
        result.symbol = new Option<BoundFunctionSymbol>.some(sym);
        // add_symbol would overwrite full_name, so we set enclosing_scope manually
        // and push directly to preserve the correct full_name.
        // The symbol must be reachable from CALL SITES, which resolve `name__args`
        // up their scope chain (function -> ... -> file namespace -> global). A
        // class-method template's enclosing scope is the CLASS scope — not on any
        // call site's chain — so register the symbol in the class's containing
        // namespace (the file namespace for top-level classes) instead.
        // Free-function templates keep their own enclosing scope (parent_scope is
        // already the file/namespace scope).
        if (parent_scope.kind is ScopeKind.ClassScope && parent_scope.parent.is_some()) {
            let ns_parent: mut BoundScope = parent_scope.parent.some;
            sym.enclosing_scope = new Option<BoundScope>.some(ns_parent);
            ns_parent.symbols.push(new BoundSymbol.function_sym(sym));
        } else {
            sym.enclosing_scope = new Option<BoundScope>.some(parent_scope);
            parent_scope.symbols.push(new BoundSymbol.function_sym(sym));
        }

        return new Option<BoundDefinition>.some(new BoundDefinition.function_def(result));
    }

    // Bind-time (pass-8) function specialization for INFERRED generic call
    // sites — no explicit <...> args at the call, so the pass-3 AST fixpoint
    // never collected the instantiation. Mirrors the collection loop's body
    // (mangle, dedupe, AST lookup, scopes, specialize, resolve_pair, this-fix)
    // but runs the resolve at pass index 3 (the monomorphize protocol —
    // resolving at 8 would stamp the def fully-processed and skip every
    // catch-up sub-pass) and replays with the pass-8 catch-up so the body
    // binds in the dynamic pass-8 window. Returns the specialized symbol.
    fun ensure_function_specialization_now(mut this, tmpl_def: BoundDefinition, type_args: _utils.List<BoundTypeArg>, result: mut BoundCompilationUnit) -> Option<BoundFunctionSymbol> {
        let owner: mut MonomorphizePass = this.owner.some;
        if (!(tmpl_def is BoundDefinition.function_def)) { return new Option<BoundFunctionSymbol>.none(); }
        // Batch 3.2: capture the ambient request-site at entry (call-explicit /
        // call-infer / call-genmethod — set by the BindExprCall sites).
        let b1_site: string = owner.b1_site;
        // Never specialize over unresolved template params (still-generic
        // bodies): garbage instantiations, unbounded when self-referential
        // (see bound_type_is_template_param).
        let k: mut i64 = 0;
        while (k < cast<i64>(type_args.size())) {
            if (bound_type_is_template_param(arg_as_bound_type(type_args.at(cast<u64>(k)).some))) {
                return new Option<BoundFunctionSymbol>.none();
            }
            k = k + 1;
        }
        let tmpl_func: BoundFunctionDefinition = tmpl_def.function_def;
        let mangled: string = MonomorphizePass.mangle_generic_name(tmpl_func.full_name, type_args);
        let j: mut i64 = 0;
        while (j < cast<i64>(result.definitions.size())) {
            let sd: BoundDefinition = result.definitions.at(cast<u64>(j)).some;
            if (sd is BoundDefinition.function_def) {
                if (sd.function_def.name == mangled && sd.function_def.symbol.is_some()) {
                    return new Option<BoundFunctionSymbol>.some(sd.function_def.symbol.some);
                }
            }
            j = j + 1;
        }
        let ast_def: Option<Definition> = if (tmpl_func.ast_source.is_some()) {
            tmpl_func.ast_source
        } else {
            this.find_ast_def_by_name(owner.model.some.ast_definitions, tmpl_func.name)
        };
        if (ast_def.is_none()) { return new Option<BoundFunctionSymbol>.none(); }
        // Derive the method's class scope from the TEMPLATE DEF ITSELF (its
        // function scope's parent is the class scope). The bare-name
        // find_method_class_scope is ambiguous now that several classes carry
        // same-named methods (map/filter/reduce/into on every iterator class)
        // — it attaches the spec to the WRONG class, so `this` and the class
        // type params never resolve.
        let scope_parent_is_class: bool = tmpl_func.scope.is_some()
            && tmpl_func.scope.some.parent.is_some()
            && tmpl_func.scope.some.parent.some.kind is ScopeKind.ClassScope;
        let method_class_scope: Option<BoundScope> = if (scope_parent_is_class) {
            new Option<BoundScope>.some(tmpl_func.scope.some.parent.some)
        } else {
            this.find_method_class_scope(result.definitions, new _utils.List<BoundDefinition>(), tmpl_func.name)
        };
        let tmpl_parent_scope: mut BoundScope = def_lookup_scope(tmpl_def, result.global_scope);
        // Batch 3.3a: no pass-pointer lowering — resolve_pair stamps the
        // protocol index itself and the catch-up guards are self-sufficient.
        let m8: mut SemanticModel = owner.model.some;
        let spec_result: Option<BoundDefinition> = this.specialize_function_def(tmpl_func, type_args, mangled, tmpl_parent_scope, method_class_scope);
        if (spec_result.is_none()) {
            return new Option<BoundFunctionSymbol>.none();
        }
        let resolved_spec: mut BoundDefinition = this.resolve_spec_pair(m8, ast_def.some, spec_result.some, result.global_scope);
        if (resolved_spec is BoundDefinition.function_def) {
            // Register template instantiations referenced by the signature
            // (return type + parameters) that the fixpoint never saw.
            this.ensure_signature_instantiations(resolved_spec.function_def.return_type, result);
            let spi: mut i64 = 0;
            while (spi < cast<i64>(resolved_spec.function_def.parameters.size())) {
                this.ensure_signature_instantiations(resolved_spec.function_def.parameters.at(cast<u64>(spi)).some.bound_type, result);
                spi = spi + 1;
            }
        }
        if (resolved_spec is BoundDefinition.function_def) {
            let parent_cls: Option<BoundClassDefinition> = this.find_parent_class_for_method(result.definitions, new _utils.List<BoundDefinition>(), resolved_spec.function_def.full_name);
            if (parent_cls.is_some()) {
                this.fix_this_param_type(resolved_spec.function_def, parent_cls.some);
            }
        }
        result.definitions.push(resolved_spec);
        if (resolved_spec is BoundDefinition.function_def) {
            owner.b1_record(resolved_spec.function_def.full_name, "fun", b1_site);
        }
        m8.a5_pass.bind_def_signature(resolved_spec, result);
        if (resolved_spec is BoundDefinition.function_def && resolved_spec.function_def.symbol.is_some()) {
            return new Option<BoundFunctionSymbol>.some(resolved_spec.function_def.symbol.some);
        }
        return new Option<BoundFunctionSymbol>.none();
    }

    // Recursively ensure the template instantiations a late-specialized
    // function's SIGNATURE references (return type, parameters). The pass-3
    // fixpoint already registered every instantiation visible in defs, but a
    // pass-8 ensure_function_specialization_now resolves types the fixpoint
    // never saw — e.g. __array_at<i32>'s return `Option<i32>` — and without a
    // specialized def the emitter finds no enum layout (the enum<X> fallback
    // degenerates to i64, corrupting the call ABI).
    fun ensure_signature_instantiations(mut this, bt: BoundType, result: mut BoundCompilationUnit) {
        let owner: mut MonomorphizePass = this.owner.some;
        // Batch 3.2 request-site tag: enum layouts referenced from a late-
        // specialized function's signature.
        owner.b1_site = "sig-enum";
        if (bt.type_definition.is_some() && cast<i64>(bt.generic_args.size()) > 0) {
            let td: BoundDefinition = bt.type_definition.some;
            // ENUM-ONLY: the emitter needs the specialized def's member layout
            // when the enum is only ever used as a return/payload spelling.
            // Classes/interfaces referenced from signatures get their
            // specializations through the ordinary use-site paths (new/call),
            // which bind bodies properly — forcing a layout-only class def
            // here would shadow that.
            let is_template: mut bool = false;
            if (td is BoundDefinition.enum_def) { is_template = cast<i64>(td.enum_def.generic_params.size()) > 0; }
            if (is_template) {
                // A late `is Option<i32>.none` check registers the TYPE SYMBOL
                // without ever creating the specialized DEF — and the emitter
                // builds layouts from defs, so the enum<X> spelling would fall
                // back to i64 and corrupt the ABI. Bypass the symbol-existence
                // gate: create + catch up + push the def directly when the
                // unit does not carry it yet.
                let td2: BoundDefinition = bt.type_definition.some;
                let mangled2: string = MonomorphizePass.mangle_generic_name(
                    (if (td2 is BoundDefinition.class_def) { td2.class_def.full_name }
                 else if (td2 is BoundDefinition.enum_def) { td2.enum_def.full_name }
                 else { td2.interface_def.full_name }),
                    bt.generic_args);
                let have_it: mut bool = false;
                let di: mut i64 = 0;
                while (di < cast<i64>(result.definitions.size())) {
                    let dd: BoundDefinition = result.definitions.at(cast<u64>(di)).some;
                    if (dd is BoundDefinition.enum_def && dd.enum_def.name == mangled2) { have_it = true; }
                    if (dd is BoundDefinition.class_def && dd.class_def.name == mangled2) { have_it = true; }
                    if (dd is BoundDefinition.interface_def && dd.interface_def.name == mangled2) { have_it = true; }
                    di = di + 1;
                }
                if (!have_it) {
                    // specialize_enum_def resolves member payload types during
                    // specialization, so the def is layout-complete on push.
                    // Do NOT stamp it processed: the emitter lowers the enum
                    // spec's OWN method list (is_some/is_none/value_or/
                    // get_unique_name/...) from this def and callers resolve
                    // to those methods directly — a layout-only def compiles
                    // each method to frame glue + `unreachable`, which at the
                    // machine level FALLS THROUGH into whatever function is
                    // emitted next (the ArrayNestedChainThenIterate segfault:
                    // Option<i32>.is_none fell into __array_at<i32>). The
                    // dynamic pass-8 loop (its bound is re-read per iteration)
                    // reaches late-pushed defs and binds their method bodies.
                    // specialize_enum_def builds the enum scope with the type
                    // args bound, so 'this' resolves.
                    //
                    // Batch 3.3a note: the historical `current_pass_index >= 8`
                    // catch-up gate here was DEAD CODE — every caller of this
                    // function lives inside ensure_function_specialization_now,
                    // which (pre-3.3a) lowered the stage to 3 for its whole
                    // window, so the condition never held: spec2 was only ever
                    // PUSHED (its bodies bind via the dynamic pass-8 loop).
                    // Removing the stage lowering flipped this gate live and
                    // changed the Array* layouts (relink 561/565); the
                    // push-only behavior is the verified one, kept explicitly.
                    let spec2: Option<BoundDefinition> = this.ensure_specialized_def(bt, result.global_scope);
                    if (spec2.is_some()) {
                        result.definitions.push(spec2.some);
                    }
                }
            }
        }
        let gi: mut i64 = 0;
        while (gi < cast<i64>(bt.generic_args.size())) {
            let a: BoundTypeArg = bt.generic_args.at(cast<u64>(gi)).some;
            if (!arg_is_value(a)) {
                this.ensure_signature_instantiations(arg_as_bound_type(a), result);
            }
            gi = gi + 1;
        }
    }

    // resolve_pair wrapper for ensure_function_specialization_now: picks the
    // spec's own scope when it has one (method bodies resolve there).
    fun resolve_spec_pair(mut this, m8: mut SemanticModel, ast_def: Definition, spec: BoundDefinition, global_scope: mut BoundScope) -> BoundDefinition {
        if (spec is BoundDefinition.function_def) {
            if (spec.function_def.scope.is_some()) {
                return m8.resolve_types_pass.resolve_pair(ast_def, spec, spec.function_def.scope.some);
            }
        }
        return m8.resolve_types_pass.resolve_pair(ast_def, spec, global_scope);
    }

    // Find the specialized class scope for a method, if its parent class has been specialized.
    // This is needed so that class type params (e.g., T=i32) are visible in method specializations.
    fun find_specialized_class_scope(this, defs: _utils.List<BoundDefinition>, method_name: string) -> Option<BoundScope> {
        let owner: mut MonomorphizePass = this.owner.some;
        _utils.trace_enter("Enter find_specialized_class_scope");
        let orig_name: string = owner.model.some.iface_layout_pass.extract_template_name(method_name);
        // Find the template class that owns this method
        let i: mut i64 = 0;
        while (i < cast<i64>(defs.size())) {
            let def: BoundDefinition = defs.at(cast<u64>(i)).some;
            if (def is BoundDefinition.class_def) {
                let cls: BoundClassDefinition = def.class_def;
                let mi: mut i64 = 0;
                while (mi < cast<i64>(cls.methods.size())) {
                    let md: BoundDefinition = cls.methods.at(cast<u64>(mi)).some;
                    if (md is BoundDefinition.function_def) {
                        if (md.function_def.name == orig_name) {
                            if (cls.is_generic_template) {
                                let spec_scope: Option<BoundScope> = this.find_class_specialization_scope(defs, cls.name);
                                if (spec_scope.is_some()) {
                                    return spec_scope;
                                }
                            }
                        }
                    }
                    mi = mi + 1;
                }
            }
            i = i + 1;
        }
        return new Option<BoundScope>.none();
    }

    fun find_class_specialization_scope(this, defs: _utils.List<BoundDefinition>, template_name: string) -> Option<BoundScope> {
        _utils.trace_enter("Enter find_class_specialization_scope");
        let i: mut i64 = 0;
        while (i < cast<i64>(defs.size())) {
            let def: BoundDefinition = defs.at(cast<u64>(i)).some;
            if (def is BoundDefinition.class_def) {
                let cls: BoundClassDefinition = def.class_def;
                if (!cls.is_generic_template && cls.scope.is_some()) {
                    // Check if this class name starts with template_name + "$"
                    // (new mangle) or the legacy "__" separator.
                    if (string_find(cls.name, template_name + "$") == 0 || string_find(cls.name, template_name + "__") == 0) {
                        return cls.scope;
                    }
                }
            }
            i = i + 1;
        }
        return new Option<BoundScope>.none();
    }

    fun find_method_class_scope(this, existing_defs: _utils.List<BoundDefinition>, new_defs: _utils.List<BoundDefinition>, method_name: string) -> Option<BoundScope> {
        let owner: mut MonomorphizePass = this.owner.some;
        _utils.trace_enter("Enter find_method_class_scope");
        let orig_name: string = owner.model.some.iface_layout_pass.extract_template_name(method_name);
        // Search existing defs
        let result: Option<BoundScope> = this.find_specialized_class_scope(existing_defs, method_name);
        if (result.is_some()) {
            return result;
        }
        // Search new (current batch) defs
        let mi: mut i64 = 0;
        while (mi < cast<i64>(new_defs.size())) {
            let sd: BoundDefinition = new_defs.at(cast<u64>(mi)).some;
            if (sd is BoundDefinition.class_def) {
                let sd_cls: BoundClassDefinition = sd.class_def;
                if (sd_cls.scope.is_some()) {
                    let sdi: mut i64 = 0;
                    while (sdi < cast<i64>(sd_cls.methods.size())) {
                        let smd: BoundDefinition = sd_cls.methods.at(cast<u64>(sdi)).some;
                        if (smd is BoundDefinition.function_def) {
                            if (smd.function_def.name == orig_name) {
                                return sd_cls.scope;
                            }
                        }
                        sdi = sdi + 1;
                    }
                }
            }
            mi = mi + 1;
        }
        return new Option<BoundScope>.none();
    }

    fun build_specialized_full_name(this, tmpl: BoundFunctionDefinition, mangled_name: string, class_scope: Option<BoundScope>) -> string {
        let owner: mut MonomorphizePass = this.owner.some;
        _utils.trace_enter("Enter build_specialized_full_name");
        if (class_scope.is_some()) {
            return class_scope.some.full_name + "." + mangled_name;
        }
        return owner.specializing.replace_name_in_full_name(tmpl.full_name, tmpl.name, mangled_name);
    }

    // Find the parent class for a method by extracting the class's full_name
    // from the function's full_name: everything before the last '.' — e.g.
    // "<global>._ns_f.Foo__i32.foo__i64" -> "<global>._ns_f.Foo__i32" (the
    // specialized class def's full_name, see build_specialized_full_name /
    // specialize_class_def). Matching by full_name (not simple name) keeps
    // file-local and specialized classes findable.
    fun find_parent_class_for_method(this, defs: _utils.List<BoundDefinition>, new_defs: _utils.List<BoundDefinition>, func_full_name: string) -> Option<BoundClassDefinition> {
        _utils.trace_enter("Enter find_parent_class_for_method");
        // Find the last dot: the prefix is the enclosing class's full_name.
        let last_dot: mut i64 = -1;
        let search_pos: mut i64 = 0;
        let full_len: i64 = string_length(func_full_name);
        while (search_pos < full_len) {
            let found: i64 = string_find_from(func_full_name, ".", search_pos);
            if (found < 0) {
                search_pos = full_len;
            } else {
                last_dot = found;
                search_pos = found + 1;
            }
        }
        if (last_dot >= 0) {
            let class_full_name: string = string_substring(func_full_name, 0, last_dot);
            let hit: Option<BoundClassDefinition> = this.find_class_by_full_name(defs, class_full_name);
            if (hit.is_some()) { return hit; }
            // Also search in new_defs (current batch)
            return this.find_class_by_full_name(new_defs, class_full_name);
        }
        return new Option<BoundClassDefinition>.none();
    }

    // Class lookup by full_name, recursing into namespace children (stdlib
    // classes live inside `namespace __builtin` — a flat top-level scan never
    // finds them, leaving specialized methods' `this` unresolved/void). The
    // def tree is acyclic, so plain recursion terminates.
    fun find_class_by_full_name(this, defs: _utils.List<BoundDefinition>, class_full_name: string) -> Option<BoundClassDefinition> {
        let i: mut i64 = 0;
        while (i < cast<i64>(defs.size())) {
            let def: BoundDefinition = defs.at(cast<u64>(i)).some;
            if (def is BoundDefinition.class_def) {
                if (def.class_def.full_name == class_full_name) {
                    return new Option<BoundClassDefinition>.some(def.class_def);
                }
            }
            if (def is BoundDefinition.namespace_def) {
                let inner: Option<BoundClassDefinition> = this.find_class_by_full_name(def.namespace_def.children, class_full_name);
                if (inner.is_some()) { return inner; }
            }
            i = i + 1;
        }
        return new Option<BoundClassDefinition>.none();
    }

    // Fix the 'this' parameter type for a specialized class method
    fun fix_this_param_type(this, func: mut BoundFunctionDefinition, cls: BoundClassDefinition) {
        let owner: mut MonomorphizePass = this.owner.some;
        _utils.trace_enter("Enter fix_this_param_type");
        let pi: mut i64 = 0;
        while (pi < cast<i64>(func.parameters.size())) {
            let bp: mut BoundFunctionParameter = func.parameters.at(cast<u64>(pi)).some;
            if (bp.is_this) {
                // Mirror resolve_class_method_pair's mutability rule: a `mut
                // this` method keeps a MUTABLE receiver type, or every
                // `this.next()`-style call inside the specialized body mis-binds
                // as an immutable receiver.
                if (func.is_new || bp.is_mutable) {
                    bp.bound_type = cls.bound_type.with_mutability(new Mutability.Mutable());
                } else {
                    bp.bound_type = cls.bound_type;
                }
                // Also update the function type on the symbol
                if (func.symbol.is_some()) {
                    let sym: mut BoundFunctionSymbol = func.symbol.some;
                    let param_types: mut _utils.List<BoundType> = new _utils.List<BoundType>();
                    let pj: mut i64 = 0;
                    while (pj < cast<i64>(func.parameters.size())) {
                        param_types.push(func.parameters.at(cast<u64>(pj)).some.bound_type);
                        pj = pj + 1;
                    }
                    sym.bound_type = owner.model.some.type_registry.make_function_type(func.return_type, param_types, false);
                    func.symbol = new Option<BoundFunctionSymbol>.some(sym);
                }
                return;
            }
            pi = pi + 1;
        }
    }
}

}
