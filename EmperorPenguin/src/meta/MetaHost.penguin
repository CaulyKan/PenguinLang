namespace emperor {

// Phase 6 v2: module-global pointer to the active MetaEngine, set by
// SemanticModel.seed_meta_engine before any JIT'd #fun runs. Single-threaded
// compile, so one global is safe. Read by the single host-callback bridge
// `penguin_meta_get_type`, which the caller-stub (and #typeof inside #fun
// bodies) use to turn a compile-time type token into the LIVE BoundType pointer.
//
// v2 removed the Round 1 per-op reflection responders (penguin_meta_field_count/
// field_name/type_name/…): reflection is now real-pointer reuse — unit B compiles
// the real emperor.BoundType, so t.fields()/methods()/variants() are direct method
// calls (weak-dedup → host's emperor_BoundType_* exports), no host callback per op.
//
// NOTE: held as a plain `mut MetaEngine` reference (not Option<MetaEngine>) so that
// a method call on it lowers to a direct ptr `this` argument. A value-type (Option)
// global is currently typed `i64` by the LLVM emitter, which would mis-lower `.some`.
// seed_meta_engine always sets this before any reflection runs, so the default
// empty MetaEngine() is never observed by the bridge.
let active_meta: mut MetaEngine = new MetaEngine();

fun penguin_meta_set_active(me: mut MetaEngine) {
    active_meta = me;
}

// Phase 6 v2 token→pointer bridge: resolve a compile-time type token back to the
// host's LIVE BoundType object (the one #typeof assigned the token for). Called
// from (a) the per-call-site caller-stub, to materialize each `type` argument as a
// real BoundType pointer before invoking the #fun; and (b) #typeof(T) inside a
// #fun body (so `t == #typeof(i32)` compares two interned BoundType pointers).
// Returns an empty BoundType() on any failure (caller treats as "unknown").
fun penguin_meta_get_type(token: i64) -> BoundType {
    let bt_opt: Option<BoundType> = active_meta.resolve_type_token(cast<u64>(token));
    if (bt_opt.is_some()) {
        return bt_opt.some;
    }
    return new BoundType();
}

// M6-step2 object bridge: recover a LIVE object from an object_ref address (a
// value-template object argument's live address in the compiler's GC heap).
// Implemented in C (std/c/core_builtin.c: emperor_penguin_meta_get_object,
// pure inttoptr) so it is callable from JIT'd #fun bodies via the
// meta_extern_decls extern — a PenguinLang body here would need unsafe_cast,
// which pass1's parser (BabyPenguin/ANTLR) does not accept. The #fun body
// casts the returned IReferenceType down to the concrete type before use.

// Phase 6 codegen bridge (kept from Round 1, NOT reflection): a #fun builds a
// code string at meta-runtime and #create_expression / #create_definition parse
// it (computed string → ast token). The literal-string fast path is compile-time
// (in MetaEngine.rewrite_meta_call_dispatch); this is the computed-string runtime
// path. Returns 0 on parse failure. (Reflection itself is real-reuse: t.fields()
// etc. are direct method calls — no host bridge.)
fun penguin_meta_create_expression(code: string) -> i64 {
    let lex: Lexer = new Lexer(code, "<meta_create_expression>");
    let toks: _utils.List<Token> = lex.tokenize();
    let p: Parser = new Parser(toks);
    let node: Expression = p.parse_expression();
    if (!p.has_errors()) {
        return cast<i64>(active_meta.register_ast_expression(node));
    }
    return 0;
}

fun penguin_meta_create_definition(code: string) -> i64 {
    let lex: Lexer = new Lexer(code, "<meta_create_definition>");
    let toks: _utils.List<Token> = lex.tokenize();
    let p: Parser = new Parser(toks);
    let unit: CompilationUnit = p.parse_compilationUnit();
    if (!p.has_errors()) {
        if (cast<i64>(unit.definitions.size()) == 1) {
            let def: Definition = unit.definitions.at(cast<u64>(0)).some;
            return cast<i64>(active_meta.register_ast_definition(def));
        }
    }
    return 0;
}

// R3c: parse a comma-separated argument list — e.g. the raw text of an
// `unstructured_ast` trailing block (`{ a, b }` → "a , b") — into a
// FunctionCallArguments AST node and register it as an ast token, so a #fun can
// introspect the arguments as a real node (unit B real-reuse, like type/ast).
// Returns 0 on parse failure (mirrors penguin_meta_create_expression).
fun penguin_meta_parse_arguments(code: string) -> i64 {
    let lex: Lexer = new Lexer(code, "<meta_parse_arguments>");
    let toks: _utils.List<Token> = lex.tokenize();
    let p: Parser = new Parser(toks);
    let fca: mut FunctionCallArguments = new FunctionCallArguments();
    while (!(p.stream.is_at_end())) {
        let before: i64 = p.stream.pos;
        let expr = p.parse_expression();
        fca.items.push(expr);
        if (p.stream.peek_type() is TokenType.Comma) { p.stream.advance(); }
        if (p.stream.pos == before) { break; }
    }
    if (!p.has_errors()) {
        return cast<i64>(active_meta.register_ast_expression(new Expression.function_call_arguments(fca)));
    }
    return 0;
}

// Phase 6 v2 Phase 5: return channels for `#fun -> type` and `#fun -> string`.
// The caller-stub stores the #fun's returned BoundType / string pointer into
// these globals (the stub returns i64 0 to the host's arity-0 trampoline); the
// host reads the value here — it can't recover a non-i64 reference from the i64
// trampoline return. Single-threaded compile ⇒ one slot each is safe.
let active_type_result: mut BoundType = new BoundType();
let active_string_result: mut string = "";
let active_double_result: mut f64 = 0.0;

fun penguin_meta_get_type_result() -> BoundType { return active_type_result; }
fun penguin_meta_get_string_result() -> string { return active_string_result; }
fun penguin_meta_get_double_result() -> f64 { return active_double_result; }

// M3 (#template -> #fun desugar): side-channel carrying the specialization request
// from the M4 use-site routing to the penguin_meta_specialize responder. The
// synthesized `_template_X` body ignores its own (cosmetic) params and reads these,
// because the responder has a fixed nullary-ish signature (name only) — value/object
// args can't all fit the heterogeneous-extern shape. Single-threaded ⇒ one slot.
let pending_specialize_name: mut string = "";
let pending_specialize_args: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();

fun penguin_meta_set_specialize_args(name: string, args: _utils.List<BoundTypeArg>) {
    pending_specialize_name = name;
    let dst: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
    let i: mut i64 = 0;
    while (i < cast<i64>(args.size())) {
        dst.push(args.at(cast<u64>(i)).some);
        i = i + 1;
    }
    pending_specialize_args = dst;
}

// M3: the `_template_X` body calls this. It asks the owning SemanticModel to
// specialize (creating the def + catch_up if needed) and returns the specialized
// type via the active_type_result channel (same pattern as #fun -> type).
fun penguin_meta_specialize(name: string) -> BoundType {
    let mut bt = active_model.ensure_specialized_type(pending_specialize_name, pending_specialize_args);
    active_type_result = bt;
    return bt;
}

// R1: compile-time diagnostics channel. active_model is the owning SemanticModel
// (set by seed_meta_engine, restored after unit-B clobber via owner_model back-ref).
// #error(msg) / #warn(msg) / #info(msg) in a #fun body route here → report_error/
// warning/info with a synthetic location. #error fails compilation; #warn/#info don't
// (has_errors filters to Error-severity only).
let active_model: mut SemanticModel = new SemanticModel();

fun penguin_meta_set_active_model(m: mut SemanticModel) {
    active_model = m;
}

fun penguin_meta_error(msg: string) {
    active_model.report_error(new ErrorCode.E_META(), msg, new SourceLocation("<meta>", 0, 0));
}

fun penguin_meta_warn(msg: string) {
    active_model.report_warning(new ErrorCode.E_META(), msg, new SourceLocation("<meta>", 0, 0));
}

fun penguin_meta_info(msg: string) {
    active_model.report_info(new ErrorCode.E_META(), msg, new SourceLocation("<meta>", 0, 0));
}

// #specializing: called by the synthesized callback for each executed `impl`
// statement. Pushes the impl's slot so the monomorphize hook can inject the
// fragment into the specialized class/enum after the callback returns.
fun penguin_meta_activate_impl(slot: i64) {
    active_meta.specializing_active_slots.push(slot);
}

// String-value bridge: a compile-time string literal passed as a #fun arg is
// stored in the MetaEngine string registry; the caller-stub calls this to
// materialize the live string pointer.
fun penguin_meta_get_string_value(token: i64) -> string {
    let s_opt: Option<string> = active_meta.get_string_value(cast<u64>(token));
    if (s_opt.is_some()) {
        return s_opt.some;
    }
    return "";
}

// M6: double-value bridge — a compile-time double literal passed as a #fun arg
// is stored in the MetaEngine double registry; the caller-stub calls this to
// materialize the live double.
fun penguin_meta_get_double_value(token: i64) -> f64 {
    let d_opt: Option<f64> = active_meta.get_double_value(cast<u64>(token));
    if (d_opt.is_some()) {
        return d_opt.some;
    }
    return 0.0;
}

// R2: ast real-reuse bridge — resolve a compile-time ast token to the live
// emperor.Expression node. Called by the caller-stub for `ast`-typed args
// (so the #fun receives a real Expression it can introspect) and for the
// ast-return conversion (stub: call @foo → token → get_ast_expression → store
// to active_ast_result).
fun penguin_meta_get_ast_expression(token: i64) -> Expression {
    let opt: Option<Expression> = active_meta.get_ast_expression(cast<u64>(token));
    if (opt.is_some()) {
        return opt.some;
    }
    return new Expression.constant(new ConstantExpression("0"));
}

// R2: ast-return channel — the caller-stub converts the #fun's returned token
// to an Expression via get_ast_expression, stores it here; the host reads it
// for splice (try_splice_meta_fun_call ast-return).
let active_ast_result: mut Expression = new Expression.constant(new ConstantExpression("0"));

fun penguin_meta_get_ast_result() -> Expression { return active_ast_result; }

// #compiler() facade responders — the real-proxy host callbacks behind
// compiler().<member>(). Each is a thin wrapper over the active MetaEngine /
// SemanticModel channels above (all unit B sees is the <meta_externs> decls).
// -------------------------------------------------------------------------

// Options: #define / #option / #defined sugar reaches the same store.
fun penguin_meta_set_option(key: string, value: string) { active_meta.set_option(key, value); }

fun penguin_meta_get_option(key: string) -> string {
    let o: Option<string> = active_meta.get_option(key);
    if (o.is_some()) { return o.some; }
    return "";
}

fun penguin_meta_has_option(key: string) -> bool { return active_meta.has_option(key); }

// Type / symbol resolution by qualified name. resolve_type_by_name returns
// Option<BoundType> directly (the AST-fallback path included), so no sentinel
// conversion needed.
fun penguin_meta_resolve_type(name: string) -> Option<BoundType> {
    return active_meta.resolve_type_by_name(name);
}

fun penguin_meta_has_type(name: string) -> bool {
    return active_meta.resolve_type_by_name(name).is_some();
}

fun penguin_meta_resolve_symbol(name: string) -> Option<BoundSymbol> {
    if (active_meta.global_scope.is_none()) { return new Option<BoundSymbol>.none(); }
    let parts: mut _utils.List<string> = new _utils.List<string>();
    let pos: mut i64 = 0;
    let len: i64 = string_length(name);
    while (pos < len) {
        let next_dot: i64 = string_find_from(name, ".", pos);
        if (next_dot < 0) {
            parts.push(string_substring(name, pos, len - pos));
            pos = len;
        } else {
            parts.push(string_substring(name, pos, next_dot - pos));
            pos = next_dot + 1;
        }
    }
    let resolved: Option<BoundSymbol> = active_meta.global_scope.some.resolve_qualified(parts);
    if (resolved.is_some()) { return resolved; }
    // Fallback for a bare (unqualified) symbol: it may live in a per-file
    // anonymous namespace (e.g. a top-level global in the user's file). Meta
    // reflection must see those — match master, which found them via the
    // global child-namespace scan.
    if (cast<i64>(parts.size()) == 1) {
        return active_meta.global_scope.some.lookup_symbol_anywhere(parts.at(cast<u64>(0)).some);
    }
    return new Option<BoundSymbol>.none();
}

// AST construction: create_ast parses a single-definition compilation unit
// first (so "fun foo() {...}" and class/enum/impl fragments work), falling back
// to an expression only if that fails (so "1+2" works too). NOT expression-first:
// parse_expression() on a `fun ...` fragment aborts with an E_INTERNAL
// "Invalid advance of token stream" before has_errors can be checked.
fun penguin_meta_create_ast(code: string) -> i64 {
    let lex: Lexer = new Lexer(code, "<meta_create_ast_def>");
    let toks: _utils.List<Token> = lex.tokenize();
    let p: Parser = new Parser(toks);
    let unit: CompilationUnit = p.parse_compilationUnit();
    if (!p.has_errors()) {
        if (cast<i64>(unit.definitions.size()) == 1) {
            return cast<i64>(active_meta.register_ast_definition(unit.definitions.at(cast<u64>(0)).some));
        }
    }
    let lex2: Lexer = new Lexer(code, "<meta_create_ast_expr>");
    let toks2: _utils.List<Token> = lex2.tokenize();
    let p2: Parser = new Parser(toks2);
    let node: Expression = p2.parse_expression();
    if (!p2.has_errors()) {
        return cast<i64>(active_meta.register_ast_expression(node));
    }
    return 0;
}

fun penguin_meta_create_empty_ast() -> i64 {
    let cb: mut CodeBlockExpression = new CodeBlockExpression();
    return cast<i64>(active_meta.register_ast_expression(new Expression.code_block(cb)));
}

fun penguin_meta_create_function_ast(name: string, return_type: BoundType, body: string) -> i64 {
    let src: string = "fun " + name + "() -> " + return_type.display_name() + " { " + body + " }";
    let lex: Lexer = new Lexer(src, "<meta_create_function_ast>");
    let toks: _utils.List<Token> = lex.tokenize();
    let p: Parser = new Parser(toks);
    let unit: CompilationUnit = p.parse_compilationUnit();
    if (!p.has_errors()) {
        if (cast<i64>(unit.definitions.size()) == 1) {
            return cast<i64>(active_meta.register_ast_definition(unit.definitions.at(cast<u64>(0)).some));
        }
    }
    return 0;
}

// Context: the enclosing class while the 5a class-member meta rewrite runs.
// Empty BoundType (display_name() == "void") when not inside a class.
fun penguin_meta_get_current_scope() -> BoundType {
    if (string_length(active_meta.current_scope_class_name) > 0) {
        let bt_opt: Option<BoundType> = active_meta.resolve_type_by_name(active_meta.current_scope_class_name);
        if (bt_opt.is_some()) {
            return bt_opt.some;
        }
    }
    return new BoundType();
}

}
