namespace emperor {

class SymbolRegEntry {
    symbol_full_name: !mut string = "";
    value: !mut IRValue = new IRValue.constant(new IRConstant("", ""));
    fun new(mut this, name: string, value: IRValue) {

        this.symbol_full_name = name;
        this.value = value;
    }
}

class LoopLabels {
    header: !mut IRLabel = new IRLabel("");
    exit: !mut IRLabel = new IRLabel("");
    fun new(mut this, header: IRLabel, exit: IRLabel) {

        this.header = header;
        this.exit = exit;
    }
}

class IRGenerator {
    builder: mut IRBuilder = new IRBuilder(new IRFunction("", "", new SourceLocation("", 0, 0)));
    symbol_regs: mut _utils.List<SymbolRegEntry> = new _utils.List<SymbolRegEntry>();
    loop_stack: mut _utils.List<LoopLabels> = new _utils.List<LoopLabels>();
    source_file: mut string = "";
    current_module: mut IRModule = new IRModule(new SourceLocation("", 0, 0));
    verbose: mut i64 = 0;

    fun new(mut this) {}

    fun make_loc(this, line: i64, col: i64) -> SourceLocation {
        _utils.trace_enter("Enter make_loc");
        return new SourceLocation(this.source_file, line, col);
    }

    // Extract source location from a bound symbol (if available)
    fun sym_loc(this, sym: Option<BoundSymbol>) -> SourceLocation {
        _utils.trace_enter("Enter sym_loc");
        if (let s := sym.some) {
            if (s is BoundSymbol.variable) {
                let l: SourceLocation = s.variable.location;
                return new SourceLocation(l.filename, l.line, l.col);
            }
            if (s is BoundSymbol.function_sym) {
                let l: SourceLocation = s.function_sym.location;
                return new SourceLocation(l.filename, l.line, l.col);
            }
            if (s is BoundSymbol.type_sym) {
                let l: SourceLocation = s.type_sym.location;
                return new SourceLocation(l.filename, l.line, l.col);
            }
            if (s is BoundSymbol.enum_member) {
                let l: SourceLocation = s.enum_member.location;
                return new SourceLocation(l.filename, l.line, l.col);
            }
        }
        return this.make_loc(0, 0);
    }

    fun sym_loc_func(this, sym: Option<BoundFunctionSymbol>) -> SourceLocation {
        _utils.trace_enter("Enter sym_loc_func");
        if (sym.is_some()) {
            let l: SourceLocation = sym.some.location;
            return new SourceLocation(l.filename, l.line, l.col);
        }
        return this.make_loc(0, 0);
    }

    fun generate(mut this, unit: BoundCompilationUnit) -> IRModule {
        _utils.trace_enter("Enter generate");
        let module: mut IRModule = new IRModule(unit.location);
        this.source_file = unit.location.filename;
        this.current_module = module;
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin IR] Generating IR for " + cast<string>(unit.definitions.size()) + " definitions..."); }
        let i: mut i64 = 0;
        while (i < cast<i64>(unit.definitions.size())) {
            this.lower_definition(unit.definitions.at(cast<u64>(i)).some, module);
            i = i + 1;
        }
        if (this.verbose >= 1) { __builtin.eprintln("[EmperorPenguin IR] Generated " + cast<string>(module.functions.size()) + " functions"); }
        return module;
    }

    fun lower_definition(mut this, def: BoundDefinition, module: mut IRModule) {
        _utils.trace_enter("Enter lower_definition");
        if (def is BoundDefinition.function_def) {
            this.lower_function_def(def.function_def, module);
        }
        if (def is BoundDefinition.namespace_def) {
            this.lower_namespace(def.namespace_def, module);
        }
        if (def is BoundDefinition.initial_routine) {
            this.lower_initial_routine(def.initial_routine, module);
        }
        if (def is BoundDefinition.class_def) {
            this.lower_class_def(def.class_def, module);
        }
        if (def is BoundDefinition.interface_def) {
            this.lower_interface_def(def.interface_def, module);
        }
        if (def is BoundDefinition.enum_def) {
            this.lower_enum_def(def.enum_def, module);
        }
        if (def is BoundDefinition.global_var_def) {
            this.lower_global_var_def(def.global_var_def, module);
        }
        if (def is BoundDefinition.impl_for_def) {
            this.lower_impl_for_def(def.impl_for_def, module);
        }
        // impl_def, type_ref_def, class_field
        // do not generate IR code
    }

    fun lower_impl_for_def(mut this, def: BoundInterfaceForImplementation, module: mut IRModule) {
        _utils.trace_enter("Enter lower_impl_for_def");
        // Primitive interface impls (`impl IHash for i64 { ... }`): lower each
        // mangled method (`hash$$i64`) as a plain function — call sites resolve
        // to direct calls (no vtable dispatch for primitives).
        let mi: mut i64 = 0;
        while (mi < cast<i64>(def.methods.size())) {
            let method_def: BoundDefinition = def.methods.at(cast<u64>(mi)).some;
            if (method_def is BoundDefinition.function_def) {
                this.lower_function_def(method_def.function_def, module);
            }
            mi = mi + 1;
        }
    }

    fun lower_namespace(mut this, def: BoundNamespaceDefinition, module: mut IRModule) {
        _utils.trace_enter("Enter lower_namespace");
        let i: mut i64 = 0;
        while (i < cast<i64>(def.children.size())) {
            this.lower_definition(def.children.at(cast<u64>(i)).some, module);
            i = i + 1;
        }
    }

    fun lower_function_def(mut this, def: BoundFunctionDefinition, module: mut IRModule) {
        _utils.trace_enter("Enter lower_function_def");
        if (def.is_generic_template) { return; }
        // Dyn-lib: the compiled symbol lives in a loaded .penguin-lib — emit a
        // declaration (with the def's real signature) so callers agree on the ABI
        // and link against the lib symbol instead of a local body.
        if (def.is_lib_export) {
            this.ensure_extern_decl_from_def(def, module);
            return;
        }
        if (this.verbose >= 2) { __builtin.eprintln("[EmperorPenguin IR]   Lowering function " + def.full_name); }
        let ret_type: string = this.bound_type_to_ir_type(def.return_type);
        let func_loc: SourceLocation = this.sym_loc_func(def.symbol);
        this.builder = new IRBuilder(new IRFunction(def.full_name, ret_type, func_loc));
        this.builder.func.display_name = def.name;
        this.builder.func.is_extern = def.is_extern;
        this.reset_locals();
        let this_reg: mut Option<IRValue> = new Option<IRValue>.none();
        let pi: mut i64 = 0;
        while (pi < cast<i64>(def.parameters.size())) {
            let p: BoundFunctionParameter = def.parameters.at(cast<u64>(pi)).some;
            let p_loc: SourceLocation = this.sym_loc_func(def.symbol);
            let _: IRValue = this.builder.func.alloc_param(p.name, this.bound_type_to_ir_type(p.bound_type), p_loc.line, p_loc.col);
            let param_full_name: string = def.full_name + ".<body>." + p.name;
            let arg_reg: IRValue = this.builder.emit_arg(p.name, pi, this.bound_type_to_ir_type(p.bound_type), p_loc);
            this.set_symbol_reg_by_name(param_full_name, arg_reg);
            if (p.name == "this") {
                this.set_symbol_reg_by_name("_this", arg_reg);
                this_reg = new Option<IRValue>.some(arg_reg);
            }
            pi = pi + 1;
        }
        // Constructors: emit field default initializers (`this.field = <init>`)
        // before the user body. The initializers were bound in the constructor
        // scope during pass_bind_expressions and stored on each bound field.
        if (def.is_new) {
            if (let this_val := this_reg.some) {
                if (cast<i64>(def.parameters.size()) > 0) {
                    let this_param: BoundFunctionParameter = def.parameters.at(cast<u64>(0)).some;
                    if (let cls_def := this_param.bound_type.type_definition.some) {
                        if (cls_def is BoundDefinition.class_def) {
                            let cls: BoundClassDefinition = cls_def.class_def;
                            let fi: mut i64 = 0;
                            while (fi < cast<i64>(cls.fields.size())) {
                                let field_def: BoundDefinition = cls.fields.at(cast<u64>(fi)).some;
                                if (field_def is BoundDefinition.class_field) {
                                    let field: BoundClassFieldDefinition = field_def.class_field;
                                    if (field.initializer.is_some()) {
                                        let field_loc: SourceLocation = this.sym_loc_func(def.symbol);
                                        let init_val: IRValue = this.lower_expression(field.initializer.some);
                                        this.builder.emit_wrmbr(this_val, field.name, init_val, field_loc);
                                    }
                                }
                                fi = fi + 1;
                            }
                        }
                    }
                }
            }
        }
        if (def.body.is_some()) {
            let _: IRValue = this.lower_expression(def.body.some);
        }
        if (!this.builder.func.has_terminator()) {
            this.builder.emit_ret_void(func_loc);
        }
        let func_ref: mut IRFunction = this.builder.func;
        module.add_function(func_ref);
    }

    fun lower_class_def(mut this, def: BoundClassDefinition, module: mut IRModule) {
        _utils.trace_enter("Enter lower_class_def");
        if (def.is_generic_template) { return; }
        let ctor_lowered: mut bool = false;
        let mi: mut i64 = 0;
        while (mi < cast<i64>(def.methods.size())) {
            let method_def: BoundDefinition = def.methods.at(cast<u64>(mi)).some;
            if (method_def is BoundDefinition.function_def) {
                if (method_def.function_def.is_new) {
                    this.lower_function_def(method_def.function_def, module);
                    ctor_lowered = true;
                } else {
                    this.lower_function_def(method_def.function_def, module);
                }
            }
            mi = mi + 1;
        }
        if (!ctor_lowered) {
            if (def.constructor.is_some()) {
                this.lower_function_def(def.constructor.some, module);
            }
        }
        let ii: mut i64 = 0;
        while (ii < cast<i64>(def.interface_impls.size())) {
            let impl_def: BoundDefinition = def.interface_impls.at(cast<u64>(ii)).some;
            if (impl_def is BoundDefinition.impl_def) {
                let iface_impl: BoundInterfaceImplementation = impl_def.impl_def;
                let imi: mut i64 = 0;
                while (imi < cast<i64>(iface_impl.methods.size())) {
                    let method_def: BoundDefinition = iface_impl.methods.at(cast<u64>(imi)).some;
                    if (method_def is BoundDefinition.function_def) {
                        this.lower_function_def(method_def.function_def, module);
                    }
                    imi = imi + 1;
                }
            }
            ii = ii + 1;
        }
    }

    fun lower_enum_def(mut this, def: BoundEnumDefinition, module: mut IRModule) {
        _utils.trace_enter("Enter lower_enum_def");
        // Skip methods for generic template enums — only specialized versions get lowered
        if (cast<i64>(def.generic_params.size()) > 0) { return; }
        // Lower direct enum methods
        let mi: mut i64 = 0;
        while (mi < cast<i64>(def.methods.size())) {
            let method_def: BoundDefinition = def.methods.at(cast<u64>(mi)).some;
            if (method_def is BoundDefinition.function_def) {
                this.lower_function_def(method_def.function_def, module);
            }
            mi = mi + 1;
        }
        // Lower interface impl methods
        let ii: mut i64 = 0;
        while (ii < cast<i64>(def.interface_impls.size())) {
            let impl_def: BoundDefinition = def.interface_impls.at(cast<u64>(ii)).some;
            if (impl_def is BoundDefinition.impl_def) {
                let iface_impl: BoundInterfaceImplementation = impl_def.impl_def;
                let imi: mut i64 = 0;
                while (imi < cast<i64>(iface_impl.methods.size())) {
                    let method_def: BoundDefinition = iface_impl.methods.at(cast<u64>(imi)).some;
                    if (method_def is BoundDefinition.function_def) {
                        this.lower_function_def(method_def.function_def, module);
                    }
                    imi = imi + 1;
                }
            }
            ii = ii + 1;
        }
    }

    fun lower_interface_def(mut this, def: BoundInterfaceDefinition, module: mut IRModule) {
        _utils.trace_enter("Enter lower_interface_def");
        // Generic interface templates are not emitted directly: their default
        // methods have unresolved type params (T -> error/ptr). They are
        // specialized per instantiation (IFoo<u8> -> IFoo__u8) and the
        // specialized defs (generic_params empty) emit the concrete methods.
        if (cast<i64>(def.generic_params.size()) > 0) {
            return;
        }
        let mi: mut i64 = 0;
        while (mi < cast<i64>(def.methods.size())) {
            let method_def: BoundDefinition = def.methods.at(cast<u64>(mi)).some;
            if (method_def is BoundDefinition.function_def) {
                if (method_def.function_def.body.is_some()) {
                    this.lower_function_def(method_def.function_def, module);
                }
            }
            mi = mi + 1;
        }
        // Emit nested-impl methods (interface inheritance): this interface
        // provides bodies for methods of other interfaces it implements. Without
        // emitting them, the inherited vtable slots reference undefined functions.
        let ii: mut i64 = 0;
        while (ii < cast<i64>(def.interface_impls.size())) {
            let impl_def: BoundDefinition = def.interface_impls.at(cast<u64>(ii)).some;
            if (impl_def is BoundDefinition.impl_def) {
                let nested_impl: BoundInterfaceImplementation = impl_def.impl_def;
                let mi2: mut i64 = 0;
                while (mi2 < cast<i64>(nested_impl.methods.size())) {
                    let method_def: BoundDefinition = nested_impl.methods.at(cast<u64>(mi2)).some;
                    if (method_def is BoundDefinition.function_def) {
                        if (method_def.function_def.body.is_some()) {
                            this.lower_function_def(method_def.function_def, module);
                        }
                    }
                    mi2 = mi2 + 1;
                }
            }
            ii = ii + 1;
        }
    }

    fun lower_initial_routine(mut this, def: BoundInitialRoutineDefinition, module: mut IRModule) {
        _utils.trace_enter("Enter lower_initial_routine");
        let loc: SourceLocation = this.sym_loc_func(def.symbol);
        this.builder = new IRBuilder(new IRFunction(def.full_name, "void", loc));
        this.builder.func.display_name = "initial";
        this.reset_locals();
        if (def.body.is_some()) {
            let _ = this.lower_expression(def.body.some);
        }
        if (!this.builder.func.has_terminator()) {
            this.builder.emit_ret_void(loc);
        }
        module.add_function(this.builder.func);
        module.entry_functions.push(this.builder.func);
    }

    fun lower_global_var_def(mut this, def: BoundGlobalVariableDefinition, module: mut IRModule) {
        _utils.trace_enter("Enter lower_global_var_def");
        let ir_type: string = this.bound_type_to_ir_type(def.bound_type);
        let global_name: string = this.clean_function_name(def.full_name);

        // Determine the initializer value
        let init_value: mut string = "0";
        if (ir_type == "ref<string>") {
            init_value = "null";
        }
        if (let init_expr := def.initializer.some) {
            if (init_expr is BoundExpression.literal) {
                init_value = init_expr.literal.value;
            }
        }

        let gv: IRGlobalVariable = new IRGlobalVariable(global_name, ir_type, init_value);
        module.add_global_variable(gv);

        // If the initializer is non-trivial (not a literal), emit a runtime init function
        if (let init_expr := def.initializer.some) {
            if (!(init_expr is BoundExpression.literal)) {
                let init_name: string = def.full_name + ".<init>";
                let loc: SourceLocation = this.make_loc(0, 0);
                let saved_builder: mut IRBuilder = this.builder;
                this.builder = new IRBuilder(new IRFunction(init_name, "void", loc));
                this.builder.func.display_name = "global_init";
                this.reset_locals();
                let val: IRValue = this.lower_expression(init_expr);
                this.builder.emit_global_store(global_name, val, loc);
                if (!this.builder.func.has_terminator()) {
                    this.builder.emit_ret_void(loc);
                }
                module.add_function(this.builder.func);
                module.init_functions.push(this.builder.func);
                this.builder = saved_builder;
            }
        }

        // Register the global in the symbol map so identifier lookups find it
        if (def.variable_symbol.is_some()) {
            let global_ref: IRValue = new IRValue.global_ref(new IRGlobalRef(global_name, ir_type));
            this.set_symbol_reg(new BoundSymbol.variable(def.variable_symbol.some), global_ref);
        }
    }

    fun lower_expression(mut this, expr: BoundExpression) -> IRValue {
        _utils.trace_enter("Enter lower_expression");
        if (expr is BoundExpression.literal) {
            return this.lower_literal(expr.literal);
        }
        if (expr is BoundExpression.identifier) {
            return this.lower_identifier(expr.identifier);
        }
        if (expr is BoundExpression.binary) {
            return this.lower_binary(expr.binary);
        }
        if (expr is BoundExpression.unary) {
            return this.lower_unary(expr.unary);
        }
        if (expr is BoundExpression.function_call) {
            return this.lower_function_call(expr.function_call);
        }
        if (expr is BoundExpression.code_block) {
            return this.lower_code_block(expr.code_block);
        }
        if (expr is BoundExpression.cast_expr) {
            return this.lower_cast(expr.cast_expr);
        }
        if (expr is BoundExpression.if_expr) {
            return this.lower_if_expr(expr.if_expr);
        }
        if (expr is BoundExpression.while_expr) {
            return this.lower_while_expr(expr.while_expr);
        }
        if (expr is BoundExpression.member_access) {
            return this.lower_member_access(expr.member_access);
        }
        if (expr is BoundExpression.new_expr) {
            return this.lower_new(expr.new_expr);
        }
        if (expr is BoundExpression.enum_variant) {
            return this.lower_enum_variant(expr.enum_variant);
        }
        if (expr is BoundExpression.try_bind) {
            return this.lower_try_bind(expr.try_bind);
        }
        __builtin.eprintln("error[E_INTERNAL]: Unhandled expression type in lower_expression");
        __builtin.exit(1);
        return this.builder.void_value();
    }

    // P2: lower a general try-bind expression. Produces the bool check result
    // and, on the matched path only, writes the extracted payload into the
    // pattern variable's register. The register gets a defensive zero write too
    // (two definitions) so scan_mutable_regs backs it with an alloca — the
    // `&&` RHS reads it at the merge point, which the write block does not
    // dominate, so it must be memory-backed rather than a plain SSA register.
    fun lower_try_bind(mut this, expr: BoundTryBindExpression) -> IRValue {
        _utils.trace_enter("Enter lower_try_bind");
        let loc: SourceLocation = this.make_loc(0, 0);
        let cond: IRValue = this.lower_expression(expr.check.some);
        let var_sym: BoundVariableSymbol = expr.variable_symbol.some;
        let ir_type: string = this.bound_type_to_ir_type(var_sym.bound_type);
        let a_reg: IRValue = this.builder.func.alloc_named_reg(var_sym.name, ir_type, var_sym.location.line, var_sym.location.col);
        this.set_symbol_reg(new BoundSymbol.variable(var_sym), a_reg);
        let then_lbl: IRLabel = this.builder.func.alloc_label("try_bind_then");
        let done_lbl: IRLabel = this.builder.func.alloc_label("try_bind_done");
        this.builder.emit_br_cond(cond, then_lbl, done_lbl, loc);
        this.builder.emit_label(then_lbl);
        // Defensive zero (2nd def so scan_mutable_regs backs the reg with an
        // alloca). Use `null` for pointer-typed pattern variables (interface /
        // reference class, ir_type "ptr" or "ref<...>") — `0` would emit an
        // invalid `store ptr 0`.
        let zero_val: mut string = "0";
        let is_ptr: mut bool = false;
        if (ir_type == "ptr") { is_ptr = true; }
        if (string_length(ir_type) >= 4 && string_substring(ir_type, 0, 4) == "ref<") { is_ptr = true; }
        if (is_ptr) { zero_val = "null"; }
        this.builder.emit_const_direct(a_reg, zero_val, loc);
        this.builder.emit_assign(a_reg, this.lower_expression(expr.extract.some), loc);
        this.builder.emit_br(done_lbl, loc);
        this.builder.emit_label(done_lbl);
        return cond;
    }

    fun lower_literal(mut this, expr: BoundLiteralExpression) -> IRValue {
        _utils.trace_enter("Enter lower_literal");
        let ir_type: string = this.bound_type_to_ir_type(expr.get_bound_type());
        let loc: SourceLocation = this.make_loc(0, 0);
        return this.builder.emit_const(expr.value, ir_type, loc);
    }

    fun lower_identifier(mut this, expr: BoundIdentifierExpression) -> IRValue {
        _utils.trace_enter("Enter lower_identifier");
        if (expr.symbol.is_some()) {
            // A function symbol used as a VALUE (fun-typed field default,
            // `let f: fun<i32,i32> = twice;`) — emit its code address as a
            // fat funptr constant instead of looking up a register.
            if (expr.symbol.some is BoundSymbol.function_sym) {
                let loc: SourceLocation = this.sym_loc(expr.symbol);
                let fname: string = this.clean_function_name(expr.symbol.some.function_sym.full_name);
                return this.builder.emit_const(fname, "funptr", loc);
            }
            let reg: Option<IRValue> = this.get_symbol_reg(expr.symbol.some);
            if (let val := reg.some) {
                // If this is a global reference, emit a load
                if (val is IRValue.global_ref) {
                    let ir_type: string = val.global_ref.ir_type;
                    let loc: SourceLocation = this.sym_loc(expr.symbol);
                    return this.builder.emit_global_load(val.global_ref.name, ir_type, loc);
                }
                return val;
            }
            // Check if this is a global variable symbol
            let sym: BoundSymbol = expr.symbol.some;
            if (sym is BoundSymbol.variable) {
                if (sym.variable.variable_kind is VariableSymbolKind.Global) {
                    let global_name: string = this.clean_function_name(sym.variable.full_name);
                    let ir_type: string = this.bound_type_to_ir_type(sym.variable.bound_type);
                    let loc: SourceLocation = this.sym_loc(expr.symbol);
                    return this.builder.emit_global_load(global_name, ir_type, loc);
                }
            }
            __builtin.eprintln("error[E_INTERNAL]: Symbol register not found for: " + expr.symbol.some.get_full_name());
            __builtin.exit(1);
        } else {
            __builtin.eprintln("error[E_INTERNAL]: Identifier expression has no symbol");
            __builtin.exit(1);
        }
        let loc: SourceLocation = this.sym_loc(expr.symbol);
        return this.builder.emit_const("unknown", "void", loc);
    }

    fun lower_binary(mut this, expr: BoundBinaryExpression) -> IRValue {
        _utils.trace_enter("Enter lower_binary");
        let ir_type: mut string = this.bound_type_to_ir_type(expr.get_bound_type());
        let loc: SourceLocation = this.make_loc(0, 0);
        if (cast<i64>(expr.operands.size()) == 0) {
            return this.builder.emit_const("0", ir_type, loc);
        }
        if (cast<i64>(expr.operands.size()) == 1) {
            return this.lower_expression(expr.operands.at(cast<u64>(0)).some);
        }

        // Lower first operand early to derive type if bound type is void
        let first: IRValue = this.lower_expression(expr.operands.at(cast<u64>(0)).some);
        if (ir_type == "void" || ir_type == "unknown") {
            let first_type: string = first.get_ir_type();
            if (first_type != "void" && first_type != "unknown") {
                ir_type = first_type;
            }
        }

        // Special handling for `is` expression (pattern matching / type check)
        if (cast<i64>(expr.operators.size()) > 0) {
            let first_op: BinaryOperator = expr.operators.at(cast<u64>(0)).some;
            if (first_op is BinaryOperator.Is) {
                let left: IRValue = this.lower_expression(expr.operands.at(cast<u64>(0)).some);
                let right: BoundExpression = expr.operands.at(cast<u64>(1)).some;
                // Enum variant check: x is EnumType.Variant
                if (right is BoundExpression.member_access) {
                    let ma: BoundMemberAccessExpression = right.member_access;
                    if (let sym := ma.member_symbol.some) {
                        if (sym is BoundSymbol.enum_member) {
                            let idx_const: IRValue = this.builder.emit_const(cast<string>(sym.enum_member.enum_value), "i64", loc);
                            return this.builder.emit_isenum(left, idx_const, loc);
                        }
                    }
                }
                // Enum variant check via a BoundEnumVariant reference (used by the
                // try-bind desugar, which carries the variant index directly).
                if (right is BoundExpression.enum_variant) {
                    let ev: BoundEnumVariantExpression = right.enum_variant;
                    let idx_const: IRValue = this.builder.emit_const(cast<string>(ev.variant_idx), "i64", loc);
                    return this.builder.emit_isenum(left, idx_const, loc);
                }
                // Interface/class type check: x is InterfaceType or x is ClassName
                if (right is BoundExpression.identifier) {
                    let id_expr: BoundIdentifierExpression = right.identifier;
                    if (let sym := id_expr.symbol.some) {
                        if (sym is BoundSymbol.type_sym) {
                            let type_id: string = sym.type_sym.full_name;
                            return this.builder.emit_isinstance(left, type_id, loc);
                        }
                    }
                }
                // Fallback: emit false constant
                return this.builder.emit_const_bool(false, loc);
            }
        }

        // Short-circuit evaluation for && and ||. The straight-line chain
        // (lower_binary_chain) evaluates ALL operands via `and`/`or`, which is
        // wrong for logical operators: `a && b` must NOT evaluate b when a is
        // false (e.g. `opt.is_some() && opt.some.field` would dereference opt.some
        // on a none Option -> NULL/wild deref). Detect a pure-&& or pure-|| chain
        // and lower it with branches so the RHS is only evaluated when needed.
        let all_and: mut bool = true;
        let all_or: mut bool = true;
        let oi: mut i64 = 0;
        while (oi < cast<i64>(expr.operators.size())) {
            let op: BinaryOperator = expr.operators.at(cast<u64>(oi)).some;
            let is_and_op: bool = op is BinaryOperator.LogicalAnd;
            let is_or_op: bool = op is BinaryOperator.LogicalOr;
            if (!is_and_op) { all_and = false; }
            if (!is_or_op) { all_or = false; }
            oi = oi + 1;
        }
        if (all_and) {
            if (cast<i64>(expr.operators.size()) > 0) {
                return this.lower_short_circuit(expr, true);
            }
        }
        if (all_or) {
            if (cast<i64>(expr.operators.size()) > 0) {
                return this.lower_short_circuit(expr, false);
            }
        }

        return this.lower_binary_chain(expr, ir_type, 1, first);
    }

    // Lower a short-circuited logical chain: for `&&`, stop at the first false
    // operand; for `||`, stop at the first true operand. Each operand is evaluated
    // only if the result is not yet determined. The result temp is assigned in
    // each block and read at the merge point.
    fun lower_short_circuit(mut this, expr: BoundBinaryExpression, is_and: bool) -> IRValue {
        _utils.trace_enter("Enter lower_short_circuit");
        let loc: SourceLocation = this.make_loc(0, 0);
        let result: IRValue = this.builder.func.alloc_temp("bool");
        let merge_lbl: IRLabel = this.builder.func.alloc_label("sc_merge");
        let n: i64 = cast<i64>(expr.operands.size());
        let i: mut i64 = 0;
        while (i < n) {
            let val: IRValue = this.lower_expression(expr.operands.at(cast<u64>(i)).some);
            this.builder.emit_assign(result, val, loc);
            if (i < n - 1) {
                let next_lbl: IRLabel = this.builder.func.alloc_label("sc_next");
                if (is_and) {
                    // && : if val is false, short-circuit to merge (result = val);
                    //      otherwise evaluate the next operand.
                    this.builder.emit_br_cond(val, next_lbl, merge_lbl, loc);
                } else {
                    // || : if val is true, short-circuit to merge (result = val);
                    //      otherwise evaluate the next operand.
                    this.builder.emit_br_cond(val, merge_lbl, next_lbl, loc);
                }
                this.builder.emit_label(next_lbl);
            }
            i = i + 1;
        }
        if (!this.builder.func.has_terminator()) {
            this.builder.emit_br(merge_lbl, loc);
        }
        this.builder.emit_label(merge_lbl);
        return result;
    }

    fun lower_binary_chain(mut this, expr: BoundBinaryExpression, ir_type: string, idx: i64, accum: IRValue) -> IRValue {
        _utils.trace_enter("Enter lower_binary_chain");
        if (idx >= cast<i64>(expr.operands.size())) {
            return accum;
        }
        let right: IRValue = this.lower_expression(expr.operands.at(cast<u64>(idx)).some);
        let op_idx: i64 = idx - 1;
        if (op_idx >= cast<i64>(expr.operators.size())) {
            return accum;
        }
        let op: BinaryOperator = expr.operators.at(cast<u64>(op_idx)).some;
        let ir_op: string = this.binary_op_to_ir(op);
        let loc: SourceLocation = this.make_loc(0, 0);
        return this.lower_binary_chain(expr, ir_type, idx + 1, this.builder.emit_binop(ir_op, accum, right, ir_type, loc));
    }

    fun lower_unary(mut this, expr: BoundUnaryExpression) -> IRValue {
        _utils.trace_enter("Enter lower_unary");
        let ir_type: mut string = this.bound_type_to_ir_type(expr.get_bound_type());
        let loc: SourceLocation = this.make_loc(0, 0);
        if (expr.operand.is_some()) {
            let operand: IRValue = this.lower_expression(expr.operand.some);
            if (ir_type == "void" || ir_type == "unknown") {
                let op_type: string = operand.get_ir_type();
                if (op_type != "void" && op_type != "unknown") {
                    ir_type = op_type;
                }
            }
            let op: string = this.unary_op_to_ir(expr.operator_value);
            return this.builder.emit_unaryop(op, operand, ir_type, loc);
        }
        __builtin.eprintln("error[E_INTERNAL]: Unary expression has no operand");
        __builtin.exit(1);
        return this.builder.emit_const("0", ir_type, loc);
    }

    fun lower_function_call(mut this, expr: BoundFunctionCallExpression) -> IRValue {
        _utils.trace_enter("Enter lower_function_call");
        // Pointer intrinsics: dispatched by the synthetic callee full_name set in
        // SemanticModel.bind_meta_call (#__address_of / #__load / #__store).
        if (expr.callee_symbol.is_some()) {
            let sym: BoundSymbol = expr.callee_symbol.some;
            if (sym is BoundSymbol.function_sym) {
                let iname: string = sym.function_sym.full_name;
                if (iname == "<intrinsic>.address_of") {
                    let loc: SourceLocation = this.sym_loc(expr.callee_symbol);
                    let operand: IRValue = this.lower_expression(expr.arguments.at(cast<u64>(0)).some);
                    return this.builder.emit_address_of(operand, loc);
                }
                if (iname == "<intrinsic>.load") {
                    let loc: SourceLocation = this.sym_loc(expr.callee_symbol);
                    let addr: IRValue = this.lower_expression(expr.arguments.at(cast<u64>(0)).some);
                    let elem_ir_type: string = this.bound_type_to_ir_type(expr.get_bound_type());
                    return this.builder.emit_load_ptr(addr, elem_ir_type, loc);
                }
                if (iname == "<intrinsic>.store") {
                    let loc: SourceLocation = this.sym_loc(expr.callee_symbol);
                    let addr: IRValue = this.lower_expression(expr.arguments.at(cast<u64>(0)).some);
                    let v: IRValue = this.lower_expression(expr.arguments.at(cast<u64>(1)).some);
                    this.builder.emit_store_ptr(addr, v, v.get_ir_type(), loc);
                    return this.builder.void_value();
                }
            }
        }
        let args: mut _utils.List<IRValue> = new _utils.List<IRValue>();
        let ai: mut i64 = 0;
        while (ai < cast<i64>(expr.arguments.size())) {
            args.push(this.lower_expression(expr.arguments.at(cast<u64>(ai)).some));
            ai = ai + 1;
        }
        // Track if this is a method call on a generic type for name mangling
        let has_generic_receiver: mut bool = false;
        let generic_args_list: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
        let template_class_name: mut string = "";
        let template_class_name_full: mut string = "";
        // Whether the callee's first parameter is `this` (set when the callee is
        // resolved below). Drives whether the receiver is passed / used for the
        // virtual vtable lookup.
        let first_param_is_this: mut bool = false;
        if (let callee_expr := expr.callee.some) {
            if (callee_expr is BoundExpression.member_access) {
                let ma: BoundMemberAccessExpression = callee_expr.member_access;
                if (ma.base_expr.is_some() && expr.callee_symbol.is_some()) {
                    let sym: BoundSymbol = expr.callee_symbol.some;
                    if (sym is BoundSymbol.variable) {
                        // fun-typed FIELD call: `h.cb(21)` where
                        // `cb: mut fun<i32, i32>` — load the field (a fat
                        // function pointer) and call through it.
                        let ftype: BoundType = sym.variable.bound_type;
                        if (ftype.kind is TypeKind.FunctionKind) {
                            let loc: SourceLocation = this.sym_loc(expr.callee_symbol);
                            let obj: IRValue = this.lower_expression(ma.base_expr.some);
                            let fnptr: IRValue = this.builder.emit_rdmbr(obj, ma.member_name, this.bound_type_to_ir_type(ftype), loc);
                            let args: mut _utils.List<IRValue> = new _utils.List<IRValue>();
                            let ai: mut i64 = 0;
                            while (ai < cast<i64>(expr.arguments.size())) {
                                args.push(this.lower_expression(expr.arguments.at(cast<u64>(ai)).some));
                                ai = ai + 1;
                            }
                            let ret_type: string = this.bound_type_to_ir_type(expr.get_bound_type());
                            let result: Option<IRValue> = this.builder.emit_call_indirect(fnptr, args, ret_type, loc);
                            if (result.is_some()) { return result.some; }
                            return this.builder.void_value();
                        }
                    }
                    if (sym is BoundSymbol.function_sym) {
                        // Whether the callee's first parameter is `this`. If not, the
                        // receiver is discarded (not passed) -- for interface-typed
                        // receivers it is still used for vtable lookup (virtual).
                        if (cast<i64>(sym.function_sym.parameters.size()) > 0) {
                            if (sym.function_sym.parameters.at(cast<u64>(0)).some.is_this) {
                                first_param_is_this = true;
                            }
                        }
                        // For direct dispatch (boxing optimization), use the original value
                        // expression without boxing
                        let dd_val: IRValue = this.lower_direct_dispatch_this(ma, expr);
                        let new_args: mut _utils.List<IRValue> = new _utils.List<IRValue>();
                        // Check if this is a namespace-qualified call (e.g., __builtin._exec_cmd)
                        // In that case, don't prepend the base expression as 'this'
                        let is_namespace_call: mut bool = false;
                        if (ma.base_expr.some is BoundExpression.identifier) {
                            let base_id: BoundIdentifierExpression = ma.base_expr.some.identifier;
                            if (base_id.symbol.is_some()) {
                                if (base_id.symbol.some is BoundSymbol.namespace_sym) {
                                    is_namespace_call = true;
                                }
                                if (base_id.symbol.some is BoundSymbol.type_sym) {
                                    is_namespace_call = true;
                                }
                            }
                        }
                        // Also handle nested member access like PenguinProject.load
                        if (ma.base_expr.some is BoundExpression.member_access) {
                            let inner_ma: BoundMemberAccessExpression = ma.base_expr.some.member_access;
                            if (inner_ma.member_symbol.is_some()) {
                                if (inner_ma.member_symbol.some is BoundSymbol.type_sym) {
                                    is_namespace_call = true;
                                }
                                if (inner_ma.member_symbol.some is BoundSymbol.namespace_sym) {
                                    is_namespace_call = true;
                                }
                            }
                        }
                        if (!is_namespace_call) {
                            if (first_param_is_this) {
                                if (dd_val.get_ir_type() == "void") {
                                    new_args.push(this.lower_expression(ma.base_expr.some));
                                } else {
                                    new_args.push(dd_val);
                                }
                            }
                            // else: no-`this` method -- discard the receiver (don't
                            // prepend). For interface-typed receivers it is lowered
                            // separately as the vtable-lookup object below.
                        }
                        let ai2: mut i64 = 0;
                        while (ai2 < cast<i64>(args.size())) {
                            new_args.push(args.at(cast<u64>(ai2)).some);
                            ai2 = ai2 + 1;
                        }
                        args = new_args;
                        // Check if receiver type has generic args
                        let receiver_type: BoundType = ma.base_expr.some.get_bound_type();
                        if (cast<i64>(receiver_type.generic_args.size()) > 0 && receiver_type.type_definition.is_some()) {
                            let recv_def: BoundDefinition = receiver_type.type_definition.some;
                            if (recv_def is BoundDefinition.class_def) {
                                if (recv_def.class_def.is_generic_template) {
                                    has_generic_receiver = true;
                                    generic_args_list = receiver_type.generic_args;
                                    template_class_name = recv_def.class_def.name;
                                    template_class_name_full = recv_def.class_def.full_name;
                                }
                            }
                            if (recv_def is BoundDefinition.enum_def) {
                                if (cast<i64>(recv_def.enum_def.generic_params.size()) > 0) {
                                    has_generic_receiver = true;
                                    generic_args_list = receiver_type.generic_args;
                                    template_class_name = recv_def.enum_def.name;
                                    template_class_name_full = recv_def.enum_def.full_name;
                                }
                            }
                        }
                    }
                }
            }
        }
        let raw_ret_type: string = this.bound_type_to_ir_type(expr.get_bound_type());
        // For virtual calls, if bound_type_to_ir_type returned void, try to recover
        // the return type from the callee symbol (interface method's return_type).
        let ret_type: string = if (raw_ret_type == "void" && expr.is_virtual && expr.callee_symbol.is_some()) {
            let csym: BoundSymbol = expr.callee_symbol.some;
            if (csym is BoundSymbol.function_sym) {
                this.bound_type_to_ir_type(csym.function_sym.return_type)
            } else {
                raw_ret_type
            }
        } else {
            raw_ret_type
        };
        let loc: SourceLocation = this.sym_loc(expr.callee_symbol);
        if (let sym := expr.callee_symbol.some) {
            let func_name: mut string = this.clean_function_name(sym.get_full_name());
            if (has_generic_receiver) {
                let mangled_class: string = this.mangle_generic_name(template_class_name_full, generic_args_list);
                func_name = this.replace_in_func_name(func_name, template_class_name, mangled_class);
            }
            if (expr.is_generic_function_call) {
                // expr.generic_args (the call's explicit TYPE args) stays
                // List<BoundType>; wrap as type args for the mangle helper.
                let type_arg_wrap: mut _utils.List<BoundTypeArg> = new _utils.List<BoundTypeArg>();
                let wi: mut i64 = 0;
                while (wi < cast<i64>(expr.generic_args.size())) {
                    let a: mut BoundType = expr.generic_args.at(cast<u64>(wi)).some;
                    type_arg_wrap.push(make_type_arg(a));
                    wi = wi + 1;
                }
                let mangled_func: string = this.mangle_generic_name(sym.get_full_name(), type_arg_wrap);
                func_name = this.replace_in_func_name(func_name, sym.get_name(), mangled_func);
            }
            if (expr.is_virtual) {
                let interface_id: string = this.resolve_interface_id(expr);
                let slot: i64 = this.resolve_vtable_slot(expr);
                // obj = the receiver for vtable lookup. For `this` methods the
                // receiver was prepended to args (args[0]); for no-`this` methods
                // it was discarded from args, so lower the base expression here.
                // Lowered directly (not via the boxing-elision path) so it carries
                // the interface metadata _emperor_vtable_lookup needs.
                let obj: IRValue = if (first_param_is_this && cast<i64>(args.size()) > 0) {
                    args.at(cast<u64>(0)).some
                } else {
                    this.lower_call_receiver(expr)
                };
                // For virtual calls on interface types, resolve the return type
                // from the receiver's interface method definition (the authoritative
                // source), bypassing expr.get_bound_type() which may be void.
                let virtual_ret_type: string = if (ret_type == "void") {
                    this.resolve_virtual_return_type(expr)
                } else {
                    ret_type
                };
                let result: Option<IRValue> = this.builder.emit_call_virt(obj, interface_id, slot, args, virtual_ret_type, loc);
                if (result.is_some()) { return result.some; }
                return this.builder.void_value();
            }
            if (sym is BoundSymbol.function_sym) {
                if (sym.function_sym.is_extern) {
                    this.ensure_extern_decl(func_name, args, ret_type);
                }
            }
            let result: Option<IRValue> = this.builder.emit_call(func_name, args, ret_type, loc);
            if (result.is_some()) { return result.some; }
            return this.builder.void_value();
        }
        __builtin.eprintln("error[E_INTERNAL]: Function call has no callee symbol");
        __builtin.exit(1);
        return this.builder.void_value();
    }

    // For boxing optimization: when direct_dispatch=true, lower the inner expression
    // of the cast (skipping the box). Returns empty IRValue if not applicable.
    fun lower_direct_dispatch_this(mut this, ma: BoundMemberAccessExpression, call_expr: BoundFunctionCallExpression) -> IRValue {
        _utils.trace_enter("Enter lower_direct_dispatch_this");
        if (!call_expr.direct_dispatch) {
            return this.builder.void_value();
        }
        if (let base := ma.base_expr.some) {
            if (base is BoundExpression.cast_expr) {
                let cast_e: BoundCastExpression = base.cast_expr;
                if (cast_e.needs_boxing) {
                    if (cast_e.inner.is_some()) {
                        return this.lower_expression(cast_e.inner.some);
                    }
                }
            }
        }
        return this.builder.void_value();
    }

    fun replace_in_func_name(this, func_name: string, old_class: string, new_class: string) -> string {
        _utils.trace_enter("Enter replace_in_func_name");
        if (func_name == old_class) {
            return new_class;
        }
        // Already-mangled name (e.g. a method resolved from a specialized def's
        // scope, like `Option__i64.json_serialize`): the mangled class name is
        // already present, so no re-mangling is needed. Without this guard, the
        // `.Option` prefix-match below would match `.Option__i64` and drop the
        // `.json_serialize` suffix, emitting the type symbol as the callee.
        if (string_find(func_name, new_class) >= 0) {
            return func_name;
        }
        let dot_pos: i64 = string_find(func_name, "." + old_class + ".");
        if (dot_pos >= 0) {
            let before: string = string_substring(func_name, 0, dot_pos);
            let after_start: i64 = dot_pos + string_length(old_class) + 2;
            let after_len: i64 = string_length(func_name) - after_start;
            let after: string = string_substring(func_name, after_start, after_len);
            return before + "." + new_class + "." + after;
        }
        let dot_pos2: i64 = string_find(func_name, "." + old_class);
        if (dot_pos2 >= 0) {
            let before2: string = string_substring(func_name, 0, dot_pos2);
            return before2 + "." + new_class;
        }
        if (string_find(func_name, old_class + ".") == 0) {
            let after_start: i64 = string_length(old_class) + 1;
            let after_len: i64 = string_length(func_name) - after_start;
            let after: string = string_substring(func_name, after_start, after_len);
            return new_class + "." + after;
        }
        return func_name;
    }

    fun ensure_extern_decl(mut this, func_name: string, args: _utils.List<IRValue>, ret_type: string) {
        _utils.trace_enter("Enter ensure_extern_decl");
        let fi: mut i64 = 0;
        while (fi < cast<i64>(this.current_module.functions.size())) {
            let existing: IRFunction = this.current_module.functions.at(cast<u64>(fi)).some;
            if (existing.name == func_name) {
                return;
            }
            fi = fi + 1;
        }
        let ext_func: mut IRFunction = new IRFunction(func_name, ret_type, new SourceLocation("", 0, 0));
        ext_func.is_extern = true;
        let pi: mut i64 = 0;
        while (pi < cast<i64>(args.size())) {
            let arg: IRValue = args.at(cast<u64>(pi)).some;
            let p: mut IRParameter = new IRParameter("p" + cast<string>(pi), arg.get_ir_type(), pi, new SourceLocation("", 0, 0));
            ext_func.parameters.push(p);
            pi = pi + 1;
        }
        this.current_module.add_function(ext_func);
    }

    // Build an extern (declaration) for a lib-export function def, so callers
    // see its real signature (param/return IR types) and precompute_function
    // _signatures / emit_args_coerced agree with the .penguin-lib's compiled
    // symbol. Mirrors ensure_extern_decl but takes the bound def directly.
    fun ensure_extern_decl_from_def(mut this, def: BoundFunctionDefinition, module: mut IRModule) {
        _utils.trace_enter("Enter ensure_extern_decl_from_def");
        let fi: mut i64 = 0;
        while (fi < cast<i64>(module.functions.size())) {
            let existing: IRFunction = module.functions.at(cast<u64>(fi)).some;
            if (existing.name == def.full_name) {
                return;
            }
            fi = fi + 1;
        }
        let ext_func: mut IRFunction = new IRFunction(def.full_name, this.bound_type_to_ir_type(def.return_type), new SourceLocation("", 0, 0));
        ext_func.is_extern = true;
        ext_func.is_lib_export_decl = true;
        let pi: mut i64 = 0;
        while (pi < cast<i64>(def.parameters.size())) {
            let p: BoundFunctionParameter = def.parameters.at(cast<u64>(pi)).some;
            let ir_param: mut IRParameter = new IRParameter(p.name, this.bound_type_to_ir_type(p.bound_type), pi, new SourceLocation("", 0, 0));
            ext_func.parameters.push(ir_param);
            pi = pi + 1;
        }
        module.add_function(ext_func);
    }

    // For an interface-method call `recv.m(...)` where recv has an interface
    // type, return that (template) interface def — the same logical interface
    // recorded in the object's interface_map and vtable. Using the template
    // (rather than the callee's possibly-specialized scope) keeps the
    // interface_id and slot index consistent with the object's vtable.
    fun call_base_interface_def(this, expr: BoundFunctionCallExpression) -> Option<BoundInterfaceDefinition> {
        _utils.trace_enter("Enter call_base_interface_def");
        if (let callee := expr.callee.some) {
            if (callee is BoundExpression.member_access) {
                let ma: BoundMemberAccessExpression = callee.member_access;
                if (ma.base_expr.is_some()) {
                    let base_type: BoundType = ma.base_expr.some.get_bound_type();
                    if (base_type.kind is TypeKind.InterfaceKind) {
                        if (let td := base_type.type_definition.some) {
                            if (td is BoundDefinition.interface_def) {
                                return new Option<BoundInterfaceDefinition>.some(td.interface_def);
                            }
                        }
                    }
                }
            }
        }
        return new Option<BoundInterfaceDefinition>.none();
    }

    // Try to resolve the vtable slot index for a virtual call.
    // For virtual calls (interface scope): find the method index among the interface's
    // non-constructor methods, which matches the vtable slot ordering.
    // For concrete calls (class scope): walk to find class vtable.
    fun resolve_vtable_slot(this, expr: BoundFunctionCallExpression) -> i64 {
        _utils.trace_enter("Enter resolve_vtable_slot");
        // Interface-typed receiver: use the base interface's method order (the
        // template def recorded in the object's vtable), not the callee's
        // possibly-specialized scope (whose name isn't in the parent scope).
        let base_iface: Option<BoundInterfaceDefinition> = this.call_base_interface_def(expr);
        if (let iface := base_iface.some) {
            let callee_name: string = this.call_callee_name(expr);
            let func_idx: mut i64 = 0;
            let mi: mut i64 = 0;
            while (mi < cast<i64>(iface.methods.size())) {
                let md: BoundDefinition = iface.methods.at(cast<u64>(mi)).some;
                if (md is BoundDefinition.function_def) {
                    if (md.function_def.name == callee_name) {
                        return func_idx;
                    }
                    if (md.function_def.name != "new") {
                        func_idx = func_idx + 1;
                    }
                }
                mi = mi + 1;
            }
            return 0;
        }
        if (let sym := expr.callee_symbol.some) {
            let scope: Option<BoundScope> = sym.get_enclosing_scope();
            if (scope.is_some()) {
                // Concrete call: find in class vtable
                let class_def: Option<BoundClassDefinition> = this.find_class_def_from_scope(scope.some);
                if (class_def.is_some()) {
                    let vtables: _utils.List<BoundVTable> = class_def.some.vtables;
                    let callee_name: string = sym.get_full_name();
                    let vi: mut i64 = 0;
                    while (vi < cast<i64>(vtables.size())) {
                        let vtable: BoundVTable = vtables.at(cast<u64>(vi)).some;
                        let si: mut i64 = 0;
                        while (si < cast<i64>(vtable.slots.size())) {
                            let slot: BoundVTableSlot = vtable.slots.at(cast<u64>(si)).some;
                            if (slot.implementation_method.is_some()) {
                                if (slot.implementation_method.some.full_name == callee_name) {
                                    return si;
                                }
                            }
                            si = si + 1;
                        }
                        vi = vi + 1;
                    }
                    __builtin.eprintln("error[E_INTERNAL]: Could not find vtable slot for: " + callee_name);
                    __builtin.exit(1);
                }
            }
        }
        return 0;
    }

    // Walk up the scope chain to find a ClassScope, then look up the type symbol
    // in the parent scope to get the BoundClassDefinition with vtables.
    fun find_class_def_from_scope(this, scope: BoundScope) -> Option<BoundClassDefinition> {
        _utils.trace_enter("Enter find_class_def_from_scope");
        if (scope.kind is ScopeKind.ClassScope) {
            if (scope.parent.is_some()) {
                let type_sym: Option<BoundSymbol> = scope.parent.some.lookup_symbol_local(scope.name);
                if (type_sym.is_some()) {
                    if (type_sym.some is BoundSymbol.type_sym) {
                        let ts: BoundTypeSymbol = type_sym.some.type_sym;
                        if (ts.type_definition.is_some()) {
                            if (ts.type_definition.some is BoundDefinition.class_def) {
                                return new Option<BoundClassDefinition>.some(ts.type_definition.some.class_def);
                            }
                        }
                    }
                }
            }
            return new Option<BoundClassDefinition>.none();
        }
        if (scope.parent.is_some()) {
            return this.find_class_def_from_scope(scope.parent.some);
        }
        return new Option<BoundClassDefinition>.none();
    }

    // Lower the receiver of a member call (e.g. `f` in `f.foo()`) as the
    // vtable-lookup object. Lowered directly so it keeps the interface metadata.
    fun lower_call_receiver(mut this, expr: BoundFunctionCallExpression) -> IRValue {
        _utils.trace_enter("Enter lower_call_receiver");
        if (let callee := expr.callee.some) {
            if (callee is BoundExpression.member_access) {
                if (callee.member_access.base_expr.is_some()) {
                    return this.lower_expression(callee.member_access.base_expr.some);
                }
            }
        }
        return this.builder.void_value();
    }

    // The method name being called on a member-access callee (e.g. "bar" in
    // f.bar()). Falls back to the callee symbol's name.
    fun call_callee_name(this, expr: BoundFunctionCallExpression) -> string {
        _utils.trace_enter("Enter call_callee_name");
        if (let callee := expr.callee.some) {
            if (callee is BoundExpression.member_access) {
                return callee.member_access.member_name;
            }
        }
        if (expr.callee_symbol.is_some()) {
            return expr.callee_symbol.some.get_name();
        }
        return "";
    }

    // Resolve the return type for a virtual call from the base interface method
    // definition. This is more reliable than expr.get_bound_type() which may be
    // void for calls on interface-typed receivers.
    fun resolve_virtual_return_type(this, expr: BoundFunctionCallExpression) -> string {
        _utils.trace_enter("Enter resolve_virtual_return_type");
        // Look up the return type from the base interface method definition.
        let callee_name: string = this.call_callee_name(expr);
        let base_iface: Option<BoundInterfaceDefinition> = this.call_base_interface_def(expr);
        let raw_rt: string = if (base_iface.is_some()) {
            let iface: BoundInterfaceDefinition = base_iface.some;
            let found: mut string = "void";
            let mi: mut i64 = 0;
            while (mi < cast<i64>(iface.methods.size())) {
                let md: BoundDefinition = iface.methods.at(cast<u64>(mi)).some;
                if (md is BoundDefinition.function_def) {
                    if (md.function_def.name == callee_name) {
                        found = this.bound_type_to_ir_type(md.function_def.return_type);
                    }
                }
                mi = mi + 1;
            }
            found
        } else {
            "void"
        };
        if (raw_rt == "void") { return "void"; }
        // If the return type has unresolved generic params, substitute them
        // with the receiver type's concrete generic args.
        if (string_find(raw_rt, "__T") >= 0 || string_find(raw_rt, "__E") >= 0) {
            let recv_type_opt: Option<BoundType> = this.call_receiver_type(expr);
            if (recv_type_opt.is_some() && cast<i64>(recv_type_opt.some.generic_args.size()) > 0) {
                let recv_type: BoundType = recv_type_opt.some;
                let base_iface2: Option<BoundInterfaceDefinition> = this.call_base_interface_def(expr);
                if (let iface2 := base_iface2.some) {
                    let mi2: mut i64 = 0;
                    while (mi2 < cast<i64>(iface2.methods.size())) {
                        let md2: BoundDefinition = iface2.methods.at(cast<u64>(mi2)).some;
                        if (md2 is BoundDefinition.function_def) {
                            if (md2.function_def.name == callee_name) {
                                let rt: BoundType = md2.function_def.return_type;
                                if (rt.kind is TypeKind.EnumKind && rt.type_definition.is_some()) {
                                    let result_sb: mut StringBuilder = new StringBuilder();
                                    result_sb.append("enum<");
                                    result_sb.append(rt.type_definition.some.get_name());
                                    let gi: mut i64 = 0;
                                    while (gi < cast<i64>(rt.generic_args.size())) {
                                        if (cast<i64>(iface2.generic_params.size()) > gi && cast<i64>(recv_type.generic_args.size()) > gi) {
                                            result_sb.append(arg_display_name(recv_type.generic_args.at(cast<u64>(gi)).some));
                                        } else {
                                            result_sb.append(arg_display_name(rt.generic_args.at(cast<u64>(gi)).some));
                                        }
                                        gi = gi + 1;
                                    }
                                    result_sb.append(">");
                                    return result_sb.to_string();
                                }
                            }
                        }
                        mi2 = mi2 + 1;
                    }
                }
            }
        }
        return raw_rt;
    }

    // Get the concrete receiver type for a virtual call from the callee expression.
    fun call_receiver_type(this, expr: BoundFunctionCallExpression) -> Option<BoundType> {
        _utils.trace_enter("Enter call_receiver_type");
        if (let callee := expr.callee.some) {
            if (callee is BoundExpression.member_access) {
                if (callee.member_access.base_expr.is_some()) {
                    return new Option<BoundType>.some(callee.member_access.base_expr.some.get_bound_type());
                }
            }
        }
        return new Option<BoundType>.none();
    }

    // Resolve the interface ID for a virtual call.
    // Uses the receiver's interface type (the template, e.g. "IFoo") — the same
    // logical interface recorded in the object's interface_map — rather than the
    // callee's possibly-specialized scope ("IFoo__u8").
    fun resolve_interface_id(this, expr: BoundFunctionCallExpression) -> string {
        _utils.trace_enter("Enter resolve_interface_id");
        let base_iface: Option<BoundInterfaceDefinition> = this.call_base_interface_def(expr);
        if (base_iface.is_some()) {
            // The object's interface_map registers the TEMPLATE name (impl I<5> ->
            // interface I), so the lookup must use the template name too — NOT the
            // possibly-specialized def's name (I__5 from the M4 meta path). A
            // mismatch (map "I" vs lookup "I__5") makes _emperor_vtable_lookup fail.
            return this.extract_template_name(base_iface.some.name);
        }
        if (let sym := expr.callee_symbol.some) {
            let scope: Option<BoundScope> = sym.get_enclosing_scope();
            if (scope.is_some()) {
                if (scope.some.kind is ScopeKind.InterfaceScope) {
                    return this.extract_template_name(scope.some.name);
                }
            }
        }
        return "";
    }

    // Strip a mangled name's suffix (new: `Name$<base62>` → Name; legacy:
    // `Name__<args>` → Name). Mirrors SemanticModel.extract_template_name.
    fun extract_template_name(this, mangled_name: string) -> string {
        let dollar: i64 = string_find(mangled_name, "$");
        if (dollar >= 0) {
            return string_substring(mangled_name, 0, dollar);
        }
        let pos: i64 = string_find(mangled_name, "__");
        if (pos >= 0) {
            return string_substring(mangled_name, 0, pos);
        }
        return mangled_name;
    }

    fun lower_code_block(mut this, expr: BoundCodeBlockExpression) -> IRValue {
        _utils.trace_enter("Enter lower_code_block");
        let si: mut i64 = 0;
        while (si < cast<i64>(expr.statements.size())) {
            this.lower_statement(expr.statements.at(cast<u64>(si)).some);
            if (this.builder.func.has_terminator()) {
                return this.builder.void_value();
            }
            si = si + 1;
        }
        if (expr.trailing_expr.is_some()) {
            return this.lower_expression(expr.trailing_expr.some);
        }
        return this.builder.void_value();
    }

    fun lower_cast(mut this, expr: BoundCastExpression) -> IRValue {
        _utils.trace_enter("Enter lower_cast");
        let inner: IRValue = this.lower_expression(expr.inner.some);
        let loc: SourceLocation = this.make_loc(0, 0);

        // Boxing: value type → interface
        if (expr.needs_boxing) {
            return this.builder.emit_box(inner, expr.source_type_name, loc);
        }

        // Unboxing: interface → value type
        if (expr.needs_unboxing) {
            let target_type: BoundType = expr.get_bound_type();
            let ir_type: string = this.bound_type_to_ir_type(target_type);
            return this.builder.emit_unbox(inner, expr.source_type_name, ir_type, loc);
        }

        // Standard cast
        let ir_from_type: string = inner.get_ir_type();
        let from_type: mut string = this.bound_type_to_ir_type(expr.inner.some.get_bound_type());
        if (ir_from_type != "unknown" && ir_from_type != "void") {
            from_type = ir_from_type;
        }
        let to_type: string = this.bound_type_to_ir_type(expr.get_bound_type());
        return this.builder.emit_cast(inner, from_type, to_type, loc);
    }

    fun lower_if_expr(mut this, expr: BoundIfExpression) -> IRValue {
        _utils.trace_enter("Enter lower_if_expr");
        let ir_type: string = this.bound_type_to_ir_type(expr.get_bound_type());
        let is_void: bool = ir_type == "void";
        let merge_lbl: IRLabel = this.builder.func.alloc_label("merge");
        let result: IRValue = this.builder.func.alloc_temp(ir_type);
        let loc: SourceLocation = this.make_loc(0, 0);
        if (expr.condition.is_some()) {
            let cond: IRValue = this.lower_expression(expr.condition.some);
            if (expr.else_block.is_some()) {
                let then_lbl: IRLabel = this.builder.func.alloc_label("then");
                let else_lbl: IRLabel = this.builder.func.alloc_label("else");
                this.builder.emit_br_cond(cond, then_lbl, else_lbl, loc);
                this.builder.emit_label(then_lbl);
                if (expr.then_block.is_some()) {
                    let then_val: IRValue = this.lower_expression(expr.then_block.some);
                    if (!is_void) {
                        this.builder.emit_assign(result, then_val, loc);
                    }
                }
                if (!this.builder.func.has_terminator()) {
                    this.builder.emit_br(merge_lbl, loc);
                }
                this.builder.emit_label(else_lbl);
                let else_val: IRValue = this.lower_expression(expr.else_block.some);
                if (!is_void) {
                    this.builder.emit_assign(result, else_val, loc);
                }
            } else {
                let then_lbl: IRLabel = this.builder.func.alloc_label("then");
                this.builder.emit_br_cond(cond, then_lbl, merge_lbl, loc);
                this.builder.emit_label(then_lbl);
                if (expr.then_block.is_some()) {
                    let then_val: IRValue = this.lower_expression(expr.then_block.some);
                    if (!is_void) {
                        this.builder.emit_assign(result, then_val, loc);
                    }
                }
            }
        }
        this.builder.emit_label(merge_lbl);
        if (!is_void) {
            return result;
        }
        return this.builder.void_value();
    }

    fun lower_while_expr(mut this, expr: BoundWhileExpression) -> IRValue {
        _utils.trace_enter("Enter lower_while_expr");
        let header_lbl: IRLabel = this.builder.func.alloc_label("while");
        let body_lbl: IRLabel = this.builder.func.alloc_label("while_body");
        let exit_lbl: IRLabel = this.builder.func.alloc_label("while_exit");
        let loc: SourceLocation = this.make_loc(0, 0);
        this.loop_stack.push(new LoopLabels(header_lbl, exit_lbl));
        this.builder.emit_label(header_lbl);
        if (expr.condition.is_some()) {
            let cond: IRValue = this.lower_expression(expr.condition.some);
            this.builder.emit_br_cond(cond, body_lbl, exit_lbl, loc);
        }
        this.builder.emit_label(body_lbl);
        if (expr.body.is_some()) {
            let _ = this.lower_expression(expr.body.some);
        }
        if (!this.builder.func.has_terminator()) {
            this.builder.emit_br(header_lbl, loc);
        }
        this.builder.emit_label(exit_lbl);
        if (cast<i64>(this.loop_stack.size()) > 0) {
            this.loop_stack.pop();
        }
        return this.builder.void_value();
    }

    fun lower_member_access(mut this, expr: BoundMemberAccessExpression) -> IRValue {
        _utils.trace_enter("Enter lower_member_access");
        let loc: SourceLocation = this.sym_loc(expr.member_symbol);

        // Handle namespace-qualified global variable access (e.g., Foo.msg)
        if (let sym := expr.member_symbol.some) {
            if (sym is BoundSymbol.variable) {
                if (sym.variable.variable_kind is VariableSymbolKind.Global) {
                    // Look up the global_ref from symbol_regs (registered by lower_global_var_def)
                    let reg: Option<IRValue> = this.get_symbol_reg(sym);
                    if (reg.is_some()) {
                        if (reg.some is IRValue.global_ref) {
                            let ir_type: string = reg.some.global_ref.ir_type;
                            let global_name: string = reg.some.global_ref.name;
                            return this.builder.emit_global_load(global_name, ir_type, loc);
                        }
                    }
                    // Fallback: use the symbol's bound_type
                    let global_name: string = this.clean_function_name(sym.variable.full_name);
                    let ir_type: string = this.bound_type_to_ir_type(sym.variable.bound_type);
                    return this.builder.emit_global_load(global_name, ir_type, loc);
                }
            }
        }

        if (expr.base_expr.is_some()) {
            let obj: IRValue = this.lower_expression(expr.base_expr.some);

            // Check if this is enum payload access (e.g., a.some where a is Option<i64>)
            if (let sym := expr.member_symbol.some) {
                if (sym is BoundSymbol.enum_member) {
                    // Use the (already generic-substituted) bound type of the expression,
                    // not the enum member symbol's member_type — the symbol keeps the
                    // unsubstituted type parameter T, so using it directly would emit a
                    // rdenum whose result is typed `ref<T>`, and any chained member access
                    // on the extracted payload (e.g. `opt.some.field`) could no longer
                    // resolve the concrete class layout. The binder substitutes T at
                    // bind time (SemanticModel bind_member_access), storing the result
                    // in expr.bound_type.
                    let payload_type: string = this.bound_type_to_ir_type(expr.bound_type);
                    return this.builder.emit_rdenum(obj, expr.member_name, payload_type, loc);
                }
            }

            // Regular member access (class fields)
            let base_type: string = this.bound_type_to_ir_type(expr.bound_type);
            if (base_type == "void") {
                __builtin.eprintln("error[E_INTERNAL]: Member access resolved to void type for: " + expr.member_name);
                __builtin.exit(1);
                return this.builder.emit_rdmbr(obj, expr.member_name, "i64", loc);
            }
            return this.builder.emit_rdmbr(obj, expr.member_name, base_type, loc);
        }
        __builtin.eprintln("error[E_INTERNAL]: Member access has no base expression for: " + expr.member_name);
        __builtin.exit(1);
        return this.builder.emit_const("error", "void", loc);
    }

    fun lower_new(mut this, expr: BoundNewExpression) -> IRValue {
        _utils.trace_enter("Enter lower_new");
        let args: mut _utils.List<IRValue> = new _utils.List<IRValue>();
        let ai: mut i64 = 0;
        while (ai < cast<i64>(expr.arguments.size())) {
            args.push(this.lower_expression(expr.arguments.at(cast<u64>(ai)).some));
            ai = ai + 1;
        }
        let loc: SourceLocation = this.make_loc(0, 0);
        if (expr.type_symbol.is_some()) {
            let type_name: mut string = expr.type_symbol.some.full_name;
            if (cast<i64>(expr.bound_type.generic_args.size()) > 0) {
                // Full base feeds the mangle (encodes the qualified name); the
                // SHORT name locates the position inside type_name for splicing.
                let base_full: string = expr.type_symbol.some.full_name;
                let base_short: string = expr.type_symbol.some.name;
                let mangled: string = this.mangle_generic_name(base_full, expr.bound_type.generic_args);
                let scope_dot: i64 = string_find(type_name, "." + base_short);
                if (scope_dot >= 0) {
                    let prefix: string = string_substring(type_name, 0, scope_dot);
                    type_name = prefix + "." + mangled;
                } else {
                    type_name = mangled;
                }
            } else {
                // M4 / spec.bound_type: the bound_type is already a specialized def
                // (type_def = A__5, NO generic_args). type_symbol still points at the
                // template (A), so without this emit_new gets the template and the
                // LLVM type has no layout → undefined register. Use the specialized
                // def's name with the same prefix logic as the generic_args branch.
                let spec_name: mut string = "";
                if (expr.bound_type.type_definition.is_some()) {
                    let td: BoundDefinition = expr.bound_type.type_definition.some;
                    if (td is BoundDefinition.class_def) {
                        if (td.class_def.is_specialized) { spec_name = td.class_def.name; }
                    } else if (td is BoundDefinition.enum_def) {
                        if (td.enum_def.is_specialized) { spec_name = td.enum_def.name; }
                    } else if (td is BoundDefinition.interface_def) {
                        if (td.interface_def.is_specialized) { spec_name = td.interface_def.name; }
                    }
                }
                if (string_length(spec_name) > 0) {
                    let base_name: string = expr.type_symbol.some.name;
                    let scope_dot: i64 = string_find(type_name, "." + base_name);
                    if (scope_dot >= 0) {
                        let prefix: string = string_substring(type_name, 0, scope_dot);
                        type_name = prefix + "." + spec_name;
                    } else {
                        type_name = spec_name;
                    }
                }
            }
            return this.builder.emit_new(type_name, args, loc);
        }
        __builtin.eprintln("error[E_INTERNAL]: new expression has no type symbol");
        __builtin.exit(1);
        return this.builder.emit_new("Object", args, loc);
    }

    fun mangle_generic_name(this, base_name: string, generic_args: _utils.List<BoundTypeArg>) -> string {
        _utils.trace_enter("Enter mangle_generic_name");
        // The unified mangle (BoundType.penguin mangle_specialization) — must
        // stay byte-identical to SemanticModel.mangle_generic_name.
        return mangle_specialization(base_name, generic_args);
    }

    // Wrap a BoundStatement as a void BoundExpression (code block)
    fun wrap_stmt_as_expr(this, stmt: BoundStatement) -> BoundExpression {
        _utils.trace_enter("Enter wrap_stmt_as_expr");
        let void_type: BoundType = new BoundType();
        let stmts: mut _utils.List<BoundStatement> = new _utils.List<BoundStatement>();
        stmts.push(stmt);
        let cb: BoundCodeBlockExpression = new BoundCodeBlockExpression(void_type, stmts, new Option<BoundExpression>.none(), new Option<BoundScope>.none());
        return new BoundExpression.code_block(cb);
    }

    // Convert Option<BoundStatement> to Option<BoundExpression> by wrapping as code block
    fun wrap_stmt_option(this, stmt_opt: Option<BoundStatement>) -> Option<BoundExpression> {
        _utils.trace_enter("Enter wrap_stmt_option");
        if (stmt_opt.is_some()) {
            return new Option<BoundExpression>.some(this.wrap_stmt_as_expr(stmt_opt.some));
        }
        return new Option<BoundExpression>.none();
    }

    fun lower_enum_variant(mut this, expr: BoundEnumVariantExpression) -> IRValue {
        _utils.trace_enter("Enter lower_enum_variant");
        let payload: mut Option<IRValue> = new Option<IRValue>.none();
        if (expr.payload.is_some()) {
            payload = new Option<IRValue>.some(this.lower_expression(expr.payload.some));
        }
        let loc: SourceLocation = this.make_loc(0, 0);
        let enum_ir_type: mut string = this.bound_type_to_ir_type(expr.enum_type);
        // Diagnostic: if type still uses template name (no __), try using type_definition name directly
        if (string_find(enum_ir_type, "__") < 0 && expr.enum_type.type_definition.is_some()) {
            let def_name: string = expr.enum_type.type_definition.some.get_name();
            if (string_find(def_name, "__") >= 0) {
                enum_ir_type = "enum<" + def_name + ">";
            }
        }
        return this.builder.emit_new_enum(enum_ir_type, expr.variant_idx, expr.variant_name, payload, loc);
    }

    fun lower_statement(mut this, stmt: BoundStatement) {
        _utils.trace_enter("Enter lower_statement");
        if (stmt is BoundStatement.expression) {
            if (stmt.expression.expression.is_some()) {
                let _ = this.lower_expression(stmt.expression.expression.some);
            }
        }
        if (stmt is BoundStatement.return_stmt) {
            let loc: SourceLocation = stmt.return_stmt.location;
            if (let bound_val := stmt.return_stmt.value.some) {
                let val_raw: IRValue = this.lower_expression(bound_val);
                // Coerce an integer-literal return value to the function's return
                // type: literals default to i64, so `return 5` in a u8 function
                // must be truncated (e.g. i64 -> i8) to match the declared return.
                // (Guard the `.literal` access via an if-expression: `&&` in
                // PenguinLang does not short-circuit, so a bare `is && .literal`
                // would cast non-literal returns — e.g. enum variants — and crash.)
                let is_int_lit: bool = if (bound_val is BoundExpression.literal) {
                    bound_val.literal.literal_kind is LiteralKind.IntegerLiteral
                } else {
                    false
                };
                let func_ret: string = this.builder.func.return_type;
                let val: IRValue = if (is_int_lit && func_ret != "void" && val_raw.get_ir_type() != func_ret) {
                    this.builder.emit_cast(val_raw, val_raw.get_ir_type(), func_ret, loc)
                } else {
                    val_raw
                };
                this.builder.emit_ret(val, loc);
            } else {
                this.builder.emit_ret_void(loc);
            }
        }
        if (stmt is BoundStatement.let_decl) {
            this.lower_let_decl(stmt.let_decl);
        }
        if (stmt is BoundStatement.assignment) {
            this.lower_assignment(stmt.assignment);
        }
        if (stmt is BoundStatement.if_stmt) {
            this.lower_if_stmt(stmt.if_stmt);
        }
        if (stmt is BoundStatement.while_stmt) {
            this.lower_while_stmt(stmt.while_stmt);
        }
        if (stmt is BoundStatement.for_stmt) {
            // For loops are lowered to while loops in SemanticModel.bind_statement,
            // so this case should never be reached at the IR level.
            __builtin.eprintln("error[E_INTERNAL]: for_stmt should have been lowered to while loop in SemanticModel");
            __builtin.exit(1);
        }
        if (stmt is BoundStatement.block) {
            this.lower_block(stmt.block);
        }
        if (stmt is BoundStatement.break_stmt) {
            this.lower_break(stmt.break_stmt);
        }
        if (stmt is BoundStatement.continue_stmt) {
            this.lower_continue(stmt.continue_stmt);
        }
    }

    fun lower_let_decl(mut this, stmt: BoundLetDeclarationStatement) {
        _utils.trace_enter("Enter lower_let_decl");
        if (let sym := stmt.variable_symbol.some) {
            let ir_type: string = this.bound_type_to_ir_type(sym.bound_type);
            let loc: SourceLocation = this.make_loc(sym.location.line, sym.location.col);
            let reg: IRValue = this.builder.func.alloc_named_reg(sym.name, ir_type, loc.line, loc.col);
            this.set_symbol_reg(new BoundSymbol.variable(sym), reg);
            if (let init_expr := stmt.initializer.some) {
                if (init_expr is BoundExpression.literal) {
                    let lit: BoundLiteralExpression = init_expr.literal;
                    this.builder.emit_const_direct(reg, lit.value, loc);
                } else {
                    let init_val: IRValue = this.lower_expression(init_expr);
                    this.builder.emit_assign(reg, init_val, loc);
                }
            }
        }
    }

    fun lower_assignment(mut this, stmt: BoundAssignmentStatement) {
        _utils.trace_enter("Enter lower_assignment");
        if (stmt.value.is_some()) {
            let val: IRValue = this.lower_expression(stmt.value.some);
            let loc: SourceLocation = stmt.location;

            // Check if target is member access (p.x = value or a.some = value)
            if (stmt.target.is_some() && stmt.target.some is BoundExpression.member_access) {
                let member_expr: BoundMemberAccessExpression = stmt.target.some.member_access;

                // Check if this is enum payload assignment (a.some = 2)
                if (let sym := member_expr.member_symbol.some) {
                    if (sym is BoundSymbol.variable) {
                        if (sym.variable.variable_kind is VariableSymbolKind.Global) {
                            // Namespace-qualified global variable assignment (e.g., Foo.msg = value)
                            let global_name: string = this.clean_function_name(sym.variable.full_name);
                            this.builder.emit_global_store(global_name, val, loc);
                            return;
                        }
                    }
                    if (sym is BoundSymbol.enum_member) {
                        if (member_expr.base_expr.is_some()) {
                            let obj: IRValue = this.lower_expression(member_expr.base_expr.some);
                            let enum_type: string = this.bound_type_to_ir_type(member_expr.base_expr.some.get_bound_type());
                            let variant_idx: i64 = sym.enum_member.enum_value;
                            let variant_name: string = sym.enum_member.name;
                            let new_enum: IRValue = this.builder.emit_new_enum(enum_type, variant_idx, variant_name, new Option<IRValue>.some(val), loc);

                            // Resolve the storage location to write the rebuilt enum back to.
                            // For `enum_var.variant = value` (e.g. `e.a = new Foo()`) the target is
                            // a member_access, so stmt.target_symbol is none — fall back to the
                            // base identifier's symbol (the enum variable being mutated). Without
                            // this, the rebuilt enum was constructed in a temp and never stored
                            // back, so the payload reassignment was silently dropped.
                            let target_sym: Option<BoundSymbol> = this.resolve_enum_payload_target_sym(stmt, member_expr);
                            if (target_sym.is_some()) {
                                let reg: Option<IRValue> = this.get_symbol_reg(target_sym.some);
                                if (reg.is_some()) {
                                    this.builder.emit_assign(reg.some, new_enum, loc);
                                } else {
                                    __builtin.eprintln("error[E_INTERNAL]: Enum payload assignment: target symbol register not found");
                                    __builtin.exit(1);
                                }
                            } else {
                                __builtin.eprintln("error[E_INTERNAL]: Enum payload assignment: no target symbol");
                                __builtin.exit(1);
                            }
                            return;
                        }
                    }
                }

                // Regular member access (class fields)
                if (member_expr.base_expr.is_some()) {
                    let obj: IRValue = this.lower_expression(member_expr.base_expr.some);
                    this.builder.emit_wrmbr(obj, member_expr.member_name, val, loc);
                    return;
                }
            }

            // Regular variable assignment
            if (stmt.target_symbol.is_some()) {
                let reg: Option<IRValue> = this.get_symbol_reg(stmt.target_symbol.some);
                if (reg.is_some()) {
                    // If target is a global reference, emit global store
                    if (reg.some is IRValue.global_ref) {
                        this.builder.emit_global_store(reg.some.global_ref.name, val, loc);
                    } else {
                        this.builder.emit_assign(reg.some, val, loc);
                    }
                } else {
                    // Check if this is a global variable symbol
                    let sym: BoundSymbol = stmt.target_symbol.some;
                    if (sym is BoundSymbol.variable) {
                        if (sym.variable.variable_kind is VariableSymbolKind.Global) {
                            let global_name: string = this.clean_function_name(sym.variable.full_name);
                            this.builder.emit_global_store(global_name, val, loc);
                        } else {
                            __builtin.eprintln("error[E_INTERNAL]: Variable assignment: register not found for: " + stmt.target_symbol.some.get_full_name());
                            __builtin.exit(1);
                        }
                    } else {
                        __builtin.eprintln("error[E_INTERNAL]: Variable assignment: register not found for: " + stmt.target_symbol.some.get_full_name());
                        __builtin.exit(1);
                    }
                }
            }
        }
    }

    // Resolve the storage symbol to write a rebuilt enum to in a payload assignment
    // `enum_var.variant = value`. Prefer the explicit target_symbol; when the target is a
    // member_access (target_symbol is none), fall back to the base identifier's symbol.
    fun resolve_enum_payload_target_sym(this, stmt: BoundAssignmentStatement, member_expr: BoundMemberAccessExpression) -> Option<BoundSymbol> {
        if (stmt.target_symbol.is_some()) {
            return stmt.target_symbol;
        }
        if (member_expr.base_expr.is_some()) {
            if (member_expr.base_expr.some is BoundExpression.identifier) {
                return member_expr.base_expr.some.identifier.symbol;
            }
        }
        return new Option<BoundSymbol>.none();
    }

    fun lower_if_stmt(mut this, stmt: BoundIfStatement) {
        _utils.trace_enter("Enter lower_if_stmt");
        let void_type: BoundType = new BoundType();
        let then_expr: Option<BoundExpression> = this.wrap_stmt_option(stmt.then_statement);
        let else_expr: Option<BoundExpression> = this.wrap_stmt_option(stmt.else_statement);
        let if_expr: BoundIfExpression = new BoundIfExpression(void_type, stmt.condition, then_expr, else_expr);
        let _: IRValue = this.lower_if_expr(if_expr);
    }

    fun lower_while_stmt(mut this, stmt: BoundWhileStatement) {
        _utils.trace_enter("Enter lower_while_stmt");
        let void_type: BoundType = new BoundType();
        let body_expr: Option<BoundExpression> = this.wrap_stmt_option(stmt.body);
        let while_expr: BoundWhileExpression = new BoundWhileExpression(void_type, stmt.condition, body_expr);
        let _: IRValue = this.lower_while_expr(while_expr);
    }

    fun lower_block(mut this, stmt: BoundBlockStatement) {
        _utils.trace_enter("Enter lower_block");
        let i: mut i64 = 0;
        while (i < cast<i64>(stmt.statements.size())) {
            this.lower_statement(stmt.statements.at(cast<u64>(i)).some);
            i = i + 1;
        }
    }

    fun lower_break(mut this, stmt: BoundBreakStatement) {
        _utils.trace_enter("Enter lower_break");
        if (cast<i64>(this.loop_stack.size()) > 0) {
            let labels: LoopLabels = this.loop_stack.at(cast<u64>(cast<i64>(this.loop_stack.size()) - 1)).some;
            let loc: SourceLocation = stmt.location;
            this.builder.emit_br(labels.exit, loc);
        } else {
            __builtin.eprintln("error[E_LOOP_CONTEXT]: break statement outside loop");
            __builtin.exit(1);
        }
    }

    fun lower_continue(mut this, stmt: BoundContinueStatement) {
        _utils.trace_enter("Enter lower_continue");
        if (cast<i64>(this.loop_stack.size()) > 0) {
            let labels: LoopLabels = this.loop_stack.at(cast<u64>(cast<i64>(this.loop_stack.size()) - 1)).some;
            let loc: SourceLocation = stmt.location;
            this.builder.emit_br(labels.header, loc);
        } else {
            __builtin.eprintln("error[E_LOOP_CONTEXT]: continue statement outside loop");
            __builtin.exit(1);
        }
    }

    fun bound_type_to_ir_type(this, bt: BoundType) -> string {
        _utils.trace_enter("Enter bound_type_to_ir_type");
        if (bt.kind is TypeKind.PrimitiveKind) {
            if (bt.primitive is PrimitiveType.BoolType) { return "bool"; }
            if (bt.primitive is PrimitiveType.I8) { return "i8"; }
            if (bt.primitive is PrimitiveType.I16) { return "i16"; }
            if (bt.primitive is PrimitiveType.I32) { return "i32"; }
            if (bt.primitive is PrimitiveType.I64) { return "i64"; }
            if (bt.primitive is PrimitiveType.U8) { return "u8"; }
            if (bt.primitive is PrimitiveType.U16) { return "u16"; }
            if (bt.primitive is PrimitiveType.U32) { return "u32"; }
            if (bt.primitive is PrimitiveType.U64) { return "u64"; }
            if (bt.primitive is PrimitiveType.F32) { return "f32"; }
            if (bt.primitive is PrimitiveType.F64) { return "f64"; }
            if (bt.primitive is PrimitiveType.CharType) { return "char"; }
            if (bt.primitive is PrimitiveType.StringType) { return "ref<string>"; }
            if (bt.primitive is PrimitiveType.VoidType) { return "void"; }
        }
        if (bt.kind is TypeKind.ClassKind) {
            if (bt.type_definition.is_some()) {
                let td: BoundDefinition = bt.type_definition.some;
                // GENERIC: full base feeds the mangle (short-prefix output).
                // NON-GENERIC: the SHORT name — `ref<X>` is resolved against the
                // layout table whose keys are global-prefix-stripped full names,
                // so a qualified spelling here would never match.
                let base_name: string = td.get_name();
                if (cast<i64>(bt.generic_args.size()) > 0) {
                    let base_full: string = (if (td is BoundDefinition.class_def) { td.class_def.full_name } else { base_name });
                    return "ref<" + this.mangle_generic_name(base_full, bt.generic_args) + ">";
                }
                return "ref<" + base_name + ">";
            }
            return "ref<unknown>";
        }
        if (bt.kind is TypeKind.EnumKind) {
            if (bt.type_definition.is_some()) {
                let td: BoundDefinition = bt.type_definition.some;
                let base_name: string = td.get_name();
                if (cast<i64>(bt.generic_args.size()) > 0) {
                    let base_full: string = (if (td is BoundDefinition.enum_def) { td.enum_def.full_name } else { base_name });
                    return "enum<" + this.mangle_generic_name(base_full, bt.generic_args) + ">";
                }
                return "enum<" + base_name + ">";
            }
            return "enum<unknown>";
        }
        if (bt.kind is TypeKind.InterfaceKind) {
            if (bt.type_definition.is_some()) {
                return "ref<" + bt.type_definition.some.get_name() + ">";
            }
            return "ref<unknown>";
        }
        if (bt.kind is TypeKind.FunctionKind) { return "funptr"; }
        __builtin.eprintln("error[E_INTERNAL]: Unhandled TypeKind in bound_type_to_ir_type");
        __builtin.exit(1);
        return "void";
    }

    fun binary_op_to_ir(this, op: BinaryOperator) -> string {
        _utils.trace_enter("Enter binary_op_to_ir");
        if (op is BinaryOperator.Add) { return "add"; }
        if (op is BinaryOperator.Subtract) { return "sub"; }
        if (op is BinaryOperator.Multiply) { return "mul"; }
        if (op is BinaryOperator.Divide) { return "div"; }
        if (op is BinaryOperator.Modulo) { return "mod"; }
        if (op is BinaryOperator.Equal) { return "eq"; }
        if (op is BinaryOperator.NotEqual) { return "ne"; }
        if (op is BinaryOperator.LessThan) { return "slt"; }
        if (op is BinaryOperator.GreaterThan) { return "sgt"; }
        if (op is BinaryOperator.LessThanOrEqual) { return "sle"; }
        if (op is BinaryOperator.GreaterThanOrEqual) { return "sge"; }
        if (op is BinaryOperator.BitwiseAnd) { return "and"; }
        if (op is BinaryOperator.BitwiseOr) { return "or"; }
        if (op is BinaryOperator.BitwiseXor) { return "xor"; }
        if (op is BinaryOperator.LogicalAnd) { return "and"; }
        if (op is BinaryOperator.LogicalOr) { return "or"; }
        // Is is handled separately in lower_binary via emit_isenum
        __builtin.eprintln("error[E_INTERNAL]: Unhandled binary operator");
        __builtin.exit(1);
        return "unknown";
    }

    fun unary_op_to_ir(this, op: UnaryOperator) -> string {
        _utils.trace_enter("Enter unary_op_to_ir");
        if (op is UnaryOperator.Negate) { return "neg"; }
        if (op is UnaryOperator.Not) { return "not"; }
        if (op is UnaryOperator.BitwiseNot) { return "bitnot"; }
        if (op is UnaryOperator.UnaryPlus) { return "plus"; }
        __builtin.eprintln("error[E_INTERNAL]: Unhandled unary operator");
        __builtin.exit(1);
        return "unknown";
    }

    fun get_symbol_reg(this, symbol: BoundSymbol) -> Option<IRValue> {
        _utils.trace_enter("Enter get_symbol_reg");
        let name: string = symbol.get_full_name();
        let i: mut i64 = 0;
        while (i < cast<i64>(this.symbol_regs.size())) {
            let entry: SymbolRegEntry = this.symbol_regs.at(cast<u64>(i)).some;
            if (entry.symbol_full_name == name) {
                return new Option<IRValue>.some(entry.value);
            }
            i = i + 1;
        }
        return new Option<IRValue>.none();
    }

    fun set_symbol_reg(mut this, symbol: BoundSymbol, value: IRValue) {
        _utils.trace_enter("Enter set_symbol_reg");
        let name: string = symbol.get_full_name();
        // Replace any existing entry for this full_name. PenguinLang's block scopes
        // reuse the literal full_name "<scope>.<block>" for sibling blocks, so two
        // `let x` in different if-branches of one function share a full_name. With
        // per-let uniquified registers (alloc_named_reg), each let now writes a
        // distinct register; "replace" makes the in-lowering-order-most-recent let
        // win, so each branch's references resolve to that branch's own register.
        let i: mut i64 = 0;
        while (i < cast<i64>(this.symbol_regs.size())) {
            if (this.symbol_regs.at(cast<u64>(i)).some.symbol_full_name == name) {
                this.symbol_regs.set(cast<u64>(i), new SymbolRegEntry(name, value));
                return;
            }
            i = i + 1;
        }
        this.symbol_regs.push(new SymbolRegEntry(name, value));
    }

    fun set_symbol_reg_by_name(mut this, name: string, value: IRValue) {
        _utils.trace_enter("Enter set_symbol_reg_by_name");
        this.symbol_regs.push(new SymbolRegEntry(name, value));
    }

    fun clean_function_name(this, full_name: string) -> string {
        _utils.trace_enter("Enter clean_function_name");
        let prefix: string = "<global>.";
        let prefix_len: i64 = string_length(prefix);
        let full_len: i64 = string_length(full_name);
        if (full_len > prefix_len) {
            let i: mut i64 = 0;
            let matches: mut bool = true;
            while (i < prefix_len) {
                let ch: string = string_char_at(full_name, i);
                let pref_ch: string = string_char_at(prefix, i);
                if (ch != pref_ch) {
                    matches = false;
                }
                i = i + 1;
            }
            if (matches) {
                return string_substring(full_name, prefix_len, full_len - prefix_len);
            }
        }
        return full_name;
    }

    fun reset_locals(mut this) {
        _utils.trace_enter("Enter reset_locals");
        // Preserve global variable symbol registrations across function boundaries
        let saved_globals: mut _utils.List<SymbolRegEntry> = new _utils.List<SymbolRegEntry>();
        let i: mut i64 = 0;
        while (i < cast<i64>(this.symbol_regs.size())) {
            let entry: SymbolRegEntry = this.symbol_regs.at(cast<u64>(i)).some;
            if (entry.value is IRValue.global_ref) {
                saved_globals.push(entry);
            }
            i = i + 1;
        }
        this.symbol_regs = saved_globals;
        this.loop_stack = new _utils.List<LoopLabels>();
    }
}

}
