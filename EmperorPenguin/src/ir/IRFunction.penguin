namespace ir {

class IRParameter {
    name: mut string = "";
    ir_type: mut string = "";
    index: mut i64 = 0;
    location: !mut ast.SourceLocation = new ast.SourceLocation("", 0, 0);

    fun new(mut this, name: string, ir_type: string, index: i64, loc: ast.SourceLocation) {
        this.name = name;
        this.ir_type = ir_type;
        this.index = index;
        this.location = loc;
    }
}

class IRFunction {
    name: mut string = "";
    display_name: mut string = "";
    return_type: mut string = "";
    parameters: mut _utils.List<IRParameter> = new _utils.List<IRParameter>();
    instructions: mut _utils.List<IRInstruction> = new _utils.List<IRInstruction>();
    next_temp: mut i64 = 0;
    next_label: mut i64 = 0;
    is_extern: mut bool = false;
    location: !mut ast.SourceLocation = new ast.SourceLocation("", 0, 0);
    // Names already allocated in this function. PenguinLang reuses source variable
    // names across sibling scopes (e.g. two `let x` in different if-branches of the
    // same function). Without uniquification they collapse onto one IR register; when
    // their types differ (ref vs value) the LLVMEmitter mis-sizes/mis-reads the slot
    // (the pass2 native crash). alloc_named_reg appends a counter on collision so each
    // `let` gets its own register.
    used_reg_names: mut _utils.List<string> = new _utils.List<string>();

    fun new(mut this, name: string, return_type: string, loc: ast.SourceLocation) {
        this.name = name;
        this.return_type = return_type;
        this.location = loc;
    }

    fun alloc_named_reg(mut this, name: string, ir_type: string, line: i64, col: i64) -> IRValue {
        let unique_name: string = this.make_unique_reg_name(name);
        return new IRValue.named_reg(new IRNamedRegister(unique_name, ir_type, line, col));
    }

    // Return `name` if not yet used in this function; otherwise `name_N` for the
    // smallest N that is unused. Records the chosen name so later allocations
    // (including redeclarations of the same source name in a sibling scope) get a
    // distinct register.
    fun make_unique_reg_name(mut this, name: string) -> string {
        let candidate: mut string = name;
        let n: mut i64 = 1;
        while (this.reg_name_taken(candidate)) {
            candidate = name + "_" + cast<string>(n);
            n = n + 1;
        }
        this.used_reg_names.push(candidate);
        return candidate;
    }

    fun reg_name_taken(this, name: string) -> bool {
        let i: mut i64 = 0;
        while (i < cast<i64>(this.used_reg_names.size())) {
            if (this.used_reg_names.at(cast<u64>(i)).some == name) { return true; }
            i = i + 1;
        }
        return false;
    }

    fun alloc_temp(mut this, ir_type: string) -> IRValue {
        let idx: i64 = this.next_temp;
        this.next_temp = this.next_temp + 1;
        return new IRValue.temp_reg(new IRTempRegister(idx, ir_type));
    }

    fun alloc_label(mut this, prefix: string) -> IRLabel {
        let idx: i64 = this.next_label;
        this.next_label = this.next_label + 1;
        return new IRLabel(prefix + cast<string>(idx));
    }

    fun add_inst(mut this, inst: IRInstruction) {
        this.instructions.push(inst);
    }

    fun alloc_param(mut this, name: string, ir_type: string, line: i64, col: i64) -> IRValue {
        let idx: i64 = cast<i64>(this.parameters.size());
        let param_loc: ast.SourceLocation = new ast.SourceLocation(this.location.filename, line, col);
        let param = new IRParameter(name, ir_type, idx, param_loc);
        this.parameters.push(param);
        return this.alloc_named_reg(name, ir_type, line, col);
    }

    fun has_terminator(this) -> bool {
        if (cast<i64>(this.instructions.size()) == 0) { return false; }
        let last: IRInstruction = this.instructions.at(cast<u64>(cast<i64>(this.instructions.size()) - 1)).some;
        return last.is_terminator();
    }

    fun ends_with_control_flow(this) -> bool {
        if (cast<i64>(this.instructions.size()) == 0) { return false; }
        let last: IRInstruction = this.instructions.at(cast<u64>(cast<i64>(this.instructions.size()) - 1)).some;
        if (last.is_control_flow()) { return true; }
        // Check second-to-last instruction in case a label was added after BR
        if (cast<i64>(this.instructions.size()) >= 2) {
            let second_last: IRInstruction = this.instructions.at(cast<u64>(cast<i64>(this.instructions.size()) - 2)).some;
            if (second_last.is_control_flow()) { return true; }
        }
        return false;
    }

    fun to_string(this) -> string {
        return "IRFunction{name=" + this.name + ", ret=" + this.return_type + ", params=" + cast<string>(this.parameters.size()) + ", instrs=" + cast<string>(this.instructions.size()) + "}";
    }
}

}
