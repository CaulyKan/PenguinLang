namespace emperor {

class IRParameter {
    name: mut string = "";
    ir_type: mut string = "";
    index: mut i64 = 0;
    location: !mut SourceLocation = new SourceLocation("", 0, 0);

    fun new(mut this, name: string, ir_type: string, index: i64, loc: SourceLocation) {
        this.name = name;
        this.ir_type = ir_type;
        this.index = index;
        this.location = loc;
    }
}

class IRFunction {
    name: mut string = "";
    display_name: mut string = "";
    return_type: mut string = "";
    parameters: mut _utils.List<IRParameter> = new _utils.List<IRParameter>();
    instructions: mut _utils.List<IRInstruction> = new _utils.List<IRInstruction>();
    next_temp: mut i64 = 0;
    next_label: mut i64 = 0;
    is_extern: mut bool = false;
    // Dyn-lib: a declaration of a function whose body lives in a loaded
    // .penguin-lib (emitted by IRGenerator.ensure_extern_decl_from_def). It IS
    // extern (declared, not defined) but is a penguin function, NOT a C-runtime
    // extern — so the LLVMEmitter must NOT route it through the _emperor_*
    // extern_map (its symbol is the plain mangled name, matching the lib's def).
    is_lib_export_decl: mut bool = false;
    location: !mut SourceLocation = new SourceLocation("", 0, 0);
    // Names already allocated in this function. PenguinLang reuses source variable
    // names across sibling scopes (e.g. two `let x` in different if-branches of the
    // same function). Without uniquification they collapse onto one IR register; when
    // their types differ (ref vs value) the LLVMEmitter mis-sizes/mis-reads the slot
    // (the pass2 native crash). alloc_named_reg appends a counter on collision so each
    // `let` gets its own register.
    used_reg_names: mut _utils.List<string> = new _utils.List<string>();

    fun new(mut this, name: string, return_type: string, loc: SourceLocation) {
        this.name = name;
        this.return_type = return_type;
        this.location = loc;
    }

    fun alloc_named_reg(mut this, name: string, ir_type: string, line: i64, col: i64) -> IRValue {
        let unique_name: string = this.make_unique_reg_name(name);
        return new IRValue.named_reg(new IRNamedRegister(unique_name, ir_type, line, col));
    }

    // Return `name` if not yet used in this function; otherwise `name_N` for the
    // smallest N that is unused. Records the chosen name so later allocations
    // (including redeclarations of the same source name in a sibling scope) get a
    // distinct register.
    fun make_unique_reg_name(mut this, name: string) -> string {
        // A name shaped like a TEMP register (`t` + digits — IRTempRegister
        // displays as %tN) is unconditionally reshaped first: a user variable
        // named t5 lowering to plain SSA `%t5` collides with temp registers
        // in the same function (multiple definition at link).
        // Batch 5 (C1, 4.4 handoff): likewise for LABEL-shaped names —
        // `entry` (the emitter names every function's first block `entry:`)
        // and `<label-prefix><digits>` (then1/else2/merge0/while3/... — the
        // IR generator's alloc_label names) plus `cond_<digits>` (the
        // emitter's per-branch i1 value). A user register/parameter with
        // such a name collides with the label/value namespace (LLVM text IR
        // shares one identifier namespace for blocks and values per
        // function): `fun f(entry: i64)` produced `%entry` + `entry:` ->
        // clang "unable to create block named 'entry'".
        let base: mut string = name;
        if (this.is_temp_shaped_name(name)) {
            base = name + "_v";
        } else if (this.is_label_shaped_name(name)) {
            base = name + "_v";
        }
        let candidate: mut string = base;
        let n: mut i64 = 1;
        while (this.reg_name_taken(candidate)) {
            candidate = base + "_" + cast<string>(n);
            n = n + 1;
        }
        this.used_reg_names.push(candidate);
        return candidate;
    }

    fun is_temp_shaped_name(this, name: string) -> bool {
        let len: i64 = string_length(name);
        if (len < 2) { return false; }
        if (string_char_at(name, 0) != "t") { return false; }
        let i: mut i64 = 1;
        while (i < len) {
            let c: string = string_char_at(name, i);
            let is_digit: bool = c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
                || c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
            if (!is_digit) { return false; }
            i = i + 1;
        }
        return true;
    }

    // Batch 5 (C1): does `name` collide with the emitter/IR-generator LABEL
    // namespace? Cover:
    //   - exactly "entry"            (LLVMEmitter names the first block `entry:`)
    //   - <prefix><digits> where prefix is any alloc_label prefix: catch,
    //     else, merge, then, while, while_body, while_exit, sc_merge,
    //     sc_next, try_bind_done, try_bind_then, try_body, try_end
    //   - cond_<digits>              (LLVMInstructions' per-branch i1 value)
    // Longer prefixes are checked first so `while_body3` matches
    // "while_body"+digits rather than "while"+"body3".
    fun is_label_shaped_name(this, name: string) -> bool {
        if (name == "entry") { return true; }
        // cond_<digits> (underscore separator — a VALUE, same namespace)
        if (this.name_is_prefix_digits(name, "cond_")) { return true; }
        let prefixes: mut _utils.List<string> = new _utils.List<string>();
        prefixes.push("try_bind_done");
        prefixes.push("try_bind_then");
        prefixes.push("while_body");
        prefixes.push("while_exit");
        prefixes.push("sc_merge");
        prefixes.push("sc_next");
        prefixes.push("try_body");
        prefixes.push("try_end");
        prefixes.push("catch");
        prefixes.push("else");
        prefixes.push("merge");
        prefixes.push("then");
        prefixes.push("while");
        let i: mut i64 = 0;
        while (i < cast<i64>(prefixes.size())) {
            if (this.name_is_prefix_digits(name, prefixes.at(cast<u64>(i)).some)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    // `name` == prefix followed by one or more digits (prefix itself must be
    // a strict prefix — name longer than prefix).
    fun name_is_prefix_digits(this, name: string, prefix: string) -> bool {
        let nlen: i64 = string_length(name);
        let plen: i64 = string_length(prefix);
        if (nlen <= plen) { return false; }
        let i: mut i64 = 0;
        while (i < plen) {
            if (string_char_at(name, i) != string_char_at(prefix, i)) { return false; }
            i = i + 1;
        }
        i = plen;
        while (i < nlen) {
            let c: string = string_char_at(name, i);
            let is_digit: bool = c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
                || c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
            if (!is_digit) { return false; }
            i = i + 1;
        }
        return true;
    }

    fun reg_name_taken(this, name: string) -> bool {
        let i: mut i64 = 0;
        while (i < cast<i64>(this.used_reg_names.size())) {
            if (this.used_reg_names.at(cast<u64>(i)).some == name) { return true; }
            i = i + 1;
        }
        return false;
    }

    fun alloc_temp(mut this, ir_type: string) -> IRValue {
        let idx: i64 = this.next_temp;
        this.next_temp = this.next_temp + 1;
        return new IRValue.temp_reg(new IRTempRegister(idx, ir_type));
    }

    fun alloc_label(mut this, prefix: string) -> IRLabel {
        let idx: i64 = this.next_label;
        this.next_label = this.next_label + 1;
        return new IRLabel(prefix + cast<string>(idx));
    }

    fun add_inst(mut this, inst: IRInstruction) {
        this.instructions.push(inst);
    }

    fun alloc_param(mut this, name: string, ir_type: string, line: i64, col: i64) -> IRValue {
        let idx: i64 = cast<i64>(this.parameters.size());
        let param_loc: SourceLocation = new SourceLocation(this.location.filename, line, col);
        // Batch 5 (C1, 4.4 handoff): route the parameter through
        // make_unique_reg_name so a label-shaped name (`entry`, `else2`, ...)
        // is reshaped BEFORE it lands in the LLVM signature — a parameter
        // `%entry` collides with the emitter's `entry:` block label (clang:
        // "unable to create block named 'entry'"). IRParameter and the
        // entry-block register share the SAME final name (callers read it
        // back via param_ir_name so the ARG instructions match).
        let unique_name: string = this.make_unique_reg_name(name);
        let mut param = new IRParameter(unique_name, ir_type, idx, param_loc);
        this.parameters.push(param);
        return new IRValue.named_reg(new IRNamedRegister(unique_name, ir_type, line, col));
    }

    // The final LLVM name of parameter `idx` (post label-shape reshape) — the
    // string the function signature AND the ARG instructions must agree on.
    fun param_ir_name(this, idx: i64) -> string {
        return this.parameters.at(cast<u64>(idx)).some.name;
    }

    fun has_terminator(this) -> bool {
        if (cast<i64>(this.instructions.size()) == 0) { return false; }
        let last: IRInstruction = this.instructions.at(cast<u64>(cast<i64>(this.instructions.size()) - 1)).some;
        return last.is_terminator();
    }

    fun ends_with_control_flow(this) -> bool {
        if (cast<i64>(this.instructions.size()) == 0) { return false; }
        let last: IRInstruction = this.instructions.at(cast<u64>(cast<i64>(this.instructions.size()) - 1)).some;
        if (last.is_control_flow()) { return true; }
        // Check second-to-last instruction in case a label was added after BR
        if (cast<i64>(this.instructions.size()) >= 2) {
            let second_last: IRInstruction = this.instructions.at(cast<u64>(cast<i64>(this.instructions.size()) - 2)).some;
            if (second_last.is_control_flow()) { return true; }
        }
        return false;
    }

    fun to_string(this) -> string {
        return "IRFunction{name=" + this.name + ", ret=" + this.return_type + ", params=" + cast<string>(this.parameters.size()) + ", instrs=" + cast<string>(this.instructions.size()) + "}";
    }
}

}
