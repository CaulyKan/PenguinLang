namespace emperor {

// Set is_exported on an AST definition after an `export` prefix is parsed.
fun _mark_ast_exported(def: Definition) {
    if (def is Definition.function_def) { let f: mut FunctionDefinition = def.function_def; f.is_exported = true; }
    else if (def is Definition.class_def) { let c: mut ClassDefinition = def.class_def; c.is_exported = true; }
    else if (def is Definition.enum_def) { let e: mut EnumDefinition = def.enum_def; e.is_exported = true; }
    else if (def is Definition.interface_def) { let i: mut InterfaceDefinition = def.interface_def; i.is_exported = true; }
    else if (def is Definition.namespace_def) { let n: mut NamespaceDefinition = def.namespace_def; n.is_exported = true; }
    else if (def is Definition.type_ref_def) { let t: mut TypeReferenceDefinition = def.type_ref_def; t.is_exported = true; }
}

    class Parser {
        stream: mut TokenStream = new TokenStream(new _utils.List<Token>());
        errors: mut _utils.List<string> = new _utils.List<string>();

        fun new(mut this, tokens: mut _utils.List<Token>) {
            this.stream = new TokenStream(tokens);
        }

        fun report_error(this, message: string) {
            let tok: Token = this.stream.peek();
            let err: string = tok.location.to_string() + ": " + message;
            this.errors.push(err);
            print(err);
        }

        fun has_errors(this) -> bool {
            return cast<i64>(this.errors.size()) > 0;
        }

        // Create a new SourceLocation from a token's location fields
        fun tok_loc(this, tok: Token) -> SourceLocation {
            return new SourceLocation(tok.location.filename, tok.location.line, tok.location.col);
        }

        // Create a new SourceLocation from the current peek token
        fun cur_loc(this) -> SourceLocation {
            return this.tok_loc(this.stream.peek());
        }

        // primaryExpression: Constant | StringLiteral+ | boolLiteral | voidLiteral | identifierWithGeneric | lambdaFunctionExpression | '(' expression ')' | codeBlockExpression | ifExpression | whileExpression | 'cast' '<' typeSpecifier '>' '(' expression ')';
        // Classification: Alternative
        fun parse_primaryExpression(this) -> Expression {
            let token: Token = this.stream.peek();
            if (token.token_type is TokenType.Constant) {
                let tok: Token = this.stream.advance();
                return new Expression.constant(new ConstantExpression(tok.text));
            } else if (token.token_type is TokenType.Stringliteral) {
                let tok: Token = this.stream.advance();
                let str_expr: StringLiteralExpression = new StringLiteralExpression(tok.text);
                return new Expression.string_literal(str_expr);
            } else if (token.token_type is TokenType.True || token.token_type is TokenType.False) {
                return this.parse_boolLiteral();
            } else if (token.token_type is TokenType.Void) {
                return this.parse_voidLiteral();
            } else if (token.token_type is TokenType.Identifier || token.token_type is TokenType.ThisKw) {
                return this.parse_identifierWithGeneric();
            } else if (token.token_type is TokenType.Fun || token.token_type is TokenType.Async_fun) {
                return this.parse_lambdaFunctionExpression();
            } else if (token.token_type is TokenType.LParen) {
                this.stream.expect(new TokenType.LParen());
                let inner = this.parse_expression();
                this.stream.expect(new TokenType.RParen());
                let paren_expr: ParenthesizedExpression = new ParenthesizedExpression();
                paren_expr.inner = new Option<Expression>.some(inner);
                return new Expression.parenthesized(paren_expr);
            } else if (token.token_type is TokenType.LBrace) {
                return this.parse_codeBlockExpression();
            } else if (token.token_type is TokenType.If) {
                return this.parse_ifExpression();
            } else if (token.token_type is TokenType.While) {
                return this.parse_whileExpression();
            } else if (token.token_type is TokenType.Cast) {
                this.stream.expect(new TokenType.Cast());
                this.stream.expect(new TokenType.Less());
                // Parse a full type specifier so generic args and qualified names work:
                //   cast<IFoo<u8>>(x), cast<mut Self>(this), cast<ns.Foo>(x)
                let target_type: TypeSpecifier = this.parse_typeSpecifier();
                this.stream.expect(new TokenType.Greater());
                this.stream.expect(new TokenType.LParen());
                let cast_inner: Expression = this.parse_expression();
                this.stream.expect(new TokenType.RParen());
                let cast_node: CastExpression = new CastExpression();
                // Build dotted display name (mirrors the NewExpression parser).
                let mut sb = new StringBuilder();
                let qi: mut i64 = 0;
                while (qi < cast<i64>(target_type.qualified_parts.size())) {
                    sb.append(target_type.qualified_parts.at(cast<u64>(qi)).some);
                    sb.append(".");
                    qi = qi + 1;
                }
                sb.append(target_type.name);
                cast_node.type_name = sb.to_string();
                cast_node.target_type = new Option<TypeSpecifier>.some(target_type);
                cast_node.location = target_type.location;
                cast_node.inner = new Option<Expression>.some(cast_inner);
                return new Expression.cast_expr(cast_node);
            } else if (token.token_type is TokenType.Let) {
                return this.parse_tryBindExpression();
            } else if (token.token_type is TokenType.Hash) {
                this.stream.expect(new TokenType.Hash());
                let name_token: Token = this.stream.advance();
                let mc: mut MetaCallExpression = new MetaCallExpression();
                mc.func_name = name_token.text;
                mc.location = this.tok_loc(name_token);
                this.stream.expect(new TokenType.LParen());
                while (!(this.stream.peek_type() is TokenType.RParen)) {
                    let arg = this.parse_meta_argument();
                    mc.arguments.push(arg);
                    if (this.stream.peek_type() is TokenType.Comma) { this.stream.advance(); }
                }
                this.stream.expect(new TokenType.RParen());
                if (this.stream.peek_type() is TokenType.LBrace) {
                    this.capture_meta_trailing_block(mc);
                }
                return new Expression.meta_call(mc);
            } else {
                return new Expression.constant(new ConstantExpression(""));
            }
        }

        // `let a [: T] := b` — try-bind expression. Parsed as a primary so the
        // trailing `&&`/`||` bind outside it; the RHS stops at bitwiseOr level.
        fun parse_tryBindExpression(this) -> Expression {
            let start_loc: SourceLocation = this.cur_loc();
            this.stream.expect(new TokenType.Let());
            if (this.stream.match(new TokenType.Mut())) {
                this.report_error("E_PARSE: `let mut` is not supported in try-bind yet");
            }
            let name_token: Token = this.stream.advance();
            let type_spec_val: mut Option<TypeSpecifier> = new Option<TypeSpecifier>.none();
            if (this.stream.match(new TokenType.Colon())) {
                type_spec_val = new Option<TypeSpecifier>.some(this.parse_typeSpecifier());
            }
            this.stream.expect(new TokenType.ColonAssign());
            let rhs: Expression = this.parse_bitwiseOrExpression();
            let node: mut TryBindExpression = new TryBindExpression();
            node.variable_name = name_token.text;
            node.type_spec = type_spec_val;
            node.rhs = new Option<Expression>.some(rhs);
            node.location = start_loc;
            return new Expression.try_bind(node);
        }

        // Meta-call arguments may be type names (e.g. #typeof(i32)). Primitive
        // type keywords (i32, u64, string, ...) are not valid expressions, so in
        // a meta-call argument position we wrap the keyword token's text as an
        // IdentifierExpression — the meta engine resolves the name later. Without
        // this, parse_primaryExpression's fallback returns a constant WITHOUT
        // consuming the keyword token, and the argument loop above spins forever
        // (this was the smoke_4c2 `return #typeof(i32);` hang / SIGKILL 137).
        fun parse_meta_argument(this) -> Expression {
            let t: Token = this.stream.peek();
            let tt: TokenType = t.token_type;
            if (tt is TokenType.I8 || tt is TokenType.I16 || tt is TokenType.I32 || tt is TokenType.I64
                || tt is TokenType.U8 || tt is TokenType.U16 || tt is TokenType.U32 || tt is TokenType.U64
                || tt is TokenType.Float || tt is TokenType.Double
                || tt is TokenType.Bool || tt is TokenType.StringKw || tt is TokenType.Char || tt is TokenType.Void) {
                let tok: Token = this.stream.advance();
                return new Expression.identifier(new IdentifierExpression(tok.text));
            }
            return this.parse_expression();
        }

        // Meta-call trailing block `{ ... }`: capture it two ways. (1) Raw inner
        // text (brace-match `{ ... }`, join inner token texts with spaces) for
        // `unstructured_ast` params — no syntax assumptions. (2) When the block
        // is standard PenguinLang syntax, a parsed code block for `ast` params.
        // Sets both fields on mc. A top-level comma (e.g. `{ a, b }`) is not a
        // valid statement separator, so such blocks skip the standard parse
        // entirely — the raw text is authoritative, and a failed standard parse
        // would poison the token stream (expect() does not roll back and error
        // recovery can overrun the block / EOF).
        fun capture_meta_trailing_block(this, mc: mut MetaCallExpression) {
            // Brace-match `{ ... }`, join the inner token texts with spaces into a
            // raw string. Trailing blocks are ONLY for `unstructured_ast` meta
            // params, which receive this text verbatim (e.g. `{ a, b }` → "a , b")
            // and parse it themselves at meta-runtime — no syntax assumptions here,
            // and never a standard code-block parse.
            this.stream.expect(new TokenType.LBrace());
            let depth: mut i64 = 1;
            let raw_sb: mut StringBuilder = new StringBuilder();
            let raw_first: mut bool = true;
            while (depth > 0 && !(this.stream.is_at_end())) {
                let t: Token = this.stream.peek();
                if (t.token_type is TokenType.LBrace) { depth = depth + 1; }
                if (t.token_type is TokenType.RBrace) { depth = depth - 1; }
                if (depth > 0) {
                    if (!raw_first) { raw_sb.append(" "); }
                    raw_sb.append(t.text);
                    raw_first = false;
                }
                this.stream.advance();
            }
            mc.trailing_block_raw = new Option<string>.some(raw_sb.to_string());
        }

        // ifExpression: 'if' '(' expression ')' codeBlockExpression ('else' (codeBlockExpression | ifExpression))?;
        // Classification: Sequence
        fun parse_ifExpression(this) -> Expression {
            this.stream.expect(new TokenType.If());
            this.stream.expect(new TokenType.LParen());
            let condition = this.parse_expression();
            this.stream.expect(new TokenType.RParen());
            let then_block: mut Option<Expression> = new Option<Expression>.none();
            if (this.stream.peek_type() is TokenType.LBrace) {
                then_block = new Option<Expression>.some(this.parse_codeBlockExpression());
            } else {
                // Braceless if: wrap single statement into a code block
                let stmt = this.parse_statement();
                let wrapper = new CodeBlockExpression();
                wrapper.statements.push(stmt);
                then_block = new Option<Expression>.some(new Expression.code_block(wrapper));
            }
            let else_block: mut Option<Expression> = new Option<Expression>.none();
            if (this.stream.match(new TokenType.Else())) {
                if (this.stream.peek_type() is TokenType.If) {
                    else_block = new Option<Expression>.some(this.parse_ifExpression());
                } else if (this.stream.peek_type() is TokenType.LBrace) {
                    else_block = new Option<Expression>.some(this.parse_codeBlockExpression());
                } else {
                    // Braceless else: wrap single statement
                    let else_stmt = this.parse_statement();
                    let else_wrapper = new CodeBlockExpression();
                    else_wrapper.statements.push(else_stmt);
                    else_block = new Option<Expression>.some(new Expression.code_block(else_wrapper));
                }
            }
            let node = new IfExpression();
            node.condition = new Option<Expression>.some(condition);
            node.then_block = then_block;
            node.else_block = else_block;
            return new Expression.if_expr(node);
        }

        // whileExpression: 'while' '(' expression ')' codeBlockExpression;
        // Classification: Sequence
        fun parse_whileExpression(this) -> Expression {
            this.stream.expect(new TokenType.While());
            this.stream.expect(new TokenType.LParen());
            let condition = this.parse_expression();
            this.stream.expect(new TokenType.RParen());
            let body: mut Option<Expression> = new Option<Expression>.none();
            if (this.stream.peek_type() is TokenType.LBrace) {
                body = new Option<Expression>.some(this.parse_codeBlockExpression());
            } else {
                // Braceless while: wrap single statement into a code block, mirroring
                // parse_ifExpression. Without this, a brace-less while body (e.g. a
                // nested `while (c) while (c2) {...}`) hit "Expected LBrace" because
                // the body was unconditionally parsed as a braced codeBlockExpression.
                let stmt = this.parse_statement();
                let wrapper = new CodeBlockExpression();
                wrapper.statements.push(stmt);
                body = new Option<Expression>.some(new Expression.code_block(wrapper));
            }
            let node = new WhileExpression();
            node.condition = new Option<Expression>.some(condition);
            node.body = body;
            return new Expression.while_expr(node);
        }

        // codeBlockExpression: '{' codeBlockItem* expression? '}';
        // Classification: Sequence
        fun parse_codeBlockExpression(this) -> Expression {
            this.stream.expect(new TokenType.LBrace());
            let node = new CodeBlockExpression();
            while (!(this.stream.is_at_end())) {
                if (this.stream.peek_type() is TokenType.RBrace) { break; }
                let _loop_guard_pos: mut i64 = this.stream.pos;
                let next: Token = this.stream.peek();
                if (next.token_type is TokenType.If || next.token_type is TokenType.While || next.token_type is TokenType.LBrace) {
                    // Block-like expressions: parse as expression, wrap without semicolon
                    let expr: Expression = this.parse_expression();
                    let bs: BlockExpressionStatement = new BlockExpressionStatement();
                    bs.expression = new Option<Expression>.some(expr);
                    node.statements.push(new Statement.block_expr(bs));
                } else if (next.token_type is TokenType.Hash || next.token_type is TokenType.Let || next.token_type is TokenType.For || next.token_type is TokenType.Return || next.token_type is TokenType.Break || next.token_type is TokenType.Continue || next.token_type is TokenType.Emit || next.token_type is TokenType.Yield || next.token_type is TokenType.InternalSignal || next.token_type is TokenType.Semicolon) {
                    let stmt = this.parse_statement();
                    node.statements.push(stmt);
                } else {
                    // expression or assignment
                    let expr = this.parse_expression();
                    if (this.stream.peek_type() is TokenType.Semicolon) {
                        this.stream.advance();
                        let es: ExpressionStatement = new ExpressionStatement();
                        es.expression = new Option<Expression>.some(expr);
                        node.statements.push(new Statement.expression(es));
                    } else if (this.stream.peek_type() is TokenType.RBrace) {
                        // trailing expression (last expression in block)
                        node.trailing_expr = new Option<Expression>.some(expr);
                        break;
                    } else {
                        // assignment: expr op value ;
                        let op_token: Token = this.stream.advance();
                        let value = this.parse_expression();
                        this.stream.expect(new TokenType.Semicolon());
                        let assign: mut AssignmentStatement = new AssignmentStatement();
                        assign.target = new Option<Expression>.some(expr);
                        let op3: mut AssignmentOperator = this.token_to_assignment_operator(op_token);
                        assign.operator_value = op3;
                        assign.value = new Option<Expression>.some(value);
                        node.statements.push(new Statement.assignment(assign));
                    }
                }
                if (this.stream.pos == _loop_guard_pos) {
                    print("ERROR: codeBlock parser stuck at pos " + cast<string>(this.stream.pos) + " token: " + this.stream.peek().to_string());
                    break;
                }
            }
            this.stream.expect(new TokenType.RBrace());
            return new Expression.code_block(node);
        }

        // identifierWithGeneric: identifier;
        // In expression context, '<' is always a comparison operator, never a generic bracket.
        fun is_type_name_token(this, tt: TokenType) -> bool {
            if (tt is TokenType.Identifier) { return true; }
            if (tt is TokenType.I8) { return true; }
            if (tt is TokenType.I16) { return true; }
            if (tt is TokenType.I32) { return true; }
            if (tt is TokenType.I64) { return true; }
            if (tt is TokenType.U8) { return true; }
            if (tt is TokenType.U16) { return true; }
            if (tt is TokenType.U32) { return true; }
            if (tt is TokenType.U64) { return true; }
            if (tt is TokenType.Bool) { return true; }
            if (tt is TokenType.StringKw) { return true; }
            if (tt is TokenType.Void) { return true; }
            if (tt is TokenType.Char) { return true; }
            return false;
        }

        fun parse_identifierWithGeneric(this) -> Expression {
            let name_token: Token = this.stream.advance();
            let id_expr: IdentifierExpression = new IdentifierExpression(name_token.text);

            // Try to parse <Type, ...> generic args
            if (this.stream.peek_type() is TokenType.Less) {
                let saved_pos: i64 = this.stream.pos;
                let generic_args: mut _utils.List<TypeSpecifier> = new _utils.List<TypeSpecifier>();
                let parse_ok: mut bool = true;
                this.stream.advance(); // consume <
                if (this.stream.peek_type() is TokenType.Greater) {
                    // Empty <> — just consume >
                    this.stream.advance();
                } else {
                    if (this.is_type_name_token(this.stream.peek_type()) || this.stream.peek_type() is TokenType.Mut) {
                        let first: TypeSpecifier = new TypeSpecifier();
                        // A type arg may have a leading 'mut' (e.g. Test<mut Foo>); without
                        // this, 'mut' is not a type-name token so the generic-args parse
                        // bailed and '<' was misread as a comparison (breaking
                        // `x is Test<mut Foo>.b` etc.).
                        if (this.stream.peek_type() is TokenType.Mut) {
                            this.stream.advance();
                            first.is_mutable = true;
                        }
                        if (!(this.is_type_name_token(this.stream.peek_type()))) {
                            parse_ok = false;
                        } else {
                            let t1: Token = this.stream.advance();
                            first.location = this.tok_loc(t1);
                            first.name = t1.text;
                            if (this.stream.peek_type() is TokenType.Less) {
                                this.parse_genericTypeArgs(first.generic_args);
                            }
                            generic_args.push(first);
                            while (this.stream.peek_type() is TokenType.Comma) {
                                this.stream.advance();
                                let next_type: TypeSpecifier = new TypeSpecifier();
                                if (this.stream.peek_type() is TokenType.Mut) {
                                    this.stream.advance();
                                    next_type.is_mutable = true;
                                }
                                if (!(this.is_type_name_token(this.stream.peek_type()))) {
                                    parse_ok = false;
                                    break;
                                }
                                let tn: Token = this.stream.advance();
                                next_type.location = this.tok_loc(tn);
                                next_type.name = tn.text;
                                if (this.stream.peek_type() is TokenType.Less) {
                                    this.parse_genericTypeArgs(next_type.generic_args);
                                }
                                generic_args.push(next_type);
                            }
                        }
                    } else {
                        parse_ok = false;
                    }
                    if (parse_ok) {
                        if (this.stream.peek_type() is TokenType.Greater) {
                            this.stream.advance(); // consume >
                        } else {
                            parse_ok = false;
                        }
                    }
                }
                let type_generic_accepted: mut bool = false;
                if (parse_ok) {
                    // Check what follows — accept for certain tokens, backtrack for operators
                    let next: Token = this.stream.peek();
                    if (next.token_type is TokenType.LParen || next.token_type is TokenType.Dot ||
                        next.token_type is TokenType.RParen || next.token_type is TokenType.Semicolon ||
                        next.token_type is TokenType.Comma || next.token_type is TokenType.LBrace ||
                        next.token_type is TokenType.Greater || next.token_type is TokenType.RBrace) {
                        id_expr.generic_args = generic_args;
                        type_generic_accepted = true;
                    }
                }
                if (!type_generic_accepted) {
                    // req3+4: type-generic args did not apply — restore and try
                    // value-expression generic args (fab<5>(), fab<N-1>()).
                    // parse_additiveExpression stops at '>' so the closing '>' is not
                    // misread as a comparison operator.
                    this.stream.pos = saved_pos;
                    this.try_parse_value_generic_args(id_expr);
                }
            }
            return new Expression.identifier(id_expr);
        }

        // req3+4: try to parse value-expression generic args at a call site
        // (fab<5>(), fab<N-1>()). Assumes peek is '<'. Uses parse_additiveExpression
        // for each arg (stops at '>'), then requires a call-terminator after '>'.
        // On success populates id_expr.value_generic_args and returns true; on any
        // failure restores the stream and returns false.
        fun try_parse_value_generic_args(this, id_expr: IdentifierExpression) -> bool {
            let saved_pos: i64 = this.stream.pos;
            this.stream.advance(); // consume '<'
            if (this.stream.peek_type() is TokenType.Greater) {
                // empty <> — not a value-generic call
                this.stream.pos = saved_pos;
                return false;
            }
            let args: mut _utils.List<Expression> = new _utils.List<Expression>();
            let ok: mut bool = true;
            while (true) {
                let arg: Expression = this.parse_additiveExpression();
                args.push(arg);
                if (this.stream.peek_type() is TokenType.Comma) {
                    this.stream.advance();
                    if (this.stream.peek_type() is TokenType.Greater) { break; }
                    continue;
                }
                break;
            }
            if (ok) {
                if (this.stream.peek_type() is TokenType.Greater) {
                    this.stream.advance(); // consume >
                } else {
                    ok = false;
                }
            }
            if (ok) {
                let next: Token = this.stream.peek();
                if (next.token_type is TokenType.LParen || next.token_type is TokenType.RParen ||
                    next.token_type is TokenType.Semicolon || next.token_type is TokenType.Comma ||
                    next.token_type is TokenType.LBrace || next.token_type is TokenType.RBrace ||
                    next.token_type is TokenType.Greater || next.token_type is TokenType.EOF) {
                    id_expr.value_generic_args = args;
                    return true;
                }
                ok = false;
            }
            this.stream.pos = saved_pos;
            return false;
        }

        // postfixExpression: primaryExpression | postfixExpression '.' identifierWithGeneric | postfixExpression '(' expression? (',' expression)* ')' | 'new' typeSpecifier '(' expression? (',' expression)* ')' | 'async' expression | 'wait' expression?;
        // Classification: LeftRecursive
        fun parse_postfixExpression(this) -> Expression {
            let results = new _utils.List<Expression>();
            if (this.stream.peek_type() is TokenType.New) {
            this.stream.expect(new TokenType.New());
            let type_token: Token = this.stream.advance();
            let mut sb = new StringBuilder();
            sb.append(type_token.text);
            let generic_args: mut _utils.List<TypeSpecifier> = new _utils.List<TypeSpecifier>();
            if (this.stream.peek_type() is TokenType.Less) {
                this.parse_genericTypeArgs(generic_args);
            }
            while (this.stream.peek_type() is TokenType.Dot) {
                this.stream.expect(new TokenType.Dot());
                sb.append(".");
                let next_token: Token = this.stream.advance();
                sb.append(next_token.text);
                if (this.stream.peek_type() is TokenType.Less) {
                    this.parse_genericTypeArgs(generic_args);
                }
            }
            this.stream.expect(new TokenType.LParen());
            let args: mut _utils.List<Expression> = new _utils.List<Expression>();
            if (!(this.stream.peek_type() is TokenType.RParen)) {
                args.push(this.parse_expression());
                while (this.stream.match(new TokenType.Comma())) {
                    args.push(this.parse_expression());
                }
            }
            this.stream.expect(new TokenType.RParen());
            let new_expr: NewExpression = new NewExpression();
            new_expr.type_name = sb.to_string();
            new_expr.generic_args = generic_args;
            new_expr.arguments = args;
            // Fall through to the postfix loop below so `new Foo().method()` and
            // `new Foo()(args)` chain correctly (the #compiler() proxy rewrite
            // emits `new emperor.CompilerContext().create_definition(...)`).
            results.push(new Expression.new_expr(new_expr));
            } else if (this.stream.peek_type() is TokenType.Async) {
            this.stream.expect(new TokenType.Async());
            let async_inner: Expression = this.parse_expression();
            let spawn_expr: SpawnAsyncExpression = new SpawnAsyncExpression();
            spawn_expr.expression = new Option<Expression>.some(async_inner);
            return new Expression.spawn_async(spawn_expr);
            } else if (this.stream.peek_type() is TokenType.Wait) {
            this.stream.expect(new TokenType.Wait());
            let wait_inner: mut Option<Expression> = new Option<Expression>.none();
            if (!(this.stream.peek_type() is TokenType.Semicolon) && !(this.stream.peek_type() is TokenType.RParen) && !(this.stream.peek_type() is TokenType.RBrace)) {
                wait_inner = new Option<Expression>.some(this.parse_expression());
            }
            let wait_expr: WaitExpression = new WaitExpression();
            wait_expr.expression = wait_inner;
            return new Expression.wait_expr(wait_expr);
            } else {
                results.push(this.parse_primaryExpression());
            }
            while (true) {
                let next = this.stream.peek();
                 if (next.token_type is TokenType.Dot) {
            this.stream.expect(new TokenType.Dot());
            let member_token: Token = this.stream.advance();
            let ma_expr: MemberAccessExpression = new MemberAccessExpression();
            ma_expr.base_expr = new Option<Expression>.some(results.at(cast<u64>(results.size() - 1)).some);
            ma_expr.member_name = member_token.text;
            // Try to parse generic args after member name (e.g., obj.method<T>(args))
            if (this.stream.peek_type() is TokenType.Less) {
                let saved_pos: i64 = this.stream.pos;
                let parse_ok: mut bool = true;
                this.stream.advance(); // consume '<'
                let first: Token = this.stream.peek();
                if (this.is_type_name_token(first.token_type)) {
                    // Parse generic args with manual backtracking (avoid parse_genericTypeArgs which calls expect)
                    let ga: mut _utils.List<TypeSpecifier> = new _utils.List<TypeSpecifier>();
                    let t1: TypeSpecifier = new TypeSpecifier();
                    let tn: Token = this.stream.advance();
                    t1.location = this.tok_loc(tn);
                    t1.name = tn.text;
                    if (this.stream.peek_type() is TokenType.Less) {
                        parse_ok = this.try_parse_genericTypeArgs(t1.generic_args);
                    }
                    if (parse_ok) { ga.push(t1); }
                    while (this.stream.peek_type() is TokenType.Comma) {
                        if (!parse_ok) { break; }
                        this.stream.advance();
                        if (this.stream.peek_type() is TokenType.Greater) { break; }
                        if (!(this.is_type_name_token(this.stream.peek_type()))) {
                            parse_ok = false;
                            break;
                        }
                        let next_type: TypeSpecifier = new TypeSpecifier();
                        let tn2: Token = this.stream.advance();
                        next_type.location = this.tok_loc(tn2);
                        next_type.name = tn2.text;
                        if (this.stream.peek_type() is TokenType.Less) {
                            parse_ok = this.try_parse_genericTypeArgs(next_type.generic_args);
                        }
                        if (parse_ok) { ga.push(next_type); }
                    }
                    if (!parse_ok) {
                        this.stream.pos = saved_pos;
                    } else if (this.stream.peek_type() is TokenType.Greater) {
                        this.stream.advance(); // consume >
                    } else {
                        parse_ok = false;
                    }
                    if (parse_ok) {
                        // Accept if followed by (, ), ;, ,, {, >, }, or EOF
                        let after: Token = this.stream.peek();
                        if (after.token_type is TokenType.LParen || after.token_type is TokenType.RParen || after.token_type is TokenType.Semicolon || after.token_type is TokenType.Comma || after.token_type is TokenType.LBrace || after.token_type is TokenType.RBrace || after.token_type is TokenType.EOF) {
                            ma_expr.generic_args = ga;
                        } else {
                            this.stream.pos = saved_pos;
                        }
                    } else {
                        this.stream.pos = saved_pos;
                    }
                } else {
                    this.stream.pos = saved_pos;
                }
            }
            results.push(new Expression.member_access(ma_expr));
                } else if (next.token_type is TokenType.LParen) {
            this.stream.expect(new TokenType.LParen());
            let fca: mut FunctionCallArguments = new FunctionCallArguments();
            if (!(this.stream.peek_type() is TokenType.RParen)) {
                fca.items.push(this.parse_expression());
                while (this.stream.match(new TokenType.Comma())) {
                    fca.items.push(this.parse_expression());
                }
            }
            this.stream.expect(new TokenType.RParen());
            let fc_expr: FunctionCallExpression = new FunctionCallExpression();
            fc_expr.callee = new Option<Expression>.some(results.at(cast<u64>(results.size() - 1)).some);
            fc_expr.arguments = fca;
            results.push(new Expression.function_call(fc_expr));
                } else {
                    break;
                }
            }
            return results.at(cast<u64>(results.size() - 1)).some;
        }

        // unaryExpression: postfixExpression | unaryOperator postfixExpression;
        // Classification: Alternative
        fun parse_unaryExpression(this) -> Expression {
            let next: Token = this.stream.peek();
            if (next.token_type is TokenType.Ampersand || next.token_type is TokenType.Star || next.token_type is TokenType.Plus || next.token_type is TokenType.Minus || next.token_type is TokenType.Tilde || next.token_type is TokenType.Bang) {
                let op_token: Token = this.stream.advance();
                let op: mut UnaryOperator = this.token_to_unary_operator(op_token);
                let operand: Expression = this.parse_unaryExpression();
                let node: UnaryExpression = new UnaryExpression();
                node.operator_value = op;
                node.operand = new Option<Expression>.some(operand);
                return new Expression.unary(node);
            }
            return this.parse_postfixExpression();
        }


        // multiplicativeExpression: unaryExpression (multiplicativeOperator unaryExpression)*;
        // Classification: Binary
        fun parse_multiplicativeExpression(this) -> Expression {
            let first: Expression = this.parse_unaryExpression();
            let operators = new _utils.List<BinaryOperator>();
            let operands = new _utils.List<Expression>();
            operands.push(first);
            while (true) {
                let token: Token = this.stream.peek();
                if (this.stream.peek_type() is TokenType.Star || this.stream.peek_type() is TokenType.Slash || this.stream.peek_type() is TokenType.Percent) {
                    let op_token: Token = this.stream.advance();
                    let op: BinaryOperator = this.token_to_binary_operator(op_token);
                    operators.push(op);
                    let right = this.parse_unaryExpression();
                    operands.push(right);
                } else {
                    break;
                }
            }

            if (operators.size() == 0) {
                return first;
            }
            let bin_expr: BinaryExpression = new BinaryExpression();
            bin_expr.operators = operators;
            bin_expr.operands = operands;
            return new Expression.binary(bin_expr);
        }


        // additiveExpression: multiplicativeExpression (additiveOperator multiplicativeExpression)*;
        // Classification: Binary
        fun parse_additiveExpression(this) -> Expression {
            let first: Expression = this.parse_multiplicativeExpression();
            let operators = new _utils.List<BinaryOperator>();
            let operands = new _utils.List<Expression>();
            operands.push(first);
            while (true) {
                let token: Token = this.stream.peek();
                if (this.stream.peek_type() is TokenType.Plus || this.stream.peek_type() is TokenType.Minus) {
                    let op_token: Token = this.stream.advance();
                    let op: BinaryOperator = this.token_to_binary_operator(op_token);
                    operators.push(op);
                    let right = this.parse_multiplicativeExpression();
                    operands.push(right);
                } else {
                    break;
                }
            }

            if (operators.size() == 0) {
                return first;
            }
            let bin_expr: BinaryExpression = new BinaryExpression();
            bin_expr.operators = operators;
            bin_expr.operands = operands;
            return new Expression.binary(bin_expr);
        }


        // relationalExpression: additiveExpression (relationalOperator additiveExpression)*;
        // Classification: Binary
        fun parse_relationalExpression(this) -> Expression {
            let first: Expression = this.parse_additiveExpression();
            let operators = new _utils.List<BinaryOperator>();
            let operands = new _utils.List<Expression>();
            operands.push(first);
            while (true) {
                let token: Token = this.stream.peek();
                if (this.stream.peek_type() is TokenType.Less || this.stream.peek_type() is TokenType.Greater || this.stream.peek_type() is TokenType.LessEqual || this.stream.peek_type() is TokenType.GreaterEqual) {
                    let op_token: Token = this.stream.advance();
                    let op: BinaryOperator = this.token_to_binary_operator(op_token);
                    operators.push(op);
                    let right = this.parse_additiveExpression();
                    operands.push(right);
                } else {
                    break;
                }
            }

            if (operators.size() == 0) {
                return first;
            }
            let bin_expr: BinaryExpression = new BinaryExpression();
            bin_expr.operators = operators;
            bin_expr.operands = operands;
            return new Expression.binary(bin_expr);
        }


        // equalityExpression: relationalExpression (equalityOperator relationalExpression)?;
        // Classification: Binary
        fun parse_equalityExpression(this) -> Expression {
            let first: Expression = this.parse_relationalExpression();
            let operators = new _utils.List<BinaryOperator>();
            let operands = new _utils.List<Expression>();
            operands.push(first);
            while (true) {
                let token: Token = this.stream.peek();
                if (this.stream.peek_type() is TokenType.EqualEqual || this.stream.peek_type() is TokenType.BangEqual || this.stream.peek_type() is TokenType.Is) {
                    let op_token: Token = this.stream.advance();
                    let op: BinaryOperator = this.token_to_binary_operator(op_token);
                    operators.push(op);
                    let right = this.parse_relationalExpression();
                    operands.push(right);
                } else {
                    break;
                }
