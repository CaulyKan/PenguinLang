namespace emperor {
    class Parser {
        stream: mut TokenStream = new TokenStream(new _utils.List<Token>());
        errors: mut _utils.List<string> = new _utils.List<string>();

        fun new(mut this, tokens: mut _utils.List<Token>) {
            this.stream = new TokenStream(tokens);
        }

        fun report_error(this, message: string) {
            let tok: Token = this.stream.peek();
            let err: string = tok.location.to_string() + ": " + message;
            this.errors.push(err);
            print(err);
        }

        fun has_errors(this) -> bool {
            return cast<i64>(this.errors.size()) > 0;
        }

        // Create a new SourceLocation from a token's location fields
        fun tok_loc(this, tok: Token) -> SourceLocation {
            return new SourceLocation(tok.location.filename, tok.location.line, tok.location.col);
        }

        // Create a new SourceLocation from the current peek token
        fun cur_loc(this) -> SourceLocation {
            return this.tok_loc(this.stream.peek());
        }

        // primaryExpression: Constant | StringLiteral+ | boolLiteral | voidLiteral | identifierWithGeneric | lambdaFunctionExpression | '(' expression ')' | codeBlockExpression | ifExpression | whileExpression | 'cast' '<' typeSpecifier '>' '(' expression ')';
        // Classification: Alternative
        fun parse_primaryExpression(this) -> Expression {
            let token: Token = this.stream.peek();
            if (token.token_type is TokenType.Constant) {
                let tok: Token = this.stream.advance();
                return new Expression.constant(new ConstantExpression(tok.text));
            } else if (token.token_type is TokenType.Stringliteral) {
                let tok: Token = this.stream.advance();
                let str_expr: StringLiteralExpression = new StringLiteralExpression(tok.text);
                return new Expression.string_literal(str_expr);
            } else if (token.token_type is TokenType.True || token.token_type is TokenType.False) {
                return this.parse_boolLiteral();
            } else if (token.token_type is TokenType.Void) {
                return this.parse_voidLiteral();
            } else if (token.token_type is TokenType.Identifier || token.token_type is TokenType.ThisKw) {
                return this.parse_identifierWithGeneric();
            } else if (token.token_type is TokenType.Fun || token.token_type is TokenType.Async_fun) {
                return this.parse_lambdaFunctionExpression();
            } else if (token.token_type is TokenType.LParen) {
                this.stream.expect(new TokenType.LParen());
                let inner = this.parse_expression();
                this.stream.expect(new TokenType.RParen());
                let paren_expr: ParenthesizedExpression = new ParenthesizedExpression();
                paren_expr.inner = new Option<Expression>.some(inner);
                return new Expression.parenthesized(paren_expr);
            } else if (token.token_type is TokenType.LBrace) {
                return this.parse_codeBlockExpression();
            } else if (token.token_type is TokenType.If) {
                return this.parse_ifExpression();
            } else if (token.token_type is TokenType.While) {
                return this.parse_whileExpression();
            } else if (token.token_type is TokenType.Cast) {
                this.stream.expect(new TokenType.Cast());
                this.stream.expect(new TokenType.Less());
                let type_token: Token = this.stream.advance();
                this.stream.expect(new TokenType.Greater());
                this.stream.expect(new TokenType.LParen());
                let cast_inner: Expression = this.parse_expression();
                this.stream.expect(new TokenType.RParen());
                let cast_node: CastExpression = new CastExpression();
                cast_node.type_name = type_token.text;
                cast_node.inner = new Option<Expression>.some(cast_inner);
                return new Expression.cast_expr(cast_node);
            } else {
                return new Expression.constant(new ConstantExpression(""));
            }
        }

        // ifExpression: 'if' '(' expression ')' codeBlockExpression ('else' (codeBlockExpression | ifExpression))?;
        // Classification: Sequence
        fun parse_ifExpression(this) -> Expression {
            this.stream.expect(new TokenType.If());
            this.stream.expect(new TokenType.LParen());
            let condition = this.parse_expression();
            this.stream.expect(new TokenType.RParen());
            let then_block: mut Option<Expression> = new Option<Expression>.none();
            if (this.stream.peek_type() is TokenType.LBrace) {
                then_block = new Option<Expression>.some(this.parse_codeBlockExpression());
            } else {
                // Braceless if: wrap single statement into a code block
                let stmt = this.parse_statement();
                let wrapper = new CodeBlockExpression();
                wrapper.statements.push(stmt);
                then_block = new Option<Expression>.some(new Expression.code_block(wrapper));
            }
            let else_block: mut Option<Expression> = new Option<Expression>.none();
            if (this.stream.match(new TokenType.Else())) {
                if (this.stream.peek_type() is TokenType.If) {
                    else_block = new Option<Expression>.some(this.parse_ifExpression());
                } else if (this.stream.peek_type() is TokenType.LBrace) {
                    else_block = new Option<Expression>.some(this.parse_codeBlockExpression());
                } else {
                    // Braceless else: wrap single statement
                    let else_stmt = this.parse_statement();
                    let else_wrapper = new CodeBlockExpression();
                    else_wrapper.statements.push(else_stmt);
                    else_block = new Option<Expression>.some(new Expression.code_block(else_wrapper));
                }
            }
            let node = new IfExpression();
            node.condition = new Option<Expression>.some(condition);
            node.then_block = then_block;
            node.else_block = else_block;
            return new Expression.if_expr(node);
        }

        // whileExpression: 'while' '(' expression ')' codeBlockExpression;
        // Classification: Sequence
        fun parse_whileExpression(this) -> Expression {
            this.stream.expect(new TokenType.While());
            this.stream.expect(new TokenType.LParen());
            let condition = this.parse_expression();
            this.stream.expect(new TokenType.RParen());
            let body: mut Option<Expression> = new Option<Expression>.none();
            if (this.stream.peek_type() is TokenType.LBrace) {
                body = new Option<Expression>.some(this.parse_codeBlockExpression());
            } else {
                // Braceless while: wrap single statement into a code block, mirroring
                // parse_ifExpression. Without this, a brace-less while body (e.g. a
                // nested `while (c) while (c2) {...}`) hit "Expected LBrace" because
                // the body was unconditionally parsed as a braced codeBlockExpression.
                let stmt = this.parse_statement();
                let wrapper = new CodeBlockExpression();
                wrapper.statements.push(stmt);
                body = new Option<Expression>.some(new Expression.code_block(wrapper));
            }
            let node = new WhileExpression();
            node.condition = new Option<Expression>.some(condition);
            node.body = body;
            return new Expression.while_expr(node);
        }

        // codeBlockExpression: '{' codeBlockItem* expression? '}';
        // Classification: Sequence
        fun parse_codeBlockExpression(this) -> Expression {
            this.stream.expect(new TokenType.LBrace());
            let node = new CodeBlockExpression();
            while (!(this.stream.is_at_end())) {
                if (this.stream.peek_type() is TokenType.RBrace) { break; }
                let _loop_guard_pos: mut i64 = this.stream.pos;
                let next: Token = this.stream.peek();
                if (next.token_type is TokenType.If || next.token_type is TokenType.While || next.token_type is TokenType.LBrace) {
                    // Block-like expressions: parse as expression, wrap without semicolon
                    let expr: Expression = this.parse_expression();
                    let bs: BlockExpressionStatement = new BlockExpressionStatement();
                    bs.expression = new Option<Expression>.some(expr);
                    node.statements.push(new Statement.block_expr(bs));
                } else if (next.token_type is TokenType.Let || next.token_type is TokenType.For || next.token_type is TokenType.Return || next.token_type is TokenType.Break || next.token_type is TokenType.Continue || next.token_type is TokenType.Emit || next.token_type is TokenType.Yield || next.token_type is TokenType.InternalSignal || next.token_type is TokenType.Semicolon) {
                    let stmt = this.parse_statement();
                    node.statements.push(stmt);
                } else {
                    // expression or assignment
                    let expr = this.parse_expression();
                    if (this.stream.peek_type() is TokenType.Semicolon) {
                        this.stream.advance();
                        let es: ExpressionStatement = new ExpressionStatement();
                        es.expression = new Option<Expression>.some(expr);
                        node.statements.push(new Statement.expression(es));
                    } else if (this.stream.peek_type() is TokenType.RBrace) {
                        // trailing expression (last expression in block)
                        node.trailing_expr = new Option<Expression>.some(expr);
                        break;
                    } else {
                        // assignment: expr op value ;
                        let op_token: Token = this.stream.advance();
                        let value = this.parse_expression();
                        this.stream.expect(new TokenType.Semicolon());
                        let assign: mut AssignmentStatement = new AssignmentStatement();
                        assign.target = new Option<Expression>.some(expr);
                        let op3: mut AssignmentOperator = this.token_to_assignment_operator(op_token);
                        assign.operator_value = op3;
                        assign.value = new Option<Expression>.some(value);
                        node.statements.push(new Statement.assignment(assign));
                    }
                }
                if (this.stream.pos == _loop_guard_pos) {
                    print("ERROR: codeBlock parser stuck at pos " + cast<string>(this.stream.pos) + " token: " + this.stream.peek().to_string());
                    break;
                }
            }
            this.stream.expect(new TokenType.RBrace());
            return new Expression.code_block(node);
        }

        // identifierWithGeneric: identifier;
        // In expression context, '<' is always a comparison operator, never a generic bracket.
        fun is_type_name_token(this, tt: TokenType) -> bool {
            if (tt is TokenType.Identifier) { return true; }
            if (tt is TokenType.I8) { return true; }
            if (tt is TokenType.I16) { return true; }
            if (tt is TokenType.I32) { return true; }
            if (tt is TokenType.I64) { return true; }
            if (tt is TokenType.U8) { return true; }
            if (tt is TokenType.U16) { return true; }
            if (tt is TokenType.U32) { return true; }
            if (tt is TokenType.U64) { return true; }
            if (tt is TokenType.Bool) { return true; }
            if (tt is TokenType.StringKw) { return true; }
            if (tt is TokenType.Void) { return true; }
            if (tt is TokenType.Char) { return true; }
            return false;
        }

        fun parse_identifierWithGeneric(this) -> Expression {
            let name_token: Token = this.stream.advance();
            let id_expr: IdentifierExpression = new IdentifierExpression(name_token.text);

            // Try to parse <Type, ...> generic args
            if (this.stream.peek_type() is TokenType.Less) {
                let saved_pos: i64 = this.stream.pos;
                let generic_args: mut _utils.List<TypeSpecifier> = new _utils.List<TypeSpecifier>();
                let parse_ok: mut bool = true;
                this.stream.advance(); // consume <
                if (this.stream.peek_type() is TokenType.Greater) {
                    // Empty <> — just consume >
                    this.stream.advance();
                } else {
                    if (this.is_type_name_token(this.stream.peek_type()) || this.stream.peek_type() is TokenType.Mut) {
                        let first: TypeSpecifier = new TypeSpecifier();
                        // A type arg may have a leading 'mut' (e.g. Test<mut Foo>); without
                        // this, 'mut' is not a type-name token so the generic-args parse
                        // bailed and '<' was misread as a comparison (breaking
                        // `x is Test<mut Foo>.b` etc.).
                        if (this.stream.peek_type() is TokenType.Mut) {
                            this.stream.advance();
                            first.is_mutable = true;
                        }
                        if (!(this.is_type_name_token(this.stream.peek_type()))) {
                            parse_ok = false;
                        } else {
                            let t1: Token = this.stream.advance();
                            first.name = t1.text;
                            if (this.stream.peek_type() is TokenType.Less) {
                                this.parse_genericTypeArgs(first.generic_args);
                            }
                            generic_args.push(first);
                            while (this.stream.peek_type() is TokenType.Comma) {
                                this.stream.advance();
                                let next_type: TypeSpecifier = new TypeSpecifier();
                                if (this.stream.peek_type() is TokenType.Mut) {
                                    this.stream.advance();
                                    next_type.is_mutable = true;
                                }
                                if (!(this.is_type_name_token(this.stream.peek_type()))) {
                                    parse_ok = false;
                                    break;
                                }
                                let tn: Token = this.stream.advance();
                                next_type.name = tn.text;
                                if (this.stream.peek_type() is TokenType.Less) {
                                    this.parse_genericTypeArgs(next_type.generic_args);
                                }
                                generic_args.push(next_type);
                            }
                        }
                    } else {
                        parse_ok = false;
                    }
                    if (parse_ok) {
                        if (this.stream.peek_type() is TokenType.Greater) {
                            this.stream.advance(); // consume >
                        } else {
                            parse_ok = false;
                        }
                    }
                }
                if (parse_ok) {
                    // Check what follows — accept for certain tokens, backtrack for operators
                    let next: Token = this.stream.peek();
                    if (next.token_type is TokenType.LParen || next.token_type is TokenType.Dot ||
                        next.token_type is TokenType.RParen || next.token_type is TokenType.Semicolon ||
                        next.token_type is TokenType.Comma || next.token_type is TokenType.LBrace ||
                        next.token_type is TokenType.Greater || next.token_type is TokenType.RBrace) {
                        id_expr.generic_args = generic_args;
                    } else {
                        this.stream.pos = saved_pos;
                    }
                } else {
                    this.stream.pos = saved_pos;
                }
            }
            return new Expression.identifier(id_expr);
        }

        // postfixExpression: primaryExpression | postfixExpression '.' identifierWithGeneric | postfixExpression '(' expression? (',' expression)* ')' | 'new' typeSpecifier '(' expression? (',' expression)* ')' | 'async' expression | 'wait' expression?;
        // Classification: LeftRecursive
        fun parse_postfixExpression(this) -> Expression {
            if (this.stream.peek_type() is TokenType.New) {
            this.stream.expect(new TokenType.New());
            let type_token: Token = this.stream.advance();
            let mut sb = new StringBuilder();
            sb.append(type_token.text);
            let generic_args: mut _utils.List<TypeSpecifier> = new _utils.List<TypeSpecifier>();
            if (this.stream.peek_type() is TokenType.Less) {
                this.parse_genericTypeArgs(generic_args);
            }
            while (this.stream.peek_type() is TokenType.Dot) {
                this.stream.expect(new TokenType.Dot());
                sb.append(".");
                let next_token: Token = this.stream.advance();
                sb.append(next_token.text);
                if (this.stream.peek_type() is TokenType.Less) {
                    this.parse_genericTypeArgs(generic_args);
                }
            }
            this.stream.expect(new TokenType.LParen());
            let args: mut _utils.List<Expression> = new _utils.List<Expression>();
            if (!(this.stream.peek_type() is TokenType.RParen)) {
                args.push(this.parse_expression());
                while (this.stream.match(new TokenType.Comma())) {
                    args.push(this.parse_expression());
                }
            }
            this.stream.expect(new TokenType.RParen());
            let new_expr: NewExpression = new NewExpression();
            new_expr.type_name = sb.to_string();
            new_expr.generic_args = generic_args;
            new_expr.arguments = args;
            return new Expression.new_expr(new_expr);
            }
            if (this.stream.peek_type() is TokenType.Async) {
            this.stream.expect(new TokenType.Async());
            let async_inner: Expression = this.parse_expression();
            let spawn_expr: SpawnAsyncExpression = new SpawnAsyncExpression();
            spawn_expr.expression = new Option<Expression>.some(async_inner);
            return new Expression.spawn_async(spawn_expr);
            }
            if (this.stream.peek_type() is TokenType.Wait) {
            this.stream.expect(new TokenType.Wait());
            let wait_inner: mut Option<Expression> = new Option<Expression>.none();
            if (!(this.stream.peek_type() is TokenType.Semicolon) && !(this.stream.peek_type() is TokenType.RParen) && !(this.stream.peek_type() is TokenType.RBrace)) {
                wait_inner = new Option<Expression>.some(this.parse_expression());
            }
            let wait_expr: WaitExpression = new WaitExpression();
            wait_expr.expression = wait_inner;
            return new Expression.wait_expr(wait_expr);
            }
            let results = new _utils.List<Expression>();
            results.push(this.parse_primaryExpression());
            while (true) {
                let next = this.stream.peek();
                 if (next.token_type is TokenType.Dot) {
            this.stream.expect(new TokenType.Dot());
            let member_token: Token = this.stream.advance();
            let ma_expr: MemberAccessExpression = new MemberAccessExpression();
            ma_expr.base_expr = new Option<Expression>.some(results.at(cast<u64>(results.size() - 1)).some);
            ma_expr.member_name = member_token.text;
            // Try to parse generic args after member name (e.g., obj.method<T>(args))
            if (this.stream.peek_type() is TokenType.Less) {
                let saved_pos: i64 = this.stream.pos;
                let parse_ok: mut bool = true;
                this.stream.advance(); // consume '<'
                let first: Token = this.stream.peek();
                if (this.is_type_name_token(first.token_type)) {
                    // Parse generic args with manual backtracking (avoid parse_genericTypeArgs which calls expect)
                    let ga: mut _utils.List<TypeSpecifier> = new _utils.List<TypeSpecifier>();
                    let t1: TypeSpecifier = new TypeSpecifier();
                    let tn: Token = this.stream.advance();
                    t1.name = tn.text;
                    if (this.stream.peek_type() is TokenType.Less) {
                        parse_ok = this.try_parse_genericTypeArgs(t1.generic_args);
                    }
                    if (parse_ok) { ga.push(t1); }
                    while (this.stream.peek_type() is TokenType.Comma) {
                        if (!parse_ok) { break; }
                        this.stream.advance();
                        if (this.stream.peek_type() is TokenType.Greater) { break; }
                        if (!(this.is_type_name_token(this.stream.peek_type()))) {
                            parse_ok = false;
                            break;
                        }
                        let next_type: TypeSpecifier = new TypeSpecifier();
                        let tn2: Token = this.stream.advance();
                        next_type.name = tn2.text;
                        if (this.stream.peek_type() is TokenType.Less) {
                            parse_ok = this.try_parse_genericTypeArgs(next_type.generic_args);
                        }
                        if (parse_ok) { ga.push(next_type); }
                    }
                    if (!parse_ok) {
                        this.stream.pos = saved_pos;
                    } else if (this.stream.peek_type() is TokenType.Greater) {
                        this.stream.advance(); // consume >
                    } else {
                        parse_ok = false;
                    }
                    if (parse_ok) {
                        // Accept if followed by (, ), ;, ,, {, >, }, or EOF
                        let after: Token = this.stream.peek();
                        if (after.token_type is TokenType.LParen || after.token_type is TokenType.RParen || after.token_type is TokenType.Semicolon || after.token_type is TokenType.Comma || after.token_type is TokenType.LBrace || after.token_type is TokenType.RBrace || after.token_type is TokenType.EOF) {
                            ma_expr.generic_args = ga;
                        } else {
                            this.stream.pos = saved_pos;
                        }
                    } else {
                        this.stream.pos = saved_pos;
                    }
                } else {
                    this.stream.pos = saved_pos;
                }
            }
            results.push(new Expression.member_access(ma_expr));
                } else if (next.token_type is TokenType.LParen) {
            this.stream.expect(new TokenType.LParen());
            let args = new _utils.List<Expression>();
            if (!(this.stream.peek_type() is TokenType.RParen)) {
                args.push(this.parse_expression());
                while (this.stream.match(new TokenType.Comma())) {
                    args.push(this.parse_expression());
                }
            }
            this.stream.expect(new TokenType.RParen());
            let fc_expr: FunctionCallExpression = new FunctionCallExpression();
            fc_expr.callee = new Option<Expression>.some(results.at(cast<u64>(results.size() - 1)).some);
            fc_expr.arguments = args;
            results.push(new Expression.function_call(fc_expr));
                } else {
                    break;
                }
            }
            return results.at(cast<u64>(results.size() - 1)).some;
        }

        // unaryExpression: postfixExpression | unaryOperator postfixExpression;
        // Classification: Alternative
        fun parse_unaryExpression(this) -> Expression {
            let next: Token = this.stream.peek();
            if (next.token_type is TokenType.Ampersand || next.token_type is TokenType.Star || next.token_type is TokenType.Plus || next.token_type is TokenType.Minus || next.token_type is TokenType.Tilde || next.token_type is TokenType.Bang) {
                let op_token: Token = this.stream.advance();
                let op: mut UnaryOperator = this.token_to_unary_operator(op_token);
                let operand: Expression = this.parse_unaryExpression();
                let node: UnaryExpression = new UnaryExpression();
                node.operator_value = op;
                node.operand = new Option<Expression>.some(operand);
                return new Expression.unary(node);
            }
            return this.parse_postfixExpression();
        }


        // multiplicativeExpression: unaryExpression (multiplicativeOperator unaryExpression)*;
        // Classification: Binary
        fun parse_multiplicativeExpression(this) -> Expression {
            let first: Expression = this.parse_unaryExpression();
            let operators = new _utils.List<BinaryOperator>();
            let operands = new _utils.List<Expression>();
            operands.push(first);
            while (true) {
                let token: Token = this.stream.peek();
                if (this.stream.peek_type() is TokenType.Star || this.stream.peek_type() is TokenType.Slash || this.stream.peek_type() is TokenType.Percent) {
                    let op_token: Token = this.stream.advance();
                    let op: BinaryOperator = this.token_to_binary_operator(op_token);
                    operators.push(op);
                    let right = this.parse_unaryExpression();
                    operands.push(right);
                } else {
                    break;
                }
            }

            if (operators.size() == 0) {
                return first;
            }
            let bin_expr: BinaryExpression = new BinaryExpression();
            bin_expr.operators = operators;
            bin_expr.operands = operands;
            return new Expression.binary(bin_expr);
        }


        // additiveExpression: multiplicativeExpression (additiveOperator multiplicativeExpression)*;
        // Classification: Binary
        fun parse_additiveExpression(this) -> Expression {
            let first: Expression = this.parse_multiplicativeExpression();
            let operators = new _utils.List<BinaryOperator>();
            let operands = new _utils.List<Expression>();
            operands.push(first);
            while (true) {
                let token: Token = this.stream.peek();
                if (this.stream.peek_type() is TokenType.Plus || this.stream.peek_type() is TokenType.Minus) {
                    let op_token: Token = this.stream.advance();
                    let op: BinaryOperator = this.token_to_binary_operator(op_token);
                    operators.push(op);
                    let right = this.parse_multiplicativeExpression();
                    operands.push(right);
                } else {
                    break;
                }
            }

            if (operators.size() == 0) {
                return first;
            }
            let bin_expr: BinaryExpression = new BinaryExpression();
            bin_expr.operators = operators;
            bin_expr.operands = operands;
            return new Expression.binary(bin_expr);
        }


        // relationalExpression: additiveExpression (relationalOperator additiveExpression)*;
        // Classification: Binary
        fun parse_relationalExpression(this) -> Expression {
            let first: Expression = this.parse_additiveExpression();
            let operators = new _utils.List<BinaryOperator>();
            let operands = new _utils.List<Expression>();
            operands.push(first);
            while (true) {
                let token: Token = this.stream.peek();
                if (this.stream.peek_type() is TokenType.Less || this.stream.peek_type() is TokenType.Greater || this.stream.peek_type() is TokenType.LessEqual || this.stream.peek_type() is TokenType.GreaterEqual) {
                    let op_token: Token = this.stream.advance();
                    let op: BinaryOperator = this.token_to_binary_operator(op_token);
                    operators.push(op);
                    let right = this.parse_additiveExpression();
                    operands.push(right);
                } else {
                    break;
                }
            }

            if (operators.size() == 0) {
                return first;
            }
            let bin_expr: BinaryExpression = new BinaryExpression();
            bin_expr.operators = operators;
            bin_expr.operands = operands;
            return new Expression.binary(bin_expr);
        }


        // equalityExpression: relationalExpression (equalityOperator relationalExpression)?;
        // Classification: Binary
        fun parse_equalityExpression(this) -> Expression {
            let first: Expression = this.parse_relationalExpression();
            let operators = new _utils.List<BinaryOperator>();
            let operands = new _utils.List<Expression>();
            operands.push(first);
            while (true) {
                let token: Token = this.stream.peek();
                if (this.stream.peek_type() is TokenType.EqualEqual || this.stream.peek_type() is TokenType.BangEqual || this.stream.peek_type() is TokenType.Is) {
                    let op_token: Token = this.stream.advance();
                    let op: BinaryOperator = this.token_to_binary_operator(op_token);
                    operators.push(op);
                    let right = this.parse_relationalExpression();
                    operands.push(right);
                } else {
                    break;
                }
            }

            if (operators.size() == 0) {
                return first;
            }
            let bin_expr: BinaryExpression = new BinaryExpression();
            bin_expr.operators = operators;
            bin_expr.operands = operands;
            return new Expression.binary(bin_expr);
        }


        // bitwiseAndExpression: equalityExpression ('&' equalityExpression)*;
        // Classification: Binary
        fun parse_bitwiseAndExpression(this) -> Expression {
            let first: Expression = this.parse_equalityExpression();
            let operators = new _utils.List<BinaryOperator>();
            let operands = new _utils.List<Expression>();
            operands.push(first);
            while (true) {
                let token: Token = this.stream.peek();
                if (this.stream.peek_type() is TokenType.Ampersand) {
                    let op_token: Token = this.stream.advance();
                    let op: BinaryOperator = this.token_to_binary_operator(op_token);
                    operators.push(op);
                    let right = this.parse_equalityExpression();
                    operands.push(right);
                } else {
                    break;
                }
            }

            if (operators.size() == 0) {
                return first;
            }
            let bin_expr: BinaryExpression = new BinaryExpression();
            bin_expr.operators = operators;
            bin_expr.operands = operands;
            return new Expression.binary(bin_expr);
        }

        // bitwiseXorExpression: bitwiseAndExpression ('^' bitwiseAndExpression)*;
        // Classification: Binary
        fun parse_bitwiseXorExpression(this) -> Expression {
            let first: Expression = this.parse_bitwiseAndExpression();
            let operators = new _utils.List<BinaryOperator>();
            let operands = new _utils.List<Expression>();
            operands.push(first);
            while (true) {
                let token: Token = this.stream.peek();
                if (this.stream.peek_type() is TokenType.Caret) {
                    let op_token: Token = this.stream.advance();
                    let op: BinaryOperator = this.token_to_binary_operator(op_token);
                    operators.push(op);
                    let right = this.parse_bitwiseAndExpression();
                    operands.push(right);
                } else {
                    break;
                }
            }

            if (operators.size() == 0) {
                return first;
            }
            let bin_expr: BinaryExpression = new BinaryExpression();
            bin_expr.operators = operators;
            bin_expr.operands = operands;
            return new Expression.binary(bin_expr);
        }

        // bitwiseOrExpression: bitwiseXorExpression ('|' bitwiseXorExpression)*;
        // Classification: Binary
        fun parse_bitwiseOrExpression(this) -> Expression {
            let first: Expression = this.parse_bitwiseXorExpression();
            let operators = new _utils.List<BinaryOperator>();
            let operands = new _utils.List<Expression>();
            operands.push(first);
            while (true) {
                let token: Token = this.stream.peek();
                if (this.stream.peek_type() is TokenType.Pipe) {
                    let op_token: Token = this.stream.advance();
                    let op: BinaryOperator = this.token_to_binary_operator(op_token);
                    operators.push(op);
                    let right = this.parse_bitwiseXorExpression();
                    operands.push(right);
                } else {
                    break;
                }
            }

            if (operators.size() == 0) {
                return first;
            }
            let bin_expr: BinaryExpression = new BinaryExpression();
            bin_expr.operators = operators;
            bin_expr.operands = operands;
            return new Expression.binary(bin_expr);
        }

        // logicalAndExpression: bitwiseOrExpression ('&&' bitwiseOrExpression)*;
        // Classification: Binary
        fun parse_logicalAndExpression(this) -> Expression {
            let first: Expression = this.parse_bitwiseOrExpression();
            let operators = new _utils.List<BinaryOperator>();
            let operands = new _utils.List<Expression>();
            operands.push(first);
            while (true) {
                let token: Token = this.stream.peek();
                if (this.stream.peek_type() is TokenType.AmpersandAmpersand) {
                    let op_token: Token = this.stream.advance();
                    let op: BinaryOperator = this.token_to_binary_operator(op_token);
                    operators.push(op);
                    let right = this.parse_bitwiseOrExpression();
                    operands.push(right);
                } else {
                    break;
                }
            }

            if (operators.size() == 0) {
                return first;
            }
            let bin_expr: BinaryExpression = new BinaryExpression();
            bin_expr.operators = operators;
            bin_expr.operands = operands;
            return new Expression.binary(bin_expr);
        }

        // logicalOrExpression: logicalAndExpression ('||' logicalAndExpression)*;
        // Classification: Binary
        fun parse_logicalOrExpression(this) -> Expression {
            let first: Expression = this.parse_logicalAndExpression();
            let operators = new _utils.List<BinaryOperator>();
            let operands = new _utils.List<Expression>();
            operands.push(first);
            while (true) {
                let token: Token = this.stream.peek();
                if (this.stream.peek_type() is TokenType.PipePipe) {
                    let op_token: Token = this.stream.advance();
                    let op: BinaryOperator = this.token_to_binary_operator(op_token);
                    operators.push(op);
                    let right = this.parse_logicalAndExpression();
                    operands.push(right);
                } else {
                    break;
                }
            }

            if (operators.size() == 0) {
                return first;
            }
            let bin_expr: BinaryExpression = new BinaryExpression();
            bin_expr.operators = operators;
            bin_expr.operands = operands;
            return new Expression.binary(bin_expr);
        }

        // expression: logicalOrExpression;
        // Classification: Wrapper
        fun parse_expression(this) -> Expression {
            return this.parse_logicalOrExpression();
        }


        // typeReferenceDeclaration: 'type' identifier '=' typeSpecifier;
        // Classification: Sequence
        fun parse_typeReferenceDeclaration(this) -> Definition {
            this.stream.expect(new TokenType.TypeKw());
            let name_token: Token = this.stream.advance();
            this.stream.expect(new TokenType.Assign());
            let ts = this.parse_typeSpecifier();
            this.stream.expect(new TokenType.Semicolon());
            let node: TypeReferenceDefinition = new TypeReferenceDefinition(name_token.text);
            node.type_spec = new Option<TypeSpecifier>.some(ts);
            return new Definition.type_ref_def(node);
        }

        // declarationWithoutInitializer: identifier ':' typeSpecifier;
        // Classification: Sequence
        fun parse_declarationWithoutInitializer(this) -> Definition {
            let name_token: Token = this.stream.advance();
            this.stream.expect(new TokenType.Colon());
            this.parse_typeSpecifier();
            let fd: FunctionDefinition = new FunctionDefinition(name_token.text);
            return new Definition.function_def(fd);
        }

        // declaration: identifier (':' typeSpecifier)? ('=' expression)?;
        // Classification: Sequence
        fun parse_declaration(this) -> Definition {
            let name_token: Token = this.stream.advance();
            let fd: FunctionDefinition = new FunctionDefinition(name_token.text);
            if (this.stream.match(new TokenType.Colon())) {
                let ts = this.parse_typeSpecifier();
                fd.return_type = new Option<TypeSpecifier>.some(ts);
            }
            if (this.stream.match(new TokenType.Assign())) {
                let expr = this.parse_expression();
                fd.body = new Option<Expression>.some(expr);
            }
            return new Definition.function_def(fd);
        }

        // classDeclaration: identifier (':' typeMutabilitySpecifier? typeSpecifier)? ('=' expression)?;
        // Classification: Sequence
        fun parse_classDeclaration(this) -> Definition {
            let name_token: Token = this.stream.advance();
            let node: mut ClassFieldDefinition = new ClassFieldDefinition(name_token.text);
            node.location = this.tok_loc(name_token);
            if (this.stream.match(new TokenType.Colon())) {
                let ts = this.parse_typeSpecifier();
                node.type_spec = new Option<TypeSpecifier>.some(ts);
            }
            if (this.stream.match(new TokenType.Assign())) {
                let init_val: Expression = this.parse_expression();
                node.initializer = new Option<Expression>.some(init_val);
            }
            return new Definition.class_field(node);
        }




        // typeSpecifier: typeMutabilitySpecifier? typeSpecifierWithoutIterable iterableType?;
        // Classification: Sequence
        fun parse_typeSpecifier(this) -> TypeSpecifier {
            let node: TypeSpecifier = new TypeSpecifier();
            let next: Token = this.stream.peek();
            if (next.token_type is TokenType.Mut) {
                this.stream.advance();
                node.is_mutable = true;
            } else if (next.text == "!mut") {
                this.stream.advance();
                node.is_not_mutable = true;
            } else if (next.token_type is TokenType.AutoKw) {
                this.stream.advance();
                node.is_auto_mutability = true;
            }
            let type_next: Token = this.stream.peek();
            if (type_next.token_type is TokenType.Fun) {
                this.stream.advance();
                if (this.stream.peek_type() is TokenType.Less) {
                    node.is_function_type = true;
                    this.parse_genericTypeArgs(node.function_params);
                } else {
                    node.name = type_next.text;
                }
            } else {
                let type_token: Token = this.stream.advance();
                node.name = type_token.text;
                while (this.stream.peek_type() is TokenType.Dot) {
                    node.qualified_parts.push(node.name);
                    this.stream.expect(new TokenType.Dot());
                    let part: Token = this.stream.advance();
                    node.name = part.text;
                }
                if (this.stream.peek_type() is TokenType.Less) {
                    this.parse_genericTypeArgs(node.generic_args);
                }
            }
            if (this.stream.peek_type() is TokenType.ArrayBracket) {
                this.stream.advance();
                node.is_iterable = true;
            }
            return node;
        }
        fun parse_genericTypeArgs(this, list: mut _utils.List<TypeSpecifier>) {
            this.stream.expect(new TokenType.Less());
            if (!(this.stream.peek_type() is TokenType.Greater)) {
                let first: TypeSpecifier = this.parse_typeSpecifierInGeneric();
                list.push(first);
                while (this.stream.peek_type() is TokenType.Comma) {
                    this.stream.advance();
                    if (this.stream.peek_type() is TokenType.Greater) { break; }
                    if (this.stream.peek_type() is TokenType.Ellipsis) {
                        this.stream.advance();
                        break;
                    }
                    let next_type: TypeSpecifier = this.parse_typeSpecifierInGeneric();
                    list.push(next_type);
                }
            }
            this.stream.expect(new TokenType.Greater());
        }

        // Non-throwing version of parse_genericTypeArgs for backtracking contexts.
        // Assumes '<' has already been consumed. Returns false on parse failure.
        fun try_parse_genericTypeArgs(this, list: mut _utils.List<TypeSpecifier>) -> bool {
            // We are positioned right after '<' — parse type args, expect '>' at end
            if (this.stream.peek_type() is TokenType.Greater) {
                this.stream.advance(); // empty <> — consume >
                return true;
            }
            if (!(this.is_type_name_token(this.stream.peek_type()))) {
                return false;
            }
            let first: TypeSpecifier = new TypeSpecifier();
            let t1: Token = this.stream.advance();
            first.name = t1.text;
            if (this.stream.peek_type() is TokenType.Less) {
                if (!this.try_parse_genericTypeArgs(first.generic_args)) {
                    return false;
                }
            }
            list.push(first);
            while (this.stream.peek_type() is TokenType.Comma) {
                this.stream.advance();
                if (this.stream.peek_type() is TokenType.Greater) { break; }
                if (!(this.is_type_name_token(this.stream.peek_type()))) {
                    return false;
                }
                let next_type: TypeSpecifier = new TypeSpecifier();
                let tn: Token = this.stream.advance();
                next_type.name = tn.text;
                if (this.stream.peek_type() is TokenType.Less) {
                    if (!this.try_parse_genericTypeArgs(next_type.generic_args)) {
                        return false;
                    }
                }
                list.push(next_type);
            }
            if (this.stream.peek_type() is TokenType.Greater) {
                this.stream.advance();
                return true;
            }
            return false;
        }

        fun parse_typeSpecifierInGeneric(this) -> TypeSpecifier {
            let ts: TypeSpecifier = new TypeSpecifier();
            if (this.stream.peek_type() is TokenType.Mut) {
                this.stream.advance();
                ts.is_mutable = true;
            }
            let t: Token = this.stream.advance();
            ts.name = t.text;
            while (this.stream.peek_type() is TokenType.Dot) {
                ts.qualified_parts.push(ts.name);
                this.stream.expect(new TokenType.Dot());
                let part: Token = this.stream.advance();
                ts.name = part.text;
            }
            if (this.stream.peek_type() is TokenType.Less) {
                this.parse_genericTypeArgs(ts.generic_args);
            }
            return ts;
        }



        // identifierWithDots: identifier ('.' identifier)*;
        // Classification: Binary
        fun parse_identifierWithDots(this) -> Expression {
            let first: Expression = this.parse_identifier();
            let operators = new _utils.List<BinaryOperator>();
            let operands = new _utils.List<Expression>();
            operands.push(first);
            while (true) {
                let token: Token = this.stream.peek();
                if (this.stream.peek_type() is TokenType.Dot) {
                    let op_token: Token = this.stream.advance();
                    let op: BinaryOperator = this.token_to_binary_operator(op_token);
                    operators.push(op);
                    let right = this.parse_identifier();
                    operands.push(right);
                } else {
                    break;
                }
            }

            if (operators.size() == 0) {
                return first;
            }
            let bin_expr: BinaryExpression = new BinaryExpression();
            bin_expr.operators = operators;
            bin_expr.operands = operands;
            return new Expression.binary(bin_expr);
        }

        // identifierWithDotsAndGenericArguments: identifierWithDots genericArguments?;
        // Classification: Sequence
        fun parse_identifierWithDotsAndGenericArguments(this) -> Expression {
            this.parse_identifierWithDots();
            if (this.stream.peek_type() is TokenType.Less) {
                this.parse_genericArguments();
            }
            let node = new ConstantExpression("");
            return new Expression.constant(node);
        }

        // genericArguments: '<' typeSpecifier (',' typeSpecifier)* (',' variadicGenericArguments)? '>';
        // Classification: Sequence
        fun parse_genericArguments(this) -> Expression {
            this.stream.expect(new TokenType.Less());
            this.parse_typeSpecifier();
            while (this.stream.peek_type() is TokenType.Comma) {
                this.stream.advance();
                if (this.stream.peek_type() is TokenType.Greater) { break; }
                this.parse_typeSpecifier();
            }
            this.stream.expect(new TokenType.Greater());
            let node = new ConstantExpression("");
            return new Expression.constant(node);
        }


        // templateParameter: identifier ':' ('type' | typeSpecifier);
        // Classification: Sequence
        fun parse_templateParameter(this) -> TemplateParameter {
            let name_token: Token = this.stream.advance();
            this.stream.expect(new TokenType.Colon());
            let node: TemplateParameter = new TemplateParameter();
            node.name = name_token.text;
            let constraint_token: Token = this.stream.peek();
            if (constraint_token.text == "type") {
                this.stream.advance();
                node.type_constraint = "type";
            } else {
                let ts = this.parse_typeSpecifier();
                node.type_constraint = "";
            }
            return node;
        }

        // templateDeclaration: '#' 'template' '(' templateParameter (',' templateParameter)* ')';
        // Classification: Sequence
        fun parse_templateDeclaration(this) -> TemplateDeclaration {
            this.stream.expect(new TokenType.Hash());
            this.stream.expect(new TokenType.TemplateKw());
            this.stream.expect(new TokenType.LParen());
            let node: TemplateDeclaration = new TemplateDeclaration();
            let tp = this.parse_templateParameter();
            node.parameters.push(tp);
            while (this.stream.peek_type() is TokenType.Comma) {
                this.stream.advance();
                let tp2 = this.parse_templateParameter();
                node.parameters.push(tp2);
            }
            this.stream.expect(new TokenType.RParen());
            return node;
        }

        // whereClause: identifier ':' typeSpecifier;
        // Classification: Sequence
        fun parse_whereClause(this) -> WhereClause {
            let name_token: Token = this.stream.advance();
            this.stream.expect(new TokenType.Colon());
            let node: WhereClause = new WhereClause();
            node.name = name_token.text;
            let ts = this.parse_typeSpecifier();
            return node;
        }

        // whereDefinition: 'where' (whereClause (',' whereClause)*);
        // Classification: Sequence
        fun parse_whereDefinition(this) -> WhereDefinition {
            this.stream.expect(new TokenType.Where());
            this.stream.expect(new TokenType.LParen());
            let node: WhereDefinition = new WhereDefinition();
            let wc = this.parse_whereClause();
            node.clauses.push(wc);
            while (this.stream.peek_type() is TokenType.Comma) {
                this.stream.advance();
                let wc2 = this.parse_whereClause();
                node.clauses.push(wc2);
            }
            this.stream.expect(new TokenType.RParen());
            return node;
        }

        // interfaceDefinition: (templateDeclaration)? 'interface' identifier '{' ((declaration ';') | functionDefinition | interfaceImplementation | eventDefinition)* '}';
        // Classification: Sequence
        fun parse_interfaceDefinition(this) -> Definition {
            let node: mut InterfaceDefinition = new InterfaceDefinition("");
            if (this.stream.peek_type() is TokenType.Hash) {
                let tpl = this.parse_templateDeclaration();
                node.template_decl = new Option<TemplateDeclaration>.some(tpl);
            }
            this.stream.expect(new TokenType.Interface());
            let name_token: Token = this.stream.advance();
            node.name = name_token.text;
            node.location = this.tok_loc(name_token);
            this.stream.expect(new TokenType.LBrace());
            let _loop_guard_pos: mut i64 = -1;
            while (!(this.stream.peek_type() is TokenType.RBrace)) {
                if (this.stream.peek_type() is TokenType.Semicolon) {
                    this.stream.advance();
                    continue;
                }
                if (this.stream.pos == _loop_guard_pos) {
                    print("ERROR: parser stuck at pos " + cast<string>(this.stream.pos) + " token: " + this.stream.peek().to_string());
                    break;
                }
                _loop_guard_pos = this.stream.pos;
                let next: Token = this.stream.peek();
                if (next.token_type is TokenType.Fun || next.token_type is TokenType.Pure || next.token_type is TokenType.NotPure || next.token_type is TokenType.Extern || next.token_type is TokenType.Async || next.token_type is TokenType.NotAsync || next.token_type is TokenType.Hash) {
                    node.members.push(this.parse_functionDefinition());
                } else if (next.token_type is TokenType.EventKw) {
                    node.members.push(this.parse_eventDefinition());
                } else if (next.token_type is TokenType.Impl) {
                    node.members.push(this.parse_interfaceImplementation());
                } else {
                    // declaration ';'
                    this.parse_declaration();
                    this.stream.expect(new TokenType.Semicolon());
                    let fd = new FunctionDefinition("");
                    node.members.push(new Definition.function_def(fd));
                }
            }
            this.stream.expect(new TokenType.RBrace());
            return new Definition.interface_def(node);
        }

        // interfaceImplementation: 'impl' typeSpecifier (whereDefinition)? (';' | ('{' (functionDefinition)* '}'));
        // Classification: Sequence
        fun parse_interfaceImplementation(this) -> Definition {
            this.stream.expect(new TokenType.Impl());
            let type_spec: TypeSpecifier = this.parse_typeSpecifier();
            if (this.stream.peek_type() is TokenType.For) {
                // interfaceForImplementation: impl Type for Type { ... }
                this.stream.expect(new TokenType.For());
                let for_type_spec: TypeSpecifier = this.parse_typeSpecifier();
                let node: InterfaceForImplementation = new InterfaceForImplementation(type_spec.name, for_type_spec.name);
                node.type_spec = new Option<TypeSpecifier>.some(type_spec);
                node.for_type_spec = new Option<TypeSpecifier>.some(for_type_spec);
                if (this.stream.peek_type() is TokenType.Where) {
                    let wd = this.parse_whereDefinition();
                    node.where_def = new Option<WhereDefinition>.some(wd);
                }
                if (this.stream.peek_type() is TokenType.LBrace) {
                    this.stream.expect(new TokenType.LBrace());
                    while (!(this.stream.peek_type() is TokenType.RBrace)) {
                        let func_def: Definition = this.parse_functionDefinition();
                        node.functions.push(func_def);
                    }
                    this.stream.expect(new TokenType.RBrace());
                } else {
                    this.stream.expect(new TokenType.Semicolon());
                }
                return new Definition.impl_for_def(node);
            }
            // interfaceImplementation: impl Type { ... } or impl Type ;
            let node2: InterfaceImplementation = new InterfaceImplementation(type_spec.name);
            node2.type_spec = new Option<TypeSpecifier>.some(type_spec);
            if (this.stream.peek_type() is TokenType.Where) {
                let wd2 = this.parse_whereDefinition();
                node2.where_def = new Option<WhereDefinition>.some(wd2);
            }
            if (this.stream.peek_type() is TokenType.LBrace) {
                this.stream.expect(new TokenType.LBrace());
                while (!(this.stream.peek_type() is TokenType.RBrace)) {
                    let func_def2: Definition = this.parse_functionDefinition();
                    node2.functions.push(func_def2);
                }
                this.stream.expect(new TokenType.RBrace());
            } else {
                this.stream.expect(new TokenType.Semicolon());
            }
            return new Definition.impl_def(node2);
        }

        // interfaceForImplementation: 'impl' typeSpecifier 'for' typeSpecifier (whereDefinition)? (';' | ('{' (functionDefinition)* '}'));
        // Classification: Sequence
        fun parse_interfaceForImplementation(this) -> Definition {
            this.stream.expect(new TokenType.Impl());
            let type_spec: TypeSpecifier = this.parse_typeSpecifier();
            if (this.stream.peek_type() is TokenType.For) {
                // interfaceForImplementation: impl Type for Type { ... }
                this.stream.expect(new TokenType.For());
                let for_type_spec: TypeSpecifier = this.parse_typeSpecifier();
                let node: InterfaceForImplementation = new InterfaceForImplementation(type_spec.name, for_type_spec.name);
                node.type_spec = new Option<TypeSpecifier>.some(type_spec);
                node.for_type_spec = new Option<TypeSpecifier>.some(for_type_spec);
                if (this.stream.peek_type() is TokenType.Where) {
                    let wd = this.parse_whereDefinition();
                    node.where_def = new Option<WhereDefinition>.some(wd);
                }
                if (this.stream.peek_type() is TokenType.LBrace) {
                    this.stream.expect(new TokenType.LBrace());
                    while (!(this.stream.peek_type() is TokenType.RBrace)) {
                        let func_def: Definition = this.parse_functionDefinition();
                        node.functions.push(func_def);
                    }
                    this.stream.expect(new TokenType.RBrace());
                } else {
                    this.stream.expect(new TokenType.Semicolon());
                }
                return new Definition.impl_for_def(node);
            }
            // interfaceImplementation: impl Type { ... } or impl Type ;
            let node2: InterfaceImplementation = new InterfaceImplementation(type_spec.name);
            node2.type_spec = new Option<TypeSpecifier>.some(type_spec);
            if (this.stream.peek_type() is TokenType.Where) {
                let wd2 = this.parse_whereDefinition();
                node2.where_def = new Option<WhereDefinition>.some(wd2);
            }
            if (this.stream.peek_type() is TokenType.LBrace) {
                this.stream.expect(new TokenType.LBrace());
                while (!(this.stream.peek_type() is TokenType.RBrace)) {
                    let func_def2: Definition = this.parse_functionDefinition();
                    node2.functions.push(func_def2);
                }
                this.stream.expect(new TokenType.RBrace());
            } else {
                this.stream.expect(new TokenType.Semicolon());
            }
            return new Definition.impl_def(node2);
        }

        // classDefinition: (templateDeclaration)? 'class' identifier '{' ((classDeclaration ';') | functionDefinition | interfaceImplementation | eventDefinition | onRoutine)* '}';
        // Classification: Sequence
        fun parse_classDefinition(this) -> Definition {
            let node: mut ClassDefinition = new ClassDefinition("");
            if (this.stream.peek_type() is TokenType.Hash) {
                let tpl = this.parse_templateDeclaration();
                node.template_decl = new Option<TemplateDeclaration>.some(tpl);
            }
            this.stream.expect(new TokenType.Class());
            let name_token: Token = this.stream.advance();
            node.name = name_token.text;
            node.location = this.tok_loc(name_token);
            this.stream.expect(new TokenType.LBrace());
            let _loop_guard_pos: mut i64 = -1;
            while (!(this.stream.peek_type() is TokenType.RBrace)) {
                if (this.stream.peek_type() is TokenType.Semicolon) {
                    this.stream.advance();
                    continue;
                }
                if (this.stream.pos == _loop_guard_pos) {
                    print("ERROR: parser stuck at pos " + cast<string>(this.stream.pos) + " token: " + this.stream.peek().to_string());
                    break;
                }
                _loop_guard_pos = this.stream.pos;
                let next: Token = this.stream.peek();
                if (next.token_type is TokenType.Fun || next.token_type is TokenType.Pure || next.token_type is TokenType.NotPure || next.token_type is TokenType.Extern || next.token_type is TokenType.Async || next.token_type is TokenType.NotAsync || next.token_type is TokenType.Hash) {
                    node.members.push(this.parse_functionDefinition());
                } else if (next.token_type is TokenType.On) {
                    node.members.push(this.parse_onRoutine());
                } else if (next.token_type is TokenType.EventKw) {
                    node.members.push(this.parse_eventDefinition());
                } else if (next.token_type is TokenType.Impl) {
                    node.members.push(this.parse_interfaceImplementation());
                } else {
                    node.members.push(this.parse_classDeclaration());
                }
            }
            this.stream.expect(new TokenType.RBrace());
            return new Definition.class_def(node);
        }

        // enumDefinition: (templateDeclaration)? 'enum' identifier '{' (enumDeclaration | functionDefinition | interfaceImplementation | eventDefinition | onRoutine)* '}';
        // Classification: Sequence
        fun parse_enumDefinition(this) -> Definition {
            let node: mut EnumDefinition = new EnumDefinition("");
            if (this.stream.peek_type() is TokenType.Hash) {
                let tpl = this.parse_templateDeclaration();
                node.template_decl = new Option<TemplateDeclaration>.some(tpl);
            }
            this.stream.expect(new TokenType.Enum());
            let name_token: Token = this.stream.advance();
            node.name = name_token.text;
            node.location = this.tok_loc(name_token);
            this.stream.expect(new TokenType.LBrace());
            let _loop_guard_pos: mut i64 = -1;
            while (!(this.stream.peek_type() is TokenType.RBrace)) {
                if (this.stream.peek_type() is TokenType.Semicolon) {
                    this.stream.advance();
                    continue;
                }
                if (this.stream.pos == _loop_guard_pos) {
                    print("ERROR: parser stuck at pos " + cast<string>(this.stream.pos) + " token: " + this.stream.peek().to_string());
                    break;
                }
                _loop_guard_pos = this.stream.pos;
                let next: Token = this.stream.peek();
                if (next.token_type is TokenType.Fun || next.token_type is TokenType.Pure || next.token_type is TokenType.NotPure || next.token_type is TokenType.Extern || next.token_type is TokenType.Async || next.token_type is TokenType.NotAsync || next.token_type is TokenType.Hash) {
                    node.members.push(this.parse_functionDefinition());
                } else if (next.token_type is TokenType.On) {
                    node.members.push(this.parse_onRoutine());
                } else if (next.token_type is TokenType.EventKw) {
                    node.members.push(this.parse_eventDefinition());
                } else if (next.token_type is TokenType.Impl) {
                    node.members.push(this.parse_interfaceImplementation());
                } else {
                    node.members.push(this.parse_enumDeclaration());
                }
            }
            this.stream.expect(new TokenType.RBrace());
            return new Definition.enum_def(node);
        }

        // enumDeclaration: identifier (':' typeSpecifier)? ';';
        // Classification: Sequence
        fun parse_enumDeclaration(this) -> Definition {
            let name_token: Token = this.stream.advance();
            let node: EnumMemberDefinition = new EnumMemberDefinition(name_token.text);
            if (this.stream.match(new TokenType.Colon())) {
                let ts = this.parse_typeSpecifier();
                node.type_spec = new Option<TypeSpecifier>.some(ts);
            }
            this.stream.expect(new TokenType.Semicolon());
            return new Definition.enum_member(node);
        }


        // codeBlockItem: statement | (letKeyword declaration ';') | (typeReferenceDeclaration ';');
        // Classification: Alternative
        fun parse_codeBlockItem(this) -> Statement {
            let next: Token = this.stream.peek();
            if (next.token_type is TokenType.TypeKw) {
                this.parse_typeReferenceDeclaration();
                let empty_stmt: ExpressionStatement = new ExpressionStatement();
                return new Statement.expression(empty_stmt);
            }
            if (next.token_type is TokenType.Let) {
                // letKeyword declaration ';'
                this.stream.advance();
                if (this.stream.match(new TokenType.Mut())) { }
                this.parse_declaration();
                this.stream.expect(new TokenType.Semicolon());
                let empty_let: ExpressionStatement = new ExpressionStatement();
                return new Statement.expression(empty_let);
            }
            // Otherwise: statement
            return this.parse_statement();
        }

        // statement: codeBlockExpression | expressionStatement | ifStatement | whileStatement | forStatement | assignmentStatement | jumpStatement | returnStatement | yieldStatement | signalStatement | emitEventStatement | ';';
        // Classification: Alternative
        fun parse_statement(this) -> Statement {
            let next: Token = this.stream.peek();
            let start_loc: SourceLocation = this.cur_loc();
            if (next.token_type is TokenType.Let) {
                this.stream.advance();
                let is_mut: mut bool = false;
                if (this.stream.match(new TokenType.Mut())) { is_mut = true; }
                let var_name: Token = this.stream.advance();
                let var_type: mut string = "";
                let type_spec_val: mut Option<TypeSpecifier> = new Option<TypeSpecifier>.none();
                if (this.stream.match(new TokenType.Colon())) {
                    let ts = this.parse_typeSpecifier();
                    var_type = ts.build_text();
                    type_spec_val = new Option<TypeSpecifier>.some(ts);
                }
                let init_val: mut Option<Expression> = new Option<Expression>.none();
                if (this.stream.match(new TokenType.Assign())) {
                    init_val = new Option<Expression>.some(this.parse_expression());
                }
                this.stream.expect(new TokenType.Semicolon());
                let let_stmt: mut LetDeclarationStatement = new LetDeclarationStatement();
                let_stmt.is_mutable = is_mut;
                let_stmt.variable_name = var_name.text;
                let_stmt.variable_type = var_type;
                let_stmt.type_spec = type_spec_val;
                let_stmt.initializer = init_val;
                let_stmt.location = start_loc;
                return new Statement.let_decl(let_stmt);
            }
            if (next.token_type is TokenType.If) {
                return this.parse_ifStatement();
            }
            if (next.token_type is TokenType.While) {
                return this.parse_whileStatement();
            }
            if (next.token_type is TokenType.For) {
                return this.parse_forStatement();
            }
            if (next.token_type is TokenType.Return) {
                return this.parse_returnStatement();
            }
            if (next.token_type is TokenType.Break || next.token_type is TokenType.Continue) {
                return this.parse_jumpStatement();
            }
            if (next.token_type is TokenType.LBrace) {
                let block = this.parse_codeBlockExpression();
                let es: mut ExpressionStatement = new ExpressionStatement();
                es.expression = new Option<Expression>.some(block);
                es.location = start_loc;
                return new Statement.expression(es);
            }
            if (next.token_type is TokenType.Emit) {
                return this.parse_emitEventStatement();
            }
            if (next.token_type is TokenType.Yield) {
                return this.parse_yieldStatement();
            }
            if (next.token_type is TokenType.InternalSignal) {
                return this.parse_signalStatement();
            }
            if (next.token_type is TokenType.Semicolon) {
                this.stream.advance();
                let empty: mut ExpressionStatement = new ExpressionStatement();
                let void_node: VoidLiteralExpression = new VoidLiteralExpression();
                empty.expression = new Option<Expression>.some(new Expression.void_literal(void_node));
                empty.location = start_loc;
                return new Statement.expression(empty);
            }
            // expression or assignment — parse expression, then check for assignment operator
            let expr = this.parse_expression();
            if (this.stream.peek_type() is TokenType.Semicolon) {
                this.stream.advance();
                let es: mut ExpressionStatement = new ExpressionStatement();
                es.expression = new Option<Expression>.some(expr);
                es.location = start_loc;
                return new Statement.expression(es);
            }
            // Must be an assignment: check for assignment operator
            let op_token: Token = this.stream.advance();
            let value = this.parse_expression();
            this.stream.expect(new TokenType.Semicolon());
            let assign: mut AssignmentStatement = new AssignmentStatement();
            assign.target = new Option<Expression>.some(expr);
            let op: mut AssignmentOperator = this.token_to_assignment_operator(op_token);
            assign.operator_value = op;
            assign.value = new Option<Expression>.some(value);
            assign.location = start_loc;
            return new Statement.assignment(assign);
        }

        // assignmentStatement: postfixExpression assignmentOperator expression ';';
        // Classification: Sequence
        fun parse_assignmentStatement(this) -> Statement {
            let start_loc: SourceLocation = this.cur_loc();
            let target = this.parse_postfixExpression();
            let op_token: Token = this.stream.advance();
            let value = this.parse_expression();
            this.stream.expect(new TokenType.Semicolon());
            let node: mut AssignmentStatement = new AssignmentStatement();
            node.target = new Option<Expression>.some(target);
            let op2: mut AssignmentOperator = this.token_to_assignment_operator(op_token);
            node.operator_value = op2;
            node.value = new Option<Expression>.some(value);
            node.location = start_loc;
            return new Statement.assignment(node);
        }

        // expressionStatement: expression ';';
        // Classification: Sequence
        fun parse_expressionStatement(this) -> Statement {
            let start_loc: SourceLocation = this.cur_loc();
            let expr = this.parse_expression();
            this.stream.expect(new TokenType.Semicolon());
            let node: mut ExpressionStatement = new ExpressionStatement();
            node.expression = new Option<Expression>.some(expr);
            node.location = start_loc;
            return new Statement.expression(node);
        }

        // ifStatement: 'if' '(' expression ')' statement ('else' statement)?;
        // Classification: Sequence
        fun parse_ifStatement(this) -> Statement {
            let start_loc: SourceLocation = this.cur_loc();
            this.stream.expect(new TokenType.If());
            this.stream.expect(new TokenType.LParen());
            let condition = this.parse_expression();
            this.stream.expect(new TokenType.RParen());
            let then_stmt = this.parse_statement();
            let else_stmt: mut Option<Statement> = new Option<Statement>.none();
            if (this.stream.match(new TokenType.Else())) {
                else_stmt = new Option<Statement>.some(this.parse_statement());
            }
            let node: mut IfStatement = new IfStatement();
            node.condition = new Option<Expression>.some(condition);
            node.then_statement = new Option<Statement>.some(then_stmt);
            node.else_statement = else_stmt;
            node.location = start_loc;
            return new Statement.if_stmt(node);
        }

        // whileStatement: 'while' '(' expression ')' statement;
        // Classification: Sequence
        fun parse_whileStatement(this) -> Statement {
            let start_loc: SourceLocation = this.cur_loc();
            this.stream.expect(new TokenType.While());
            this.stream.expect(new TokenType.LParen());
            let condition = this.parse_expression();
            this.stream.expect(new TokenType.RParen());
            let body = this.parse_statement();
            let node: mut WhileStatement = new WhileStatement();
            node.condition = new Option<Expression>.some(condition);
            node.body = new Option<Statement>.some(body);
            node.location = start_loc;
            return new Statement.while_stmt(node);
        }

        // forStatement: 'for' '(' letKeyword declaration 'in' expression ')' statement;
        // Classification: Sequence
        fun parse_forStatement(this) -> Statement {
            let start_loc: SourceLocation = this.cur_loc();
            this.stream.expect(new TokenType.For());
            this.stream.expect(new TokenType.LParen());
            this.stream.expect(new TokenType.Let());
            let is_mut: mut bool = false;
            if (this.stream.match(new TokenType.Mut())) { is_mut = true; }
            let name_token: Token = this.stream.advance();
            let var_type: mut string = "";
            if (this.stream.match(new TokenType.Colon())) {
                let type_token: Token = this.stream.advance();
                var_type = type_token.text;
            }
            this.stream.expect(new TokenType.In());
            let iterable = this.parse_expression();
            this.stream.expect(new TokenType.RParen());
            let body = this.parse_statement();
            let node: mut ForStatement = new ForStatement();
            node.is_mutable = is_mut;
            node.variable_name = name_token.text;
            node.variable_type = var_type;
            node.iterable = new Option<Expression>.some(iterable);
            node.body = new Option<Statement>.some(body);
            node.location = start_loc;
            return new Statement.for_stmt(node);
        }

        // jumpStatement: 'continue' ';' | 'break' expression? ';';
        // Classification: Alternative
        fun parse_jumpStatement(this) -> Statement {
            let next: Token = this.stream.peek();
            let start_loc: SourceLocation = this.cur_loc();
            if (next.token_type is TokenType.Continue) {
                this.stream.advance();
                this.stream.expect(new TokenType.Semicolon());
                let node: mut ContinueStatement = new ContinueStatement();
                node.location = start_loc;
                return new Statement.continue_stmt(node);
            }
            // break expression? ';'
            this.stream.expect(new TokenType.Break());
            let node: mut BreakStatement = new BreakStatement();
            if (!(this.stream.peek_type() is TokenType.Semicolon)) {
                let val: Expression = this.parse_expression();
                node.value = new Option<Expression>.some(val);
            }
            this.stream.expect(new TokenType.Semicolon());
            node.location = start_loc;
            return new Statement.break_stmt(node);
        }

        // returnStatement: returnKeyword expression? ';';
        // Classification: Sequence
        fun parse_returnStatement(this) -> Statement {
            let start_loc: SourceLocation = this.cur_loc();
            this.stream.expect(new TokenType.Return());
            let val: mut Option<Expression> = new Option<Expression>.none();
            if (!(this.stream.peek_type() is TokenType.Semicolon)) {
                val = new Option<Expression>.some(this.parse_expression());
            }
            this.stream.expect(new TokenType.Semicolon());
            let node: mut ReturnStatement = new ReturnStatement();
            node.value = val;
            node.location = start_loc;
            return new Statement.return_stmt(node);
        }


        // yieldStatement: 'yield' expression? ';';
        // Classification: Sequence
        fun parse_yieldStatement(this) -> Statement {
            let start_loc: SourceLocation = this.cur_loc();
            this.stream.expect(new TokenType.Yield());
            let node: mut YieldStatement = new YieldStatement();
            if (!(this.stream.peek_type() is TokenType.Semicolon)) {
                let val: Expression = this.parse_expression();
                node.value = new Option<Expression>.some(val);
            }
            this.stream.expect(new TokenType.Semicolon());
            node.location = start_loc;
            return new Statement.yield_stmt(node);
        }

        // signalStatement: '__signal' expression;
        // Classification: Sequence
        fun parse_signalStatement(this) -> Statement {
            let start_loc: SourceLocation = this.cur_loc();
            this.stream.expect(new TokenType.InternalSignal());
            let node: mut SignalStatement = new SignalStatement();
            let expr: Expression = this.parse_expression();
            node.expression = new Option<Expression>.some(expr);
            node.location = start_loc;
            return new Statement.signal_stmt(node);
        }

        // emitEventStatement: 'emit' expression '(' expression? ')' ';';
        // Classification: Sequence
        fun parse_emitEventStatement(this) -> Statement {
            let start_loc: SourceLocation = this.cur_loc();
            this.stream.expect(new TokenType.Emit());
            let event_expr: Expression = this.parse_expression();
            this.stream.expect(new TokenType.LParen());
            let node: mut EmitEventStatement = new EmitEventStatement();
            node.event_expr = new Option<Expression>.some(event_expr);
            if (!(this.stream.peek_type() is TokenType.RParen)) {
                let arg: Expression = this.parse_expression();
                node.argument = new Option<Expression>.some(arg);
            }
            this.stream.expect(new TokenType.RParen());
            this.stream.expect(new TokenType.Semicolon());
            node.location = start_loc;
            return new Statement.emit_event(node);
        }

        // compilationUnit: namespaceDeclaration* EOF;
        // Classification: Sequence
        fun parse_compilationUnit(this) -> CompilationUnit {
            let unit: CompilationUnit = new CompilationUnit();
            let prev_pos: mut i64 = -1;
            while (!(this.stream.is_at_end())) {
                if (this.stream.peek_type() is TokenType.Semicolon) {
                    this.stream.advance();
                    continue;
                }
                if (this.stream.pos == prev_pos) {
                    this.report_error("parser stuck at token: " + this.stream.peek().to_string());
                    break;
                }
                prev_pos = this.stream.pos;
                let def = this.parse_namespaceDeclaration();
                unit.definitions.push(def);
            }
            if (this.has_errors()) {
                print("Parse completed with " + cast<string>(this.errors.size()) + " error(s)");
            }
            return unit;
        }

        // namespaceDeclaration: (letKeyword declaration ';') | typeReferenceDeclaration | namespaceDefinition | initialRoutine | functionDefinition | classDefinition | enumDefinition | interfaceDefinition | interfaceForImplementation | eventDefinition | onRoutine | ';';
        // Classification: Alternative
        fun parse_namespaceDeclaration(this) -> Definition {
            let next: Token = this.stream.peek();
            if (next.token_type is TokenType.Namespace) {
                return this.parse_namespaceDefinition();
            }
            if (next.token_type is TokenType.Fun || next.token_type is TokenType.Pure || next.token_type is TokenType.NotPure || next.token_type is TokenType.Extern || next.token_type is TokenType.Async || next.token_type is TokenType.NotAsync) {
                return this.parse_functionDefinition();
            }
            if (next.token_type is TokenType.Hash) {
                let saved_pos: i64 = this.stream.pos;
                this.stream.advance(); // skip #
                if (this.stream.peek_type() is TokenType.TemplateKw) {
                    this.stream.advance(); // skip template
                    this.stream.expect(new TokenType.LParen());
                    let depth: mut i64 = 1;
                    while (depth > 0 && !(this.stream.is_at_end())) {
                        let t: Token = this.stream.advance();
                        if (t.token_type is TokenType.LParen) { depth = depth + 1; }
                        if (t.token_type is TokenType.RParen) { depth = depth - 1; }
                    }
                    let after_tpl: Token = this.stream.peek();
                    this.stream.pos = saved_pos;
                    if (after_tpl.token_type is TokenType.Class) { return this.parse_classDefinition(); }
                    if (after_tpl.token_type is TokenType.Enum) { return this.parse_enumDefinition(); }
                    if (after_tpl.token_type is TokenType.Interface) { return this.parse_interfaceDefinition(); }
                    if (after_tpl.token_type is TokenType.Fun) { return this.parse_functionDefinition(); }
                } else {
                    this.stream.pos = saved_pos;
                }
            }
            if (next.token_type is TokenType.Class) {
                return this.parse_classDefinition();
            }
            if (next.token_type is TokenType.Enum) {
                return this.parse_enumDefinition();
            }
            if (next.token_type is TokenType.Initial) {
                return this.parse_initialRoutine();
            }
            if (next.token_type is TokenType.Let) {
                let let_loc: SourceLocation = this.cur_loc();
                this.stream.advance();
                let is_mut: mut bool = false;
                if (this.stream.match(new TokenType.Mut())) { is_mut = true; }
                let name_tok: Token = this.stream.advance();
                let gvar: mut GlobalVariableDefinition = new GlobalVariableDefinition(name_tok.text);
                gvar.is_mutable = is_mut;
                gvar.location = let_loc;
                if (this.stream.match(new TokenType.Colon())) {
                    let ts: TypeSpecifier = this.parse_typeSpecifier();
                    gvar.type_spec = new Option<TypeSpecifier>.some(ts);
                }
                if (this.stream.match(new TokenType.Assign())) {
                    let expr: Expression = this.parse_expression();
                    gvar.initializer = new Option<Expression>.some(expr);
                }
                this.stream.expect(new TokenType.Semicolon());
                return new Definition.global_var(gvar);
            }
            if (next.token_type is TokenType.TypeKw) {
                return this.parse_typeReferenceDeclaration();
            }
            if (next.token_type is TokenType.Interface) {
                return this.parse_interfaceDefinition();
            }
            if (next.token_type is TokenType.Impl) {
                return this.parse_interfaceImplementation();
            }
            if (next.token_type is TokenType.EventKw) {
                return this.parse_eventDefinition();
            }
            if (next.token_type is TokenType.On) {
                return this.parse_onRoutine();
            }
            if (next.token_type is TokenType.Semicolon) {
                this.stream.advance();
                let fallback2 = new FunctionDefinition("");
                return new Definition.function_def(fallback2);
            }
            // fallback
            let fallback3 = new FunctionDefinition("");
            return new Definition.function_def(fallback3);
        }

        // thisParameter: 'mut'? 'this';
        // Classification: Sequence
        fun parse_thisParameter(this) -> Parameter {
            let is_mut: mut bool = false;
            if (this.stream.match(new TokenType.Mut())) { is_mut = true; }
            this.stream.expect(new TokenType.ThisKw());
            let node: Parameter = new Parameter("this");
            node.is_this = true;
            node.is_mutable = is_mut;
            if (this.stream.match(new TokenType.Colon())) {
                let ts = this.parse_typeSpecifier();
                node.type_spec = new Option<TypeSpecifier>.some(ts);
            }
            return node;
        }

        // singleParameter: identifier (':' typeSpecifier)? ('=' expression)?;
        fun parse_singleParameter(this) -> Parameter {
            let name_token: Token = this.stream.advance();
            let node: Parameter = new Parameter(name_token.text);
            if (this.stream.match(new TokenType.Colon())) {
                let ts = this.parse_typeSpecifier();
                node.type_spec = new Option<TypeSpecifier>.some(ts);
            }
            if (this.stream.match(new TokenType.Assign())) {
                let default_val: Expression = this.parse_expression();
                node.default_value = new Option<Expression>.some(default_val);
            }
            return node;
        }

        // parameterList: (thisParameter | singleParameter)? (',' singleParameter)* ','?;
        // Classification: Sequence
        fun parse_parameterList(this, params: mut _utils.List<Parameter>) {
            if (!(this.stream.peek_type() is TokenType.RParen)) {
                let first = this.stream.peek();
                if (first.token_type is TokenType.ThisKw || first.token_type is TokenType.Mut) {
                    params.push(this.parse_thisParameter());
                } else {
                    params.push(this.parse_singleParameter());
                }
            }
            while (this.stream.match(new TokenType.Comma())) {
                if (this.stream.peek_type() is TokenType.RParen) { break; }
                params.push(this.parse_singleParameter());
            }
        }


        // lambdaFunctionExpression: ('fun' | 'async_fun') ('(' parameterList ')')? ('->' typeSpecifier)? codeBlockExpression;
        // Classification: Sequence
        fun parse_lambdaFunctionExpression(this) -> Expression {
            let node: LambdaFunctionExpression = new LambdaFunctionExpression();
            if (this.stream.peek_type() is TokenType.Async_fun) {
                this.stream.advance();
                node.is_async = true;
            } else {
                this.stream.expect(new TokenType.Fun());
            }
            if (this.stream.peek_type() is TokenType.LParen) {
                this.stream.expect(new TokenType.LParen());
                this.parse_parameterList(node.parameters);
                this.stream.expect(new TokenType.RParen());
            }
            if (this.stream.match(new TokenType.Arrow())) {
                let ret_type = this.parse_typeSpecifier();
                node.return_type = new Option<TypeSpecifier>.some(ret_type);
            }
            let body: Expression = this.parse_codeBlockExpression();
            node.body = new Option<Expression>.some(body);
            return new Expression.lambda_expr(node);
        }

        // functionDefinition: functionSpecifier* 'fun' (identifier | 'new') ('(' parameterList ')')? ('->' typeSpecifier)? (codeBlockExpression | ';');
        // Classification: Sequence
        fun parse_functionDefinition(this) -> Definition {
            let node: mut FunctionDefinition = new FunctionDefinition("");
            if (this.stream.peek_type() is TokenType.Hash) {
                let tpl = this.parse_templateDeclaration();
                node.template_decl = new Option<TemplateDeclaration>.some(tpl);
            }
            while (true) {
                let spec: Token = this.stream.peek();
                if (spec.token_type is TokenType.Pure) {
                    this.stream.advance();
                    node.is_pure = true;
                } else if (spec.token_type is TokenType.NotPure) {
                    this.stream.advance();
                    node.is_not_pure = true;
                } else if (spec.token_type is TokenType.Extern) {
                    this.stream.advance();
                    node.is_extern = true;
                } else if (spec.token_type is TokenType.Async) {
                    this.stream.advance();
                    node.is_async = true;
                } else if (spec.token_type is TokenType.NotAsync) {
                    this.stream.advance();
                    node.is_not_async = true;
                } else {
                    break;
                }
            }
            this.stream.expect(new TokenType.Fun());
            let name_token: Token = this.stream.advance();
            node.name = name_token.text;
            node.location = this.tok_loc(name_token);
            if (name_token.text == "new") { node.is_new = true; }
            if (this.stream.match(new TokenType.LParen())) {
                this.parse_parameterList(node.parameters);
                this.stream.expect(new TokenType.RParen());
            }
            if (this.stream.match(new TokenType.Arrow())) {
                let ret_type = this.parse_typeSpecifier();
                node.return_type = new Option<TypeSpecifier>.some(ret_type);
            }
            if (this.stream.peek_type() is TokenType.LBrace) {
                let body_expr = this.parse_codeBlockExpression();
                node.body = new Option<Expression>.some(body_expr);
            } else {
                this.stream.expect(new TokenType.Semicolon());
            }
            return new Definition.function_def(node);
        }

        // eventDefinition: 'event' identifier (':' typeSpecifier)? ';';
        // Classification: Sequence
        fun parse_eventDefinition(this) -> Definition {
            this.stream.expect(new TokenType.EventKw());
            let name_token: Token = this.stream.advance();
            let node: EventDefinition = new EventDefinition(name_token.text);
            if (this.stream.match(new TokenType.Colon())) {
                let type_token: Token = this.stream.advance();
                let ts: TypeSpecifier = new TypeSpecifier();
                ts.name = type_token.text;
                node.event_type = new Option<TypeSpecifier>.some(ts);
            }
            this.stream.expect(new TokenType.Semicolon());
            return new Definition.event_def(node);
        }

        // initialRoutine: 'initial' identifier? codeBlockExpression;
        // Classification: Sequence
        fun parse_initialRoutine(this) -> Definition {
            let start_loc: SourceLocation = this.cur_loc();
            this.stream.expect(new TokenType.Initial());
            // Optional identifier before codeBlockExpression
            if (!(this.stream.peek_type() is TokenType.LBrace)) {
                this.stream.advance(); // consume optional identifier
            }
            let body = this.parse_codeBlockExpression();
            let node: mut InitialRoutineDefinition = new InitialRoutineDefinition();
            node.body = new Option<Expression>.some(body);
            node.location = start_loc;
            return new Definition.initial_routine(node);
        }

        // onRoutine: 'on' expression ('(' declarationWithoutInitializer? ')')? codeBlockExpression;
        // Classification: Sequence
        fun parse_onRoutine(this) -> Definition {
            this.stream.expect(new TokenType.On());
            let node: OnRoutineDefinition = new OnRoutineDefinition();
            let event_token: Token = this.stream.advance();
            let event_id: IdentifierExpression = new IdentifierExpression(event_token.text);
            if (this.stream.peek_type() is TokenType.Dot) {
                let base_id: IdentifierExpression = new IdentifierExpression(event_token.text);
                this.stream.expect(new TokenType.Dot());
                let member_token: Token = this.stream.advance();
                let ma: MemberAccessExpression = new MemberAccessExpression();
                ma.base_expr = new Option<Expression>.some(new Expression.identifier(base_id));
                ma.member_name = member_token.text;
                node.event_expr = new Option<Expression>.some(new Expression.member_access(ma));
            } else {
                node.event_name = event_token.text;
                node.event_expr = new Option<Expression>.some(new Expression.identifier(event_id));
            }
            if (this.stream.peek_type() is TokenType.LParen) {
                this.stream.expect(new TokenType.LParen());
                if (!(this.stream.peek_type() is TokenType.RParen)) {
                    this.parse_declarationWithoutInitializer();
                }
                this.stream.expect(new TokenType.RParen());
            }
            let body: Expression = this.parse_codeBlockExpression();
            node.body = new Option<Expression>.some(body);
            return new Definition.on_routine_def(node);
        }

        // namespaceDefinition: 'namespace' identifier '{' namespaceDeclaration* '}';
        // Classification: Sequence
        fun parse_namespaceDefinition(this) -> Definition {
            this.stream.expect(new TokenType.Namespace());
            let name_token: Token = this.stream.advance();
            this.stream.expect(new TokenType.LBrace());
            let node: mut NamespaceDefinition = new NamespaceDefinition(name_token.text);
            node.location = this.tok_loc(name_token);
            let _loop_guard_pos: mut i64 = -1;
            while (!(this.stream.peek_type() is TokenType.RBrace)) {
                if (this.stream.peek_type() is TokenType.Semicolon) {
                    this.stream.advance();
                    continue;
                }
                if (this.stream.pos == _loop_guard_pos) {
                    print("ERROR: parser stuck at pos " + cast<string>(this.stream.pos) + " token: " + this.stream.peek().to_string());
                    break;
                }
                _loop_guard_pos = this.stream.pos;
                let child = this.parse_namespaceDeclaration();
                node.children.push(child);
            }
            this.stream.expect(new TokenType.RBrace());
            return new Definition.namespace_def(node);
        }

        // identifier: Identifier | 'this';
        // Classification: Alternative
        fun parse_identifier(this) -> Expression {
            let token: Token = this.stream.peek();
            if (token.token_type is TokenType.Identifier) {
                let token: Token = this.stream.advance();
                return new Expression.constant(new ConstantExpression(token.text));
            } else if (token.token_type is TokenType.ThisKw) {
                let token: Token = this.stream.advance();
                return new Expression.constant(new ConstantExpression(token.text));
            } else {
                return new Expression.constant(new ConstantExpression(""));
            }
        }

        // boolLiteral: 'true' | 'false';
        // Classification: Alternative
        fun parse_boolLiteral(this) -> Expression {
            let token: Token = this.stream.peek();
            if (token.token_type is TokenType.True) {
                let token: Token = this.stream.advance();
                let node: BoolLiteralExpression = new BoolLiteralExpression();
                node.value = token.text;
                return new Expression.bool_literal(node);
            } else if (token.token_type is TokenType.False) {
                let token: Token = this.stream.advance();
                let node: BoolLiteralExpression = new BoolLiteralExpression();
                node.value = token.text;
                return new Expression.bool_literal(node);
            } else {
                let node: BoolLiteralExpression = new BoolLiteralExpression();
                return new Expression.bool_literal(node);
            }
        }

        // voidLiteral: 'void';
        // Classification: Sequence
        fun parse_voidLiteral(this) -> Expression {
            this.stream.expect(new TokenType.Void());
            let node: VoidLiteralExpression = new VoidLiteralExpression();
            node.value = "void";
            return new Expression.void_literal(node);
        }

        fun token_to_binary_operator(this, token: Token) -> BinaryOperator {
            if (token.text == "+") { return new BinaryOperator.Add(); }
            if (token.text == "-") { return new BinaryOperator.Subtract(); }
            if (token.text == "*") { return new BinaryOperator.Multiply(); }
            if (token.text == "/") { return new BinaryOperator.Divide(); }
            if (token.text == "%") { return new BinaryOperator.Modulo(); }
            if (token.text == "<") { return new BinaryOperator.LessThan(); }
            if (token.text == ">") { return new BinaryOperator.GreaterThan(); }
            if (token.text == "<=") { return new BinaryOperator.LessThanOrEqual(); }
            if (token.text == ">=") { return new BinaryOperator.GreaterThanOrEqual(); }
            if (token.text == "==") { return new BinaryOperator.Equal(); }
            if (token.text == "!=") { return new BinaryOperator.NotEqual(); }
            if (token.text == "&&") { return new BinaryOperator.LogicalAnd(); }
            if (token.text == "||") { return new BinaryOperator.LogicalOr(); }
            if (token.text == "&") { return new BinaryOperator.BitwiseAnd(); }
            if (token.text == "|") { return new BinaryOperator.BitwiseOr(); }
            if (token.text == "^") { return new BinaryOperator.BitwiseXor(); }
            if (token.text == "is") { return new BinaryOperator.Is(); }
            return new BinaryOperator.Add();
        }
        fun token_to_assignment_operator(this, token: Token) -> AssignmentOperator {
            if (token.text == "=") { return new AssignmentOperator.Assign(); }
            if (token.text == "+=") { return new AssignmentOperator.PlusAssign(); }
            if (token.text == "-=") { return new AssignmentOperator.MinusAssign(); }
            if (token.text == "*=") { return new AssignmentOperator.StarAssign(); }
            if (token.text == "/=") { return new AssignmentOperator.SlashAssign(); }
            if (token.text == "%=") { return new AssignmentOperator.PercentAssign(); }
            if (token.text == "&=") { return new AssignmentOperator.AmpersandAssign(); }
            if (token.text == "^=") { return new AssignmentOperator.CaretAssign(); }
            if (token.text == "|=") { return new AssignmentOperator.PipeAssign(); }
            return new AssignmentOperator.Assign();
        }
        fun token_to_unary_operator(this, token: Token) -> UnaryOperator {
            if (token.text == "-") { return new UnaryOperator.Negate(); }
            if (token.text == "!") { return new UnaryOperator.Not(); }
            if (token.text == "~") { return new UnaryOperator.BitwiseNot(); }
            if (token.text == "+") { return new UnaryOperator.UnaryPlus(); }
            if (token.text == "*") { return new UnaryOperator.Deref(); }
            if (token.text == "&") { return new UnaryOperator.Ref(); }
            return new UnaryOperator.Negate();
        }
    }
}
