        // logicalOrExpression: logicalAndExpression ('||' logicalAndExpression)*;
        // Classification: Binary
        fun parse_logicalOrExpression(this) -> Expression {
            let first: Expression = this.parse_logicalAndExpression();
            let operators = new _utils.List<BinaryOperator>();
            let operands = new _utils.List<Expression>();
            operands.push(first);
            while (true) {
                let token: Token = this.stream.peek();
                if (this.stream.peek_type() is TokenType.PipePipe) {
                    let op_token: Token = this.stream.advance();
                    let op: BinaryOperator = this.token_to_binary_operator(op_token);
                    operators.push(op);
                    let right = this.parse_logicalAndExpression();
                    operands.push(right);
                } else {
