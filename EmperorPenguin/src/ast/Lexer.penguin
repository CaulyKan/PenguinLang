namespace emperor {
    export class Lexer {
        source: string = "";
        filename: string = "";
        pos: mut i64 = 0;
        line: mut i64 = 1;
        col: mut i64 = 1;
        // Cached string_length(source): string helpers strlen the whole string
        // per call, so calling them per source byte made tokenization O(n^2).
        source_len: mut i64 = 0;

        fun new(mut this, source: string, filename: string) {
            this.source = source;
            this.filename = filename;
            this.source_len = string_length(source);
        }

        // O(1) code unit at pos (-1 at EOF) — the hot per-position read.
        fun peek_code(this) -> i64 {
            if (this.pos >= this.source_len) { return -1; }
            return string_char_code_at(this.source, this.pos);
        }

        fun tokenize(this) -> _utils.List<Token> {
            let mut tokens = new _utils.List<Token>();
            while (!this.is_at_end()) {
                let ch_code: i64 = this.peek_code();
                // Skip whitespace
                if (ch_code == 32 || ch_code == 9 || ch_code == 13 || ch_code == 10) {
                    if (ch_code == 10) {
                        this.line = this.line + 1;
                        this.col = 1;
                    } else {
                        this.col = this.col + 1;
                    }
                    this.advance_char();
                    continue;
                }

                // Line comment
                if (this.match_string("//")) {
                    while (!this.is_at_end() && this.peek_code() != 10) {
                        this.advance_char();
                    }
                    continue;
                }

                // Block comment
                if (this.match_string("/*")) {
                    this.advance_chars(2);
                    while (!this.is_at_end()) {
                        if (this.match_string("*/")) {
                            this.advance_chars(2);
                            break;
                        }
                        if (this.peek_code() == 10) {
                            this.line = this.line + 1;
                            this.col = 1;
                        }
                        this.advance_char();
                    }
                    continue;
                }

                if (this.match_keyword("__yield_not_finished_return")) {
                    tokens.push(new Token(new TokenType.InternalYield_not_finished_return(), "__yield_not_finished_return", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 27;
                    this.advance_chars(27);
                    continue;
                }
                if (this.match_keyword("__yield_finished_return")) {
                    tokens.push(new Token(new TokenType.InternalYield_finished_return(), "__yield_finished_return", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 23;
                    this.advance_chars(23);
                    continue;
                }
                if (this.match_keyword("__blocked_return")) {
                    tokens.push(new Token(new TokenType.InternalBlocked_return(), "__blocked_return", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 16;
                    this.advance_chars(16);
                    continue;
                }
                if (this.match_keyword("async_fun")) {
                    tokens.push(new Token(new TokenType.Async_fun(), "async_fun", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 9;
                    this.advance_chars(9);
                    continue;
                }
                if (this.match_keyword("export")) {
                    tokens.push(new Token(new TokenType.Export(), "export", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 6;
                    this.advance_chars(6);
                    continue;
                }
                if (this.match_keyword("interface")) {
                    tokens.push(new Token(new TokenType.Interface(), "interface", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 9;
                    this.advance_chars(9);
                    continue;
                }
                if (this.match_keyword("namespace")) {
                    tokens.push(new Token(new TokenType.Namespace(), "namespace", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 9;
                    this.advance_chars(9);
                    continue;
                }
                if (this.match_keyword("using")) {
                    tokens.push(new Token(new TokenType.Using(), "using", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 5;
                    this.advance_chars(5);
                    continue;
                }
                if (this.match_keyword("template")) {
                    tokens.push(new Token(new TokenType.TemplateKw(), "template", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 8;
                    this.advance_chars(8);
                    continue;
                }
                if (this.match_keyword("continue")) {
                    tokens.push(new Token(new TokenType.Continue(), "continue", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 8;
                    this.advance_chars(8);
                    continue;
                }
                if (this.match_keyword("construct")) {
                    tokens.push(new Token(new TokenType.ConstructKw(), "construct", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 9;
                    this.advance_chars(9);
                    continue;
                }
                if (this.match_keyword("output")) {
                    tokens.push(new Token(new TokenType.Output(), "output", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 6;
                    this.advance_chars(6);
                    continue;
                }
                if (this.match_keyword("catch")) {
                    tokens.push(new Token(new TokenType.CatchKw(), "catch", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 5;
                    this.advance_chars(5);
                    continue;
                }
                if (this.match_keyword("input")) {
                    tokens.push(new Token(new TokenType.Input(), "input", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 5;
                    this.advance_chars(5);
                    continue;
                }
                if (this.match_keyword("tick")) {
                    tokens.push(new Token(new TokenType.Tick(), "tick", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("try")) {
                    tokens.push(new Token(new TokenType.TryKw(), "try", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 3;
                    this.advance_chars(3);
                    continue;
                }
                if (this.match_keyword("__signal")) {
                    tokens.push(new Token(new TokenType.InternalSignal(), "__signal", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 8;
                    this.advance_chars(8);
                    continue;
                }
                if (this.match_keyword("initial")) {
                    tokens.push(new Token(new TokenType.Initial(), "initial", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 7;
                    this.advance_chars(7);
                    continue;
                }
                if (this.match_keyword("extern")) {
                    tokens.push(new Token(new TokenType.Extern(), "extern", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 6;
                    this.advance_chars(6);
                    continue;
                }
                if (this.match_keyword("double")) {
                    tokens.push(new Token(new TokenType.Double(), "double", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 6;
                    this.advance_chars(6);
                    continue;
                }
                if (this.match_keyword("string")) {
                    tokens.push(new Token(new TokenType.StringKw(), "string", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 6;
                    this.advance_chars(6);
                    continue;
                }
                if (this.match_keyword("return")) {
                    tokens.push(new Token(new TokenType.Return(), "return", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 6;
                    this.advance_chars(6);
                    continue;
                }
                if (this.match_string("!async")) {
                    tokens.push(new Token(new TokenType.NotAsync(), "!async", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 6;
                    this.advance_chars(6);
                    continue;
                }
                if (this.match_keyword("while")) {
                    tokens.push(new Token(new TokenType.While(), "while", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 5;
                    this.advance_chars(5);
                    continue;
                }
                if (this.match_keyword("async")) {
                    tokens.push(new Token(new TokenType.Async(), "async", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 5;
                    this.advance_chars(5);
                    continue;
                }
                if (this.match_keyword("float")) {
                    tokens.push(new Token(new TokenType.Float(), "float", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 5;
                    this.advance_chars(5);
                    continue;
                }
                if (this.match_keyword("class")) {
                    tokens.push(new Token(new TokenType.Class(), "class", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 5;
                    this.advance_chars(5);
                    continue;
                }
                if (this.match_keyword("break")) {
                    tokens.push(new Token(new TokenType.Break(), "break", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 5;
                    this.advance_chars(5);
                    continue;
                }
                if (this.match_keyword("yield")) {
                    tokens.push(new Token(new TokenType.Yield(), "yield", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 5;
                    this.advance_chars(5);
                    continue;
                }
                if (this.match_string("!pure")) {
                    tokens.push(new Token(new TokenType.NotPure(), "!pure", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 5;
                    this.advance_chars(5);
                    continue;
                }
                if (this.match_keyword("false")) {
                    tokens.push(new Token(new TokenType.False(), "false", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 5;
                    this.advance_chars(5);
                    continue;
                }
                if (this.match_keyword("cast")) {
                    tokens.push(new Token(new TokenType.Cast(), "cast", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("unsafe_cast")) {
                    tokens.push(new Token(new TokenType.UnsafeCast(), "unsafe_cast", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 11;
                    this.advance_chars(11);
                    continue;
                }
                if (this.match_keyword("else")) {
                    tokens.push(new Token(new TokenType.Else(), "else", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("elif")) {
                    tokens.push(new Token(new TokenType.ElifKw(), "elif", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("wait")) {
                    tokens.push(new Token(new TokenType.Wait(), "wait", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("type")) {
                    tokens.push(new Token(new TokenType.TypeKw(), "type", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_string("!mut")) {
                    tokens.push(new Token(new TokenType.NotMut(), "!mut", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("auto")) {
                    tokens.push(new Token(new TokenType.AutoKw(), "auto", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("void")) {
                    tokens.push(new Token(new TokenType.Void(), "void", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("bool")) {
                    tokens.push(new Token(new TokenType.Bool(), "bool", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("char")) {
                    tokens.push(new Token(new TokenType.Char(), "char", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("Self")) {
                    tokens.push(new Token(new TokenType.SelfKw(), "Self", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("impl")) {
                    tokens.push(new Token(new TokenType.Impl(), "impl", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("enum")) {
                    tokens.push(new Token(new TokenType.Enum(), "enum", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("this")) {
                    tokens.push(new Token(new TokenType.ThisKw(), "this", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("pure")) {
                    tokens.push(new Token(new TokenType.Pure(), "pure", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("true")) {
                    tokens.push(new Token(new TokenType.True(), "true", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 4;
                    this.advance_chars(4);
                    continue;
                }
                if (this.match_keyword("new")) {
                    tokens.push(new Token(new TokenType.New(), "new", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 3;
                    this.advance_chars(3);
                    continue;
                }
                if (this.match_keyword("let")) {
                    tokens.push(new Token(new TokenType.Let(), "let", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 3;
                    this.advance_chars(3);
                    continue;
                }
                if (this.match_keyword("mut")) {
                    tokens.push(new Token(new TokenType.Mut(), "mut", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 3;
                    this.advance_chars(3);
                    continue;
                }
                if (this.match_keyword("u16")) {
                    tokens.push(new Token(new TokenType.U16(), "u16", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 3;
                    this.advance_chars(3);
                    continue;
                }
                if (this.match_keyword("u32")) {
                    tokens.push(new Token(new TokenType.U32(), "u32", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 3;
                    this.advance_chars(3);
                    continue;
                }
                if (this.match_keyword("u64")) {
                    tokens.push(new Token(new TokenType.U64(), "u64", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 3;
                    this.advance_chars(3);
                    continue;
                }
                if (this.match_keyword("i16")) {
                    tokens.push(new Token(new TokenType.I16(), "i16", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 3;
                    this.advance_chars(3);
                    continue;
                }
                if (this.match_keyword("i32")) {
                    tokens.push(new Token(new TokenType.I32(), "i32", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 3;
                    this.advance_chars(3);
                    continue;
                }
                if (this.match_keyword("i64")) {
                    tokens.push(new Token(new TokenType.I64(), "i64", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 3;
                    this.advance_chars(3);
                    continue;
                }
                if (this.match_keyword("fun")) {
                    tokens.push(new Token(new TokenType.Fun(), "fun", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 3;
                    this.advance_chars(3);
                    continue;
                }
                if (this.match_string("...")) {
                    tokens.push(new Token(new TokenType.Ellipsis(), "...", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 3;
                    this.advance_chars(3);
                    continue;
                }
                if (this.match_keyword("for")) {
                    tokens.push(new Token(new TokenType.For(), "for", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 3;
                    this.advance_chars(3);
                    continue;
                }
                if (this.match_keyword("if")) {
                    tokens.push(new Token(new TokenType.If(), "if", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_string("<=")) {
                    tokens.push(new Token(new TokenType.LessEqual(), "<=", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_string(">=")) {
                    tokens.push(new Token(new TokenType.GreaterEqual(), ">=", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_string("==")) {
                    tokens.push(new Token(new TokenType.EqualEqual(), "==", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_string("!=")) {
                    tokens.push(new Token(new TokenType.BangEqual(), "!=", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_keyword("is")) {
                    tokens.push(new Token(new TokenType.Is(), "is", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_string("&&")) {
                    tokens.push(new Token(new TokenType.AmpersandAmpersand(), "&&", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_string("||")) {
                    tokens.push(new Token(new TokenType.PipePipe(), "||", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_string("*=")) {
                    tokens.push(new Token(new TokenType.StarAssign(), "*=", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_string("/=")) {
                    tokens.push(new Token(new TokenType.SlashAssign(), "/=", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_string("%=")) {
                    tokens.push(new Token(new TokenType.PercentAssign(), "%=", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_string("+=")) {
                    tokens.push(new Token(new TokenType.PlusAssign(), "+=", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_string("-=")) {
                    tokens.push(new Token(new TokenType.MinusAssign(), "-=", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_string("&=")) {
                    tokens.push(new Token(new TokenType.AmpersandAssign(), "&=", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_string("^=")) {
                    tokens.push(new Token(new TokenType.CaretAssign(), "^=", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_string("|=")) {
                    tokens.push(new Token(new TokenType.PipeAssign(), "|=", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_keyword("u8") && (this.pos + 2 >= this.source_len || (string_substring(this.source, this.pos + 2, 1) != "\"" && string_substring(this.source, this.pos + 2, 1) != "'"))) {
                    tokens.push(new Token(new TokenType.U8(), "u8", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_keyword("i8")) {
                    tokens.push(new Token(new TokenType.I8(), "i8", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_keyword("in")) {
                    tokens.push(new Token(new TokenType.In(), "in", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_string("->")) {
                    tokens.push(new Token(new TokenType.Arrow(), "->", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (this.match_keyword("connect")) {
                    tokens.push(new Token(new TokenType.Connect(), "connect", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 7;
                    this.advance_chars(7);
                    continue;
                }
                if (ch_code == 40) {
                    tokens.push(new Token(new TokenType.LParen(), "(", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 41) {
                    tokens.push(new Token(new TokenType.RParen(), ")", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 60) {
                    tokens.push(new Token(new TokenType.Less(), "<", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 62) {
                    tokens.push(new Token(new TokenType.Greater(), ">", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 123) {
                    tokens.push(new Token(new TokenType.LBrace(), "{", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 125) {
                    tokens.push(new Token(new TokenType.RBrace(), "}", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 46) {
                    tokens.push(new Token(new TokenType.Dot(), ".", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 44) {
                    tokens.push(new Token(new TokenType.Comma(), ",", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 38) {
                    tokens.push(new Token(new TokenType.Ampersand(), "&", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 42) {
                    tokens.push(new Token(new TokenType.Star(), "*", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 43) {
                    tokens.push(new Token(new TokenType.Plus(), "+", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 45) {
                    tokens.push(new Token(new TokenType.Minus(), "-", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 126) {
                    tokens.push(new Token(new TokenType.Tilde(), "~", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 33) {
                    tokens.push(new Token(new TokenType.Bang(), "!", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 47) {
                    tokens.push(new Token(new TokenType.Slash(), "/", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 37) {
                    tokens.push(new Token(new TokenType.Percent(), "%", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 94) {
                    tokens.push(new Token(new TokenType.Caret(), "^", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 124) {
                    tokens.push(new Token(new TokenType.Pipe(), "|", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 61) {
                    tokens.push(new Token(new TokenType.Assign(), "=", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (this.match_string(":=")) {
                    tokens.push(new Token(new TokenType.ColonAssign(), ":=", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }
                if (ch_code == 58) {
                    tokens.push(new Token(new TokenType.Colon(), ":", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 35) {
                    tokens.push(new Token(new TokenType.Hash(), "#", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                if (ch_code == 59) {
                    tokens.push(new Token(new TokenType.Semicolon(), ";", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 1;
                    this.advance_char();
                    continue;
                }
                // Array/iterable type suffix: `i64[]`. The parser expects a single
                // ArrayBracket token for `[]`.
                if (ch_code == 91 && this.pos + 1 < this.source_len && string_char_code_at(this.source, this.pos + 1) == 93) {
                    tokens.push(new Token(new TokenType.ArrayBracket(), "[]", new SourceLocation(this.filename, this.line, this.col)));
                    this.col = this.col + 2;
                    this.advance_chars(2);
                    continue;
                }

                // Check for encoding prefix (u8/u/U/L) for string/char constants
                if (ch_code == 117 || ch_code == 85 || ch_code == 76) {
                    // u8"..." string prefix
                    if (ch_code == 117 && this.pos + 2 < this.source_len && string_char_code_at(this.source, this.pos + 1) == 56 && string_char_code_at(this.source, this.pos + 2) == 34) {
                        let start_col: i64 = this.col;
                        let text: string = this.read_string_literal_with_prefix();
                        tokens.push(new Token(new TokenType.Stringliteral(), text, new SourceLocation(this.filename, this.line, start_col)));
                        this.col = this.col + string_length(text);
                        continue;
                    }
                    // u"/U"/L" string prefix
                    if (this.pos + 1 < this.source_len && string_char_code_at(this.source, this.pos + 1) == 34) {
                        let start_col: i64 = this.col;
                        let text: string = this.read_string_literal_with_prefix();
                        tokens.push(new Token(new TokenType.Stringliteral(), text, new SourceLocation(this.filename, this.line, start_col)));
                        this.col = this.col + string_length(text);
                        continue;
                    }
                    // L'/u'/U' char constant prefix
                    if (this.pos + 1 < this.source_len && string_char_code_at(this.source, this.pos + 1) == 39) {
                        let start_col: i64 = this.col;
                        let text: string = this.read_char_constant();
                        tokens.push(new Token(new TokenType.Constant(), text, new SourceLocation(this.filename, this.line, start_col)));
                        this.col = this.col + string_length(text);
                        continue;
                    }
                }
                // String literal
                if (ch_code == 34) {
                    let start_col: i64 = this.col;
                    let text: string = this.read_string_literal();
                    tokens.push(new Token(new TokenType.Stringliteral(), text, new SourceLocation(this.filename, this.line, start_col)));
                    this.col = this.col + string_length(text);
                    continue;
                }

                // Character constant
                if (ch_code == 39) {
                    let start_col: i64 = this.col;
                    let text: string = this.read_char_constant();
                    tokens.push(new Token(new TokenType.Constant(), text, new SourceLocation(this.filename, this.line, start_col)));
                    this.col = this.col + string_length(text);
                    continue;
                }
                // Constant (integer, float, or character)
                if (ch_code >= 48 && ch_code <= 57) {
                    let start_col: i64 = this.col;
                    let text: string = this.read_constant();
                    tokens.push(new Token(new TokenType.Constant(), text, new SourceLocation(this.filename, this.line, start_col)));
                    this.col = this.col + string_length(text);
                    continue;
                }

                // Identifier fallback (non-keyword alphabetic identifier)
                {
                    if ((ch_code >= 97 && ch_code <= 122) || (ch_code >= 65 && ch_code <= 90) || ch_code == 95) {
                        let start_col: i64 = this.col;
                        let text: string = this.read_while_identifier_start();
                        tokens.push(new Token(new TokenType.Identifier(), text, new SourceLocation(this.filename, this.line, start_col)));
                        this.col = this.col + string_length(text);
                        continue;
                    }
                }

                // Unknown character - skip
                this.advance_char();
            }
            tokens.push(new Token(new TokenType.EOF(), "", new SourceLocation(this.filename, this.line, this.col)));
            return tokens;
        }

        fun advance_char(this) {
            this.pos = this.pos + 1;
        }

        fun advance_chars(this, n: i64) {
            this.pos = this.pos + n;
        }

        fun is_at_end(this) -> bool {
            return this.pos >= this.source_len;
        }

        fun match_string(this, s: string) -> bool {
            return string_starts_with_at(this.source, this.pos, s);
        }

        fun read_while_digit(this) -> string {
            let start: i64 = this.pos;
            while (this.pos < this.source_len) {
                let code: i64 = string_char_code_at(this.source, this.pos);
                if (code >= 48 && code <= 57) {
                    this.pos = this.pos + 1;
                } else {
                    break;
                }
            }
            return string_substring(this.source, start, this.pos - start);
        }

        fun read_while_identifier_start(this) -> string {
            let start: i64 = this.pos;
            // Read first char: [a-zA-Z_]
            if (this.pos < this.source_len) {
                let code: i64 = string_char_code_at(this.source, this.pos);
                if ((code >= 97 && code <= 122) || (code >= 65 && code <= 90) || code == 95) {
                    this.pos = this.pos + 1;
                } else {
                    return "";
                }
            }
            // Read remaining: [a-zA-Z0-9_]*
            while (this.pos < this.source_len) {
                let code: i64 = string_char_code_at(this.source, this.pos);
                if ((code >= 97 && code <= 122) || (code >= 65 && code <= 90) || code == 95 || (code >= 48 && code <= 57)) {
                    this.pos = this.pos + 1;
                } else {
                    break;
                }
            }
            return string_substring(this.source, start, this.pos - start);
        }

        fun read_while_float(this) -> string {
            let start: i64 = this.pos;
            // Read integer part
            while (this.pos < this.source_len) {
                let code: i64 = string_char_code_at(this.source, this.pos);
                if (code >= 48 && code <= 57) {
                    this.pos = this.pos + 1;
                } else {
                    break;
                }
            }
            // Read dot and fractional part
            if (this.pos < this.source_len && string_char_code_at(this.source, this.pos) == 46) {
                this.pos = this.pos + 1;
                while (this.pos < this.source_len) {
                    let code: i64 = string_char_code_at(this.source, this.pos);
                    if (code >= 48 && code <= 57) {
                        this.pos = this.pos + 1;
                    } else {
                        break;
                    }
                }
            }
            return string_substring(this.source, start, this.pos - start);
        }

        fun match_keyword(this, keyword: string) -> bool {
            // First-code-unit precheck: the keyword chain tries ~60 candidates
            // per position, and a full starts_with for each is wasted work —
            // comparing the leading byte rejects all but a couple.
            if (this.pos >= this.source_len) { return false; }
            let c: i64 = string_char_code_at(this.source, this.pos);
            if (c != string_char_code_at(keyword, 0)) { return false; }
            if (!string_starts_with_at(this.source, this.pos, keyword)) { return false; }
            let next_pos: i64 = this.pos + string_length(keyword);
            if (next_pos >= this.source_len) { return true; }
            let code: i64 = string_char_code_at(this.source, next_pos);
            if ((code >= 97 && code <= 122) || (code >= 65 && code <= 90) || code == 95 || (code >= 48 && code <= 57)) {
                return false;
            }
            return true;
        }

        fun read_string_literal(this) -> string {
            let start: i64 = this.pos;
            this.advance_char(); // skip opening quote
            while (this.pos < this.source_len) {
                let code: i64 = string_char_code_at(this.source, this.pos);
                if (code == 34) {
                    this.pos = this.pos + 1; // include closing quote
                    break;
                }
                if (code == 92 && this.pos + 1 < this.source_len) {
                    this.pos = this.pos + 2; // skip escape sequence
                } else {
                    this.pos = this.pos + 1;
                }
            }
            return string_substring(this.source, start, this.pos - start);
        }

        fun read_constant(this) -> string {
            let start: i64 = this.pos;
            if (this.pos + 1 < this.source_len && string_char_code_at(this.source, this.pos) == 48) {
                let next: i64 = string_char_code_at(this.source, this.pos + 1);
                if (next == 120 || next == 88) {
                    this.pos = this.pos + 2;
                    while (this.pos < this.source_len) {
                        let code: i64 = string_char_code_at(this.source, this.pos);
                        if ((code >= 48 && code <= 57) || (code >= 97 && code <= 102) || (code >= 65 && code <= 70)) {
                            this.pos = this.pos + 1;
                        } else { break; }
                    }
                    if (this.pos < this.source_len && string_char_code_at(this.source, this.pos) == 46) {
                        this.pos = this.pos + 1;
                        while (this.pos < this.source_len) {
                            let code: i64 = string_char_code_at(this.source, this.pos);
                            if ((code >= 48 && code <= 57) || (code >= 97 && code <= 102) || (code >= 65 && code <= 70)) {
                                this.pos = this.pos + 1;
                            } else { break; }
                        }
                    }
                    if (this.pos < this.source_len) {
                        let code: i64 = string_char_code_at(this.source, this.pos);
                        if (code == 112 || code == 80) {
                            this.pos = this.pos + 1;
                            if (this.pos < this.source_len) { let s: i64 = string_char_code_at(this.source, this.pos); if (s == 43 || s == 45) { this.pos = this.pos + 1; } }
                            while (this.pos < this.source_len) {
                                let d: i64 = string_char_code_at(this.source, this.pos);
                                if (d >= 48 && d <= 57) { this.pos = this.pos + 1; } else { break; }
                            }
                        }
                    }
                    this.skip_constant_suffix();
                    return string_substring(this.source, start, this.pos - start);
                }
                if (next == 98 || next == 66) {
                    this.pos = this.pos + 2;
                    while (this.pos < this.source_len) {
                        let c: i64 = string_char_code_at(this.source, this.pos);
                        if (c == 48 || c == 49) { this.pos = this.pos + 1; } else { break; }
                    }
                    this.skip_constant_suffix();
                    return string_substring(this.source, start, this.pos - start);
                }
            }
            while (this.pos < this.source_len) {
                let code: i64 = string_char_code_at(this.source, this.pos);
                if (code >= 48 && code <= 57) { this.pos = this.pos + 1; } else { break; }
            }
            if (this.pos < this.source_len && string_char_code_at(this.source, this.pos) == 46) {
                this.pos = this.pos + 1;
                while (this.pos < this.source_len) {
                    let code: i64 = string_char_code_at(this.source, this.pos);
                    if (code >= 48 && code <= 57) { this.pos = this.pos + 1; } else { break; }
                }
            }
            if (this.pos < this.source_len) {
                let code: i64 = string_char_code_at(this.source, this.pos);
                if (code == 101 || code == 69) {
                    this.pos = this.pos + 1;
                    if (this.pos < this.source_len) { let s: i64 = string_char_code_at(this.source, this.pos); if (s == 43 || s == 45) { this.pos = this.pos + 1; } }
                    while (this.pos < this.source_len) {
                        let d: i64 = string_char_code_at(this.source, this.pos);
                        if (d >= 48 && d <= 57) { this.pos = this.pos + 1; } else { break; }
                    }
                }
            }
            this.skip_constant_suffix();
            return string_substring(this.source, start, this.pos - start);
        }

        fun skip_constant_suffix(this) {
            if (this.pos >= this.source_len) { return; }
            let c: i64 = string_char_code_at(this.source, this.pos);
            if (c == 102 || c == 70) { this.pos = this.pos + 1; return; }
            if (c == 117 || c == 85) {
                this.pos = this.pos + 1;
                if (this.pos < this.source_len) {
                    let c2: i64 = string_char_code_at(this.source, this.pos);
                    if (c2 == 108 || c2 == 76) {
                        this.pos = this.pos + 1;
                        if (this.pos < this.source_len) { let c3: i64 = string_char_code_at(this.source, this.pos); if (c3 == 108 || c3 == 76) { this.pos = this.pos + 1; } }
                    }
                }
                return;
            }
            if (c == 108 || c == 76) {
                this.pos = this.pos + 1;
                if (this.pos < this.source_len) {
                    let c2: i64 = string_char_code_at(this.source, this.pos);
                    if (c2 == 108 || c2 == 76) {
                        this.pos = this.pos + 1;
                        if (this.pos < this.source_len) { let c3: i64 = string_char_code_at(this.source, this.pos); if (c3 == 117 || c3 == 85) { this.pos = this.pos + 1; } }
                        return;
                    }
                    if (c2 == 117 || c2 == 85) { this.pos = this.pos + 1; }
                }
                return;
            }
        }


        fun read_char_constant(this) -> string {
            let start: i64 = this.pos;
            let first: i64 = this.peek_code();
            if (first == 76 || first == 117 || first == 85) { this.pos = this.pos + 1; }
            this.pos = this.pos + 1;
            while (this.pos < this.source_len) {
                let c: i64 = string_char_code_at(this.source, this.pos);
                if (c == 39) { this.pos = this.pos + 1; break; }
                if (c == 92 && this.pos + 1 < this.source_len) { this.pos = this.pos + 2; } else { this.pos = this.pos + 1; }
            }
            return string_substring(this.source, start, this.pos - start);
        }


        fun read_string_literal_with_prefix(this) -> string {
            let start: i64 = this.pos;
            if (this.peek_code() == 117 && this.pos + 1 < this.source_len && string_char_code_at(this.source, this.pos + 1) == 56) {
                this.pos = this.pos + 2;
            } else {
                this.pos = this.pos + 1;
            }
            this.pos = this.pos + 1; // skip opening quote
            while (this.pos < this.source_len) {
                let c: i64 = string_char_code_at(this.source, this.pos);
                if (c == 34) { this.pos = this.pos + 1; break; }
                if (c == 92 && this.pos + 1 < this.source_len) { this.pos = this.pos + 2; } else { this.pos = this.pos + 1; }
            }
            return string_substring(this.source, start, this.pos - start);
        }

    }
}
