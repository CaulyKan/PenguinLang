class GlobalVariableDefinition {
    name: mut string = "";
    type_spec: mut Option<TypeSpecifier> = new Option<TypeSpecifier>.none();
    initializer: mut Option<Expression> = new Option<Expression>.none();
    is_mutable: mut bool = false;

    fun new(mut this, name: string) {

        this.name = name;
    }

    location: mut SourceLocation = new SourceLocation("", 0, 0);
    source_file: mut string = "";
    impl IDefinition {
        fun build_text(this: IDefinition) -> string {
            _utils.trace_enter("Enter build_text");
            let self = cast<GlobalVariableDefinition>(this);
            let s: mut string = "let ";
            if (self.is_mutable) { s = s + "mut "; }
            s = s + self.name;
            if (self.type_spec.is_some()) { s = s + ": " + self.type_spec.some.build_text(); }
            if (self.initializer.is_some()) { s = s + " = " + self.initializer.some.build_text(); }
            return s + ";";
        }
    }
}

class MetaParameter {
    name: mut string = "";
    kind: mut string = "";
    // M6-step2 4c: the declared STATIC type of an "object" param (e.g. List<i64>
    // in `(l: List<i64>)`) — the unit-B synthesis uses it as the real param type
    // (the kind alone, "object", is not a type name).
    param_type: mut Option<TypeSpecifier> = new Option<TypeSpecifier>.none();
    fun build_text(this) -> string {
        _utils.trace_enter("Enter build_text");
        if (string_length(this.kind) > 0) {
            return this.name + ": " + this.kind;
        }
        return this.name;
    }
}

class MetaFunctionDefinition {
    name: mut string = "";
    parameters: mut _utils.List<MetaParameter> = new _utils.List<MetaParameter>();
    return_type: mut Option<TypeSpecifier> = new Option<TypeSpecifier>.none();
    body: mut Option<Expression> = new Option<Expression>.none();
    location: mut SourceLocation = new SourceLocation("", 0, 0);
    source_file: mut string = "";

    fun new(mut this, name: string) {
        this.name = name;
    }

    impl IDefinition {
        fun build_text(this: IDefinition) -> string {
            _utils.trace_enter("Enter build_text");
            let self = cast<MetaFunctionDefinition>(this);
            let mut sb = new StringBuilder();
            sb.append("#fun ");
            sb.append(self.name);
            sb.append("(");
            let i: mut i64 = 0;
            while (i < cast<i64>(self.parameters.size())) {
                if (i > 0) { sb.append(", "); }
                sb.append(self.parameters.at(cast<u64>(i)).some.build_text());
                i = i + 1;
            }
            sb.append(")");
            if (self.return_type.is_some()) { sb.append(" -> "); sb.append(self.return_type.some.build_text()); }
            if (self.body.is_some()) { sb.append(" "); sb.append(self.body.some.build_text()); }
            else { sb.append(";"); }
            return sb.to_string();
        }
    }
}

class MetaIfDefinition {
    condition: mut Option<Expression> = new Option<Expression>.none();
    then_definitions: mut _utils.List<Definition> = new _utils.List<Definition>();
    elif_branches: mut _utils.List<MetaElifBranch> = new _utils.List<MetaElifBranch>();
    else_definitions: mut _utils.List<Definition> = new _utils.List<Definition>();
    location: mut SourceLocation = new SourceLocation("", 0, 0);
    source_file: mut string = "";
    impl IDefinition {
        fun build_text(this: IDefinition) -> string {
            _utils.trace_enter("Enter build_text");
            let self = cast<MetaIfDefinition>(this);
            let mut sb = new StringBuilder();
            sb.append("#if (");
            sb.append(self.condition.some.build_text());
            sb.append(") {");
            let i: mut i64 = 0;
            while (i < cast<i64>(self.then_definitions.size())) {
                sb.append(" ");
                sb.append(self.then_definitions.at(cast<u64>(i)).some.build_text());
                i = i + 1;
            }
            sb.append(" }");
            let i: mut i64 = 0;
            while (i < cast<i64>(self.elif_branches.size())) {
                sb.append(" ");
                sb.append(self.elif_branches.at(cast<u64>(i)).some.build_text());
                i = i + 1;
            }
            if (cast<i64>(self.else_definitions.size()) > 0) {
                sb.append(" #else {");
                let j: mut i64 = 0;
                while (j < cast<i64>(self.else_definitions.size())) {
                    sb.append(" ");
                    sb.append(self.else_definitions.at(cast<u64>(j)).some.build_text());
                    j = j + 1;
                }
                sb.append(" }");
            }
            return sb.to_string();
        }
    }
}

class MetaForDefinition {
    variable_name: mut string = "";
    variable_type: mut string = "";
    is_mutable: mut bool = false;
    iterable: mut Option<Expression> = new Option<Expression>.none();
