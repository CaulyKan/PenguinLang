        }
    }
}

// `#specializing Bar<T> { ... }` — a compile-time conditional interface impl.
// The block is compiled into a meta (#fun) callback that runs when `Bar<T>` is
// instantiated; every executed `impl` statement (Expression.specializing_impl)
// activates that interface implementation on the specialized class/enum. `body`
// is the block's statements (if/else expressions, impls, #error/#warn calls).
class SpecializingDefinition {
    target_type_spec: mut Option<TypeSpecifier> = new Option<TypeSpecifier>.none();
    body: mut _utils.List<Expression> = new _utils.List<Expression>();
    // The conditional impl blocks in SLOT order (nested or not); the callback's
    // `emperor.penguin_meta_activate_impl(<slot>)` maps to these 1:1.
    impl_fragments: mut _utils.List<InterfaceImplementation> = new _utils.List<InterfaceImplementation>();
    location: mut SourceLocation = new SourceLocation("", 0, 0);
    source_file: mut string = "";
    impl IDefinition {
        fun build_text(this: IDefinition) -> string {
            _utils.trace_enter("Enter build_text");
            let self = cast<SpecializingDefinition>(this);
            return "#specializing " + self.target_type_spec.some.build_text() + " { <specializing-body> }";
        }
    }
}

    enum Definition {
    function_def: FunctionDefinition;
    class_def: ClassDefinition;
    enum_def: EnumDefinition;
    namespace_def: NamespaceDefinition;
    using_def: UsingDefinition;
    initial_routine: InitialRoutineDefinition;
    interface_def: InterfaceDefinition;
    impl_def: InterfaceImplementation;
    impl_for_def: InterfaceForImplementation;
    event_def: EventDefinition;
    on_routine_def: OnRoutineDefinition;
    type_ref_def: TypeReferenceDefinition;
    enum_member: EnumMemberDefinition;
    class_field: ClassFieldDefinition;
    global_var: GlobalVariableDefinition;
    meta_function_def: MetaFunctionDefinition;
    meta_class_def: ClassDefinition;
    meta_if_def: MetaIfDefinition;
    meta_for_def: MetaForDefinition;
    meta_while_def: MetaWhileDefinition;
    meta_call_def: MetaCallDefinition;
    specializing_def: SpecializingDefinition;

    fun build_text(this) -> string {
        _utils.trace_enter("Enter build_text");
        if (this is Definition.function_def) { return this.function_def.build_text(); }
        if (this is Definition.class_def) { return this.class_def.build_text(); }
        if (this is Definition.enum_def) { return this.enum_def.build_text(); }
        if (this is Definition.namespace_def) { return this.namespace_def.build_text(); }
        if (this is Definition.using_def) { return this.using_def.build_text(); }
        if (this is Definition.initial_routine) { return this.initial_routine.build_text(); }
        if (this is Definition.interface_def) { return this.interface_def.build_text(); }
        if (this is Definition.impl_def) { return this.impl_def.build_text(); }
        if (this is Definition.impl_for_def) { return this.impl_for_def.build_text(); }
        if (this is Definition.event_def) { return this.event_def.build_text(); }
        if (this is Definition.on_routine_def) { return this.on_routine_def.build_text(); }
        if (this is Definition.type_ref_def) { return this.type_ref_def.build_text(); }
        if (this is Definition.enum_member) { return this.enum_member.build_text(); }
        if (this is Definition.class_field) { return this.class_field.build_text(); }
        if (this is Definition.global_var) { return this.global_var.build_text(); }
        if (this is Definition.meta_function_def) { return this.meta_function_def.build_text(); }
        if (this is Definition.meta_class_def) { return this.meta_class_def.build_text(); }
        if (this is Definition.meta_if_def) { return this.meta_if_def.build_text(); }
        if (this is Definition.meta_for_def) { return this.meta_for_def.build_text(); }
        if (this is Definition.meta_while_def) { return this.meta_while_def.build_text(); }
        if (this is Definition.meta_call_def) { return this.meta_call_def.build_text(); }
        if (this is Definition.specializing_def) { return this.specializing_def.build_text(); }
        return "";
    }
}

class CompilationUnit {
    definitions: mut _utils.List<Definition> = new _utils.List<Definition>();
    fun build_text(this) -> string {
        _utils.trace_enter("Enter build_text");
        let mut sb = new StringBuilder();
        let i: mut i64 = 0;
        while (i < cast<i64>(this.definitions.size())) {
            if (i > 0) { sb.append(" "); }
            sb.append(this.definitions.at(cast<u64>(i)).some.build_text());
            i = i + 1;
        }
        return sb.to_string();
    }
}
}
