            _utils.trace_enter("Enter build_text");
            let self = cast<MetaForDefinition>(this);
            let mut sb = new StringBuilder();
            sb.append("#for (let ");
            if (self.is_mutable) { sb.append("mut "); }
            sb.append(self.variable_name);
            if (string_length(self.variable_type) > 0) { sb.append(": "); sb.append(self.variable_type); }
            sb.append(" in ");
            sb.append(self.iterable.some.build_text());
            sb.append(") {");
            let i: mut i64 = 0;
            while (i < cast<i64>(self.body.size())) {
                sb.append(" ");
                sb.append(self.body.at(cast<u64>(i)).some.build_text());
                i = i + 1;
            }
            sb.append(" }");
            return sb.to_string();
        }
    }
}

