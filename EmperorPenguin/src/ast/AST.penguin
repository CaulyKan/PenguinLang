class MetaElifBranch {
    condition: mut Option<Expression> = new Option<Expression>.none();
    body_statement: mut Option<Statement> = new Option<Statement>.none();
    body_definitions: mut _utils.List<Definition> = new _utils.List<Definition>();
    fun build_text(this) -> string {
        _utils.trace_enter("Enter build_text");
        if (this.body_statement.is_some()) {
            return "#elif (" + this.condition.some.build_text() + ") " + this.body_statement.some.build_text();
        }
        let mut sb = new StringBuilder();
        sb.append("#elif (");
        sb.append(this.condition.some.build_text());
        sb.append(") {");
        let i: mut i64 = 0;
        while (i < cast<i64>(this.body_definitions.size())) {
            sb.append(" ");
            sb.append(this.body_definitions.at(cast<u64>(i)).some.build_text());
            i = i + 1;
        }
        sb.append(" }");
        return sb.to_string();
    }
}

class MetaIfStatement {
    condition: mut Option<Expression> = new Option<Expression>.none();
    then_statement: mut Option<Statement> = new Option<Statement>.none();
    elif_branches: mut _utils.List<MetaElifBranch> = new _utils.List<MetaElifBranch>();
    else_statement: mut Option<Statement> = new Option<Statement>.none();
    location: mut SourceLocation = new SourceLocation("", 0, 0);
    impl IStatement {
        fun build_text(this: IStatement) -> string {
            _utils.trace_enter("Enter build_text");
            let self = cast<MetaIfStatement>(this);
            let mut sb = new StringBuilder();
            sb.append("#if (");
            sb.append(self.condition.some.build_text());
            sb.append(") ");
            sb.append(self.then_statement.some.build_text());
            let i: mut i64 = 0;
            while (i < cast<i64>(self.elif_branches.size())) {
                sb.append(" ");
                sb.append(self.elif_branches.at(cast<u64>(i)).some.build_text());
                i = i + 1;
            }
            if (self.else_statement.is_some()) {
                sb.append(" #else ");
                sb.append(self.else_statement.some.build_text());
            }
            return sb.to_string();
        }
    }
}

