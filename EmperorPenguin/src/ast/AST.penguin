        this.for_type_name = for_type_name;
    }


    impl IDefinition {
        fun build_text(this: IDefinition) -> string {
            _utils.trace_enter("Enter build_text");
            let self = cast<InterfaceForImplementation>(this);
            let mut sb = new StringBuilder();
            sb.append("impl ");
            if (self.type_spec.is_some()) { sb.append(self.type_spec.some.build_text()); }
            else { sb.append(self.type_name); }
            sb.append(" for ");
            if (self.for_type_spec.is_some()) { sb.append(self.for_type_spec.some.build_text()); }
            else { sb.append(self.for_type_name); }
            if (cast<i64>(self.functions.size()) > 0) {
                sb.append(" {");
                let i: mut i64 = 0;
                while (i < cast<i64>(self.functions.size())) {
                    sb.append(" ");
                    sb.append(self.functions.at(cast<u64>(i)).some.build_text());
                    i = i + 1;
                }
                sb.append(" }");
            } else {
                sb.append(";");
            }
            return sb.to_string();
        }
    }
}

class EventDefinition {
    name: mut string = "";
    event_type: mut Option<TypeSpecifier> = new Option<TypeSpecifier>.none();
    location: mut SourceLocation = new SourceLocation("", 0, 0);
    source_file: mut string = "";

    fun new(mut this, name: string) {

        this.name = name;
    }


    impl IDefinition {
        fun build_text(this: IDefinition) -> string {
            _utils.trace_enter("Enter build_text");
            let self = cast<EventDefinition>(this);
            let s: mut string = "event " + self.name;
            if (self.event_type.is_some()) { s = s + ": " + self.event_type.some.build_text(); }
            return s + ";";
        }
    }
}

class NamespaceDefinition {
    name: mut string = "";
    children: mut _utils.List<Definition> = new _utils.List<Definition>();

    fun new(mut this, name: string) {

        this.name = name;
    }

    location: mut SourceLocation = new SourceLocation("", 0, 0);
    source_file: mut string = "";
    is_exported: bool = false;
    impl IDefinition {
        fun build_text(this: IDefinition) -> string {
            _utils.trace_enter("Enter build_text");
            let self = cast<NamespaceDefinition>(this);
            let s: mut string = "namespace " + self.name + "{";
            let i: mut i64 = 0;
            while (i < cast<i64>(self.children.size())) {
                s = s + " " + self.children.at(cast<u64>(i)).some.build_text();
                i = i + 1;
            }
            s = s + " }";
            return s;
        }
    }
}

// using <namespace-name> ';'
// A using-directive: pulls the named namespace's symbols into unqualified
// lookup for the enclosing file-namespace / namespace scope (see
// BoundScope.imported_namespaces). Binds to a placeholder bound def (the
// #class pattern) so the pass loops' unit.definitions[i] <->
// result.definitions[i] alignment is preserved.
class UsingDefinition {
    name: mut string = "";
    location: mut SourceLocation = new SourceLocation("", 0, 0);
    source_file: mut string = "";
    is_exported: bool = false;
    impl IDefinition {
        fun build_text(this: IDefinition) -> string {
            let self = cast<UsingDefinition>(this);
            return "using " + self.name + ";";
        }
    }
}

class InitialRoutineDefinition {
    body: mut Option<Expression> = new Option<Expression>.none();
    location: mut SourceLocation = new SourceLocation("", 0, 0);
    source_file: mut string = "";
    impl IDefinition {
        fun build_text(this: IDefinition) -> string {
            _utils.trace_enter("Enter build_text");
            let self = cast<InitialRoutineDefinition>(this);
            if (self.body.is_some()) { return "initial " + self.body.some.build_text(); }
            return "initial {}";
        }
    }
}

class OnRoutineDefinition {
    event_name: mut string = "";
    event_expr: mut Option<Expression> = new Option<Expression>.none();
    parameter: mut Option<Parameter> = new Option<Parameter>.none();
    body: mut Option<Expression> = new Option<Expression>.none();
    location: mut SourceLocation = new SourceLocation("", 0, 0);
    source_file: mut string = "";
    impl IDefinition {
        fun build_text(this: IDefinition) -> string {
            _utils.trace_enter("Enter build_text");
            let self = cast<OnRoutineDefinition>(this);
            let mut sb = new StringBuilder();
            sb.append("on ");
            if (self.event_expr.is_some()) { sb.append(self.event_expr.some.build_text()); }
            else { sb.append(self.event_name); }
            if (self.parameter.is_some()) { sb.append("("); sb.append(self.parameter.some.build_text()); sb.append(")"); }
            if (self.body.is_some()) { sb.append(" "); sb.append(self.body.some.build_text()); }
            return sb.to_string();
        }
    }
}

