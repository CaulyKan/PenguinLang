[Project]
# penguin-tools — the CLI utility belt (demangle / mangle / meta / format).
# A thin CLI shell over the compiler lib: the formatter (emperor.format_
# penguin_text), the mangle truth (emperor.demangle_name / mangle_name) and
# the libmeta reader (emperor.read_meta) all come from the prebuilt
# libemperorpenguin.penguin-lib via --lib — the only local sources are the
# four tool modules. argparse rides the lib's dep chain
# (libemperorpenguin.penguin-lib -> libemperorpenguin-std.penguin-lib), so the
# #arg/#pos_arg annotations resolve without listing argparse as a source.
# Build (see make tools):
#   build/linux/emperor_penguin_llvm_emitter EmperorPenguin/tools/PenguinTools.penguins \
#       --lib build/linux/libemperorpenguin.penguin-lib -o build/tools/penguin-tools
name="PenguinTools"
sources=["main.penguin", "mangle_tool.penguin", "libmeta_dump.penguin", "format_tool.penguin"]
