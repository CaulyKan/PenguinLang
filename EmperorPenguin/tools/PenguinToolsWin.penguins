[Project]
# Windows (win64 cross) build of penguin-tools: a MONOLITH of the tool
# modules + the whole EmperorPenguin compiler (the EmperorPenguinLib source
# set = EmperorPenguinFull minus main.penguin) — mirroring LspServerWin: the
# Linux build (PenguinTools.penguins) links the prebuilt shared library
# libemperorpenguin.penguin-lib instead, and that dyn-lib mechanism is
# ELF-specific. The entry point is the tools' own top-level initial
# (main.penguin) — no compiler main.penguin. argparse.penguin rides the
# monolith too (the #arg/#pos_arg #funs own the tools' annotated option
# fields — without it every annotated field is silently dropped). Same
# source-set rules as EmperorPenguinFull.penguins: native parser only
# (pass2+), never BabyPenguin.
name="PenguinToolsWin"
sources=["../../EmperorPenguin/src/ast/AST.penguin", "../../EmperorPenguin/src/ast/Lexer.penguin", "../../EmperorPenguin/src/ast/Parser.penguin", "../../EmperorPenguin/src/ast/SourceLocation.penguin", "../../EmperorPenguin/src/ast/Token.penguin", "../../EmperorPenguin/src/ast/Formatter.penguin", "../../EmperorPenguin/src/bound/BoundCompilationUnit.penguin", "../../EmperorPenguin/src/bound/BoundDefinition.penguin", "../../EmperorPenguin/src/bound/BoundExpression.penguin", "../../EmperorPenguin/src/bound/BoundScope.penguin", "../../EmperorPenguin/src/bound/BoundStatement.penguin", "../../EmperorPenguin/src/bound/BoundSymbol.penguin", "../../EmperorPenguin/src/bound/BoundTreePrinter.penguin", "../../EmperorPenguin/src/bound/BoundType.penguin", "../../EmperorPenguin/src/bound/BoundTypeRegistry.penguin", "../../EmperorPenguin/src/bound/Mangling.penguin", "../../EmperorPenguin/src/bound/EmperorPenguinCompiler.penguin", "../../EmperorPenguin/src/bound/SemanticModel.penguin", "../../EmperorPenguin/src/bound/SemanticShared.penguin", "../../EmperorPenguin/src/bound/SemanticMetaRewrite.penguin", "../../EmperorPenguin/src/bound/SemanticBuildScopes.penguin", "../../EmperorPenguin/src/bound/SemanticMonomorphize.penguin", "../../EmperorPenguin/src/bound/SemanticResolveTypes.penguin", "../../EmperorPenguin/src/bound/SemanticBindSymbols.penguin", "../../EmperorPenguin/src/bound/SemanticConstructors.penguin", "../../EmperorPenguin/src/bound/SemanticInterfaces.penguin", "../../EmperorPenguin/src/bound/SemanticClassifyValueTypes.penguin", "../../EmperorPenguin/src/bound/SemanticBindBodies.penguin", "../../EmperorPenguin/src/bound/SemanticBindExpressions.penguin", "../../EmperorPenguin/src/bound/SemanticBindMetaCalls.penguin", "../../EmperorPenguin/src/bound/SemanticValidateControlFlow.penguin", "../../EmperorPenguin/src/ir/IRBuilder.penguin", "../../EmperorPenguin/src/ir/IRFunction.penguin", "../../EmperorPenguin/src/ir/IRGenerator.penguin", "../../EmperorPenguin/src/ir/IRInstruction.p