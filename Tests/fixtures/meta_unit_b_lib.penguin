// A plain runtime function library for the --meta-src unit-B test
// (MetaUserSources.md): this file is BOTH a compilation source and a
// --meta-src entry, so its functions run at runtime AND inside a #fun.

fun trv_double(x: i64) -> i64 {
    return x * 2;
}

fun trv_tag(s: string) -> string {
    return "[" + s + "]";
}
