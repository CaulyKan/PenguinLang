// spawnx_b.penguin — cross-file spawn-site synthetic-name fixture B (batch
// 1.3 regression guard, Tests/AsyncTest/SpawnCtxCrossFileCounter.md).
// Same explicit namespace `spawnx` as spawnx_a.penguin (merged across
// files, shared bind scope for the synthesized spawn classes). This
// file's spawn captures NO args, so its ctx class has no a0 field — under
// per-file numbering both files mint `__SpawnCtx_1`/`__SpawnFut_1` in the
// shared namespace; whichever class loses the bind race silently replaces
// the other and the loser's future completes to the wrong value (the bug
// this test pins: r2 printed 0 instead of 7).
namespace spawnx {
    fun h0() -> i64 {
        return 7;
    }

    fun fb() {
        let f : mut __builtin.IFuture<i64> = async h0();
        let r : i64 = wait f;
        println("r2=" + cast<string>(r));
    }
}
