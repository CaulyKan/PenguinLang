{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) pass2",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/tmp/pass2",
            "args": [
                "-vv",
                "${workspaceFolder}/Examples/hello_llvm.penguin"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "将反汇编风格设置为 Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "text": "b _initial_"
                }
            ]
        },
        {
            "type": "antlr-debug",
            "request": "launch",
            "name": "antlr-hello_world",
            "input": "${workspaceFolder}/BabyPenguin/Builtin.penguin",
            "grammar": "${workspaceFolder}/PenguinLangParser/PenguinLang.g4",
            "startRule": "compilationUnit",
            "visualParseTree": true
        },
        {
            "name": "dotnet debug",
            "type": "coreclr",
            "request": "launch",
            "windows": {
                "preLaunchTask": "dotnet build win"
            },
            "linux": {
                "preLaunchTask": "dotnet build linux"
            },
            "program": "${workspaceFolder}/BabyPenguin/bin/Debug/net10.0/BabyPenguin.dll",
            "args": [
                "${workspaceFolder}/Examples/test.penguin",
                "-r",
                "report.txt"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "dotnet debug emperorpenguin",
            "type": "coreclr",
            "request": "launch",
            "windows": {
                "preLaunchTask": "dotnet build win"
            },
            "linux": {
                "preLaunchTask": "dotnet build linux"
            },
            "program": "${workspaceFolder}/BabyPenguin/bin/Debug/net10.0/BabyPenguin.dll",
            "args": [
                "${workspaceFolder}/EmperorPenguin/EmperorPenguin.penguins",
                "-r",
                "report.txt"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "launch dap",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/BabyPenguin/bin/Debug/net8.0/BabyPenguin.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Attach",
            "type": "coreclr",
            "request": "attach",
            "processName": "MagellanicPenguinDAP.exe"
            // "processId": "${command:pickProcess}"
        },
        {
            "name": "Extension",
            "type": "extensionHost",
            "request": "launch",
            "windows": {
                "preLaunchTask": "dotnet build win"
            },
            "linux": {
                "preLaunchTask": "dotnet build linux"
            },
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/MagellanicPenguin/vscode"
            ]
        },
        {
            "name": "PenguinLang Debug",
            "type": "penguinlang",
            "request": "launch",
            "program": "${workspaceFolder}/EmperorPenguin/EmperorPenguin.penguins"
        },
    ]
}