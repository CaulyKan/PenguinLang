namespace _utils {
    extern fun file_read_text(file: string) -> mut string;
    extern fun file_write_text(file: string, text: string);
    extern fun mkdir(path: string) -> bool;
    extern fun file_exists(path: string) -> bool;
    extern fun dir_exists(path: string) -> bool;
    extern fun dir_get_entries(path: string) -> string;

    // Binary-mode file I/O for dynamic-linking (.penguin-lib) support. Read paths
    // use "rb"/"ab" so Windows does not CRLF-mangle a .so/.dll tail or the JSON
    // metadata + PENGUINLIB footer appended to it. Metadata is ASCII, so the
    // NUL-terminated string contract holds.
    extern fun file_size(file: string) -> i64;
    extern fun file_read_range(file: string, offset: i64, size: i64) -> string;
    extern fun file_append(file: string, text: string);
    extern fun exe_path() -> string;

    // Environment variable lookup ("" when unset). Used to resolve the link
    // compiler ($CLANG) in-process — a `${CLANG:-clang}` shell expansion only
    // works under a POSIX system() shell, not cmd.exe on native Windows.
    extern fun getenv(name: string) -> string;

    // Create a fresh, process-unique temporary directory and return its path.
    // The directory is created atomically so it never conflicts with other
    // callers (including parallel compiler invocations). Cross-platform.
    extern fun create_temp_dir(prefix: string) -> string;

    // Returns a guaranteed-unique temporary directory path, already created.
    // Use this for build intermediates so parallel EmperorPenguin runs do not
    // collide on a shared fixed path like "build/".
    fun get_temp_folder() -> string {
        let dir: string = create_temp_dir("penguin");
        return dir;
    }

    let verbose_level: mut i64 = 0;
    fun trace_set_verbose(level: i64) {
        verbose_level = level;
    }

    fun trace_enter(str: string) {
        if (verbose_level >= 3) {
            __builtin.eprintln(str);
        }
    }

    fun args() -> _utils.List<string> {
        let count: i64 = __args_count();
        let result: mut _utils.List<string> = new _utils.List<string>();
        let i: mut i64 = 0;
        while (i < count) {
            result.push(__args_get(i));
            i = i + 1;
        }
        return result;
    }

    #template(T: type)
    class List {
        impl IReferenceType;
        __impl: __builtin.__ExternImpl = new __builtin.__ExternImpl();
        extern fun new(mut this);
        extern fun at(this, index: u64) -> __builtin.Option<T>;
        extern fun remove(mut this, index: u64);
        extern fun push(mut this, value: T);
        extern fun pop(mut this) -> __builtin.Option<T>;
        extern fun size(this) -> u64;
        extern fun set(mut this, index: u64, value: T);

        impl __builtin.IIterable<T> {
            fun iter(this: __builtin.IIterable<T>) -> __builtin.IIterator<T> {
                return cast<__builtin.IIterator<T>>(new _utils.ListIterator<T>(cast<_utils.List<T>>(this)));
            }
            fun iter_mut(this: __builtin.IIterable<T>) -> mut __builtin.IIterator<T> {
                return cast<mut __builtin.IIterator<T>>(new _utils.ListIterator<T>(cast<_utils.List<T>>(this)));
            }
        }
    }

    // String-keyed hash map (string -> i64) for the compiler's hot name
    // lookups (layout tables, per-function register/alloca sets, memoized
    // finders). Chained buckets over dense parallel arrays; the hash is
    // djb2 over string_char_code_at — ZERO allocation per probe (a
    // list_contains/linear-scan replacement: those pay one string content
    // compare per element, which dominated the emitter profile). Values
    // must be non-negative; get() returns -1 on miss.
    // (Mirror of EmperorPenguin/src/utils.penguin — keep both in sync.)
    class StrMap {
        impl __builtin.IReferenceType;
        heads: mut _utils.List<i64> = new _utils.List<i64>();
        next: mut _utils.List<i64> = new _utils.List<i64>();
        keys: mut _utils.List<string> = new _utils.List<string>();
        vals: mut _utils.List<i64> = new _utils.List<i64>();
        count: mut i64 = 0;

        fun new(mut this) {
            let i: mut i64 = 0;
            while (i < 256) {
                this.heads.push(-1);
                i = i + 1;
            }
        }

        fun hash(this, key: string) -> i64 {
            let h: mut i64 = 5381;
            let n: i64 = string_length(key);
            let i: mut i64 = 0;
            while (i < n) {
                h = __builtin.lshift(h, 5) + h + string_char_code_at(key, i);
                i = i + 1;
            }
            // Fold high bits in so long names do not collide on the low
            // bucket bits only.
            return (h ^ __builtin.rshift(h, 33)) & 1073741823;
        }

        fun get(this, key: string) -> i64 {
            let b: i64 = this.hash(key) & 255;
            let i: mut i64 = this.heads.at(cast<u64>(b)).some;
            while (i >= 0) {
                if (this.keys.at(cast<u64>(i)).some == key) {
                    return this.vals.at(cast<u64>(i)).some;
                }
                i = this.next.at(cast<u64>(i)).some;
            }
            return -1;
        }

        // NOTE: `this` (not `mut this`) — see EmperorPenguin/src/utils.penguin.
        fun set(this, key: string, val: i64) {
            let b: i64 = this.hash(key) & 255;
            let i: mut i64 = this.heads.at(cast<u64>(b)).some;
            while (i >= 0) {
                if (this.keys.at(cast<u64>(i)).some == key) {
                    this.vals.set(cast<u64>(i), val);
                    return;
                }
                i = this.next.at(cast<u64>(i)).some;
            }
            this.keys.push(key);
            this.vals.push(val);
            this.next.push(this.heads.at(cast<u64>(b)).some);
            this.heads.set(cast<u64>(b), this.count);
            this.count = this.count + 1;
        }
    }

    #template(T: type)
    class ListIterator {
        list: !mut _utils.List<T>;
        current: mut u64;

        fun new(mut this, list: !mut _utils.List<T>) {
            this.list = list;
            this.current = 0;
        }

        impl __builtin.IIterator<T> {
            fun next(this: mut __builtin.IIterator<T>) -> __builtin.Option<T> {
                let self: mut _utils.ListIterator<T> = cast<mut _utils.ListIterator<T>>(this);
                let res: __builtin.Option<T> = self.list.at(self.current);
                self.current += 1;
                return res;
            }
        }
    }

    #template(T: type)
    class Queue {
        __impl: __builtin.__ExternImpl = new __builtin.__ExternImpl();
        extern fun new(mut this);
        extern fun enqueue(mut this, value: T);
        extern fun dequeue(mut this) -> __builtin.Option<T>;
        extern fun peek(this) -> __builtin.Option<T>;
        extern fun size(this) -> u64;
    }

    fun exec(exe: string, args: List<string>) -> i64 {
        let cmd: mut string = exe;
        let i: mut i64 = 0;
        while (i < cast<i64>(args.size())) {
            let arg: string = args.at(cast<u64>(i)).some;
            cmd = cmd + " " + arg;
            i = i + 1;
        }
        return __builtin._exec_cmd(cmd);
    }
}
