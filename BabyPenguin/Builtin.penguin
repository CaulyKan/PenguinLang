    enum RoutineState {
        pending;
        running;
        ready;
        finished;
        ready_finished;

        fun from_i64(v: i64) -> mut RoutineState {
            if (v == 0) {
                return new RoutineState.pending();
            } else if (v == 1) {
                return new RoutineState.running();
            } else if (v == 2) {
                return new RoutineState.ready();
            } else if (v == 3) {
                return new RoutineState.finished();
            } else {
                return new RoutineState.ready_finished();
            }
        }

        fun from_atomic(a: AtomicI64) -> mut RoutineState {
            let v : mut i64 = a.load();
            return RoutineState.from_i64(v);
        }

        fun to_i64(this) -> i64 {
            if (this is RoutineState.pending) {
                return 0;
            } else if (this is RoutineState.running) {
                return 1;
            } else if (this is RoutineState.ready) {
                return 2;
            } else if (this is RoutineState.finished) {
                return 3;
            } else {
                return 4;
            }
        }

        fun switch(v: mut AtomicI64, from: RoutineState, to: RoutineState) -> bool {
            let from_i64 : mut i64 = from.to_i64();
            let to_i64 : mut i64 = to.to_i64();
            let res : mut i64 = v.compare_exchange(from_i64, to_i64);
            return res == from_i64;
        }
    }

    let __object_id : mut AtomicI64 = new AtomicI64(0);
    interface IObjectID {
        // Object identity is inherently a reference concept. IEventReceiver extends this
        // interface and is stored in List<IEventReceiver<T>> (Event.receivers), so the root
        // must be reference-typed to make IEventReceiver a sized reference interface.
        impl IReferenceType;
        object_id : mut i64 = __object_id.fetch_add(1);
        fun equals(this, other: IObjectID) -> bool {
            return this.object_id == other.object_id;
        }
    }

    #template(T: type)
    enum FutureState {
        not_ready;
        ready: T;
        finished;
        ready_finished: T;
    }

    interface IFutureBase {
        // Futures are scheduled across the main scheduler and stored in Queue<IFutureBase>
        // (Scheduler.pending_jobs), so they must be reference-typed (sized pointer).
        impl IReferenceType;
        fun routine_state(this) -> RoutineState;
        fun switch_state(mut this, from: RoutineState, to: RoutineState) -> bool;
        fun start(mut this) -> bool;
    }

    #template(T: type)
    interface IFuture {
        impl IFutureBase;
        fun poll(this) -> mut FutureState<T>;
        
        !async fun do_wait(mut this) -> T {
            let result: mut T;
            while(true) {
                wait;
                let state: mut FutureState<T> = this.poll();
                if (state is FutureState<T>.ready_finished) {
                    __builtin._sim_activity();
                    result = state.ready_finished;
                    break;
                }
                else if (state is FutureState<T>.ready) {
                    __builtin._sim_activity();
                    result = state.ready;
                    this.switch_state(new RoutineState.ready(), new RoutineState.pending());
                    _main_scheduler.pending_jobs.enqueue(this);
                } else if (state is FutureState<T>.finished) {
                    break;
                }
            }
            return result;
        }

        !async fun do_wait_any(this: mut IFuture<T>) -> Option<T> {
            while(true) {
                wait;
                let state: mut FutureState<T> = this.poll();
                if (state is FutureState<T>.ready_finished) {
                    __builtin._sim_activity();
                    this.switch_state(new RoutineState.ready_finished(), new RoutineState.finished());
                    return new Option<T>.some(state.ready_finished);
                }
                else if (state is FutureState<T>.ready) {
                    __builtin._sim_activity();
                    this.switch_state(new RoutineState.ready(), new RoutineState.pending());
                    _main_scheduler.pending_jobs.enqueue(this);
                    return new Option<T>.some(state.ready);
                } else if (state is FutureState<T>.finished) {
                    break;
                }
            }
            return new Option<T>.none();
        }
    }

    class Scheduler {
        pending_jobs : mut _utils.Queue<IFutureBase> = new _utils.Queue<IFutureBase>();

        fun entry(mut this) {
            while (true) {
                let job_opt : Option<IFutureBase> = this.pending_jobs.dequeue();
                if (job_opt.is_some()) {
                    let job : mut IFutureBase = job_opt.some;
                    let result: bool = job.start();
                    let state : RoutineState = job.routine_state();
                    if (!result) {
                        // job is in invalid state, skip it for now
                        println("Scheduler: job in '" + cast<string>(state) + "' state, failed to run");
                    }
                    else {
                        if (state is RoutineState.pending) {
                            this.pending_jobs.enqueue(job);
                        }
                    }
                } else {
                    break;
                }
            }
        }

        fun current() -> Scheduler {
            return _main_scheduler;
        }
    }

    let _main_scheduler : mut Scheduler = new Scheduler();

    #template(T: type)
    interface IGenerator {
        impl IIterator<T>;
    }

    #template(T: type)
    class RoutineContext {
        __impl: __ExternImpl = new __ExternImpl();
        result: mut Option<T> = new Option<T>.none();
        target: mut async_fun<T>;

        fun new(mut this, target: mut async_fun<T>) {
            this.target = target;
        }
        extern fun call(mut this) -> i64;
    }

    #template(T: type)
    class _DefaultRoutine {
        state: mut AtomicI64 = new AtomicI64(0);
        context: mut RoutineContext<T>;

        fun new(mut this, target: async_fun<T>, scheduleNow: bool) {
            this.context = new RoutineContext<T>(target);
            if (scheduleNow) {
                _main_scheduler.pending_jobs.enqueue(cast<IFutureBase>(this));
            }
        }

        impl IFutureBase {
            fun routine_state(this: IFutureBase) -> RoutineState {
                let self: Self = cast<Self>(this);
                return RoutineState.from_atomic(self.state);
            }

            fun switch_state(this: mut IFutureBase, from: RoutineState, to: RoutineState) -> bool {
                let self: mut Self = cast<mut Self>(this);
                return RoutineState.switch(self.state, from, to);
            }

            fun start(this: mut IFutureBase) -> bool {
                let self: mut Self = cast<mut Self>(this);
                let res : bool = RoutineState.switch(self.state, new RoutineState.pending(), new RoutineState.running());
                if (!res) 
                    return false;
                let return_state : i64 = self.context.call();

                // Blocked = 0, YieldNotFinished = 2, Finished = 3, YieldFinished = 4
                RoutineState.switch(self.state, new RoutineState.running(), RoutineState.from_i64(return_state));

                return true;
            }
        }

        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                let self: Self = cast<Self>(this);
                let state_val: i64 = self.state.load();
                
                if (state_val == 2) {
                    return new FutureState<T>.ready(self.context.result.some);
                } else if (state_val == 3) {
                    return new FutureState<T>.finished();
                } else if (state_val == 4) {
                    return new FutureState<T>.ready_finished(self.context.result.some);
                } else {
                    return new FutureState<T>.not_ready();
                }
            }
        }
    
        impl IGenerator<T>;
        impl IIterator<T> {
            fun next(this: mut IIterator<T>) -> Option<T> {
                let self: mut Self = cast<mut Self>(this);
                return self.do_wait_any();
            }
        }
    }

    // ============ Event (anonymous broadcast) ============
    //
    // First-class broadcast hub replacing the old event/emit/on keywords.
    // An event is an ordinary value: store it in a global, a class field or
    // a local, pass it to free functions, emit from anywhere. Any number of
    // waiters may park on one event and every emit reaches ALL of them —
    // each `wait ev` parks on its own one-slot subscription created by the
    // compiler's wait-rewrite. Values emitted while nobody is waiting are
    // lost (broadcast, not queueing — use Fifo for store-and-forward), and
    // two emits before a waiter re-parks collapse to the last value, like a
    // wire.
    #template(T: type)
    class Event {
        impl IObjectID;

        subscribers : mut _utils.List<_EventSubscription<T>> = new _utils.List<_EventSubscription<T>>();
        // Wires granted to connected input ports (connect(ev, f.x)): unlike
        // a parked wait's one-shot subscription, a wire stays registered and
        // its own delivery cursor governs when the consumer sees a value.
        wires : mut _utils.List<LatestChannel<T>> = new _utils.List<LatestChannel<T>>();

        fun emit(mut this, v: T) {
            __builtin._sim_activity();
            for (let s : mut _EventSubscription<T> in this.subscribers.iter()) {
                s.deliver(v);
            }
            for (let w : mut LatestChannel<T> in this.wires.iter()) {
                w.write(v);
            }
            wait;
        }

        fun subscribe(mut this, s: _EventSubscription<T>) {
            this.subscribers.push(s);
        }

        // The connect desugaring calls this: one fresh wire per connected
        // input (fan-out with independent cursors, like an output hub).
        fun connect_wire(mut this) -> mut LatestChannel<T> {
            let w : mut LatestChannel<T> = new LatestChannel<T>();
            this.wires.push(w);
            return w;
        }

        fun unsubscribe(mut this, s: _EventSubscription<T>) {
            for (let i : u64 in range(0, this.subscribers.size())) {
                let cur : Option<_EventSubscription<T>> = this.subscribers.at(i);
                if (cur.is_some()) {
                    if (cur.some.equals(s)) {
                        this.subscribers.remove(i);
                        return;
                    }
                }
            }
        }
    }

    // One parked waiter's mailbox: exactly one value slot. The wait-rewrite
    // creates a fresh subscription per `wait ev`; poll consumes the slot and
    // deregisters the subscription, so wait loops do not accumulate dead
    // subscriptions.
    #template(T: type)
    class _EventSubscription {
        impl IObjectID;

        ev : mut Event<T>;
        value : mut Option<T> = new Option<T>.none();

        fun new(mut this, ev: mut Event<T>) {
            this.ev = ev;
            ev.subscribe(this);
        }

        fun deliver(mut this, v: T) {
            this.value = new Option<T>.some(v);
        }

        impl IFutureBase {
            fun routine_state(this: IFutureBase) -> RoutineState {
                return new RoutineState.ready();
            }

            fun switch_state(this: mut IFutureBase, from: RoutineState, to: RoutineState) -> bool {
                return true;
            }

            fun start(this: mut IFutureBase) -> bool {
                return true;
            }
        }

        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                let self : mut Self = cast<mut Self>(this);
                if (self.value.is_some()) {
                    let v : T = self.value.some;
                    self.value = new Option<T>.none();
                    self.ev.unsubscribe(self);
                    return new FutureState<T>.ready_finished(v);
                }
                return new FutureState<T>.not_ready();
            }
        }
    }

    class _TimerWait {
        finished : mut bool = false;
        result_tick : mut i64 = 0;

        impl IFutureBase {
            fun routine_state(this: IFutureBase) -> RoutineState {
                return new RoutineState.ready();
            }

            fun switch_state(this: mut IFutureBase, from: RoutineState, to: RoutineState) -> bool {
                return true;
            }

            fun start(this: mut IFutureBase) -> bool {
                return true;
            }
        }

        impl IFuture<i64> {
            fun poll(this: IFuture<i64>) -> mut FutureState<i64> {
                let self: Self = cast<Self>(this);
                let now : i64 = __builtin._sim_now();
                if (now >= self.result_tick) {
                    self.finished = true;
                    return new FutureState<i64>.ready_finished(self.result_tick);
                }
                return new FutureState<i64>.not_ready();
            }
        }
    }

    extern fun _after(n: i64) -> IFuture<i64>;
    extern fun _sim_now() -> i64;
    extern fun _run();

    // ============ Channels (RTL-style communication) ============
    //
    // A channel is a first-class object that is both a source and a sink of
    // transactions. `wait <channel>` consumes one transaction (the channel
    // implements IFuture); `current()` reads the latest delivered slot without
    // consuming; `write(v)` delivers a transaction and may suspend on a full
    // backpressuring channel. Every write is a transaction — writing the same
    // value twice still delivers twice (no value dedup, unlike Verilog).
    //
    // close(ch) is supervision shutdown: after close, every pending and future
    // waiter is woken with a runtime error ("channel closed"), and writes onto
    // a closed channel raise as well — so closing a top-level channel tears
    // down every module still waiting on it (their try/catch decides whether
    // that is an orderly shutdown).

    extern fun _sim_activity();
    // Monotonic scheduler round counter (one delta round per increment) —
    // wires merge same-round writes into the final value.
    extern fun _sim_delta() -> i64;
    // True when the previous completed round carried no transaction activity
    // and none has happened in the current round so far: propagation at the
    // current simulation time has settled.
    extern fun _sim_settled() -> bool;

    enum FifoPolicy {
        backpressure;
        drop;

        fun is_backpressure(this) -> bool {
            return this is FifoPolicy.backpressure;
        }

        fun is_drop(this) -> bool {
            return this is FifoPolicy.drop;
        }
    }

    #template(T: type)
    interface ISource {
        impl IReferenceType;
        // Non-blocking probe: take one pending transaction, or none.
        fun try_poll(mut this) -> Option<T>;
        // Latest delivered slot, without consuming (none when never written).
        fun current(this) -> Option<T>;
    }

    #template(T: type)
    interface ISink {
        impl IReferenceType;
        // Deliver a transaction. On a full backpressuring channel this
        // suspends until a slot frees up (Go-channel semantics).
        fun write(mut this, v: T);
        // Non-blocking escape hatch: false when the channel was full.
        fun try_write(mut this, v: T) -> bool;
    }

    #template(T: type)
    interface IChannel {
        impl ISource<T>;
        impl ISink<T>;
        // A channel is directly waitable: `wait ch` consumes the next
        // transaction (virtual dispatch to the concrete channel's poll).
        impl IFuture<T>;
        fun close(mut this);
        fun is_closed(this) -> bool;
    }

    fun _channel_closed_error() {
        __builtin.__throw_runtime_error("channel closed", 100);
    }

    #template(T: type)
    class Fifo {
        impl IReferenceType;

        queue : mut _utils.Queue<T> = new _utils.Queue<T>();
        capacity : i64 = 0;
        policy : FifoPolicy = new FifoPolicy.backpressure();
        closed : mut bool = false;
        latest : mut Option<T> = new Option<T>.none();

        fun new(mut this, capacity: i64, policy: mut FifoPolicy) {
            this.capacity = capacity;
            this.policy = policy;
        }

        fun check_closed(mut this) {
            if (this.closed) {
                _channel_closed_error();
            }
        }

        fun is_full(this) -> bool {
            return cast<i64>(this.queue.size()) >= this.capacity;
        }

        fun deliver(mut this, v: T) {
            __builtin._sim_activity();
            this.queue.enqueue(v);
            this.latest = new Option<T>.some(v);
        }

        impl ISink<T> {
            fun write(this: mut ISink<T>, v: T) {
                let self : mut Self = cast<mut Self>(this);
                self.check_closed();
                if (self.policy.is_drop()) {
                    // Drop policy: a full channel silently discards the new value.
                    if (!self.is_full()) {
                        self.deliver(v);
                    }
                    return;
                }
                // Backpressure: park (bare wait = one delta) until a slot frees
                // up; the poll-wakeup below re-checks close in every round.
                while (self.is_full()) {
                    wait;
                    self.check_closed();
                }
                self.deliver(v);
            }

            fun try_write(this: mut ISink<T>, v: T) -> bool {
                let self : mut Self = cast<mut Self>(this);
                self.check_closed();
                if (self.is_full()) {
                    return false;
                }
                self.deliver(v);
                return true;
            }
        }

        impl ISource<T> {
            fun try_poll(this: mut ISource<T>) -> Option<T> {
                let self : mut Self = cast<mut Self>(this);
                self.check_closed();
                return self.queue.dequeue();
            }

            fun current(this: ISource<T>) -> Option<T> {
                let self : Self = cast<Self>(this);
                return self.latest;
            }
        }

        impl IChannel<T> {
            fun close(this: mut IChannel<T>) {
                let self : mut Self = cast<mut Self>(this);
                self.closed = true;
            }

            fun is_closed(this: IChannel<T>) -> bool {
                let self : Self = cast<Self>(this);
                return self.closed;
            }
        }

        impl IFutureBase {
            fun routine_state(this: IFutureBase) -> RoutineState {
                return new RoutineState.ready();
            }

            fun switch_state(this: mut IFutureBase, from: RoutineState, to: RoutineState) -> bool {
                return true;
            }

            fun start(this: mut IFutureBase) -> bool {
                return true;
            }
        }

        // `wait fifo` — the next transaction, delivered in FIFO order.
        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                let self : mut Self = cast<mut Self>(this);
                self.check_closed();
                let v : Option<T> = self.queue.dequeue();
                if (v.is_some()) {
                    return new FutureState<T>.ready_finished(v.some);
                }
                return new FutureState<T>.not_ready();
            }
        }
    }

    // Wire / diagnostic channel: transaction-stream semantics with an
    // independent delivery cursor. Every write is a transaction; writes in
    // the SAME delta round collapse to the final value (a wire settles to
    // one value per delta — "downstream not yet woken between two writes"),
    // while writes in different rounds are each delivered, in order, to
    // every consumer whenever it polls — a late consumer never loses
    // transactions. A connect-time seed value (port default / net's current
    // value) is delivered at most once and only while no real write has ever
    // happened: any write supersedes it. `current()` reads the latest
    // delivered value (or the seed) without consuming.
    #template(T: type)
    class LatestChannel {
        impl IReferenceType;

        // Committed transactions from earlier rounds (consumed entries
        // dequeue off the front).
        committed : mut _utils.Queue<T> = new _utils.Queue<T>();
        // The current round's write; same-round writes replace it while it
        // is still unconsumed. Flushed to `committed` when a later round
        // writes (FIFO order across rounds).
        pending : mut Option<T> = new Option<T>.none();
        pending_round : mut i64 = -1;
        ever_written : mut bool = false;
        last_value : mut Option<T> = new Option<T>.none();
        // Connect-time initial value: weak one-shot delivery, superseded by
        // any real transaction. Only wires granted by subscribe() /
        // connect_wire mark the seed deliverable (Q3: time-0 first-wait
        // wake-up); an output hub's own slot seed serves current() bare
        // reads and wire seeding only — `wait port` parks until a real
        // write.
        seed : mut Option<T> = new Option<T>.none();
        seed_taken : mut bool = false;
        seed_deliver : mut bool = false;
        closed : mut bool = false;

        fun new(mut this) {}

        fun set_seed(mut this, v: T, deliver: bool) {
            this.seed = new Option<T>.some(v);
            this.seed_deliver = deliver;
        }

        // Whether current() reflects a REAL transaction or a DECLARED
        // deliverable seed (variable nets, `output p = v`) — as opposed to a
        // synthesized type-zero seed that only backs bare reads. subscribe()
        // consults this to decide whether a newly granted wire should wake
        // its subscriber at time 0: a module that has not written anything
        // must not deliver its payload zero as a transaction.
        fun has_live_value(this) -> bool {
            return this.ever_written || this.seed_deliver;
        }

        fun check_closed(mut this) {
            if (this.closed) {
                _channel_closed_error();
            }
        }

        fun push(mut this, v: T) {
            let d : i64 = __builtin._sim_delta();
            if (this.pending.is_some() && this.pending_round == d) {
                // Same delta round, previous write not yet consumed: the
                // wire settles to the final value.
                this.pending = new Option<T>.some(v);
            } else {
                if (this.pending.is_some()) {
                    this.committed.enqueue(this.pending.some);
                }
                this.pending = new Option<T>.some(v);
                this.pending_round = d;
            }
            this.ever_written = true;
            this.last_value = new Option<T>.some(v);
        }

        // Advance the cursor: oldest undelivered transaction, else the
        // one-shot seed (only before any real write), else none.
        fun take(mut this) -> Option<T> {
            let head : Option<T> = this.committed.dequeue();
            if (head.is_some()) {
                return head;
            }
            if (this.pending.is_some()) {
                let v : Option<T> = this.pending;
                this.pending = new Option<T>.none();
                return v;
            }
            if (!this.ever_written && this.seed.is_some() && !this.seed_taken && this.seed_deliver) {
                this.seed_taken = true;
                return this.seed;
            }
            return new Option<T>.none();
        }

        impl ISink<T> {
            fun write(this: mut ISink<T>, v: T) {
                let self : mut Self = cast<mut Self>(this);
                self.check_closed();
                __builtin._sim_activity();
                self.push(v);
            }

            fun try_write(this: mut ISink<T>, v: T) -> bool {
                let self : mut Self = cast<mut Self>(this);
                self.check_closed();
                __builtin._sim_activity();
                self.push(v);
                return true;
            }
        }

        impl ISource<T> {
            fun try_poll(this: mut ISource<T>) -> Option<T> {
                let self : mut Self = cast<mut Self>(this);
                self.check_closed();
                return self.take();
            }

            fun current(this: ISource<T>) -> Option<T> {
                let self : Self = cast<Self>(this);
                if (self.last_value.is_some()) {
                    return self.last_value;
                }
                return self.seed;
            }
        }

        impl IChannel<T> {
            fun close(this: mut IChannel<T>) {
                let self : mut Self = cast<mut Self>(this);
                self.closed = true;
            }

            fun is_closed(this: IChannel<T>) -> bool {
                let self : Self = cast<Self>(this);
                return self.closed;
            }
        }

        impl IFutureBase {
            fun routine_state(this: IFutureBase) -> RoutineState {
                return new RoutineState.ready();
            }

            fun switch_state(this: mut IFutureBase, from: RoutineState, to: RoutineState) -> bool {
                return true;
            }

            fun start(this: mut IFutureBase) -> bool {
                return true;
            }
        }

        // v1 waiters share this channel's single cursor (competing
        // consumers, like any standalone channel). Broadcast fan-out with
        // per-consumer cursors is what an output port's subscribe() wires
        // and Event.connect_wire() grant.
        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                let self : mut Self = cast<mut Self>(this);
                self.check_closed();
                let v : Option<T> = self.take();
                if (v.is_some()) {
                    return new FutureState<T>.ready_finished(v.some);
                }
                return new FutureState<T>.not_ready();
            }
        }
    }

    // Two-source merge (fan-in): transactions arrive in arrival order across
    // both sources. Source-only in v1 (writes go to the channels it merges).
    #template(T: type)
    class MergeChannel {
        impl IReferenceType;

        a : mut ISource<T>;
        b : mut ISource<T>;
        closed : mut bool = false;

        fun new(mut this, a: mut ISource<T>, b: mut ISource<T>) {
            this.a = a;
            this.b = b;
        }

        fun check_closed(mut this) {
            if (this.closed) {
                _channel_closed_error();
            }
        }

        fun poll_once(mut this) -> Option<T> {
            let va : Option<T> = this.a.try_poll();
            if (va.is_some()) {
                return va;
            }
            return this.b.try_poll();
        }

        impl ISource<T> {
            fun try_poll(this: mut ISource<T>) -> Option<T> {
                let self : mut Self = cast<mut Self>(this);
                self.check_closed();
                return self.poll_once();
            }

            fun current(this: ISource<T>) -> Option<T> {
                let self : Self = cast<Self>(this);
                return self.a.current();
            }
        }

        impl IChannel<T> {
            fun close(this: mut IChannel<T>) {
                let self : mut Self = cast<mut Self>(this);
                self.closed = true;
            }

            fun is_closed(this: IChannel<T>) -> bool {
                let self : Self = cast<Self>(this);
                return self.closed;
            }
        }

        impl IFutureBase {
            fun routine_state(this: IFutureBase) -> RoutineState {
                return new RoutineState.ready();
            }

            fun switch_state(this: mut IFutureBase, from: RoutineState, to: RoutineState) -> bool {
                return true;
            }

            fun start(this: mut IFutureBase) -> bool {
                return true;
            }
        }

        // `wait merge` — merge` — the next transaction across either source.
        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                let self : mut Self = cast<mut Self>(this);
                self.check_closed();
                let v : Option<T> = self.poll_once();
                if (v.is_some()) {
                    return new FutureState<T>.ready_finished(v.some);
                }
                return new FutureState<T>.not_ready();
            }
        }
    }

    // Permanently idle source: the placeholder behind an unconnected input
    // port without a default. Polls never deliver (wait parks — the routine
    // contributes identical rounds and ends at quiescence, per the "unbound
    // input wait blocks, it does not crash" rule), current() is none, and
    // writes are rejected.
    #template(T: type)
    class _NeverSource {
        impl IReferenceType;

        fun new(mut this) {}

        impl ISink<T> {
            fun write(this: mut ISink<T>, v: T) {
                _channel_closed_error();
            }

            fun try_write(this: mut ISink<T>, v: T) -> bool {
                _channel_closed_error();
                return false;
            }
        }

        impl ISource<T> {
            fun try_poll(this: mut ISource<T>) -> Option<T> {
                return new Option<T>.none();
            }

            fun current(this: ISource<T>) -> Option<T> {
                return new Option<T>.none();
            }
        }

        impl IChannel<T> {
            fun close(this: mut IChannel<T>) {
            }

            fun is_closed(this: IChannel<T>) -> bool {
                return false;
            }
        }

        impl IFutureBase {
            fun routine_state(this: IFutureBase) -> RoutineState {
                return new RoutineState.ready();
            }

            fun switch_state(this: mut IFutureBase, from: RoutineState, to: RoutineState) -> bool {
                return true;
            }

            fun start(this: mut IFutureBase) -> bool {
                return true;
            }
        }

        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                return new FutureState<T>.not_ready();
            }
        }
    }

    // Late-binding relay: the object behind a passed-through input port
    // (connect(this.x, inner.x)). The class construct wires inner.x to this
    // view BEFORE the enclosing instance's own input is connected from the
    // outside; every poll/current/close re-reads the upstream FIELD, so the
    // real source is picked up whenever the outer connect binds it.
    #template(T: type)
    class _LateSource {
        impl IReferenceType;

        upstream : mut IChannel<T> = new _NeverSource<T>();

        // The outer connect calls this with the real source (wire/channel).
        fun bind(mut this, src: mut IChannel<T>) {
            this.upstream = src;
        }

        impl ISink<T> {
            fun write(this: mut ISink<T>, v: T) {
                _channel_closed_error();
            }

            fun try_write(this: mut ISink<T>, v: T) -> bool {
                _channel_closed_error();
                return false;
            }
        }

        impl ISource<T> {
            fun try_poll(this: mut ISource<T>) -> Option<T> {
                let self : mut Self = cast<mut Self>(this);
                return self.upstream.try_poll();
            }

            fun current(this: ISource<T>) -> Option<T> {
                let self : Self = cast<Self>(this);
                return self.upstream.current();
            }
        }

        impl IChannel<T> {
            fun close(this: mut IChannel<T>) {
                let self : mut Self = cast<mut Self>(this);
                self.upstream.close();
            }

            fun is_closed(this: IChannel<T>) -> bool {
                let self : Self = cast<Self>(this);
                return self.upstream.is_closed();
            }
        }

        impl IFutureBase {
            fun routine_state(this: IFutureBase) -> RoutineState {
                return new RoutineState.ready();
            }

            fun switch_state(this: mut IFutureBase, from: RoutineState, to: RoutineState) -> bool {
                return true;
            }

            fun start(this: mut IFutureBase) -> bool {
                return true;
            }
        }

        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                let self : mut Self = cast<mut Self>(this);
                return self.upstream.poll();
            }
        }
    }

    // Constant payload source: an input port's default when left unconnected.
    // current() always yields the constant; it never delivers a transaction
    // (wait parks forever — the port is unconnected) and writes are invalid.
    #template(T: type)
    class ConstantSource {
        impl IReferenceType;

        value : T;
        closed : mut bool = false;

        fun new(mut this, value: T) {
            this.value = value;
        }

        fun check_closed(mut this) {
            if (this.closed) {
                _channel_closed_error();
            }
        }

        impl ISink<T> {
            fun write(this: mut ISink<T>, v: T) {
                _channel_closed_error();
            }

            fun try_write(this: mut ISink<T>, v: T) -> bool {
                _channel_closed_error();
                return false;
            }
        }

        impl ISource<T> {
            fun try_poll(this: mut ISource<T>) -> Option<T> {
                return new Option<T>.none();
            }

            fun current(this: ISource<T>) -> Option<T> {
                let self : Self = cast<Self>(this);
                return new Option<T>.some(self.value);
            }
        }

        impl IChannel<T> {
            fun close(this: mut IChannel<T>) {
                let self : mut Self = cast<mut Self>(this);
                self.closed = true;
            }

            fun is_closed(this: IChannel<T>) -> bool {
                let self : Self = cast<Self>(this);
                return self.closed;
            }
        }

        impl IFutureBase {
            fun routine_state(this: IFutureBase) -> RoutineState {
                return new RoutineState.ready();
            }

            fun switch_state(this: mut IFutureBase, from: RoutineState, to: RoutineState) -> bool {
                return true;
            }

            fun start(this: mut IFutureBase) -> bool {
                return true;
            }
        }

        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                return new FutureState<T>.not_ready();
            }
        }
    }

    // Output-port fanout hub: the module's single driver writes here; every
    // connected input gets its OWN wire via subscribe() (independent delivery
    // cursors — each subscriber receives every transaction in order), while
    // the hub's own slot stream serves direct `wait out_port` /
    // `out_port.try_poll()` readers at the wiring level (one shared cursor,
    // competing consumers). The declared default / type zero value lives in
    // the slot as a weak seed: bare reads before any write return it, and
    // subscribe() seeds new wires from it (time-0 first-wait wake-up).
    #template(T: type)
    class _Fanout {
        impl IReferenceType;

        wires : mut _utils.List<LatestChannel<T>> = new _utils.List<LatestChannel<T>>();
        slot : mut LatestChannel<T> = new LatestChannel<T>();
        closed : mut bool = false;

        fun new(mut this) {}

        // The hub slot's seed: an EXPLICIT declared default (`output p = v`)
        // is a weak deliverable transaction (time-0 first-wait wake-up,
        // superseded by any real write); a synthesized type-zero seed only
        // backs current() bare reads — direct `wait port` parks until the
        // module actually writes.
        fun set_seed(mut this, v: T, deliver: bool) {
            this.slot.set_seed(v, deliver);
        }

        fun subscribe(mut this) -> mut LatestChannel<T> {
            let w : mut LatestChannel<T> = new LatestChannel<T>();
            // Connect-time seeding: a REAL past transaction or a DECLARED
            // default (a variable net's current value, an output port's
            // `= v` default) becomes the new wire's DELIVERABLE seed — the
            // subscriber's first `wait` wakes immediately at time 0 (Q3),
            // and any real write supersedes it. A synthesized type-zero
            // seed backs current() bare reads ONLY: delivering it would
            // wake every subscriber with a garbage empty transaction at
            // time 0.
            let cur : Option<T> = this.slot.current();
            if (cur.is_some()) {
                w.set_seed(cur.some, this.slot.has_live_value());
            }
            this.wires.push(w);
            return w;
        }

        fun check_closed(mut this) {
            if (this.closed) {
                _channel_closed_error();
            }
        }

        impl ISink<T> {
            fun write(this: mut ISink<T>, v: T) {
                let self : mut Self = cast<mut Self>(this);
                self.check_closed();
                __builtin._sim_activity();
                self.slot.push(v);
                for (let w : mut LatestChannel<T> in self.wires.iter()) {
                    w.write(v);
                }
            }

            fun try_write(this: mut ISink<T>, v: T) -> bool {
                let self : mut Self = cast<mut Self>(this);
                self.check_closed();
                __builtin._sim_activity();
                self.slot.push(v);
                for (let w : mut LatestChannel<T> in self.wires.iter()) {
                    w.write(v);
                }
                return true;
            }
        }

        impl ISource<T> {
            fun try_poll(this: mut ISource<T>) -> Option<T> {
                let self : mut Self = cast<mut Self>(this);
                self.check_closed();
                return self.slot.take();
            }

            fun current(this: ISource<T>) -> Option<T> {
                let self : Self = cast<Self>(this);
                return self.slot.current();
            }
        }

        impl IChannel<T> {
            fun close(this: mut IChannel<T>) {
                let self : mut Self = cast<mut Self>(this);
                self.closed = true;
            }

            fun is_closed(this: IChannel<T>) -> bool {
                let self : Self = cast<Self>(this);
                return self.closed;
            }
        }

        impl IFutureBase {
            fun routine_state(this: IFutureBase) -> RoutineState {
                return new RoutineState.ready();
            }

            fun switch_state(this: mut IFutureBase, from: RoutineState, to: RoutineState) -> bool {
                return true;
            }

            fun start(this: mut IFutureBase) -> bool {
                return true;
            }
        }

        // Directly waitable: consumes the hub's own slot stream (single
        // shared cursor for wiring-level readers). Module-to-module wiring
        // goes through subscribe(), which grants each input an independent
        // cursor.
        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                let self : mut Self = cast<mut Self>(this);
                self.check_closed();
                let v : Option<T> = self.slot.take();
                if (v.is_some()) {
                    return new FutureState<T>.ready_finished(v.some);
                }
                return new FutureState<T>.not_ready();
            }
        }
    }

    // Dynamic fan-in: a port-like object accepting N connects. `wait mi`
    // returns the next transaction across ANY connected source — the scan
    // starts where the previous one stopped (rotating), so a busy source
    // cannot starve the others. Iterate the source views (`for (let src :
    // ISource<T> in mi)`) when a custom policy (priority, per-source
    // handling) is needed; try_poll on each view is the non-blocking probe.
    #template(T: type)
    class MultiInput {
        impl IReferenceType;

        sources : mut _utils.List<ISource<T>> = new _utils.List<ISource<T>>();

        // Register a source view (the connect desugaring calls this).
        fun add(mut this, source: mut ISource<T>) {
            this.sources.push(source);
        }

        fun size(this) -> u64 {
            return this.sources.size();
        }

        // Non-blocking probe across every registered source, round-robin:
        // after a hit, the producing source and everything skipped this
        // round move to the back, so a busy source cannot starve the rest.
        fun try_poll_any(mut this) -> Option<T> {
            let n : u64 = this.sources.size();
            if (n == 0) {
                return new Option<T>.none();
            }
            let skipped : mut u64 = 0;
            for (let s : mut ISource<T> in this.sources.iter()) {
                let v : Option<T> = s.try_poll();
                if (v.is_some()) {
                    for (let k : u64 in range(0, skipped + 1)) {
                        let head : Option<ISource<T>> = this.sources.at(0);
                        if (head.is_some()) {
                            this.sources.remove(0);
                            this.sources.push(head.some);
                        }
                    }
                    return v;
                }
                skipped = skipped + 1;
            }
            return new Option<T>.none();
        }

        impl IIterable<ISource<T>> {
            fun iter(this: IIterable<ISource<T>>) -> IIterator<ISource<T>> {
                let self : Self = cast<Self>(this);
                return self.sources.iter();
            }

            fun iter_mut(this: IIterable<ISource<T>>) -> mut IIterator<ISource<T>> {
                let self : Self = cast<Self>(this);
                return self.sources.iter_mut();
            }
        }

        impl IFutureBase {
            fun routine_state(this: IFutureBase) -> RoutineState {
                return new RoutineState.ready();
            }

            fun switch_state(this: mut IFutureBase, from: RoutineState, to: RoutineState) -> bool {
                return true;
            }

            fun start(this: mut IFutureBase) -> bool {
                return true;
            }
        }

        // `wait mi` — the next transaction across any source.
        impl IFuture<T> {
            fun poll(this: IFuture<T>) -> mut FutureState<T> {
                let self : mut Self = cast<mut Self>(this);
                let v : Option<T> = self.try_poll_any();
                if (v.is_some()) {
                    return new FutureState<T>.ready_finished(v.some);
                }
                return new FutureState<T>.not_ready();
            }
        }
    }
}
