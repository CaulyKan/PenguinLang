// Firmware.penguin — the tinyriscv hello-world UART firmware, as assembly
// source.
//
//   1. LUI the UART base 0x30000000, enable TX (CTRL = 1).
//   2. Loop over the NUL-terminated string: poll STATUS.tx_busy, then write
//      the byte to TXDATA. Every poll iteration flows through the pipeline —
//      the busy wait costs REAL cycles, like on the RTL.
//   3. x26 = 1: the testbench's simulation-end convention.
//
// Meta insertion point 3: `firmware_image()` runs the ASSEMBLER AT COMPILE
// TIME via #fun (native pass3 JIT) — the two-pass assemble() executes
// during compilation and the image words are spliced in as a string
// LITERAL: the firmware is baked into the binary, zero runtime cost.

namespace tinyriscv {

    using esl;

    fun firmware_source() -> string {
        return "    lui  t0, 0x30000       # t0 = 0x30000000 (UART base)\n" +
            "    addi t1, x0, 1\n" +
            "    sw   t1, 0(t0)         # CTRL = tx_en\n" +
            "    addi t1, x0, 0         # i = 0\n" +
            "loop:\n" +
            "    lbu  t2, str(t1)       # c = str[i]  (offset = str addr, base = i)\n" +
            "    beqz t2, done\n" +
            "poll:\n" +
            "    lw   t3, 4(t0)         # STATUS\n" +
            "    andi t3, t3, 1         # tx_busy\n" +
            "    bnez t3, poll\n" +
            "    sw   t2, 12(t0)        # TXDATA = c\n" +
            "    addi t1, t1, 1\n" +
            "    j    loop\n" +
            "done:\n" +
            "    li   x26, 1            # simulation end convention\n" +
            "end:\n" +
            "    j    end\n" +
            "str:\n" +
            "    .string \"hello world\\n\"\n";
    }

    #fun firmware_image() -> string {
        return assemble(firmware_source());
    }

    // The compute core's program: a counted loop (bound read from RAM
    // word 2 — elaboration-preloaded, per-core workload shaping without
    // R-type arithmetic, which this ISA subset lacks), then a checksum at
    // RAM word 0 and a done flag at word 1. RAM base 0x10000000 (nibble 1).
    fun compute_firmware_source() -> string {
        return "    lui  x5, 0x10000       # x5 = 0x10000000 (RAM base)\n" +
            "    lw   x3, 8(x5)         # n = loop bound (RAM word 2)\n" +
            "    addi x1, x0, 0         # sum = 0\n" +
            "    addi x2, x0, 0         # i = 0\n" +
            "loop:\n" +
            "    addi x1, x1, 5         # sum += 5\n" +
            "    addi x2, x2, 1         # i += 1\n" +
            "    bne  x2, x3, loop\n" +
            "    sw   x1, 0(x5)         # RAM[0] = checksum\n" +
            "    addi x6, x0, 1\n" +
            "    sw   x6, 4(x5)         # RAM[1] = done\n" +
            "end:\n" +
            "    j    end\n";
    }

    #fun compute_firmware_image() -> string {
        return assemble(compute_firmware_source());
    }

}
