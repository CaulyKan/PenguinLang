// main.penguin — tinyriscv SoC top level (Examples/tinyriscv).
//
// Memory map (addr[31:28] decode, faithful to rtl/tinyriscv_soc.v):
//   0x0        ROM  (firmware, 4 KB)
//   0x1        RAM  (16 KB)
//   0x3        UART (0x30000000: CTRL/STATUS/BAUD/TXDATA)
//
// The wiring lives in a top-level construct block — it runs at ELABORATION
// (before any initial routine spawns) and is statically audited (E_WIRING):
// every module input is connected. Pipeline state flows through esl.Pipe
// channels (if_id / id_ex), the writeback through Execute's wb output port,
// and the posedge fans out from the clock's Event into each module's clk
// INPUT PORT (connect(clk.evt, m.clk) ≡ @(posedge clk)). The firmware is
// assembled at compile time (#fun) and loaded into ROM during elaboration,
// before the first fetch. The clock runs until the firmware sets x26=1
// (testbench end convention); the final report prints the cycle count and
// its 50 MHz wall-clock equivalent.
//
// Combinational paths (regfile reads, the RIB bus) stay plain function
// calls during evaluate — the SystemC convention; every arbitration input
// derives from committed register/pipe state, so wakeup order stays
// irrelevant.

using tinyriscv;
using esl;

class SimEnd {
    impl ICycleHook;

    clk: Clock;
    regs: RegFile;
    uart: Uart;
    limit: mut i64 = 2000000;

    fun new(mut this, clk: mut Clock, regs: mut RegFile, uart: mut Uart) {
        this.clk = clk;
        this.regs = regs;
        this.uart = uart;
    }

    impl ICycleHook {
        fun after_commit(this) -> bool {
            if (this.regs.read(cast<u32>(26)) == cast<u32>(1)) {
                let n: i64 = this.clk.cycles;
                println("");
                println("[tinyriscv] simulation end: " + cast<string>(n) +
                    " cycles (" + cast<string>(n * 20) + " ns @ 50 MHz), " +
                    cast<string>(this.uart.tx_count) + " chars sent");
                return true;
            }
            if (this.clk.cycles >= this.limit) {
                println("");
                println("[tinyriscv] TIMEOUT after " + cast<string>(this.clk.cycles) + " cycles");
                return true;
            }
            return false;
        }
    }
}

fun load_firmware(rom: mut Rom) {
    // Meta: firmware_image() assembles AT COMPILE TIME (#fun JIT).
    let image: string = #firmware_image();
    let idx: mut i64 = 0;
    for (let line: string in image.split("\n")) {
        let v: Option<i64> = parse_int(line);
        if (v.is_some()) {
            rom.set_word(cast<u64>(idx), cast<u32>(v.some));
            idx = idx + 1;
        }
    }
}

construct {
    let clk: mut Clock = new Clock();

    let regs: mut RegFile = new RegFile(clk);

    let rom: mut Rom = new Rom(1024);
    load_firmware(rom);
    let ram: mut Ram = new Ram(4096);
    let uart: mut Uart = new Uart();

    // Meta: the addr[31:28] -> region decode is GENERATED from the #class
    // memory-map table (perips/MemMap.penguin); slaves attach in table order.
    let bus: mut Bus = new Bus();
    bus.attach_indexed(rom);
    bus.attach_indexed(ram);
    bus.attach_indexed(uart);
    bus.set_decoder(new MmioDecoder());

    // Pipeline channels: if_id / id_ex as two-phase esl.Pipe registers
    // (write during evaluate, publish at the clock's commit; a cycle with
    // no write is the NOP bubble — the RTL's flush).
    let if_pipe: mut Pipe<FetchPacket> = new Pipe<FetchPacket>(clk);
    let id_pipe: mut Pipe<DecPacket> = new Pipe<DecPacket>(clk);

    // Control: pure functions of the committed id_ex slot + regfile.
    let ctrl: mut Ctrl = new Ctrl(id_pipe, regs);

    let fetch: mut Fetch = new Fetch(clk, bus, if_pipe, ctrl);
    let decode: mut Decode = new Decode(id_pipe, ctrl);
    let execute: mut Execute = new Execute(regs, bus);

    // Posedge fan-out (Event -> clk input ports), datapath channels, and
    // the writeback wire (EX output -> RegFile input).
    connect(clk.evt, fetch.clk);
    connect(clk.evt, decode.clk);
    connect(clk.evt, execute.clk);
    connect(if_pipe, decode.if_in);
    connect(id_pipe, execute.id_in);
    connect(execute.wb, regs.wb_in);

    // RIB m0 arbitration probe: the Bus asks EX (IBusMaster) whether it
    // owns the bus this cycle.
    bus.set_m0(execute);

    let hook: mut SimEnd = new SimEnd(clk, regs, uart);
    clk.set_hook(hook);
}
