// Pipeline.penguin — the shared pipeline STATE of the tinyriscv core
// (pc_reg / if_id / id_ex register bundle), owned by Core and driven by the
// Fetch / Decode / Execute processes (their own files). Every Reg commits
// at the clock edge through esl.Clock, so each process's evaluate phase
// reads only committed state — the processes are wakeup-order independent.

namespace tinyriscv {

    using esl;

    class Core {
        impl __builtin.IReferenceType;

        clk: Clock;
        bus: Bus;
        regs: RegFile;

        // pc_reg
        pc: mut Reg<u32>;
        // if_id (instruction word + its pc, for branch target math)
        if_inst: mut Reg<u32>;
        if_pc: mut Reg<u32>;
        // id_ex (decoded fields + register INDICES — values are read in EX)
        ex_op: mut Reg<u32>;
        ex_rd: mut Reg<u32>;
        ex_rs1: mut Reg<u32>;
        ex_rs2: mut Reg<u32>;
        ex_imm: mut Reg<u32>;
        ex_pc: mut Reg<u32>;

        fun new(mut this, clk: mut Clock, bus: mut Bus, regs: mut RegFile) {
            this.clk = clk;
            this.bus = bus;
            this.regs = regs;
            this.pc = new Reg<u32>(clk, cast<u32>(0));
            this.if_inst = new Reg<u32>(clk, nop_word());
            this.if_inst.set_default(nop_word());
            this.if_pc = new Reg<u32>(clk, cast<u32>(0));
            this.ex_op = new Reg<u32>(clk, OP_NOP());
            this.ex_rd = new Reg<u32>(clk, cast<u32>(0));
            this.ex_rs1 = new Reg<u32>(clk, cast<u32>(0));
            this.ex_rs2 = new Reg<u32>(clk, cast<u32>(0));
            this.ex_imm = new Reg<u32>(clk, cast<u32>(0));
            this.ex_pc = new Reg<u32>(clk, cast<u32>(0));
        }

        // RIB m0 arbitration probe: pure function of COMMITTED id_ex state.
        impl IBusMaster {
            fun bus_req(this) -> bool {
                return is_mem_op(this.ex_op.out());
            }
        }
    }

}
