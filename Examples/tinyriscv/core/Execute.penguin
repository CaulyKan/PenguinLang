// Execute.penguin — the EX stage process (rtl/core/ex.v): combinational
// execute of the committed id_ex — ALU, RIB m0 data access, regfile write
// submission (committed at the edge by RegFile itself), link register.
// The jump DECISION is made independently by Ctrl (same committed inputs);
// this process only performs the state effects owned by EX.

namespace tinyriscv {

    using esl;

    class Execute {
        impl __builtin.IReferenceType;

        clk: Clock;
        core: Core;
        ctrl: Ctrl;

        fun new(mut this, clk: mut Clock, core: mut Core, ctrl: mut Ctrl) {
            this.clk = clk;
            this.core = core;
            this.ctrl = ctrl;
        }

        initial {
            while (true) {
                wait this.clk.evt;
                this.step();
            }
        }

        fun step(mut this) {
            let eop: u32 = this.core.ex_op.out();
            let erd: u32 = this.core.ex_rd.out();
            let eimm: u32 = this.core.ex_imm.out();
            let epc: u32 = this.core.ex_pc.out();
            let ers1v: u32 = this.ctrl.ex_rs1v();
            let ers2v: u32 = this.ctrl.ex_rs2v();

            if (eop == OP_LUI()) {
                this.core.regs.submit_write(erd, eimm);
            } else if (eop == OP_ADDI()) {
                this.core.regs.submit_write(erd, ers1v + eimm);
            } else if (eop == OP_ANDI()) {
                this.core.regs.submit_write(erd, ers1v & eimm);
            } else if (eop == OP_LBU()) {
                let addr: u32 = ers1v + eimm;
                let word: u32 = this.core.bus.m0_read(addr);
                let lane: i64 = cast<i64>(addr & cast<u32>(3));
                this.core.regs.submit_write(erd, bits(cast<u32>(rshift(cast<i64>(word), lane * 8)), 7, 0));
            } else if (eop == OP_LW()) {
                let addr: u32 = ers1v + eimm;
                this.core.regs.submit_write(erd, this.core.bus.m0_read(addr));
            } else if (eop == OP_SW()) {
                let addr: u32 = ers1v + eimm;
                this.core.bus.m0_write(addr, ers2v);
            } else if (eop == OP_JAL()) {
                this.core.regs.submit_write(erd, epc + cast<u32>(4));
            }
            // BEQ/BNE have no EX state effect beyond the ctrl decision.
        }
    }

}
