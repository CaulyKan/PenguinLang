// Execute.penguin — the EX stage process (rtl/core/ex.v): poll the id_ex
// Pipe (none = bubble, nothing to do), combinational execute — ALU, RIB m0
// data access, regfile writeback through the `wb` OUTPUT PORT (the write
// lands at this cycle's clock edge, like the RTL's posedge regfile write),
// link register. The jump DECISION is made independently by Ctrl from the
// same committed id_ex slot; this process only performs the state effects
// owned by EX.

namespace tinyriscv {

    using esl;

    class Execute {
        impl __builtin.IReferenceType;

        input clk : i64;
        input id_in : DecPacket;
        output wb : Writeback;

        regs: RegFile;
        bus: Bus;

        fun new(mut this, regs: mut RegFile, bus: mut Bus) {
            this.regs = regs;
            this.bus = bus;
        }

        // RIB m0 arbitration probe: a pure function of the COMMITTED id_ex
        // slot (current() — the registered view, unaffected by whether this
        // cycle's poll already consumed it), so the answer is identical
        // whichever module evaluates first.
        impl IBusMaster {
            fun bus_req(this) -> bool {
                let s: Option<DecPacket> = this.id_in.current();
                if (s.is_none()) { return false; }
                return is_mem_op(s.some.op);
            }
        }

        fun send_wb(mut this, rd: u32, val: u32) {
            let w: mut Writeback = new Writeback();
            w.rd = rd;
            w.val = val;
            this.wb.write(w);
        }

        initial {
            while (true) {
                let cyc: i64 = wait this.clk;
                let p: Option<DecPacket> = this.id_in.try_poll();
                if (p.is_some()) {
                    let d: DecPacket = p.some;
                    if (d.op == OP_LUI()) {
                        this.send_wb(d.rd, d.imm);
                    } else if (d.op == OP_ADDI()) {
                        this.send_wb(d.rd, this.regs.read(d.rs1) + d.imm);
                    } else if (d.op == OP_ANDI()) {
                        this.send_wb(d.rd, this.regs.read(d.rs1) & d.imm);
                    } else if (d.op == OP_LBU()) {
                        let addr: u32 = this.regs.read(d.rs1) + d.imm;
                        let word: u32 = this.bus.m0_read(addr);
                        let lane: i64 = cast<i64>(addr & cast<u32>(3));
                        this.send_wb(d.rd, bits(cast<u32>(rshift(cast<i64>(word), lane * 8)), 7, 0));
                    } else if (d.op == OP_LW()) {
                        let addr: u32 = this.regs.read(d.rs1) + d.imm;
                        this.send_wb(d.rd, this.bus.m0_read(addr));
                    } else if (d.op == OP_SW()) {
                        let addr: u32 = this.regs.read(d.rs1) + d.imm;
                        this.bus.m0_write(addr, this.regs.read(d.rs2));
                    } else if (d.op == OP_JAL()) {
                        this.send_wb(d.rd, d.pc + cast<u32>(4));
                    }
                    // BEQ/BNE have no EX state effect beyond the ctrl decision.
                }
            }
        }
    }

}
