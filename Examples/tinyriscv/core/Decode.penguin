// Decode.penguin — the ID stage process: poll the if_id Pipe (none = bubble
// ≡ NOP — reset value or a flush), decode the word (pure decode in
// Decoder.penguin), and publish the fields into the id_ex Pipe. A taken
// branch in EX (Hold_Id) publishes NOTHING instead — the pipe bubble next
// cycle is the second half of the 2-cycle taken-branch penalty. Instructions
// decoding to OP_NOP are not published at all: the bubble IS the NOP.

namespace tinyriscv {

    using esl;

    class Decode {
        impl __builtin.IReferenceType;

        input clk : i64;
        input if_in : FetchPacket;

        id_out: mut Pipe<DecPacket>;
        ctrl: Ctrl;
        dec: mut Dec = new Dec();

        fun new(mut this, id_out: mut Pipe<DecPacket>, ctrl: mut Ctrl) {
            this.id_out = id_out;
            this.ctrl = ctrl;
        }

        initial {
            while (true) {
                let cyc: i64 = wait this.clk;
                if (this.ctrl.jump_flag()) {
                    // Hold_Id: no id_out publication — EX polls a bubble.
                } else {
                    let fp: Option<FetchPacket> = this.if_in.try_poll();
                    if (fp.is_some()) {
                        decode(fp.some.inst, this.dec);
                        if (this.dec.op != OP_NOP()) {
                            let d: mut DecPacket = new DecPacket();
                            d.op = this.dec.op;
                            d.rd = this.dec.rd;
                            d.rs1 = this.dec.rs1;
                            d.rs2 = this.dec.rs2;
                            d.imm = this.dec.imm;
                            d.pc = fp.some.pc;
                            this.id_out.write(d);
                        }
                    }
                    // A polled bubble (reset / flush) latches nothing.
                }
            }
        }
    }

}
