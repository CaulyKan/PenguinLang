// LspMain: the session-level module (design doc's static half).
//
// Two loops, one per input port (session commands, document traffic):
//  - session: initialize / initialized / shutdown / exit. `exit` pushes the
//    out_exit control into the outbound hub — frame order guarantees the
//    shutdown response (and everything else queued) reaches the wire before
//    StdioStream calls exit(code) — then the loop retires.
//  - docs: routing by textDocument.uri into the SINGLE compile actor
//    (batch 4.4): didOpen/didChange/didClose update the open-document
//    registry and push an LspCompileMsg onto the actor's reqs Fifo (the
//    actor folds same-uri bursts, serializes every incremental transaction
//    and answers the navigation queries); everything the actor produces —
//    responses and publishDiagnostics — flows through its OWN output port,
//    attached into JsonOutputParser's fan-in once at construction. LspMain
//    itself only answers lifecycle requests and protocol errors for
//    documents that are not open (queries on closed documents never reach
//    the actor).
//
// Session responses flow through this module's OWN output port (connected
// statically to JsonOutputParser.inputs in LspWiring) — no ISink anywhere.
namespace lsp {

// The LspMain-side open-document record (registry): the routing path plus
// the document's CURRENT editor text, updated on didOpen/didChange. Only
// LspMain reads and writes it (each kick carries a copy as its payload —
// the compile actor never reaches back into this map).
class LspDocState {
    path: string = "";
    text: mut string = "";

    fun new(mut this, path: string, text: string) {
        this.path = path;
        this.text = text;
    }
}

class LspMain {
    input session : string;
    input docs : string;
    output responses : LspOutMsg;

    // Outbound fan-in module reference (used only for the one-time attach()
    // of the compile actor's output port at construction — see
    // JsonOutputParser).
    out: mut JsonOutputParser;
    // The single compile actor: every incremental transaction and query is
    // serialized inside it (batch 4.4 redesign §9 topology).
    compiler: mut LspCompileActor;
    // Open-document registry: uri → path + current editor text (the text
    // also rides each LspCompileMsg — the actor never reads this map).
    doc_states: mut std.HashMap<string, LspDocState> = new std.HashMap<string, LspDocState>();
    shutdown_seen: mut bool = false;
    // Workspace routing config (.magellanic.config at the initialize rootUri;
    // loaded once at initialize, unloaded-empty before it — see LspConfig).
    config: mut LspWorkspaceConfig = new LspWorkspaceConfig();

    fun new(mut this, out: mut JsonOutputParser, compiler: mut LspCompileActor) {
        this.out = out;
        this.compiler = compiler;
        this.out.attach(cast<mut __builtin.ISource<LspOutMsg>>(compiler.events));
    }

    fun respond_result(mut this, msg: LspMessage, result_json: string) {
        let r: mut LspResponse = response_for(msg);
        r.result_json = result_json;
        this.responses.write(new LspOutMsg.out_response(r));
    }

    fun respond_error(mut this, msg: LspMessage, code: i64, message: string) {
        this.responses.write(new LspOutMsg.out_error(error_for(msg, code, message)));
    }

    // Push one request into the compile actor's Fifo.
    fun kick(mut this, kind: i64, msg: LspMessage, uri: string, path: string, text: string) {
        let m: mut LspCompileMsg = new LspCompileMsg();
        m.kind = kind;
        m.uri = uri;
        m.path = path;
        m.text = text;
        m.msg = msg;
        m.config = this.config;
        this.compiler.reqs.write(m);
    }

    // Push a lifecycle request (initialize/shutdown/exit/unknown session
    // method): the compile actor answers it strictly behind every pending
    // transaction and query — the whole outbound stream stays totally
    // ordered (a shutdown response can never overtake an earlier query's).
    fun kick_lifecycle(mut this, msg: LspMessage, exit_code: i64) {
        let m: mut LspCompileMsg = new LspCompileMsg();
        m.kind = 3;
        m.msg = msg;
        m.exit_code = exit_code;
        m.config = this.config;
        this.compiler.reqs.write(m);
    }

    initial {
        while (true) {
            let body: string = wait this.session;
            let msg: mut LspMessage = parse_message(body);
            if (msg.method == "initialize") {
                // rootUri is stored, never answered with — the initialize
                // response bytes are capability-only (SessionLifecycle locks
                // them). The config load reads <rootUri>/.magellanic.config
                // once; a missing file is an empty loaded config.
                this.config = load_workspace_config(extract_root_uri(msg.params_json));
                this.kick_lifecycle(msg, 0);
            } else if (msg.method == "initialized") {
                // Notification; nothing to do.
            } else if (msg.method == "shutdown") {
                this.shutdown_seen = true;
                this.kick_lifecycle(msg, 0);
            } else if (msg.method == "exit") {
                // LSP spec: 0 after shutdown, 1 otherwise. The control flows
                // through the actor's port into the hub, so pending frames
                // (including any queued responses) flush before StdioStream
                // calls exit(code) — then this loop retires.
                if (this.shutdown_seen) {
                    this.kick_lifecycle(msg, 0);
                } else {
                    this.kick_lifecycle(msg, 1);
                }
                break;
            } else if (msg.has_id) {
                this.kick_lifecycle(msg, 0);
            }
        }
    }

    initial {
        while (true) {
            let body: string = wait this.docs;
            let msg: mut LspMessage = parse_message(body);
            let uri: string = extract_uri(msg);
            if (uri == "") {
                continue;
            }
            if (msg.method == "textDocument/didOpen") {
                if (this.doc_states.get(uri).is_none()) {
                    let p: std.JsonValue = std.parse_json(msg.params_json);
                    let td: __builtin.Option<std.JsonValue> = p.get("textDocument");
                    let text: mut string = "";
                    if (td.is_some()) {
                        text = json_get_string(td.some, "text");
                    }
                    let path: string = uri_to_path(uri);
                    this.doc_states.put(uri, new LspDocState(path, text));
                    this.kick(0, msg, uri, path, text);
                }
            } else if (msg.method == "textDocument/didClose") {
                // Retire the document: the registry entry drops now (later
                // traffic for this uri is rejected here), and the compile
                // actor folds the CLOSE (single-file sessions die; project
                // sessions fall the file back to its on-disk text).
                let st: __builtin.Option<LspDocState> = this.doc_states.get(uri);
                if (!st.is_none()) {
                    this.doc_states.remove(uri);
                    this.kick(1, msg, uri, st.some.path, "");
                }
            } else if (msg.method == "textDocument/didChange") {
                let st: __builtin.Option<LspDocState> = this.doc_states.get(uri);
                if (!st.is_none()) {
                    let t: string = extract_change_text(msg.params_json);
                    if (string_length(t) > 0) {
                        st.some.text = t;
                        this.kick(0, msg, uri, st.some.path, t);
                    }
                }
            } else {
                // Navigation queries: routed into the compile actor (it
                // answers strictly after the edits that preceded them).
                let st: __builtin.Option<LspDocState> = this.doc_states.get(uri);
                if (!st.is_none()) {
                    this.kick(2, msg, uri, st.some.path, st.some.text);
                } else if (msg.has_id) {
                    this.respond_error(msg, JSONRPC_INVALID_PARAMS, "document not open: " + uri);
                }
            }
        }
    }
}

}
