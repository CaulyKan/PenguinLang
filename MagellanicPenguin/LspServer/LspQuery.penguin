// LspQuery: bound-tree queries over the last successful compilation
// (definition / documentSymbol / completion / references / hover / inlayHint /
// rename / formatting).
//
// Every query runs on the SYMBOL INDEX — a SymEntry tree built by recursively
// walking emperor.BoundCompilationUnit.definitions (namespaces, classes,
// enums, interfaces, functions, fields, globals, initial blocks; each bound
// symbol carries the emperor.SourceLocation of its declaration). EP lexer locations
// are 1-based line AND 1-based col; LSP positions are 0-based, so conversion
// happens at the JSON edge (line-1 / col-1), matching diagnostics publishing.
//
// v1 semantics mirror the C# server's deliberate simplicity (see
// MagellanicPenguin/LSP/LSP.cs): documentSymbol lists THIS document's defs
// (stdlib and other files filtered by location filename; the per-file
// `_ns_*` wrapper namespaces splice their children to the top level);
// definition/hover re-lex the document for the identifier under the cursor
// and look it up in the whole-program index (same-file match preferred — no
// scope resolution); completion returns the language keywords plus every
// indexed symbol, deduplicated by name. references/rename are name-level
// occurrence scans of the requesting document (declarations reported once,
// honoring context.includeDeclaration; rename edits every occurrence).
// inlayHint walks bound bodies for `let` declarations with known types.
// formatting re-emits the token stream lexically (comments preserved from
// the raw text). Enum member symbols carry declaration locations in the
// bound tree, so variants resolve to their own sites.
namespace lsp {

// LSP SymbolKind (documentSymbol).
let SYM_NAMESPACE: i64 = 3;
let SYM_CLASS: i64 = 5;
let SYM_METHOD: i64 = 6;
let SYM_FIELD: i64 = 8;
let SYM_ENUM: i64 = 10;
let SYM_INTERFACE: i64 = 11;
let SYM_FUNCTION: i64 = 12;
let SYM_VARIABLE: i64 = 13;
let SYM_ENUM_MEMBER: i64 = 22;

// LSP CompletionItemKind (completion).
let CIK_METHOD: i64 = 2;
let CIK_FUNCTION: i64 = 3;
let CIK_FIELD: i64 = 5;
let CIK_VARIABLE: i64 = 6;
let CIK_CLASS: i64 = 7;
let CIK_INTERFACE: i64 = 8;
let CIK_MODULE: i64 = 9;
let CIK_ENUM: i64 = 13;
let CIK_KEYWORD: i64 = 14;
let CIK_ENUM_MEMBER: i64 = 20;

class SymEntry {
    name: string = "";
    kind: i64 = 0;
    cik: i64 = 0;
    // Hover detail (a PenguinLang signature/type line; "" = none).
    detail: string = "";
    // Declaration site in EP lexer basis (1-based line, 1-based col); an
    // empty filename means "no location" (namespace wrappers).
    filename: string = "";
    line: i64 = 0;
    col: i64 = 0;
    children: mut _utils.List<SymEntry> = new _utils.List<SymEntry>();

    fun new(mut this) {}
}

fun empty_loc() -> emperor.SourceLocation {
    return new emperor.SourceLocation("", 0, 0);
}

fun make_entry(name: string, kind: i64, cik: i64, loc: emperor.SourceLocation) -> mut SymEntry {
    let e: mut SymEntry = new SymEntry();
    e.name = name;
    e.kind = kind;
    e.cik = cik;
    e.filename = loc.filename;
    e.line = loc.line;
    e.col = loc.col;
    return e;
}

// A hover signature from a bound function symbol: `fun name(a: T, ...) -> R`
// (`this` receivers skipped). Parameters carry their mutability flavor.
fun function_detail(sym: emperor.BoundFunctionSymbol) -> string {
    let sb: mut StringBuilder = new StringBuilder();
    sb.append("fun ");
    sb.append(sym.name);
    sb.append("(");
    let i: mut i64 = 0;
    let first: mut bool = true;
    while (i < cast<i64>(sym.parameters.size())) {
        let p: emperor.BoundFunctionParameter = sym.parameters.at(cast<u64>(i)).some;
        if (!p.is_this) {
            if (!first) { sb.append(", "); }
            first = false;
            sb.append(p.name);
            sb.append(": ");
            sb.append(p.bound_type.display_name());
        }
        i = i + 1;
    }
    sb.append(") -> ");
    sb.append(sym.return_type.display_name());
    return sb.to_string();
}

// One function definition → one entry (skips monomorphized copies so a
// generic method completes/defines as its template, not Foo__i64 clones).
fun push_function_entry(def: emperor.BoundFunctionDefinition, kind: i64, cik: i64, out: mut _utils.List<SymEntry>) {
    if (def.is_specialized) { return; }
    if (def.symbol.is_none()) { return; }
    let e: mut SymEntry = make_entry(def.name, kind, cik, def.symbol.some.location);
    e.detail = function_detail(def.symbol.some);
    out.push(e);
}

fun push_function_entries(defs: _utils.List<emperor.BoundDefinition>, kind: i64, cik: i64, out: mut _utils.List<SymEntry>) {
    for (let d in defs) {
        if (d is emperor.BoundDefinition.function_def) {
            push_function_entry(d.function_def, kind, cik, out);
        }
    }
}

// Build the symbol tree from a bound unit's definitions. The per-file
// `_ns_*` wrapper namespaces are spliced away (their children surface at the
// enclosing level); specialized (monomorphized) defs and impl blocks are
// skipped — they duplicate their templates.
fun index_defs(defs: _utils.List<emperor.BoundDefinition>, out: mut _utils.List<SymEntry>) {
    for (let def in defs) {
        if (def is emperor.BoundDefinition.namespace_def) {
            let nd: emperor.BoundNamespaceDefinition = def.namespace_def;
            if (string_find(nd.name, "_ns_") == 0) {
                index_defs(nd.children, out);
            } else {
                let e: mut SymEntry = make_entry(nd.name, SYM_NAMESPACE, CIK_MODULE, empty_loc());
                index_defs(nd.children, e.children);
                out.push(e);
            }
        } else if (def is emperor.BoundDefinition.class_def) {
            let cd: emperor.BoundClassDefinition = def.class_def;
            if (!cd.is_specialized) {
                let loc: emperor.SourceLocation = if (cd.type_symbol.is_some()) { cd.type_symbol.some.location } else { empty_loc() };
                let e: mut SymEntry = make_entry(cd.name, SYM_CLASS, CIK_CLASS, loc);
                e.detail = "class " + cd.name;
                let fi: mut i64 = 0;
                while (fi < cast<i64>(cd.fields.size())) {
                    let f: emperor.BoundDefinition = cd.fields.at(cast<u64>(fi)).some;
                    if (f is emperor.BoundDefinition.class_field) {
                        let fld: emperor.BoundClassFieldDefinition = f.class_field;
                        let floc: emperor.SourceLocation = if (fld.field_symbol.is_some()) { fld.field_symbol.some.location } else { empty_loc() };
                        let fe: mut SymEntry = make_entry(fld.name, SYM_FIELD, CIK_FIELD, floc);
                        fe.detail = fld.name + ": " + fld.bound_type.display_name();
                        e.children.push(fe);
                    }
                    fi = fi + 1;
                }
                push_function_entries(cd.methods, SYM_METHOD, CIK_METHOD, e.children);
                push_function_entries(cd.constructors, SYM_METHOD, CIK_METHOD, e.children);
                out.push(e);
            }
        } else if (def is emperor.BoundDefinition.enum_def) {
            let ed: emperor.BoundEnumDefinition = def.enum_def;
            if (!ed.is_specialized) {
                let loc: emperor.SourceLocation = if (ed.type_symbol.is_some()) { ed.type_symbol.some.location } else { empty_loc() };
                let e: mut SymEntry = make_entry(ed.name, SYM_ENUM, CIK_ENUM, loc);
                e.detail = "enum " + ed.name;
                let mi: mut i64 = 0;
                while (mi < cast<i64>(ed.members.size())) {
                    let m: emperor.BoundEnumMemberDefinition = ed.members.at(cast<u64>(mi)).some;
                    // Member symbols carry no location (bound tree gap) —
                    // variants resolve to the enum declaration itself.
                    let mloc: mut emperor.SourceLocation = loc;
                    if (m.member_symbol.is_some()) {
                        if (m.member_symbol.some.location.line > 0) {
                            mloc = m.member_symbol.some.location;
                        }
                    }
                    let me: mut SymEntry = make_entry(m.name, SYM_ENUM_MEMBER, CIK_ENUM_MEMBER, mloc);
                    me.detail = "member of " + ed.name;
                    e.children.push(me);
                    mi = mi + 1;
                }
                push_function_entries(ed.methods, SYM_METHOD, CIK_METHOD, e.children);
                out.push(e);
            }
        } else if (def is emperor.BoundDefinition.interface_def) {
            let id: emperor.BoundInterfaceDefinition = def.interface_def;
            if (!id.is_specialized) {
                let loc: emperor.SourceLocation = if (id.type_symbol.is_some()) { id.type_symbol.some.location } else { empty_loc() };
                let e: mut SymEntry = make_entry(id.name, SYM_INTERFACE, CIK_INTERFACE, loc);
                e.detail = "interface " + id.name;
                push_function_entries(id.methods, SYM_METHOD, CIK_METHOD, e.children);
                out.push(e);
            }
        } else if (def is emperor.BoundDefinition.function_def) {
            push_function_entry(def.function_def, SYM_FUNCTION, CIK_FUNCTION, out);
        } else if (def is emperor.BoundDefinition.global_var_def) {
            let gd: emperor.BoundGlobalVariableDefinition = def.global_var_def;
            let gloc: emperor.SourceLocation = if (gd.variable_symbol.is_some()) { gd.variable_symbol.some.location } else { empty_loc() };
            let ge: mut SymEntry = make_entry(gd.name, SYM_VARIABLE, CIK_VARIABLE, gloc);
            ge.detail = gd.name + ": " + gd.variable_symbol.some.bound_type.display_name();
            out.push(ge);
        } else if (def is emperor.BoundDefinition.initial_routine) {
            let ir: emperor.BoundInitialRoutineDefinition = def.initial_routine;
            if (ir.symbol.is_some()) {
                out.push(make_entry("<initial>", SYM_METHOD, CIK_METHOD, ir.symbol.some.location));
            }
        }
        // impl_def / impl_for_def / type_ref / meta_*: not user-visible symbols.
    }
}

fun flat_collect(entries: _utils.List<SymEntry>, out: mut _utils.List<SymEntry>) {
    for (let e in entries) {
        out.push(e);
        flat_collect(e.children, out);
    }
}

// An LSP position object from 0-based coordinates (already converted).
fun write_pos0(w: mut std.JsonWriter, line0: i64, char0: i64) {
    let l: mut i64 = line0;
    let c: mut i64 = char0;
    if (l < 0) { l = 0; }
    if (c < 0) { c = 0; }
    w.begin_object();
    w.key("line");
    w.value_i64(l);
    w.key("character");
    w.value_i64(c);
    w.end_object();
}

// ---- documentSymbol ----

// Serialize the subtree rooted at `entries` filtered to doc_path: a matching
// node emits itself (name spans its declaration) plus its matching children;
// a non-matching wrapper (namespace, foreign-file root) splices its matching
// descendants through to this level.
fun write_doc_symbols(w: mut std.JsonWriter, entries: _utils.List<SymEntry>, doc_path: string) {
    for (let e in entries) {
        if (e.filename == doc_path && e.line > 0) {
            let line0: i64 = e.line - 1;
            let char0: i64 = e.col - 1;
            w.begin_object();
            w.key("name");
            w.value_string(e.name);
            w.key("kind");
            w.value_i64(e.kind);
            w.key("range");
            w.begin_object();
            w.key("start");
            write_pos0(w, line0, char0);
            w.key("end");
            write_pos0(w, line0, char0 + string_length(e.name));
            w.end_object();
            w.key("selectionRange");
            w.begin_object();
            w.key("start");
            write_pos0(w, line0, char0);
            w.key("end");
            write_pos0(w, line0, char0 + string_length(e.name));
            w.end_object();
            w.key("children");
            w.begin_array();
            write_doc_symbols(w, e.children, doc_path);
            w.end_array();
            w.end_object();
        } else {
            write_doc_symbols(w, e.children, doc_path);
        }
    }
}

fun query_document_symbol(unit: LspCompilationUnit) -> string {
    if (unit.last_ok.is_none()) { return "[]"; }
    let roots: mut _utils.List<SymEntry> = new _utils.List<SymEntry>();
    index_defs(unit.last_ok.some.definitions, roots);
    let w: mut std.JsonWriter = new std.JsonWriter();
    w.begin_array();
    write_doc_symbols(w, roots, unit.path);
    w.end_array();
    return w.to_string();
}

// ---- definition ----

// The identifier token covering the 0-based (line, character) position, or "".
fun identifier_at(text: string, filename: string, line: i64, character: i64) -> string {
    let mut lexer = new emperor.Lexer(text, filename);
    let tokens: _utils.List<emperor.Token> = lexer.tokenize();
    let want_line: i64 = line + 1;
    let want_col: i64 = character + 1;
    for (let t in tokens) {
        if (t.token_type is emperor.TokenType.Identifier) {
            if (t.location.line == want_line) {
                let c0: i64 = t.location.col;
                if (want_col >= c0 && want_col < c0 + string_length(t.text)) {
                    return t.text;
                }
            }
        }
    }
    return "";
}

fun query_definition(unit: LspCompilationUnit, msg: LspMessage) -> string {
    if (unit.last_ok.is_none()) { return "[]"; }
    let pos: LspPosition = extract_position(msg.params_json);
    let name: string = identifier_at(unit.text, unit.path, pos.line, pos.character);
    if (name == "") { return "[]"; }

    let roots: mut _utils.List<SymEntry> = new _utils.List<SymEntry>();
    index_defs(unit.last_ok.some.definitions, roots);
    let flat: mut _utils.List<SymEntry> = new _utils.List<SymEntry>();
    flat_collect(roots, flat);

    let same_file: mut Option<SymEntry> = new Option<SymEntry>.none();
    let other_file: mut Option<SymEntry> = new Option<SymEntry>.none();
    for (let e in flat) {
        if (e.name == name && e.line > 0) {
            if (e.filename == unit.path) {
                if (same_file.is_none()) { same_file = new Option<SymEntry>.some(e); }
            } else {
                if (other_file.is_none()) { other_file = new Option<SymEntry>.some(e); }
            }
        }
    }
    let best: Option<SymEntry> = if (same_file.is_some()) { same_file } else { other_file };
    if (best.is_none()) { return "[]"; }

    let e: SymEntry = best.some;
    let w: mut std.JsonWriter = new std.JsonWriter();
    w.begin_array();
    w.begin_object();
    w.key("uri");
    w.value_string(path_to_uri(e.filename));
    w.key("range");
    w.begin_object();
    w.key("start");
    write_pos0(w, e.line - 1, e.col - 1);
    w.key("end");
    write_pos0(w, e.line - 1, e.col - 1 + string_length(e.name));
    w.end_object();
    w.end_object();
    w.end_array();
    return w.to_string();
}

// ---- completion ----

fun push_keyword(out: mut _utils.List<string>, kw: string) {
    out.push(kw);
}

fun keyword_list() -> mut _utils.List<string> {
    let kws: mut _utils.List<string> = new _utils.List<string>();
    push_keyword(kws, "namespace");
    push_keyword(kws, "using");
    push_keyword(kws, "interface");
    push_keyword(kws, "class");
    push_keyword(kws, "enum");
    push_keyword(kws, "impl");
    push_keyword(kws, "fun");
    push_keyword(kws, "initial");
    push_keyword(kws, "extern");
    push_keyword(kws, "construct");
    push_keyword(kws, "input");
    push_keyword(kws, "output");
    push_keyword(kws, "connect");
    push_keyword(kws, "event");
    push_keyword(kws, "emit");
    push_keyword(kws, "on");
    push_keyword(kws, "wait");
    push_keyword(kws, "async");
    push_keyword(kws, "spawn");
    push_keyword(kws, "let");
    push_keyword(kws, "mut");
    push_keyword(kws, "auto");
    push_keyword(kws, "type");
    push_keyword(kws, "template");
    push_keyword(kws, "export");
    push_keyword(kws, "new");
    push_keyword(kws, "cast");
    push_keyword(kws, "unsafe_cast");
    push_keyword(kws, "this");
    push_keyword(kws, "Self");
    push_keyword(kws, "is");
    push_keyword(kws, "in");
    push_keyword(kws, "for");
    push_keyword(kws, "if");
    push_keyword(kws, "else");
    push_keyword(kws, "elif");
    push_keyword(kws, "while");
    push_keyword(kws, "return");
    push_keyword(kws, "break");
    push_keyword(kws, "continue");
    push_keyword(kws, "try");
    push_keyword(kws, "catch");
    push_keyword(kws, "yield");
    push_keyword(kws, "true");
    push_keyword(kws, "false");
    push_keyword(kws, "void");
    push_keyword(kws, "bool");
    push_keyword(kws, "char");
    push_keyword(kws, "i8");
    push_keyword(kws, "i16");
    push_keyword(kws, "i32");
    push_keyword(kws, "i64");
    push_keyword(kws, "u8");
    push_keyword(kws, "u16");
    push_keyword(kws, "u32");
    push_keyword(kws, "u64");
    push_keyword(kws, "float");
    push_keyword(kws, "double");
    push_keyword(kws, "string");
    return kws;
}

fun query_completion(unit: LspCompilationUnit, msg: LspMessage) -> string {
    let w: mut std.JsonWriter = new std.JsonWriter();
    w.begin_array();
    let kws: mut _utils.List<string> = keyword_list();
    for (let kw in kws) {
        w.begin_object();
        w.key("label");
        w.value_string(kw);
        w.key("kind");
        w.value_i64(CIK_KEYWORD);
        w.end_object();
    }
    if (unit.last_ok.is_some()) {
        let roots: mut _utils.List<SymEntry> = new _utils.List<SymEntry>();
        index_defs(unit.last_ok.some.definitions, roots);
        let flat: mut _utils.List<SymEntry> = new _utils.List<SymEntry>();
        flat_collect(roots, flat);
        let seen: mut std.HashMap<string, bool> = new std.HashMap<string, bool>();
        for (let e in flat) {
            // Namespaces carry no location; qualify by name instead.
            if (e.kind == SYM_NAMESPACE) { continue; }
            if (e.name == "" || string_find(e.name, "<") == 0) { continue; }
            if (seen.contains(e.name)) { continue; }
            seen.put(e.name, true);
            w.begin_object();
            w.key("label");
            w.value_string(e.name);
            w.key("kind");
            w.value_i64(e.cik);
            w.end_object();
        }
    }
    w.end_array();
    return w.to_string();
}

// ---- hover ----

// The whole-program index flattened, same-file matches first (the v1
// name-level resolution order shared by definition/hover/references).
fun lookup_entries(unit: LspCompilationUnit, name: string) -> mut _utils.List<SymEntry> {
    let matches: mut _utils.List<SymEntry> = new _utils.List<SymEntry>();
    if (unit.last_ok.is_none()) { return matches; }
    let roots: mut _utils.List<SymEntry> = new _utils.List<SymEntry>();
    index_defs(unit.last_ok.some.definitions, roots);
    let flat: mut _utils.List<SymEntry> = new _utils.List<SymEntry>();
    flat_collect(roots, flat);
    let same: mut _utils.List<SymEntry> = new _utils.List<SymEntry>();
    let other: mut _utils.List<SymEntry> = new _utils.List<SymEntry>();
    for (let e in flat) {
        if (e.name == name && e.line > 0) {
            if (e.filename == unit.path) { same.push(e); } else { other.push(e); }
        }
    }
    for (let e in same) { matches.push(e); }
    for (let e in other) { matches.push(e); }
    return matches;
}

fun query_hover(unit: LspCompilationUnit, msg: LspMessage) -> string {
    let pos: LspPosition = extract_position(msg.params_json);
    let name: string = identifier_at(unit.text, unit.path, pos.line, pos.character);
    if (name == "") { return "null"; }
    let matches: mut _utils.List<SymEntry> = lookup_entries(unit, name);
    if (matches.size() == 0) { return "null"; }
    let e: SymEntry = matches.at(cast<u64>(0)).some;
    let line0: i64 = e.line - 1;
    let char0: i64 = e.col - 1;
    let text: string = if (e.detail == "") { e.name } else { e.detail };
    let w: mut std.JsonWriter = new std.JsonWriter();
    w.begin_object();
    w.key("contents");
    w.begin_object();
    w.key("kind");
    w.value_string("markdown");
    w.key("value");
    w.value_string("```penguin\n" + text + "\n```");
    w.end_object();
    w.key("range");
    w.begin_object();
    w.key("start");
    write_pos0(w, line0, char0);
    w.key("end");
    write_pos0(w, line0, char0 + string_length(e.name));
    w.end_object();
    w.end_object();
    return w.to_string();
}

// ---- references ----

// All identifier tokens in the document with the given text (the v1
// name-level use sites; cross-file references need the other documents'
// texts, which only opened units have — v1 scans the requesting document).
fun occurrences_in_doc(unit: LspCompilationUnit, name: string) -> mut _utils.List<emperor.Token> {
    let hits: mut _utils.List<emperor.Token> = new _utils.List<emperor.Token>();
    let mut lexer = new emperor.Lexer(unit.text, unit.path);
    let tokens: _utils.List<emperor.Token> = lexer.tokenize();
    for (let t in tokens) {
        if (t.token_type is emperor.TokenType.Identifier) {
            if (t.text == name) {
                hits.push(t);
            }
        }
    }
    return hits;
}

fun query_references(unit: LspCompilationUnit, msg: LspMessage) -> string {
    let pos: LspPosition = extract_position(msg.params_json);
    let name: string = identifier_at(unit.text, unit.path, pos.line, pos.character);
    if (name == "") { return "[]"; }
    let include_decl: bool = json_get_bool_at(msg.params_json, "context", "includeDeclaration");
    let w: mut std.JsonWriter = new std.JsonWriter();
    w.begin_array();
    let hits: mut _utils.List<emperor.Token> = occurrences_in_doc(unit, name);
    let seen_decl: mut bool = false;
    for (let t in hits) {
        let is_decl: bool = t.location.line > 0 && is_declaration_site(unit, name, t.location.line, t.location.col);
        if (is_decl) {
            if (seen_decl || !include_decl) { continue; }
            seen_decl = true;
        }
        w.begin_object();
        w.key("uri");
        w.value_string(path_to_uri(unit.path));
        w.key("range");
        w.begin_object();
        w.key("start");
        write_pos0(w, t.location.line - 1, t.location.col - 1);
        w.key("end");
        write_pos0(w, t.location.line - 1, t.location.col - 1 + string_length(name));
        w.end_object();
        w.end_object();
    }
    w.end_array();
    return w.to_string();
}

// Does an identifier occurrence coincide with the DECLARATION site of a
// same-named symbol (per the index)? Declarations are reported once.
fun is_declaration_site(unit: LspCompilationUnit, name: string, line: i64, col: i64) -> bool {
    let matches: mut _utils.List<SymEntry> = lookup_entries(unit, name);
    for (let e in matches) {
        if (e.filename == unit.path && e.line == line && e.col == col) {
            return true;
        }
    }
    return false;
}

// ---- rename ----

// v1 renames the identifier's every occurrence in the requesting document
// (name-level, not scope-precise) via a single-document WorkspaceEdit.
fun query_rename(unit: LspCompilationUnit, msg: LspMessage) -> string {
    let pos: LspPosition = extract_position(msg.params_json);
    let name: string = identifier_at(unit.text, unit.path, pos.line, pos.character);
    if (name == "") { return "null"; }
    let new_name: string = json_get_string(std.parse_json(msg.params_json), "newName");
    if (new_name == "") { return "null"; }
    let w: mut std.JsonWriter = new std.JsonWriter();
    w.begin_object();
    w.key("changes");
    w.begin_object();
    w.key(path_to_uri(unit.path));
    w.begin_array();
    let hits: mut _utils.List<emperor.Token> = occurrences_in_doc(unit, name);
    for (let t in hits) {
        w.begin_object();
        w.key("range");
        w.begin_object();
        w.key("start");
        write_pos0(w, t.location.line - 1, t.location.col - 1);
        w.key("end");
        write_pos0(w, t.location.line - 1, t.location.col - 1 + string_length(name));
        w.end_object();
        w.key("newText");
        w.value_string(new_name);
        w.end_object();
    }
    w.end_array();
    w.end_object();
    w.end_object();
    return w.to_string();
}

// ---- inlay hints ----

// Collect `let` declarations of THIS document whose bound type is known,
// walking function/method/ctor/initial bodies recursively through nested
// blocks and if/while/lambda expressions. Hints are `: T` labels (kind 1 =
// Type) placed right after the variable name.
fun collect_let_hints(defs: _utils.List<emperor.BoundDefinition>, doc_path: string, lo: i64, hi: i64, out: mut _utils.List<SymEntry>) {
    for (let def in defs) {
        if (def is emperor.BoundDefinition.namespace_def) {
            collect_let_hints(def.namespace_def.children, doc_path, lo, hi, out);
        }
        if (def is emperor.BoundDefinition.class_def) {
            let cd: emperor.BoundClassDefinition = def.class_def;
            for (let md in cd.methods) { collect_fn_hints(md, doc_path, lo, hi, out); }
            for (let cd2 in cd.constructors) { collect_fn_hints(cd2, doc_path, lo, hi, out); }
        }
        if (def is emperor.BoundDefinition.enum_def) {
            let ed: emperor.BoundEnumDefinition = def.enum_def;
            for (let md in ed.methods) { collect_fn_hints(md, doc_path, lo, hi, out); }
        }
        if (def is emperor.BoundDefinition.interface_def) {
            let id: emperor.BoundInterfaceDefinition = def.interface_def;
            for (let md in id.methods) { collect_fn_hints(md, doc_path, lo, hi, out); }
        }
        if (def is emperor.BoundDefinition.function_def) {
            collect_fn_hints(def, doc_path, lo, hi, out);
        }
        if (def is emperor.BoundDefinition.initial_routine) {
            collect_initial_hints(def, doc_path, lo, hi, out);
        }
    }
}

fun collect_initial_hints(def: emperor.BoundDefinition, doc_path: string, lo: i64, hi: i64, out: mut _utils.List<SymEntry>) {
    if (def is emperor.BoundDefinition.initial_routine) {
        let ir: emperor.BoundInitialRoutineDefinition = def.initial_routine;
        if (ir.body.is_some()) {
            walk_hints_expr(ir.body.some, doc_path, lo, hi, out);
        }
    }
}

fun collect_fn_hints(def: emperor.BoundDefinition, doc_path: string, lo: i64, hi: i64, out: mut _utils.List<SymEntry>) {
    if (def is emperor.BoundDefinition.function_def) {
        let fd: emperor.BoundFunctionDefinition = def.function_def;
        if (fd.is_specialized) { return; }
        if (fd.body.is_some()) {
            walk_hints_expr(fd.body.some, doc_path, lo, hi, out);
        }
    }
}

fun push_hint(unit_loc: emperor.SourceLocation, sym: emperor.BoundVariableSymbol, doc_path: string, lo: i64, hi: i64, out: mut _utils.List<SymEntry>) {
    if (unit_loc.filename != doc_path) { return; }
    let line0: i64 = unit_loc.line - 1;
    if (line0 < lo || line0 > hi) { return; }
    let e: mut SymEntry = new SymEntry();
    e.name = sym.name;
    e.filename = unit_loc.filename;
    e.line = unit_loc.line;
    e.col = unit_loc.col;
    e.detail = sym.bound_type.display_name();
    out.push(e);
}

fun walk_hints_expr(e: emperor.BoundExpression, doc_path: string, lo: i64, hi: i64, out: mut _utils.List<SymEntry>) {
    if (e is emperor.BoundExpression.code_block) {
        walk_hints_stmts(e.code_block.statements, doc_path, lo, hi, out);
        if (e.code_block.trailing_expr.is_some()) {
            walk_hints_expr(e.code_block.trailing_expr.some, doc_path, lo, hi, out);
        }
        return;
    }
    if (e is emperor.BoundExpression.if_expr) {
        if (e.if_expr.then_block.is_some()) { walk_hints_expr(e.if_expr.then_block.some, doc_path, lo, hi, out); }
        if (e.if_expr.else_block.is_some()) { walk_hints_expr(e.if_expr.else_block.some, doc_path, lo, hi, out); }
        return;
    }
    if (e is emperor.BoundExpression.while_expr) {
        if (e.while_expr.body.is_some()) { walk_hints_expr(e.while_expr.body.some, doc_path, lo, hi, out); }
        return;
    }
    if (e is emperor.BoundExpression.lambda_expr) {
        if (e.lambda_expr.body.is_some()) { walk_hints_expr(e.lambda_expr.body.some, doc_path, lo, hi, out); }
        return;
    }
}

fun walk_hints_stmts(stmts: _utils.List<emperor.BoundStatement>, doc_path: string, lo: i64, hi: i64, out: mut _utils.List<SymEntry>) {
    for (let s in stmts) {
        if (s is emperor.BoundStatement.let_decl) {
            let ld: emperor.BoundLetDeclarationStatement = s.let_decl;
            if (ld.variable_symbol.is_some()) {
                push_hint(ld.location, ld.variable_symbol.some, doc_path, lo, hi, out);
            }
        }
        if (s is emperor.BoundStatement.expression) {
            if (s.expression.expression.is_some()) {
                walk_hints_expr(s.expression.expression.some, doc_path, lo, hi, out);
            }
        }
        if (s is emperor.BoundStatement.block) {
            walk_hints_stmts(s.block.statements, doc_path, lo, hi, out);
        }
    }
}

fun query_inlay_hints(unit: LspCompilationUnit, msg: LspMessage) -> string {
    if (unit.last_ok.is_none()) { return "null"; }
    let rng: LspRange = extract_range(msg.params_json);
    let hints: mut _utils.List<SymEntry> = new _utils.List<SymEntry>();
    collect_let_hints(unit.last_ok.some.definitions, unit.path, rng.start_line, rng.end_line, hints);
    let w: mut std.JsonWriter = new std.JsonWriter();
    w.begin_array();
    for (let h in hints) {
        w.begin_object();
        w.key("position");
        write_pos0(w, h.line - 1, h.col - 1 + string_length(h.name));
        w.key("label");
        w.value_string(": " + h.detail);
        w.key("kind");
        w.value_i64(1);
        w.end_object();
    }
    w.end_array();
    return w.to_string();
}

// ---- formatting ----

// A whole-document formatter that is lexically faithful: it re-emits the
// token stream with normalized spacing/indentation and preserves comments
// (pre-scanned from the raw text — the lexer drops them) in source order.
fun query_formatting(unit: LspCompilationUnit, msg: LspMessage) -> string {
    let formatted: string = format_penguin_text(unit.text);
    let last: LspPosition = end_position(unit.text);
    let w: mut std.JsonWriter = new std.JsonWriter();
    w.begin_array();
    w.begin_object();
    w.key("range");
    w.begin_object();
    w.key("start");
    write_pos0(w, 0, 0);
    w.key("end");
    write_pos0(w, last.line, last.character);
    w.end_object();
    w.key("newText");
    w.value_string(formatted);
    w.end_object();
    w.end_array();
    return w.to_string();
}

// The 0-based position just past the last character (0,0 for empty text).
fun end_position(text: string) -> LspPosition {
    let p: mut LspPosition = new LspPosition();
    let i: mut i64 = 0;
    let n: i64 = string_length(text);
    while (i < n) {
        if (string_char_at(text, i) == "\n") {
            p.line = p.line + 1;
            p.character = 0;
        } else {
            p.character = p.character + 1;
        }
        i = i + 1;
    }
    return p;
}

// One formatting atom: either a lexer token or a preserved comment.
class FmtItem {
    line: i64 = 0;
    col: i64 = 0;
    text: string = "";
    is_comment: bool = false;

    fun new(mut this) {}
}

fun make_fmt_item(line: i64, col: i64, text: string, is_comment: bool) -> mut FmtItem {
    let it: mut FmtItem = new FmtItem();
    it.line = line;
    it.col = col;
    it.text = text;
    it.is_comment = is_comment;
    return it;
}

// Comment spans of the raw text (line + block), skipping string literals.
// Positions are in the EP lexer basis (1-based line/col).
fun collect_comments(text: string) -> mut _utils.List<FmtItem> {
    let out: mut _utils.List<FmtItem> = new _utils.List<FmtItem>();
    let n: i64 = string_length(text);
    let i: mut i64 = 0;
    let line: mut i64 = 1;
    let col: mut i64 = 1;
    while (i < n) {
        let c: string = string_char_at(text, i);
        if (c == "\"") {
            i = i + 1;
            col = col + 1;
            while (i < n) {
                let sc: string = string_char_at(text, i);
                if (sc == "\\" && i + 1 < n) {
                    i = i + 2;
                    col = col + 2;
                    continue;
                }
                if (sc == "\n") { line = line + 1; col = 1; } else { col = col + 1; }
                i = i + 1;
                if (sc == "\"") { break; }
            }
            continue;
        }
        if (c == "/" && i + 1 < n && string_char_at(text, i + 1) == "/") {
            let start_col: i64 = col;
            let start_line: i64 = line;
            let sb: mut StringBuilder = new StringBuilder();
            while (i < n && string_char_at(text, i) != "\n") {
                sb.append(string_char_at(text, i));
                i = i + 1;
                col = col + 1;
            }
            out.push(make_fmt_item(start_line, start_col, sb.to_string(), true));
            continue;
        }
        if (c == "/" && i + 1 < n && string_char_at(text, i + 1) == "*") {
            let start_col: i64 = col;
            let start_line: i64 = line;
            let sb: mut StringBuilder = new StringBuilder();
            while (i < n) {
                let bc: string = string_char_at(text, i);
                if (bc == "*" && i + 1 < n && string_char_at(text, i + 1) == "/") {
                    sb.append("*/");
                    i = i + 2;
                    col = col + 2;
                    break;
                }
                sb.append(bc);
                if (bc == "\n") { line = line + 1; col = 1; } else { col = col + 1; }
                i = i + 1;
            }
            out.push(make_fmt_item(start_line, start_col, sb.to_string(), true));
            continue;
        }
        if (c == "\n") { line = line + 1; col = 1; } else { col = col + 1; }
        i = i + 1;
    }
    return out;
}

fun fmt_items_sorted(items: mut _utils.List<FmtItem>) {
    // Insertion sort (formatting inputs are small).
    let n: i64 = cast<i64>(items.size());
    let i: mut i64 = 1;
    while (i < n) {
        let key: mut FmtItem = items.at(cast<u64>(i)).some;
        let j: mut i64 = i - 1;
        while (j >= 0) {
            let a: FmtItem = items.at(cast<u64>(j)).some;
            let before: bool = a.line < key.line || (a.line == key.line && a.col < key.col);
            if (before) { break; }
            items.set(cast<u64>(j + 1), a);
            j = j - 1;
        }
        items.set(cast<u64>(j + 1), key);
        i = i + 1;
    }
}

fun no_space_before(tok: string) -> bool {
    return tok == ";" || tok == "," || tok == ")" || tok == "]" || tok == "}" || tok == ".";
}

fun no_space_after(tok: string) -> bool {
    return tok == "(" || tok == "[" || tok == "." || tok == "#";
}

fun space_before_lparen(prev: string) -> bool {
    // `if (`, `while (`, `for (`, `catch (`, `elif (` keep the space; calls,
    // declarations and casts glue to their argument list.
    return prev == "if" || prev == "while" || prev == "for" || prev == "catch"
        || prev == "elif" || prev == "return" || prev == "wait" || prev == "connect"
        || prev == "emit" || prev == "on";
}

fun format_penguin_text(text: string) -> string {
    // Merge lexer tokens and preserved comments in source order.
    let items: mut _utils.List<FmtItem> = collect_comments(text);
    let mut lexer = new emperor.Lexer(text, "");
    let tokens: _utils.List<emperor.Token> = lexer.tokenize();
    for (let t in tokens) {
        if (t.token_type is emperor.TokenType.EOF) { continue; }
        items.push(make_fmt_item(t.location.line, t.location.col, t.text, false));
    }
    fmt_items_sorted(items);

    let sb: mut StringBuilder = new StringBuilder();
    let depth: mut i64 = 0;
    let paren_depth: mut i64 = 0;
    // Angle-bracket suppression: inside the <...> of cast<T>/unsafe_cast<T>/
    // new Foo<T> no spaces are emitted around < , > (they are TYPE brackets,
    // not comparison operators).
    let angle_depth: mut i64 = 0;
    let after_new: mut bool = false;
    let prev: mut string = "";
    let prev_line: mut i64 = 0;
    let at_line_start: mut bool = true;
    let i: mut i64 = 0;
    while (i < cast<i64>(items.size())) {
        let it: FmtItem = items.at(cast<u64>(i)).some;
        let tok: string = it.text;
        // Comment classification is TEXT-based (the merged stream's only
        // items starting with "//" or "/*" are the preserved comments).
        let is_comment_item: bool = string_find(tok, "//") == 0 || string_find(tok, "/*") == 0;
        let is_line_comment: bool = string_find(tok, "//") == 0;
        // Blank-line preservation: a gap of >= 2 lines between items keeps
        // one blank line (never right after an opening brace).
        if (!at_line_start && prev != "" && it.line >= prev_line + 2 && depth > 0 && prev != "{") {
            sb.append("\n\n");
            at_line_start = true;
        }
        if (tok == "}") {
            depth = depth - 1;
            if (depth < 0) { depth = 0; }
        }
        // Hard newline before a closing brace / a column-0 comment.
        if (!at_line_start && (tok == "}" || (is_comment_item && it.col == 1 && prev != "{" && prev != ""))) {
            sb.append("\n");
            at_line_start = true;
        }
        if (at_line_start) {
            let k: mut i64 = 0;
            while (k < depth) {
                sb.append("    ");
                k = k + 1;
            }
            at_line_start = false;
        } else {
            // Join spacing: glue punctuation and type brackets, space words.
            let space: mut bool = prev != "" && !no_space_before(tok) && !no_space_after(prev);
            if (space && tok == "(" && !space_before_lparen(prev)) { space = false; }
            if (space && tok == "<" && (prev == "cast" || prev == "unsafe_cast" || after_new)) { space = false; }
            if (space && angle_depth > 0 && (tok == "<" || tok == ">" || tok == ",")) { space = false; }
            if (space && prev == "<" && angle_depth > 0) { space = false; }
            if (space && tok == ">" && angle_depth >= 1) { space = false; }
            if (space) { sb.append(" "); }
        }
        sb.append(tok);
        // Angle-bracket bookkeeping AFTER emitting (cast</new Foo< opened one).
        if (angle_depth > 0 && tok == ">") { angle_depth = angle_depth - 1; }
        if (tok == "<" && (prev == "cast" || prev == "unsafe_cast" || after_new)) { angle_depth = angle_depth + 1; }
        if (tok == "new") { after_new = true; } else { after_new = false; }
        // Hard newline after braces / statement semicolons / line comments.
        let force_nl: mut bool = false;
        if (tok == "{") {
            depth = depth + 1;
            force_nl = true;
        } else if (tok == "}") {
            force_nl = true;
        } else if (tok == ";" && paren_depth == 0) {
            force_nl = true;
        } else if (is_line_comment) {
            force_nl = true;
        }
        if (force_nl && i + 1 < cast<i64>(items.size())) {
            sb.append("\n");
            at_line_start = true;
        }
        if (tok == "(") { paren_depth = paren_depth + 1; }
        if (tok == ")") { paren_depth = paren_depth - 1; if (paren_depth < 0) { paren_depth = 0; } }
        prev = tok;
        prev_line = it.line;
        i = i + 1;
    }
    if (!at_line_start) { sb.append("\n"); }
    return sb.to_string();
}

}
