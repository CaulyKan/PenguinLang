// LspQuery: bound-tree queries over the last successful compilation
// (definition / documentSymbol / completion / references / hover / inlayHint /
// rename / formatting). Every query takes an LspDocContext — the document's
// path/text/last-good model plus the prebuilt symbol index — and returns
// TYPED protocol structs (LspProtocol); no JSON is written here.
//
// v1 semantics mirror the C# server's deliberate simplicity (see
// MagellanicPenguin/LSP/LSP.cs): documentSymbol lists THIS document's defs
// (stdlib and other files filtered by location filename; the per-file
// `_ns_*` wrapper namespaces splice their children to the top level);
// definition/hover re-lex the document for the identifier under the cursor
// and look it up in the whole-program index (same-file match preferred — no
// scope resolution); completion returns the language keywords plus every
// indexed symbol, deduplicated by name. references/rename are name-level
// occurrence scans of the requesting document (declarations reported once,
// honoring context.includeDeclaration; rename edits every occurrence).
// inlayHint walks bound bodies for `let` declarations with known types.
// formatting re-emits the token stream lexically (comments preserved from
// the raw text). Enum member symbols carry declaration locations in the
// bound tree, so variants resolve to their own sites.
namespace lsp {

// The query-side view of one open document: everything a query needs,
// decoupled from the LspCompilationUnit actor (its channels, its publish
// duties). The unit snapshots this after every recompile-refreshed state.
class LspDocContext {
    path: string = "";
    text: string = "";
    // Last error-free compilation (queries survive diagnostics).
    last_ok: __builtin.Option<emperor.BoundCompilationUnit> = new __builtin.Option<emperor.BoundCompilationUnit>.none();
    // The symbol index of last_ok (rebuilt whenever last_ok is replaced).
    roots: mut std.Vector<SymEntry> = new std.Vector<SymEntry>();
    flat: mut std.Vector<SymEntry> = new std.Vector<SymEntry>();

    fun new(mut this) {}
}

// ---- documentSymbol ----

// The subtree rooted at `entries` filtered to doc_path: a matching node
// yields itself (name spans its declaration) plus its matching children; a
// non-matching wrapper (namespace, foreign-file root) splices its matching
// descendants through to this level.
fun build_doc_symbols(entries: std.Vector<SymEntry>, doc_path: string) -> mut std.Vector<LspDocumentSymbol> {
    let out: mut std.Vector<LspDocumentSymbol> = new std.Vector<LspDocumentSymbol>();
    for (let e in entries) {
        if (e.filename == doc_path && e.line > 0) {
            let line0: i64 = e.line - 1;
            let char0: i64 = e.col - 1;
            let s: mut LspDocumentSymbol = new LspDocumentSymbol();
            s.name = e.name;
            s.kind = e.kind;
            s.range = make_range(line0, char0, char0 + string_length(e.name));
            s.selectionRange = make_range(line0, char0, char0 + string_length(e.name));
            s.children = build_doc_symbols(e.children, doc_path);
            out.push(s);
        } else {
            let spliced: mut std.Vector<LspDocumentSymbol> = build_doc_symbols(e.children, doc_path);
            let si: mut i64 = 0;
            while (si < cast<i64>(spliced.size())) {
                out.push(spliced.at(cast<u64>(si)).some);
                si = si + 1;
            }
        }
    }
    return out;
}

fun query_document_symbol(ctx: LspDocContext) -> mut std.Vector<LspDocumentSymbol> {
    return build_doc_symbols(ctx.roots, ctx.path);
}

// ---- definition ----

// The identifier token covering the 0-based (line, character) position, or "".
fun identifier_at(text: string, filename: string, line: i64, character: i64) -> string {
    let mut lexer = new emperor.Lexer(text, filename);
    let tokens: _utils.List<emperor.Token> = lexer.tokenize();
    let want_line: i64 = line + 1;
    let want_col: i64 = character + 1;
    for (let t in tokens) {
        if (t.token_type is emperor.TokenType.Identifier) {
            if (t.location.line == want_line) {
                let c0: i64 = t.location.col;
                if (want_col >= c0 && want_col < c0 + string_length(t.text)) {
                    return t.text;
                }
            }
        }
    }
    return "";
}

fun query_definition(ctx: LspDocContext, msg: LspMessage) -> mut std.Vector<LspLocation> {
    let out: mut std.Vector<LspLocation> = new std.Vector<LspLocation>();
    let pos: LspPosition = extract_position(msg.params_json);
    let name: string = identifier_at(ctx.text, ctx.path, pos.line, pos.character);
    if (name == "") { return out; }

    let same_file: mut Option<SymEntry> = new Option<SymEntry>.none();
    let other_file: mut Option<SymEntry> = new Option<SymEntry>.none();
    for (let e in ctx.flat) {
        if (e.name == name && e.line > 0) {
            if (e.filename == ctx.path) {
                if (same_file.is_none()) { same_file = new Option<SymEntry>.some(e); }
            } else {
                if (other_file.is_none()) { other_file = new Option<SymEntry>.some(e); }
            }
        }
    }
    let best: Option<SymEntry> = if (same_file.is_some()) { same_file } else { other_file };
    if (best.is_none()) { return out; }

    let e: SymEntry = best.some;
    let loc: mut LspLocation = new LspLocation();
    loc.uri = path_to_uri(e.filename);
    loc.range = make_range(e.line - 1, e.col - 1, e.col - 1 + string_length(e.name));
    out.push(loc);
    return out;
}

// ---- completion ----

fun keyword_list() -> mut std.Vector<string> {
    let kws: mut std.Vector<string> = new std.Vector<string>();
    kws.push("namespace");
    kws.push("using");
    kws.push("interface");
    kws.push("class");
    kws.push("enum");
    kws.push("impl");
    kws.push("fun");
    kws.push("initial");
    kws.push("extern");
    kws.push("construct");
    kws.push("input");
    kws.push("output");
    kws.push("connect");
    kws.push("event");
    kws.push("emit");
    kws.push("on");
    kws.push("wait");
    kws.push("async");
    kws.push("spawn");
    kws.push("let");
    kws.push("mut");
    kws.push("auto");
    kws.push("type");
    kws.push("template");
    kws.push("export");
    kws.push("new");
    kws.push("cast");
    kws.push("unsafe_cast");
    kws.push("this");
    kws.push("Self");
    kws.push("is");
    kws.push("in");
    kws.push("for");
    kws.push("if");
    kws.push("else");
    kws.push("elif");
    kws.push("while");
    kws.push("return");
    kws.push("break");
    kws.push("continue");
    kws.push("try");
    kws.push("catch");
    kws.push("yield");
    kws.push("true");
    kws.push("false");
    kws.push("void");
    kws.push("bool");
    kws.push("char");
    kws.push("i8");
    kws.push("i16");
    kws.push("i32");
    kws.push("i64");
    kws.push("u8");
    kws.push("u16");
    kws.push("u32");
    kws.push("u64");
    kws.push("float");
    kws.push("double");
    kws.push("string");
    return kws;
}

fun query_completion(ctx: LspDocContext, msg: LspMessage) -> mut std.Vector<LspCompletionItem> {
    let out: mut std.Vector<LspCompletionItem> = new std.Vector<LspCompletionItem>();
    let kws: mut std.Vector<string> = keyword_list();
    for (let kw in kws) {
        let it: mut LspCompletionItem = new LspCompletionItem();
        it.label = kw;
        it.kind = CIK_KEYWORD;
        out.push(it);
    }
    if (ctx.last_ok.is_some()) {
        let seen: mut std.HashMap<string, bool> = new std.HashMap<string, bool>();
        for (let e in ctx.flat) {
            // Namespaces carry no location; qualify by name instead.
            if (e.kind == SYM_NAMESPACE) { continue; }
            if (e.name == "" || string_find(e.name, "<") == 0) { continue; }
            if (seen.contains(e.name)) { continue; }
            seen.put(e.name, true);
            let it: mut LspCompletionItem = new LspCompletionItem();
            it.label = e.name;
            it.kind = e.cik;
            out.push(it);
        }
    }
    return out;
}

// ---- hover ----

// The whole-program index flattened, same-file matches first (the v1
// name-level resolution order shared by definition/hover/references).
fun lookup_entries(ctx: LspDocContext, name: string) -> mut std.Vector<SymEntry> {
    let matches: mut std.Vector<SymEntry> = new std.Vector<SymEntry>();
    let same: mut std.Vector<SymEntry> = new std.Vector<SymEntry>();
    let other: mut std.Vector<SymEntry> = new std.Vector<SymEntry>();
    for (let e in ctx.flat) {
        if (e.name == name && e.line > 0) {
            if (e.filename == ctx.path) { same.push(e); } else { other.push(e); }
        }
    }
    for (let e in same) { matches.push(e); }
    for (let e in other) { matches.push(e); }
    return matches;
}

fun query_hover(ctx: LspDocContext, msg: LspMessage) -> __builtin.Option<LspHover> {
    let pos: LspPosition = extract_position(msg.params_json);
    let name: string = identifier_at(ctx.text, ctx.path, pos.line, pos.character);
    if (name == "") { return new __builtin.Option<LspHover>.none(); }
    let matches: mut std.Vector<SymEntry> = lookup_entries(ctx, name);
    if (matches.size() == 0) { return new __builtin.Option<LspHover>.none(); }
    let e: SymEntry = matches.at(cast<u64>(0)).some;
    let text: string = if (e.detail == "") { e.name } else { e.detail };
    let h: mut LspHover = new LspHover();
    h.contents.kind = "markdown";
    h.contents.value = "```penguin\n" + text + "\n```";
    h.range = make_range(e.line - 1, e.col - 1, e.col - 1 + string_length(e.name));
    return new __builtin.Option<LspHover>.some(h);
}

// ---- references ----

// All identifier tokens in the document with the given text (the v1
// name-level use sites; cross-file references need the other documents'
// texts, which only opened units have — v1 scans the requesting document).
fun occurrences_in_doc(ctx: LspDocContext, name: string) -> mut std.Vector<emperor.Token> {
    let hits: mut std.Vector<emperor.Token> = new std.Vector<emperor.Token>();
    let mut lexer = new emperor.Lexer(ctx.text, ctx.path);
    let tokens: _utils.List<emperor.Token> = lexer.tokenize();
    for (let t in tokens) {
        if (t.token_type is emperor.TokenType.Identifier) {
            if (t.text == name) {
                hits.push(t);
            }
        }
    }
    return hits;
}

fun query_references(ctx: LspDocContext, msg: LspMessage) -> mut std.Vector<LspLocation> {
    let out: mut std.Vector<LspLocation> = new std.Vector<LspLocation>();
    let pos: LspPosition = extract_position(msg.params_json);
    let name: string = identifier_at(ctx.text, ctx.path, pos.line, pos.character);
    if (name == "") { return out; }
    let include_decl: bool = json_get_bool_at(msg.params_json, "context", "includeDeclaration");
    let hits: mut std.Vector<emperor.Token> = occurrences_in_doc(ctx, name);
    let seen_decl: mut bool = false;
    for (let t in hits) {
        let is_decl: bool = t.location.line > 0 && is_declaration_site(ctx, name, t.location.line, t.location.col);
        if (is_decl) {
            if (seen_decl || !include_decl) { continue; }
            seen_decl = true;
        }
        let loc: mut LspLocation = new LspLocation();
        loc.uri = path_to_uri(ctx.path);
        loc.range = make_range(t.location.line - 1, t.location.col - 1, t.location.col - 1 + string_length(name));
        out.push(loc);
    }
    return out;
}

// Does an identifier occurrence coincide with the DECLARATION site of a
// same-named symbol (per the index)? Declarations are reported once.
fun is_declaration_site(ctx: LspDocContext, name: string, line: i64, col: i64) -> bool {
    let matches: mut std.Vector<SymEntry> = lookup_entries(ctx, name);
    for (let e in matches) {
        if (e.filename == ctx.path && e.line == line && e.col == col) {
            return true;
        }
    }
    return false;
}

// ---- rename ----

// v1 renames the identifier's every occurrence in the requesting document
// (name-level, not scope-precise) via a single-document WorkspaceEdit.
fun query_rename(ctx: LspDocContext, msg: LspMessage) -> __builtin.Option<LspWorkspaceEdit> {
    let pos: LspPosition = extract_position(msg.params_json);
    let name: string = identifier_at(ctx.text, ctx.path, pos.line, pos.character);
    if (name == "") { return new __builtin.Option<LspWorkspaceEdit>.none(); }
    let new_name: string = json_get_string(std.parse_json(msg.params_json), "newName");
    if (new_name == "") { return new __builtin.Option<LspWorkspaceEdit>.none(); }
    let edits: mut std.Vector<LspTextEdit> = new std.Vector<LspTextEdit>();
    let hits: mut std.Vector<emperor.Token> = occurrences_in_doc(ctx, name);
    for (let t in hits) {
        let te: mut LspTextEdit = new LspTextEdit();
        te.range = make_range(t.location.line - 1, t.location.col - 1, t.location.col - 1 + string_length(name));
        te.newText = new_name;
        edits.push(te);
    }
    let we: mut LspWorkspaceEdit = new LspWorkspaceEdit();
    we.changes.put(path_to_uri(ctx.path), edits);
    return new __builtin.Option<LspWorkspaceEdit>.some(we);
}

// ---- inlay hints ----

// Collect `let` declarations of THIS document whose bound type is known,
// walking function/method/ctor/initial bodies recursively through nested
// blocks and if/while/lambda expressions. Hints are `: T` labels (kind 1 =
// Type) placed right after the variable name.
fun collect_let_hints(defs: _utils.List<emperor.BoundDefinition>, doc_path: string, lo: i64, hi: i64, out: mut std.Vector<SymEntry>) {
    for (let def in defs) {
        if (def is emperor.BoundDefinition.namespace_def) {
            collect_let_hints(def.namespace_def.children, doc_path, lo, hi, out);
        }
        if (def is emperor.BoundDefinition.class_def) {
            let cd: emperor.BoundClassDefinition = def.class_def;
            for (let md in cd.methods) { collect_fn_hints(md, doc_path, lo, hi, out); }
            for (let cd2 in cd.constructors) { collect_fn_hints(cd2, doc_path, lo, hi, out); }
        }
        if (def is emperor.BoundDefinition.enum_def) {
            let ed: emperor.BoundEnumDefinition = def.enum_def;
            for (let md in ed.methods) { collect_fn_hints(md, doc_path, lo, hi, out); }
        }
        if (def is emperor.BoundDefinition.interface_def) {
            let id: emperor.BoundInterfaceDefinition = def.interface_def;
            for (let md in id.methods) { collect_fn_hints(md, doc_path, lo, hi, out); }
        }
        if (def is emperor.BoundDefinition.function_def) {
            collect_fn_hints(def, doc_path, lo, hi, out);
        }
        if (def is emperor.BoundDefinition.initial_routine) {
            collect_initial_hints(def, doc_path, lo, hi, out);
        }
    }
}

fun collect_initial_hints(def: emperor.BoundDefinition, doc_path: string, lo: i64, hi: i64, out: mut std.Vector<SymEntry>) {
    if (def is emperor.BoundDefinition.initial_routine) {
        let ir: emperor.BoundInitialRoutineDefinition = def.initial_routine;
        if (ir.body.is_some()) {
            walk_hints_expr(ir.body.some, doc_path, lo, hi, out);
        }
    }
}

fun collect_fn_hints(def: emperor.BoundDefinition, doc_path: string, lo: i64, hi: i64, out: mut std.Vector<SymEntry>) {
    if (def is emperor.BoundDefinition.function_def) {
        let fd: emperor.BoundFunctionDefinition = def.function_def;
        if (fd.is_specialized) { return; }
        if (fd.body.is_some()) {
            walk_hints_expr(fd.body.some, doc_path, lo, hi, out);
        }
    }
}

fun push_hint(unit_loc: emperor.SourceLocation, sym: emperor.BoundVariableSymbol, doc_path: string, lo: i64, hi: i64, out: mut std.Vector<SymEntry>) {
    if (unit_loc.filename != doc_path) { return; }
    let line0: i64 = unit_loc.line - 1;
    if (line0 < lo || line0 > hi) { return; }
    let e: mut SymEntry = new SymEntry();
    e.name = sym.name;
    e.filename = unit_loc.filename;
    e.line = unit_loc.line;
    e.col = unit_loc.col;
    e.detail = sym.bound_type.display_name();
    out.push(e);
}

fun walk_hints_expr(e: emperor.BoundExpression, doc_path: string, lo: i64, hi: i64, out: mut std.Vector<SymEntry>) {
    if (e is emperor.BoundExpression.code_block) {
        walk_hints_stmts(e.code_block.statements, doc_path, lo, hi, out);
        if (e.code_block.trailing_expr.is_some()) {
            walk_hints_expr(e.code_block.trailing_expr.some, doc_path, lo, hi, out);
        }
        return;
    }
    if (e is emperor.BoundExpression.if_expr) {
        if (e.if_expr.then_block.is_some()) { walk_hints_expr(e.if_expr.then_block.some, doc_path, lo, hi, out); }
        if (e.if_expr.else_block.is_some()) { walk_hints_expr(e.if_expr.else_block.some, doc_path, lo, hi, out); }
        return;
    }
    if (e is emperor.BoundExpression.while_expr) {
        if (e.while_expr.body.is_some()) { walk_hints_expr(e.while_expr.body.some, doc_path, lo, hi, out); }
        return;
    }
    if (e is emperor.BoundExpression.lambda_expr) {
        if (e.lambda_expr.body.is_some()) { walk_hints_expr(e.lambda_expr.body.some, doc_path, lo, hi, out); }
        return;
    }
}

fun walk_hints_stmts(stmts: _utils.List<emperor.BoundStatement>, doc_path: string, lo: i64, hi: i64, out: mut std.Vector<SymEntry>) {
    for (let s in stmts) {
        if (s is emperor.BoundStatement.let_decl) {
            let ld: emperor.BoundLetDeclarationStatement = s.let_decl;
            if (ld.variable_symbol.is_some()) {
                push_hint(ld.location, ld.variable_symbol.some, doc_path, lo, hi, out);
            }
        }
        if (s is emperor.BoundStatement.expression) {
            if (s.expression.expression.is_some()) {
                walk_hints_expr(s.expression.expression.some, doc_path, lo, hi, out);
            }
        }
        if (s is emperor.BoundStatement.block) {
            walk_hints_stmts(s.block.statements, doc_path, lo, hi, out);
        }
    }
}

// null (no model yet) vs [] (model, no hints in range) are different wire
// answers — hence the Option wrapper.
fun query_inlay_hints(ctx: LspDocContext, msg: LspMessage) -> __builtin.Option<std.Vector<LspInlayHint>> {
    if (ctx.last_ok.is_none()) { return new __builtin.Option<std.Vector<LspInlayHint>>.none(); }
    let rng: LspRangeParams = extract_range(msg.params_json);
    let carriers: mut std.Vector<SymEntry> = new std.Vector<SymEntry>();
    collect_let_hints(ctx.last_ok.some.definitions, ctx.path, rng.start_line, rng.end_line, carriers);
    let out: mut std.Vector<LspInlayHint> = new std.Vector<LspInlayHint>();
    for (let h in carriers) {
        let hint: mut LspInlayHint = new LspInlayHint();
        hint.position = make_position(h.line - 1, h.col - 1 + string_length(h.name));
        hint.label = ": " + h.detail;
        hint.kind = 1;
        out.push(hint);
    }
    return new __builtin.Option<std.Vector<LspInlayHint>>.some(out);
}

// ---- formatting ----

// A whole-document formatter that is lexically faithful: it re-emits the
// token stream with normalized spacing/indentation and preserves comments
// (pre-scanned from the raw text — the lexer drops them) in source order.
fun query_formatting(ctx: LspDocContext, msg: LspMessage) -> mut std.Vector<LspTextEdit> {
    let out: mut std.Vector<LspTextEdit> = new std.Vector<LspTextEdit>();
    let te: mut LspTextEdit = new LspTextEdit();
    te.range = make_range(0, 0, 0);
    te.range.end = end_position(ctx.text);
    te.newText = format_penguin_text(ctx.text);
    out.push(te);
    return out;
}

// The 0-based position just past the last character (0,0 for empty text).
fun end_position(text: string) -> mut LspPosition {
    let p: mut LspPosition = new LspPosition();
    let i: mut i64 = 0;
    let n: i64 = string_length(text);
    while (i < n) {
        if (string_char_at(text, i) == "\n") {
            p.line = p.line + 1;
            p.character = 0;
        } else {
            p.character = p.character + 1;
        }
        i = i + 1;
    }
    return p;
}

// One formatting atom: either a lexer token or a preserved comment.
class FmtItem {
    line: i64 = 0;
    col: i64 = 0;
    text: string = "";
    is_comment: bool = false;

    fun new(mut this) {}
}

fun make_fmt_item(line: i64, col: i64, text: string, is_comment: bool) -> mut FmtItem {
    let it: mut FmtItem = new FmtItem();
    it.line = line;
    it.col = col;
    it.text = text;
    it.is_comment = is_comment;
    return it;
}

// Comment spans of the raw text (line + block), skipping string literals.
// Positions are in the EP lexer basis (1-based line/col).
fun collect_comments(text: string) -> mut std.Vector<FmtItem> {
    let out: mut std.Vector<FmtItem> = new std.Vector<FmtItem>();
    let n: i64 = string_length(text);
    let i: mut i64 = 0;
    let line: mut i64 = 1;
    let col: mut i64 = 1;
    while (i < n) {
        let c: string = string_char_at(text, i);
        if (c == "\"") {
            i = i + 1;
            col = col + 1;
            while (i < n) {
                let sc: string = string_char_at(text, i);
                if (sc == "\\" && i + 1 < n) {
                    i = i + 2;
                    col = col + 2;
                    continue;
                }
                if (sc == "\n") { line = line + 1; col = 1; } else { col = col + 1; }
                i = i + 1;
                if (sc == "\"") { break; }
            }
            continue;
        }
        if (c == "/" && i + 1 < n && string_char_at(text, i + 1) == "/") {
            let start_col: i64 = col;
            let start_line: i64 = line;
            let sb: mut StringBuilder = new StringBuilder();
            while (i < n && string_char_at(text, i) != "\n") {
                sb.append(string_char_at(text, i));
                i = i + 1;
                col = col + 1;
            }
            out.push(make_fmt_item(start_line, start_col, sb.to_string(), true));
            continue;
        }
        if (c == "/" && i + 1 < n && string_char_at(text, i + 1) == "*") {
            let start_col: i64 = col;
            let start_line: i64 = line;
            let sb: mut StringBuilder = new StringBuilder();
            while (i < n) {
                let bc: string = string_char_at(text, i);
                if (bc == "*" && i + 1 < n && string_char_at(text, i + 1) == "/") {
                    sb.append("*/");
                    i = i + 2;
                    col = col + 2;
                    break;
                }
                sb.append(bc);
                if (bc == "\n") { line = line + 1; col = 1; } else { col = col + 1; }
                i = i + 1;
            }
            out.push(make_fmt_item(start_line, start_col, sb.to_string(), true));
            continue;
        }
        if (c == "\n") { line = line + 1; col = 1; } else { col = col + 1; }
        i = i + 1;
    }
    return out;
}

fun fmt_items_sorted(items: mut std.Vector<FmtItem>) {
    // Insertion sort (formatting inputs are small).
    let n: i64 = cast<i64>(items.size());
    let i: mut i64 = 1;
    while (i < n) {
        let key: mut FmtItem = items.at(cast<u64>(i)).some;
        let j: mut i64 = i - 1;
        while (j >= 0) {
            let a: FmtItem = items.at(cast<u64>(j)).some;
            let before: bool = a.line < key.line || (a.line == key.line && a.col < key.col);
            if (before) { break; }
            items.set(cast<u64>(j + 1), a);
            j = j - 1;
        }
        items.set(cast<u64>(j + 1), key);
        i = i + 1;
    }
}

fun no_space_before(tok: string) -> bool {
    return tok == ";" || tok == "," || tok == ")" || tok == "]" || tok == "}" || tok == ".";
}

fun no_space_after(tok: string) -> bool {
    return tok == "(" || tok == "[" || tok == "." || tok == "#";
}

fun space_before_lparen(prev: string) -> bool {
    // `if (`, `while (`, `for (`, `catch (`, `elif (` keep the space; calls,
    // declarations and casts glue to their argument list.
    return prev == "if" || prev == "while" || prev == "for" || prev == "catch"
        || prev == "elif" || prev == "return" || prev == "wait" || prev == "connect"
        || prev == "emit" || prev == "on";
}

fun format_penguin_text(text: string) -> string {
    // Merge lexer tokens and preserved comments in source order.
    let items: mut std.Vector<FmtItem> = collect_comments(text);
    let mut lexer = new emperor.Lexer(text, "");
    let tokens: _utils.List<emperor.Token> = lexer.tokenize();
    for (let t in tokens) {
        if (t.token_type is emperor.TokenType.EOF) { continue; }
        items.push(make_fmt_item(t.location.line, t.location.col, t.text, false));
    }
    fmt_items_sorted(items);

    let sb: mut StringBuilder = new StringBuilder();
    let depth: mut i64 = 0;
    let paren_depth: mut i64 = 0;
    // Angle-bracket suppression: inside the <...> of cast<T>/unsafe_cast<T>/
    // new Foo<T> no spaces are emitted around < , > (they are TYPE brackets,
    // not comparison operators).
    let angle_depth: mut i64 = 0;
    let after_new: mut bool = false;
    let prev: mut string = "";
    let prev_line: mut i64 = 0;
    let at_line_start: mut bool = true;
    let i: mut i64 = 0;
    while (i < cast<i64>(items.size())) {
        let it: FmtItem = items.at(cast<u64>(i)).some;
        let tok: string = it.text;
        // Comment classification is TEXT-based (the merged stream's only
        // items starting with "//" or "/*" are the preserved comments).
        let is_comment_item: bool = string_find(tok, "//") == 0 || string_find(tok, "/*") == 0;
        let is_line_comment: bool = string_find(tok, "//") == 0;
        // Blank-line preservation: a gap of >= 2 lines between items keeps
        // one blank line (never right after an opening brace).
        if (!at_line_start && prev != "" && it.line >= prev_line + 2 && depth > 0 && prev != "{") {
            sb.append("\n\n");
            at_line_start = true;
        }
        if (tok == "}") {
            depth = depth - 1;
            if (depth < 0) { depth = 0; }
        }
        // Hard newline before a closing brace / a column-0 comment.
        if (!at_line_start && (tok == "}" || (is_comment_item && it.col == 1 && prev != "{" && prev != ""))) {
            sb.append("\n");
            at_line_start = true;
        }
        if (at_line_start) {
            let k: mut i64 = 0;
            while (k < depth) {
                sb.append("    ");
                k = k + 1;
            }
            at_line_start = false;
        } else {
            // Join spacing: glue punctuation and type brackets, space words.
            let space: mut bool = prev != "" && !no_space_before(tok) && !no_space_after(prev);
            if (space && tok == "(" && !space_before_lparen(prev)) { space = false; }
            if (space && tok == "<" && (prev == "cast" || prev == "unsafe_cast" || after_new)) { space = false; }
            if (space && angle_depth > 0 && (tok == "<" || tok == ">" || tok == ",")) { space = false; }
            if (space && prev == "<" && angle_depth > 0) { space = false; }
            if (space && tok == ">" && angle_depth >= 1) { space = false; }
            if (space) { sb.append(" "); }
        }
        sb.append(tok);
        // Angle-bracket bookkeeping AFTER emitting (cast</new Foo< opened one).
        if (angle_depth > 0 && tok == ">") { angle_depth = angle_depth - 1; }
        if (tok == "<" && (prev == "cast" || prev == "unsafe_cast" || after_new)) { angle_depth = angle_depth + 1; }
        if (tok == "new") { after_new = true; } else { after_new = false; }
        // Hard newline after braces / statement semicolons / line comments.
        let force_nl: mut bool = false;
        if (tok == "{") {
            depth = depth + 1;
            force_nl = true;
        } else if (tok == "}") {
            force_nl = true;
        } else if (tok == ";" && paren_depth == 0) {
            force_nl = true;
        } else if (is_line_comment) {
            force_nl = true;
        }
        if (force_nl && i + 1 < cast<i64>(items.size())) {
            sb.append("\n");
            at_line_start = true;
        }
        if (tok == "(") { paren_depth = paren_depth + 1; }
        if (tok == ")") { paren_depth = paren_depth - 1; if (paren_depth < 0) { paren_depth = 0; } }
        prev = tok;
        prev_line = it.line;
        i = i + 1;
    }
    if (!at_line_start) { sb.append("\n"); }
    return sb.to_string();
}

}
