[Project]
# Windows (win64 cross) build of the PenguinLang-native LSP server: a
# MONOLITH of the LSP modules + the whole EmperorPenguin compiler (the
# EmperorPenguinLib source set = EmperorPenguinFull minus main.penguin).
# The Linux build (LspServer.penguins) instead links the prebuilt shared
# library libemperorpenguin.penguin-lib, but that dyn-lib mechanism relies on
# ELF specifics (SONAME + $ORIGIN rpath + -rdynamic interposition), so the
# Windows port compiles everything into one self-contained exe. Build
# (see ./penguin -lsp -win):
#   CC=.../x86_64-w64-mingw32-clang CLANG=.../x86_64-w64-mingw32-clang \
#   tmp/pass4 MagellanicPenguin/LspServer/LspServerWin.penguins \
#       --enable-coroutine -o tmp/win64-lsp/MagellanicPenguinLSP.exe -target=win64
# The entry point is the LSP modules' own top-level construct/initial
# (LspWiring.penguin) — no main.penguin. Same source-set rules as
# EmperorPenguinFull.penguins: native parser only (pass2+), never BabyPenguin.
# Windows coroutines & stdio event sources come from the runtime's fiber
# scheduler + PeekNamedPipe fd integration (EmperorPenguin/std/c/scheduler.c).
name="LspServerWin"
sources=["../../EmperorPenguin/src/ast/AST.penguin", "../../EmperorPenguin/src/ast/Lexer.penguin", "../../EmperorPenguin/src/ast/Parser.penguin", "../../EmperorPenguin/src/ast/SourceLocation.penguin", "../../EmperorPenguin/src/ast/Token.penguin", "../../EmperorPenguin/src/bound/BoundCompilationUnit.penguin", "../../EmperorPenguin/src/bound/BoundDefinition.penguin", "../../EmperorPenguin/src/bound/BoundExpression.penguin", "../../EmperorPenguin/src/bound/BoundScope.penguin", "../../EmperorPenguin/src/bound/BoundStatement.penguin", "../../EmperorPenguin/src/bound/BoundSymbol.penguin", "../../EmperorPenguin/src/bound/BoundTreePrinter.penguin", "../../EmperorPenguin/src/bound/BoundType.penguin", "../../EmperorPenguin/src/bound/BoundTypeRegistry.penguin", "../../EmperorPenguin/src/bound/EmperorPenguinCompiler.penguin", "../../EmperorPenguin/src/bound/SemanticModel.penguin", "../../EmperorPenguin/src/bound/SemanticShared.penguin", "../../EmperorPenguin/src/bound/SemanticMetaRewrite.penguin", "../../EmperorPenguin/src/bound/SemanticBuildScopes.penguin", "../../EmperorPenguin/src/bound/SemanticMonomorphize.penguin", "../../EmperorPenguin/src/bound/SemanticResolveTypes.penguin", "../../EmperorPenguin/src/bound/SemanticBindSymbols.penguin", "../../EmperorPenguin/src/bound/SemanticConstructors.penguin", "../../EmperorPenguin/src/bound/SemanticInterfaces.penguin", "../../EmperorPenguin/src/bound/SemanticClassifyValueTypes.penguin", "../../EmperorPenguin/src/bound/SemanticBindBodies.penguin", "../../EmperorPenguin/src/bound/SemanticBindExpressions.penguin", "../../EmperorPenguin/src/bound/SemanticBindMetaCalls.penguin", "../../EmperorPenguin/src/bound/SemanticValidateControlFlow.penguin", "../../EmperorPenguin/src/ir/IRBuilder.penguin", "../../EmperorPenguin/src/ir/IRFunction.penguin", "../../EmperorPenguin/src/ir/IRGenerator.penguin", "../../EmperorPenguin/src/ir/IRInstruction.penguin", "../../EmperorPenguin/src/ir/IRModule.penguin", "../../EmperorPenguin/src/ir/IRPrinter.pengu