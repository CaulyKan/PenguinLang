// LspCompilationUnit: the per-document module (design doc's dynamic half).
// Created by LspMain on didOpen (runtime `new` — module-as-actor), wired
// through its OWN Fifo (cmds: LspMain routes document traffic in; a plain
// class-field channel so its generic instantiation is collected by the
// pass-3 monomorphize fixpoint) and publishes through its OWN results
// OUTPUT PORT — LspMain attaches that port's hub into JsonOutputParser's
// fan-in at creation (see StdioStream.penguin's note on port payload
// restrictions).
//
// Compilation reuses the embedded EmperorPenguin compiler
// (EmperorPenguinCompiler.compile_sources) on every didOpen/didChange — the
// same full-recompile model as the C# LSP — with stdlib (core_builtin +
// io + scheduler) injected first and enable_coroutine on (documents may use
// ports; the scheduler/concurrency stdlib loads only under that flag).
// Diagnostics of the last compile are published through LspDiagnostics (the
// single typed pipeline); queries run against the last error-free unit
// (LastSuccessModel pattern) via a snapshot LspDocContext whose symbol index
// is rebuilt whenever that unit is replaced, so no query re-indexes.
namespace lsp {

let STDLIB_CORE: string = load_stdlib_text("core_builtin.penguin");
let STDLIB_IO: string = load_stdlib_text("io.penguin");
// The concurrency stdlib: documents compile with enable_coroutine on (they
// may use ports/wait/channels), so the scheduler surface must be injected
// too — the compiler auto-loads it ONLY under --enable-coroutine (main.penguin).
let STDLIB_SCHED: string = load_stdlib_text("scheduler.penguin");

// Stdlib sources for document compiles, located once at startup: cwd first
// (dev/test run from the repo root), then exe-relative candidates — a direct
// sibling layout AND an upward walk from the exe dir (up to 12 parents), so
// the server still finds the repo when launched from a nested workdir (the
// test runner copies the exe into build/testruns/<ts>/prebuilt/... ) or from
// vscode/server/<platform>/ inside a deployed extension.
fun load_stdlib_text(name: string) -> string {
    let candidates: mut std.Vector<string> = new std.Vector<string>();
    candidates.push("EmperorPenguin/std/penguin/" + name);
    let exe_dir: string = emperor.compiler_exe_dir();
    candidates.push(exe_dir + "/EmperorPenguin/std/penguin/" + name);
    // Walk parents of the exe dir: <parent>/EmperorPenguin/std/penguin/<name>.
    let dir: mut string = exe_dir;
    let hops: mut i64 = 0;
    while (hops < 12) {
        let last_slash: mut i64 = -1;
        let pos: mut i64 = string_find(dir, "/");
        while (pos >= 0) {
            last_slash = pos;
            pos = string_find_from(dir, "/", pos + 1);
        }
        if (last_slash <= 0) { break; }
        dir = string_substring(dir, 0, last_slash);
        candidates.push(dir + "/EmperorPenguin/std/penguin/" + name);
        hops = hops + 1;
    }
    let i: mut i64 = 0;
    while (i < cast<i64>(candidates.size())) {
        let path: string = candidates.at(cast<u64>(i)).some;
        if (std.io.exists(path)) {
            let text: __builtin.Option<string> = std.io.read_text(path);
            if (text.is_some()) {
                return text.some;
            }
        }
        i = i + 1;
    }
    return "";
}

class LspCompilationUnit {
    impl __builtin.IReferenceType;

    uri: string = "";
    path: string = "";
    text: mut string = "";
    output results : LspOutMsg;
    cmds: mut __builtin.Fifo<LspMessage> = new __builtin.Fifo<LspMessage>(64, new __builtin.FifoPolicy.backpressure());
    // Last error-free compilation result (queries survive diagnostics).
    last_ok: mut __builtin.Option<emperor.BoundCompilationUnit> = new __builtin.Option<emperor.BoundCompilationUnit>.none();
    // The symbol index of last_ok — rebuilt when last_ok is replaced; the
    // per-query snapshot (LspDocContext) carries these by reference.
    index_roots: mut std.Vector<SymEntry> = new std.Vector<SymEntry>();
    index_flat: mut std.Vector<SymEntry> = new std.Vector<SymEntry>();
    // Path → in-memory text of every OTHER currently opened document (the
    // LspMain-owned snapshot, flushed at every forwarded didChange / at
    // construction — project-mode recompiles use it so sibling documents of
    // the same project analyze the EDITOR's text, not the disk's).
    open_texts: mut std.HashMap<string, string> = new std.HashMap<string, string>();
    // Workspace routing config (config hit > .penguins search > single file).
    config: mut LspWorkspaceConfig = new LspWorkspaceConfig();

    fun new(mut this, uri: string, text: string, open_texts: std.HashMap<string, string>, config: LspWorkspaceConfig) {
        this.uri = uri;
        this.path = uri_to_path(uri);
        this.text = text;
        this.open_texts = open_texts;
        this.config = config;
        this.recompile();
    }

    // Full recompile. Single-file mode (no project file above the document):
    // stdlib + this document's in-memory text (the doc's path is the
    // SourceInput filename so diagnostics carry real locations). Project
    // mode (a *.penguins found upward, see LspProject): stdlib + project
    // libs + the project's files, every opened sibling contributing its
    // editor text; diagnostics filter to THIS document (other files' errors
    // no longer land on this uri).
    // The embedded compile is guarded: a broken document can panic the
    // compiler (E_INTERNAL → RuntimeError, sjlj-catchable) — the catch
    // publishes the panic as a diagnostic, keeps last_ok at the previous
    // error-free unit (queries keep working), and the server SURVIVES
    // (previously the panic killed the whole process and every later
    // request went unanswered). Note: the result lives INSIDE the try — no
    // fallback BoundCompilationUnit is ever constructed (its default
    // ctor's field-default chain is unexercised by the compiler itself and
    // crashes; compile_sources either returns a real unit or throws).
    fun recompile(mut this) {
        let plan: mut LspCompilePlan = plan_for_document_routed(this.path, this.config);
        let inputs: mut _utils.List<emperor.SourceInput> = new _utils.List<emperor.SourceInput>();
        // "" = publish every error (single-file mode, the historical
        // behavior); a path = project mode, publish only this doc's errors.
        let filter_path: mut string = "";

        let compiler: mut emperor.EmperorPenguinCompiler = new emperor.EmperorPenguinCompiler();
        // Documents may use ports/wait/channels — the analysis is a superset
        // with the flag on, so it stays on in both modes.
        compiler.enable_coroutine = true;

        if (plan.project_path == "") {
            inputs.push(new emperor.SourceInput("core_builtin.penguin", STDLIB_CORE));
            inputs.push(new emperor.SourceInput("io.penguin", STDLIB_IO));
            inputs.push(new emperor.SourceInput("scheduler.penguin", STDLIB_SCHED));
            inputs.push(new emperor.SourceInput(this.path, this.text));
        } else {
            inputs = project_source_inputs(plan, this.path, this.text, this.open_texts);
            filter_path = this.path;
            compiler.verbose = plan.verbose;
            let di: mut i64 = 0;
            while (di < cast<i64>(plan.define_keys.size())) {
                compiler.cli_define_keys.push(plan.define_keys.at(cast<u64>(di)).some);
                compiler.cli_define_values.push(plan.define_values.at(cast<u64>(di)).some);
                di = di + 1;
            }
            let state_opt: __builtin.Option<emperor.LibLoadState> = lib_state_for(plan);
            if (state_opt.is_some()) {
                let st: emperor.LibLoadState = state_opt.some;
                if (!st.has_error) {
                    let ii: mut i64 = 0;
                    while (ii < cast<i64>(st.instances.size())) {
                        compiler.lib_instances.push(st.instances.at(cast<u64>(ii)).some);
                        ii = ii + 1;
                    }
                }
            }
        }

        let crash_message: mut string = "";
        try {
            let result: emperor.BoundCompilationUnit = compiler.compile_sources(inputs);
            if (!result.has_errors()) {
                this.last_ok = new __builtin.Option<emperor.BoundCompilationUnit>.some(result);
                this.index_roots = new std.Vector<SymEntry>();
                index_defs(result.definitions, this.index_roots);
                this.index_flat = new std.Vector<SymEntry>();
                flat_collect(this.index_roots, this.index_flat);
            }
            this.publish_diagnostics(error_diagnostics(result.errors, filter_path));
        } catch (e) {
            crash_message = e.message;
        }
        if (string_length(crash_message) > 0) {
            this.publish_diagnostics(crash_diagnostics(crash_message));
        }
    }

    // The query-side snapshot: path/text/last_ok plus the prebuilt index.
    fun make_context(mut this) -> mut LspDocContext {
        let ctx: mut LspDocContext = new LspDocContext();
        ctx.path = this.path;
        ctx.text = this.text;
        ctx.last_ok = this.last_ok;
        ctx.roots = this.index_roots;
        ctx.flat = this.index_flat;
        return ctx;
    }

    fun publish_diagnostics(mut this, diags: std.Vector<LspDiagnostic>) {
        this.send_diagnostics(diagnostics_params_json(this.uri, diags));
    }

    fun send_diagnostics(mut this, params_json: string) {
        let n: mut LspNotification = new LspNotification();
        n.method = "textDocument/publishDiagnostics";
        n.params_json = params_json;
        this.results.write(new LspOutMsg.out_notification(n));
    }

    fun respond_result(mut this, msg: LspMessage, result_json: string) {
        let r: mut LspResponse = response_for(msg);
        r.result_json = result_json;
        this.results.write(new LspOutMsg.out_response(r));
    }

    fun respond_error(mut this, msg: LspMessage, code: i64, message: string) {
        this.results.write(new LspOutMsg.out_error(error_for(msg, code, message)));
    }

    initial {
        while (true) {
            let msg: LspMessage = wait this.cmds;
            if (msg.method == "textDocument/didChange") {
                let t: string = extract_change_text(msg.params_json);
                if (string_length(t) > 0) {
                    this.text = t;
                    this.recompile();
                }
            } else if (msg.method == "textDocument/didClose") {
                // Protocol-driven retirement: the loop ends, the module's
                // channels go quiet, and the GC may reclaim the instance
                // once nothing references it (Close command → break).
                break;
            } else if (msg.method == "textDocument/definition") {
                this.respond_result(msg, locations_to_json(query_definition(this.make_context(), msg)));
            } else if (msg.method == "textDocument/documentSymbol") {
                this.respond_result(msg, symbols_to_json(query_document_symbol(this.make_context())));
            } else if (msg.method == "textDocument/completion") {
                this.respond_result(msg, completion_items_to_json(query_completion(this.make_context(), msg)));
            } else if (msg.method == "textDocument/references") {
                this.respond_result(msg, locations_to_json(query_references(this.make_context(), msg)));
            } else if (msg.method == "textDocument/hover") {
                let h: __builtin.Option<LspHover> = query_hover(this.make_context(), msg);
                if (h.is_some()) {
                    this.respond_result(msg, h.some.json_serialize());
                } else {
                    this.respond_result(msg, "null");
                }
            } else if (msg.method == "textDocument/inlayHint") {
                let hints: __builtin.Option<std.Vector<LspInlayHint>> = query_inlay_hints(this.make_context(), msg);
                if (hints.is_some()) {
                    this.respond_result(msg, inlay_hints_to_json(hints.some));
                } else {
                    this.respond_result(msg, "null");
                }
            } else if (msg.method == "textDocument/rename") {
                let we: __builtin.Option<LspWorkspaceEdit> = query_rename(this.make_context(), msg);
                if (we.is_some()) {
                    this.respond_result(msg, we.some.json_serialize());
                } else {
                    this.respond_result(msg, "null");
                }
            } else if (msg.method == "textDocument/formatting") {
                this.respond_result(msg, text_edits_to_json(query_formatting(this.make_context(), msg)));
            } else if (msg.has_id) {
                this.respond_error(msg, JSONRPC_METHOD_NOT_FOUND, "method not found: " + msg.method);
            }
        }
    }
}

}
