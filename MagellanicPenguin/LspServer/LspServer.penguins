[Project]
# MagellanicPenguin LSP server — PenguinLang rewrite of the C# LSP.cs using
# the RTL-ports architecture (StdioStream → JsonInputParser → LspMain /
# LspCompilationUnit → JsonOutputParser, see .agents/plans/emperorpenguin-lsp-ports.md).
#
# Same source set as EmperorPenguinFull.penguins MINUS its main.penguin (the
# compiler CLI driver) — the LSP embeds the whole EmperorPenguin compiler as
# its analysis engine (per-document compile through EmperorPenguinCompiler.
# compile_sources) — PLUS the LSP modules. json/vector/hashmap are explicit
# (core_builtin.penguin + io.penguin are auto-injected by every compile).
# Built natively: tmp/pass3 --enable-coroutine MagellanicPenguin/LspServer/LspServer.penguins -o <exe>
name="LspServer"
sources=["LspTypes.penguin", "LspFraming.penguin", "StdioStream.penguin", "JsonInputParser.penguin", "LspMain.penguin", "LspCompilationUnit.penguin", "JsonOutputParser.penguin", "LspQuery.penguin", "LspJson.penguin", "LspWiring.penguin", "../../EmperorPenguin/src/ast/AST.penguin", "../../EmperorPenguin/src/ast/Lexer.penguin", "../../EmperorPenguin/src/ast/Parser.penguin", "../../EmperorPenguin/src/ast/SourceLocation.penguin", "../../EmperorPenguin/src/ast/Token.penguin", "../../EmperorPenguin/src/bound/BoundCompilationUnit.penguin", "../../EmperorPenguin/src/bound/BoundDefinition.penguin", "../../EmperorPenguin/src/bound/BoundExpression.penguin", "../../EmperorPenguin/src/bound/BoundScope.penguin", "../../EmperorPenguin/src/bound/BoundStatement.penguin", "../../EmperorPenguin/src/bound/BoundSymbol.penguin", "../../EmperorPenguin/src/bound/BoundTreePrinter.penguin", "../../EmperorPenguin/src/bound/BoundType.penguin", "../../EmperorPenguin/src/bound/BoundTypeRegistry.penguin", "../../EmperorPenguin/src/bound/EmperorPenguinCompiler.penguin", "../../EmperorPenguin/src/bound/SemanticModel.penguin", "../../EmperorPenguin/src/bound/SemanticShared.penguin", "../../EmperorPenguin/src/bound/SemanticMetaRewrite.penguin", "../../EmperorPenguin/src/bound/SemanticBuildScopes.penguin", "../../EmperorPenguin/src/bound/SemanticMonomorphize.penguin", "../../EmperorPenguin/src/bound/SemanticResolveTypes.penguin", "../../EmperorPenguin/src/bound/SemanticBindSymbols.penguin", "../../EmperorPenguin/src/bound/SemanticConstructors.penguin", "../../EmperorPenguin/src/bound/SemanticInterfaces.penguin", "../../EmperorPenguin/src/bound/SemanticClassifyValueTypes.penguin", "../../EmperorPenguin/src/bound/SemanticBindBodies.penguin", "../../EmperorPenguin/src/bound/SemanticBindExpressions.penguin", "../../EmperorPenguin/src/bound/SemanticBindMetaCalls.penguin", "../../EmperorPenguin/src/bound/SemanticValidateControlFlow.penguin", "../../EmperorPenguin/src/ir/IRBuilder.penguin", "../../EmperorPenguin/src/ir/IRFunction.penguin", "../../EmperorPenguin/src/ir/IRGenerator.penguin", "../../EmperorPenguin/src/ir/IRInstruction.penguin", "../../EmperorPenguin/src/ir/IRModule.penguin", "../../EmperorPenguin/src/ir/IRPrinter.penguin", "../../EmperorPenguin/src/ir/IRSourceLocation.penguin", "../../EmperorPenguin/src/ir/IRValue.penguin", "../../EmperorPenguin/src/llvm/LLVMCompiler.penguin", "../../EmperorPenguin/src/llvm/LLVMEmitter.penguin", "../../EmperorPenguin/src/meta/MetaEngine.penguin", "../../EmperorPenguin/src/meta/MetaHost.penguin", "../../EmperorPenguin/std/penguin/metaconfig.penguin", "../../EmperorPenguin/src/project/CompilerConfig.penguin", "../../EmperorPenguin/src/project/ErrorCode.penguin", "../../EmperorPenguin/src/project/Project.penguin", "../../EmperorPenguin/src/utils.penguin", "../../EmperorPenguin/std/penguin/json.penguin", "../../EmperorPenguin/std/penguin/vector.penguin", "../../EmperorPenguin/std/penguin/hashmap.penguin", "../../EmperorPenguin/std/penguin/array.penguin", "../../EmperorPenguin/std/penguin/dynlib.penguin"]
