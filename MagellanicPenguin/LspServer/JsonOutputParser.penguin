// JsonOutputParser: the outbound fan-in point. Every producer (LspMain, each
// LspCompilationUnit) writes LspOutMsg values into the SHARED outbound Fifo
// (N writers on one channel are legal — the design doc's multi-writer
// merge pattern, "multiple routines writing one channel"): this module is
// its single consumer, serializing each message into a JSON-RPC frame for
// StdioStream.tx. The out_exit control rides the same stream (channel order
// guarantees every frame queued ahead of it reaches the wire first) and is
// forwarded as the exit sentinel for StdioStream to terminate the process.
//
// (JsonOutputParser.inputs is the MultiInput fan-in the plan described, but
// EP v1 has no channel-as-connect-sink — deviation F — so producers write
// the hub Fifo through ISink views handed out at construction instead. Same
// fan-in topology, wired through constructors rather than connect.)
namespace lsp {

class JsonOutputParser {
    output out : string;
    // The shared outbound hub (single consumer: this module's loop).
    hub: mut __builtin.Fifo<LspOutMsg> = new __builtin.Fifo<LspOutMsg>(256, new __builtin.FifoPolicy.backpressure());

    fun new(mut this) {}

    // Producer view of the hub.
    fun sink(mut this) -> mut __builtin.ISink<LspOutMsg> {
        return cast<mut __builtin.ISink<LspOutMsg>>(this.hub);
    }

    initial {
        while (true) {
            let m: LspOutMsg = wait this.hub;
            if (m is LspOutMsg.out_exit) {
                this.out.write(make_exit_control(m.out_exit));
            } else if (m is LspOutMsg.out_response) {
                this.out.write(make_frame(serialize_response(m.out_response)));
            } else if (m is LspOutMsg.out_error) {
                this.out.write(make_frame(serialize_error_msg(m.out_error)));
            } else {
                this.out.write(make_frame(serialize_notification(m.out_notification)));
            }
        }
    }
}

}
